[ rdf:type owl:AllDisjointClasses ;
  owl:members ( doco:Abstract
                doco:Afterword
                doco:Appendix
                doco:Colophon
                doco:Foreword
                doco:Glossary
                doco:Index
                doco:ListOfFigures
                doco:ListOfTables
                doco:Preface
                doco:TableOfContents
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( doco:BackMatter
                doco:BodyMatter
                doco:CaptionedBox
                doco:Chapter
                doco:ComplexRunInQuotation
                doco:Footnote
                doco:Formula
                doco:FormulaBox
                doco:FrontMatter
                doco:List
                doco:Part
                doco:Section
                doco:Table
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( doco:Label
                doco:Paragraph
                doco:Subtitle
                doco:Title
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( doco:Sentence
                doco:SimpleRunInQuotation
                doco:TextChunk
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( frbr:Concept
                frbr:Event
                frbr:Object
                frbr:Place
              )
] .


