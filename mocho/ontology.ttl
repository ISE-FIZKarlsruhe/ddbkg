###  http://rdaregistry.info/Elements/w/P10260
rdaw:P10260 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "a pour item sujet"@fr ,
                       "aiheena oleva kappale"@fi ,
                       "có chủ đề (bản)"@vi ,
                       "ha come soggetto item "@it ,
                       "har eksemplar, som er subjekt"@da ,
                       "har emne (eksemplar)"@no ,
                       "has subject item"@en ,
                       "hat Thema (Exemplar)"@de ,
                       "heeft item als onderwerp"@nl ,
                       "konu alınan kopya ile ilişkilidir"@tr ,
                       "teema (eksemplar)"@et ,
                       "temats (vienība)"@lv ,
                       "tiene item de tema"@es ,
                       "tárgya a következő példány:"@hu ,
                       "té com a ítem de matèria"@ca ,
                       "έχει θέμα (αντίτυπο)"@el ,
                       "له مفردة موضوع"@ar ,
                       "有主题单件"@zh-hans-cn ;
            skos:definition "Bir eseri, eserin hakkında olduğu bir kopyayla ilişkilendirir."@tr ,
                            "Correla un’opera a un item di cui un’opera tratta."@it ,
                            "Hozzákapcsol egy művet egy példányhoz, amelyről egy mű szól."@hu ,
                            "Liittää teoksen kappaleeseen, jota teos koskee."@fi ,
                            "Liên kết tác phẩm với bản mà tác phẩm nói về."@vi ,
                            "Met une œuvre en relation avec un item dont traite une œuvre."@fr ,
                            "Relaciona una obra amb un ítem sobre el qual tracta una obra."@ca ,
                            "Relaciona una obra con un item del que trata una obra."@es ,
                            "Relateert een werk aan een item waar een werk over gaat."@nl ,
                            "Relaterer et verk til et eksemplar som et verk handler om."@no ,
                            "Relaterer et værk til et eksemplar, som et værk handler om."@da ,
                            "Relates a work to an item that a work is about."@en ,
                            "Sasaista darbu ar vienību, par kuru ir darbs."@lv ,
                            "Seostab teose eksemplariga, mille kohta teos on."@et ,
                            "Setzt ein Werk in Beziehung zu einem Exemplar, von dem ein Werk handelt."@de ,
                            "Συνδέει ένα έργο με ένα αντίτυπο στο οποίο αναφέρεται ένα έργο."@el ,
                            "يربط بين عمل ومفردة يدور حولها عمل."@ar ,
                            "将一种作品与一种作品所关于的一个单件关联起来。"@zh-hans-cn .


###  http://rdaregistry.info/Elements/w/P10261
rdaw:P10261 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "a pour personne sujet"@fr ,
                       "aiheena oleva henkilö"@fi ,
                       "có chủ đề (cá nhân)"@vi ,
                       "ha come soggetto persona "@it ,
                       "har emne (person)"@no ,
                       "har person, som er subjekt"@da ,
                       "has subject person"@en ,
                       "hat Thema (Person)"@de ,
                       "heeft persoon als onderwerp"@nl ,
                       "konu alınan kişi ile ilişkilidir"@tr ,
                       "teema (isik)"@et ,
                       "temats (persona)"@lv ,
                       "tiene tema de persona"@es ,
                       "tárgya a következő személy:"@hu ,
                       "té com a persona de matèria"@ca ,
                       "έχει θέμα (φυσικό πρόσωπο)"@el ,
                       "له شخص موضوع"@ar ,
                       "有主题个人"@zh-hans-cn ;
            skos:definition "Bir eseri, kendisi hakkında olan kişiyle ilişkilendirir."@tr ,
                            "Correla un’opera a una persona di cui un’opera tratta."@it ,
                            "Hozzákapcsol egy művet egy személyhez, akiről egy mű szól."@hu ,
                            "Liittää teoksen henkilöön, jota teos koskee."@fi ,
                            "Liên kết tác phẩm với cá nhân mà tác phẩm nói về."@vi ,
                            "Met une œuvre en relation avec une personne dont traite une œuvre."@fr ,
                            "Relaciona una obra amb una persona sobre la qual tracta una obra."@ca ,
                            "Relaciona una obra con una persona de la que trata una obra."@es ,
                            "Relateert een werk aan een persoon waar een werk over gaat."@nl ,
                            "Relaterer et verk til en person som et verk handler om."@no ,
                            "Relaterer et værk til en person, som et værk handler om."@da ,
                            "Relates a work to a person whom a work is about."@en ,
                            "Sasaista darbu ar personu, par kuru ir darbs."@lv ,
                            "Seostab teose isikuga, kelle kohta teos on."@et ,
                            "Setzt ein Werk in Beziehung zu einer Person, von der ein Werk handelt."@de ,
                            "Συνδέει ένα έργο με ένα φυσικό πρόσωπο στο οποίο αναφέρεται ένα έργο."@el ,
                            "يربط بين عمل وشخص يدور حوله عمل."@ar ,
                            "将一种作品与一种作品所关于的一个个人关联起来。"@zh-hans-cn .


###  http://rdaregistry.info/Elements/w/P10262
rdaw:P10262 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "a pour famille sujet"@fr ,
                       "aiheena oleva suku"@fi ,
                       "có chủ đề (gia đình)"@vi ,
                       "ha come soggetto famiglia "@it ,
                       "har emne (familie)"@no ,
                       "har familie, som er subjekt"@da ,
                       "has subject family"@en ,
                       "hat Thema (Familie)"@de ,
                       "heeft familie als onderwerp"@nl ,
                       "konu alınan aile ile ilişkilidir"@tr ,
                       "teema (perekond)"@et ,
                       "temats (dzimta/ģimene)"@lv ,
                       "tiene tema de familia"@es ,
                       "tárgya a következő család:"@hu ,
                       "té com a família de matèria"@ca ,
                       "έχει θέμα (οικογένεια)"@el ,
                       "له عائلة موضوع"@ar ,
                       "有主题家族"@zh-hans-cn ;
            skos:definition "Bir eseri, kendisi hakkında olan bir aileyle ilişkilendirir."@tr ,
                            "Correla un’opera a una famiglia di cui un’opera tratta."@it ,
                            "Hozzákapcsol egy művet egy családhoz, amelyről egy mű szól."@hu ,
                            "Liittää teoksen sukuun, jota teos koskee."@fi ,
                            "Liên kết tác phẩm với gia đình mà tác phẩm nói về."@vi ,
                            "Met une œuvre en relation avec une famille dont traite une œuvre."@fr ,
                            "Relaciona una obra amb una família sobre la qual tracta una obra."@ca ,
                            "Relaciona una obra con una familia de la que trata una obra."@es ,
                            "Relateert een werk aan een familie waar een werk over gaat."@nl ,
                            "Relaterer et verk til en familie som et verk handler om."@no ,
                            "Relaterer et værk til en familie, som et værk handler om."@da ,
                            "Relates a work to a family whom a work is about."@en ,
                            "Sasaista darbu ar dzimtu/ģimeni, par kuru ir darbs."@lv ,
                            "Seostab teose perekonnaga, kelle kohta teos on."@et ,
                            "Setzt ein Werk in Beziehung zu einer Familie, von der ein Werk handelt."@de ,
                            "Συνδέει ένα έργο με μια οικογένεια στην οποία αναφέρεται ένα έργο."@el ,
                            "يربط بين عمل وعائلة يدور حولها عمل."@ar ,
                            "将一种作品与一种作品所关于的一个家族关联起来。"@zh-hans-cn .


###  http://rdaregistry.info/Elements/w/P10263
rdaw:P10263 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "a pour collectivité sujet"@fr ,
                       "aiheena oleva yhteisö"@fi ,
                       "có chủ đề (tập thể)"@vi ,
                       "ha come soggetto ente "@it ,
                       "har emne (korporasjon)"@no ,
                       "har korporation, som er subjekt"@da ,
                       "has subject corporate body"@en ,
                       "hat Thema (Körperschaft)"@de ,
                       "heeft corporatie als onderwerp"@nl ,
                       "konu alınan tüzel kişi ile ilişkilidir"@tr ,
                       "teema (asutus)"@et ,
                       "temats (institūcija)"@lv ,
                       "tiene tema de cuerpo corporativo"@es ,
                       "tárgya a következő testület:"@hu ,
                       "té com a entitat corporativa de matèria"@ca ,
                       "έχει θέμα (συλλογικό όργανο)"@el ,
                       "له هيئة موضوع"@ar ,
                       "有主题团体"@zh-hans-cn ;
            skos:definition "Bir eseri, kendisi hakkında olan tüzel kişi ile ilişkilendirir."@tr ,
                            "Correla un’opera a un ente di cui un’opera tratta."@it ,
                            "Hozzákapcsol egy művet egy testülethez, amelyről egy mű szól."@hu ,
                            "Liittää teoksen yhteisöön, jota teos koskee."@fi ,
                            "Liên kết tác phẩm với tập thể mà tác phẩm nói về."@vi ,
                            "Met une œuvre en relation avec une collectivité dont traite une œuvre."@fr ,
                            "Relaciona una obra amb una entitat corporativa sobre la qual tracta una obra."@ca ,
                            "Relaciona una obra con un cuerpo corporativo del que trata una obra."@es ,
                            "Relateert een werk aan een corporatie waar een werk over gaat."@nl ,
                            "Relaterer et verk til en korporasjon som et verk handler om."@no ,
                            "Relaterer et værk til en korporation, som et værk handler om."@da ,
                            "Relates a work to a corporate body whom a work is about."@en ,
                            "Sasaista darbu ar institūciju, par kuru ir darbs."@lv ,
                            "Seostab teose asutusega, mille kohta teos on."@et ,
                            "Setzt ein Werk in Beziehung zu einer Körperschaft, von der ein Werk handelt."@de ,
                            "Συνδέει ένα έργο με ένα συλλογικό όργανο στο οποίο αναφέρεται ένα έργο."@el ,
                            "يربط بين عمل وهيئة يدور حولها عمل."@ar ,
                            "将一种作品与一种作品所关于的一个团体关联起来。"@zh-hans-cn .


###  http://rdaregistry.info/Elements/w/P10265
rdaw:P10265 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "er beskrivelse af eksemplar"@da ,
                       "er beskrivelse av eksemplar"@no ,
                       "es descripción de item"@es ,
                       "est une description d’un item"@fr ,
                       "ir apraksts vienībai"@lv ,
                       "is beschrijving van item"@nl ,
                       "is description of item"@en ,
                       "ist Beschreibung von (Exemplar)"@de ,
                       "kirjeldatud eksemplar"@et ,
                       "kopyanın tanımıdır"@tr ,
                       "kuvaus kappaleesta"@fi ,
                       "leírása a következő példánynak:"@hu ,
                       "là mô tả của (bản)"@vi ,
                       "è descrizione di item"@it ,
                       "és descripció d’un ítem"@ca ,
                       "είναι περιγραφή του (αντίτυπο)"@el ,
                       "هو وصف لمفردة"@ar ,
                       "是单件的描述"@zh-hans-cn ;
            skos:definition "Bir eseri, eser tarafından tanımlanan bir kopyayla ilişkilendirir."@tr ,
                            "Correla un’opera a un item che è descritto da un’opera."@it ,
                            "Hozzákapcsol egy művet egy példányhoz, amelyet egy mű leír."@hu ,
                            "Liittää teoksen kappaleeseen, jota teos kuvaa."@fi ,
                            "Liên kết tác phẩm với bản được mô tả bởi tác phẩm mô tả."@vi ,
                            "Met une œuvre en relation avec un item qui est décrit par une œuvre."@fr ,
                            "Relaciona una obra amb un ítem que és descrit per una obra."@ca ,
                            "Relaciona una obra con un item que es descrito por una obra."@es ,
                            "Relateert een werk aan een item dat beschreven wordt door een werk."@nl ,
                            "Relaterer et verk til et eksemplar som beskrives av et verk."@no ,
                            "Relaterer et værk til et eksemplar, som er beskrevet af et værk."@da ,
                            "Relates a work to an item that is described by a work."@en ,
                            "Sasaista darbu ar vienību, kas ir aprakstīta darbā."@lv ,
                            "Seostab teose eksemplariga, mida teoses on kirjeldatud."@et ,
                            "Setzt ein Werk in Beziehung zu einem Exemplar, das von einem Werk beschrieben wird."@de ,
                            "Συνδέει ένα έργο με ένα αντίτυπο που περιγράφεται σε ένα περιγραφικό έργο."@el ,
                            "يربط بين عمل ومفردة موصوفة في عمل."@ar ,
                            "将一种作品与被一种作品描述的一个单件关联起来。"@zh-hans-cn .


###  http://rdaregistry.info/Elements/w/P10267
rdaw:P10267 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "arviointi kappaleesta"@fi ,
                       "er evaluering af eksemplar"@da ,
                       "er evaluering av eksemplar"@no ,
                       "est une évaluation d’un item"@fr ,
                       "hinnang eksemplarile"@et ,
                       "ir novērtējums vienībai"@lv ,
                       "is beschouwing van item"@nl ,
                       "is evaluation of item (Deprecated)"@en ,
                       "ist Evaluierung von (Exemplar)"@de ,
                       "kiértékelése a következő példánynak:"@hu ,
                       "là đánh giá của (bản)"@vi ,
                       "è valutazione di item"@it ,
                       "és avaluació d’un ítem"@ca ,
                       "είναι αξιολόγηση του (αντίτυπο)"@el ,
                       "هو تقييم لمفردة"@ar ;
            skos:definition "Correla un’opera a un item che è esaminato o valutato."@it ,
                            "Hozzákapcsol egy művet egy példányhoz, amelyet elemeznek és megítélnek."@hu ,
                            "Liittää teoksen kappaleeseen, jota on tutkittu tai arvioitu."@fi ,
                            "Liên kết tác phẩm với bản được kiểm tra hoặc đánh giá."@vi ,
                            "Met une œuvre en relation avec un item qui est examiné ou jugé."@fr ,
                            "Relaciona una obra amb un ítem que s’examina o es jutja."@ca ,
                            "Relateert een werk aan een item dat onderzocht of beoordeeld wordt."@nl ,
                            "Relaterer et verk til et eksemplar som utforskes eller vurderes."@no ,
                            "Relaterer et værk til et eksemplar, som er undersøgt eller bedømt."@da ,
                            "Relates a work to an item that is examined or judged. (Deprecated)"@en ,
                            "Sasaista darbu ar vienību, kas ir pārbaudīta vai vērtēta."@lv ,
                            "Seostab teose eksemplariga, mida on kontrollitud või hinnatud."@et ,
                            "Setzt ein Werk in Beziehung zu einem Exemplar, das untersucht oder beurteilt wird."@de ,
                            "Συνδέει ένα έργο με ένα αντίτυπο που εξετάζεται ή κρίνεται."@el ,
                            "يربط بين عمل ومفردة يتم فحصها أو الحكم عليها."@ar .


###  http://rdaregistry.info/Elements/w/P10268
rdaw:P10268 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "arvostelu kappaleesta"@fi ,
                       "er anmeldelse af eksemplar"@da ,
                       "er anmeldelse av eksemplar"@no ,
                       "est une recension d’un item"@fr ,
                       "ir recenzija vienībai"@lv ,
                       "is recensie van item"@nl ,
                       "is review of item (Deprecated)"@en ,
                       "ist Rezension von (Exemplar)"@de ,
                       "szemlézi a következő példányt:"@hu ,
                       "tổng quan của bản"@vi ,
                       "è recensione di item"@it ,
                       "és revisió d’un ítem"@ca ,
                       "ülevaade eksemplarist"@et ,
                       "είναι εξέταση του (αντίτυπο)"@el ,
                       "هو مراجعة لمفردة"@ar ;
            skos:definition "Correla un'opera a un item usato come base per una breve valutazione."@it ,
                            "Hozzákapcsol egy művet egy példányhoz, amelyet egy rövid kiértékelés alapjaként használnak."@hu ,
                            "Liittää teoksen lyhyen arvioinnin perustana käytettyyn kappaleeseen."@fi ,
                            "Liên kết tác phẩm với bản được dùng như là cơ sở cho đánh giá ngắn gọn."@vi ,
                            "Met une œuvre en relation avec un item qui sert de base à une brève évaluation."@fr ,
                            "Relaciona una obra amb un ítem usat com a base d’una avaluació breu."@ca ,
                            "Relateert een werk aan een item gebruikt als een basis voor een korte beschouwing."@nl ,
                            "Relaterer et verk til et eksemplar brukt som utgangspunkt for en kortfattet evaluering."@no ,
                            "Relaterer et værk til et eksemplar, som anvendes som grundlag for en kortfattet evaluering."@da ,
                            "Relates a work to an item used as a basis for a brief evaluation. (Deprecated)"@en ,
                            "Sasaista darbu ar vienību, kas izmantota par pamatu īsam novērtējumam."@lv ,
                            "Seostab teose eksemplariga, mis on lühihinnangu aluseks."@et ,
                            "Setzt ein Werk in Beziehung zu einem Exemplar, das als Grundlage für eine kurze Untersuchung verwendet wird."@de ,
                            "Συνδέει ένα έργο με ένα αντίτυπο που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση."@el ,
                            "يربط بين عمل ومفردة تستخدم كأساس لتقييم موجز."@ar .


###  http://rdaregistry.info/Elements/w/P10269
rdaw:P10269 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "arvustatud eksemplar"@et ,
                       "bírálata a következő példánynak:"@hu ,
                       "er kritik af eksemplar"@da ,
                       "er kritikk av eksemplar"@no ,
                       "est une critique d’un item"@fr ,
                       "ir kritika vienībai"@lv ,
                       "is critique of item (Deprecated)"@en ,
                       "is kritiek van item"@nl ,
                       "ist Kritik von (Exemplar)"@de ,
                       "kritiikki kappaleesta"@fi ,
                       "là phê bình của (bản)"@vi ,
                       "è critica di item"@it ,
                       "és crítica d’un ítem"@ca ,
                       "είναι κριτική στο (αντίτυπο)"@el ,
                       "هو نقد لمفردة"@ar ;
            skos:definition "Correla un'opera a un item usato come base per una valutazione critica."@it ,
                            "Hozzákapcsol egy művet egy példányhoz, amelyet egy kritikai kiértékelés alapjaként használnak."@hu ,
                            "Liittää teoksen kappaleeseen, johon kriittinen arviointi perustuu."@fi ,
                            "Liên kết tác phẩm với bản được dùng như là cơ sở cho đánh giá phê bình."@vi ,
                            "Met une œuvre en relation avec un item qui sert de base à une évaluation critique."@fr ,
                            "Relaciona una obra amb un ítem usat com a base d’una avaluació crítica."@ca ,
                            "Relateert een werk aan een item gebruikt als een basis voor een kritische beschouwing."@nl ,
                            "Relaterer et verk til et eksemplar brukt som utgangspunkt for en kritisk evaluering."@no ,
                            "Relaterer et værk til et eksemplar, som anvendes som grundlag for en kritisk evaluering."@da ,
                            "Relates a work to an item used as a basis for a critical evaluation. (Deprecated)"@en ,
                            "Sasaista darbu ar vienību, kas izmantota par pamatu kritikai."@lv ,
                            "Seostab teose eksemplariga, mis on aluseks kriitilisele hinnangule."@et ,
                            "Setzt ein Werk in Beziehung zu einem Exemplar, das als Grundlage für eine kritische Untersuchung verwendet wird."@de ,
                            "Συνδέει ένα έργο με ένα αντίτυπο που χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση."@el ,
                            "يربط بين عمل ومفردة تستخدم كأساس لتقييم نقدي."@ar .


###  http://rdaregistry.info/Elements/w/P10271
rdaw:P10271 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "er beskrivelse af manifestation"@da ,
                       "er beskrivelse av manifestasjon"@no ,
                       "es la descripción de la manifestación"@es ,
                       "est une description d’une manifestation"@fr ,
                       "gösterimin tanımıdır"@tr ,
                       "ir apraksts manifestācijai"@lv ,
                       "is beschrijving van manifestatie"@nl ,
                       "is description of manifestation"@en ,
                       "ist Beschreibung von (Manifestation)"@de ,
                       "kirjeldatud kehastus"@et ,
                       "kuvaus manifestaatiosta"@fi ,
                       "leírása a következő megjelenési formának:"@hu ,
                       "là mô tả của (biểu thị)"@vi ,
                       "è descrizione di manifestazione"@it ,
                       "és descripció d’una manifestació"@ca ,
                       "είναι περιγραφή της (εκδήλωση)"@el ,
                       "هو وصف لتجسيدة"@ar ,
                       "是载体表现的描述"@zh-hans-cn ;
            skos:definition "Bir eseri, bir eser tarafından tanımlanan bir gösterimle ilişkilendirir."@tr ,
                            "Correla un’opera a una manifestazione che è descritta da un’opera."@it ,
                            "Hozzákapcsol egy művet egy megjelenési formához, amelyet egy mű leír."@hu ,
                            "Liittää teoksen manifestaatioon, jota teos kuvaa."@fi ,
                            "Liên kết tác phẩm với biểu thị được mô tả bởi tác phẩm mô tả."@vi ,
                            "Met une œuvre en relation avec une manifestation qui est décrite par une œuvre."@fr ,
                            "Relaciona una obra amb una manifestació que és descrita per una obra."@ca ,
                            "Relaciona una obra con una manifestación que es descrita por una obra."@es ,
                            "Relateert een werk aan een manifestatie die beschreven wordt door een werk."@nl ,
                            "Relaterer et verk til en manifestasjon som beskrives av et verk."@no ,
                            "Relaterer et værk til en manifestation, som er beskrevet af et værk."@da ,
                            "Relates a work to a manifestation that is described by a work."@en ,
                            "Sasaista darbu ar manifestāciju, kas ir aprakstīta darbā."@lv ,
                            "Seostab teose kehastusega, mida teoses on kirjeldatud."@et ,
                            "Setzt ein Werk in Beziehung zu einer Manifestation, die von einem Werk beschrieben wird."@de ,
