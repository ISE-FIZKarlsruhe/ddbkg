###  http://rdaregistry.info/Elements/m/P30423
rdam:P30423 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdam: ;
            rdfs:label "a pour famille contributrice à un agrégat"@fr ,
                       "aggregaattiin osallinen suku"@fi ,
