           skos:definition "A given extent of space."@en ,
                           "A tér egy adott kiterjedése."@hu ,
                           "Belirli bir alan ölçüsü."@tr ,
                           "Een bepaalde mate van ruimte."@nl ,
                           "Eine definierte Ausdehnung eines Raums."@de ,
                           "Et bestemt omfang i rom."@no ,
                           "Extensió d’espai determinada."@ca ,
                           "Givet omfang af rum."@da ,
                           "Một quy mô được nêu ra của không gian."@vi ,
                           "Noteikta telpa."@lv ,
                           "Portion d’espace déterminée."@fr ,
                           "Teatud kindel ruumiulatus."@et ,
                           "Tilan tietty laajuus."@fi ,
                           "Ubicazione identificata da un nome."@it ,
                           "Una determinada extensión de espacio."@es ,
                           "Μια δεδομένη χωρική έκταση."@el ,
                           "حيز مكاني معين."@ar ,
                           "一个指定的空间范围"@zh-hans-cn .


###  http://rdaregistry.info/Elements/c/C10011
rda:C10011 rdf:type owl:Class ;
           rdfs:subClassOf rda:C10002 ;
           rdfs:isDefinedBy rda: ;
           rdfs:label "Gemeinschaftlicher Akteur"@de ,
                      "agent collectif"@fr ,
                      "agent col·lectiu"@ca ,
                      "agente colectivo"@es ,
                      "agente collettivo"@it ,
                      "collectieve actor"@nl ,
                      "collective agent"@en ,
                      "grupa"@lv ,
                      "kolektif temsilci"@tr ,
                      "kollektiiv"@et ,
                      "kollektiv agent"@da ,
                      "kollektiv agent"@no ,
                      "kollektív ágens"@hu ,
                      "tác nhân tập thể"@vi ,
                      "yhteistoimija"@fi ,
                      "συλλογικός φορέας"@el ,
                      "وكيل جماعي"@ar ,
                      "集体行为者"@zh-hans-cn ;
           skos:definition "Agent que és una reunió o organització de dues o més persones que porta un nom concret i que és capaç d’actuar com una unitat."@ca ,
                           "Agent qui est un groupement ou une association de deux ou plusieurs personnes portant un nom particulier et disposant de la faculté d’agir collectivement."@fr ,
                           "Agent, som er en forsamling eller organisation af to eller felere personer med et bestemt namn, der kan agere som en enhed."@da ,
                           "An agent who is a gathering or organization of two or more persons that bears a particular name and that is capable of acting as a unit."@en ,
                           "Belirli bir adı taşıyan ve bir birim olarak hareket edebilen iki veya daha fazla kişiden oluşan bir toplantı veya organizasyon olan bir temsilci."@tr ,
                           "Een actor die is een bijeenkomst of organisatie van twee of meer personen dat een specifieke naam draagt en dat in staat is om op te treden als een eenheid."@nl ,
                           "Ein Akteur, bei dem es sich um eine Zusammenkunft oder eine Organisation von zwei oder mehreren Personen handelt, die der einen bestimmten Namen trägt und imstande ist, als Einheit zu handeln."@de ,
                           "En samling av eller organisasjon av personer som har et eget navn og som er i stand til å opptre som en enhet."@no ,
                           "Gruppo o organizzazione di persone contraddistinto da un nome specifico e in grado di agire come un'unità "@it ,
                           "Isikute rühm või organisatsioon, millel on kindel nimi ja mis on võimeline tegutsema üksusena."@et ,
                           "Một tập hợp hoặc tổ chức của các cá nhân có tên riêng và có thể hoạt động như là một đơn vị."@vi ,
                           "Personu kopums vai organizācija, kas izmanto īpašu nosaukumu un darbojas kā vienība."@lv ,
                           "Személyek csoportosulása vagy szervezete, amely saját névvel rendelkezik és egységként képes cselekedni"@hu ,
                           "Toimija, joka on useamman kuin yhden henkilön kokoontuminen tai organisaatio, jolla on tietty nimi ja joka on kykenevä toimimaan yksikkönä."@fi ,
                           "Un agente que es una reunión u organización de dos o más personas que lleva un nombre particular y que es capaz de actuar como una unidad."@es ,
                           "Μια συνένωση ή οργανισμός φυσικών προσώπων που φέρουν ένα συγκεκριμένο όνομα και δύνανται να δρουν ως ομάδα."@el ,
                           "وكيل عبارة عن تجمع أو تنظيم من شخصين أو أكثر يحملون اسما محددا ويمكنهم التعامل كوحدة ."@ar ,
                           "作为两个或多个个人的聚集或组织、有一个特定的名称并可如同一个单位一起行动的一个行为者"@zh-hans-cn ;
           skos:scopeNote "A collective agent includes a corporate body and a family."@en ,
                          "Agente collettivo comprende ente e famiglia"@it ,
                          "Darunter fallen Körperschaften und Familien."@de ,
                          "Een collectieve actor omvat een corporatie en een familie."@nl ,
                          "En kollektiv agent inkluderer korporasjon og familie."@no ,
                          "Grupa ietver institūciju un dzimtu/ģimeni."@lv ,
                          "Kolektif bir temsilci, bir tüzel kişiyi ve bir aileyi içerir."@tr ,
                          "Kollektiivid on asutus ja perekond."@et ,
                          "Kollektiv agent omfatter en korporation og en familie"@da ,
                          "Kollektív ágens"@hu ,
                          "Un agent collectif comprend une collectivité et une famille."@fr ,
                          "Un agent col·lectiu inclou una entitat corporativa i una família."@ca ,
                          "Un agente colectivo incluye una entidad corporativa y una familia."@es ,
                          "Yhteistoimija kattaa yhteisön ja suvun."@fi ,
                          "Ένας συλλογικός φορέας περιλαμβάνει ένα συλλογικό όργανο και μια οικογένεια."@el ,
                          "وكيل جماعي يشمل هيئة وعائلة."@ar ,
                          "集体行为者包括团体和家族"@zh-hans-cn .


###  http://rdaregistry.info/Elements/c/C10013
rda:C10013 rdf:type owl:Class ;
           rdfs:isDefinedBy rda: ;
           rdfs:label "RDA entity"@en ,
                      "RDA entīte"@lv ,
                      "RDA olem"@et ,
                      "RDA varlığı"@tr ,
                      "RDA οντότητα"@el ,
                      "RDA-Entität"@de ,
                      "RDA-entiteetti"@fi ,
                      "RDA-entiteit"@nl ,
                      "RDA-entitet"@da ,
                      "RDA-entitet"@no ,
                      "RDA-entitás"@hu ,
                      "RDA实体"@zh-hans-cn ,
                      "entidad RDA"@es ,
                      "entitat RDA"@ca ,
                      "entità RDA"@it ,
                      "entité RDA"@fr ,
                      "thực thể RDA"@vi ,
                      "كيان \"وام\""@ar ;
           skos:definition "A tárgyalási univerzum kulcsfogalmi objektumainak elvont osztálya, amely az RDA-metaadathasználók érdeklődésének középpontjában áll a forráskereső (discovery) rendszerek használata során."@hu ,
                           "Abstrakt klasse af begrebsmæssige nøglekomponenter af interesse for brugere af RDA-metadata i et system til ressourcesøgning."@da ,
                           "An abstract class of key conceptual objects in the universe of human discourse that are a focus of interest to users of RDA metadata in a system for resource discovery."@en ,
                           "Classe abstracta dels objectes conceptuals clau en l’univers del discurs humà que són un centre d’interès per als usuaris de les metadades RDA en un sistema per a la descoberta de recursos."@ca ,
                           "Classe abstraite d’objets conceptuels fondamentaux dans l’univers du discours humain qui constituent un centre d’intérêt pour les utilisateurs de métadonnées RDA dans un système de découverte de ressources."@fr ,
                           "Classe astratta di oggetti concettuali chiave nel'universo del discorso umano che è focus di interesse per gli utenti di metadati RDA in un sistema per la scoperta delle risorse"@it ,
                           "Een abstracte klasse van de belangrijkste conceptuele objecten in de wereld van het menselijk vertoog dat van belang is voor gebruikers van RDA-metadata in een systeem voor het ontdekken van resources."@nl ,
                           "Eine abstrakte Klasse wichtiger konzeptioneller Entitäten in der Gesamtheit des menschlichen Diskursuniversums, die für Benutzende von RDA-Metadaten in einem System zum Auffinden von Ressourcen von Interesse ist."@de ,
                           "En abstrakt klasse med konseptuelle nøkkelobjekter innenfor menneskelig diskurs som er i fokus for brukere av RDA-metadata i sluttbrukertjenester."@no ,
                           "Galveno konceptuālo objektu vispārēja klase, kas interesē RDA metadatu lietotājus bibliotēku informācijas sistēmās."@lv ,
                           "Ihmisdiskurssin keskeisten käsitteellisten objektien abstrakti luokka, joka on RDA:n metatietojen käyttäjien kiinnostuksen kohde hakujärjestelmässä."@fi ,
                           "Inimühiskonna diskursuse olulisimate mõisteliste objektide abstraktne klass, mis on ressursside leidmise süsteemis RDA metaandmete kasutajate huvikeskmes."@et ,
                           "Kaynak keşif sisteminde RDA metadata kullanıcılarının ilgi odağı olan, insan söylemi evrenindeki temel kavramsal nesnelerin soyut bir sınıfı"@tr ,
                           "Một lớp trừu tượng của các đối tượng khái niệm chủ yếu của nhân loại được người dùng siêu dữ liệu RDA tập trung chú ý trong các hệ thống thông tin thư viện."@vi ,
                           "Una clase abstracta de objetos conceptuales clave en el universo del discurso humano que son un foco de interés para los usuarios de metadatos RDA en un sistema para el descubrimiento de recursos."@es ,
                           "Μια αφηρημένη τάξη σημαντικών εννοιολογικών αντικειμένων στο σύμπαν του ανθρώπινου λόγου, τα οποία αποτελούν εστία ενδιαφέροντος για τους χρήστες των RDA μεταδεδομένων στα πληροφοριακά συστήματα των βιβλιοθηκών."@el ,
                           "فئة مجردة من كائنات مفاهيمية رئيسية في عالم الخطاب البشري، هي محور اهتمام مستخدمي ميتاداتا \"وام\" في نظام لاكتشاف المصادر."@ar ,
                           "资源发现系统中作为RDA元数据使用者兴趣焦点的人类论域中关键概念对象的抽象类"@zh-hans-cn ;
           skos:scopeNote "An RDA entity includes an agent, collective agent, corporate body, expression, family, item, manifestation, nomen, person, place, timespan, and work."@en ,
                          "Bir RDA varlığı, bir temsilci, kolektif temsilci, tüzel kişi, anlatım, aile, kopya, gösterim, isim, kişi, yer, zaman aralığı ve eseri içerir."@tr ,
                          "Darunter fallen Akteure, Exemplare, Expressionen, Familien, gemeinschaftliche Akteure, Geografika, Körperschaften, Manifestationen, Nomen, Personen, Werke und Zeiträume."@de ,
                          "Een RDA-entiteit omvat een actor, collectieve actor, corporatie, expressie, familie, item, manifestatie, nomen, persoon, plaats, tijdspanne en werk."@nl ,
                          "Egy RDA-entitás magába foglal egy ágenst, egy kollektív ágenst, testületet, kifejezési formát, családot, példányt, megjelenési formát, noment, személyt, helyet, időtartamot és művet."@hu ,
                          "En RDA-entitet inkluderer agent, fellesagent, korporasjon, uttrykk, familie, eksemplar, manifestasjon, nomen, person, sted, tidsrom og verk."@no ,
                          "RDA entīte ietver aģentu, grupu, institūciju, izteiksmi, dzimtu/ģimeni, vienību, manifestāciju, nomenu, personu, vietu, laikposmu un darbu."@lv ,
                          "RDA olemid on tegija, kollektiiv, asutus, väljendus, perekond, eksemplar, kehastus, nomen, isik, koht, ajavahemik ja teos."@et ,
                          "RDA-entiteetti kattaa toimijan, yhteistoimijan, yhteisön, ekspression, suvun, kappaleen, manifestaation, nomenin, henkilön, paikan, ajanjakson ja teoksen."@fi ,
                          "RDA-entitet omfatter en agent, kollektiv agent, korporation, et udtryk, en familie, et eksemplar, en manifestation, et nomen, en person, et sted, en tidsperiode og et værk."@da ,
                          "RDA实体包括行为者、集体行为者、团体、内容表达、家族、单件、载体表现、命名、个人、地点、时间段、作品。"@zh-hans-cn ,
                          "Un'entità RDA comprende arco di tempo, agente, agente collettivo, ente, espressione, famiglia, item, luogo, manifestazione, nomen, opera e persona."@it ,
                          "Una entidad RDA incluye un agente, agente colectivo, cuerpo corporativo, expresión, familia, item, manifestación, nomen, persona, lugar, período de tiempo y obra."@es ,
                          "Una entitat RDA inclou un agent, un agent col·lectiu, una entitat corporativa, una expressió, una família, un ítem, una manifestació, un nomen, una persona, un lloc, un interval de temps i una obra."@ca ,
                          "Une entité RDA comprend un agent, un agent collectif, une collectivité, une expression, une famille, un item, un laps de temps, un lieu, une manifestation, un nomen, une œuvre et une personne."@fr ,
                          "Μια οντότητα RDA περιλαμβάνει έναν φορέα, έναν συλλογικό φορέα, μια έκφραση, μια οικογένεια, ένα αντίτυπο, μια εκδήλωση, ένα όνομα, ένα φυσικό πρόσωπο, έναν τόπο, ένα χρονικό διάστημα και ένα έργο."@el ,
                          "كيان \"وام\" يشمل وكيلا، ووكيلا جماعيا، وهيئة، وتعبيرة، وعائلة، ومفردة، وتجسيدة، وتسمية، وشخص، ومكان، وفترة زمنية، وعمل."@ar .


