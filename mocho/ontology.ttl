###  http://rdaregistry.info/Elements/w/P10529
rdaw:P10529 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "a pour collectivité cartographe d’une œuvre"@fr ,
                       "darba kartogrāfs (institūcija)"@lv ,
