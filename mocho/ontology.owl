    <!-- http://rdaregistry.info/Elements/w/P10566 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10566">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille architecte paysagiste</rdfs:label>
        <rdfs:label xml:lang="lv">ainavu arhitekts (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto del paesaggio  famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er landskabsarkitekt</rdfs:label>
        <rdfs:label xml:lang="no">har landskapsarkitekt (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has landscape architect family</rdfs:label>
        <rdfs:label xml:lang="de">hat Landschaftsarchitektin/Landschaftsarchitekten (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landschapsarchitect-familie</rdfs:label>
        <rdfs:label xml:lang="et">maastikuarhitekt (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">maisema-arkkitehti (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">peyzaj mimarı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia arquitecta paisajista</rdfs:label>
        <rdfs:label xml:lang="hu">tájépítész családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família arquitecta paisatgista</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مهندسة تنسيق مواقع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有景观设计师家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, peyzaj çalışmaları yapmakla yükümlü mimar olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia architetto responsabile della creazione di opere paesaggistiche.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy építész családhoz, amely felelős tájépítészeti művek létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’œuvres paysagères.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un arquitecte que és responsable de la creació d’obres paisatgístiques.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear obras de paisajismo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een architect is die verantwoordelijk is voor het creëren van landschapswerken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en arkitekt med ansvar for å skape landskapsverk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en arkitekt, som er ansvarlig for at skabe landskabsværker.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an architect who is responsible for creating landscape works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par ainavu darbu veidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes arhitektina vastutab maastikuteoste loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Architektin/einem Architekten (Familie), die/der für die Erstellung landschaftlicher Werke verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مهندسة معمارية مسئولة عن إنشاء أعمال تنسيق المواقع.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为建筑师并负责创建景观作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10567 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10567">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille calligraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come calligrafo famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er kalligraf</rdfs:label>
        <rdfs:label xml:lang="no">har kalligraf (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has calligrapher family</rdfs:label>
        <rdfs:label xml:lang="de">hat Kalligrafin/Kalligrafen (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kalligraaf-familie</rdfs:label>
        <rdfs:label xml:lang="tr">kaligraf aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kaligrāfs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">kalligraaf (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">kalligrafi (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">kalligráfus családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia calígrafa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família cal·lígrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة خطاطة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有书法者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, aynı ailenin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlık veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan bir aileyle ilişkilendirir</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia artista responsabile della calligrafia, laddove l&apos;oggetto dell&apos;interesse risieda nel valore estetico della calligrafia o maestria grafica, a prescindere dal fatto che la stessa famiglia sia anche responsabile per il testo scritto. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész családhoz, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a család a lejegyzett szöveg szerzője is egyben vagy sem.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama suku myös vastuussa kirjoitetusta tekstistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même famille soit aussi responsable du texte calligraphié.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa família és també responsable del text inscrit.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una artista quien es responsable de la caligrafía donde el foco de interés yace en el valor estético de la caligrafía o habilidad artística gráfica, sin importar si la misma familia también es responsable del texto inscrito.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde familie ook verantwoordelijk is voor de inscriptie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same family is also responsible for the inscribed text.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni mākslinieks, kas ir atbildīga par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par ierakstīto tekstu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama perekond on vastutav ka kirjutatud teksti eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Familie), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Familie auch für den aufgeschriebenen Text verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون فنانة مسئولة عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون العائلة نفسها مسئولة أيضًا عن النص المدرج.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一家族是否负责题写文字）的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10568 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10568">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille sculptrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come scultore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er skulptør</rdfs:label>
        <rdfs:label xml:lang="no">har skulptør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has sculptor family</rdfs:label>
        <rdfs:label xml:lang="de">hat Bildhauerin/Bildhauer (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft beeldhouwer-familie</rdfs:label>
        <rdfs:label xml:lang="tr">heykeltıraş ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">kuvanveistäjä (suku)</rdfs:label>
        <rdfs:label xml:lang="et">skulptor (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">szobrász családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia escultora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família escultora</rdfs:label>
        <rdfs:label xml:lang="lv">tēlnieks (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة نحاتة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕塑家家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, modelleme, oyma veya benzeri bir teknikle üç boyutlu bir eser oluşturmaktan sorumlu tüzel kişi olan sanatçı olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia artista responsabile della creazione di un&apos;opera tridimensionale tramite modellatura, intaglio o tecnica simile. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész családhoz, amely felelős egy háromdimenziós mű megalkotásáért modellezési, faragási vagy hasonló technikával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille artiste qui est responsable de la création d’une œuvre tridimensionnelle par le modelage, la taille ou une technique similaire.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un artista que és responsable de la creació d’una obra tridimensional a partir del modelatge, la talla o una tècnica similar.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una artista quien es responsable de crear una obra tridimensional al modelar, esculpir o utilizar otra técnica similar.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een kunstenaar is die verantwoordelijk is voor het creëren van driedimensionaal modelleren, snijden of gelijksoortige techniek.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en kunstner med ansvar for å skape et tredimensjonalt verk gjennom modellering, utskjæring eller lignende teknikker.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en kunstner, som er ansvarlig for at skabe et tredimensionelt værk vha. modellering, udskæring eller lignende teknik.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an artist who is responsible for creating a three-dimensional work by modeling, carving, or similar technique.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni - mākslinieks, kura ir atbildīga par trīsdimensiju darba radīšanu, to veidojot, grebjot vai izmantojot līdzīgu tehniku.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on modelleerimise, nikerdamise või muu säärase tehnika teel loodud kolmemõõtmelise teose eest vastutav kunstnik.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Familie), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون فنانة مسئولة عن إنشاء عمل ثلاثي الأبعاد عن طريق النمذجة، أو النحت، أو تقنية مشابهة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为艺术家并通过模型、雕刻或类似技术负责创建一种三维作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10569 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10569">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille artiste du livre</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatu mākslinieks (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come book artist famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bokkunstner (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bogkunstner</rdfs:label>
        <rdfs:label xml:lang="en">has book artist family</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchkünstlerin/Buchkünstler (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekkunstenaar-familie</rdfs:label>
        <rdfs:label xml:lang="fi">kirjataiteilija (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">kitap sanatçısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvművész családja a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukunstnik (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia artista de libros</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família artista de llibre d’art</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة فنانة كتب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书美术家家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu sanatçı olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész családhoz, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una artista quien es responsable de explotar la forma del libro o alterar su estructura física.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an artist who is responsible for exploiting the book form or altering its physical structure.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas atbild par grāmatas kā mākslas darbu radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Familie), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون فنانة مسئولة عن استغلال شكل الكتاب أو تغيير بنيته المادية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10570 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10570">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille scénariste</rdfs:label>
        <rdfs:label xml:lang="hu">forgatókönyvíró családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come sceneggiatore famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er manuskriptforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har manusforfatter (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has screenwriter family</rdfs:label>
        <rdfs:label xml:lang="de">hat Drehbuchautorin/Drehbuchautor (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft scenarioschrijver-familie</rdfs:label>
        <rdfs:label xml:lang="fi">käsikirjoittaja (suku)</rdfs:label>
        <rdfs:label xml:lang="lv">scenārists (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">senarist ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">stsenarist (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia guionista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família guionista</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة كاتبة سيناريو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有影视剧编剧家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, senaryo, metin veya sahne yazarı olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia autore di una sceneggiatura, copione o scena.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely szerzője egy forgatókönyvnek, szövegkönyvnek vagy jelenetnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on käsikirjoituksen tai kohtauksen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille autrice d’un scénario, d’un script ou d’une scène.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un autor d’un guió, un argument o una escena.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una autora de un guion o escena.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een auteur is van een scenario, script of scène.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en forfatter av et skuespill, et manuskript eller en scene.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er forfatter af et manuskript, drejebog eller scene.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an author of a screenplay, script, or scene.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir scenārija, uzveduma plāna vai ainas autors.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on stsenaariumi või stseeni autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Familie) eines Drehbuchs, eines Skripts oder einer Szene.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون كاتبة سيناريو، أو نص، أو مشهد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为影视剧剧本、脚本或场景著者的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10571 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10571">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille parolière</rdfs:label>
        <rdfs:label xml:lang="hu">dalszövegíró családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">dziesmas teksta autors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come paroliere famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er tekstforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har sangtekstforfatter (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has lyricist family</rdfs:label>
        <rdfs:label xml:lang="de">hat Textdichterin/Textdichter (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft liedtekstschrijver-familie</rdfs:label>
        <rdfs:label xml:lang="fi">sanoittaja (suku)</rdfs:label>
        <rdfs:label xml:lang="et">sõnade autor (perekond)</rdfs:label>
        <rdfs:label xml:lang="tr">söz yazarı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia letrista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família lletrista</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مؤلفة أغاني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作词者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerinin yazarı olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia autore delle parole di una canzone pop, inclusa una canzone di un musical.  </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille autrice auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una autora de las palabras de una canción popular, incluyendo una canción de un musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an author of the words of a popular song, including a song from a musical.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir dziesmas vārdu autors, ieskaitot dziesmas no mūzikla.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on levilaulu (k.a laul muusikalist) sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Familie) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مؤلفة كلمات أغنية مشهورة، بما في ذلك أغنية من مسرحية موسيقية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of only the dialogue from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca diyaloglarının yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å bare skrive dialogen fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore dei soli dialoghi di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali dialoogide kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkän musikaalin dialogin kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun dialogen i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de dialogen uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musical párbeszédeinek szerzősége nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver mūzikla dialogus.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye ser el autor de solo el dialogo de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només el diàleg d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف الحوار فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是对话的著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10572 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10572">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille librettiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come librettista famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er librettist</rdfs:label>
        <rdfs:label xml:lang="no">har librettist (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has librettist family</rdfs:label>
        <rdfs:label xml:lang="de">hat Librettistin/Librettisten (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft librettist-familie</rdfs:label>
        <rdfs:label xml:lang="et">libretist (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">libretisti (suku)</rdfs:label>
        <rdfs:label xml:lang="lv">libretists (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">librettista családja a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">libretto yazarı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia libretista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família llibretista</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مؤلفة أوبرالية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有台本作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, opera, bale veya müzikal sahne için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia autore delle parole di un musical o opera coreografica, come un&apos;opera, balletto, o altra opera per il teatro musicale, o per un oratorio. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző családhoz, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o una qualsevol altra escènica musical o d’un oratori.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una autora de las palabras de una obra musical o coreográfica tal como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en famile som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Familie) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مؤلفة كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为歌剧、芭蕾等音乐或编舞作品或其他舞台音乐作品或者清唱剧的歌词的著者的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of the words of only the songs from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore delle parole delle sole canzoni di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali laulusõnade kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun sangteksterne i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musicaldalok szövegírója nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atsevišķu dziesmu tekstus mūziklos.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye ser el autor de solo las canciones de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només les paraules de les cançons d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是歌曲的词著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10573 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10573">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille rapporteuse</rdfs:label>
        <rdfs:label xml:lang="et">aruande koostaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="it">ha come relatore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er rapportør</rdfs:label>
        <rdfs:label xml:lang="no">har rapportør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has rapporteur family</rdfs:label>
        <rdfs:label xml:lang="de">hat Berichterstatterin/Berichterstatter (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft rapporteur-familie</rdfs:label>
        <rdfs:label xml:lang="fi">kokousten raportoija (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">raportör ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">raportőr családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia relatora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família relatora</rdfs:label>
        <rdfs:label xml:lang="lv">ziņotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مقررة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有会务报告人家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kuruluş tarafından toplantılarının işleyişi hakkında rapor vermek üzere atanan bir yazar olan aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia autore incaricato da un&apos;organizzazione di compilare rapporti sugli atti dei suoi incontri. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző családhoz, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille autrice qui est nommée par une organisation pour rédiger les comptes rendus de ses réunions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una autora quien es nombrada por una organización para reportar los procedimientos de sus reuniones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is an author who is appointed by an organization to report on the proceedings of its meetings.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Familie), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مؤلفة عينتها منظمة لإعداد تقارير عن وقائع اجتماعاتها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个著者并被一个组织指定为在其会议文集中报告的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="no">Ansvar som er begrenset til å ta møtereferater, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; esclusa la responsabilità limitata a redigere verbali.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma vastutust, mis on piiratud ainult protokollimisega.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atbildību protokolēt.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele a jegyzőkönyvvezetésre korlátozódó szerzőség.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter ikke ansvar begrænset til at tage referat.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Responsibility limited to taking minutes is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la responsabilidad limitada a tomar minutas.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la responsabilitat que es limita a prendre notes.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Tutanak tutmakla sınırlı sorumluluk hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une responsabilité limitée à rédiger un procès-verbal est exclue.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Verantwoordelijkheid beperkt tot het notuleren is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括仅限于写会议记录的责任。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10575 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10575">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille chorégraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come coreografo famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er koreograf</rdfs:label>
        <rdfs:label xml:lang="no">har koreograf (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has choreographer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Choreografin/Choreografen (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft choreograaf-familie</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">koreograaf (perekond)</rdfs:label>
        <rdfs:label xml:lang="tr">koreograf aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">koreografi (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfus családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia coreógrafa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família coreògrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مصممة رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kareografik bir çalışma oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile di un&apos;opera coreografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy koreografikus mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa koreografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre chorégraphique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra coreogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra coreográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een choreografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et koreografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for et koreografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a choreographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par horeogrāfisku darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab koreograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines choreografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن ابتكار عمل راقص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种编舞作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10576 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10576">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille cartographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba kartogrāfs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kartograf ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come cartografo famiglia di opera</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er kartograf for værk</rdfs:label>
        <rdfs:label xml:lang="no">har kartograf (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has cartographer family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Kartografin/Kartografen eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cartograaf-familie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű térképész családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen kartantekijä (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose kartograaf (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia cartógrafa de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família cartògrafa d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة رسامة خرائط لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的地图绘制者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kartografik bir çalışma oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile di un&apos;opera cartografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy kartográfiai mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa kartografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre cartographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra cartogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra cartográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een cartografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for et kartografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for et kartografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a cartographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par karti, atlantu, globusu vai citu kartogrāfijas materiālu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab kartograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines kartografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل خرائطي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种地图作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10577 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10577">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille autrice</rdfs:label>
        <rdfs:label xml:lang="lv">autors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come autore famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er forfatter</rdfs:label>
        <rdfs:label xml:lang="no">har forfatter (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has author family</rdfs:label>
        <rdfs:label xml:lang="de">hat Verfasserin/Verfasser (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft auteur-familie</rdfs:label>
        <rdfs:label xml:lang="fi">kirjoittaja (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">szerző családja a következő:</rdfs:label>
        <rdfs:label xml:lang="et">tekstteose autor (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia autora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família autora</rdfs:label>
        <rdfs:label xml:lang="tr">yazar aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مؤلفة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有著者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, metinsel bir eser oluşturmaktan sorumlu bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile di un&apos;opera testuale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy szöveges mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa tekstiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre textuelle.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra textual.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra textual.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een tekstwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for et tekstlig verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for et tekstværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a textual work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par tekstuālu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab tekstteose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines textlichen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل نصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种文字作品的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Başka bir yaratıcıya ait eserlerin yeniden yazılması, yeniden ifade edilmesi veya uyarlanması yoluyla, eğer yapılan değişiklik orijinal eserin niteliğini ve içeriğini önemli ölçüde değiştirmişse ya da ifade ortamını dönüştürmüşse, yeni bir eser oluşturulması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy új mű megalkotása egy másik alkotó munkáinak átfogalmazásával, újraírásával vagy adaptálásával, ha a módosítás lényegesen megváltoztatta az eredeti jellegét és tartalmát, vagy a kifejezési forma médiumát.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Creatie van een nieuw werk door het parafraseren, herschrijven of bewerken van werken van een andere maker, als de wijziging de aard en content van het origineel substantieel gewijzigd heeft of het medium van expressie gewijzigd heeft, is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Creation of a new work by paraphrasing, rewriting, or adapting works by another creator, if the modification has substantially changed the nature and content of the original or changed the medium of expression, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Schaffung eines neuen Werks durch Paraphrasieren, Umschreiben oder Adaption von Werken einer anderen geistigen Schöpferin/eines anderen geistigen Schöpfers, wenn die Veränderung die Art und den Inhalt des Originals substanziell verändert hat oder sich das Medium der Expression geändert hat.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å skape et nytt verk ved å omskrive eller bearbeide verk av en annen opphaver er inkludert hvis dette i vesentlig grad har endret originalverkets særpreg og innhold, eller hvis mediet for uttrykket er endret.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compresa la creazione di una nuova opera tramite la parafrasi, riscrittura o adattamento di opere di un altro creatore, se la modifica ha cambiato sostanzialmente la natura e contenuto dell&apos;originale, o ha mutato il mezzo di espressione.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uue teose loomist, ümber sõnastades, ümber töötades või adapteerides teise autori teoseid, kui teisendamine on originaali olemust ja sisu oluliselt muutnud või muutunud on väljenduse meedium.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver arī jauna darba radīšanu, pārfrazējot, pārrakstot vai pielāgojot cita radītāja darbus, ja ir būtiski mainīta pamatdarba būtība, saturs vai izteiksmes nesējs.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la creació d’una obra nova parafrasejant, reescrivint o adaptant obres d’un altre creador, si la modificació ha canviat substancialment la natura i el contingut de l’original o si ha canviat el mitjà d’expressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">La creación de una nueva obra al parafrasear, reescribir o adaptar obras de otro creador, si la modificación ha cambiado sustancialmente la naturaleza y contenido del original, o cambiado el medio de expresión, se incluye.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La création d’une nouvelle œuvre en paraphrasant, en réécrivant ou en adaptant les œuvres d’un autre créateur est incluse, si la modification a changé considérablement la nature et le contenu de l’original ou a changé le mode d’expression.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Skabelse af et nyt værk ved at parafrasere, omskrive eller bearbejde værker af et andet ophav, hvis modificeringen har medført en væsentlig ændring af originalens karakter og indhold, eller den har ændret udtryksmediet, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين إنشاء عمل جديد عن طريق إعادة منشئ آخر الصياغة، أو الكتابة، أو تكييفه الأعمال، إذا كان التعديل قد غيّر طبيعة الأصل ومحتواه أو غير وسيلة التعبير تغييرا كبيرا.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">通过演绎、改写或改变另一个创建者的作品所作而成的新作品的创建，如果修改实质性改变了原作的性质和内容或者改变了内容表达的媒介，应被包括在内。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10578 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10578">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille créatrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba radītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin yaratıcı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore famiglia di opera</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er ophav til værk</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av verk (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has creator family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat geistige Schöpferin/geistigen Schöpfer eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-familie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű létrehozó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen tekijä (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose autor (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia creadora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família creadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منشئة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创作一种作品的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of work includes an agent who is jointly responsible for the creation of a work either by performing the same role as another agent, such as in a collaboration between two writers, or by performing a different role, such as in a collaboration between a composer and a lyricist.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A mű létrehozója magában foglal egy ágenst, amely egy másik ágenssel közösen felelős egy mű létrehozásáért akár ugyanabban a közreműködői minőségben, mint például két író közötti együttműködés, vagy eltérő közreműködői minőségben, mint például egy zeneszerző és egy szövegíró közötti együttműködés.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir eserin yaratıcısı, iki yazarın iş birliği gibi başka bir temsilciyle aynı rolü üstlenerek ya da bir besteci ve söz yazarı arasındaki iş birliği gibi farklı bir rol üstlenerek, eserin yaratılmasından ortaklaşa sorumlu olan bir temsilciyi kapsar.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darba radītājs ietver aģentu, kas ir atbildīgs par darba radīšanu un pilda tādu pašu lomu kā cits aģents, piemēram, kā sadarbībā starp diviem rakstniekiem vai veicot dažādas lomas, kā piemēram, komponista un teksta autora sadarbībā.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt ein Akteur, der für die Schaffung eines Werks mitverantwortlich ist, wenn er entweder dieselbe Rolle wie ein anderer Akteur ausführt, wie bei einer Zusammenarbeit zwischen zwei Schriftstellerinnen/Schriftstellern, oder eine andere Rollen ausführt, wie bei einer Zusammenarbeit zwischen einer Komponistin/einem Komponisten und einer Textdichterin/einem Textdichter.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van werk omvat een actor die gezamenlijk verantwoordelijk is voor de creatie van een werk door ofwel dezelfde rol uit te voeren als een andere actor, zoals bij een samenwerking door twee schrijvers, ofwel door een verschillende rol uit te voeren, zoals bij een samenwerking tussen een componist en een liedtekstschrijver.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En opphaver for verk inkluderer en agent med delt ansvar for å skape et verk, enten ved å fylle samme rolle som en annen agent, som i et samarbeid mellom to forfattere, eller ulike roller som i et samarbeid mellom en komponist og en sangtekstforfatter.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til værk omfatter en agent, som har fælles ansvar for at have skabt et værk enten ved at udføre den samme rolle som en anden agent, såsom i et samarbejde mellem to forfattere, eller ved at udføre en anden rolle, såsom i et samarbejde mellem en komponist og en tekstforfatter. </skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose autor hõlmab ka tegijat, kes kaasvastutab teose loomise eest, täites teise tegijaga kas sama rolli (nt kahe kirjaniku koostöö) või erinevat rolli (nt helilooja ja sõnade autori koostöö).</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de obra incluye un agente que es responsable en conjunto de la creación de una obra ya sea al desempeñar el mismo papel que otro agente, tal como en una colaboración entre dos escritores, o al desempeñar un papel distinto, tal como en una colaboración entre un compositor y un letrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una obra inclou un agent que és responsable conjuntament de la creació d’una obra ja sigui realitzant la mateixa funció que un altre agent, com ara una col·laboració entre dos escriptors, o realitzant funcions diferents, com ara una col·laboració entre un compositor i un lletrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di opera comprende un agente congiuntamente responsabile della creazione di un&apos;opera, sia svolgendo lo stesso ruolo di un altro agente, come in una collaborazione tra due scrittori, sia svolgendo un ruolo differente, come in una collaborazione tra un compositore e un paroliere.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une œuvre comprend un agent coresponsable de la création d’une œuvre soit en exerçant le même rôle qu’un autre agent, comme dans le cas d’une collaboration entre deux écrivains, soit en exerçant un rôles différent, comme dans le cas d’une collaboration entre un compositeur et un parolier.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منشئ العمل يشمل وكيلًا مسئولاً مسئولية مشتركة عن إنشاء عمل إما عن طريق أداء نفس الدور الذي يؤديه وكيل آخر، كما هو الحال في التعاون بين كاتبين، أو عن طريق أداء دور مختلف، كما هو الحال في التعاون بين ملحن ومؤلف أغاني.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">作品的创作者包括对作品的创建联合负责的行为者，他们或者行使同样的角色（例如两个写作者之间的合作）或者行使不同角色（例如作曲者和词作者之间的合作）。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10579 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10579">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille architecte</rdfs:label>
        <rdfs:label xml:lang="et">arhitekt (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">arhitekts (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">arkkitehti (suku)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har arkitekt (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er arkitekt</rdfs:label>
        <rdfs:label xml:lang="en">has architect family</rdfs:label>
        <rdfs:label xml:lang="de">hat Architektin/Architekten (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft architect-familie</rdfs:label>
        <rdfs:label xml:lang="tr">mimar aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia arquitecta</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família arquitecta</rdfs:label>
        <rdfs:label xml:lang="hu">építész családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مهندسة معمارية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有建筑师家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir binanın veya diğer bir yapının tamamlandığında nasıl görüneceğini göstermeyi amaçlayan resimli bir temsil de dahil olmak üzere mimari bir tasarımın oluşturulmasından sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile di un progetto architettonico, compresa una rappresentazione visiva destinata a mostrare l&apos;aspetto che avrà una costruzione o altra struttura, una volta completata. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy építészeti tervért, beleértve egy képi ábrázolást, melynek célja bemutatni, hogy egy épület stb. az elkészülte után hogyan fog kinézni.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une conception architecturale, y compris une représentation illustrée conçue pour montrer à quoi ressemblera un bâtiment ou une autre structure une fois la construction terminée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’un disseny arquitectònic, inclosa una representació il·lustrada concebuda per mostrar com serà un edifici o qualsevol altra estructura una vegada complet.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear un diseño arquitectónico, incluyendo una representación ilustrada destinada a mostrar cómo se verá un edificio u otra estructura cuando haya sido completada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een architectonisch ontwerp, omvattende een picturale representatie bedoeld te laten zien hoe een gebouw of andere structuur er na voltooiing uit zal zien.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape en arkitektonisk utforming, inkludert en gjengivelse i bildeform som er ment å vise hvordan en bygning eller annen struktur vil se ut når den er ferdig.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for et arkitektonisk design, inkl. en billedrepræsentation, som skal vise, hvordan en bygning eller anden struktur vil se ud, når den er færdig.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating an architectural design, including a pictorial representation intended to show how a building or other structure will look when completed.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par arhitektūras projekta radīšanu, ieskaitot projekta skici, lai parādītu, kā ēka vai cita struktūra izskatīsies, kad tā tiks pabeigta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab arhitektuurse kujunduse loomise eest, k.a pildiline esitus, mis näitab, kuidas ehitis või muu konstruktsioon valmides välja hakkab nägema.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines architektonischen Entwurfs verantwortlich ist, einschließlich einer bildlichen Darstellung, die zeigt, wie ein Gebäude oder eine andere Konstruktion nach der Fertigstellung aussehen soll.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء تصميم معماري، بما في ذلك تمثيل تصويري يهدف إلى إظهار كيف سيبدو المبنى أو هيكل آخر عند اكتماله.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建建筑设计（包括用于展示建筑或其他结构完成之后外观效果的绘画作品）的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10580 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10580">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille commanditaire</rdfs:label>
        <rdfs:label xml:lang="tr">görevlendiren aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come committente famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er opgavestiller</rdfs:label>
        <rdfs:label xml:lang="no">har oppdragsgiver (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has commissioning family</rdfs:label>
        <rdfs:label xml:lang="de">hat Auftraggeberin/Auftraggeber (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft opdrachtgever-familie</rdfs:label>
        <rdfs:label xml:lang="hu">megrendelő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pasūtītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">tellija (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia comisionante</rdfs:label>
        <rdfs:label xml:lang="fi">toimeksiantaja (suku)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família entitat comitent</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مكلِفة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有委托家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eseri görevlendirmekten sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della committenza di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy mű megrendeléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa teoksen teettämisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la commande d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable d’encarregar una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de comisionar una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor opdracht geven tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å bestille et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for bestilling af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for commissioning a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par darba pasūtīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab teose tellimise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die ein Werk in Auftrag gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن التكليف بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责委托一种作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10581 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10581">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille programmeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come programmatore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er programmør</rdfs:label>
        <rdfs:label xml:lang="no">har programmerer (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has programmer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Programmiererin/Programmierer (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft programmeur-familie</rdfs:label>
        <rdfs:label xml:lang="fi">ohjelmoija (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">programcı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">programmeerija (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">programmētājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">programozó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia programadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família programadora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مبرمجة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编程者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir bilgisayar programı oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un programma per computer.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy számítógépes program megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa tietokoneohjelman luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’un programme informatique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’un programa informàtic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear un programa de computadora.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een computerprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et dataprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et computerprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a computer program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par datorprogrammas izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab arvutiprogrammi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Computerprogramms verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء برنامج كمبيوتر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种计算机程序的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10582 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10582">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille designer</rdfs:label>
        <rdfs:label xml:lang="fi">designer (suku)</rdfs:label>
        <rdfs:label xml:lang="lv">dizainers (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come designer famiglia </rdfs:label>
        <rdfs:label xml:lang="no">har designer (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er designer</rdfs:label>
        <rdfs:label xml:lang="en">has designer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Designerin/Designer (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ontwerper-familie</rdfs:label>
        <rdfs:label xml:lang="et">kujundaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="tr">tasarımcı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">tervező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia diseñadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família dissenyadora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مصممة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有设计者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir nesne için tasarım oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione del progetto di un oggetto. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy tárgy tervezetének a megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa kohteen suunnittelusta tai muotoilusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la conception d’un objet.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’un disseny d’un objecte.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear un diseño para un objeto.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een ontwerp voor een object.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å designe en gjenstand.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at designe et objekt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a design for an object.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par objekta dizaina radīšanu/izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab objekti kujunduse loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Gestaltung des Designs eines Objekts verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء تصميم لكائن.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个物体的设计的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10583 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10583">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille compositrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba komponists (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin besteci ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compositore famiglia di opera </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er komponist af værk</rdfs:label>
        <rdfs:label xml:lang="no">har komponist (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has composer family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Komponistin/Komponisten eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft componist-familie werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű zeneszerző családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen säveltäjä (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose helilooja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia compositora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família compositora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة ملحنة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的作曲者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzik çalışması oluşturmaktan sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un&apos;opera musicale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy zenemű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa musiikkiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een muziekwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et musikalsk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et musikværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a musical work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par mūzikas darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab muusikateose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Musikwerks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل موسيقي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种音乐作品的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Bewerken van een ander muziekwerk om een onderscheidende aanpassing te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compreso l&apos;adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un&apos;opera o la creazione di un&apos;opera nello stile tipico di un altro compositore, o tramite la creazione di un&apos;opera basata sulla musica di un altro compositore. </skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">La adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra al estilo general de otro compositor, o crear una obra que está basada en la música de otro compositor, se incluye.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创建一种新的作品、或者基于另一个作曲者的音乐创建一种新的作品。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10584 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10584">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille inventrice</rdfs:label>
        <rdfs:label xml:lang="hu">feltaláló családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come inventore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er opfinder</rdfs:label>
        <rdfs:label xml:lang="no">har oppfinner (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has inventor family</rdfs:label>
        <rdfs:label xml:lang="de">hat Erfinderin/Erfinder (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvinder-familie</rdfs:label>
        <rdfs:label xml:lang="lv">izgudrotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">keksijä (suku)</rdfs:label>
        <rdfs:label xml:lang="et">leiutaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="tr">mucit ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia inventora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família inventora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مخترعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发明者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, yeni bir cihaz veya işlem oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un nuovo dispositivo o procedimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy új eszköz vagy eljárás létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa uuden välineen tai menetelmän luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’un nouveau dispositif ou procédé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’un mecanisme o un procés nou.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear un nuevo dispositivo o proceso.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een nieuw apparaat of proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape en ny innretning eller prosess.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe en ny anordning eller proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a new device or process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par jaunas ierīces vai procesa radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab uue seadme või protsessi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines neuen Gerätes oder Prozesses verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء جهاز جديد أو عملية جديدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种新装置或新过程的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10585 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10585">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille compilatrice</rdfs:label>
        <rdfs:label xml:lang="tr">derleyen aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compilatore famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er kompilator</rdfs:label>
        <rdfs:label xml:lang="no">har utarbeider (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has compiler family</rdfs:label>
        <rdfs:label xml:lang="de">hat Zusammenstellende/Zusammenstellenden (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft samensteller-familie</rdfs:label>
        <rdfs:label xml:lang="fi">kokoaja (suku)</rdfs:label>
        <rdfs:label xml:lang="et">koostaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">sastādītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia compiladora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família compiladora</rdfs:label>
        <rdfs:label xml:lang="hu">összeállító családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة جامعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编纂者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir üstveri seti oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely adatok, információk stb. kiválasztása, elrendezése, aggregálása és szerkesztése révén felelős egy olyan új mű létrehozásáért, mint például egy bibliográfia vagy adattár.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa uuden teoksen, kuten bibliografian tai hakemiston luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’un ensemble de métadonnées descriptives.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’un conjunt de descripció de metadades.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear un conjunto de descripción de metadatos.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a metadata description set.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个元数据描述集的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön muokkaamista tai selkeyttämistä eikä teosten tai teosten osien valitsemista ja kokoamista yhteen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik ide sem egy mű kifejezési formájának tartalmi felülvizsgálata vagy tisztázása, sem a művek vagy műrészek kifejezési formáinak kiválasztása és összeállítása.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono esclusi la revisione o il chiarimento del contenuto di un&apos;espressione di un&apos;opera, e la selezione e raccolta di espressioni di opere o parti di opere.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares y una ayuda analítica para hallazgos.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن أعمال أو أجزاء من أعمال وتجميعها.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10586 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10586">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille photographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="tr">eserin fotoğrafçı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">fotogrāfs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come fotografo famiglia di opera</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er fotograf af værk</rdfs:label>
        <rdfs:label xml:lang="no">har fotograf for verk (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has photographer family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Fotografin/Fotografen eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fotograaf-familie werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű fényképész családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen valokuvaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose fotograaf (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia fotógrafa de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família fotògrafa d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مصورة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的摄影者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, fbir otoğraf eseri oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un&apos;opera fotografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy fényképészeti mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa valokuvateoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre photographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra fotogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra fotográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een fotografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et fotografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et fotografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a photographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par fotogrāfiska darba izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab fotograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines fotografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل فوتوغرافي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种摄影作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10587 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10587">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille intervieweuse d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervējis (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşmeci ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistatore famiglia di opera</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er interviewer for værk</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuer (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has interviewer family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewerin/Interviewer eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft interviewer-familie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúkészítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastattelija (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueerija (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia entrevistadora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família entrevistadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة محاورة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的采访者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir görüşmeci, muhabir, anketör veya bilgi toplayan başka bir tür aile olarak hareket ederek bir eser oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un&apos;opera che agisce come intervistatore, reporter, sondaggista o altro genere di persona che raccoglie informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő családként cselekszik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre famille recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus de família que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra al actuar como un entrevistador, reportero, encuestador u otro tipo de agente que recolecta información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for korporation, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of family who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva perekonnana.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Familie Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل من خلال العمل كمحاور، أو مراسل، أو مستطلع آراء، أو عائلة من نوع آخر تجمع المعلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过担当采访者、记者、民意调查员或其他类型信息搜集行为者而对一种作品的创建负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10588 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10588">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille interviewée d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervēts (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşülen ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistato famiglia di opera</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er interviewperson for værk</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuobjekt (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has interviewee family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewte/Interviewten eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geïnterviewde familie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúalany családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastateltava (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueeritav (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia entrevistada de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família entrevistada d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مقابلة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的受访者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir görüşmeci, genellikle bir muhabir, anketör veya bilgi toplayan başka bir türde temsilciye yanıt vererek bir eser oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un&apos;opera tramite le risposte rilasciate a un intervistatore, solitamente un reporter, sondaggista o altro genere di agente che raccoglie le informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy mű létrehozásáért oly módon, hogy válaszol egy interjúkészítőnek, általában riporternek, közvélemény-kutatónak, vagy valamilyen más információgyűjtő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa teoksen luomisesta vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jonkinlaiselle muulle toimijalle, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre en répondant à un intervieweur, habituellement un reporteur, un sondeur ou un autre agent recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra responent a un entrevistador, normalment un periodista, enquestador o qualsevol altre tipus d’agent que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra al responder a un entrevistador, usualmente un reportero, encuestador u otro tipo de agente que recolecta información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een werk door het antwoorden op een interviewer, meestal een journalist, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et verk ved å svare på spørsmål fra en intervjuer, reporter eller annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et værk ved at besvare spørgsmål fra en interviewer, normalt en journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating a work by responding to an interviewer, usually a reporter, pollster, or some other kind of agent who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par darba radīšanu, atbildot uz intervētāja, parasti reportiera, aptaujas organizētāja vai kāda cita informācijas apkopotāja jautājumiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab teose loomise eest, vastates intervjueerijale, reporterile, küsitlejale või muule infot koguvale tegijale. </skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Werks verantwortlich ist, indem sie einer Interviewerin/einem Interviewer antwortet. Dabei handelt es sich normalerweise um eine Reporterin/einen Reporter, eine Meinungsforscherin/einen Meinungsforscher oder eine andere Akteurin/einen anderen Akteur, die/der Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مسئولة عن إنشاء عمل من خلال الرد على المحاور، وعادة ما يكون مراسلًا، أو مستطلع آراء، أو وكيلاً من نوع آخر يجمع معلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过回答采访者（通常是记者、民意调查员或其他类型信息搜集行为者）而对一种作品的创建负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10589 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10589">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille agrégatrice</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattori (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátor családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come aggregatore famiglia </rdfs:label>
        <rdfs:label xml:lang="no">har aggregator (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er samler</rdfs:label>
        <rdfs:label xml:lang="en">has aggregator family</rdfs:label>
        <rdfs:label xml:lang="de">hat Aggregatorin/Aggregator (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aggregator-familie</rdfs:label>
        <rdfs:label xml:lang="et">liitja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia agregadora</rdfs:label>
        <rdfs:label xml:lang="tr">toplayıcı aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família agregadora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مجمعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集编者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, başka eserlerin anlatımlarını seçerek ve düzenleyerek toplama bir eser oluşturmaktan sorumlu olan aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un&apos;opera tramite la selezione e l&apos;organizzazione di espressioni di altre opere.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy aggregáló mű létrehozásáért, más művek kifejezési formáinak kiválasztása és elrendezése révén.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre agrégatrice par la sélection et l’arrangement d’expressions d’autres œuvres.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra agregadora mitjançant la selecció i l’arranjament d’expressions d’altres obres.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra agregante al seleccionar y disponer expresiones de otras obras.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een aggregaatwerk door middel van selectie en arrangeren van expressies van andere werken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et aggregerende verk ved å velge ut og arrangere uttrykk av andre verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et aggregerende værk ved at udvælge og arrangere udtryk af andre værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating an aggregating work by selecting and arranging expressions of other works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par darba-apkopojuma radīšanu, atlasot un sakārtojot citu darbu izteiksmes.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab liitva teose loomise eest, valides ja korrastades teiste teoste väljendused.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines aggregierenden Werks verantwortlich ist, indem sie Expressionen anderer Werke auswählt und zusammenstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل مجمع عن طريق اختيار تعبيرات أعمال أخرى وترتيبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责把其他作品的内容表达选择和整理后创建一种合集性作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10590 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10590">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille remixeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista di remix famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er remixer</rdfs:label>
        <rdfs:label xml:lang="no">har remikser (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has remix artist family</rdfs:label>
        <rdfs:label xml:lang="de">hat Remix Artist (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft remixartiest-familie</rdfs:label>
        <rdfs:label xml:lang="et">remiksija (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">remiksētājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">remix sanatçısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">remixművész családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia artista de remix</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família artista de remescla</rdfs:label>
        <rdfs:label xml:lang="fi">uudelleenmiksaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة فنانة مزج موسيقي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合成艺术家家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un&apos;opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear una obra de audio al manipular, recombinar, mezclar y reproducir sonidos previamente grabados.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en famile som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创建一种音频作品的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="es">Actividades de remix que no cambian sustancialmente la naturaleza y contenido de la obra original, y mezclar juntas pistas grabadas para que parezcan una pista continua, se excluyen.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell&apos;opera originale, nonché il missaggio di brani registrati che appaiano come un unico brano.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10591 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10591">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille cinéaste</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvantekijä (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">film üreticisi ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas veidotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">filmitegija (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">filmkészítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come cineasta famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er filmskaber</rdfs:label>
        <rdfs:label xml:lang="no">har filmskaper (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has filmmaker family</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmemacherin/Filmemacher (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmmaker-familie</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia cineasta</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família cineasta</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة صانعة أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制片人家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bağımsız veya kişisel bir film yaratmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un film indipendente o realizzato autonomamente.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy független- vagy egy magánfilm létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’un film indépendant ou personnel.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’una pel·lícula cinematogràfica independent o personal.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear un film independiente o personal.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het creëren van een zelfstandige of persoonlijke film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape en uavhengig eller personlig film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe en indiefilm eller personlig film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating an independent or personal film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab sõltumatu või autorifilmi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für Schaffung eines unabhängigen oder privaten Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن إنتاج فيلم مستقل أو شخصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种独立或个人电影的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A filmmaker is individually responsible for the conception and execution of all aspects of the film.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir film yapımcısı, filmin tüm yönlerinin tasarlanmasından ve yürütülmesinden bireysel olarak sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een filmmaker is individueel verantwoordelijk voor de conceptie en uitvoering van alle aspecten van de film.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy filmkészítő egyénileg felelős egy film koncepciójáért és összes aspektusának végrehajtásáért.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En filmskaper har personlig ansvar for planen med og gjennomføringen av alle aspektene ved filmen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Filmas veidotājs ir pilnībā atbildīgs par visiem filmas koncepcijas un realizācijas aspektiem.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmitegija vastutab üksinda kõigi filmi aspektide kontseptsiooni ja teostamise eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmskaberen er individuelt ansvarlig for udtænkning og udførelse af alle filmens aspekter.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un cineasta es individualmente responsable de crear un film independiente o personal.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un cineasta è responsabile a livello individuale della concezione ed esecuzione di ogni aspetto del film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un cineasta és responsable a títol individual de la concepció i l’execució de tots els aspectes de la pel·lícula.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un cinéaste est responsable à titre individuel de la conception et de l’exécution de tous les aspects du film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">صانع أفلام مسئول مسئولية فردية عن تصور جميع جوانب الفيلم وتنفيذه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制片人对电影所有方面的构思和执行负有个人责任</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10592 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10592">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille artiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er kunstner</rdfs:label>
        <rdfs:label xml:lang="no">har kunstner (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has artist family</rdfs:label>
        <rdfs:label xml:lang="de">hat Künstlerin/Künstler (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kunstenaar-familie</rdfs:label>
        <rdfs:label xml:lang="et">kunstnik (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">mākslinieks (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">művész családja a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">sanatçı aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">taiteilija (suku)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia artista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família artista</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة فنانة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有美术家家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, orijinal bir grafik tasarımı, çizimi, resmi vb. oluşturmaktan sorumlu bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della creazione di un un progetto grafico, schizzo, dipinto originali, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy eredeti grafikai terv, rajz, festmény, stb. megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la création d’un graphisme, d’une peinture, d’un dessin, etc. original.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la creació d’un disseny gràfic, un dibuix, una pintura, etc., original.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de crear un diseño gráfico, dibujo, pintura, etc. original.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is het maken van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for å skape et originalt grafisk design, en tegning, et maleri etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at skabe et originalt grafisk design, -tegning, -maleri etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for creating an original graphic design, drawing, painting, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par darba radīšanu un īstenošanu, izmantojot oriģinālu grafisko dizainu, zīmēšanu, gleznošanu, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab originaalse graafilise kujunduse, joonistuse, maali vms loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسؤولة عن إنشاء تصميم رسومي، ورسم، وتصوير زيتي أصلي، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责完成原创图形设计、绘图、绘画等的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10593 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10593">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille fondatrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba dibinātājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kurucu ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fondatore famiglia di opera </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er stifter af værk</rdfs:label>
        <rdfs:label xml:lang="no">har grunnlegger av verk (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has founder family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Begründerin/Begründer eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft oprichter-familie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű alapító családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen perustaja (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose asutaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia fundadora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família fundadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مؤسسة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创办者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eseri başlatmaktan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile dell&apos;avvio di un&apos;opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy diakronikus mű indításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa diakronisen teoksen alullepanosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de lancer une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable d’iniciar una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de iniciar una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het initiëren van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som har ansvar for å etablere et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for at igangsætte et diakronisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for initiating a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab diakroonilise teose ellukutsumise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für das Begründen eines diachronen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن بدء عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责发起一种历时作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10594 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10594">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille directrice de casting</rdfs:label>
        <rdfs:label xml:lang="lv">aktieru atlases režisors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">casting&apos;u juht (perekond)</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore del casting famiglia </rdfs:label>
        <rdfs:label xml:lang="no">har casting director (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er caster</rdfs:label>
        <rdfs:label xml:lang="en">has casting director family</rdfs:label>
        <rdfs:label xml:lang="de">hat Casting Director (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft castingdirector-familie</rdfs:label>
        <rdfs:label xml:lang="tr">kast yönetmeni ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">roolittaja (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">szereposztó rendező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia directora de casting</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família directora de càsting</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مديرة طاقم تمثيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有角色导演家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, sanatçılara rol ve görev atamanın çoğu yönünden sorumlu olan bir aile ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della maggior parte degli aspetti relativi all&apos;assegnazione agli interpreti di parti e compiti. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la majoria dels aspectes de l’assignació de parts i funcions als intèrprets.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de la mayoría de los aspectos de la asignación de roles y funciones a intérpretes.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for de fleste aspekter ved å fordele roller og oppgaver mellom utøvere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for de fleste aspekter ved tildeling af roller og ansvar til udøvere.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for most aspects of assigning parts and duties to performers.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par lomu sadali un pienākumu piešķiršanu izpildītājiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab enamiku aspektide eest esitajatele rollide ja ülesannete jagamisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن معظم جوانب تخصيص الأدوار والواجبات للمؤدين.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责给演员分配角色和任务的大多数工作的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10595 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10595">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille productrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er producer</rdfs:label>
        <rdfs:label xml:lang="no">har produsent (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has producer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-familie</rdfs:label>
        <rdfs:label xml:lang="lv">producents (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">producer családja a következő:</rdfs:label>
        <rdfs:label xml:lang="et">produtsent (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia productora</rdfs:label>
        <rdfs:label xml:lang="fi">tuottaja (suku)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família productora</rdfs:label>
        <rdfs:label xml:lang="tr">yapımcı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منتجة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir yapımın ticari yönlerinin çoğundan sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, grabación de audio, televisión, webcast, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Generalmente un produttore è responsabile della raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un productor es generalmente responsable de recaudar fondos, gestionar la producción, contratar personal clave, llegar a acuerdos para distribuidores, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10596 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10596">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille réalisatrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er instruktør</rdfs:label>
        <rdfs:label xml:lang="no">har regissør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has director family</rdfs:label>
        <rdfs:label xml:lang="de">hat Regisseurin/Regisseur (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft regisseur-familie</rdfs:label>
        <rdfs:label xml:lang="fi">ohjaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">rendező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">režisors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">režissöör (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia directora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família realitzadora</rdfs:label>
        <rdfs:label xml:lang="tr">yönetmen ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مخرجة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有导演家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia responsabile della gestione generale e della supervisione di un&apos;interpretazione cinematografica, programma radiofonico o televisivo, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es responsable de la gestión y supervisión general de una presentación grabada, un programa de radio o televisión, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة مسئولة عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي، أو تليفزيوني، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责电影表演、广播或电视节目等的全面管理和监督的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10597 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10597">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille émettrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er udstedende organ</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has issuing family</rdfs:label>
        <rdfs:label xml:lang="de">hat herausgebende Familie</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvaardiger-familie</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisija (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">kibocsátó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">piyasaya çıkaran ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia emisora</rdfs:label>
        <rdfs:label xml:lang="lv">turpinājumizdevuma izdevējs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família d’entitat editora</rdfs:label>
        <rdfs:label xml:lang="et">väljaandja (perekond)</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة جهة إصدار</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有颁布家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser yayınlayan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia che emette un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely kibocsát egy művet.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka julkaisee teoksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui publie une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que publica una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que emite una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een werk uitvaardigt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som utgir et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som udgiver et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who issues a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas izdevusi darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes annab teose välja.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die ein Werk heraus gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تصدر عملاً.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与颁布一种作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10598 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10598">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille organisatrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come organizzatore famiglia </rdfs:label>
        <rdfs:label xml:lang="no">har arrangør (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er arrangør</rdfs:label>
        <rdfs:label xml:lang="en">has organizer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Veranstalterin/Veranstalter (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft organisator-familie</rdfs:label>
        <rdfs:label xml:lang="fi">järjestäjä (suku)</rdfs:label>
        <rdfs:label xml:lang="et">korraldaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="tr">organizatör ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">organizētājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">szervező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia organizadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família organitzadora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منظِمة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有组织者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, düzenlediği bir konferans, sergi veya etkinlik sonucu bir eser ortaya çıkan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia organizzatrice di una conferenza, mostra o altro evento che dà origine a un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely egy mű létrejöttét eredményező konferenciát, kiállítást vagy egyéb eseményt szervez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui organise un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que organitza un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que organiza una conferencia, exhibición u otro evento que da origen a otra obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die organiseert een conferentie, tentoonstelling of andere gebeurtenis dat aanleiding geeft tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som organiserer en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som organiserer en konference, udstilling eller anden begivenhed, som giver anledning til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who organizes a conference, exhibition, or other event that gives rise to a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas organizējusi konferenci, izstādi vai citu pasākumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes korraldab teosele aluse pannud konverentsi, näituse vm ürituse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert beziehungsweise veranstaltet, aus der/dem ein Werk hervorgeht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تنظم مؤتمرًا، أو معرضًا، أو أي حدث آخر ينتج عنه عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与组织会议、展览或其他事件以产生一种作品的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10599 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10599">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille consultante</rdfs:label>
        <rdfs:label xml:lang="fi">asiantuntija (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">danışman aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come consulente famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er rådgiver</rdfs:label>
        <rdfs:label xml:lang="no">har konsulent (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has consultant family</rdfs:label>
        <rdfs:label xml:lang="de">hat Beraterin/Berater (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft consultant-familie</rdfs:label>
        <rdfs:label xml:lang="et">konsultant (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">konsultants (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">tanácsadó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia consultora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família consultora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة استشارية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有顾问家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmetleri sağlayan ve genellikle tavsiyelerde bulunan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come creatore di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que provee servicios de consultoría, y frecuentemente hace recomendaciones, a un agente relacionado que es representado como un creador de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تقدم خدمات استشارية، وغالبًا ما تقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10600 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10600">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af nomen</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av nomen</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de nomen</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’un nomen</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts nomenam</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van nomen</rdfs:label>
        <rdfs:label xml:lang="en">is description of nomen</rdfs:label>
        <rdfs:label xml:lang="tr">ismin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Nomen)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud nomen</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus nomenista</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő nomennek:</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di nomen</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’un nomen</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف تسمية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是命名的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından tanımlanan bir isim ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un nomen descritto da un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est décrit par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és descrit per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es descrito por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et nomen som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et nomen, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kurš aprakstīts darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose nomen&apos;iga, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Nomen, das von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية موصوفة في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10601 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10601">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="de">Ist Beschreibung von (Geografikum)</rdfs:label>
        <rdfs:label xml:lang="da">er beskrivelse af sted</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av sted</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de lugar</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’un lieu</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts vietai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van plaats</rdfs:label>
        <rdfs:label xml:lang="en">is description of place</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud koht</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus paikasta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő helynek:</rdfs:label>
        <rdfs:label xml:lang="tr">yerin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di luogo</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’un lloc</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف مكان</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是地点的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser tarafından tanımlanan bir yerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un luogo descritto da un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy helyhez, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen paikkaan, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un lieu qui est décrit par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un lloc que és descrit per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lugar que es descrito por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een plaats die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et sted som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et sted, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a place that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vietu, kas aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kohaga, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Geografikum, das von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومكان موصوف في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个地点关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10602 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10602">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="de">Ist Beschreibung von (Zeitraum)</rdfs:label>
        <rdfs:label xml:lang="da">er beskrivelse af tidsperiode</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av tidsrom</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de espacio de tiempo</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’un laps de temps</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts laikposmam</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van tijdspanne</rdfs:label>
        <rdfs:label xml:lang="en">is description of timespan</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud ajavahemik</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus ajanjaksosta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő időtartamnak:</rdfs:label>
        <rdfs:label xml:lang="tr">zaman aralığının tanımıdır</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di arco di tempo</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’un interval de temps</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف فترة زمنية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是时间段的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından tanımlanan bir zaman aralığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un arco di tempo descritto da un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy időtartamhoz, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ajanjaksoon, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un laps de temps qui est décrit par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un interval de temps que és descrit per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un espacio de tiempo que es descrito por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een tijdspanne die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et tidsrom som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en tidsperiode, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a timespan that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar laikposmu, kas aprakstīts darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose ajavahemikuga, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Zeitraum, der von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وفترة زمنية موصوفة في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个时间段关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10604 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10604">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif parraineur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba sponsors (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin sponsoru olan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come sponsor agente collettivo di opera</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er sponsor af værk</rdfs:label>
        <rdfs:label xml:lang="no">har sponsor for verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has sponsoring collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Trägerin/Träger eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sponsor van werk-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="hu">mű szponzoráló kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen sponsori (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose toetaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo patrocinador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu patrocinador d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي راعٍ لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的赞助集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin bazı yönlerine sponsor olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo che sponsorizza qualche aspetto di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely egy művet valamilyen tekintetben szponzorál.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka sponsoroi teosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui parraine un aspect quelconque d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que patrocina algun aspecte d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que patrocina algún aspecto de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die enige aspecten van een werk sponsort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er sponsor for et aspekt ved et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som sponsorerer et aspekt af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who sponsors some aspect of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas sponsorē dažus darba aspektus.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes mingil viisil majanduslikult toetab teose loomist. </skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der einzelne Aspekte eines Werks finanziell unterstützt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يرعى بعض جوانب عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与赞助一种作品某方面的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend le financement de la recherche et le parrainage d’un événement qui constitue la base d’une œuvre.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Comprende la ricerca di fondi e la sponsorizzazione di un evento, che è la base di un&apos;opera.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy mű alapját képező kutatás finanszírozása és esemény szponzorálása is idetartozik.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uurimistöö rahastamist ja teose aluseks oleva ürituse majanduslikku toetamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver pētījumu finansēšanu un pasākuma sponsorēšanu, kas ir darba pamatā.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou el finançament de la recerca i el patrocini d’un esdeveniment que és la base d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes funding research and sponsoring an event that is the basis of a work.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye financiar investigación y patrocinar un evento que es la base de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Inkluderer finansiering av forskning og økonomisk støtte til et arrangement som er grunnlaget for et verk.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter finansiering af forskning og sponsorering af et arrangement, som danner grundlag for et værk.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat het financieren van onderzoek en het sponsoren van een evenement dat de basis vormt van een werk.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">eserin sponsoru olan temsilci ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل ذلك تمويل البحث ورعاية حدث يمثل أساس عمل.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括资助作为一种作品之基础的研究以及赞助作为一种作品之基础的一项活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10605 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10605">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité parraineuse d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba sponsors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin sponsoru olan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come sponsor ente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er sponsor af værk</rdfs:label>
        <rdfs:label xml:lang="no">har sponsor for verk (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has sponsoring corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Trägerin/Träger eines Werks (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sponsor van werk-corporatie</rdfs:label>
        <rdfs:label xml:lang="hu">mű szponzoráló testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen sponsori (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose toetaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo patrocinador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa patrocinadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة راعية لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的赞助团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin bazı yönlerine sponsor olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente che sponsorizza qualche aspetto di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely egy művet valamilyen tekintetben szponzorál.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka sponsoroi teosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui parraine un aspect quelconque d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que patrocina algun aspecte d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que patrocina algún aspecto de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die enige aspecten van een werk sponsort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er sponsor for et aspekt ved et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som sponsorerer et aspekt af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who sponsors some aspect of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas sponsorē dažus darba aspektus.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes mingil viisil majanduslikult toetab teose loomist. </skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die einzelne Aspekte eines Werks finanziell unterstützt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة ترعى بعض جوانب عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与赞助一种作品某方面的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend le financement de la recherche et le parrainage d’un événement qui constitue la base d’une œuvre.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Comprende la ricerca di fondi e la sponsorizzazione di un evento, che è la base di un&apos;opera.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy mű alapját képező kutatás finanszírozása és esemény szponzorálása is idetartozik.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uurimistöö rahastamist ja teose aluseks oleva ürituse majanduslikku toetamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver pētījumu finansēšanu un pasākuma sponsorēšanu, kas ir darba pamatā.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou el finançament de la recerca i el patrocini d’un esdeveniment que és la base d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes funding research and sponsoring an event that is the basis of a work.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye financiar investigación y patrocinar un evento que es la base de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Inkluderer finansiering av forskning og økonomisk støtte til et arrangement som er grunnlaget for et verk.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter finansiering af forskning og sponsorering af et arrangement, som danner grundlag for et værk.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat het financieren van onderzoek en het sponsoren van een evenement dat de basis vormt van een werk.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">eserin sponsoru olan tüzel kişi ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل ذلك تمويل البحث ورعاية حدث يمثل أساس عمل.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括资助作为一种作品之基础的研究以及赞助作为一种作品之基础的一项活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10606 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10606">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille parraineuse d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba sponsors (dzimta/ģimene</rdfs:label>
        <rdfs:label xml:lang="tr">eserin sponsoru olan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come sponsor famiglia di opera</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er sponsor af værk</rdfs:label>
        <rdfs:label xml:lang="no">har sponsor for verk (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has sponsoring family of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Trägerin/Träger eines Werks (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sponsor van werk-familie</rdfs:label>
        <rdfs:label xml:lang="hu">mű szponzoráló családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen sponsori (suku)</rdfs:label>
        <rdfs:label xml:lang="et">teose toetaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia patrocinadora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família patrocinadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة راعية لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的赞助家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin bazı yönlerine sponsor olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia che sponsorizza qualche aspetto di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely egy művet valamilyen tekintetben szponzorál.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka sponsoroi teosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui parraine un aspect quelconque d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que patrocina algun aspecte d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que patrocina algún aspecto de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die enige aspecten van een werk sponsort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er sponsor for et aspekt ved et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som sponsorerer et aspekt af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who sponsors some aspect of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas sponsorē dažus darba aspektus.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes mingil viisil majanduslikult toetab teose loomist.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die einzelne Aspekte eines Werks finanziell unterstützt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة ترعى بعض جوانب عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与赞助一种作品某方面的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend le financement de la recherche et le parrainage d’un événement qui constitue la base d’une œuvre.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Comprende la ricerca di fondi e la sponsorizzazione di un evento, che è la base di un&apos;opera.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy mű alapját képező kutatás finanszírozása és esemény szponzorálása is idetartozik.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uurimistöö rahastamist ja teose aluseks oleva ürituse majanduslikku toetamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver pētījumu finansēšanu un pasākuma sponsorēšanu, kas ir darba pamatā.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou el finançament de la recerca i el patrocini d’un esdeveniment que és la base d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes funding research and sponsoring an event that is the basis of a work.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye financiar investigación y patrocinar un evento que es la base de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Inkluderer finansiering av forskning og økonomisk støtte til et arrangement som er grunnlaget for et verk.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter finansiering af forskning og sponsorering af et arrangement, som danner grundlag for et værk.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat het financieren van onderzoek en het sponsoren van een evenement dat de basis vormt van een werk.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">eserin sponsoru olan aile ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل ذلك تمويل البحث ورعاية حدث يمثل أساس عمل.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括资助作为一种作品之基础的研究以及赞助作为一种作品之基础的一项活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10607 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10607">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne parraineuse d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba sponsors (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin sponsoru olan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come sponsor persona di opera</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er sponsor af værk</rdfs:label>
        <rdfs:label xml:lang="no">har sponsor for verk (person)</rdfs:label>
        <rdfs:label xml:lang="en">has sponsoring person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Trägerin/Träger eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sponsor van werk-persoon</rdfs:label>
        <rdfs:label xml:lang="hu">mű szponzoráló személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen sponsori (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose toetaja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona patrocinadora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona patrocinadora d’una obra</rdfs:label>
