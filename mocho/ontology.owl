        <owl:inverseOf rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isEmbodimentOf"/>
        <rdfs:domain rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Expression"/>
        <rdfs:range rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Manifestation"/>
        <rdfs:label xml:lang="en">mocho:hasEmbodiment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ise-fizkarlsruhe.github.io/ddbkg/mocho#hasExemplar -->

