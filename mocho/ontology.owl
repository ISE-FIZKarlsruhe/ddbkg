        <rdfs:domain rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Manifestation"/>
        <rdfs:range rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Expression"/>
        <rdfs:label xml:lang="en">mocho:isEmbodimentOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isExemplarOf -->

    <owl:ObjectProperty rdf:about="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isExemplarOf">
