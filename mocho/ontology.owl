        <rdfs:domain rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Item"/>
        <rdfs:range rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Work"/>
        <rdfs:label xml:lang="en">mocho:isExemplarOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isManifestationOf -->

    <owl:ObjectProperty rdf:about="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isManifestationOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/fabio/isManifestationOf"/>
        <rdfs:domain rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Manifestation"/>
        <rdfs:range rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Work"/>
        <rdfs:label xml:lang="en">mocho:isManifestationOf</rdfs:label>
