        <rdfs:domain rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Manifestation"/>
        <rdfs:range rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Item"/>
        <rdfs:label xml:lang="en">mocho:hasExemplar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ise-fizkarlsruhe.github.io/ddbkg/mocho#hasManifestation -->

    <owl:ObjectProperty rdf:about="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#hasManifestation">
