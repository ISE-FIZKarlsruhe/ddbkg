###  http://rdaregistry.info/Elements/m/P30434
rdam:P30434 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdam: ;
            rdfs:label "a pour famille diffuseuse audiovisuelle"@fr ,
                       "ha come emittente famiglia "@it ,
