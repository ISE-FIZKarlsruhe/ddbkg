        <rdfs:label xml:lang="da">har ophavsangivelse, som relaterer til serie</rdfs:label>
        <rdfs:label xml:lang="sv">har upphovsuppgift till serie</rdfs:label>
        <rdfs:label xml:lang="en">has statement of responsibility relating to series</rdfs:label>
        <rdfs:label xml:lang="de">hat Verantwortlichkeitsangabe, die sich auf eine Reihe bezieht</rdfs:label>
        <rdfs:label xml:lang="nl">heeft verantwoordelijkheidsvermelding gerelateerd aan reeks</rdfs:label>
        <rdfs:label xml:lang="fi">sarjan vastuullisuusmerkintö</rdfs:label>
        <rdfs:label xml:lang="et">seeriaga seotud vastutusandmed</rdfs:label>
        <rdfs:label xml:lang="tr">seriye ilişkin sorumluluk bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">sorozathoz kapcsolódó felelősségi közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">sērijas atbildības ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de responsabilidad relativa a la serie</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de responsabilitat relativa a una col·lecció</rdfs:label>
        <rdfs:label xml:lang="el">έχει μνεία ευθύνης σχετική με τη σειρά</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان مسئولية مرتبط بسلسلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有和丛编有关的责任说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir diziyle ilişkili bir sorumluluk bildirimiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di responsabilità associata a una serie.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy felelősségi közléshez, amely egy sorozathoz társul.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sarjaan liittyvään vastuullisuusmerkintöön.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với thông tin liên quan tới nhận dạng các tác nhân có trách nhiệm đối với tùng thư.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de responsabilité qui est associée à une collection.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de responsabilitat que s’associa amb una col·lecció.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de responsabilidad que está asociada a una serie.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een verantwoordelijkheidsvermelding die geassocieerd is met een reeks.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en ansvarsangivelse knyttet til en serie.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en ophavsangivelse, som er knyttet til en serie.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a statement of responsibility that is associated with a series.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar atbildības ziņām, kas attiecas uz sēriju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse vastutusandmetega, mis on seotud seeriaga.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Verantwortlichkeitsangabe, die mit einer Reihe in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια μνεία που σχετίζεται με την ταύτιση των φορέων που είναι υπεύθυνοι για μια σειρά.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان مسئولية يرتبط بسلسلة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和丛编有关的一个责任说明关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30121 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30121">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de responsabilité relative à une édition</rdfs:label>
        <rdfs:label xml:lang="tr">basıma ilişkin sorumluluk bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có thông tin trách nhiệm liên quan tới ấn bản</rdfs:label>
        <rdfs:label xml:lang="et">editsiooniga seotud vastutusandmed</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di responsabilità relativa all’edizione</rdfs:label>
        <rdfs:label xml:lang="no">har ansvarsangivelse knyttet til utgave</rdfs:label>
        <rdfs:label xml:lang="da">har ophavsangivelse, som relaterer til udgave</rdfs:label>
        <rdfs:label xml:lang="sv">har upplagespecifik upphovsuppgift</rdfs:label>
        <rdfs:label xml:lang="en">has statement of responsibility relating to edition</rdfs:label>
        <rdfs:label xml:lang="de">hat Verantwortlichkeitsangabe, die sich auf eine Ausgabe bezieht</rdfs:label>
        <rdfs:label xml:lang="nl">heeft verantwoordelijkheidsvermelding gerelateerd aan editie</rdfs:label>
        <rdfs:label xml:lang="lv">izdevuma atbildības ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">kiadáshoz kötődő felelősségi közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painokseen liittyvä vastuullisuusmerkintö</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de responsabilidad relativa a la edición</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de responsabilitat relativa a una edició</rdfs:label>
        <rdfs:label xml:lang="el">έχει μνεία ευθύνης σχετική με την έκδοση</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان مسئولية مرتبط بطبعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有和版本有关的责任说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir basımla ilişkili bir sorumluluk bildirimiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di responsabilità associata a un’edizione.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy felelősségi közléshez, amely egy kiadáshoz társul.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation painokseen liittyvään vastuullisuusmerkintöön.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với thông tin liên quan tới nhận dạng các tác nhân có trách nhiệm đối với ấn bản đang được mô tả nhưng không phải tất cả các ấn bản.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de responsabilité qui est associée à une édition.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de responsabilitat que s’associa amb una edició.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de responsabilidad que está asociada a una edición.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een verantwoordelijkheidsvermelding die geassocieerd is met een editie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en ansvarsangivelse knyttet til en utgave.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en ophavsangivelse, som er knyttet til en udgave.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a statement of responsibility that is associated with an edition.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar atbildības ziņām, kas attiecas uz izdevumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse vastutusandmetega, mis on seotud editsiooniga.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Verantwortlichkeitsangabe, die mit einer Ausgabe in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια μνεία που σχετίζεται με την ταύτιση των φορέων που είναι υπεύθυνοι για μια περιγραφόμενη έκδοση αλλά όχι για όλες τις εκδόσεις.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان مسئولية يرتبط بطبعة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和版本有关的一个责任说明关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30122 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30122">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour émulsion sur microfilm et microfiche</rdfs:label>
        <rdfs:label xml:lang="vi">có thể sữa trên vi phim và vi phiếu</rdfs:label>
        <rdfs:label xml:lang="hu">emulziója mikrofilmen és mikrofilmlapon a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come emulsione su microfilm e microfiche</rdfs:label>
        <rdfs:label xml:lang="sv">har emulsion på mikrofilm och mikrofiche</rdfs:label>
        <rdfs:label xml:lang="da">har emulsion på mikrofilm og mikrofiche</rdfs:label>
        <rdfs:label xml:lang="no">har emulsjon på mikrofilm og mikrofilmkort</rdfs:label>
        <rdfs:label xml:lang="en">has emulsion on microfilm and microfiche</rdfs:label>
        <rdfs:label xml:lang="de">hat Emulsionsschicht auf Mikrofilm und Mikrofiche</rdfs:label>
        <rdfs:label xml:lang="nl">heeft emulsie op microfilm en microfiche</rdfs:label>
        <rdfs:label xml:lang="tr">mikrofilm ve mikrofiş üzerinde emülsiyon ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">mikrofilmas un mikrofišas emulsijas pārklājums</rdfs:label>
        <rdfs:label xml:lang="et">mikrofilmi ja mikrokaardi emulsioon</rdfs:label>
        <rdfs:label xml:lang="fi">mikrofilmin ja mikrokortin emulsio</rdfs:label>
        <rdfs:label xml:lang="es">tiene emulsión en microfilm y microficha</rdfs:label>
        <rdfs:label xml:lang="ca">té com a emulsió sobre microfilm i microfitxa</rdfs:label>
        <rdfs:label xml:lang="el">έχει γαλάκτωμα στη μικροταινία και το μικροδελτίο</rdfs:label>
        <rdfs:label xml:lang="ar">له طبقة حساسة على ميكروفيلم وميكروفيش</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有缩微胶卷和缩微平片上的乳剂</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir mikrofilm veya mikrofiş üzerinde kaplama olarak kullanılan ışığa duyarlı kimyasalların bir süspansiyonuyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una sospensione di sostanza chimica fotosensibile utilizzata come uno strato su un microfilm o una microfiche.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát fényérzékeny vegyszerek szuszpenziójához, amelyet bevonatként használnak mikrofilmen vagy mikrofilmlapon.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation mikrofilmin tai mikrokortin valoherkkiä kemikaaleja sisältävään pinnoitteeseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với thể vẩn của hoá chất nhậy sáng được sử dụng như là lớp phủ trên vi phim hoặc vi phiếu.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une suspension de produits chimiques photosensibles qui est utilisée comme revêtement sur un microfilm ou une microfiche.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una suspensió de substàncies químiques sensibles a la llum que s’usa com a revestiment d’un microfilm o una microfitxa.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una suspensión de sustancias químicas sensibles a la luz que se utiliza como recubrimiento en un microfilm o microficha.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een suspensie van lichtgevoelige chemicaliën die gebruikt is als coating op microfilm of microfiche.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en suspensjon av lysfølsomme kjemikalier som er brukt som belegg på mikrofilm eller mikrofilmkort.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en opslæmning af lysfølsomme kemikalier, som anvendes som belægning på en mikrofilm eller mikrofiche.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a suspension of light-sensitive chemicals that is used as a coating on a microfilm or microfiche.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar gaismas jutīgu ķimikāliju slāni, ar kuru pārklāj mikrofilmas vai mikrofišas.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse valgustundliku kemikaali kihiga, mida on kasutatud mikrofilmi või mikrokaardi pinna katmiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Suspension aus lichtempfindlichen Chemikalien, die als Beschichtung eines Mikrofilms oder eines Mikrofiches verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα αιώρημα χαμηλής ευαισθησίας χημικών που χρησιμοποιείται ως επίστρωση πάνω σε μικροταινία ή σε μικροδελτίο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ونظام تسجيل خاص بالمواد الكيميائية المستخدمة كغطاء على ميكروفيلم أو ميكروفيش.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与缩微胶卷或缩微平片表面感光化合物的悬浮涂层关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30123 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30123">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour norme de diffusion</rdfs:label>
        <rdfs:label xml:lang="lv">apraides standarts</rdfs:label>
        <rdfs:label xml:lang="vi">có chuẩn phát sóng</rdfs:label>
        <rdfs:label xml:lang="it">ha come standard di trasmissione</rdfs:label>
        <rdfs:label xml:lang="no">har kringkastingsstandard</rdfs:label>
        <rdfs:label xml:lang="sv">har sändningsstandard</rdfs:label>
        <rdfs:label xml:lang="da">har transmissionsstandard</rdfs:label>
        <rdfs:label xml:lang="en">has broadcast standard</rdfs:label>
        <rdfs:label xml:lang="de">hat Sendestandard</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitzendstandaard</rdfs:label>
        <rdfs:label xml:lang="et">leviedastusstandard</rdfs:label>
        <rdfs:label xml:lang="fi">lähetysstandardi</rdfs:label>
        <rdfs:label xml:lang="hu">műsorszórási szabványa a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene estándar de transmisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a estàndard d’emissió</rdfs:label>
        <rdfs:label xml:lang="tr">yayın standardı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει πρότυπο εκπομπής</rdfs:label>
        <rdfs:label xml:lang="ar">له معيار بث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播标准</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, televizyon yayını için bir videonun bir gösterimini formatlamak için kullanılan bir sistemle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un sistema utilizzato per la formattazione di una risorsa video per la trasmissione televisiva.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy rendszerhez, amelyet egy televíziós közvetítésre szánt videó megjelenési formájának a formátumaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation järjestelmään, jonka mukaan videoaineiston manifestaatio muunnetaan televisiolähetystä varten.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với hệ thống được sử dụng để định dạng biểu thị của video cho phát sòng truyền hình.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un système utilisé pour formater une manifestation d’une vidéo pour la télédiffusion.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un sistema usat per formatar una manifestació d’un vídeo per a l’emissió per televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un sistema utilizado para formatear una manifestación de un video para transmisión televisiva.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een systeem gebruikt voor het formatteren van een video resource voor televisie-uitzending.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et system for å formatere en videomanifestasjon for fjernsynskringkasting.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et system, som anvendes til at formatere en videomanifestation til tv-transmission.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a system used to format a manifestation of a video for television broadcast.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sistēmu, ko lieto, lai pārveidotu video manifestāciju televīzijas pārraides vajadzībām.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse standardiga, mida on kasutatud videoressursi kehastuse muundamiseks teleülekande jaoks sobivasse formaati.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem System, das zur Formatierung einer Manifestation eines Videos für eine Fernsehsendung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα σύστημα που χρησιμοποιείται για τη διαμόρφωση μιας εκδήλωσης ενός βίντεο για τηλεοπτική εκπομπή.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ونظام مستخدم لتهيئة تجسيدة من فيديو للبث التلفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于电视广播的视频的一种载体表现的格式的一个体系关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30124 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30124">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour caractéristique de fichier numérique</rdfs:label>
        <rdfs:label xml:lang="vi">có đặc trưng tệp số</rdfs:label>
        <rdfs:label xml:lang="lv">datnes raksturojums</rdfs:label>
        <rdfs:label xml:lang="fi">digitaalisen tiedoston ominaisuus</rdfs:label>
        <rdfs:label xml:lang="hu">digitális fájl jellemzője a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">dijital dosya özelliği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">faili tunnus</rdfs:label>
        <rdfs:label xml:lang="it">ha come caratteristica del file digitale</rdfs:label>
        <rdfs:label xml:lang="da">har digitale filkarakteristika</rdfs:label>
        <rdfs:label xml:lang="no">har digtal filkarakteristikk</rdfs:label>
        <rdfs:label xml:lang="sv">har egenskaper för resursens digitala kodning</rdfs:label>
        <rdfs:label xml:lang="en">has digital file characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Eigenschaft einer digitalen Datei</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kenmerken digitale bestand</rdfs:label>
        <rdfs:label xml:lang="es">tiene característica de archivo digital</rdfs:label>
        <rdfs:label xml:lang="ca">té com a característica de fitxer digital</rdfs:label>
        <rdfs:label xml:lang="el">έχει χαρακτηριστικό του ψηφιακού αρχείου</rdfs:label>
        <rdfs:label xml:lang="ar">له خاصية ملف رقمي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有数字文件特征</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki metin, görüntü, ses, video veya diğer veri türlerinin dijital olarak kodlanmasıyla ilgili teknik bir şartnameyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una specifica tecnica relativa alla codifica digitale di testo, immagine, audio, video e altri tipi di dati in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy műszaki specifikációhoz, amely egy megjelenési formában a szöveg, kép, hang, videó és más adattípusok digitális kódolásához kapcsolódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaation sisältämän tekstin, kuvan, äänen, videon tai muun datan digitaaliseen koodauksen tekniseen määritykseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với đặc tính kỹ thuật liên quan tới ghi mã kỹ thuật số cho văn bản, hình ảnh, audio, video, và các loại dữ liệu khác trong biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une spécification technique relative à l’encodage numérique de données textuelles, image, audio, vidéo ou d’autres types dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una especificació tècnica relativa a la codificació digital de text, d’imatge, d’àudio, de vídeo o d’altres tipus de dades d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una especificación técnica relativa a la codificación digital de texto, imagen, audio, video u otro tipo de datos en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een technische specificatie gerelateerd aan de digitale codering van tekst, beeld geluid, video, of andere vormen van gegevens in een resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en teknisk spesifikasjon knyttet til den digitale kodingen av tekst, bilder, lyd, video og andre typer data i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en teknisk specifikation, som relaterer til den digitale kodning af tekst, billede, audio-, video- og andre datatyper i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a technical specification relating to the digital encoding of text, image, audio, video, or other types of data in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas tekstu, attēlu, audio, video un citu datu tipu digitālo kodējumu, piem., ieraksta blīvums, sektoru skaits.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tehnilise kirjeldusega, mis puudutab kehastuses sisalduva teksti, kujutise, heli, video jm tüüpi andmete digitaalset kodeeringut.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer technischen Spezifikation, die sich auf die digitale Kodierung von Text, Bild, Audio, Video oder anderen Datentypen in einer Manifestation bezieht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια τεχνική προδιαγραφή που σχετίζεται με την ψηφιακή κωδικοποίηση του κειμένου, της εικόνας, του ήχου, του βίντεο και άλλων τύπων δεδομένων σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وخصائص فنية متعلقة بالتكويد الرقمي لنص، وصورة، وصوت، وفيديو، وأي نوع بيانات آخر في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现中的文本、图像、音频、视频或其他类型数据的数字编码有关的一个技术规格关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30125 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30125">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour caractéristique sonore</rdfs:label>
        <rdfs:label xml:lang="vi">có đặc trưng âm thanh</rdfs:label>
        <rdfs:label xml:lang="it">ha come caratteristica del suono</rdfs:label>
        <rdfs:label xml:lang="hu">hangjellemzője a következő:</rdfs:label>
        <rdfs:label xml:lang="sv">har ljudkaraktäristiska</rdfs:label>
        <rdfs:label xml:lang="no">har lydegenskaper</rdfs:label>
        <rdfs:label xml:lang="da">har lydkarakteristika</rdfs:label>
        <rdfs:label xml:lang="en">has sound characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Toneigenschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kenmerken geluid</rdfs:label>
        <rdfs:label xml:lang="et">heli tunnus</rdfs:label>
        <rdfs:label xml:lang="tr">ses özelliği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņas raksturojums</rdfs:label>
        <rdfs:label xml:lang="es">tiene característica de sonido</rdfs:label>
        <rdfs:label xml:lang="ca">té com a característica de so</rdfs:label>
        <rdfs:label xml:lang="fi">äänen ominaisuudet</rdfs:label>
        <rdfs:label xml:lang="el">έχει χαρακτηριστικό του ήχου</rdfs:label>
        <rdfs:label xml:lang="ar">له خاصية صوت</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有声音特征</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki sesin kodlanmasıyla ilgili teknik bir şartnameyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una specifica tecnica relativa alla codifica del suono in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy műszaki specifikációhoz, amely egy megjelenési formában a hang kódolásához kapcsolódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaation sisältämän äänen koodaamisen tekniseen määritykseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với đặc tính kỹ thuật liên quan tới ghi mã âm thanh trong biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une spécification technique relative à l’encodage du son dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una especificació tècnica relativa a la codificació del so d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una especificación técnica relativa a la codificación del sonido en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een technische specificatie gerelateerd aan de codering van geluid in een resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en teknisk spesifikasjon knyttet til kodingen av lyd i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en teknisk specifikation, som relaterer til kodningen af lyd i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a technical specification relating to the encoding of sound in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar tehnisko specifikāciju, kas attiecas uz skaņas kodējumu manifestācijā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tehnilise kirjeldusega, mis puudutab kehastuses sisalduva heli kodeeringut.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer technischen Spezifikation, die sich auf die Kodierung des Tons in einer Manifestation bezieht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια τεχνική προδιαγραφή που σχετίζεται με την κωδικοποίηση του ήχου σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وخصائص فنية متعلقة بالتكويد لصوت في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现中的声音的编码有关的一个技术规格关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30126 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30126">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour caractéristique vidéo</rdfs:label>
        <rdfs:label xml:lang="vi">có đặc trưng video</rdfs:label>
        <rdfs:label xml:lang="it">ha come caratteristica video</rdfs:label>
        <rdfs:label xml:lang="no">har videoegenskaper</rdfs:label>
        <rdfs:label xml:lang="da">har videokarakteristika</rdfs:label>
        <rdfs:label xml:lang="sv">har videokaraktäristika</rdfs:label>
        <rdfs:label xml:lang="en">has video characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Video-Eigenschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kenmerken video</rdfs:label>
        <rdfs:label xml:lang="es">tiene característica de vídeo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a característica vídeo</rdfs:label>
        <rdfs:label xml:lang="lv">video raksturojums</rdfs:label>
        <rdfs:label xml:lang="et">video tunnus</rdfs:label>
        <rdfs:label xml:lang="tr">video özelliği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">videon ominaisuudet</rdfs:label>
        <rdfs:label xml:lang="hu">videójellemzője a következő:</rdfs:label>
        <rdfs:label xml:lang="el">έχει χαρακτηριστικό του βίντεο</rdfs:label>
        <rdfs:label xml:lang="ar">له خاصية فيديو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有视频特征</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki video görüntülerinin kodlanmasıyla ilgili bir teknik şartnameyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una specifica tecnica relativa alla codifica di immagini video di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy műszaki specifikációhoz, amely egy megjelenési formában a videóképek kódolásához kapcsolódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaation sisältämän videon koodauksen tekniseen määritykseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với đặc tính kỹ thuật liên quan tới ghi mã hình ảnh video trong biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une spécification technique relative à l’encodage des images vidéo dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una especificació tècnica relativa a la codificació d’imatges de vídeo d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una especificación técnica relativa a la codificación de imágenes de vídeo en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een technische specificatie gerelateerd aan de codering van videobeelden in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en teknisk spesifikasjon knyttet til kodingen av videobilder i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en teknisk specifikation, som relaterer til kodningen af videobilleder i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a technical specification relating to the encoding of video images in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar tehnisko specifikāciju, kas attiecas uz videoattēlu kodējumu manifestācijā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tehnilise kirjeldusega, mis puudutab kehastuses sisalduvate videokujutiste kodeeringut.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer technischen Spezifikation, die sich auf die Kodierung von Videobildern in einer Manifestation bezieht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια τεχνική προδιαγραφή που σχετίζεται με την κωδικοποίηση των εικόνων βίντεο σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وخصائص فنية متعلقة بتكويد الفيديو في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现中的视频的编码有关的一个技术规格关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30127 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30127">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour caractéristique de projection d’un film cinématographique</rdfs:label>
        <rdfs:label xml:lang="vi">có đặc trưng chiếu của phim điện ảnh</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvafilmin projisointiominaisuudet</rdfs:label>
        <rdfs:label xml:lang="it">ha come caratteristica di proiezione di pellicola cinematografica</rdfs:label>
        <rdfs:label xml:lang="no">har projeksjonsegenskaper for spillefilm</rdfs:label>
        <rdfs:label xml:lang="sv">har projektionskaraktäristika för film</rdfs:label>
        <rdfs:label xml:lang="da">har projiceringskarakteristika for spillefilm</rdfs:label>
        <rdfs:label xml:lang="en">has projection characteristic of motion picture film</rdfs:label>
        <rdfs:label xml:lang="de">hat Projektionseigenschaft von Filmen</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kenmerken van de projectie van speelfilm</rdfs:label>
        <rdfs:label xml:lang="lv">kinofilmas demonstrēšanas raksturlielumi</rdfs:label>
        <rdfs:label xml:lang="et">kinofilmi projitseerimistunnus</rdfs:label>
        <rdfs:label xml:lang="hu">mozgókép vetítési jellemzője a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">sinema filminin projeksiyon özelliği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene la característica de proyección de una película cinematográfica</rdfs:label>
        <rdfs:label xml:lang="ca">té com a característica de projecció d’una pel·lícula cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="el">έχει χαρακτηριστικό της προβολής της κινηματογραφικής ταινίας</rdfs:label>
        <rdfs:label xml:lang="ar">له خاصية عرض لفيلم صور متحركة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影胶卷的投影特征</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir sinema filminin gösterimiyle ilgili teknik bir teknik ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una specifica tecnica relativa alla proiezione di un film.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy műszaki specifikációhoz, amely egy filmen lévő mozgókép vetítéséhez kapcsolódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation elokuvafilmin projisointia koskevaan tekniseen määritykseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với đặc tính kỹ thuật liên quan tới chiếu phim điện ảnh.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une spécification technique relative à la projection d’un film cinématographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una especificació tècnica relativa a la projecció d’una pel·lícula cinematogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una especificación técnica relativa a la proyección de una película cinematográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een technische specificatie gerelateerd aan de projectie van een speelfilm.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en teknisk spesifikasjon knyttet til projeksjonen av en spillefilm.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en teknisk specifikation, som relaterer til projiceringen af en spillefilm.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a technical specification relating to the projection of a motion picture film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar tehnisko specifikāciju, kas attiecas uz kinofilmu demonstrēšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tehnilise kirjeldusega, mis puudutab kinofilmi projitseerimist.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer technischen Spezifikation, die sich auf die Projektion eines Films bezieht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια τεχνική προδιαγραφή που σχετίζεται με την προβολή μιας κινηματογραφικής ταινίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وخصائص فنية متعلقة بعرض فيلم صور متحركة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种电影胶卷的投影有关的技术规格关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30128 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30128">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour variante de titre de manifestation</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề khác</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin alternatif başlığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo variante della manifestazione</rdfs:label>
        <rdfs:label xml:lang="no">har tittelvariant for manifestasjon</rdfs:label>
        <rdfs:label xml:lang="da">har variant af titel på manifestation</rdfs:label>
        <rdfs:label xml:lang="sv">har varianttitel</rdfs:label>
        <rdfs:label xml:lang="en">has variant title of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat abweichenden Titel einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft variant titel van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse variantpealkiri</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation varianttinimeke</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas cits nosaukums</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma címváltozata a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene título variante de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a variant de títol de manifestació</rdfs:label>
        <rdfs:label xml:lang="el">έχει εναλλακτικό τίτλο</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان مختلف لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的变异题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, belirli bir uygulama veya bağlamda tercih edilmeyen bir gösterimin unvanı olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un titolo della manifestazione non scelto come preferito in una specifica applicazione o contesto.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy nomenhez, amely egy olyan megjelenési formához tartozó cím, amelyet egy adott alkalmazásban vagy kontextusban nem részesítenek előnyben.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on manifestaation nimeke, jota ei ole valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với nhan đề liên quan tới biểu thị khác với nhan đề được ghi như là nhan đề hợp thức, nhan đề hợp thức song song, thông tin nhan đề khác, thông tin nhan đề khác song song, nhan đề hợp thức trước đây, nhan đề hợp thức sau này, nhan đề khoá, hoặc nhan đề tắt.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un titre de manifestation ne faisant pas l’objet d’un choix privilégié dans une application ou un contexte spécifiques.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un títol de manifestació que no se selecciona com a preferent en una aplicació o un context específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es un título de manifestación que no se selecciona de preferencia en una aplicación o contexto específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een titel van manifestatie die niet als voorkeursterm geselecteerd is in een specifieke toepassing of context.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en tittel for manifestasjon som ikke er valgt som foretrukket tittel i en spesifikk applikasjon eller kontekst.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en titel på manifestation, som ikke er valgt som præference i en specifik anvendelse eller kontekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is a title of manifestation that is not selected for preference in a specific application or context.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir manifestācijas nosaukums, kas nav izvēlēts kā prioritārs noteiktā lietojumprogrammā vai kontekstā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse pealkirjaga, mis kindlas rakenduses või kontekstis ei ole valitud eelistatuks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Titel einer Manifestation, der in einer bestimmten Anwendung oder in einem bestimmten Kontext nicht als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με έναν τίτλο που συνδέεται με μια εκδήλωση που διαφέρει από έναν τίτλο που καταχωρίστηκε ως κύριος τίτλος, ως παράλληλος κύριος τίτλος, ως άλλες πληροφορίες σχετικές με τον τίτλο, ως άλλες πληροφορίες σχετικές με τον παράλληλο τίτλο, ως προηγούμενος κύριος τίτλος, ως μεταγενέστερος κύριος τίτλος, ως τίτλος κλειδί ή ως συντομευμένος τίτλος.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعنوان تجسيدة لم يتم اختياره للتفضيل في تطبيق أو سياق محدد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为载体表现的一个题名但未在特定的应用或语境中被首选的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30131 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30131">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour titre abrégé</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề tắt</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo abbreviato</rdfs:label>
        <rdfs:label xml:lang="da">har forkortet titel</rdfs:label>
        <rdfs:label xml:lang="no">har forkortet tittel</rdfs:label>
        <rdfs:label xml:lang="sv">har förkortad titel</rdfs:label>
        <rdfs:label xml:lang="en">has abbreviated title</rdfs:label>
        <rdfs:label xml:lang="de">hat Kurztitel</rdfs:label>
        <rdfs:label xml:lang="nl">heeft verkorte titel</rdfs:label>
        <rdfs:label xml:lang="tr">kısaltılmış başlık ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">lyhennetty nimeke</rdfs:label>
        <rdfs:label xml:lang="et">lühendatud pealkiri</rdfs:label>
        <rdfs:label xml:lang="hu">rövidített címe a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">saīsināts nosaukums</rdfs:label>
        <rdfs:label xml:lang="es">tiene título abreviado</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol abreujat</rdfs:label>
        <rdfs:label xml:lang="el">έχει συντομευμένο τίτλο</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان مختصر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有缩略题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi,dizinleme veya tanımlama amacıyla kısaltılmış bir başlık olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un titolo abbreviato per scopi di indicizzazione o identificazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy nomenhez, amely egy indexelés vagy azonosítás céljából rövidített cím.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on indeksointia tai tunnistamista varten lyhennetty nimeke.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với nhan đề được rút gọn nhằm mục đích định chỉ mục hoặc nhận dạng.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un titre qui a été abrégé à des fins d’indexation ou d’identification.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un títol que ha estat abreujat amb la finalitat de la indexació o la identificació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es un título que ha sido abreviado con fines de indexación o identificación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een titel die is verkort ten behoeve van indexering of identificatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en tittel som har blitt forkortet for indekserings- eller identifiseringsformål.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en titel, som er forkortet med henblik på indeksering eller identifikation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is a title that has been abbreviated for purposes of indexing or identification.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir saīsināts nosaukums prekšmetošanas vai indeksēšanas vajadzībām.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse pealkirjaga, mis on esitatud indekseerimise või identifitseerimise tarbeks lühendatud kujul.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Titel, der zum Zwecke der Indexierung oder der Identifizierung gekürzt wurde.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με έναν τίτλο που έχει συντμηθεί για τους σκοπούς της ευρετηρίασης ή της ταύτισης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعنوان تم اختصاره لأغراض التكشيف أو التحديد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为一个题名并为索引或标识的目的而被缩略的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30134 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30134">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour titre de manifestation</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim başlığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo di manifestazione</rdfs:label>
        <rdfs:label xml:lang="sv">har titel</rdfs:label>
        <rdfs:label xml:lang="da">har titel på manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har tittel for manifestasjon</rdfs:label>
        <rdfs:label xml:lang="en">has title of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Titel einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft titel van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse pealkiri</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation nimeke</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas nosaukums</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma címe a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene título de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol de manifestació</rdfs:label>
        <rdfs:label xml:lang="el">έχει τίτλο</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, doğal dilde gösterimin bir adı olan bir adla ve ortak söylemde kullanılan ifadelerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una denominazione di manifestazione espressa in una lingua e formulazione naturali, usata nella lingua corrente.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy nomenhez, amely egy a megjelenési formához tartozó természetes nyelvű megnevezés és a közbeszédben használt megfogalmazás.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on manifestaation nimitys, joka on luonnollisen kielen ja yleisen diskurssin sanamuodon mukainen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với từ, ký tự, hoặc nhóm từ hoặc ký tự mà tên của biểu thị hoặc tác phẩm được thể hiện trong đó.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est une appellation de manifestation exprimée dans un langage et une formulation naturels et utilisée dans le langage courant.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és una apel·lació de manifestació en llenguatge i frases naturals usada en el discurs comú.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es una denominación de manifestación en lenguaje natural y fraseo usado en el discurso común.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een benaming van manifestatie in natuurlijke taal en terminologie in gebruikelijke bewoording.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en betegnelse for manifestasjon på et naturlig språk og med en frasering brukt i alminnelig diskurs.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en benævnelse på manifestation på normalsprog og med formuleringer, som bruges alment.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is an appellation of manifestation in natural language and phrasing used in common discourse.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir vārds vai vārdu, vai rakstzīmju grupa, kas nosauc tajā ietverto manifestāciju vai darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse nimetusega loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Bezeichnung für eine Manifestation in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια λέξη, έναν χαρακτήρα ή μια ομάδα λέξεων ή χαρακτήρων που κατονομάζουν μια εκδήλωση ή με ένα έργο που είναι ενσωματωμένο σε αυτήν [την εκδήλωση].</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتسمية تجسيدة في اللغة الطبيعية والتسمية المستخدمة في الخطاب العام.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为用自然语言和普通话语措词表达的一种载体表现之称谓的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30137 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30137">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour note sur une manifestation</rdfs:label>
        <rdfs:label xml:lang="vi">có ghi chú về biểu thị</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim hakkında not ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come nota sulla manifestazione</rdfs:label>
        <rdfs:label xml:lang="sv">har anmärkning om manifestationen</rdfs:label>
        <rdfs:label xml:lang="no">har note om manifestasjon</rdfs:label>
        <rdfs:label xml:lang="da">har note om manifestation</rdfs:label>
        <rdfs:label xml:lang="en">has note on manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Anmerkung zur Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft noot bij manifestatie</rdfs:label>
        <rdfs:label xml:lang="fi">huomautus manifestaatiosta</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési formára tett megjegyzése a következő:</rdfs:label>
        <rdfs:label xml:lang="et">märkus kehastuse kohta</rdfs:label>
        <rdfs:label xml:lang="lv">piezīme par manifestāciju</rdfs:label>
        <rdfs:label xml:lang="es">tiene nota sobre la manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a nota sobre una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">έχει σημείωση στην εκδήλωση</rdfs:label>
        <rdfs:label xml:lang="ar">له تبصرة عن تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有关于载体表现的附注</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin bir veya daha fazla niteliğinin geniş, yapılandırılmamış bir tanımlamasıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una descrizione non strutturata generale di uno o più attributi di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma egy vagy több ismérvének szabad szöveges, strukturálatlan leírásához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yleisluonteiseen rakenteistamattomaan kuvailuun, joka sisältää manifestaation yhden tai useamman attribuutin.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với ghi chú cung cấp thông tin phụ trợ về thuộc tính của biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une description non structurée générale d’un ou plusieurs attributs d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una descripció no estructurada àmplia d’un o més atributs d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una descripción amplia y no estructurada de uno o más atributos de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een noot die aanvullende informatie over attributen van een manifestatie verschaft.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en bred ustrukturert beskrivelse av ett eller flere attributter til en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en bred, ustruktureret beskrivelse af en eller flere af en manifestations attributter.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a broad unstructured description of one or more attributes of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar plašu nestrukturētu manifestācijas vienu vai vairākiem atribūtu aprakstiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse üldise struktureerimata kirjeldusega, mis iseloomustab üht või mitut kehastuse omadust.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer umfassenden, unstrukturierten Beschreibung eines Merkmals oder mehrerer Merkmale einer Manifestation.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια σημείωση που παρέχει πρόσθετες πληροφορίες σχετικά με τις ιδιότητες της εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووصف عريض غير مهيكل لواحدة أو أكثر من خواص تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种载体表现的一个或多个属性的一个宽泛的非结构化描述关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30138 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30138">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour caractéristique de lecture particulière</rdfs:label>
        <rdfs:label xml:lang="vi">có đặc trưng phát lại đặc biệt</rdfs:label>
        <rdfs:label xml:lang="it">ha come caratteristica di riproduzione speciale</rdfs:label>
        <rdfs:label xml:lang="sv">har specifika uppspelningskaraktäristika</rdfs:label>
        <rdfs:label xml:lang="no">har spesiell avspillingsegenskap</rdfs:label>
        <rdfs:label xml:lang="da">har særlige afspilningskarakteristika</rdfs:label>
        <rdfs:label xml:lang="en">has special playback characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat besondere Wiedergabeeigenschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft speciale afspeelkenmerken</rdfs:label>
        <rdfs:label xml:lang="et">heli taasesituse eritunnus</rdfs:label>
        <rdfs:label xml:lang="lv">specifiska atskaņojuma pazīme</rdfs:label>
        <rdfs:label xml:lang="hu">speciális visszajátszási jellemzője a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene una característica de reproducción especial</rdfs:label>
        <rdfs:label xml:lang="ca">té com a característica especial de reproducció</rdfs:label>
        <rdfs:label xml:lang="fi">äänentoiston erityisominaisuudet</rdfs:label>
        <rdfs:label xml:lang="tr">özel oynatma özelliği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει ειδικό χαρακτηριστικό της αναπαραγωγής</rdfs:label>
        <rdfs:label xml:lang="ar">له خاصية خاصة للتشغيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有特别回放特征</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir ses kaydı yapmak için kullanılan bir eşitleme sistemi, gürültü azaltma sistemi veya diğer işlemlerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un sistema di equalizzazione, sistema di riduzione del rumore, etc. utilizzato nella realizzazione di una registrazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kiegyenlítési rendszerhez, hangcsökkentő rendszerhez vagy egyéb eljáráshoz, amelyet egy hangfelvétel készítésénél használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation äänitteen äänityksessä käytettyyn taajuuskorjausjärjestelmään, kohinanvaimennusjärjestelmään tai muuhun prosessointiin.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với hệ thống ngang bằng, hệ thống giảm tiếng ồn, v.v..., được sử dụng để tạo bản ghi audio.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un système d’égalisation, un système de réduction du bruit ou un autre traitement qui est utilisé lors de la réalisation d’un enregistrement audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un sistema d’equalització, de reducció de soroll o d’un altre processament que s’utilitza en fer un enregistrament àudio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un sistema de ecualización, sistema de reducción de ruido u otro procesamiento que se utiliza para realizar una grabación de audio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een equalisatiesysteem, ruisonderdrukkend systeem of ander systeem dat is gebruikt bij het maken van een geluidsopname.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et system for tonekontroll, støyreduksjon etc. som brukes ved produksjon av lydopptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et equalizersystem, støjbegrænsningssystem etc., som anvendes til at lave en lydoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an equalization system, noise-reduction system, or other processing that is used in making an audio recording.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar skaņu izlīdzināšanas sistēmu, trokšņu samazināšanas sistēmu, u.tml., kas izmantota skaņas ieraksta veidošanā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse heli salvestamisel kasutatud tasandussüsteemiga, müravähendussüsteemiga vms.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Ausgleichssystem, einem Störgeräusch-Reduktionssystem oder einer anderen Verarbeitung, das/die bei der Erstellung von Audioaufnahmen verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα σύστημα εξισορρόπησης, ένα σύστημα μείωσης του θορύβου κ.λπ. που χρησιμοποιείται στην κατασκευή μιας ηχογράφησης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ونظام صوت، ونظام خفض ضوضاء، إلخ. مستخدم في إعداد تسجيل صوتي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与在一种录音制作中所使用的平衡系统、降噪系统或其他处理关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30140 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30140">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour item en relation avec une manifestation</rdfs:label>
        <rdfs:label xml:lang="lv">ar manifestāciju saistītā vienība</rdfs:label>
        <rdfs:label xml:lang="vi">có biểu thị bản có liên quan</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin ilgili kopyası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come item di manifestazione correlato</rdfs:label>
        <rdfs:label xml:lang="da">har eksemplar relateret til manifestation</rdfs:label>
        <rdfs:label xml:lang="sv">har relaterat exemplar</rdfs:label>
        <rdfs:label xml:lang="no">har relatert eksemplar av manifestasjon</rdfs:label>
        <rdfs:label xml:lang="en">has related item of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat mit Manifestation in Beziehung stehendes Exemplar</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gerelateerd item van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastusega seotud eksemplar</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaatioon liittyvä kappale</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma kapcsolódó példánya a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene un elemento de manifestación relacionado</rdfs:label>
        <rdfs:label xml:lang="ca">té com a ítem relacionat amb una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχετικό αντίτυπο (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">له مفردة متعلقة بالتجسيد</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的关联单件</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimle ilişkili bir kopyayla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un item associato a una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy példányhoz, amelyet egy megjelenési formához társítanak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation kappaleeseen, joka liittyy manifestaatioon.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với bản liên quan tới biểu thị đang được mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un item qui est associé à une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un ítem que s’associa amb una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un elemento que está asociado con una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een item dat is geassocieerd met het item dat beschreven wordt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et eksemplar som forbindes med en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et eksemplar, som er knyttet til en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an item that is associated with a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar vienību, kas ir saistīta ar manifestāciju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse eksemplariga, mis on kehastusega seotud.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Exemplar, das mit einer Manifestation in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα αντίτυπο που συνδέεται με μια περιγραφόμενη εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومفردة مرتبطة بتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现有关的一个单件关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30146 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30146">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour restriction d’usage d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="vi">có hạn chế về sử dụng biểu thị</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin kullanım kısıtlaması ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come limitazioni d&apos;uso di una manifestazione</rdfs:label>
        <rdfs:label xml:lang="sv">har användningsrestriktioner</rdfs:label>
        <rdfs:label xml:lang="no">har restriksjoner for bruk av manifestasjon</rdfs:label>
        <rdfs:label xml:lang="da">har restriktion på brug af manifestation</rdfs:label>
        <rdfs:label xml:lang="en">has restriction on use of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Benutzungsbeschränkung einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft beperking op gebruik van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse kasutuspiirang</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation käyttöehdot</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas izmantošanas ierobežojums</rdfs:label>
        <rdfs:label xml:lang="es">tiene restricción en el uso de la manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a restricció d’ús d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="hu">van megjelenési forma használatához rendelt korlátozása</rdfs:label>
        <rdfs:label xml:lang="el">έχει περιορισμό της χρήσης της εκδήλωσης</rdfs:label>
        <rdfs:label xml:lang="ar">له تقييد على استخدام تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有关于载体表现使用的限制</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin çoğaltılmasına, yayınlanmasına, sergilenmesine vb. konulan bir sınırlamayla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione  a restrizioni poste alla riproduzione, pubblicazione, esposizione, etc. di una manifstazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy korlátozáshoz, amelyet egy megjelenési forma másolásához, publikálásához, kiállításához stb. rendelnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaation käyttörajoituksiin koskien esim. kopiointia, julkaisemista tai esille asettamista.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với giới hạn được đặt ra về sản xuất lại, xuất bản, triển lãm, v.v..., biểu thị</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une limitation imposée sur la reproduction, la publication, l’exposition, etc. d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una limitació imposada sobre la reproducció, la publicació, l’exposició, etc., d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una limitación impuesta a la reproducción, publicación, exhibición, etc., de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een beperking geplaatst op de reproductie, publicatie, tentoonstelling, etc. van een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en begrensning for reproduksjon, utgivelse, utstilling etc. av en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en begrænsning af reproduktion, publicering, udstilling etc. af en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a limitation placed on reproduction, publication, exhibition, etc., of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas izmantošanas ierobežojumiem pavairošanā, izgatavošanā, izrādīšanā u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse piiranguga, mis on kehtestatud kehastuse reprodutseerimisele, avaldamisele, eksponeerimisele jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beschränkung der Verwendungsart einer Manifestation, wie zum Beispiel Reproduktion, Veröffentlichung, Ausstellung und so weiter.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με έναν περιορισμό που ανατίθεται σε μια αναπαραγωγή, μια δημοσίευση, μια έκθεση κ.λπ. μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وقيود وفقًا للمكان تتعلق باستنساخ، ونشر، وعرض، إلخ. لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与对一种载体表现的复制、出版、展览等施加的限制关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30155 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30155">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour disposition</rdfs:label>
        <rdfs:label xml:lang="vi">có sắp đặt</rdfs:label>
        <rdfs:label xml:lang="tr">düzen ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come layout</rdfs:label>
        <rdfs:label xml:lang="da">har layout</rdfs:label>
        <rdfs:label xml:lang="no">har layout</rdfs:label>
        <rdfs:label xml:lang="sv">har layout</rdfs:label>
        <rdfs:label xml:lang="en">has layout</rdfs:label>
        <rdfs:label xml:lang="de">hat Layout</rdfs:label>
        <rdfs:label xml:lang="nl">heeft opmaak</rdfs:label>
        <rdfs:label xml:lang="et">küljendus</rdfs:label>
        <rdfs:label xml:lang="fi">layout</rdfs:label>
        <rdfs:label xml:lang="lv">salikums</rdfs:label>
        <rdfs:label xml:lang="es">tiene diseño</rdfs:label>
        <rdfs:label xml:lang="ca">té com a disposició</rdfs:label>
        <rdfs:label xml:lang="hu">tördelése a következő:</rdfs:label>
        <rdfs:label xml:lang="el">έχει τυπογραφική διάταξη</rdfs:label>
        <rdfs:label xml:lang="ar">له تصميم طباعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有版式</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki metin, resimler, dokunsal notasyon veya diğer içeriğin bir düzenlemesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una disposizione del testo, immagini, notazione tattile, etc. in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát szöveg, képek, tapintható lejegyzés vagy egyéb tartalom elrendezéséhez egy megjelenési formában.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatioon sisältyvän tekstin, kuvien, taktiilin nuottikirjoituksen tai muun sisällön sommitteluun.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với sự sắp xếp của văn bản, hình ảnh, ký hiệu xúc giác, v.v..., trong biểu hiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agencement du texte, des images, de la notation tactile ou de tout autre contenu dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un arranjament del text, les imatges, la notació tàctil o un altre contingut d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una disposición de texto, imágenes, notación táctil u otro contenido en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een rangschikking van tekst, beeld, tactiele notatievormen of andere content in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en ordning av tekst, bilder, berøringsnotasjon etc. i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til opstilling af tekst, billeder, taktil notation etc. i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an arrangement of text, images, tactile notation, or other content in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar teksta, attēla, u.tml. izkārtojumu manifestācijā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse teksti, piltide, taktiilse notatsiooni jms paigutusega kehastuses.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Anordnung von Text, Bildern, taktiler Notation oder anderem Inhalt in einer Manifestation.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια οργάνωση κειμένου, εικόνων, απτικής σημειογραφίας κ.λπ. σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وترتيب النص، والصور، والكتابة البارزة، إلخ. في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与载体表现中对文本、图像、触摸标记或其他内容的安排关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30156 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30156">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour titre propre</rdfs:label>
        <rdfs:label xml:lang="tr">başlık ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề hợp thức</rdfs:label>
        <rdfs:label xml:lang="hu">főcíme a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo proprio</rdfs:label>
        <rdfs:label xml:lang="da">har hovedtitel</rdfs:label>
        <rdfs:label xml:lang="no">har hovedtittel</rdfs:label>
        <rdfs:label xml:lang="sv">har huvudtitel</rdfs:label>
        <rdfs:label xml:lang="en">has title proper</rdfs:label>
        <rdfs:label xml:lang="de">hat Haupttitel</rdfs:label>
        <rdfs:label xml:lang="nl">heeft hoofdtitel</rdfs:label>
        <rdfs:label xml:lang="lv">pamatnosaukums</rdfs:label>
        <rdfs:label xml:lang="fi">päänimeke</rdfs:label>
        <rdfs:label xml:lang="et">põhipealkiri</rdfs:label>
        <rdfs:label xml:lang="es">tiene título propiamente dicho</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol propi</rdfs:label>
        <rdfs:label xml:lang="el">έχει κύριο τίτλο</rdfs:label>
        <rdfs:label xml:lang="ar">له العنوان نفسه</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有正题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, belirli bir uygulamada veya bağlamda tercih edilmek üzere seçilen bir gösterimin unvanıı olan bir isim ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un titolo della manifestazione scelto come preferito in una specifica applicazione o contesto.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy cím nomenhez, amelyet egy adott alkalmazásban vagy kontextusban előnyben részesítenek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on manifestaation nimeke, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tên chính của biểu thị, đó là, nhan đề được sử dụng thông thường khi gọi tên biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un titre de manifestation faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un títol de manifestació que se selecciona com a preferent en una aplicació o un context específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es un título de manifestación que se selecciona de preferencia en una aplicación o contexto específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een titel van manifestatie die als voorkeursterm geselecteerd is in een specifieke toepassing of context.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en tittel for manifestasjon som er valgt som foretrukket tittel i en spesifikk applikasjon eller kontekst.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en titel på manifestation, som er valgt som præference i en specifik anvendelse eller kontekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is a title of manifestation that is selected for preference in a specific application or context.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir manifestācijas galvenais nosaukums, ko parasti lieto, atsaucoties uz manifestāciju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse pealkirjaga, mis kindlas rakenduses või kontekstis on valitud eelistatuks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Titel einer Manifestation, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα κύριο όνομα μιας εκδήλωσης δηλαδή ένας τίτλος που συνήθως χρησιμοποιείται όταν κατονομάζεται μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعنوان تجسيدة التي اختيرت للتفضيل ضمن تطبيق او سياق محدد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为载体表现的一个题名并在一个特定的应用或语境下被首选的一个命名关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Alternatif bir başlık, asıl başlığın bir parçası olarak ele alınır.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Alternatiivpeakiri loetakse põhipealkirja osaks.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Alternativ titel behandles som del af en hovedtitel.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Alternatīvais nosaukums tiek uzskatīts par pamatnosaukuma daļu.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">An alternative title is treated as part of a title proper.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Az alternatív címet a főcím részeként kezelik.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een alternatieve titel wordt behandeld als onderdeel van de hoofdtitel.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Ein Alternativtitel wird als Teil eines Haupttitels behandelt.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En alternativ tittel behandles som en del av hovedtittel</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Il titolo alternativo è trattato come parte di un titolo proprio.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Nhan đề lựa chọn được xử lý như là phần của nhan đề hợp thức.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un titre alternatif est traité comme faisant partie d’un titre propre.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un títol alternatiu es tracta com a part d’un títol propi.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un título alternativo se trata como parte de un título propiamente dicho.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Vaihtoehtoista nimekettä pidetään päänimekkeen osana.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ένας εναλλακτικός τίτλος υποβάλλεται σε διαχείριση ως μέρος του κύριου τίτλου.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">العنوان البديل يتم التعامل معه كجزء من العنوان نفسه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">交替题名被处理为正题名的部分</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30157 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30157">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour titre de collection</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề hợp thức của tùng thư</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo della serie</rdfs:label>
        <rdfs:label xml:lang="sv">har huvudtitel till serie</rdfs:label>
        <rdfs:label xml:lang="no">har serietittel</rdfs:label>
        <rdfs:label xml:lang="da">har titel på serie</rdfs:label>
        <rdfs:label xml:lang="en">has title of series</rdfs:label>
        <rdfs:label xml:lang="de">hat Titel einer Reihe</rdfs:label>
        <rdfs:label xml:lang="nl">heeft titel van reeks</rdfs:label>
        <rdfs:label xml:lang="fi">sarjan nimeke</rdfs:label>
        <rdfs:label xml:lang="et">seeriapealkiri</rdfs:label>
        <rdfs:label xml:lang="tr">seri başlığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">sorozatcíme a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">sērijas nosaukums</rdfs:label>
        <rdfs:label xml:lang="es">tiene título de serie</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol de col·lecció</rdfs:label>
        <rdfs:label xml:lang="el">έχει κύριο τίτλο σειράς</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان سلسلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有丛编题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin ait olduğu bir diziyi tanımlayan bir unvan olan bir isim ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un titolo che identifica una serie a cui appartiene una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy cím nomenhez, amely azonosítja azt a sorozatot, amelyhez a megjelenési forma tartozik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on nimeke, joka ilmaisee, mihin sarjaan manifestaatio kuuluu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tên của tùng thư xuất hiện trên biểu thị của phần của tùng thư.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un titre qui identifie une collection à laquelle appartient une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un títol que identifica una col·lecció a la qual pertany una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es un título que identifica una serie a la que pertenece una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een titel die een reeks identificeert waartoe een manifestatie behoort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en tittel som identifiserer en serie som manifestasjonen tilhører.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en titel, som identificerer en serie, hvortil en manifestation tilhører.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is a title that identifies a series to which a manifestation belongs.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir nosaukums, kas identificē sēriju, kurai pieder manifestācija.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse pealkirjaga, mis identifitseerib seeria, millesse kehastus kuulub.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Titel, der eine Reihe/Unterreihe identifiziert, zu der eine Manifestation gehört.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα όνομα μιας σειράς που εμφανίζεται σε μια εκδήλωση ενός μέρους μιας σειράς.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعنوان يحدد سلسلة تنتمي إليها تجسيدة</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为标识一种载体表现属于其中的一种丛编的题名的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30159 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30159">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour résolution</rdfs:label>
        <rdfs:label xml:lang="vi">có độ phân giải</rdfs:label>
        <rdfs:label xml:lang="et">eraldusvõime</rdfs:label>
        <rdfs:label xml:lang="hu">felbontása a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come risoluzione</rdfs:label>
        <rdfs:label xml:lang="da">har opløsning</rdfs:label>
        <rdfs:label xml:lang="no">har oppløsning</rdfs:label>
        <rdfs:label xml:lang="sv">har upplösning</rdfs:label>
        <rdfs:label xml:lang="en">has resolution</rdfs:label>
        <rdfs:label xml:lang="de">hat Auflösung</rdfs:label>
        <rdfs:label xml:lang="nl">heeft resolutie</rdfs:label>
        <rdfs:label xml:lang="lv">izšķirtspēja</rdfs:label>
        <rdfs:label xml:lang="fi">resoluutio</rdfs:label>
        <rdfs:label xml:lang="es">tiene resolución</rdfs:label>
        <rdfs:label xml:lang="ca">té com a resolució</rdfs:label>
        <rdfs:label xml:lang="tr">çözünürlük ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει ανάλυση</rdfs:label>
        <rdfs:label xml:lang="ar">له درجة وضوح</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有分辨率</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, görüntünün piksel vb. cinsinden ölçülmesiyle ifade edilen, bir dijital görüntüdeki ayrıntının netliği veya duyarlılığı ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una limpidezza o precisione del dettaglio di un&apos;immagine digitale, espressa mediante la misurazione dell&apos;immagine in pixel, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát a részletek élességéhez vagy finomságához egy digitális képen, amely a kép pixelben, stb. megadott mértékében fejeződik ki.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation digitaalisen kuvan tarkkuuteen, joka ilmaistaan pikseleinä tms.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với độ rõ hoặc vẻ đẹp của chi tiết trong hình ảnh số, được thể hiện bằng độ đo của hình ảnh theo pixel, v.v...</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une netteté ou une finesse de détail d’une image numérique, exprimée par la mesure de l’image en pixels, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una claredat o subtilesa de detall d’una imatge digital, expressada per la mesura de la imatge en píxels, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una claridad o finura de detalle en una imagen digital, expresada por la medición de la imagen en píxeles, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een helderheid of verfijning van de details in een digitaal beeld, uitgedrukt in de afmeting van het beeld in pixels etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en grad av klarhet eller detaljnivå for et digitalt bilde, uttrykt som bildestørrelse angitt i piksler etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et digitalt billedes skarphed eller finhedsgrad, udtrykt som en måling af pixels i et billede etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a clarity or fineness of detail in a digital image, expressed by the measurement of the image in pixels, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar digitālā attēla detaļu smalkuma parametru, ko parasti mēra pikseļu u.tml. skaitā collās.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse digitaalpildi selguse ja detailitäpsusega, mida väljendatakse tavaliselt pildi pikslite arvuga.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Klarheit oder einem Feinheitsgrad der Details in einem digitalen Bild, die/der durch die Abmessung des Bilds in Pixeln und so weiter ausgedrückt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια καθαρότητα ή λεπτότητα των λεπτομερειών σε μια ψηφιακή εικόνα, η οποία εκφράζεται μέσω της μέτρησης της εικόνας σε εικονοστοιχεία κ.λπ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووضوح أو جودة التفاصيل في صورة رقمية، تم التعبير عنها بمقاييس الصورة بالبكسل، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与数字图像中由图像像素等的度量表达的细部清晰度或精细度关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30161 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30161">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour configuration de piste</rdfs:label>
        <rdfs:label xml:lang="vi">có cấu hình rãnh</rdfs:label>
        <rdfs:label xml:lang="it">ha come configurazione della traccia</rdfs:label>
        <rdfs:label xml:lang="sv">har ljudspårskonfiguration för film</rdfs:label>
        <rdfs:label xml:lang="no">har sporkonfigurasjon</rdfs:label>
        <rdfs:label xml:lang="da">har sporkonfiguration</rdfs:label>
        <rdfs:label xml:lang="en">has track configuration</rdfs:label>
        <rdfs:label xml:lang="de">hat Tonspurlage</rdfs:label>
        <rdfs:label xml:lang="nl">heeft trackconfiguratie</rdfs:label>
        <rdfs:label xml:lang="et">heliriba paigutus</rdfs:label>
        <rdfs:label xml:lang="tr">parça yapılandırması ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņas celiņu konfigurācija</rdfs:label>
        <rdfs:label xml:lang="hu">sávkonfigurációja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene configuración de pista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a configuració de pista</rdfs:label>
        <rdfs:label xml:lang="fi">ääniraidan sijainti</rdfs:label>
        <rdfs:label xml:lang="el">έχει διαμόρφωση κομματιού</rdfs:label>
        <rdfs:label xml:lang="ar">له بنية مسار</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音轨配置</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir film müziği filmindeki ses parçasının bir konfigürasyonuyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una configurazione della traccia audio su una pellicola con traccia audio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy hangsávos film audiosávjainak konfigurációjához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation ääniraidan asemointiin äänifilmissä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với cấu hình của rãnh audio trên phim có rãnh âm thanh.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une configuration de la piste audio sur une bande sonore de film.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una configuració de la pista àudio en la banda sonora d’una pel·lícula.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una configuración de la pista de audio de una película de banda sonora.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een configuratie van het geluidsspoor van een geluidsfilm.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en konfigurasjon av lydsporet til en film med lydspor.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en konfiguration af lydsporet til en film med lydspor.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a configuration of the audio track on a soundtrack film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar audio skaņas celiņu konfigurāciju kinofilmas lentē.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse helifilmi heliriba paigutusega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Positionierung der Tonspur auf einem Film mit Tonspur.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια διαμόρφωση του ηχητικού κομματιού σε ένα τμήμα ήχου για ταινία.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وضبط المسار الصوتي على مسار الصوت على الفيلم.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与原声电影片上的音轨配置关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30164 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30164">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour caractéristique de sillon</rdfs:label>
        <rdfs:label xml:lang="hu">barázdajellemzője a következő:</rdfs:label>
        <rdfs:label xml:lang="vi">có đặc trưng đường rãnh</rdfs:label>
        <rdfs:label xml:lang="it">ha come caratteristica del solco</rdfs:label>
        <rdfs:label xml:lang="no">har rilleegenskaper</rdfs:label>
        <rdfs:label xml:lang="da">har rillekarakteristika</rdfs:label>
        <rdfs:label xml:lang="sv">har spårkarakteristika</rdfs:label>
        <rdfs:label xml:lang="en">has groove characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Rilleneigenschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft groefkenmerken</rdfs:label>
        <rdfs:label xml:lang="tr">oluk özelliği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">rievas raksturojums</rdfs:label>
        <rdfs:label xml:lang="es">tiene característica de ranura</rdfs:label>
        <rdfs:label xml:lang="ca">té com a característica de solc</rdfs:label>
        <rdfs:label xml:lang="fi">uran ominaisuudet</rdfs:label>
        <rdfs:label xml:lang="et">vao tunnus</rdfs:label>
        <rdfs:label xml:lang="el">έχει χαρακτηριστικό της αύλακας</rdfs:label>
        <rdfs:label xml:lang="ar">له خاصية تلثيم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有纹槽特征</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir analog diskin oluk genişliği veya bir analog silindirin oluk aralığı ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione  a un&apos;ampiezza del solco di un disco analogico o passo del solco di un cilindro analogico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy analóg lemez vagy diszk barázdaszélességéhez, vagy egy analóg henger barázdamagasságához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation analogisen levyn uran leveyteen tai analogisen äänilieriön urajakoon.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chiều rộng đường rãnh của đĩa tương tự hoặc mức đương rãnh trong trục lăn tương tự.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une largeur de sillon d’un disque analogique ou un pas de sillonnage d’un cylindre analogique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una amplada del solc d’un disc analògic o un pas del solc d’un cilindre analògic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con el ancho de ranura de un disco analógico o con el paso de ranura de un cilindro analógico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een groefbreedte van een analoge schijf of groefpitch van een analoge cilinder.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en rillebredde for en analog plate eller rillevidde for en analog sylinder.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en rillebredde på en analog disk eller en rilledybde på en analog cylinder.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a groove width of an analog disc or a groove pitch of an analog cylinder.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar analoga diska (skaņuplates) rievas platumu vai analogā ruļļa (cilindra) rievu blīvumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse analoogplaadi vao laiusega või analoogtrumli vao sammuga.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Rillenbreite einer Schallplatte oder einem Rillenabstand eines Phonographenzylinders.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με το πλάτος μιας αύλακας ενός αναλογικού δίσκου ή το ύψος μιας αύλακας ενός αναλογικού κυλίνδρου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعرض المسار لقرص تناظري أو المسار لاسطوانة تناظرية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与模拟盘的纹槽宽度或模拟筒的纹槽间距关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30172 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30172">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour type d’enregistrement</rdfs:label>
        <rdfs:label xml:lang="vi">có kiểu ghi</rdfs:label>
        <rdfs:label xml:lang="hu">felvételtípusa a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come tipo di registrazione</rdfs:label>
        <rdfs:label xml:lang="sv">har inspelningstyp</rdfs:label>
        <rdfs:label xml:lang="da">har type af indspilning</rdfs:label>
        <rdfs:label xml:lang="no">har type opptak</rdfs:label>
        <rdfs:label xml:lang="en">has type of recording</rdfs:label>
        <rdfs:label xml:lang="de">hat Art einer Aufnahme</rdfs:label>
        <rdfs:label xml:lang="nl">heeft opname type</rdfs:label>
        <rdfs:label xml:lang="lv">ieraksta veids</rdfs:label>
        <rdfs:label xml:lang="tr">kayıt türü ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">salvestustüüp</rdfs:label>
        <rdfs:label xml:lang="es">tiene tipo de grabación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a tipus d’enregistrament</rdfs:label>
        <rdfs:label xml:lang="fi">äänen tallennustapa</rdfs:label>
        <rdfs:label xml:lang="el">έχει τύπο της ηχογράφησης</rdfs:label>
        <rdfs:label xml:lang="ar">له نوع تسجيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有录音的类型</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, oynatma için ses içeriğini kodlamada kullanılan bir yöntemle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un metodo utilizzato per la codifica del contenuto audio per la riproduzione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy módszerhez, amelyet audiótartalom kódolásához használnak visszajátszás céljára.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation menetelmään, jota on käytetty äänen tallentamiseksi äänentoistoa varten.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với phương pháp được sử dụng để ghi mã nội dung cho phát lại.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une méthode utilisée pour encoder un contenu audio pour la lecture.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un mètode usat per codificar el contingut àudio per a la reproducció.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un método utilizado para codificar contenido de audio para su reproducción.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een methode gebruikt om audio content te coderen voor afspelen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en metode som er brukt for å kode lydinnhold for avspilling.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en metode, som anvendes til at kode lydindhold til afspilning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a method used to encode audio content for playback.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar metodi, kāda lietota audio satura kodēšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse meetodiga, mida on kasutatud helisisu kodeerimiseks taasesituse tarbeks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Verfahren, das zur Kodierung von Audio-Inhalt für die Wiedergabe verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια μέθοδο που χρησιμοποιείται για την κωδικοποίηση ηχητικού περιεχομένου για αναπαραγωγή.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وطريقة مستخدمة في تكويد المحتوى الصوتي المطلوب للتشغيل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于编码供回放的音频内容的方法关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30176 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30176">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour nom d’éditeur</rdfs:label>
        <rdfs:label xml:lang="vi">có tên nhà xuất bản</rdfs:label>
        <rdfs:label xml:lang="it">ha come nome dell&apos;editore</rdfs:label>
        <rdfs:label xml:lang="da">har navn på udgiver</rdfs:label>
        <rdfs:label xml:lang="no">har navn på utgiver</rdfs:label>
        <rdfs:label xml:lang="sv">har utgivarnamn</rdfs:label>
        <rdfs:label xml:lang="en">has name of publisher</rdfs:label>
        <rdfs:label xml:lang="de">hat Verlagsnamen</rdfs:label>
        <rdfs:label xml:lang="nl">heeft naam van uitgever</rdfs:label>
        <rdfs:label xml:lang="lv">izdevēja vārds/nosaukums</rdfs:label>
        <rdfs:label xml:lang="hu">kiadó neve a következő:</rdfs:label>
        <rdfs:label xml:lang="et">kirjastaja nimi</rdfs:label>
        <rdfs:label xml:lang="fi">kustantajan nimi</rdfs:label>
        <rdfs:label xml:lang="es">tiene nombre de publicador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a nom d’editor</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncının adı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει όνομα εκδότη</rdfs:label>
        <rdfs:label xml:lang="ar">له اسم ناشر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有出版者名称</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimi yayımlamaktan sorumlu bir temsilcinin adı olan bir isim ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un nome di un agente responsabile della pubblicazione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy nomenhez, egy ágens nevéhez, amely felelős egy kiadott megjelenési forma terjesztéséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on manifestaation kustantamisesta vastuussa olevan toimijan nimi.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tên của tác nhân có trách nhiệm về xuất bản, đăng tảu, công bố biểu hiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un nom d’un agent responsable de la publication d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un nom d’un agent que és responsable de la publicació d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es el nombre de un agente que es responsable de publicar una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een naam van een actor die verantwoordelijk is voor het uitgeven van een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et navn på en agent som er ansvarlig for å utgi en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et navn på en agent, som er ansvarlig for at publicere en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is a name of an agent who is responsible for publishing a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir vārds/nosaukums aģentam, kurš ir atbildīgs par manifestācijas izdošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse avaldamise eest vastutava tegija nimega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zum Namen eines Akteurs, der für die Veröffentlichung einer Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα όνομα ενός φορέα υπεύθυνου για τη δημοσίευση, την κυκλοφορία ή την έκδοση μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة واسم وكيل مسئول عن نشر تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为负责出版一种载体表现的一个行为者之名称的一个命名关联起来。</skos:definition>
        <skos:scopeNote xml:lang="et">Avaldamine hõlmab ka väljalaskmist ja väljaandmist.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen die Freigabe und die Herausgabe.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kustantaminen pitää sisällään myös julkaisemisen ja ilmestymisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La pubblicazione comprende la diffusione e l’emissione.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">La publicació inclou la posada en circulació i l’emissió.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">La publicación incluye lanzamiento y emisión.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La publication comprend la mise à disposition et l’édition.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Publication includes release and issuance.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Publicēšana ir izlaišana vai izdošana.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Publikation omfatter frigivelse og udstedelse.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Uitgeven omvat uitbrengen en uitvaardigen.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Utgivelse inkluderer lansering og utstedelse.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Yayın, piyasaya çıkarmayı ve yayımlamayı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">kiadója neve:</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل النشر الإطلاق والإصدار.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">出版包括发布和发行</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30182 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30182">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour étendue d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="vi">có quy mô</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim kapsamı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come estensione della manifestazione</rdfs:label>
        <rdfs:label xml:lang="da">har omfang af manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har omfang for manifestasjon</rdfs:label>
        <rdfs:label xml:lang="sv">har omfång</rdfs:label>
        <rdfs:label xml:lang="en">has extent of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Umfang einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft omvang van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse maht</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation laajuus</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas apjoms</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma terjedelme a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene extensión de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a extensió d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">έχει έκταση</rdfs:label>
        <rdfs:label xml:lang="ar">له امتداد لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的数量</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin birim veya alt birim sayısı ve türüyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un numero e tipo di unità o sottounità di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma egységének vagy alegységének a számáért és típusáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaation yksiköiden ja/tai osayksiköiden määrään ja tyyppiin.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với số lượng và loại của đơn vị hoặc tiểu đơn vị của biểu hiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nombre et type d’unités ou de sous-unités d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nombre i tipus d’unitat o subunitat d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un número y tipo de unidad o subunidad de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een aantal en type eenheid of subeenheid van een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til antall og type enheter eller underenheter som utgjør en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til antal og type af enheder eller underenheder, som udgør en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a number and type of unit or subunit of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas vienību vai apakšvienību skaitu un veidu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastust moodustavate üksuste või alamüksuste arvu ja tüübiga.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Anzahl und Art der Einheit oder Untereinheit einer Manifestation.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με έναν αριθμό και έναν τύπο της μονάδας ή της υπομονάδας μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ورقم ونوع وحدة أو وحدة فرعية لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种载体表现的单元或子单元的数量和类型关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30186 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30186">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour monture</rdfs:label>
        <rdfs:label xml:lang="lv">balsts/paliktnis</rdfs:label>
        <rdfs:label xml:lang="vi">có khung</rdfs:label>
        <rdfs:label xml:lang="hu">foglalata a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come montatura</rdfs:label>
        <rdfs:label xml:lang="sv">har montering</rdfs:label>
        <rdfs:label xml:lang="da">har monteringskarton</rdfs:label>
        <rdfs:label xml:lang="no">har underlag eller ramme</rdfs:label>
        <rdfs:label xml:lang="en">has mount</rdfs:label>
        <rdfs:label xml:lang="de">hat Halterung</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ondersteuning</rdfs:label>
        <rdfs:label xml:lang="tr">montaj malzemesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene montaje</rdfs:label>
        <rdfs:label xml:lang="et">tugimaterjal</rdfs:label>
        <rdfs:label xml:lang="fi">tukimateriaali</rdfs:label>
        <rdfs:label xml:lang="ca">té com a muntura</rdfs:label>
        <rdfs:label xml:lang="el">έχει βάση στήριξης</rdfs:label>
        <rdfs:label xml:lang="ar">له حامل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有衬底/底座</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin temel malzemesinin eklendiği destek veya arkalık için kullanılan fiziksel bir malzeme ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione al materiale fisico utilizzato come supporto o sostegno al quale si fissa il materiale di base di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy fizikai anyaghoz, amelyet tartóként vagy támaszként használnak, amelyhez egy forrás alapanyagát csatolták.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation materiaaliin, johon aineiston pohjamateriaali kiinnitetään manifestaation tukemiseksi tai kannattamiseksi.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với vật liệu vật lý được sử dụng để hỗ trợ hoặc đỡ mà vật liệu cơ sở của biểu thị được gắn vào.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un matériau physique utilisé pour le support ou le renforcement, sur lequel le matériau de base d’une manifestation a été fixé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un material físic usat de suport o de reforçament al qual s’ha subjectat el material de base d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un material físico utilizado como soporte o respaldo al que se ha adherido el material base de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een fysiek materiaal gebruikt als steun of ondergrond waaraan het basismateriaal van een resource is bevestigd.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et fysisk materiale som brukes som støtte eller bakgrunn og som basismaterialet til en manifestasjon er festet til.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et fysisk materiale, som udgør den støtte eller bagbeklædning, som en manifestations basismateriale er fastgjort på.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a physical material used for the support or backing to which the base material of a manifestation has been attached.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar materiālu, ko lieto atbalstam vai kā paliktni, pie kura piestiprināts manifestācijas pamatmateriāls.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse toestava materjaliga, mille külge on kinnitatud kehastuse alusmaterjal.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem physischen Material, das für die Halterung oder die Stütze verwendet wird, an dem das Trägermaterial einer Manifestation angebracht ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα φυσικό υλικό το οποίο χρησιμοποιείται για τη στήριξη ή την υποστήριξη με το οποίο έχει συνδεθεί το βασικό υλικό μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومادة مادية تستخدم في التدعيم أو السند لمادة القاعدة التي تكون تجسيدة ملصقة بها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于支撑或背衬的载体表现的基底材料所附着的物理材料关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30196 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30196">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour polarité</rdfs:label>
        <rdfs:label xml:lang="vi">có phân cực</rdfs:label>
        <rdfs:label xml:lang="it">ha come polarità</rdfs:label>
        <rdfs:label xml:lang="da">har polaritet</rdfs:label>
        <rdfs:label xml:lang="no">har polaritet</rdfs:label>
        <rdfs:label xml:lang="sv">har polaritet</rdfs:label>
        <rdfs:label xml:lang="en">has polarity</rdfs:label>
        <rdfs:label xml:lang="de">hat Polarität</rdfs:label>
        <rdfs:label xml:lang="nl">heeft polariteit</rdfs:label>
        <rdfs:label xml:lang="et">polaarsus</rdfs:label>
        <rdfs:label xml:lang="tr">polarite ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">polariteetti</rdfs:label>
        <rdfs:label xml:lang="hu">polaritása a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">polaritāte</rdfs:label>
        <rdfs:label xml:lang="es">tiene polaridad</rdfs:label>
        <rdfs:label xml:lang="ca">té com a polaritat</rdfs:label>
        <rdfs:label xml:lang="el">έχει πολικότητα</rdfs:label>
        <rdfs:label xml:lang="ar">له استقطاب ألوان</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有极性</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir nesnenin görüntüsündeki renklerin ve tonların, yeniden üretilen nesnenin renkleri ve tonlarıyla olan ilişkisine dair bir belirtiyle ilişkilidir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una relazione tra i colori e toni in un&apos;immagine e i colori e toni dell&apos;oggetto riprodotto.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kép színei és tónusai, valamint a reprodukált objektum színei és tónusai között fennálló kapcsolathoz.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation suhteeseen, joka kuvan väreillä ja valoisuudella on kuvan kohteen väreihin ja valoisuuteen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với mối quan hệ của màu và sắc thái trong hình ảnh với màu và sắc thái của vật thể được sao chép.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une relation des couleurs et des tons d’une image d’un objet avec les couleurs et les tons de l’objet reproduit.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una relació entre els colors i les tonalitats d’una imatge amb els colors i les tonalitats de l’objecte que es reprodueix.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una relación de los colores y tonos de una imagen de un objeto con los colores y tonos del objeto que se reproduce.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een relatie tussen de kleuren en tonen in een beeld en de kleuren en tonen van het object dat gereproduceerd is.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et forhold mellom fargene og tonene til et bilde og fargene og tonene til motivet som gjengis.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et forhold mellem farver og nuancer i et billede og farver og nuancer i den reproducerede genstand.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a relationship of the colours and tones in an image of an object to the colours and tones of the object that is reproduced.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar attēla krāsu un toņu atbilstību reproducētā objekta krāsās un toņos (piem., pozitīvs, negatīvs).</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse pildi värvuste ja toonide ning reprodutseeritud objekti värvuste ja toonide suhtega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zum Verhältnis zwischen den Farben und Tönungen im Bild eines Objekts und den Farben und Tönungen des reproduzierten Objekts.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια σχέση των χρωμάτων και των αποχρώσεων σε μια εικόνα με τα χρώματα και τις αποχρώσεις του αναπαραγόμενου αντικειμένου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعلاقة خاصة بالألوان ودرجاتها في صورة ما والألوان ودرجاتها في الشيء المعاد إنتاجه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一个对象的图像中色彩和色调与被复制对象的色彩和色调的关系关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30197 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30197">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour format bibliographique</rdfs:label>
        <rdfs:label xml:lang="fi">bibliografinen koko</rdfs:label>
        <rdfs:label xml:lang="hu">bibliográfiai formátuma a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">bibliyografik format ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có định dạng thư mục</rdfs:label>
        <rdfs:label xml:lang="it">ha come formato bibliografico</rdfs:label>
        <rdfs:label xml:lang="da">har bogformat</rdfs:label>
        <rdfs:label xml:lang="no">har bokformat</rdfs:label>
        <rdfs:label xml:lang="sv">har bokformat</rdfs:label>
        <rdfs:label xml:lang="en">has bibliographic format</rdfs:label>
        <rdfs:label xml:lang="de">hat bibliografisches Format</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekformaat</rdfs:label>
        <rdfs:label xml:lang="lv">iespiedformāts</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse formaat</rdfs:label>
        <rdfs:label xml:lang="es">tiene formato bibliográfico</rdfs:label>
        <rdfs:label xml:lang="ca">té com a format bibliogràfic</rdfs:label>
        <rdfs:label xml:lang="el">έχει βιβλιογραφικό μορφότυπο</rdfs:label>
        <rdfs:label xml:lang="ar">له شكل ببليوجرافي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有书目格式</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir yaprağın tamamı ile bu yaprağın dolu bırakılması, kesilmesi veya katlanması durumunda ortaya çıkan tek tek yapraklar arasındaki orantılı ilişkiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una relazione proporzionale tra un intero foglio in una risorsa a stampa e/o manoscritta e i fogli individuali che vengono prodotti se quel foglio viene lasciato nella sua interezza, tagliato o ripiegato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma teljes lapja és az egyes lapjai közötti aránybeli viszonyhoz, amelyek akkor érvényesek, ha a lapot teljesnek hagyják, elvágják vagy összehajtják.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation painetussa tai käsikirjoitusaineistossa kokonaisen arkin ja yksittäisten lehtien väliseen kokosuhteeseen, joka riippuu siitä, onko arkki kokonainen, leikattu tai taitettu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với mối quan hệ cân xứng giữa toàn bộ tờ trong tài nguyên in hoặc bản thảo, và các tờ in riêng lẻ sinh ra nếu tờ đó được để nguyên, cắt, hoặc gấp.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une relation proportionnelle entre une feuille entière et les feuillets individuels qui sont produits lorsque cette feuille est coupée, pliée ou laissée à sa pleine grandeur dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una relació proporcional entre un full sencer i els fulls individuals que resulten si aquest full es deixa complet, tallat o doblegat en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una relación proporcional entre una hoja completa y las hojas individuales que resultan si esa hoja se deja completa, cortada o doblada en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een proportionele relatie tussen een heel vel en de individuele bladen die ontstaan als dat vel heel gelaten wordt, gesneden of gevouwen wordt tot een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et størrelsesforhold mellom et helt ark i en trykt eller håndskrevet ressurs og enkeltbladene som blir resultatet når arket blir brettet eller beskåret eller forblir ubrettet og ubeskåret.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et proportionalt forhold mellem et helt ark i en trykt ressource eller manuskriptressource, og de enkelte blade der fremkommer, hvis arket efterlades udfyldt, klippet eller foldet.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a proportional relationship between a whole sheet and the individual leaves that result if that sheet is left full, cut, or folded in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar proporcionālo attiecību starp visu iespiesto lapu vai manuskripta resursu, un atsevišķām lapām, kas rodas, ja lapa ir atstāta pilna, sagriezta vai salocīta.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse trükise või käsikirja jaoks kasutatud tervikpoogna ning üksikute lehtede suuruse suhtega, mis sõltub sellest, kas poogen on lõigatud, murtud või jäetud terveks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem proportionalen Verhältnis zwischen einem ganzen Bogen und den einzelnen Blättern, die resultieren, wenn der Bogen in einer Manifestation im Ganzen gelassen, geschnitten oder gefaltet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια αναλογική σχέση μεταξύ ενός ολόκληρου φύλλου σε έναν έντυπο ή χειρόγραφο πόρο και των μεμονωμένων φύλλων που προκύπτουν αν το συγκεκριμένο φύλλο απομένει πλήρες, κομμένο ή διπλωμένο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعلاقة نسبية بين ورقة كاملة في مصدر مطبوع أو مخطوط، والأوراق الفردية التي تنتج إذا تركت الورقة كاملة، أو مقطوعة، أو مطوية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一个整张和导致在一种载体表现中是否完整、裁切或折叠的单独页之间的比例关系关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30198 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30198">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour facteur de réduction</rdfs:label>
        <rdfs:label xml:lang="vi">có tỷ lệ thu nhỏ</rdfs:label>
        <rdfs:label xml:lang="it">ha come rapporto di riduzione</rdfs:label>
        <rdfs:label xml:lang="sv">har förminskningsgrad</rdfs:label>
        <rdfs:label xml:lang="no">har reduksjonsrate</rdfs:label>
        <rdfs:label xml:lang="da">har reduktionsforhold</rdfs:label>
        <rdfs:label xml:lang="en">has reduction ratio</rdfs:label>
        <rdfs:label xml:lang="de">hat Verkleinerungsfaktor</rdfs:label>
        <rdfs:label xml:lang="nl">heeft verkleiningsfactor</rdfs:label>
        <rdfs:label xml:lang="tr">küçültme oranı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">pienennyssuhde</rdfs:label>
        <rdfs:label xml:lang="hu">redukciós aránya a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">samazinājuma pakāpe</rdfs:label>
        <rdfs:label xml:lang="es">tiene relación de reducción</rdfs:label>
        <rdfs:label xml:lang="ca">té com a escala de reducció</rdfs:label>
        <rdfs:label xml:lang="et">vähendussuhe</rdfs:label>
        <rdfs:label xml:lang="el">έχει λόγο σμίκρυνσης</rdfs:label>
        <rdfs:label xml:lang="ar">له معدل تصغير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有缩率</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, mikro görüntünün boyutunun orijinal görüntüye göre sayısal bir oranıyla ilişkilendirir</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un rapporto numerico delle dimensioni di una microimmagine in relazione all&apos;originale da cui è stata prodotta. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy mikrokép méretének számarányához az eredetihez viszonyítva, amelyből azt előállították.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation numeeriseen suhdelukuun, joka ilmaisee mikrokokoiseksi pienennetyn kuvan suhteen alkuperäiseen kuvaan, josta pienennetty kuva on tuotettu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tỷ số giữa độ lớn của hình ảnh thu nhỏ với nguyên gốc mà nó được tạo ra,</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un rapport numérique entre la taille d’une micro-image et celle de l’original à partir duquel elle a été produite.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una escala numèrica de la mida d’una microimatge en relació a l’original a partir del qual s’ha produït.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una relación numérica del tamaño de una microimagen en relación con el original a partir del cual fue producida.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een numerieke verhouding van de grootte van een micro-beeld betreffende het origineel waarvan het werd afgeleid.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et tallmessig forhold mellom størrelsen på et mikrobilde og originalen som det ble produsert fra.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et numerisk forhold for størrelsen på et mikrobillede i forhold til den original, som det er fremstillet ud fra.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a numerical ratio of the size of a micro-image in relation to the original from which it was produced.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar mikroattēla izmēru attiecību pret oriģināla izmēriem, no kura tas izgatavots.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse mikrokujutise ja selle aluseks oleva originaali suuruse arvulise suhtega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Zahlenverhältnis zwischen der Größe eines Mikro-Bilds im Verhältnis zu dem Original, von dem es hergestellt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια αριθμητική αναλογία του μεγέθους μιας μικρο-εικόνας σε σχέση με την αρχική μορφή από την οποία παρήχθη.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ونسبة في حجم صورمصغرة بالنسبة للأصل الذي انتجت منه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与缩微图像尺寸和其所复制的原件之间的数值比关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30200 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30200">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour vitesse de projection</rdfs:label>
        <rdfs:label xml:lang="vi">có tốc độ chiếu</rdfs:label>
        <rdfs:label xml:lang="lv">demonstrēšanas ātrums</rdfs:label>
        <rdfs:label xml:lang="it">ha come velocità di proiezione</rdfs:label>
        <rdfs:label xml:lang="no">har projeksjonshastighet</rdfs:label>
        <rdfs:label xml:lang="sv">har projektionshastighet</rdfs:label>
        <rdfs:label xml:lang="da">har projiceringshastighed</rdfs:label>
        <rdfs:label xml:lang="en">has projection speed</rdfs:label>
        <rdfs:label xml:lang="de">hat Projektionsgeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="nl">heeft projectiesnelheid</rdfs:label>
        <rdfs:label xml:lang="fi">projisointinopeus</rdfs:label>
        <rdfs:label xml:lang="et">projitseerimiskiirus</rdfs:label>
        <rdfs:label xml:lang="es">tiene velocidad de proyección</rdfs:label>
        <rdfs:label xml:lang="ca">té com a velocitat de projecció</rdfs:label>
        <rdfs:label xml:lang="hu">vetítési sebessége a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">yansıtma hızı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει ταχύτητα προβολής</rdfs:label>
        <rdfs:label xml:lang="ar">له سرعة عرض</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有投影速度</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, amaçlanan hareketli görüntüyü üretmek için yansıtılan bir taşıyıcının çalıştırılması gereken bir hızla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una velocità a cui un supporto proiettato deve essere utilizzato per produrre l&apos;immagine in movimento desiderata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy sebességhez, amelyen egy kivetített hordozónak működnie kell, hogy a kívánt mozgóképet elő tudják állítani.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nopeuteen, jolla projisoitava tallenne tulee esittää liikkuvan kuvan näyttämiseksi tarkoitetulla tavalla.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tốc độ mà vật mang tin chiếu phải hoạt động để tạo ta hình ảnh động như dự kiến.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une vitesse à laquelle un support matériel projeté doit être utilisé pour produire l’image animée prévue.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una velocitat a la qual ha de funcionar un suport físic projectat per produir el moviment d’imatges previst.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una velocidad a la que se debe operar un soporte proyectado para producir la imagen en movimiento pretendida.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een snelheid waarmee een projectiedrager moet worden afgespeeld om het bedoelde bewegende beeld te produceren.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en hastighet som kreves for at et projeksjonsmedium skal produsere levende bilder slik de var ment.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en hastighed, ved hvilken en projiceret bærer skal betjenes for at producere det ønskede levende billede.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a speed at which a projected carrier must be operated to produce the moving image intended.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar ātrumu, ar kādu projektoram jādarbojas, lai demonstrētu kustīgu attēlu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kiirusega, millega tuleb projitseeritavat kandjat käitada, et tekiks ettenähtud liikuv pilt.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Geschwindigkeit, mit der ein projizierbarer Datenträger betrieben werden muss, um das beabsichtigte Bewegtbild zu erzeugen.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια ταχύτητα στην οποία ο προβαλλόμενος φορέας αποθήκευσης πρέπει να λειτουργεί για την παραγωγή της σκοπούμενης κινητής εικόνας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وسرعة يجب أن يشغل بها حامل العرض لكي ينتج عنه الصور المتحركة المطلوبة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种投影载体要产生所期望的动态图像必须操作的速度关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30201 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30201">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour vitesse de lecture</rdfs:label>
        <rdfs:label xml:lang="lv">atskaņošanas ātrums</rdfs:label>
        <rdfs:label xml:lang="vi">có tốc độ chơi</rdfs:label>
        <rdfs:label xml:lang="it">ha come velocità di riproduzione</rdfs:label>
        <rdfs:label xml:lang="no">har avspillingshastighet</rdfs:label>
        <rdfs:label xml:lang="da">har omdrejningshastighed</rdfs:label>
        <rdfs:label xml:lang="sv">har uppspelningshastighet</rdfs:label>
        <rdfs:label xml:lang="en">has playing speed</rdfs:label>
        <rdfs:label xml:lang="de">hat Abspielgeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="nl">heeft afspeelsnelheid</rdfs:label>
        <rdfs:label xml:lang="hu">lejátszási sebessége a következő:</rdfs:label>
        <rdfs:label xml:lang="et">mängimiskiirus</rdfs:label>
        <rdfs:label xml:lang="es">tiene velocidad de reproducción</rdfs:label>
        <rdfs:label xml:lang="fi">toistonopeus</rdfs:label>
        <rdfs:label xml:lang="ca">té com a velocitat de reproducció</rdfs:label>
        <rdfs:label xml:lang="tr">çalma hızı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει ταχύτητα αναπαραγωγής</rdfs:label>
        <rdfs:label xml:lang="ar">له سرعة تشغيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有播放速度</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, sesin üretilmesi için bir ses taşıyıcısının çalıştırılması gereken bir hız ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una velocità a cui un supporto audio deve essere utilizzato per produrre il suono desiderato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy sebességhez, amelyen egy hanghordozónak működnie kell, hogy a kívánt hangot elő tudják állítani.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nopeuteen, jolla äänitallenne on toistettava äänen tuottamiseksi tarkoitetulla tavalla.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tốc độ mà vật mang audio phải vận hành để tạo ra âm thanh dự kiến.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une vitesse à laquelle un support matériel audio doit être utilisé pour produire le son prévu.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una velocitat a la qual un suport físic àudio ha de funcionar per produir el so previst.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con la velocidad a la que se debe operar un soporte de audio para producir el sonido deseado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een snelheid waarmee een geluidsdrager moet worden afgespeeld om het bedoelde geluid te produceren.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en hastighet som kreves for at en lydbærer skal produsere lyd slik den var ment.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en hastighed, som en lydbærer skal betjenes ved for at producere den ønskede lyd.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a speed at which an audio carrier must be operated to produce the sound intended.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar paredzēto atskaņošanas ātrumu skaņu ierakstam, kādā ierīcei jāatskaņo ierakstītais, lai iegūtu plānoto skaņu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kiirusega, millega tuleb helikandjat käitada, et tekiks ettenähtud heli.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Geschwindigkeit, mit der ein Tonträger für die korrekte Wiedergabe abgespielt werden muss.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια ταχύτητα στην οποία ένας φορέας αποθήκευσης ήχου πρέπει να λειτουργεί για την παραγωγή του σκοπούμενου ήχου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وسرعة يجب أن يشغل حامل الصوت بها لكي ينتج الصوت المطلوب.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种音频载体要产生所期望的声音必须操作的速度关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30202 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30202">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour débit binaire codé</rdfs:label>
        <rdfs:label xml:lang="vi">có tốc độ bit được mã</rdfs:label>
        <rdfs:label xml:lang="it">ha come codifica bitrate</rdfs:label>
        <rdfs:label xml:lang="sv">har bithastighet</rdfs:label>
        <rdfs:label xml:lang="no">har kodet bithastighet</rdfs:label>
        <rdfs:label xml:lang="da">har kodet bitrate</rdfs:label>
        <rdfs:label xml:lang="en">has encoded bitrate</rdfs:label>
        <rdfs:label xml:lang="de">hat Bitrate</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gecodeerde bitsnelheid</rdfs:label>
        <rdfs:label xml:lang="et">kodeeritud bitikiirus</rdfs:label>
        <rdfs:label xml:lang="tr">kodlanmış bit hızı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kodēts bitu pārraides ātrums</rdfs:label>
        <rdfs:label xml:lang="fi">koodattu bittinopeus</rdfs:label>
        <rdfs:label xml:lang="hu">kódolt bitrátája a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene tasa de bits codificada</rdfs:label>
        <rdfs:label xml:lang="ca">té com a velocitat de transmissió</rdfs:label>
        <rdfs:label xml:lang="el">έχει κωδικοποιημένο ρυθμό μετάδοσης</rdfs:label>
        <rdfs:label xml:lang="ar">له معدل للبتات المكودة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编码的比特率</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, ses, video veya diğer içeriğin oynatılmak üzere tasarlandığı bir hızla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una velocità di riproduzione in streaming di registrazioni audio, video, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy sebességhez, amelyen egy sztrímelt audió, videó vagy egyéb tartalom terv szerint lejátszódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nopeuteen, jolla suoratoistoääni, -video tai muu sisältö on suunniteltu toistettavan.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tốc độ mà audio, video truyền, v.v... được thiết kế để chơi.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une vitesse à laquelle un flux audio, vidéo ou autre est destiné à être diffusé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una velocitat a la qual es dissenya l’estríming d’àudio, vídeo o un altre contingut</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con la velocidad a la que está diseñado para reproducirse la transmisión de audio, vídeo u otro contenido.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een snelheid waarmee streaming audio, video of andere content, bedoeld is om afgespeeld te worden.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en avspillingshastighet som strømmet lyd, video etc. er laget for.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en hastighed, som streaming af lyd, video etc. er beregnet til.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a speed at which streaming audio, video, or other content is designed to play.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar ātrumu, kādā paredzēts atskaņot straumētu audio, video u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kiirusega, millega heli, video jms voogedastus on mõeldud toimima.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Geschwindigkeit, mit der Audio-, Video oder andere Streaming-Inhalte abgespielt werden.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια ταχύτητα στην οποία η ροή ήχου, εικόνας κ.λπ. είναι προορισμένη να αναπαράγεται.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وسرعة تم تصميم كل من الصوت، والفيديو، إلخ. للتشغيل وفقا لها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与流播音频、视频或其他内容被设计播放的速度关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30203 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30203">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour titre propre parallèle</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề hợp thức song song</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo proprio parallelo</rdfs:label>
        <rdfs:label xml:lang="da">har parallel hovedtitel</rdfs:label>
        <rdfs:label xml:lang="no">har parallell hovedtittel</rdfs:label>
        <rdfs:label xml:lang="sv">har parallell huvudtitel</rdfs:label>
        <rdfs:label xml:lang="en">has parallel title proper</rdfs:label>
        <rdfs:label xml:lang="de">hat Paralleltitel</rdfs:label>
        <rdfs:label xml:lang="nl">heeft parallelle hoofdtitel</rdfs:label>
        <rdfs:label xml:lang="tr">paralel esas başlık ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">paralēlais pamatnosaukums</rdfs:label>
        <rdfs:label xml:lang="hu">párhuzamos főcíme a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">rinnakkainen päänimeke</rdfs:label>
        <rdfs:label xml:lang="et">rööppõhipealkiri</rdfs:label>
        <rdfs:label xml:lang="es">tiene un título paralelo propiamente dicho</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol propi paral·lel</rdfs:label>
        <rdfs:label xml:lang="el">έχει παράλληλο κύριο τίτλο</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان موزاي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有并列正题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, başka bir dilde veya yazıda uygun bir unvan olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un titolo proprio in un&apos;altra lingua e/o scrittura.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formához egy nomenhez, amely egy főcím más nyelven vagy írásrendszerben.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on päänimeke toisella kielellä tai kirjoitusjärjestelmällä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với nhan đề hợp thức trong ngôn ngữ hoặc hệ thống viết khác.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un titre propre dans une autre langue ou écriture.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un títol propi en una altra llengua o escriptura.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es un título propiamente dicho en otra lengua o escritura.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een hoofdtitel in een andere taal en/of schrift.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en hovedtittel på et annet språk eller i et annet skriftsystem.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en hovedtitel på et andet sprog eller skriftsystem.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is a title proper in another language or script.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir pamatnosaukums citā valodā vai rakstībā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse põhipealkirjaga teises keeles või kirjasüsteemis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Haupttitel in einer anderen Sprache oder einer anderen Schrift.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με έναν κύριο τίτλο σε μια άλλη γλώσσα ή γραφή.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعنوان نفسه في لغة أخرى أو نظام آخر للحروف.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为用另一种语言或文字的一个正题名的一个命名关联起来。</skos:definition>
        <skos:scopeNote xml:lang="nl">Een alternatieve titel in een andere taal of schrift wordt behandeld als onderdeel van de parallelle titel.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy más nyelvű vagy más írásmódú alternatív címet egy párhuzamos valódi cím részének tekintenek.   </skos:scopeNote>
        <skos:scopeNote xml:lang="de">Ein Alternativtitel in einer anderen Sprache und/oder Schrift wird als Teil des Paralleltitels behandelt.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">En alternativ titel på et andet sprog eller i et andet alfabet behandles som del af en parallel hovedtitel.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En alternativ tittel på et annet språk eller i et annet skriftsystem behandles som del av en parallell hovedtittel.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Nhan đề lựa chọn trong ngôn ngữ hoặc hệ thống viết khác được xử lý như phần của nhan đề hợp thức song song.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un titre alternatif dans une autre langue ou écriture est traité comme faisant partie d’un titre propre parallèle.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un títol alternatiu en una altra llengua o escriptura es tracta com a part del títol propi paral·lel.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ένας εναλλακτικός τίτλος σε μια άλλη γλώσσα ή γραφή υποβάλλεται σε διαχείριση ως μέρος ενός κύριου παράλληλου τίτλου.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30208 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30208">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour matériau de base</rdfs:label>
        <rdfs:label xml:lang="hu">alapanyaga a következő:</rdfs:label>
        <rdfs:label xml:lang="et">alusmaterjal</rdfs:label>
        <rdfs:label xml:lang="vi">có vật liệu cơ sở</rdfs:label>
        <rdfs:label xml:lang="it">ha come materiale di base</rdfs:label>
        <rdfs:label xml:lang="da">har basismateriale</rdfs:label>
        <rdfs:label xml:lang="no">har basismateriale</rdfs:label>
        <rdfs:label xml:lang="sv">har bärande material</rdfs:label>
        <rdfs:label xml:lang="en">has base material</rdfs:label>
        <rdfs:label xml:lang="de">hat Trägermaterial</rdfs:label>
        <rdfs:label xml:lang="nl">heeft basismateriaal</rdfs:label>
        <rdfs:label xml:lang="lv">pamatmateriāls</rdfs:label>
        <rdfs:label xml:lang="fi">pohjamateriaali</rdfs:label>
        <rdfs:label xml:lang="tr">temel malzeme ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene material base</rdfs:label>
        <rdfs:label xml:lang="ca">té com a material de base</rdfs:label>
        <rdfs:label xml:lang="el">έχει βασικό υλικό</rdfs:label>
        <rdfs:label xml:lang="ar">له مادة أساسية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有基底材料</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, altta yatan fiziksel bir durumla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un substrato fisico di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma mögöttes fizikai anyagához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaation fyysiseen pohjamateriaaliin.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với vật liệu vật lý nằm bên dưới của biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un matériau physique sous-jacent d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un material físic subjacent d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un material físico subyacente de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een onderliggend fysieke materiaal van een resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et underliggende fysisk materiale for en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestations underliggende fysiske materiale.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an underlying physical material of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas pamatā esošu fizisku materiālu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse aluspõhjaks oleva füüsilise materjaliga.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem zugrunde liegenden, physischen Material einer Manifestation.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα υποκείμενο φυσικό υλικό μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومادة ملموسة أساسية لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种载体表现的下层物理材料关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30215 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30215">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent papetier</rdfs:label>
        <rdfs:label xml:lang="vi">có người sản xuất giấy</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di carta agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er papirproducent</rdfs:label>
        <rdfs:label xml:lang="no">har papirprodusent (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has papermaker agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Papiermacherin/Papiermacher (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft papiermaker-actor</rdfs:label>
        <rdfs:label xml:lang="tr">kağıt üreticisi temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">paberivalmistaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">paperinvalmistaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">papírgyártó ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">papīra izgatavotājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente papelero</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent paperer</rdfs:label>
        <rdfs:label xml:lang="el">έχει χαρτοποιό</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل صانع ورق</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有造纸者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir şirkette kullanılan kağıdın yapımından sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente responsabile della produzione della carta utilizzata per la manifattura di una manifestazione. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely egy megjelenési forma gyártásához használt papír előállításáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation toimijaan, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tác nhân có trách nhiệm đối với sản xuất giấy được sử dụng để chế tạo biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent qui est responsable de la confection du papier utilisé dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és responsable de l’elaboració del paper usat en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que es responsable de la fabricación del papel utilizado en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die verantwoordelijk is voor het maken van papier gebruikt in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er ansvarlig for produksjonen av papir brukt til å framstille en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er ansvarlig for fremstilling af papir, som anvendes til fremstilling af en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is responsible for the making of paper used in a manifestation. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir atbildīgs par papīra izgatavošanu, kas izmantots ražošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes vastutab kehastuse valmistamiseks kasutatud paberi tootmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Akteur, der für die Produktion von Papier verantwortlich ist, das zur Herstellung einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με έναν φορέα υπεύθυνο για την παραγωγή χάρτου που χρησιμοποιείται για την κατασκευή μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مسئول عن إنتاج الورق المستخدم في صناعة تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种载体表现中所使用的纸张之制造的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30216 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30216">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un matériau appliqué</rdfs:label>
        <rdfs:label xml:lang="hu">az alkalmazott anyag részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của vật liệu ứng dụng</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par izmantoto materiālu</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om anvendt materiale</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende anvendt materiale</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om applicerat material</rdfs:label>
        <rdfs:label xml:lang="en">has details of applied material</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zu aufgebrachtem Material</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van aangebracht materiaal</rdfs:label>
        <rdfs:label xml:lang="et">pealismaterjali täpsustus</rdfs:label>
        <rdfs:label xml:lang="fi">päällimateriaalin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del material aplicado</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de material aplicat</rdfs:label>
        <rdfs:label xml:lang="tr">uygulanan materyalin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του εφαρμοσμένου υλικού</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل مادة مستخدمة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有施加材料的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir temel malzemeye uygulanan fiziksel veya kimyasal bir maddenin ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma alapanyagaként alkalmazott fizikai vagy kémiai anyag részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin materiaalista tai kemikaalisista aineista, joita käytetään manifestaation pohjamateriaalin päällä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của chất hoá học hoawcjm vật lý được áp dụng làm vật liệu cơ sở của biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une substance physique ou chimique appliquée sur un matériau de base d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una substància física o química que s’aplica sobre un material de base d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una sustancia física o química que se aplica a un material base de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een fysische of chemische substantie aangebracht op een basismateriaal van een resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende et fysisk eller kjemisk stoff som er påført basismaterialet til en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om et fysisk eller kemisk stof, som er påført en manifestations basismateriale.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a physical or chemical substance that is applied to a base material of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par fizikālām vai ķīmiskām vielām, kas izmantotas manifestācijas pamatmateriālā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega füüsilise või keemilise aine kohta, millega on kaetud kehastuse alusmaterjal.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer physischen oder chemischen Substanz, die auf ein Trägermaterial einer Manifestation aufgebracht ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες της φυσικής ή χημικής ουσίας που εφαρμόζεται στο βασικό υλικό μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل المادة الفيزيائية أو الكيميائية التي تم صنع مادة القاعدة منها لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与施加于一种载体表现的基底材料上的物理或化学物质的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30217 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30217">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un matériau de base</rdfs:label>
        <rdfs:label xml:lang="hu">alapanyag részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="et">alusmaterjali täpsustus</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của vật liệu cơ sở</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par pamatmateriālu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al materiale di base</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om basismateriale</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende basismateriale</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om bärande matieral</rdfs:label>
        <rdfs:label xml:lang="en">has details of base material</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Trägermaterial</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van basismateriaal</rdfs:label>
        <rdfs:label xml:lang="fi">pohjamateriaalin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="tr">temel materyalin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del material base</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de material de base</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του βασικού υλικού</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل مادة الأساس</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有基底材料的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, altta yatan bir konunun fiziksel malzemesi ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un substrato fisico di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma mögöttes fizikai anyagának részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin manifestaation fyysisestä pohjamateriaalista.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của vật liệu vật lý nằm bên dưới của biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un matériau physique sous-jacent d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un material físic subjacent d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un material físico subyacente de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een onderliggend fysiek materiaal van een resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende et underliggende fysisk materiale i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en manifestations underliggende fysiske materiale.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of an underlying physical material of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par manifestācijas pamatā esošo fizisko materiālu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega kehastuse aluspõhjaks oleva füüsilise materjali kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einem zugrunde liegenden physischen Material einer Manifestation.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός υποκείμενου φυσικού υλικού μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل المادة الفيزيائية الأساسية لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种载体表现的下层物理材料的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30218 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30218">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un format bibliographique</rdfs:label>
        <rdfs:label xml:lang="fi">bibliografista koon tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">bibliográfiai formátum részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="tr">bibliyografik formatın ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của định dạng thư mục</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par iespiedformātu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al formato bibliografico</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om bogformat</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende bokformat</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om bokformat</rdfs:label>
        <rdfs:label xml:lang="en">has details of bibliographic format</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum bibliografischen Format</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van boekformaat</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse formaadi täpsustus</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de formato bibliográfico</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de format bibliogràfic</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του βιβλιογραφικού μορφότυπου</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل شكل ببليوجرافي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有书目格式细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, basılı veya el yazması bir kaynaktaki tüm bir sayfa ile bu sayfanın dolu bırakılması, kesilmesi veya katlanması durumunda ortaya çıkan tek tek yapraklar arasındaki orantılı ilişkinin ayrıntılaryla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una relazione proporzionale tra un intero foglio in una risorsa a stampa e/o manoscritta e i fogli individuali che vengono prodotti sequel foglio viene lasciato nella sua interezza, tagliato o ripiegato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy aránybeli viszonyhoz, amely egy nyomtatott vagy kézírásos forrás teljes lapja és az egyes lapok között áll fent, amelyek akkkor keletkeznek, ha a lapot hagyják megtelni, elvágják vagy összehajtják.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin painetun aineiston tai käsikirjoitusaineiston kokonaisen arkin ja erillisten lehtien välisestä kokosuhteesta, joka riippuu siitä, onko arkki kokonainen, leikattu tai taitettu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của mối quan hệ cân xứng giữa toàn bộ tờ trong tài nguyên in hoặc bản thảo, và tờ in riêng rẽ khi để nguyên, cắt, hoặc gấp.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une relation proportionnelle entre une feuille entière dans une ressource imprimée ou manuscrite et les feuillets individuels qui sont produits lorsque cette feuille est coupée, pliée ou laissée à sa pleine grandeur.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una relació proporcional entre un full sencer en un recurs imprès o un manuscrit i els fulls individuals que resulten si aquest full es deixa complet, tallat o doblegat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una relación proporcional entre una hoja completa en un recurso impreso o manuscrito y las hojas individuales que resultan si esa hoja se deja llena, cortada o doblada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een resultaat van het vouwen van een bedrukt vel om een katern te vormen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende størrelsesforholdet mellom et helt ark i en trykt eller håndskrevet ressurs og enkeltbladene som blir resultatet når arket blir brettet eller beskåret eller forblir ubrettet og ubeskåret.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om et proportionalt forhold mellem et helt ark i en trykt ressource eller manuskriptressource, og de enkelte blade der fremkommer, hvis arket efterlades udfyldt, klippet eller foldet.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a proportional relationship between a whole sheet in a printed or manuscript resource and the individual leaves that result if that sheet is left full, cut, or folded.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par proporcionālām attiecībām starp drukāto vai manuskripta resursu pilno lapu un atsevišķām lapām, kas rodas, ja šī lapa ir atstāta neskarta, ir sagriezta vai salocīta.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega trükise või käsikirja jaoks kasutatud tervikpoogna ning üksikute lehtede suuruse suhte kohta, mis sõltub sellest, kas poogen on lõigatud, murtud või jäetud terveks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu dem proportionalen Verhältnis zwischen einem ganzen Bogen in einer gedruckten oder handschriftlichen Ressource und den einzelnen Blättern, die resultieren, wenn der Bogen im Ganzen gelassen, geschnitten oder gefaltet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας αναλογικής σχέσης μεταξύ ενός ολόκληρου φύλλου σε έναν έντυπο ή χειρόγραφο πόρο και των μεμονωμένων φύλλων που προκύπτουν αν το συγκεκριμένο φύλλο έχει απομείνει πλήρες, κομμένο ή διπλωμένο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل علاقة نسبية بين ورقة كاملة في مصدر مطبوع أو مخطوط والأوراق الفردية التي تنتج إذا تركت الورقة كاملة، أو مقطوعة، أو مطوية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与导致在一种印刷或手稿资源中是否完整、裁切或折叠的一个整张和单独页之间的比例关系的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30219 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30219">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une norme de diffusion</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của chuẩn phát sóng</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par apraides standartu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi allo standard di trasmissione</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om transmissionsstandard</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende kringkastingsstandard</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om sändningsstandard</rdfs:label>
        <rdfs:label xml:lang="en">has details of broadcast standard</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Sendestandard</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van uitzendstandaard</rdfs:label>
        <rdfs:label xml:lang="et">leviedastusstandardi täpsustus</rdfs:label>
        <rdfs:label xml:lang="fi">lähetysstandardin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">műsorszórási szabvány részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del estándar de transmisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats d’estàndard d’emissió</rdfs:label>
        <rdfs:label xml:lang="tr">yayın standardının ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του προτύπου εκπομπής</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل معيار بث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播标准细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir sistemin ayrıntılarıyla televizyon yayını için bir video gösterimini biçimlendirmek için kullanılır.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un sistema utilizzato per la formattazione di una risorsa video per la trasmissione televisiva.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy videó megjelenési formájának televíziós műsorszórás-formátumához használt rendszer részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin järjestelmästä, jonka mukaan videon manifestaatio muunnetaan televisiolähetystä varten.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của hệ thống được sử dụng để dịnh dạng biểu thị của video cho phát sóng truyền hình.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un système qui est utilisé pour formater une manifestation d’une vidéo pour la télédiffusion.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un sistema que s’usa per formatar una manifestació d’un vídeo per a l’emissió per televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un sistema que se utiliza para formatear una manifestación de un video para transmisión televisiva.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een systeem dat gebruikt wordt om een video resource geschikt te maken voor een televisie-uitzending.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende et system som brukes for å formatere en videomanifestasjon for fjernsynskringkasting.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om et system, som anvendes til at formatere en videomanifestation til tv-transmission.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a system that is used to format a manifestation of a video for television broadcast.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par sistēmu, kas izmantota, lai pārveidotu video manifestāciju televīzijas pārraides vajadzībām.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega  standardi kohta, mida on kasutatud videoressursi kehastuse muundamiseks teleülekande jaoks sobivasse formaati.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einem System, das zur Formatierung einer Manifestation eines Videos für eine Fernsehsendung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός συστήματος που χρησιμοποιείται για τη διαμόρφωση μιας εκδήλωσης ενός βίντεο για τηλεοπτική εκπομπή.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل نظام الذي يستخدم في تكوين تجسيدة من فيديو للبث التليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于电视广播的视频的一种载体表现的格式的一个体系的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30220 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30220">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une configuration des canaux de reproduction</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của cấu hình của kênh phát lại</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par atskaņošanas kanālu konfigurēšanu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla configurazione dei canali di riproduzione</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om konfiguration af afspilningskanaler</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende konfigurasjon av kanaler for avspilling</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om antal ljudkanaler</rdfs:label>
        <rdfs:label xml:lang="en">has details of configuration of playback channels</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Konfiguration von Wiedergabekanälen</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van afspeelkanalenconfiguratie</rdfs:label>
        <rdfs:label xml:lang="tr">oynatma kanalları düzeninin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">taasesituskanalite konfiguratsiooni täpsustus</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de configuración de canales de reproducción</rdfs:label>
        <rdfs:label xml:lang="fi">toistokanavien määrän tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de configuració de canals de reproducció</rdfs:label>
        <rdfs:label xml:lang="hu">visszajátszási csatornák konfigurációjának részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της διαμόρφωσης των καναλιών αναπαραγωγής</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل إعدادات قنوات التشغل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有回放声道的配置的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, kayıt yapmak için kullanılan bir dizi ses kanalının ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un numero di canali audio utilizzati per realizzare una registrazione.        </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát lemezfelvétel készítésére használt hangcsatornák számának részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin äänitteen tekoon käytettyjen äänikanavien määrästä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của số lượng kênh âm thanh được sử dụng để tạo bản ghi.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un nombre de canaux sonores utilisés pour réaliser un enregistrement.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un nombre de canals de so usats per fer un enregistrament.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una serie de canales de sonido utilizados para realizar una grabación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een aantal geluidskanalen die gebruikt worden om een opname te maken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende et antall lydkanaler som brukes for å gjøre et opptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om et antal af lydkanaler, som anvendes til en indspilning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a number of sound channels used to make a recording.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par skaņu kanālu skaitu, kas lietots, lai veiktu skaņu ierakstu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega salvestusel kasutatud helikanalite arvu kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zur Anzahl von Tonkanälen, die für die Wiedergabe einer Aufnahme verwendet werden.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός αριθμού καναλιών ήχου που χρησιμοποιούνται για την κατασκευή μιας ηχογράφησης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل عدد قنوات الصوت المستخدمة في إعداد تسجيل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于制作一个录音制品的声道数的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30221 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30221">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une caractéristique de fichier numérique</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của đặc trưng tệp số</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par datnes raksturojumu</rdfs:label>
        <rdfs:label xml:lang="fi">digitaalisen tiedoston ominaisuuksien tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">digitális fájljellemzők részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="tr">dijital dosya özelliklerinin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">faili tunnuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alle caratteristiche del file digitale</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om digitale filkarakteristika</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende egenskaper for digital fil</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om egenskaper för resursens digitala kodning</rdfs:label>
        <rdfs:label xml:lang="en">has details of digital file characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Eigenschaft einer digitalen Datei</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van kenmerken digitaal bestand</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de la característica del archivo digital</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de característiques de fitxer digital</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του χαρακτηριστικού του ψηφιακού αρχείου</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل خاصية ملف رقمي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有数字文件特征的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, metin, görüntü, ses, video veya diğer veri türlerinin dijital olarak kodlanmasıyla ilgili bir teknik spesifikasyonun ayrıntılarıyla ilişkilidir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una specifica tecnica relativa alla codifica digitale di testo, immagine, audio, video e altri tipi di dati in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma szövegének, képének, hangjának, videójának és más adattípusainak digitális kódolásához kapcsolódó műszaki specifikáció részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin manifestaation sisältämän tekstin, kuvan, äänen, videon tai muun datan digitaalisen koodauksen teknisestä määrityksestä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của đặc tính kỹ thuật liên quan tới ghi mã văn bản, hình ảnh, audio, video, và các loại dữ liệu khác trong biểu hiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une spécification technique relative à l’encodage numérique de données textuelles, image, audio, vidéo ou d’autres types dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una especificació tècnica relativa a la codificació digital de text, d’imatge, d’àudio, de vídeo o d’altres tipus de dades d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una especificación técnica relacionada con la codificación digital de texto, imagen, audio, video u otros tipos de datos en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een technische specificatie gerelateerd aan de digitale codering van tekst, beeld, geluid, video, of andere soorten gegevens in een resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en teknisk spesifikasjon angående den digitale kodingen av tekst, bilder, lyd, video og andre typer data i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en teknisk specifikation, som relaterer til den digitale kodning af tekst, billede, audio-, video- og andre datatyper i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a technical specification relating to the digital encoding of text, image, audio, video, or other types of data in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par resursa tekstu, attēlu, audio, video un citu datu tipu digitālo kodējumu manifestācijā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega tehnilises kirjelduses, mis puudutab kehastuses sisalduva teksti, kujutise, heli, video jm tüüpi andmete digitaalset kodeeringut.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer technischen Spezifikation, die sich auf die digitale Kodierung von Text, Bild, Audio, Video oder anderen Datentypen in einer Manifestation bezieht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας τεχνικής προδιαγραφής που συνδέεται με την ψηφιακή κωδικοποίηση του κειμένου, της εικόνας, του ήχου, του βίντεο και άλλων τύπων δεδομένων σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل خصائص فنية متعلقة بالتكويد الرقمي لنص، وصورة، وصوت، وفيديو، وأي نوع بيانات آخر في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现中的文本、图像、音频、视频或其他类型数据的数字编码有关的一个技术规格的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30222 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30222">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une représentation numérique de contenu cartographique</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của biểu diễn số của nội dung bản đồ</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par kartogrāfiskā satura digitālu attēlojumu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla rappresentazione digitale del contenuto cartografico</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om digital repræsentation af kartografisk indhold</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende digital representasjon av kartografisk innhold</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om geografisk data relaterad till kodningen av en kartografisk resurs</rdfs:label>
        <rdfs:label xml:lang="en">has details of digital representation of cartographic content</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur digitalen Darstellung von kartografischem Inhalt</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van digitale representatie van cartografische content</rdfs:label>
        <rdfs:label xml:lang="et">kartograafilise sisu digitaalse esitusviisi täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">kartografik içeriğin dijital temsilinin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">kartografisen sisällön digitaalisen esitysmuodon tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">kartográfiai tartalom digitális ábrázolásának részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de representación digital del contenido cartográfico</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de representació digital de contingut cartogràfic</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της ψηφιακής αναπαράστασης του χαρτογραφικού περιεχομένου</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل تمثيل رقمي لمحتوى خرائطي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地图内容的数字表现的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki jeo-uzamsal bilgi kodlamasının ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una codifica delle informazioni geospaziali in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma térinformatikai információinak kódolásának részleteihez .</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin manifestaation maantieteellisen paikkatiedon koodaamisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của ghi mã thông tin địa không gian trong biểu hiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un encodage de l’information géospatiale dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una codificació de la informació geoespacial d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una codificación de información geoespacial en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een codering van geospatiale informatie in een cartografische resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende koding av geospatial informasjon i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om kodning af geodata i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of an encoding of geospatial information in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par ģeotelpiskās informācijas kodējumu kartogrāfiskajā manifestācijā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega kehastuses sisalduva georuumilise info kodeeringu kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zur Kodierung von Geoinformationen in einer Manifestation.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας κωδικοποίησης των γεωχωρικών πληροφοριών σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل تكويد للمعلومات الجغرافية المكانية في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与载体表现中地理空间信息的编码细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30223 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30223">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une émulsion sur microfilm et microfiche</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của thể sữa của vi phim và vi phiếu</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par mikrofilmas un mikrofišas emulsijas pārklājumu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi all&apos;emulsione su microfilm e microfiche</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om emulsion på mikrofilm og mikrofiche</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende emulsjon på mikrofilm og mikrofilmkort</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om emulsion på microfilm och microfiche</rdfs:label>
        <rdfs:label xml:lang="en">has details of emulsion on microfilm and microfiche</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Emulsionsschicht auf Mikrofilm und Mikrofiche</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van de emulsie op microfilm en microfiche</rdfs:label>
        <rdfs:label xml:lang="tr">mikrofilm ve mikrofiş üzerindeki emülsiyonun ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">mikrofilmen és mikrofilmlapon levő emulzió részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="et">mikrofilmi ja mikrokaardi emulsiooni täpsustus</rdfs:label>
        <rdfs:label xml:lang="fi">mikrokortin ja mikrofilmin emulsion tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de emulsión en microfilm y microficha</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats d’emulsió sobre microfilm i microfitxa</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του γαλακτώματος στη μικροταινία και στο μικροδελτίο</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن طبقة حساسة على الميكروفيلم والميكروفيش</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有缩微胶卷和缩微平片上的乳剂的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, üzerinde kaplama olarak kullanılan ışığa duyarlı kimyasallardan oluşan bir mikrofilm veya mikrofiş.süspansiyonun ayrıntılarıyla ilişkilendirir..</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una sospensione di sostanza chimica fotosensibile utilizzata come uno strato su un microfilm o una microfiche.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát mikrofilmen vagy mikrofilmlapon bevonatként használt fényérzékeny vegyszerek szuszpenziójának részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin mikrofilmin tai mikrokortin valoherkkiä kemikaaleja sisältävästä pinnoitteesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của thể vẩn của hoá chất nhậy sáng được sử dụng như là lớp phủ trên vi phim hoặc vi phiếu.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une suspension de produits chimiques photosensibles qui est utilisée comme revêtement sur un microfilm ou une microfiche.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una suspensió de substàncies químiques sensibles a la llum que s’usa com a revestiment d’un microfilm o una microfitxa.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una suspensión de sustancias químicas sensibles a la luz que se utiliza como recubrimiento en un microfilm o microficha.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een suspensie van lichtgevoelige chemicaliën die gebruikt worden als coating van een microfilm of microfiche.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en suspensjon av lysfølsomme kjemikalier som er brukt som belegg på mikrofilm eller mikrofilmkort.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om opslæmmede lysfølsomme kemikalier, som anvendes som belægning på en mikrofilm eller mikrofiche.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a suspension of light-sensitive chemicals that is used as a coating on a microfilm or microfiche.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par gaismas jutīgu ķīmisku suspensiju, ko lieto mikrofilmu vai mikrofišu pārklājumos.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega valgustundliku kemikaali kihi kohta, mida on kasutatud mikrofilmi või mikrokaardi pinna katmiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer Suspension aus lichtempfindlichen Chemikalien, die als Beschichtung eines Mikrofilms oder eines Mikrofiches verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός αιωρήματος χαμηλής ευαισθησίας χημικών που χρησιμοποιείται ως επίστρωση πάνω σε μικροταινία ή σε μικροδελτίο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل المواد الكيميائية الحساسة للضوء التي تستخدم كغلاف على ميكروفيلم أو ميكروفيش.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与缩微胶卷或缩微平片表面感光化合物的悬浮涂层的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30224 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30224">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un format d’encodage</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của định dạng ghi mã</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par kodējuma formātu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al formato di codifica</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om indkodningsformat</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende kodeformat</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om kodningsformat</rdfs:label>
        <rdfs:label xml:lang="en">has details of encoding format</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Kodierungsformat</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van coderingsformaat</rdfs:label>
        <rdfs:label xml:lang="et">kodeerimisformaadi täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">kodlama formatının ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">koodausmuodon tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">kódolási formátum részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del formato de codificación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de format de codificació</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του μορφότυπου κωδικοποίησης</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل نظام ترميز</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编码格式的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir dijital içeriği kodlamak için kullanılan bir şema veya standardın ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a uno schema, standard, etc. utilizzato per la codifica del contenuto digitale di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát azon séma vagy szabvány részleteihez, amelyet egy megjelenési forma digitális tartalmának a kódolására használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin manifestaation digitaalisen sisällön koodaamiseen käytetystä skeemasta tai standardista.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của lược đồ, chuẩn, v.v..., được sử dụng để ghi mã nội dung số của biểu hiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une norme ou d’un schéma utilisé pour encoder le contenu numérique d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un esquema o d’un estàndard usat per codificar el contingut digital d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un esquema o estándar utilizado para codificar el contenido digital de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een schema of standaard gebruikt om de digitale content van een resource te coderen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende et skjema, en standard etc. brukt til å kode det digitale innholdet i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om skema, standard etc., som bruges til kodning af en manifestations digitale indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a schema or standard used to encode the digital content of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par shēmu, standartu u.tml., ko lieto, lai kodētu manifestācijas digitālo saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega süsteemi või standardi kohta, mida on kasutatud kehastuse digitaalsisu kodeerimiseks. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu dem Schema oder Standard, das/der zum Kodieren des digitalen Inhalts einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός σχήματος, προτύπου κ.λπ. που χρησιμοποιείται για την κωδικοποίηση του ψηφιακού περιεχομένου μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل خطة، أو معيار، إلخ. مستخدم في تكويد المحتوى الرقمي لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于对一种载体表现的数字内容进行编码的一种方案或标准的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30225 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30225">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un type de fichier</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của kiểu tệp</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par datnes tipu</rdfs:label>
        <rdfs:label xml:lang="tr">dosya türünün ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">faili tüübi täpsustus</rdfs:label>
        <rdfs:label xml:lang="hu">fájltípus részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al tipo di file</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om filtype</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende filtype</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om filtyp</rdfs:label>
        <rdfs:label xml:lang="en">has details of file type</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Dateityp</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van bestandstype</rdfs:label>
        <rdfs:label xml:lang="fi">tiedostotyypin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del tipo de archivo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de tipus de fitxer</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του τύπου του αρχείου</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل نوع الملف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有文件类型细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bilgisayar dosyasında kodlanan genel bir veri içeriği türünün ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un tipo generale di contenuto di dati codificati in un file per computer.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy számítógépes fájlban kódolt adattartalom általános típusának részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin tiedostoon koodatun datasisällön yleisestä tyypistä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của loại chung của nội dung dữ liệu được lập mã trong tệp máy tính.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un type général de contenu des données encodées dans un fichier informatique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un tipus general de contingut de les dades que es codifiquen en un fitxer informàtic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un tipo general de contenido de datos que está codificado en un archivo informático.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een algemeen type data gecodeerd in een computerbestand.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en generell type datainnhold som er kodet i en datafil.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en type af dataindhold, som er kodet i en computerfil.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a general type of data content that is encoded in a computer file.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par datnē iekodēto datu satura tipu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega failis kodeeritud andmesisu üldise tüübi kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer allgemeinen Art von Dateninhalt, der in einer Datei kodiert ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός γενικού τύπου δεδομένων περιεχομένου κωδικοποιημένων σε ένα αρχείο ηλεκτρονικού υπολογιστή.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل نوع عام لمحتوى بيانات يتم تكويدها في ملف كمبيوتر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与计算机文件中编码的数据内容的一般类型的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30232 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30232">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une caractéristique de sillon</rdfs:label>
        <rdfs:label xml:lang="hu">barázdajellemzők részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của đặc trưng đường rãnh</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par rievu raksturojumu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla caratteristica del solco</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om rillekarakteristika</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende rilleegenskaper</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om spårkaraktäristika</rdfs:label>
        <rdfs:label xml:lang="en">has details of groove characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Rilleneigenschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van groefkenmerken</rdfs:label>
        <rdfs:label xml:lang="tr">oluk özelliğinin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de ranura característica</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de característiques de solc</rdfs:label>
        <rdfs:label xml:lang="fi">uran ominaisuuksien tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="et">vao tunnuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του χαρακτηριστικού της αύλακας</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن خاصية تلثيم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有纹槽特征的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, analog bir diskin oluk genişliği veya analog bir silindirin oluk aralığıyla ilgili ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una profondità del solco di un disco analogico o passo del solco di un cilindro analogico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy analóg lemez barázdaszélességének vagy egy analóg henger barázdamélységének részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin analogisen levyn uran leveydestä tai äänilieriön urajaosta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của chiều rộng đường rãnh của đĩa tương tự hoặc mức đương rãnh trong trục lăn tương tự.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une largeur de sillon d’un disque analogique ou d’un pas de sillonnage d’un cylindre analogique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una amplada del solc d’un disc analògic o un pas del solc d’un cilindre analògic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles del ancho de una ranura de un disco analógico o un paso de ranura de un cilindro analógico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een groefbreedte van een analoge schijf of groefpitch van een analoge cilinder.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende rillebredde for en analog plate eller rillevidde for en analog sylinder.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en rillebredde på en analog disk eller en rilledybde på en analog cylinder.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a groove width of an analog disc or a groove pitch of an analog cylinder.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par analoga diska (skaņuplates) rievu platumu vai analogā ruļļa (cilindra) rievu dziļumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega analoogplaadi vao laiuse või analoogtrumli vao sammu kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zur Rillenbreite einer Schallplatte oder zum Rillenabstand eines Phonographenzylinders.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες του πλάτους μιας αύλακας ενός αναλογικού δίσκου ή του ύψους μιας αύλακας ενός αναλογικού κυλίνδρου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل عرض المسار لقرص تناظري أو مسار الاسطوانة التناظرية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与模拟盘的纹槽宽度或模拟筒的纹槽间距的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30233 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30233">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une disposition</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của sắp đặt</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par salikumu</rdfs:label>
        <rdfs:label xml:lang="tr">düzen ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al layout </rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om layout</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende layout</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om layout</rdfs:label>
        <rdfs:label xml:lang="en">has details of layout</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Layout</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van lay-out</rdfs:label>
        <rdfs:label xml:lang="et">küljenduse täpsustus</rdfs:label>
        <rdfs:label xml:lang="fi">layoutin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de diseño</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de disposició</rdfs:label>
        <rdfs:label xml:lang="hu">tördelés részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της τυπογραφικής διάταξης</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن تصميم طباعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有版式细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki metin, resimler, dokunsal notasyon veya diğer içeriğin bir düzenlemesinin ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una disposizione del testo, immagini, notazione tattile, etc. in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát szöveg, képek, tapintható lejegyzés vagy egyéb tartalom elrendezésének részleteihez egy megjelenési formában.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin manifestaatioon sisältyvän tekstin, kuvien, taktiilin nuottikirjoituksen tai muun sisällön sommittelusta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của sự sắp xếp của văn bản, hình ảnh, ký hiệu xúc giác, v.v..., trong biểu hiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un agencement du texte, des images, de la notation tactile ou de tout autre contenu dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un arranjament de text, imatges, notació tàctil o un altre contingut d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una disposición de texto, imágenes, notación táctil u otro contenido en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een rangschikking van tekst, beeld, tactiele notatievormen of andere content in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende hvordan tekst, bilder, berøringsnotasjon etc. er ordnet i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om opstilling af tekst, billeder, taktil notation etc. i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of an arrangement of text, images, tactile notation, or other content in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par teksta, attēlu, u.tml. izkārtojumu manifestācijā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega teksti, piltide, taktiilse notatsiooni jms paigutuse kohta kehastuses.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zur Anordnung von Text, Bildern, taktiler Notation oder anderem Inhalt in einer Manifestation.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας οργάνωσης του κειμένου, των εικόνων, της απτικής σημειογραφίας κ.λπ. σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل ترتيب النص، والصورة، والكتابة البارزة، إلخ. في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与载体表现中对文本、图像、触摸标记或其他内容的安排的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30234 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30234">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une monture</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của khung</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par balstu/paliktni</rdfs:label>
        <rdfs:label xml:lang="hu">foglalat részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla montatura</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om monteringskarton</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende underlag eller ramme</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om montering</rdfs:label>
        <rdfs:label xml:lang="en">has details of mount</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Halterung</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van ondersteuning</rdfs:label>
        <rdfs:label xml:lang="tr">montaj ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de montaje</rdfs:label>
        <rdfs:label xml:lang="et">tugimaterjali täpsustus</rdfs:label>
        <rdfs:label xml:lang="fi">tukimateriaalin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de muntura</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της βάσης στήριξης</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن حامل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有衬底/底座细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin temel malzemesinin iliştirildiği destek veya arkalık için kullanılan fiziksel bir malzemenin detaylarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un materiale fisico utilizzato come supporto o sostegno al quale si fissa il materiale di base di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma alapanyagához csatolt tartóként vagy támaszként használt fizikai anyag részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin materiaalista, johon manifestaation pohjamateriaali kiinnitetään aineiston tukemiseksi tai kannattamiseksi.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của vật liệu vật lý được sử dụng để hỗ trợ hoặc đỡ mà vật liệu cơ sở của biểu thị được gắn vào.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un matériau physique qui est utilisé pour le support ou le renforcement, sur lequel le matériau de base d’une manifestation a été fixé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un material físic que s’usa de suport o de reforçament al qual s’ha subjectat el material de base d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un material físico que se utiliza como soporte o respaldo al que se ha adherido el material base de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een fysiek materiaal gebruikt als steun of ondergrond waaraan het basismateriaal van een resource is bevestigd.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende det fysiske materialet som er brukt som støtte eller bakgrunn og som basismaterialet til en manifestasjon er festet til.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om det fysiske materiale, som udgør den støtte eller bagbeklædning, som en manifestations basismateriale er fastgjort på.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a physical material that is used for the support or backing to which the base material of a manifestation has been attached.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par materiālu, ko lieto atbalstam vai kā paliktni, uz kura piestiprināts manifestācijas pamatmateriāls.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega toestava materjali kohta, mille külge on kinnitatud kehastuse alusmaterjal.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu dem physischen Material, das für die Halterung oder die Stütze verwendet wird, an dem das Trägermaterial einer Manifestation angebracht ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός φυσικού υλικού το οποίο χρησιμοποιείται για τη στήριξη ή την υποστήριξη, με το οποίο έχει συνδεθεί το βασικό υλικό μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل مادة مادية مستخدمة في التدعيم أو السند لمادة القاعدة التي تكون تجسيدة ملصقة بها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于支撑或背衬的载体表现的基底材料所附着的物理材料的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30235 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30235">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une vitesse de lecture</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của tốc độ chơi</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par atskaņošanas ātrumu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla velocità di riproduzione</rdfs:label>
        <rdfs:label xml:lang="sv">har details of playing speed</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om omdrejningshastighed</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende avspillingshastighet</rdfs:label>
        <rdfs:label xml:lang="en">has details of playing speed</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Abspielgeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van afspeelsnelheid</rdfs:label>
        <rdfs:label xml:lang="hu">lejátszási sebesség részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="et">mängimiskiiruse täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">oynatma hızı ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de la velocidad de reproducción</rdfs:label>
        <rdfs:label xml:lang="fi">toistonopeuden tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de velocitat de reproducció</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της ταχύτητας αναπαραγωγής</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل سرعة تشغيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有播放速度细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, amaçlanan sesi üretmek için bir ses taşıyıcısının çalıştırılması gereken hızın ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un velocità a cui un supporto audio deve essere utilizzato per produrre il suono desiderato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy sebesség részleteihez, amelyen egy hanghordozónak működnie kell, hogy a kívánt hangot elő tudják állítani.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin nopeudesta, jolla äänitallenne on toistettava äänen tuottamiseksi tarkoitetulla tavalla.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của tốc độ mà vật mang audio phải vận hành để tạo ra âm thanh dự kiến.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une vitesse à laquelle un support matériel audio doit être utilisé pour produire le son prévu.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una velocitat a la qual un suport físic àudio ha de funcionar per produir el so previst.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de la velocidad a la que se debe operar un portador de audio para producir el sonido deseado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een snelheid waarmee een geluidsdrager moet worden afgespeeld om het bedoelde geluid te produceren.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende hastigheten som kreves for at en lydbærer skal produsere lyd slik den var ment.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om den hastighed, som en lydbærer skal betjenes ved for at producere den ønskede lyd.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a speed at which an audio carrier must be operated to produce the sound intended.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par paredzēto atskaņošanas ātrumu skaņu ierakstam kādā nesējam jāatskaņo ierakstītais, lai iegūtu plānoto skaņu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega kiiruse kohta, millega tuleb helikandjat käitada, et tekiks ettenähtud heli.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zur Geschwindigkeit, mit der ein Tonträger für die korrekte Wiedergabe abgespielt werden muss.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας ταχύτητας στην οποία πρέπει να λειτουργεί ένας φορέας αποθήκευσης ήχου για την παραγωγή του σκοπούμενου ήχου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل سرعة يجب أن يتم تشغيل حامل الصوت بها لكي ينتج الصوت المطلوب.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种音频载体要产生所期望的声音必须操作的速度的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30236 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30236">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une polarité</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của phân cực</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par polaritāti</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla polarità</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om polaritet</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende polaritet</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om polaritet</rdfs:label>
        <rdfs:label xml:lang="en">has details of polarity</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Polarität</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van polariteit</rdfs:label>
        <rdfs:label xml:lang="et">polaarsuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">polarite ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">polariteetin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">polaritás részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de polaridad</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de polaritat</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της πολικότητας</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن استقطاب ألوان</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有极性细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, görüntüdeki renklerin ve tonların yeniden üretilen nesnenin renk ve tonlarıyla olan ilişkisinin ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un relazione tra i colori e i toni in un&apos;immagine e i colori e i toni dell&apos;oggetto riprodotto.</skos:definition>
        <skos:definition xml:lang="hu">Egy kép színei és tónusai, valamint a reprodukált tárgy színei és tónusai között fennálló viszony részletei.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin suhteesta, joka kuvan väreillä ja valoisuudella on kuvan kohteen väreihin ja valoisuuteen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của mối quan hệ của màu và sắc thái trong hình ảnh với màu và sắc thái của vật thể được sao chép.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une relation des couleurs et des tons d’une image avec les couleurs et les tons de l’objet reproduit.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una relació entre els colors i les tonalitats d’una imatge amb els colors i les tonalitats de l’objecte reproduït.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una relación de los colores y tonos de una imagen con los colores y tonos del objeto reproducido.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een relatie tussen de kleuren en tonen in een beeld en de kleuren en tonen van de reproductie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende forholdet mellom fargene og tonene til et bilde og fargene og tonene til motivet som gjengis.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om et forhold mellem farverne og nuancerne i et billede og farverne og nuancerne i den reproducerede genstand.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a relationship of the colours and tones in an image to the colours and tones of the object reproduced.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par attēla krāsu un toņu atbilstību reproducētā objekta krāsām un toņiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega pildi värvuste ja toonide ning reprodutseeritud objekti värvuste ja toonide suhte kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu dem Verhältnis der Farben und Tönungen in einem Bild zu den Farben und Tönungen des reproduzierten Objekts.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας σχέσης των χρωμάτων και των αποχρώσεων σε μια εικόνα με τα χρώματα και τις αποχρώσεις του αναπαραγόμενου αντικειμένου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل علاقة الألوان ودرجاتها في صورة ما والألوان ودرجاتها في الشيء المعاد إنتاجه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一个对象的图像中色彩和色调与被复制对象的色彩和色调的关系的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30237 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30237">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un format de projection</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của định dạng trình bày</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par attēlošanas formātu</rdfs:label>
        <rdfs:label xml:lang="et">esitusformaadi täpsustus</rdfs:label>
        <rdfs:label xml:lang="fi">esitysformaatin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al formato di presentazione</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om fremvisningsformat</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende visningsformat</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om filmprojektionssystem</rdfs:label>
        <rdfs:label xml:lang="en">has details of presentation format</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Wiedergabeformat</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van presentatieformaat</rdfs:label>
        <rdfs:label xml:lang="hu">prezentációs formátum részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="tr">sunum formatının ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del formato de presentación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de format de presentació</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του μορφότυπου παρουσίασης</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل شكل عرض</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有呈现格式细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yansıtılan bir görüntünün üretiminde kullanılan bir formatın ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un formato utilizzato nella produzione di un&apos;immagine proiettata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kivetített kép előállításánál használt formátum részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin heijastettavan kuvan tuottamisessa käytettävästä formaatista.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của định dạng được yêu cầu trong sản xuất hình ảnh chiếu.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un format qui est utilisé pour la production d’une image projetée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un format que s’usa en la producció d’una imatge projectada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un formato que se utiliza en la producción de una imagen proyectada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een formaat gebruikt voor de productie van een geprojecteerd beeld.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende formatet som er brukt ved produksjon av et projisert bilde.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om et format, som anvendes ved fremstillingen af et projiceret billede.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a format that is used in the production of a projected image.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par formātu projicētā attēla rādīšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega formaadi kohta, mida on kasutatud projitseeritava pildi tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu dem Format, das bei der Entstehung eines projizierten Bilds verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός μορφότυπου που χρησιμοποιείται για την παραγωγή μιας προβαλλόμενης εκόνας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل شكل مستخدم في إنتاج صورة مرئية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于一个投影图像制作的格式的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30241 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30241">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une caractéristique de projection d’un film cinématographique</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của đặc trưng chiếu của phim điện ảnh</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par kinofilmas demonstrēšanas raksturlielumu</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvafilmin projisointiominaisuuksien tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">filmvetítési jellemzők részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla caratteristica di proiezione di pellicola cinematografica</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om projiceringskarakteristika for spillefilm</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende projeksjonsegenskaper for spillefilm</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om projektionskarakteristika för film</rdfs:label>
        <rdfs:label xml:lang="en">has details of projection characteristic of motion picture film</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Projektionseigenschaft eines Films</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van projectiekenmerken van speelfilm</rdfs:label>
        <rdfs:label xml:lang="et">kinofilmi projitseerimistunnuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">sinema filminin projeksiyon özelliğinin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de proyección característicos de una película cinematográfica</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de característiques de projecció d’una pel·lícula cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του χαρακτηριστικού της προβολής της κινηματογραφικής ταινίας</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن خاصية عرض أفلام صور متحركة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影胶卷的投影特征的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir sinema filminin gösterimiyle ilgili teknik bir şartnamenin ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una specifica tecnica relativa alla proiezione di una pellicola cinematografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy mozgófilm vetítéséhez kapcsolódó műszaki specifikáció részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin elokuvafilmin projisointia koskevasta teknisestä määrityksestä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của đặc tính kỹ thuật liên quan tới chiếu phim điện ảnh.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une spécification technique relative à la projection d’un film cinématographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una especificació tècnica relativa a la projecció d’una pel·lícula cinematogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una especificación técnica relativa a la proyección de una película cinematográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een technische specificatie gerelateerd aan de projectie van een speelfilm.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en teknisk spesifikasjon knyttet til projeksjonen av en spillefilm.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en teknisk specifikation, som relaterer til projiceringen af en spillefilm.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a technical specification relating to the projection of a motion picture film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par tehnisko specifikāciju kinofilmu demonstrēšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega tehnilises kirjelduses, mis puudutab kinofilmi projitseerimist.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer technischen Spezifikation, die sich auf die Projektion eines Films bezieht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας τεχνικής προδιαγραφής που συνδέεται με την προβολή μιας κινηματογραφικής ταινίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل خصائص فنية متعلقة بعرض فيلم صور متحركة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种电影胶卷的投影有关的技术规格的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30242 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30242">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une vitesse de projection</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của tốc độ chiếu</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par demonstrēšanas ātrumu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla velocità di proiezione</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om projiceringshastighed</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende projeksjonshastighet</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om projektionshastighet</rdfs:label>
        <rdfs:label xml:lang="en">has details of projection speed</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Projektionsgeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van projectiesnelheid</rdfs:label>
        <rdfs:label xml:lang="tr">projeksiyon hızı ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">projisointinopeuden tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="et">projitseerimiskiiruse täpsustus</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de la velocidad de proyección</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de velocitat de projecció</rdfs:label>
        <rdfs:label xml:lang="hu">vetítési sebesség részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της ταχύτητας προβολής</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل سرعة عرض</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有投影速度细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, amaçlanan hareketli görüntüyü üretmek için yansıtılan bir taşıyıcının çalıştırılması gereken hızın ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un velocità a cui un supporto proiettato deve essere azionato per produrre l&apos;immagine in movimento desiderata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát azon sebesség részleteihez, amelyen egy kivetített hordozónak működnie kell, hogy a kívánt mozgóképet elő tudják állítani.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin nopeudesta, jolla projisoitava tallenne tulee esittää liikkuvan kuvan näyttämiseksi tarkoitetulla tavalla.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của tốc độ mà vật mang tin chiếu phải hoạt động để tạo ta hình ảnh động như dự kiến.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une vitesse à laquelle un support matériel projeté doit être utilisé pour produire l’image animée prévue.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una velocitat a la qual ha de funcionar un suport físic projectat per produir el moviment d’imatges previst.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de la velocidad a la que se debe operar un soporte proyectado para producir la imagen en movimiento deseada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een snelheid waarmee een projectiedrager moet worden afgespeeld om het bedoelde bewegende beeld te produceren.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende hastigheten som kreves for at et projeksjonsmedium skal produsere levende bilder slik de var ment.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om den hastighed, som en projiceret bærer skal betjenes ved for at producere det ønskede levende billede.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a speed at which a projected carrier must be operated to produce the moving image intended.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par ātrumu, ar kādu projekcijas nesējs darbojas, lai demonstrētu kustīgo attēlu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega kiiruse kohta, millega tuleb projitseeritavat kandjat käitada, et tekiks ettenähtud liikuv pilt.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zur Geschwindigkeit, mit der ein projizierbarer Datenträger betrieben werden muss, um das beabsichtigte Bewegtbild zu erzeugen.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας ταχύτητας στην οποία ο προβαλλόμενος φορέας αποθήκευσης πρέπει να λειτουργεί για την παραγωγή της σκοπούμενης κινητής εικόνας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل سرعة التي يجب أن يشغل بها حامل العرض لكي ينتج عنه الصورة المتحركة المطلوبة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种投影载体要产生所期望的动态图像必须操作的速度的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30244 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30244">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une désignation de facteur de réduction</rdfs:label>
        <rdfs:label xml:lang="hu">csökkenési arányjelölés részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của định danh tỷ lệ thu nhỏ</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par reducēšanas noteikšanu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla designazione del rapporto di riduzione</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om reduktionsforholdsbetegnelse</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende betegnelse for reduksjonsrate</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om förminskningsgrad</rdfs:label>
        <rdfs:label xml:lang="en">has details of reduction ratio designation</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Bezeichnung eines Verkleinerungsfaktors</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van benaming verkleiningsfactor</rdfs:label>
        <rdfs:label xml:lang="tr">küçültme oranının ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">pienennyssuhteen määritteen tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de la designación de la relación de reducción</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de designació d’escala de reducció</rdfs:label>
        <rdfs:label xml:lang="et">vähendussuhte tähistuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του προσδιορισμού του λόγου σμίκρυνσης</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن تسمية نسبة تصغير الصور</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有缩率标识细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, üretildiği orijinal ile ilişkili olarak bir mikro görüntünün boyutunun genel bir tanımının ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una designazione generale della dimensione di una microimmagine in relazione all&apos;originale da cui è stata prodotta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát azon általános megjelölés részleteihez, amely egy mikrokép nagyságát jelzi az eredetihez viszonyítva, amelyből azt előállították.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin yleisestä määritteestä, joka ilmaisee mikrokokoiseksi pienennetyn kuvan suhteen alkuperäiseen kuvaan, josta pienennetty kuva on tuotettu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của tỷ số giữa độ lớn của hình ảnh thu nhỏ với nguyên gốc mà nó được tạo ra,</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une désignation générale de la taille d’une micro-image par rapport à celle de l’original à partir duquel elle a été produite.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una designació de la mida d’una microimatge en relació a l’original a partir del qual es va produir.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una designación general del tamaño de una microimagen en relación con el original a partir del cual fue producida.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van de aanduiding van grootte van een microbeeld betreffende het origineel waarvan het werd afgeleid.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en generell betegnelse for størrelsen på et mikrobilde i forhold til originalen som det ble produsert fra.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en almindelig betegnelse for størrelsen på et mikrobillede i forhold til den original, som det er fremstillet ud fra.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a general designation of the size of a micro-image in relation to the original from which it was produced.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par mikroattēla oriģināla lieluma noteikšanu, no kura tas ticis ražots.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega mikrokujutise ja selle aluseks oleva originaali suuruse arvulise suhte üldise tähistuse kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer allgemeinen Bezeichnung für die Größe eines Mikro-Bilds im Verhältnis zum Original, von dem es hergestellt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός γενικού προσδιορισμού του μεγέθους μιας μικρο-εικόνας με το πρωτότυπο από το οποίο παρήχθη.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل تسمية عامة لحجم الصورة المصغرة وعلاقتها بالأصل الذي تم إنتاجها منه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与缩微图像尺寸和其所复制的原件之间一般关系的标识的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30246 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30246">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une caractéristique de lecture particulière</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của đặc trưng phát lại</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par specifisku atskaņojuma pazīmi</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla caratteristica di riproduzione speciale</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om særlige afspilningskarakteristika</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende spesielle avspillingsegenskaper</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om specifika uppspelningskaraktäristika</rdfs:label>
        <rdfs:label xml:lang="en">has details of special playback characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zu einer besonderen Wiedergabeeigenschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van bijzondere afspeelkenmerken</rdfs:label>
        <rdfs:label xml:lang="et">heli taasesituse eritunnuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="hu">speciális visszajátszási jellemzők részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de características especiales de reproducción</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de característiques especials de reproducció</rdfs:label>
        <rdfs:label xml:lang="fi">äänentoiston erityisominaisuuksien tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="tr">özel oynatma özelliğinin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του ειδικού χαρακτηριστικού της αναπαραγωγής</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن خاصية خاصة للتشغيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有特别回放特征的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimdeki, bir ses kaydının yapılmasında kullanılan bir eşitleme sisteminin, gürültü azaltma sisteminin veya diğer işlemlerin ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un sistema di equalizzazione, sistema di riduzione del rumore, etc. utilizzato nella realizzazione di una registrazione audio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kiegyenlítési rendszer, hangcsökkentő rendszer, vagy egyéb eljárás részleteihez, amelyeket egy hangfelvétel készítésénél használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin äänitteen äänityksessä käytetystä taajuuskorjausjärjestelmästä, kohinanvaimennusjärjestelmästä tai muusta prosessoinnista.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của hệ thống ngang bằng, hệ thống giảm tiếng ồn, v.v..., được sử dụng để tạo bản ghi audio.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un système d’égalisation, d’un système de réduction du bruit ou d’un autre traitement utilisé lors de la réalisation d’un enregistrement audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un sistema d’equalització, de reducció de soroll o un altre processament que s’usa en fer un enregistrament àudio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un sistema de ecualización, sistema de reducción de ruido u otro procesamiento que se utiliza para realizar una grabación de audio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van equalisatiesysteem, ruisonderdrukkend systeem of ander systeem dat gebruikt wordt bij het maken van een geluidsopname.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende systemer for tonekontroll, støyreduksjon etc. som er brukt ved produksjon av lydopptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om et equalizersystem, støjdæmpningssystem etc., som anvendes til at lave en lydoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of an equalization system, noise-reduction system, or other processing that is used in making an audio recording.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par skaņu izlīdzināšanas sistēmu, trokšņu samazināšanas sistēmu, u.tml., kas izmantota skaņas ieraksta veidošanā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega heli salvestamisel kasutatud tasandussüsteemi, müravähendussüsteemi vms kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einem Ausgleichssystem, einem Störgeräusch-Reduktionssystem oder einer anderen Verarbeitung, das/die zur Erstellung von Audioaufnahmen verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός συστήματος εξισορρόπησης, ενός συστήματος μείωσης του θορύβου κ.λπ.  που χρησιμοποιείται στην κατασκευή μιας ηχογράφησης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل نظام صوت، ونظام خفض ضوضاء، إلخ. مستخدم في إعداد تسجيل صوتي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与在一种录音制作中所使用的平衡系统、降噪系统或其他处理的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30247 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30247">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une configuration de bande magnétique</rdfs:label>
        <rdfs:label xml:lang="tr">bant yapılandırmasının ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của cấu hình băng</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par lentes konfigurāciju</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla configurazione del nastro</rdfs:label>
        <rdfs:label xml:lang="hu">hangszalagkonfiguráció részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om båndkonfiguration</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende lydbåndkonfigurasjon</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om antal spår</rdfs:label>
        <rdfs:label xml:lang="en">has details of tape configuration</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Bandkonfiguration</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van configuratie geluidsband</rdfs:label>
        <rdfs:label xml:lang="et">heliriba paigutuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de la configuración de la cinta</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de configuració de cinta</rdfs:label>
        <rdfs:label xml:lang="fi">ääninauhan raitojen määrän tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της διαμόρφωσης της μαγνητικής ταινίας</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن بنية شريط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有磁带配置的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir ses bandındaki bir dizi parçanın ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un numero di tracce su un nastro audio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy hangszalagon lévő sávok számának részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin ääninauhalla olevien ääniraitojen lukumäärästä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của số lượng rãnh trên băng audio.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’un nombre de pistes sur une bande audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un nombre de pistes d’una cinta àudio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de varias pistas en una cinta de audio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een aantal sporen op een geluidsband.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende antall spor på et lydbånd.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om antal af spor på et lydbånd.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a number of tracks on an audiotape.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par skaņas celiņu skaitu audio lentē.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega helifilmi heliriba paigutuse kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zur Anzahl der Spuren auf einem Tonband.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός αριθμού κομματιών σε μια ταινία ήχου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل عدد المسارات على شريط صوت.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与录音磁带上的音轨数的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30248 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30248">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une configuration de piste</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của đặc trưng rãnh</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par skaņu celiņa konfigurāciju</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla configurazione della traccia</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om lydsporskonfiguration</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende sporkonfigurasjon</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om ljudspårskonfiguration för film</rdfs:label>
        <rdfs:label xml:lang="en">has details of track configuration</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Tonspurlage</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van nummerconfiguratie</rdfs:label>
        <rdfs:label xml:lang="tr">parça yapılandırmasının ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">salvestustüübi täpsustus</rdfs:label>
        <rdfs:label xml:lang="hu">sávkonfiguráció részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de la configuración de la pista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de configuració de pista</rdfs:label>
        <rdfs:label xml:lang="fi">ääniraidan sijainnin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες της διαμόρφωσης κομματιού</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل عن بنية مسار</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音轨配置的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir ses bandı filmi üzerindeki ses parçası konfigürasyonunun ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una configurazione della traccia audio su una pellicola con traccia audio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát a hangsáv konfigurációjának részleteihez egy hangsávos filmen.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin ääniraidan sijainnista äänifilmissä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của cấu hình của rãnh audio trên phim có rãnh âm thanh.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une configuration de la piste audio sur une bande sonore de film.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una configuració de la pista àudio en una banda sonora d’una pel·lícula.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una configuración de la pista de audio en una película con banda sonora.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een configuratie van het geluidsspoor van een geluidsfilm.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende konfigurasjon av lydsporet til en film med lydspor.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en konfiguration af lydsporet til en film med soundtrack.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a configuration of the audio track on a sound-track film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par audio skaņas celiņa atrašanās vietu kinofilmas lentē.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega meetodi kohta, mida on kasutatud helisisu kodeerimiseks taasesituse tarbeks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu Details zur Positionierung der Tonspur auf einem Film mit Tonspur.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας διαμόρφωσης του ηχητικού κομματιού σε ένα τμήμα ήχου για ταινία.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل إعدادات مسار الصوت على مسار صوت الفيلم.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与原声电影片上的音轨配置的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30249 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30249">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un type d’enregistrement</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của loại ghi</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par skaņu ieraksta veidu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al tipo di registrazione</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om indspilningskarakteristika</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende typen opptak</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om inspelningstyp</rdfs:label>
        <rdfs:label xml:lang="en">has details of type of recording</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Art einer Aufnahme</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van opnamesoort</rdfs:label>
        <rdfs:label xml:lang="tr">kayıt türü ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rögzítéstípus részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del tipo de grabación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de tipus d’enregistrament</rdfs:label>
        <rdfs:label xml:lang="et">video tunnuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="fi">äänen tallentamisen tavan tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του τύπου της ηχογράφησης</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل نوع التسجيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有录音的类型的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, oynatma için ses içeriğini kodlamak için kullanılan bir yöntemin ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a un metodo utilizzato per la codifica del contenuto audio per la riproduzione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát azon módszer részleteihez, amelyet audiótartalom kódolásához használnak visszajátszás céljára.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin menetelmästä, jota on käytetty äänen tallentamiseksi äänentoistoa varten.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của phương pháp được sử dụng để ghi mã nội dung cho phát lại.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une méthode qui est utilisée pour encoder un contenu audio pour la lecture.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un mètode que s’usa per codificar el contingut àudio per a la reproducció.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un método que se utiliza para codificar contenido de audio para su reproducción.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een methode gebruikt om audio content te coderen voor afspelen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en metode som er brukt for å kode lydinnhold for avspilling.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en metode, som anvendes til at kode lydindhold til afspilning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a method that is used to encode audio content for playback.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar detaļām par metodi, kādas lietotas, lai kodētu audio saturu atskaņošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega tehnilises kirjelduses, mis puudutab kehastuses sisalduvate videokujutiste kodeeringut.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einem Verfahren, das zur Kodierung von Audio-Inhalt für die Wiedergabe verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες της μεθόδου που χρησιμοποιείται για την κωδικοποίηση ηχητικού περιεχομένου για αναπαραγωγή.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل طريقة مستخدمة في تكويد المحتوى الصوتي لتشغيل الصوت.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于编码音频内容供回放的方法的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30250 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30250">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’une caractéristique vidéo</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của đặc trưng video</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par video raksturojumu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla caratteristica video</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om videokarakteristika</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende videoegenskaper</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om videokaraktäristika</rdfs:label>
        <rdfs:label xml:lang="en">has details of video characteristic</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zur Video-Eigenschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van videokenmerken</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de la característica del video</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de característiques vídeo</rdfs:label>
        <rdfs:label xml:lang="et">video tunnuse täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">video özelliğinin ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">videon ominaisuuksien tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">videójellemző részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του χαρακτηριστικού του βίντεο</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل خاصية فيديو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有视频特征的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki video görüntülerinin kodlanmasıyla ilgili bir teknik spesifikasyonun ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una specifica tecnica relativa alla codifica di immagini video in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát azon műszaki specifikáció részleteihez, amely egy megjelenési formában videóképek kódolásához kapcsolódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin manifestaation sisältämän videon koodauksen teknisestä määrityksestä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của đặc tính kỹ thuật liên quan tới ghi mã hình ảnh video trong biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une spécification technique relative à l’encodage des images vidéo dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una especificació tècnica relativa a la codificació d’imatges de vídeo en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una especificación técnica relativa a la codificación de imágenes de vídeo en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een technische specificatie gerelateerd aan de codering van videobeelden in een resource.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en teknisk spesifikasjon knyttet til kodingen av videobilder i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en teknisk specifikation, som relaterer til kodning af videobilleder i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a technical specification relating to the encoding of video images in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par tehnisko specifikāciju, kas attiecas uz video attēlu kodējumu manifestācijā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega tehnilises kirjelduses, mis puudutab kehastuses sisalduvate videokujutiste kodeeringut.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer technischen Spezifikation, die sich auf die Kodierung von Videobildern in einer Manifestation bezieht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας τεχνικής προδιαγραφής που συνδέεται με την κωδικοποίηση εικόνων βίντεο σε μια εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل خصائص فنية المتعلقة بتكويد صور الفيديو في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现中的视频图像的编码有关的一个技术规格的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30251 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30251">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un format vidéo</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của định dạng video</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par videoformātu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al formato video</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om videoformat</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende videoformat</rdfs:label>
        <rdfs:label xml:lang="sv">har detaljerad information om videoformat</rdfs:label>
        <rdfs:label xml:lang="en">has details of video format</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Videoformat</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van videoformaat</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del formato de video</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de format vídeo</rdfs:label>
        <rdfs:label xml:lang="et">video formaadi täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">video formatı ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">videoformaatin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">videóformátum részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του μορφότυπου του βίντεο</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل شكل فيديو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有视频格式的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin analog video içeriğini kodlamak için kullanılan bir şemanın veya standardın ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a uno standard, etc. utilizzato per la codifica del contenuto video analogico di una risorsa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát azon séma vagy szabvány részleteihez, amelyet egy megjelenési forma analóg tartalmának kódolására használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin analogisen videon koodaukseen käytetystä skeemasta tai standardista. </skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của chuẩn, v.v..., được sử dụng để ghi mã nội dung video tương tự của biểu thị.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une norme ou d’un schéma qui est utilisé pour encoder le contenu vidéo analogique d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’un esquema o d’un estàndard que s’usa per codificar el contingut vídeo analògic d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de un esquema o estándar que se utiliza para codificar el contenido de vídeo analógico de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een schema of standaard dat gebruikt is om de analoge videocontent van een manifestatie te coderen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en standard etc. som er brukt til å kode det analoge videoinnholdet til en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en standard etc., som anvendes til kodning af en manifestations analoge videoindhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a schema or standard that is used to encode the analog video content of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par standartu, u.tml., kas izmantots analogā video manifestācijas satura kodēšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega analoogvideosisu kodeerimiseks kasutatud standardi vms kohta. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einem Schema oder Standard, das/der zur Kodierung des analogen Videoinhalts einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός προτύπου κ.λπ. που χρησιμοποιείται για την κωδικοποίηση του περιεχομένου ενός αναλογικού βίντεο μιας εκδήλωσης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل معيار، إلخ. مستخدم في تكويد محتوى الفيديو التناظري لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与用于对一种载体表现的模拟视频内容进行编码的一个方案或标准的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30262 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30262">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un type de données cartographiques</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của loại dữ liệu bản đồ</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par kartogrāfisko datu veidu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi al tipo di dati cartografici</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om kartografisk datatype</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende type kartografiske data</rdfs:label>
        <rdfs:label xml:lang="en">has details of cartographic data type</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum kartografischen Datentyp</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van cartografisch datatype</rdfs:label>
        <rdfs:label xml:lang="et">kartograafiaandmete tüübi täpsustus</rdfs:label>
        <rdfs:label xml:lang="tr">kartografik veri türünün ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">kartografisen tietotyypin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="hu">kartográfiai adattípus részletei következők:</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles del tipo de datos cartográficos</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de tipus de dades cartogràfiques</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του τύπου χαρτογραφικών δεδομένων</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل نوع بيانات خرائطية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地理数据类型的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, jeo-uzamsal özelliklerin makine tarafından okunabilen bir temsilinin ayrıntılarıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una rappresentazione di caratteristiche geospaziali in formato leggibile dalla macchina.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát térinformatikai jellemzők géppel olvasható ábrázolásának részleteihez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin maantieteellisten ominaisuuksien konelukuisesta esityksestä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của trình bày máy đọc được của địa vật địa không gian.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une représentation lisible par machine de caractéristiques géospatiales.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una representació llegible per màquina de les característiques geoespacials.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una representación legible por máquina de características geoespaciales.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een machine-leesbare weergave van geospatiale kenmerken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en maskinlesbar framstilling av geospatiale elementer.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en maskinlæsbar repræsentation af geoobjekter.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a machine-readable representation of geospatial features.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par mašīnlasāmu ģeotelpisko parametru attēlošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega georuumiliste andmete masinloetava esituse kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu den Details zu einer maschinenlesbaren Darstellung von Geodaten.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες μιας μηχαναγνώσιμης αναπαράστασης γεωχωρικών χαρακτηριστικών.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل تمثيل مقروء آليًا لملامح جغرافية مكانية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与地理空间特征的机器可读表现的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30263 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30263">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour désignation de facteur de réduction</rdfs:label>
        <rdfs:label xml:lang="hu">csökkenési arányjelölése a következő:</rdfs:label>
        <rdfs:label xml:lang="vi">có định danh tỷ lệ thu nhỏ</rdfs:label>
        <rdfs:label xml:lang="it">ha come designazione del rapporto di riduzione</rdfs:label>
        <rdfs:label xml:lang="no">har betegnelse for reduksjonsrate</rdfs:label>
        <rdfs:label xml:lang="da">har reduktionsforholdsbetegnelse</rdfs:label>
        <rdfs:label xml:lang="en">has reduction ratio designation</rdfs:label>
        <rdfs:label xml:lang="de">hat Bezeichnung des Verkleinerungsfaktors</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aanduiding verkleiningfactor</rdfs:label>
        <rdfs:label xml:lang="tr">küçültme oranı tanımlaması ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">pienennyssuhteen määrite</rdfs:label>
        <rdfs:label xml:lang="lv">samazinājuma pakāpes apzīmējums</rdfs:label>
        <rdfs:label xml:lang="es">tiene designación de relación de reducción</rdfs:label>
        <rdfs:label xml:lang="ca">té com a designació d’escala de reducció</rdfs:label>
        <rdfs:label xml:lang="et">vähendussuhte tähistus</rdfs:label>
        <rdfs:label xml:lang="el">έχει προσδιορισμό του λόγου σμίκρυνσης</rdfs:label>
        <rdfs:label xml:lang="ar">له تسمية نسبة تصغير الصور</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有缩率标识</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, üretildiği orijinali ile ilişkili olarak bir mikro görüntünün boyutunun genel bir tanımıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una designazione generale della dimensione di una microimmagine in relazione all&apos;originale da cui è stata prodotta</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy általános megjelöléshez, amely a mikrokép méretének az eredetiből viszonyított számarányára vonatkozik, amelyből azt előállították.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yleiseen määritteeseen, joka ilmaisee mikrokokoiseksi pienennetyn kuvan suhteen alkuperäiseen kuvaan, josta pienennetty kuva on tuotettu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với định danh chung của cỡ của hình ảnh thu nhỏ với nguyên gốc mà nó được tạo ra,</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une désignation générale de la taille d’une micro-image par rapport à celle de l’original à partir duquel elle a été produite.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una designació general de la mida d’una microimatge en relació a l’original a partir del qual s’ha produït.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una designación general del tamaño de una microimagen en relación con el original a partir del cual fue producida.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een algemene aanduiding van de grootte van een microbeeld in relatie tot het origineel waarvan het werd afgeleid.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en generell betegnelse for størrelsen på et mikrobilde i forhold til originalen som det ble produsert fra.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en almindelig betegnelse for størrelsen på et mikrobillede i forhold til den original, som det er fremstillet ud fra.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a general designation of the size of a micro-image in relation to the original from which it was produced.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar vispārēju mikroattēla izmēru attiecību pret oriģināla izmēriem, no kura tas izgatavots.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse mikrokujutise ja selle aluseks oleva originaali suuruse arvulise suhte üldise tähistusega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer allgemeinen Bezeichnung für die Größe eines Mikro-Bilds im Verhältnis zum Original, von dem es hergestellt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με έναν γενικό προσδιορισμό του μεγέθους μιας μικρο-εικόνας σε σχέση με το πρωτότυπο από το οποίο παρήχθη.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتسمية عامة لحجم الصورة المصغرة وعلاقتها بالأصل الذي تم إنتاجها منه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与缩微图像尺寸和其所复制的原件之间关系的一般标识关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30265 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30265">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour œuvre en relation avec une manifestation</rdfs:label>
        <rdfs:label xml:lang="lv">ar manifestāciju saistītais darbs</rdfs:label>
        <rdfs:label xml:lang="vi">có biểu thị tác phẩm có liên quan</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin ilgili eseri ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come opera di manifestazione correlata </rdfs:label>
        <rdfs:label xml:lang="no">har verk relatert til manifestasjon</rdfs:label>
        <rdfs:label xml:lang="da">har værk relateret til manifestation</rdfs:label>
        <rdfs:label xml:lang="en">has related work of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat mit Manifestation in Beziehung stehendes Werk</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gerelateerd werk van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastusega seotud teos</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaatioon liittyvä teos</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma kapcsolódó műve a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene obra relacionada de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a obra relacionada amb una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχετικό έργο (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">له عمل مرتبط بتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的关联作品</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimle ilişkili bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un&apos;opera associata a una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy műhöz, amelyet egy megjelenési formához társítanak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation teokseen, joka liittyy manifestaatioon.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với tác phẩm liên quan tới biểu thị đang được mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une œuvre qui est associée à une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una obra que s’associa amb una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una obra que está asociada a una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een werk dat geassocieerd is met een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et verk som forbindes med en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et værk, som er knyttet til en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a work that is associated with a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar darbu, kas saistīts ar manifestāciju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastusega seotud teosega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Werk, das mit einer Manifestation in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με ένα έργο που συνδέεται με μια περιγραφόμενη εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعمل مرتبط بتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现有关的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30266 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30266">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour expression en relation avec une manifestation</rdfs:label>
        <rdfs:label xml:lang="lv">ar manifestāciju saistītā izteiksme</rdfs:label>
        <rdfs:label xml:lang="vi">có biểu hiện có liên quan (biểu th)</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin ilgili anlatımı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come espressione di manifestazione correlata </rdfs:label>
        <rdfs:label xml:lang="da">har udtryk relateret til manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har uttrykk relatert til manifestasjon</rdfs:label>
        <rdfs:label xml:lang="en">has related expression of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat mit Manifestation in Beziehung stehende Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gerelateerde expressie van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastusega seotud väljendus</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaatioon liittyvä ekspressio</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma kapcsolódó kifejezési formája a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene expresión relacionada de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a expressió relacionada amb una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχετική έκφραση (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">له تعبيرة مرتبطة بتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的关联内容表达</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimle ilişkili bir anlatımla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un&apos;espressione associata a una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kifejezési formához, amelyet egy megjelenési formához társítanak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation ekspressioon, joka liittyy manifestaatioon.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với biểu hiện liên quan tới biểu thị đang được mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une expression qui est associée à une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una expressió que s’associa amb una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una expresión que está asociada a una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een expressie die geassocieerd is met een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et uttrykk som forbindes med en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til til et udtryk, som er knyttet til en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an expression that is associated with a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar izteiksmi, kas ir saistīta ar manifestāciju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastusega seotud väljendusega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Expression, die mit einer Manifestation in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με μια έκφραση που συνδέεται με μια περιγραφόμενη εκδήλωση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتعبيرة مرتبطة بتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与和一种载体表现有关的一种内容表达关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30275 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30275">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour particularités d’un code de région</rdfs:label>
        <rdfs:label xml:lang="fi">aluekoodin tarkemmat tiedot</rdfs:label>
        <rdfs:label xml:lang="tr">bölgesel kodlama ayrıntıları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có chi tiết của lập mã vùng</rdfs:label>
        <rdfs:label xml:lang="lv">detalizēti par reģionālo kodēšanu</rdfs:label>
        <rdfs:label xml:lang="it">ha come particolari relativi alla codifica regionale</rdfs:label>
        <rdfs:label xml:lang="da">har detaljer om regional kodning</rdfs:label>
        <rdfs:label xml:lang="no">har detaljer vedrørende regionkoder</rdfs:label>
        <rdfs:label xml:lang="en">has details of regional encoding</rdfs:label>
        <rdfs:label xml:lang="de">hat Details zum Regionalcode</rdfs:label>
        <rdfs:label xml:lang="nl">heeft details van regiocodering</rdfs:label>
        <rdfs:label xml:lang="hu">regionális kódolás részletei a következők:</rdfs:label>
        <rdfs:label xml:lang="et">regioonikoodi täpsustus</rdfs:label>
        <rdfs:label xml:lang="es">tiene detalles de codificación regional</rdfs:label>
        <rdfs:label xml:lang="ca">té com a particularitats de codificació regional</rdfs:label>
        <rdfs:label xml:lang="el">έχει λεπτομέρειες του κωδικού περιοχής</rdfs:label>
        <rdfs:label xml:lang="ar">له تفاصيل تكويد مناطق</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地区编码的细节</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir video diskin veya video oyunu taşıyıcısının kodlandığı dünyanın bir veya daha fazla bölgesi için bir atamanın ayrıntılarıyla ilişkilendirir ve oynatmanın, onu deşifre etmek için konfigüre edilmiş bir cihazla sınırlı olduğunu belirtir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione ai particolari relativi a una designazione per una o più regioni del mondo per le quali un supporto di video disco o videogioco è stato codificato e che indica che la lettura è limitata a un dispositivo configurato per la decodifica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy a világ egy vagy több régiójára vonatkozó jelölés részleteihez, amelyre egy videólemezt vagy egy videójáték-hordozót kódoltak, jelezve, hogy a visszajátszás az annak dekódolására konfigurált készülékre korlátozódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tarkempiin tietoihin määritteestä, jolla identifioidaan videolevyn tai videopelitallenteen käyttöalue ja estetään niiden käyttäminen toisella alueella myydyllä soittimella.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết biểu thị với chi tiết của định danh của một hoặc nhiều hơn vùng của thế giới mà vật mang tin đĩa video hoặc trò chơi video được lập mã, chỉ ra rằng phát lại bị cấm đối với thiết bị được cấu hình để giải mã nó.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec des particularités d’une désignation d’une ou plusieurs régions du monde pour laquelle un vidéodisque ou un support matériel de jeu vidéo a été encodé, qui indique que sa lecture est limitée à un appareil configuré pour le décoder.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb les particularitats d’una designació d’una o més regions del món per a la qual s’ha codificat un suport físic de videodisc o videojoc, indicant que la reproducció és restringida a un dispositiu configurat per descodificar-lo.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con detalles de una designación para una o más regiones del mundo para las cuales se ha codificado un soporte de videodisco o videojuego, indicando que la reproducción está restringida a un dispositivo configurado para decodificarlo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan details van een aanduiding van één of meer regio&apos;s van de wereld waarvoor een videodisk of computerspeldrager gecodeerd is, om aan te geven dat het afspelen beperkt is tot een apparaat dat deze kan decoderen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til detaljer vedrørende en betegnelse for én eller flere geografiske regioner som en videoplate eller videospillbærer er kodet for, og som angir at avspilling er begrenset til enheter som er konfigurert for å dekode plater eller bærere med denne kodingen.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til detaljer om en betegnelse for en eller flere regioner i verden, som en videodisk eller spillekonsol er kodet til, hvormed afspilning er forbeholdt en enhed, som er konfigureret til at afkode regionskoden.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to details of a designation for one or more regions of the world for which a videodisc or video game carrier has been encoded, indicating that playback is restricted to a device configured to decode it.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar sīkāku informāciju par viena vai vairāku pasaules reģionu apzīmējumiem, kuriem ir paredzēts kodētais videodiska vai videospēļu nesējs, norādot, ka atskaņošana ir ierobežota un ierakstam nepieciešama atkodēšana.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse täpsemate andmetega tähistuse kohta, mis märgib üht või mitut maailma regiooni, mille jaoks videoplaat või videomängu kandja on kodeeritud, nii et taasesitus on võimalik ainult selle dekodeerimiseks sobiva seadmega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu Details einer Bezeichnung, die die Region(en) der Welt angibt, für die eine Videodisk oder ein Videospiel-Datenträger kodiert ist, und der verhindert, dass die Disk von einem Wiedergabegerät, das in einer anderen Region verkauft wurde, abgespielt werden kann.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει μια εκδήλωση με τις λεπτομέρειες ενός προσδιορισμού για μία ή περισσότερες περιοχές του κόσμου για τις οποίες ένας φορέας αποθήκευσης βιντεοδίσκου ή βίντεο-παιχνιδιού έχει κωδικοποιηθεί, δηλώνοντας ότι η αναπαραγωγή περιορίζεται σε μια συσκευή διαμορφωμένη για την αποκωδικοποίησή της.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وتفاصيل تسمية لمنطقة أو أكثر من العالم التي بناء عليها تم تكويد حامل قرص الفيديو أو ألعاب الفيديو لتحديد أن التشغيل مقيد بجهاز معد لفك الكود.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与视盘或视频游戏载体被编码后表示对设置解码回放的设备限制的世界上一个或多个地区的标识的细节关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30276 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30276">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour point d’accès d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim için erişim noktası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come punto d&apos;accesso per la manifestazione</rdfs:label>
        <rdfs:label xml:lang="da">har søgeindgang for manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har søkeinngang for manifestasjon</rdfs:label>
        <rdfs:label xml:lang="en">has access point for manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Sucheinstieg für eine Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ingang voor manifestatie</rdfs:label>
        <rdfs:label xml:lang="hu">hozzáférési pontja megjelenési formához a következő:</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse otsielement</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation hakutieto</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas pamatforma</rdfs:label>
        <rdfs:label xml:lang="es">tiene punto de acceso para manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a punt d’accés de manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له نقطة إتاحة لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的检索点</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir kelime kodlama şemasından alınan veya bir dizi kodlama şeması kullanılarak oluşturulan doğal dilde gösterimin bir unvanı olan bir isim ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una denominazione espressa in linguaggio naturale derivata da uno schema di codifica di vocabolario o costruita usando uno schema di codifica della stringa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy nomenhez, amely egy szótárkódolási sémából származik, vagy egy karakterlánc-kódolási séma használatával szerkesztett.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on luonnollisen kielen mukainen manifestaation nimitys, joka on otettu sanaston merkintäjärjestelmästä tai joka on muodostettu merkkijonon merkintäjärjestelmää käyttäen.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est une appellation de manifestation en langage naturel provenant d’un schéma d’encodage de vocabulaire ou construite à l’aide d’un schéma d’encodage de chaînes.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és una apel·lació de manifestació en llenguatge natural que s’obté d’un esquema de codificació de vocabulari o s’elabora usant un esquema de codificació de cadenes.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es una denominación de manifestación en lenguaje natural que se toma de un esquema de codificación de vocabulario o se construye utilizando un esquema de codificación de cadenas.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een benaming van manifestatie in natuurlijke taal die ontleend is aan een vocabulair coderingsschema of gevormd is volgens een string coderingsschema.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en betegnelse på manifestasjon på et naturlig språk som er hentet fra et kodeskjema for vokabular eller er laget ved bruk av et kodeskjema for syntaks.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en benævnelse på manifestation på normalsprog, som er taget fra et vokabularkodningsskema eller er konstrueret ved hjælp af et strengkodningsskema.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is an appellation of manifestation in natural language that is taken from a vocabulary encoding scheme or is constructed using a string encoding scheme.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir manifestācijas, vārds/nosaukums dabiskā valodā, kas ņemts no shēmas kontrolētu vārdnīcu kodēšanai vai tiek konstruēts, izmantojot virknes kodēšanas shēmu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse nimetusega loomulikus keeles, mis on võetud leksikaalsest märkimissüsteemist või moodustatud stringilise märkimissüsteemi alusel.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Bezeichnung für eine Manifestation in natürlicher Sprache, die einem Vocabulary Encoding Scheme entnommen oder mit einem String Encoding Scheme konstruiert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة واسم تجسيدة في اللغة الطبيعية والمأخوذ من خطة ترميز مفردات، أو انشئت باستخدام خطة ترميز سلسلة تمثيلات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为一种载体表现的称谓、取自一个词表编码体系或者用一个串编码体系构建、用自然语言的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30278 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30278">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour date d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim tarihi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come data di manifestazione</rdfs:label>
        <rdfs:label xml:lang="da">har dato for manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har tidspunkt for manifestasjon</rdfs:label>
        <rdfs:label xml:lang="en">has date of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Datum einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft datum van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse daatum</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation ajankohta</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas datējums</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma dátuma a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene fecha de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a data de manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له تاريخ لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的日期</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanan bir gösterimin yayınlandığı, piyasaya sürüldüğü, ihraç edildiği, basıldığı, çoğaltıldığı, dağıtıldığı veya yayınlanmamış bir gösterimin yazıldığı, üretildiği, inşa edildiği veya başka bir şekilde üretildiği bir zaman aralığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un arco di tempo durante il quale una manifestazione pubblicata è pubblicata, diffusa, emessa, stampata, duplicata, fusa, distribuita, etc., o una manifestazione non pubblicata è iscritta, fabbricata, costruita, etc.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy időtartamhoz, amely alatt egy közzétett megjelenési formát közzétesznek, kiadnak, kibocsátanak, kinyomtatnak, sokszorosítanak, öntenek, terjesztenek stb., vagy egy kiadatlan megjelenési formába bejegyzést tesznek, gyártanak,megépítenek stb.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation ajanjaksoon, jolloin julkaistu manifestaatio on kustannettu, julkaistu, ilmestynyt, painettu, monistettu, valattu kirjasintin osalta tai jaettu. Liittää manifestaation ajanjaksoon, jolloin julkaisematon manifestaatio on kaiverrettu, valmistettu, koottu tai muuten tuotettu.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un laps de temps pendant lequel une manifestation publiée est publiée, mise à disposition, éditée, imprimée, reproduite, moulée ou diffusée ou distribuée, ou une manifestation non publiée est écrite à la main, fabriquée, construite ou produite d’une autre manière.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un interval de temps durant el qual una manifestació publicada es publica, es posa en circulació, s’emet, s’imprimeix, es reprodueix, es modela o es distribueix o una manifestació no publicada s’inscriu, es fabrica, es construeix o es produeix d’una altra manera.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un período de tiempo durante el cual una manifestación publicada se publica, libera, emite, imprime, duplica, emite o distribuye, o una manifestación no publicada se inscribe, fabrica, construye o de otra manera produce.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een tijdspanne gedurende welke een gepubliceerde manifestatie is uitgegeven, uitgebracht, uitgevaardigd, gedrukt, gedupliceerd, gegoten of gedistribueerd, of een ongepubliceerde manifestatie is afgeschreven, gefabriceerd, geconstrueerd of anderszins geproduceerd.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til et tidsrom hvor en publisert manifestasjon er utgitt, tilgjengeliggjort, utstedt, trykt, mangfoldiggjort, tildelt roller, distribuert etc., eller en upublisert manifestasjon er inskribert, fabrikkert, konstruert etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en tidsperiode, hvorunder en publiceret manifestation er publiceret, frigivet, udgivet, trykt, duplikeret, støbt, distribueret ect., eller hvorunder en upubliceret manifestation er indskrevet, fremstillet, konstrueret ect.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a timespan during which a published manifestation is published, released, issued, printed, duplicated, cast, or distributed, or an unpublished manifestation is inscribed, fabricated, constructed, or otherwise produced.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar laikposmu, kurā publicētā manifestācija publicēta, izdota, izdrukāta, dublēta, tiražēta, izplatīta u.tml., vai nepublicētā manifestācija tiek ierakstīta, izgatavota, radīta u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse ajavahemikuga, mille jooksul avaldatud kehastus on avaldatud, välja lastud, välja antud, trükitud, paljundatud, valatud, levitatud vms, või avaldamata kehastus on inskribeeritud, toodetud, ehitatud vms.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Zeitraum, in dem eine veröffentlichte Manifestation veröffentlicht, freigegeben, herausgegeben, gedruckt, vervielfältigt, gegossen oder vertrieben wird oder in dem eine unveröffentlichte Manifestation beschriftet, hergestellt, konstruiert wird oder anderweitig entsteht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وفترة زمنية تم خلالها نشر، أو إصدار، أو طباعة، أو إعادة طباعة، أو توزيع، إلخ. تجسيدة منشورة، أو تجسيدة غير منشورة تم تدوينها، أو تصنيعها، أو إنشائها، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种出版载体表现被出版、发布、发行、印刷、复制、铸造或经销的时间段、或者一种非出版载体表现被镌刻、制造、构造或其他方式制作的时间段关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30280 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30280">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur le copyright</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin telif hakkı bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione del copyright </rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om copyright</rdfs:label>
        <rdfs:label xml:lang="da">har manifestations copyrightoplysning</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation copyright statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Copyright-Angabe einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-copyrightvermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse copyright&apos;i andmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation copyright-merkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas autortiesību ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">szerzői jogra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de derechos de autor de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de copyright</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان حقوق نشر لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现版权说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, telif hakkı veya benzeri bir beyan kapsamında koruma talebiyle ilişkili bir tarih hakkındaki bir gösterim beyanıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione su una data associata a una dichiarazione di protezione sotto copyright o un regime simile.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy időpontot jelölő megjelenésiforma-közléshez, amely a szerzői jog vagy egy hasonló szabályrendszer alapján támasztott védettségi követeléshez kapcsolódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön, joka kertoo copyright-säädöksen tai vastaavien säädösten alaiseen copyright-suojaukseen liittyvän ajankohdan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à une date qui est associée à une revendication de protection en vertu du copyright ou d’un régime similaire.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre una data que s’associa amb una declaració de protecció en virtut del copyright o d’un règim similar.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre una fecha que está asociada con un reclamo de protección bajo derechos de autor o un régimen similar.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over een datum die geassocieerd is met een claim van bescherming onder copyright of soortgelijk beleid.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om en dato som knyttes til et krav om beskyttelse under copyright eller et lignende regime.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om en dato, som er knyttet til et beskyttelseskrav under copyright eller et lignende system.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about a date that is associated with a claim of protection under copyright or a similar regime.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par datējumu, kas saistīts ar prasību par autortiesību aizsardzību vai līdzīgiem nosacījumiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega ajavahemiku kohta, mis on seotud autoriõiguse vms õigusrežiimi kaitsega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe zu einem Datum, das mit einem Schutzanspruch nach dem Urheberrecht oder einem ähnlichen Regelwerk in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بتاريخ مرتبط بالحماية تحت حقوق النشر أو أي نظام مشابه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于版权或其他类似管理体系下和保护声明有关的一个日期的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A copyright date includes a phonogram date that is associated with a claim of protection for an audio recording.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Autortiesību datējumi ietver fonogrammu datējumus, kas saistīti ar audioierakstu aizsardzības prasībām.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir telif hakkı tarihi, bir ses kaydı için koruma talebiyle ilişkili bir fonogram tarihini içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Copyright&apos;i aastad hõlmavad ka fonogrammi aastaid, mis on seotud helisalvestise õiguskaitsega.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Copyright-vuodet käsittävät phonogram-vuodet, jotka liittyvät äänitallenteiden copyright-suojaukseen.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Copyrightdatoer omfatter fonogramdatoer, som er knyttet til beskyttelseskrav for lydoptagelser.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Phonogramm-Daten, das heißt Datumsangaben, die mit einem Schutzanspruch für Audioaufnahmen in Verbindung stehen.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Dato for copyright inkluderer dato for fonogram som krever beskyttelse for lydopptak.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een copyrightdatum omvat een phonogramdatum, die geassocieerd is met een claim van bescherming voor een geluidsopname.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Le date di copyright comprendono le date di phonogram associate a dichiarazioni di protezione per registrazioni audio.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una data de copyright inclou una data de fonograma que s’associa amb una declaració de protecció per a un enregistrament àudio.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una fecha de derecho de autor incluye una fecha de fonograma asociada con un reclamo de protección para una grabación de audio.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une date de copyright comprend une date de phonogramme qui est associée à une revendication de protection pour un enregistrement audio.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">szerzői jogra vonatkozó megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل تاريخ حقوق النشر تواريخ التسجيل الصوتي المرتبطة بإعلان حماية التسجيلات الصوتية</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">版权日期包括与录音保护声明有关的录音版权日期</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30281 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30281">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur la désignation d’une séquence</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin sıralandırma bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione di designazione di una sequenza</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om betegnelse for sekvens</rdfs:label>
        <rdfs:label xml:lang="da">har manifestationsoplysning for rækkefølgebetegnelse</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation designation of sequence statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Manifestationsangabe zur Bezeichnung einer fortlaufenden Ressource</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-aanduiding van volgorde-vermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse andmed nummerduse tähistuse kohta</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation merkintö numerointijakson määritteestä</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas secības apzīmējuma ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">sorrendiséget jelölő megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene designación de manifestación de declaración de secuencia</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de designació d’una seqüència</rdfs:label>
        <rdfs:label xml:lang="ar">له تسمية تجسيدة لبيان تسلسل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有序列说明的载体表现标识</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bireysel parçaların bir gösterim dizisinin numaralandırılması veya bir gösterimin veya bir eserin bölümlerinin veya gösterimin yinelenmesiyle ilgili bir gösterim ifadesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione relativa alla designazione di una sequenza di una manifestazione di una parte, fascicolo o iterazione di un&apos;opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy sorrendiséget jelölő megjelenésiforma-közléshez, amely egy megjelenési forma részének, számának vagy egy diakronikus mű iterációjának sorrendiségét jelöli.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön manifestaation yksittäisten osien tai iteraatioiden tai teoksen yksittäisten osien tai numeroiden manifestaatioiden numerointijaksosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à la numérotation d’une séquence de manifestations des parties ou itérations individuelles d’une manifestation ou des parties ou livraisons d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre la numeració d’una seqüència de manifestacions de les parts individuals o iteracions d’una manifestació o les parts o números d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre la numeración de una secuencia de manifestaciones de las partes individuales o iteraciones de una manifestación o partes o emisiones de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over de nummering van een volgorde van manifestaties van de individuele delen of iteraties van een manifestatie of delen of afleveringen van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om betegnelse for en sekvens av en manifestasjon av en del, et hefte eller en versjon av et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om betegnelsen af en rækkefølge for en manifestation af en del, nummer eller iteration af et diakronisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about the numbering of a sequence of manifestations of the individual parts or iterations of a manifestation or parts or issues of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par diahroniska darba daļu, laidienu vai iterāciju secību.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega diakroonilise teose osa, numbri või seisu kehastuse nummerduse tähistuse kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die die Zählung einzelner Ausgaben einer fortlaufenden Ressource oder einzelner Teile oder Ausgaben eines Werks enthält.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بتسمية تسلسل تجسيدة لجزء أو عدد أو لعمل ممتد زمنيا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于一种载体表现个别部分或更新后整体或者一种作品的部分或期的载体表现的序列之编号的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes an alphanumeric or chronological designation.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed sisaldavad tähtnumbrilist või kronoloogilist tähistust.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim, alfasayısal veya kronolojik bir belirteç içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen alphanumerische oder chronologische Bezeichnungen.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een alfanumerieke of chronologische aanduiding.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione comprende una designazione alfanumerica o cronologica.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää aakkosnumeerisen määritteen tai aikamääritteen.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter en alfanummerisk eller kronologisk betegnelse</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningen inkluderer en alfanumerisk eller kronologisk betegnelse.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye una designación alfanumérica o cronológica.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou una designació alfanumèrica o cronològica.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une désignation alphanumérique ou chronologique.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver burtciparu vai hronoloģisku apzīmējumu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">sorrendiség-jelölő megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل البيان على تسميات هجائية رقمية أو زمنية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括字母数字或年代标识</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30282 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30282">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur une thèse ou un mémoire</rdfs:label>
        <rdfs:label xml:lang="lv">disertācijas manifestācijas ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">disszertációra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin tez bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione su una dissertazione</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om doktoravhandling</rdfs:label>
        <rdfs:label xml:lang="da">har manifestations afhandlingsoplysning</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation dissertation statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Hochschulschriftenvermerk einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-proefschriftvermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse andmed väitekirja kohta</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation väitöskirjamerkintö</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de disertación de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de dissertació</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان تجسيدة أطروحة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现学位论文说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, tez veya diğer tez bilgileriyle ilgili bir gösterim beyanıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione sui dati relativi a una tesi e altre informazioni su una dissertazione. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy szakdolgozatról vagy disszertációról szóló információ megjelenésiforma-közléséhez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön opinnäytteen tai väitöskirjan tiedoista.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à de l’information sur une thèse ou un mémoire.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre la tesi o altra informació de la dissertació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre tesis u otra información de disertación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over proefschrift of andere dissertatie informatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om data knyttet til tesen og annen informasjon om avhandlingen.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om data, som relaterer til speciale og anden information fra afhandlinger.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about thesis or other dissertation information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par datiem, kas saistīti ar tēžu un citu disertācijas informāciju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega, mis puudutavad kraaditööd või dissertatsiooni.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die Angaben zum Hochschulschriftenvermerk enthält.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص ببيانات مرتبطة بأطروحة والمعلومات الأخرى عن الرسائل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于毕业论文或其他学位论文信息的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes any or all of a degree title, year of award, or granting institution.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed sisaldavad kraadi nimetust, selle andmise aastat ja kraadi andnud asutuse nime, või vähemalt ühte neist.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim, bir derece unvanının, ödül yılının veya veren kurumun herhangi birini veya tamamını içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: akademischer Titel, Jahr der Vergabe oder verleihende Institution.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een of alle van een graad. jaar van toekenning, en toekennende instelling</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione comprende, del tutto o in parte, il titolo accademico, l&apos;anno in cui il titolo è stato conferito e l&apos;istituzione o facoltà conferente. </skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää jonkin tai kaikki seuraavista: akateeminen oppiarvo, oppiarvon myöntämisvuosi ja oppiarvon myöntävä laitos.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter hvilken som helst eller alle af: gradsbetegnelse, tildelingsårstal og tildelende organisation.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningen inkluderer gradstittel eller gradstitlene, år for tildeling og tildelende institusjon.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye parte o la totalidad de un título de grado, año del premio o institución otorgante.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou, en tot o en part, un títol acadèmic, un any d’obtenció o una institució que concedeix títols acadèmics.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une partie ou la totalité des informations suivantes : nom de grade, année d’obtention ou institution conférant le grade.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver daļēju vai pilnu informāciju par grāda nosaukumu, piešķiršanas gadu vai piešķīrējiestādi.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">disszertációs megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل البيان على أي أو كل من الدرجة العلمية، وسنة الحصول، والجامعة المانحة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括学位名称、授予年或授予机构这些中的任何一个或者全部。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30283 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30283">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur la diffusion ou la distribution</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin dağıtım bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione di distribuzione</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om distribusjon</rdfs:label>
        <rdfs:label xml:lang="da">har manifestations distributionsoplysning</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation distribution statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Vertriebsangabe einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-distributievermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse levitamisandmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation jakelumerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas izplatīšanas ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">terjesztésre vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de distribución de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de distribució</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان توزيع تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现发行说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimin, yayınlanan bir gösterimin dağıtımıyla ilgili verilerle ilgili bir gösterim beyanıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione sui dati relativi alla distribuzione di una manifestazione pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kiadott megjelenési forma terjesztésével kapcsolatos adatokról szóló megjelenésiforma-közléshez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön julkaistun manifestaation jakeluun liittyvistä tiedoista.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à des données sur la diffusion ou la distribution d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre la distribució d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre datos relacionados con la distribución de una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over gegevens gerelateerd aam de verspreiding van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om data knyttet til distribusjonen av en publisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om data, som relaterer til distributionen af en publiceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about data relating to the distribution of a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par datiem, kas saistīti ar publicētās manifestācijas izplatīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega, mis puudutavad avaldatud kehastuse levitamist.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die Daten zum Vertrieb einer veröffentlichten Manifestation enthält.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص ببيانات التوزيع لتجسيدة منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于和一种出版载体表现的发行有关的数据的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes any or all of place or date of distribution or name of distributor.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed sisaldavad levitamise kohta, daatumit ja levitaja nime, või vähemalt ühte neist.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim, dağıtım yerinin veya tarihinin veya distribütörün adının herhangi birini veya tamamını içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: Vertriebsort, Vertriebsdatum oder Vertriebsname.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een of alle van plaats of datum van distributie of naam van distributeur</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulaziome comprende, del tutto o in parte, il luogo e la data di distribuzione, e il nome del distributore.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää jonkin tai kaikki seuraavista: jakelupaikka, jakeluaika ja jakelijan nimi.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter hvilken som helst eller alle af: sted, dato for distribution og navn på distributør.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningen inkluderer alle steder og datoer for distribusjon og navn på distributør.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye parte o la totalidad del lugar o fecha de distribución o el nombre del distribuidor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou, en tot o en part, el lloc o la data de distribució o el nom de distribuïdor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une partie ou la totalité des informations suivantes : lieu et date de diffusion ou de distribution ou nom de diffuseur ou de distributeur.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver daļēju vai pilnu informāciju par izplatīšanas vietu un datējumu, un par izplatītāju.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">terjesztési megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل البيان على أي أو كل من مكان وتاريخ التوزيع والموزع.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括发行地或发行日期或发行者名称这些中的任何一个或者全部</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30284 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30284">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur l’édition</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin basım bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione dell&apos;edizione</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om utgave</rdfs:label>
        <rdfs:label xml:lang="da">har manifestations udgaveoplysning</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation edition statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Ausgabevermerk einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-editievermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse editsiooniandmed</rdfs:label>
        <rdfs:label xml:lang="hu">kiadásra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation painosmerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas izdevuma ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de edición de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació d’edició</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان طبعة تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现版本说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin ait olduğu bir baskı hakkındaki bir gösterim ifadesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione relativa a un&apos;edizione a cui appartiene una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát a megjelenési forma kiadásáról szóló megjelenésiforma-közléshez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön painoksesta, johon manifestaatio kuuluu.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à une édition à laquelle appartient une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre una edició a la qual pertany una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre una edición a la que pertenece una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over een editie waartoe een manifestatie behoort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om en utgave som en manifestasjon tilhører.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om en udgave, hvortil en manifestation tilhører.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about an edition to which a manifestation belongs.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par izdevumu, kuram manifestācija ir piederīga.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega editsiooni kohta, millesse kehastus kuulub.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die eine Ausgabe bezeichnet, zu der eine Manifestation gehört.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص عن طبعة التي تنتمي إليها تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于一种载体表现所属于的一个版本的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes any or all of designation of edition or named revision of edition, or a statement of responsibility relating to an edition or revision.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed sisaldavad editsiooni või editsiooni nimelise uusversiooni tähistust ja editsiooniga või uusversiooniga seotud vastutusandmeid, või vähemalt ühte neist.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim, baskının herhangi bir veya tüm belirtecini veya baskının adlandırılmış revizyonunu veya bir baskı veya revizyonla ilgili bir sorumluluk bildirimini içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: Ausgabebezeichnung oder Ausgabezeichnung einer näher erläuterten Überarbeitung oder eine Verantwortlichkeitsangabe, die sich auf eine Ausgabe oder eine näher erläuterte Überarbeitung bezieht.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een of alle van aanduiding van editie of benoemde herziening van editie, of een vermelding van verantwoordelijkheid met betrekking tot een editie of herziening.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione comprende, del tutto o in parte, la designazione di edizione o revisione identificata di edizione, e una formulazione di responsabilità relativa a un&apos;edizione o revisione di un&apos;edizione.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää jonkin tai kaikki seuraavista: painoksen tai nimetyn uudistetun painoksen määrite sekä painokseen tai uudistettuun painokseen liittyvä vastuullisuusmerkintö.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter hvilken som helst eller alle af: udgavebetegnelse, udgaverevision og en ophavsangivelse, som relaterer til en udgave eller revision.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningene inkluderer alle betegnelsene for utgave eller bestemt revisjon av utgave og en ansvarsangivelse som er knyttet til en utgave eller revisjon.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye parte o toda la designación de edición o revisión nombrada de edición, o una declaración de responsabilidad relacionada con una edición o revisión.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou, en tot o en part, la designació d’edició o una revisió explícita d’edició o una menció de responsabilitat relativa a una edició o una revisió.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une partie ou la totalité des informations suivantes : désignation d’édition ou d’une révision nommée d’une édition ou mention de responsabilité relative à une édition ou à une révision.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver daļēju vai pilnu informāciju par izdevumu vai izdevuma pārskatīšanu, un ziņas par atbildību saistībā ar izdevumu vai tā pārskatīšanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">kiadási megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">البيان يشتمل على أي أو كل من تسميات الطبعة أو المراجعة المسماة لطبعة، و بيان المسئولية المرتبط بطبعة أو مراجعة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括版本或版本的命名修订的标识或者和版本或修订有关的责任说明这些中的任何一个或者全部。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30285 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30285">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur la périodicité</rdfs:label>
        <rdfs:label xml:lang="hu">gyakoriságra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yayın sıklığının bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione della periodicità</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om frekvens</rdfs:label>
        <rdfs:label xml:lang="da">har oplysning om manifestations hyppighed</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation frequency statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Angabe zur Erscheinungsfrequenz einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-frequentievermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse ilmumissageduse andmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation ilmestymistiheysmerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas periodiskuma ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de frecuencia de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de periodicitat</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان تتابع تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现频率说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, artzamanlı bir çalışmanın parçalarının, sorunlarının veya yinelemelerinin ortaya çıkışlarının yayınlandığı bir aralık hakkında bir gösterim ifadesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione relativa alla cadenza con cui sono pubblicate le manifestazioni di parti, fascicoli, o iterazioni di un&apos;opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy időközről szóló megjelenésiforma-közléshez, amely alatt egy diakronikus mű részeit, számait, iterációit kiadják.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön tiheydestä, jolla diakronisen teoksen osien, numeroiden tai iteraatioiden manifestaatiot ilmestyvät.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à l’intervalle de temps suivant lequel les manifestations de parties, livraisons ou itérations d’une œuvre diachronique sont publiées.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre un interval en el qual es publiquen les manifestacions de les parts, els números o les iteracions d’una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un enunciado de manifestación sobre un intervalo en el que se emiten las manifestaciones de partes, temas o iteraciones de una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over een interval waarmee de manifestatie van delen, afleveringen of iteraties van een diachronisch werk zijn uitgevaardigd.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om et intervall som manifestasjoner av deler, hefter eller versjoner av et diakronisk verk utgis i.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om et interval, hvor manifestationerne af dele, numre eller iterationer af et diakronisk værk er udgivet.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about an interval at which the manifestations of parts, issues, or iterations of a diachronic work are issued.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par intervālu/periodiskumu, kurā izdod diahroniskā darba daļas, laidienus vai iterācijas..</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega intervalli kohta, millega diakroonilise teose osade, numbrite või seisude kehastused avaldatakse.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe die angibt, in welchem Intervall die Manifestationen von Teilen, Ausgaben oder Iterationen eines diachronen Werks erscheinen.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بمدة تصدر وفقًا لها التجسيدة الخاصة بجزء، أو عدد، أو لعمل ممتد زمنيًاً.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于一种历时作品的部分、期或更新后的整体的载体表现发行的时间间隔的载体表现说明关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30286 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30286">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur un identifiant</rdfs:label>
        <rdfs:label xml:lang="hu">azonosítóra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin tanımlayıcısının bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione di identificatore</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om identifikator</rdfs:label>
        <rdfs:label xml:lang="da">har manifestationsoplysning om identifikator</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation identifier statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Angaben zum Identifikator einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-identificatievermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse identifikaatori andmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation tunnistemerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas identifikatora ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de identificador de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació d’identificador</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان معرف تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现标识符说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir eseri, ifadeyi veya gösterimi tanımlamak için kullanılan, genellikle doğal dilden ve sosyal adlandırma geleneklerinden bağımsız olarak, bir kod, sayı veya başka bir dizi hakkında bir gösterim ifadesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione relativa a un codice, numero, o altra stringa, solitamente indipendente dal linguaggio naturale e dalle convenzioni sociali di denominazione, usata per identificare un&apos;opera, espressione, o manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kód-, szám-, vagy más típusú karakterláncból álló megjelenésiforma-közléshez, amely általában független a természetes nyelvektől és társadalmi névkonvencióktól, és egy mű, kifejezési forma, vagy megjelenési forma azonosítására használják.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön koodista, numerosta tai muusta merkkijonosta, joka on luonnollisesta kielestä ja kielen sosiaalisista konventioista riippumaton teoksen, ekspression tai manifestaation tunnistamiskeino.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à un code, à un nombre ou à une autre chaîne, généralement indépendante du langage naturel et des conventions sociales de dénomination, utilisée pour identifier une œuvre, une expression ou une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre un codi, un número o qualsevol altra cadena, normalment independent del llenguatge natural i de les convencions lingüístiques socials, usada per identificar una obra, una expressió o una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre un código, número u otra cadena, generalmente independiente del lenguaje natural y las convenciones de nomenclatura social, utilizada para identificar una obra, expresión o manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over een code, nummer of andere string, meestal onafhankelijk van natuurlijke taal en sociale naamgevingsconventies, gebruikt om een werk, expressie of manifestatie te identificeren.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om en kode, et nummer eller annen streng som, oftest uavhengig av naturlig språk og sosiale navnekonvensjoner, brukes for å identifisere et verk, uttrykk eller en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om en kode, nummer eller anden streng, sædvanligvis upåvirket af normalsprog og navngivningskonventioner brugt til at identificere et værk, udtryk eller manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about a code, number, or other string, usually independent of natural language and social naming conventions, used to identify a work, expression, or manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par kodu, numuru vai citu virkni, kas parasti ir neatkarīga no dabiskās valodas un sabiedrībā lietotā nosaukuma, ko izmanto, lai identificētu darbu, izteiksmi vai manifestāciju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega teost, väljendust või kehastust identifitseeriva koodi, numbri või muu loomulikust keelest ja üldtuntud nimetamistavadest sõltumatu stringi kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die aus einem Code, einer Nummer oder einer anderen Zeichenkette besteht, der/die normalerweise nicht in natürlicher Sprache und unabhängig von den sozialen Benennungskonventionen ist und zur Identifizierung eines Werks, einer Expression oder einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص برمز أو رقم أو أي رمز يستخدم عادة مختلف عن اللغة الطبيعية والمعنى الاجتماعي الدارج، ويستخدم عادة لتحديد عمل، أو تعبيرة، أو تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于通常独立于自然语言和社会命名惯例、用以标识一种作品、内容表达或载体表现的代码、数字或其他串的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes any or all of fingerprint, plate and publisher number for notated music, ISSN of series or subseries, or other identifier for manifestation.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed hõlmavad fingerprint-identifikaatorit, noodi trükiplaadi või kirjastajanumbrit, seeria või allseeria ISSNi ja muud kehastuse identifikaatorit, või vähemalt ühte neist. </skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim, parmak izinin herhangi birini veya tamamını, notalı müzik için plaka ve yayıncı numarasını, seri veya alt serilerin ISSN&apos;sini veya gösterim için diğer tanımlayıcıları içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: Fingerprint, Druckplattennummer für Noten und Noten-Bestellnummern, ISSN für eine Reihe oder Unterreihe oder andere Identifikatoren einer Manifestation.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een of alle van vingerafdruk, plaat- en uitgeversnummer voor bladmuziek, ISSN van reeks of onderreeks, of andere identificatie voor manifestatie.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione comprende, del tutto o in parte, l&apos;impronta, il numero dell&apos;editore e di lastra per la musica notata, l&apos;ISSN delle serie e sottoserie, e altri identificatori per la manifestazione.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää jonkin tai kaikki seuraavista: sormenjälkitunniste, nuottiaineiston laatan ja kustantajan numero, sarjan tai alasarjan ISSN sekä muut manifestaation tunnisteet.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter hvilken som helst eller alle af: fingeraftryk, plade- og editionsnummer for noteret musik, ISSN for serie eller underserie og anden identifikator for manifestation.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningene inkluderer alle fingeravtrykk, plate og utgivernummer for nedskrevet musikk, ISSN for serie og underserie og andre identifikatorer for manifestasjon.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye parte o la totalidad de las huellas dactilares, la placa y el número de editor de la música anotada, el ISSN de la serie o subserie u otro identificador de manifestación.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou, en tot o en part, l’empremta, el número de planxa i el número d’editor de música notada, l’ISSN de col·lecció o subcol·lecció o qualsevol altre identificador de manifestació.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une partie ou la totalité des informations suivantes : empreinte, cotage et numéro d’éditeur pour la musique notée, ISSN de collection ou de sous-collection ou tout autre identifiant de manifestation.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver daļēju vai pilnu informāciju par identificējošo zīmju virkni, plātnes (nošu) un izdevēja numuru, ISSN numuru sērijām vai apakšsērijām vai citu manifestācijas identifikatoru.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">azonosító megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل البيان على أي أو كل من البصمة واللوحة ورقم الناشر لنوتة موسيقية، الترقيم الدولي الموحد للدوريات، أو السلاسل الفرعية، وأي معرف آخر للتجسيدة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括指纹、乐谱的版号和出版者编号、丛编或分丛编的ISSN、或载体表现的其他标识符这些中的任何一个或者全部</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30287 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30287">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur la fabrication</rdfs:label>
        <rdfs:label xml:lang="hu">gyártásra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin üretim bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione di manifattura</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning for framstilling</rdfs:label>
        <rdfs:label xml:lang="da">har manifestationsoplysning om producent</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation manufacture statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Herstellungsangabe einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-vervaardigersvermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse valmistamisandmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation valmistusmerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas ražošanas ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de fabricación de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de fabricació</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان تصنيع لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现生产说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanan bir gösterimin basılması, çoğaltılması, dökümü veya başka bir üretim yöntemiyle ilgili veriler hakkında bir gösterim bildirimiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione sui dati relativi alla stampa. duplicazione, fusione, etc. di una manifestazione pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy olyan megjelenésiforma-közléshez, amely egy közzétett megjelenési forma nyomtatásával, sokszorosításával, öntésével stb. kapcsolatos adatokat tartalmaz</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön julkaistun manifestaation painamiseen, monistamiseen, kirjasinten valamiseen tai muuhun valmistustapaan liittyvistä tiedoista.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à des données sur l’impression, la reproduction, le moulage ou toute autre méthode de fabrication d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre la impressió, la reproducció, el modelat o un altre mètode de fabricació d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre datos relacionados con la impresión, duplicación, fundición u otro método de fabricación de una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over gegevens gerelateerd aan het drukken, vermenigvuldigen, gieten of andere methode van het vervaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om data knyttet til trykking, mangfoldiggjøring, rollebesettelse etc. av en publisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om data vedrørende trykning, kopiering, støbning, eller anden fremstillingsmetode for en publiceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about data relating to the printing, duplicating, casting, or other method of manufacturing of a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par datiem, kas saistīti ar publicētas manifestācijas drukāšanu, pavairošanu, salikšanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega avaldatud kehastuse trükkimise, paljundamise, valamise vms kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die Daten zum Druck, zur Vervielfältigung, zum Guss oder zu einer anderen Herstellungsmethode einer veröffentlichten Manifestation enthält.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بطباعة، أو نسخ، أو صب، إلخ. لتجسيدة منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于和一种出版载体表现的印刷、复制、铸造或其他生产方法有关的数据的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes any or all of place or date of manufacture or name of manufacturer.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed sisaldavad valmistamise kohta, daatumit ja valmistaja nime, või vähemalt ühte neist.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim, üretim yeri veya tarihinin veya üreticinin adının herhangi birini veya tamamını içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: Herstellungsort, Herstellungsdatum oder Herstellername.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een of alle van plaats en datum van vervaardiging en naam van vervaardiger.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione comprende, del tutto o in parte, il luogo e la data della manifattura, e nome della manifattura.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää jonkin tai kaikki seuraavista: valmistuspaikka, valmistusaika ja valmistajan nimi.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter et eller alle sted for produktion eller navne på producent.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningene inkluderer alle steder og datoer for framstilling og navn på tilvirker.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye parte o la totalidad del lugar o fecha de fabricación o el nombre del fabricante.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou, en tot o en part, el lloc o la data de fabricació o el nom de fabricant.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une partie ou la totalité des informations suivantes : lieu ou date de fabrication ou nom de fabricant.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver daļēju vai pilnu informāciju par izgatavošanas vietu un datējumu un izgatavotāja nosaukumu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">gyártási megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل البيان على أي أو كل من مكان وتاريخ الصناعة واسم الصانع.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括生产地或生产日期或生产者名称这些中的任何一个或者全部</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30288 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30288">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur la production</rdfs:label>
        <rdfs:label xml:lang="hu">előállításra vonatkozó megjelenésiforma- közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yapım bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione di produzione</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om produksjon</rdfs:label>
        <rdfs:label xml:lang="da">har manifestationsoplysning om produktion</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation production statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Entstehungsangabe einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-productievermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse tootmisandmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation tuotantomerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas izgatavošanas ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de producción de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de producció</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان إنتاج لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现制作说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanmamış bir gösterimin yazımı, üretimi, inşası veya diğer üretim yöntemleriyle ilgili veriler hakkındaki bir gösterim beyanıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione sui dati relativi all&apos;iscrizione, fabbricazione, costruzione, etc. di una manifestazione non pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy olyan megjelenésiforma-közléshez, amely egy közzé nem tett megjelenési forma bejegyzésével, elkészítésével, megépítésével stb. kapcsolatos adatokat tartalmaz</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön julkaisemattoman manifestaation kaivertamiseen, valmistamiseen, kokoamiseen tai muuhun tuotantotapaan liittyvistä tiedoista.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à des données sur la scription, la fabrication, la construction ou toute autre méthode de production d’une manifestation non publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre dades relatives a la inscripció, la fabricació, la construcció o un altre mètode de producció d’una manifestació no publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre datos relacionados con la inscripción, fabricación, construcción u otro método de producción de una manifestación inédita.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over gegevens gerelateerd aan de afschrijving, vervaardiging, constructie of andere methode van productie van een ongepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om data knyttet til inskripsjon, fabrikasjon, konstruksjon etc. av en upublisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om data, som relaterer til indskrift, fremstilling, konstruktion etc. af en upubliceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about data relating to the inscription, fabrication, construction, or other method of production of an unpublished manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par datiem, kas saistīti ar nepublicētas manifestācijas ierakstīšanu, izgatavošanu, izveidošanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega avaldamata kehastuse inskribeerimise, tootmise, ehitamise vms kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die Daten zu der Beschriftung, der Fabrikation, der Konstruktion oder einer anderen Entstehungsmethode einer unveröffentlichten Manifestation enthält.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بتسجيل، أو تصنيع، أو إنشاء، إلخ. لتجسيدة غير منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于和一种非出版载体表现的镌刻、制造、构建或其他制作方法有关的数据的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes any or all of place or date of production or name of producer.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed sisaldavad tootmise kohta, daatumit ja tootja nime, või vähemalt ühte neist.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim üretim yeri veya tarihinin veya üreticinin adının herhangi birini veya tamamını içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: Entstehungsort, Entstehungsdatum oder Erzeugername.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een of alle van plaats en datum van productie en naam van producent.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione comprende, del tutto o in parte, il luogo e la data di produzione, e il nome del produttore.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää jonkin tai kaikki seuraavista: tuotantopaikka, tuotantoaika ja tuottajan nimi.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter hvilken som helst eller alle af: sted, dato for produktion og navn på producer.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningen inkluderer alle steder og datoer for produksjon og navn på produsent.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye parte o la totalidad del lugar o fecha de producción o el nombre del productor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou, en tot o en part, el lloc o la data de producció o el nom de productor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une partie ou la totalité des informations suivantes : lieu ou date de production ou nom de producteur.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver daļēju vai pilnu informāciju par izgatavošanas vietu un datējumu un izgatavotāja nosaukumu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">készítési megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل البيان على أي أو كل من مكان وتاريخ الإنتاج واسم المنتج.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括制作地或制作日期或制作者名称这些中的任何一个或者全部</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30289 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30289">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur la publication</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yayınlama bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione di pubblicazione</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om utgivelse</rdfs:label>
        <rdfs:label xml:lang="da">har manifestations publiceringsoplysning</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation publication statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Veröffentlichungsangabe einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-publicatievermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse ilmumisandmed</rdfs:label>
        <rdfs:label xml:lang="hu">közzétételre vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation julkaisumerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas izdošanas ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de publicación de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de publicació</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان نشر لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现出版说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimin yayınlanması, gösterime sunulması veya yayınlanmasıyla ilgili bir gösterim beyanıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione sulla publicazione, diffusione o emissione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési forma kiadásához, kibocsájtásához vagy megjelentetéséről szóló megjelenésiforma-közléshez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön manifestaation kustantamiseen, julkaisemiseen, ilmestymiseen tms. liittyvistä tiedoista.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à la publication, à la mise à disposition ou à l’édition d’une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre la publicació, la posada en circulació o l’emissió d’una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre la publicación, divulgación o emisión de una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over het uitgeven, uitbrengen of uitvaardigen van een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om utgivelse, tilgjengeliggjøring eller utstedelse av en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om publiceringen, frigivelse eller udgivelse af en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about the publication, release, or issuing of a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par manifestācijas publicēšanu, izlaidi vai izdošanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega kehastuse avaldamise, väljalaskmise või väljaandmise kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die Informationen über die Veröffentlichung, das Release oder die Herausgabe einer Manifestation enthält.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بالنشر أو الإصدار لتجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于一种载体表现出版、发布或发行的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A statement includes any or all of place or date of publication or name of publisher.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Andmed sisaldavad ilmumiskohta, ilmumisaastat ja kirjastaja nime, või vähemalt ühte neist.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir bildirim, yayın yeri veya tarihinin veya yayıncının adının herhangi birini veya tamamını içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: Erscheinungsort, Erscheinungsdatum oder Verlagsname.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een vermelding omvat een of alle van plaats of datum van publicatie of naam van uitgever.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione comprende, del tutto o in parte, il luogo e la data di pubblicazione, e il nome dell&apos;editore.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Merkintö sisältää jonkin tai kaikki seuraavista: kustannuspaikka, julkaisuaika ja kustantajan nimi.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Oplysning omfatter hvilken som helst eller alle af: sted, dato for udgivelse og navn på udgiver.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Opplysningen inkluderer alle steder og datoer for utgivelse og navn på utgiver.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración incluye parte o la totalidad del lugar o fecha de publicación o el nombre del editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció inclou, en tot o en part, el lloc o la data de publicació o el nom d’editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention comprend une partie ou la totalité des informations suivantes : lieu ou date de publication ou nom d’éditeur.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ziņas ietver daļēju vai pilnu informāciju par izgatavošanas vietu un datējumu un izgatavotāja nosaukumu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">megjelenési megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل البيان على أي أو كل من مكان وتاريخ النشر واسم الناشر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">说明包括出版地或出版日期或出版者名称这些中的任何一个或者全部</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30290 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30290">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur un code de région</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin bölgesel kodlanma bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione della codifica regionale</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om regionskode</rdfs:label>
        <rdfs:label xml:lang="da">har manifestations regional kodningsoplysning</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation regional encoding statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Angabe zum Regionalcode einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-regiocoderingsvermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse regioonikoodi andmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation merkintö aluekoodista</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas reģiona koda ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">regionális kódolásra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de codificación regional de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de codificació de regional</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان أكواد مناطق لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现地区编码说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir video diskin veya video oyunu taşıyıcısının kodlandığı dünyanın bir veya daha fazla bölgesi için bir atama hakkında bir gösterim beyanıyla ilişkilendirir ve oynatmanın,bunun kodunu çözecek şekilde yapılandırılmış bir cihazla sınırlı olduğunu belirtir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione su una designazione per una o più regioni del mondo per le quali un supporto di video disco o videogioco è stato codificato e che indica che la lettura è limitata a un dispositivo configurato per la decodifica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenésiforma-közléshez, amely vegy videolemez vagy videojáték-hordozó kódolásáról szól, a világ egy vagy több régiójának jelölésével, és azt jelzi, hogy a lejátszás egy dekódolásra konfigurált eszközre korlátozódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön määritteestä, jolla identifioidaan videolevyn tai videopelitallenteen käyttöalue ja estetään niiden käyttäminen toisella alueella myydyllä soittimella.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à une désignation d’une ou plusieurs régions du monde pour laquelle un vidéodisque ou un support matériel de jeu vidéo a été encodé, qui indique que sa lecture est limitée à un appareil configuré pour le décoder.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre una designació d’una o més regions del món per a la qual s’ha codificat un suport físic de videodisc o videojoc, indicant que la reproducció és restringida a un dispositiu configurat per descodificar-lo.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre una designación para una o más regiones del mundo para las cuales se ha codificado un soporte de videodisco o videojuego, indicando que la reproducción está restringida a un dispositivo configurado para decodificarlo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over een aanduiding voor één of meer regio&apos;s van de wereld waarvoor een videodisk of computerspeldrager gecodeerd is, om aan te geven dat het afspelen beperkt is tot een apparaat dat deze kan decoderen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om en betegnelse for en eller flere regioner i verden som en videoplate eller videospillbærer er kodet for og som indikerer at avspilling er avgrenset til en enhet som er konfigurert for å dekode den.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om en betegnelse for en eller flere regioner i verden, som en videodisk eller spillekonsol er kodet til, hvormed afspilning er forbeholdt en enhed, som er konfigureret til at afkode regionskoden.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about a designation for one or more regions of the world for which a videodisc or video game carrier has been encoded, indicating that playback is restricted to a device configured to decode it.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par apzīmējumu vienam vai vairākiem pasaules reģioniem, kuriem videodiska vai videospēļu nesējs ir kodēts, norādot, ka atskaņošana ir ierobežota īpaši konfigurētām ierīcēm.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega tähistuse kohta, mis märgib üht või mitut maailma regiooni, mille jaoks videoplaat või videomängu kandja on kodeeritud, nii et taasesitus on võimalik ainult selle dekodeerimiseks sobiva seadmega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die die Region(en) der Welt angibt, für die eine Videodisk oder ein Videospiel-Datenträger kodiert ist, und der verhindert, dass die Disk von einem Wiedergabegerät, das in einer anderen Region verkauft wurde, abgespielt werden kann.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بتسمية منطقة أو أكثر من العالم التي تم تكويد حامل قرص الفيديو أو ألعاب الفيديو وفقًا له، ويوضح أن التشغيل مقيد بجهاز معد لفك الكود.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于视盘或视频游戏载体被编码后表示对设置解码回放的设备限制的世界上一个或多个地区的标识的一个载体表现说明关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30291 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30291">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur une collection</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin seri bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione della serie</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om serie</rdfs:label>
        <rdfs:label xml:lang="da">har manifestations seriebetegnelse</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation series statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Gesamttitelangabe einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-reeksvermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse seeriaandmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation sarjamerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas sērijas ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">sorozatra vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de serie de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de col·lecció</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان سلسلة تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现丛编说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, seri içindeki bir gösterimin numaralandırılmasıyla ilişkili bir seri hakkındaki bir gösterim ifadesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione su una serie associata alla manifestazione e alla numerazione di una manifestazione all&apos;interno della serie.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési formával társított sorozatról és a megjelenési forma sorozaton belüli számozásáról szóló megjelenésiforma-közléshez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön manifestaatioon liittyvästä sarjasta ja manifestaation numeroinnista sarjassa.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative à une collection associée à une manifestation et à une numérotation d’une manifestation à l’intérieur de la collection.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre una col·lecció que s’associa amb una manifestació i una numeració d’una manifestació dins la col·lecció.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre una serie que está asociada con una manifestación y una numeración de una manifestación dentro de la serie.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over een reeks die geassocieerd is met een manifestatie en een nummering van een manifestatie binnen de reeks.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om en serie som er knyttet til manifestasjonen og en nummerering av en manifestasjon innen serien.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om en serie, som er knyttet til en manifestation og en nummerering af en manifestation indenfor serie.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about a series that is associated with a manifestation and a numbering of a manifestation within the series.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par sēriju, kas ir saistīta ar manifestāciju, un manifestācijas numerāciju sērijas ietvaros.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega kehastusega seotud seeria ja kehastuse seeriasisese numbri kohta.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die Informationen über eine Reihe enthält, mit der eine Manifestation in Verbindung steht und die eine Zählung einer Manifestation innerhalb der Reihe aufweist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بسلسلة ترتبط بالتجسيدة والترقيم الخاص بتجسيدة داخل السلسلة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于和一种载体表现有关的一种丛编以及一种载体表现在丛编内的编号的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A manifestation series statement includes any or all of title of series, other title information of series, statement of responsibility relating to series, ISSN, or numbering within sequence.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir gösterim serisi bildirimi, serinin başlığının herhangi birini veya tamamını, serinin diğer başlık bilgilerini, seriyle ilgili sorumluluk bildirimini, ISSN&apos;yi veya dizi içindeki numaralandırmayı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen eine, mehrere oder alle der folgenden Angaben: Titel einer Reihe, Titelzusätze einer Reihe, Verantwortlichkeitsangaben, die sich auf eine Reihe beziehen, ISSNs oder eine Zählung innerhalb einer Reihe.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een manifestatie reeksvermelding omvat een of alle van hoofdtitel van de reeks, overige titelgegevens van de reeks; verantwoordelijkheidsvermelding gerelateerd aan de reeks; ISSN, en nummering binnen de reeks.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En manifestasjonsopplysning om serie inkluderer alle hovedtitler for serie, annen tittelinformasjon for serie, ansvarsangivelse knyttet til serie, ISSN og nummerering innen serie.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kehastuse seeriaandmed sisaldavad seeria põhipealkirja, pealkirja täiendandmeid, seeriaga seotud vastutusandmeid, ISSNi ja seeriasisest numbrit, või vähemalt ühte neist.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione di manifestazione della serie comprende, del tutto o in parte, il titolo proprio della serie, altre informazioni del titolo della serie, formulazione di responsabilità relativa alla serie, ISSN e numerazione all&apos;interno della serie.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Manifestaation sarjamerkintö sisältää jonkin tai kaikki seuraavista: sarjan päänimeke, sarjan muu nimeketieto, sarjaan liittyvä vastuullisuusmerkintö, ISSN ja sarjaan sisältyvä numerointi.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Manifestations seriebetegnelse omfatter hvilken som helst eller alle af: seriehovedtitel, anden titelinformation om serie, ophavsangivelse, som relaterer til serie; ISSN og nummerering indenfor serie.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Sērijas ziņas ietver daļēju vai pilnu informāciju par sērijas pamatnosaukumu, par citu sērijas nosaukumu; sērijas atbildības ziņām; ISSN vai sērijas numerāciju.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración de serie de manifestación incluye parte o la totalidad del título de la serie, otra información del título de la serie, declaración de responsabilidad relacionada con la serie, ISSN o numeración dentro de la secuencia.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció de manifestació de col·lecció inclou, en tot o en part, el títol de col·lecció, el complement de títol de col·lecció, la menció de responsabilitat relativa a la col·lecció, l’ISSN o la numeració dins d’una seqüència.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention de manifestation sur une collection comprend une partie ou la totalité des informations suivantes : titre de collection, complément de titre de collection, mention de responsabilité relative à une collection, ISSN ou numérotation au sein d’une séquence.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">sorozati megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل بيان تجسيدة سلسلة على أي أو كل من العنوان نفسه للسلسلة وأي بيانات أخرى لعنوان السلسلة، وبيان المسئولية المرتبط بالسلسلة، والترقيم الدولي الموحد للسلاسل، الترقيم داخل السلسلة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">载体表现丛编说明包括丛编题名、丛编其他题名信息、和丛编有关的责任说明、ISSN、或序列内的编号这些中的任何一个或者全部。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30292 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30292">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di manifestazione</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning</rdfs:label>
        <rdfs:label xml:lang="da">har manifestationsoplysning</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Manifestationsangabe</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatievermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse andmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaatiomerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas ziņas</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene declaración de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimde görünen ve kullanıcıların gösterimin kendisini nasıl temsil ettiğini anlamaları için önemli olduğu düşünülen bir ifadeyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione che compare in una manifestazione, considerata come significativa per gli utenti per capire come la manifestazione si presenti.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési forma egy megjelenési formán előforduló olyan közléshez, amelyet a felhasználók jelentősnek tartanak annak megértéséhez, hogy a megjelenési forma hogyan képviseli önmagát.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation merkintöön, joka esiintyy manifestaatiossa ja jota pidetään tärkeänä, jotta käyttäjät ymmärtävät, kuinka manifestaatio edustaa itseään.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention qui figure dans une manifestation et est jugée importante en ce qu&apos;elle permet aux utilisateurs de comprendre comment la manifestation se représente elle-même.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció que figura en una manifestació i que es considera significativa perquè els usuaris entenguin com la manifestació es representa a si mateixa.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración que aparece en una manifestación y se considera importante para que los usuarios comprendan cómo la manifestación se representa a sí misma.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een vermelding opgenomen in een manifestatie en die belangrijk gevonden wordt voor gebruikers om te begrijpen hoe de manifestatie zichzelf vertegenwoordigt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en opplysning som framkommer i en manifestasjon som ansees å være viktig for brukerene for å forstå hvordan manifestasjonen framstår.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en oplysning, som vises i en manifestation og som anses for vigtig for brugernes forståelse af, hvordan manifestationen repræsenterer sig selv.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a statement appearing in a manifestation and deemed to be significant for users to understand how the manifestation represents itself.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar ziņām, kas atrodamas manifestācijā un ir uzskatāmas par būtiskām lietotājiem, lai saprastu, kā manifestācija pārstāv pati sevi.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse andmetega, mis esinevad kehastuses ja mida peetakse kasutajale oluliseks kehastuse olemusest arusaamiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Angabe, die in der Manifestation erscheint und die für Benutzerinnen/Benutzer als wichtig erachtet wird, um zu verstehen, wie die Manifestation sich selbst darstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان ظاهر على تجسيدة يعد مهمًا للمستخدمين لفهم كيف تقدم التجسيدة نفسها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与在一种载体表现中出现并被认为对使用者理解该载体表现呈现方式重要的一个说明关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30293 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30293">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour mention de manifestation sur les titres et les responsabilités</rdfs:label>
        <rdfs:label xml:lang="hu">címre és felelősségre vonatkozó megjelenésiforma-közlése a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin başlık ve sorumluluk bildirimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come formulazione di titolo e di responsabilità della manifestazione</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjonsopplysning om tittel og ansvar</rdfs:label>
        <rdfs:label xml:lang="da">har manifestationstitel og ophavsangivelse</rdfs:label>
        <rdfs:label xml:lang="en">has manifestation title and responsibility statement</rdfs:label>
        <rdfs:label xml:lang="de">hat Titel und Verantwortlichkeitsangabe einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie-titel en verantwoordelijkheidsvermelding</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse pealkirja- ja vastutusandmed</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation nimeke- ja vastuullisuusmerkintö</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas nosaukums un atbildības ziņas</rdfs:label>
        <rdfs:label xml:lang="es">tiene título de manifestación y declaración de responsabilidad</rdfs:label>
        <rdfs:label xml:lang="ca">té com a menció de manifestació de títol i responsabilitat</rdfs:label>
        <rdfs:label xml:lang="ar">له بيان مسئولية عنوان تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现题名和责任说明</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimin başlıkları ve bir gösterimin somutlaştırdığı bir anlatımın içeriğinden sorumlu olan temsilcilerin adları hakkında bir gösterim ifadesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una formulazione di manifestazione relativa ai titoli di una manifestazione e ai nomi degli agenti responsabili del contenuto dell&apos;espressione materializzata in una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy olyan megjelenésiforma-közléshez, amely a megjelenési forma címét és azoknak az ágenseknek a nevét tartalmazza, akik/amelyek felelősek a megjelenési formába beépülő kifejezési forma tartalmáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatiomerkintöön manifestaation nimekkeistä ja manifestaatioon sisältyvän ekspression sisältöön vaikuttavien toimijoiden nimistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une mention de manifestation relative aux titres d’une manifestation et aux noms des agents responsables du contenu d’une expression matérialisée par une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una menció de manifestació sobre els títols d’una manifestació i els noms dels agents que són responsables del contingut de l’expressió que es materialitza en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una declaración de manifestación sobre los títulos de una manifestación y los nombres de los agentes que son responsables del contenido de una expresión que está incorporada en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een manifestatievermelding over de titels van een manifestatie en de namen van actoren die verantwoordelijk zijn voor de inhoud van de expressie verwezenlijkt in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en manifestasjonsopplysning om titlene for en manifestasjon og navn på agentene som er ansvarlige for innholdet av uttrykket som er realisert i en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en manifestationsoplysning om titlerne på en manifestation og navnene på agenter, som er ansvarlige for indholdet af det udtryk, som er indeholdt i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a manifestation statement about the titles of a manifestation and the names of agents who are responsible for the content of an expression that is embodied by a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar manifestācijas ziņām par manifestācijas nosaukumiem un aģentu vārdiem/nosaukumiem, kuri ir atbildīgi par manifestācijā ietverto izteiksmes saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse andmetega, mis puudutavad kehastuse pealkirju ja kehastuses teostatud väljenduse sisu eest vastutavate tegijate nimesid.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Manifestationsangabe, die die Titel einer Manifestation und die Namen der Akteure enthält, die für den Inhalt der Expression, die durch eine Manifestation verkörpert ist, verantwortlich sind.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وبيان تجسيدة خاص بعناوين التجسيدة وأسماء الوكلاء المسئولين عن محتوى التعبيرة المجسدة في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与关于一种载体表现的题名以及负责被一种载体表现所具体化的一种内容表达之内容的一个行为者的名称的一个载体表现说明关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A manifestation title and responsibility statement includes any kind of title or statement of responsibility that is associated with the content of the manifestation, but does not include a title or statement of responsibility that is associated with an edition, revision or series that is related to the manifestation.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir gösterimin başlık ve sorumluluk bildirimi, gösterimin içeriğiyle ilişkilendirilen herhangi bir başlığı veya sorumluluk bildirimini içerir; ancak, gösterimle ilişkili bir baskı, revizyon veya seriye ait başlık veya sorumluluk bildirimini içermez.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen alle Arten von Titeln (Haupttitel, abweichende Titel und Titelzusätze) oder Verantwortlichkeitsangaben, die mit dem Inhalt der Manifestation in Beziehung stehen. Darunter fallen keine Titel oder Verantwortlichkeitsangaben von in Beziehung stehenden Ausgaben, Überarbeitungen oder Reihen, die mit der Manifestation in Verbindung stehen.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een manifestatietitel en verantwoordelijkheidsvermelding omvat elke soort titel of verantwoordelijkheidsvermelding dat geassocieerd is met de content van de manifestatie, maar die niet omvat een titel of verantwoordelijkheidsvermelding die geassocieerd is met een editie, herziening of serie die gerelateerd is aan de manifestatie.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En manifestasjonsopplysning om tittel og ansvar inkluderer alle typer tittel, inkludert hovedtittel, varianttittel eller annen tittelinformasjon, alle typer ansvarsangivelse knyttet til innholdet av manifestasjonen, men inkluderer ikke titler for tilknyttede serier eller navn på agenter som er ansvarlige for slike serier.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kehastuse pealkirja- ja vastutusandmed hõlmavad kõiki pealkirju, k.a põhipealkiri, variantpealkiri ja pealkirja täiendandmed, samuti kõiki kehastuse sisuga seotud vastutusandmeid, kuid ei hõlma seotud seeria pealkirju ega seeria eest vastutavate tegijate nimesid.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">La formulazione di titolo e di responsabilità della manifestazione comprende qualsiasi tipo di titolo, compreso un titolo proprio, una forma variante del titolo e altre informazioni sul titolo e qualsiasi tipo di formulazione di responsabilità relativa al contenuto della manifestazione, ma non comprende titoli di serie correlate o nomi di agenti responsabili di tali serie.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Manifestaation nimeke- ja vastuullisuusmerkintö sisältää kaikenlaiset nimekkeet (ml. päänimekkeen, nimekkeen varianttimuodot ja muun nimeketiedon) sekä kaikenlaiset manifestaation sisältöön liittyvät vastuullisuusmerkinnöt. Manifestaation nimeke- ja vastuullisuusmerkintö ei sisällä sarjaan liittyviä nimekkeitä eikä sarjasta vastuussa olevien toimijoiden nimiä.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Manifestationstitel og ophavsangivelse omfatter enhver form for titel, herunder en hovedtitel, en variant af titlen og anden titelinformation og enhver form for ophavsangivelse, som relaterer til indholdet af en manifestation, men omfatter ikke titler på relaterede serier eller navne på agenter, som er ophav for sådanne serier.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Manifestācijas nosaukums un atbildības ziņas ietver jebkura veida nosaukumu, ieskaitot pamatnosaukumu, atšķirīgo vārdu/nosaukuma un citu nosaukuma informāciju, vai jebkura veida atbildības ziņas, kas saistītas ar manifestācijas saturu, bet neietver saistīto sēriju nosaukumus vai to aģentu vārdus, kuri ir atbildīgi par šādām sērijām.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una declaración de título y responsabilidad de manifestación incluye cualquier tipo de título o declaración de responsabilidad que esté asociada con el contenido de la manifestación, pero no incluye un título o declaración de responsabilidad que esté asociada con una edición, revisión o serie que esté relacionada con la manifestación.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una menció de manifestació de títol i responsabilitat inclou qualsevol tipus de títol o menció de responsabilitat que s’associa amb el contingut de la manifestació, però no inclou un títol o una menció de responsabilitat que s’associa amb una edició, una revisió o una col·lecció que es relaciona amb la manifestació.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une mention de manifestation sur les titres et les responsabilités comprend tout type de titre ou de mention de responsabilité qui est associée au contenu de la manifestation, mais ne comprend pas un titre ou une mention de responsabilité qui est associée à une édition, une révision ou une collection qui est reliée à la manifestation.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">cím- és felelősségi megjelenésiforma-közlés</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل العنوان وبيان المسئولية للتجسيدة على أي نوع من العناوين ويشمل العنوان نفسه، أشكال مختلفة للعنوان، وبيانات أخرى للعنوان، وأي بيان مسئولية مرتبط بمحتوى التجسيدة ولكن لا يشتمل على العناوين الأخري في السلسلة، أو اسماء الوكلاء المسئولين عن السلسلة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">载体表现题名和责任说明包括与该载体表现的内容有关的任何类型的题名或责任说明，但不包括与该载体表现所关联的版本、修订或丛编的题名或责任说明。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30294 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30294">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour point d’accès autorisé d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="hu">autorizált hozzáférési pontja megjelenési formához a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim için yetkili erişim noktası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come punto d&apos;accesso autorizzato per manifestazione</rdfs:label>
        <rdfs:label xml:lang="da">har autoriseret søgeindgang for manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har autorisert søkeinngang for manifestasjon</rdfs:label>
        <rdfs:label xml:lang="en">has authorized access point for manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat normierten Sucheinstieg für eine Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geautoriseerde ingang voor manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse normitud otsielement</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation auktorisoitu hakutieto</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas autoritatīvā pamatforma</rdfs:label>
        <rdfs:label xml:lang="es">tiene un punto de acceso autorizado para la manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a punt d’accés autoritzat de manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له نقطة إتاحة مقننة لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的规范检索点</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, belirli bir kelime kodlama şemasında tercih edilmek üzere seçilen bir örneğin erişim noktası olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un punto d&apos;accesso di una manifestazione scelto come preferito in uno specifico schema di codifica del vocabolario.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési forma a megjelenési forma egy olyan hozzáférési pontjához, amelynek kiválasztásához egy speciális szótárkódolási sémát részesítenek előnyben.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on manifestaation hakutieto, joka on valittu ensisijaiseksi tietyssä sanaston merkintäjärjestelmässä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un point d’accès d’une manifestation faisant l’objet d’un choix privilégié dans un schéma d’encodage de vocabulaire spécifique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un punt d’accés de manifestació que se selecciona com a preferent en un esquema de codificació de vocabulari específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es un punto de acceso a la manifestación que se selecciona de preferencia en un esquema de codificación de vocabulario específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een ingang van manifestatie die als voorkeursterm geselecteerd is in een specifiek vocabulair coderingssysteem.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en foretrukket søkeinngang for manifestasjon som er valgt fra et bestemt kodeskjema for vokabular.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en søgeindgang for manifestation, som er valgt som præference i et specifikt vokabularkodningsskema.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is an access point of manifestation that is selected for preference in a specific vocabulary encoding scheme.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir manifestācijas pamatforma, kas ir izvēle no konkrētas vārdnīcas.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse otsielemendiga, mis on valitud eelistatuks vastavas leksikaalses märkimissüsteemis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Sucheinstieg für eine Manifestation, der in einem bestimmten Vocabulary Encoding Scheme als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ونقطة إتاحة لتجسيدة التي تم اختيارها من خطة ترميز مفردات محددة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为一种载体表现的检索点、并在一个特定的词表编码体系中被首选的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30295 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30295">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour variante de point d’accès d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterim için alternatif erişim noktası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come punto d&apos;accesso variante per manifestazione</rdfs:label>
        <rdfs:label xml:lang="no">har alternativ søkeinngang for manifestasjon</rdfs:label>
        <rdfs:label xml:lang="da">har variant af søgeindgang for manifestation</rdfs:label>
        <rdfs:label xml:lang="en">has variant access point for manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat zusätzlichen Sucheinstieg für eine Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft variant ingang voor manifestatie</rdfs:label>
        <rdfs:label xml:lang="hu">hozzáférésipont-variánsa megjelenési forma számára a következő:</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse otsielemendi variant</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation varianttihakutieto</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas papildforma</rdfs:label>
        <rdfs:label xml:lang="es">tiene un punto de acceso variante para la manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a variant de punt d’accés de manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له نقطة إتاحة مختلفة لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的变异检索点</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, belirli bir kelime kodlama şemasında tercih için seçilmeyen bir örneğine erişim noktası olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un punto d&apos;accesso di manifestazione non scelto come preferito in uno specifico schema di codifica del vocabolario.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formához egy noment, amely egy olyan hozzáférési pont időtartam számára, amelyet egy adott szótárkódolási sémában nem részesítenek előnyben.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation nomeniin, joka on manifestaation hakutieto, jota ei ole valittu ensisijaiseksi tietyssä sanaston merkintäjärjestelmässä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un nomen qui est un point d’accès d’une manifestation ne faisant pas l’objet d’un choix privilégié dans un schéma d’encodage de vocabulaire spécifique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un nomen que és un punt d’accés de manifestació que no se selecciona com a preferent en un esquema de codificació de vocabulari específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un nomen que es un punto de acceso a la manifestación que no está seleccionado de preferencia en un esquema de codificación de vocabulario específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een nomen dat is een ingang van manifestatie die niet als voorkeursterm geselecteerd is in een specifiek vocabulair coderingssysteem.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en søkeinngang for manifestasjon som ikke er en foretrukket søkeinngang i et bestemt kodeskjema for vokabular.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en søgeindgang for manifestation, som ikke er valgt som præference i et specifikt vokabularkodningsskema.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a nomen that is an access point of manifestation that is not selected for preference in a specific vocabulary encoding scheme.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar nomenu, kas ir piekļuves punkts manifestācijai, kas nav izvēlēta kā prioritāra noteiktai kontrolētas vārdnīcas shēmai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kehastuse otsielemendiga, mis ei ole valitud eelistatuks vastavas leksikaalses märkimissüsteemis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Sucheinstieg für eine Manifestation, der in einem bestimmten Vocabulary Encoding Scheme nicht als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ونقطة إتاحة لتجسيدة التي لم يتم اختيارها من خطة ترميز مفردات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为一种载体表现的检索点、并没有在一个特定的词表编码体系中被首选的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30304 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30304">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour matériau</rdfs:label>
        <rdfs:label xml:lang="hu">anyaga a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come materiale</rdfs:label>
        <rdfs:label xml:lang="da">har materiale</rdfs:label>
        <rdfs:label xml:lang="no">har materiale</rdfs:label>
        <rdfs:label xml:lang="en">has material</rdfs:label>
        <rdfs:label xml:lang="de">hat Material</rdfs:label>
        <rdfs:label xml:lang="nl">heeft materiaal</rdfs:label>
        <rdfs:label xml:lang="fi">materiaali</rdfs:label>
        <rdfs:label xml:lang="lv">materiāls</rdfs:label>
        <rdfs:label xml:lang="et">materjal</rdfs:label>
        <rdfs:label xml:lang="tr">materyal ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene material</rdfs:label>
        <rdfs:label xml:lang="ca">té com a material</rdfs:label>
        <rdfs:label xml:lang="ar">له مادة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有材料</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, gösterim oluşturmak için kullanılan fiziksel veya kimyasal bir madde ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a una sostanza chimica o fisica utilizzata per creare una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy olyan fizikai vagy kémiai anyaghoz, amelyet egy megjelenési forma létrehozásához használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation fysikaaliseen tai kemialliseen aineeseen, jota on käytetty manifestaation luomisessa.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une substance physique ou chimique qui est utilisée pour créer une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una substància física o química que s’usa per crear una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una sustancia física o química que se utiliza para crear una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een fysieke of chemische substantie die is gebruikt om een manifestatie te creëren.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en fysisk eller kjemisk substans som brukes til å lage en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til et fysisk eller kemisk stof, der anvendes til at skabe en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a physical or chemical substance that is used to create a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar fizisku vai ķīmisku vielu, ko izmanto, lai radītu manifestāciju.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse füüsilise või keemilise ainega, mida on kasutatud kehastuse teostamiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer physischen oder chemischen Substanz, die zur Erstellung einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومادة فيزيائية أو كيميائية مستخدمة في إنشاء تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与被用于创建一种载体表现的一种物理或化学物质关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30307 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30307">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour pas de sillonnage</rdfs:label>
        <rdfs:label xml:lang="hu">barázdamagassága a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come passo del solco</rdfs:label>
        <rdfs:label xml:lang="da">har rilledybde</rdfs:label>
        <rdfs:label xml:lang="no">har rillevidde</rdfs:label>
        <rdfs:label xml:lang="en">has groove pitch</rdfs:label>
        <rdfs:label xml:lang="de">hat Rillenabstand</rdfs:label>
        <rdfs:label xml:lang="nl">heeft groefpitch</rdfs:label>
        <rdfs:label xml:lang="tr">oluk aralığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">rievu blīvums</rdfs:label>
        <rdfs:label xml:lang="es">tiene paso de ranura</rdfs:label>
        <rdfs:label xml:lang="ca">té com a pas de solc</rdfs:label>
        <rdfs:label xml:lang="fi">urajako</rdfs:label>
        <rdfs:label xml:lang="et">vao samm</rdfs:label>
        <rdfs:label xml:lang="ar">له مسار أسطوانة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有槽纹间距</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, analog bir silindirin kanal aralığı ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un passo del solco di un cilindro analogico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy analóg henger barázdamagasságához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation analogisen äänilieriön urajakoon.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un pas de sillonnage d’un cylindre analogique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un pas del solc d’un cilindre analògic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con el paso de una ranura de un cilindro analógico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een groefpitch van een analoge cilinder.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en rillevidde for en analog sylinder.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en rilledybde på en analog cylinder.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a groove pitch of an analog cylinder.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar analogā cilindra rievu blīvumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse analoogtrumli vao sammuga.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Abstand zwischen den Rillen eines Phonographenzylinders.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومسارات مفحورة على اسطوانة تناظرية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与模拟筒的纹槽间距关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30308 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30308">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour largeur de sillon</rdfs:label>
        <rdfs:label xml:lang="hu">barázdaszélessége a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come ampiezza del solco</rdfs:label>
        <rdfs:label xml:lang="da">har rillebredde</rdfs:label>
        <rdfs:label xml:lang="no">har rillebredde</rdfs:label>
        <rdfs:label xml:lang="en">has groove width</rdfs:label>
        <rdfs:label xml:lang="de">hat Rillenbreite</rdfs:label>
        <rdfs:label xml:lang="nl">heeft groefwijdte</rdfs:label>
        <rdfs:label xml:lang="tr">oluk genişliği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">rievas platums</rdfs:label>
        <rdfs:label xml:lang="es">tiene ancho de ranura</rdfs:label>
        <rdfs:label xml:lang="ca">té com a amplada de solc</rdfs:label>
        <rdfs:label xml:lang="fi">uran leveys</rdfs:label>
        <rdfs:label xml:lang="et">vao laius</rdfs:label>
        <rdfs:label xml:lang="ar">له عرض مسار قرص</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有槽纹宽度</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir analog diskin oluk genişliği ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un&apos;ampiezza del solco di un disco analogico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy analóg lemez barázdaszélességéhez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation analogisen levyn uran leveyteen.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une largeur de sillon d’un disque analogique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una amplada del solc d’un disc analògic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con el ancho de una ranura de un disco analógico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een groefwijdte van een analoge disk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en rillebredde for en analog plate.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en rillebredde på en analog disk.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a groove width of an analog disc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar analogā diska rievas platumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse analoogplaadi vao laiusega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Breite der Rillen auf einer Schallplatte.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعرض المسار لقرص تناظري.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与模拟盘的槽纹宽度关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30311 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30311">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur de musique</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til musik</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til musikk (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of music</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger einer Musik (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van muziek</rdfs:label>
        <rdfs:label xml:lang="fi">musiikkiin osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="et">muusikaline kaastööline (tegija)</rdfs:label>
        <rdfs:label xml:lang="tr">müziğe katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">mūzikas līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador de la música</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor de música</rdfs:label>
        <rdfs:label xml:lang="hu">zene közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بموسيقى</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音乐的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir müzik eserinin yorumunu oluşturan bir bütüne katkıda bulunan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy zenemű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän musiikkiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre musicale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra musical que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que contribuye al agregado y que crea una expresión de una obra musical que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die is een bijdrager aan aggregaat die een expressie van een muziekwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et musikalsk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et musikværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of a musical work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto mūzikas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues muusikateose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines Musikwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي بإنشاء عمل موسيقي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种音乐作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30312 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30312">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent arpenteur</rdfs:label>
        <rdfs:label xml:lang="hu">földmérő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er landinspektør</rdfs:label>
        <rdfs:label xml:lang="no">har landmåler (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has surveyor agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Landvermesserin/Landvermesser (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landmeter-actor</rdfs:label>
        <rdfs:label xml:lang="et">maamõõtja (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">maanmittari (toimija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente topógrafo</rdfs:label>
        <rdfs:label xml:lang="tr">topograf temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">topogrāfs (aģents)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent agrimensor</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساح</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有测绘者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, coğrafi bir alan için ölçümler veya boyutsal ilişkiler sağlayan kartografyaya katkıda bulunan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy térképészeti közreműködő ágenshez, amely egy földrajzi területről méréseket vagy dimenziós összefüggéseket szolgáltat.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation toimijaan, joka kartografiaan osallisena toimijana tuottaa maantieteellisen alueen mitat tai mittasuhteet.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur de cartographie qui fournit des mesures ou des relations dimensionnelles pour une aire géographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un agent contribuïdor de cartografia que proporciona mesuraments o relacions dimensionals d’una àrea geogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que es un agente aportante de cartografía que proporciona medidas o relaciones dimensionales para un área geográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die is een bijdrager-actor van cartografie die metingen of dimensionele verhoudingen verschaft voor een geografisch gebied.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en kartograf til aggregat som tilfører målinger eller størrelsesforhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er kartograf til samling, som angiver målinger eller dimensionelle forhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor agent of cartography who provides measurements or dimensional relationships for a geographic area.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir apkopojuma kartogrāfs un nodrošina ģeogrāfiskā apgabala mērījumus vai dimensiju attiecības.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes liitumi kartograafina hangib geograafilise piirkonna mõõdud või mõõdusuhted. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger einer Kartografie (Akteur), die/der Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مسئول عن رسم الخرائط في عمل تجميعي يقدم علاقات القياسات أو الأبعاد لمنطقة جغرافية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为地图绘制的贡献者行为者并为一个地理区域提供测量或尺寸关系的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30315 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30315">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur de cartographie</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til kartografi</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til kartografi (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of cartography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Kartografie (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van cartografie</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline kartograafia alal (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">kartografiaan osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="tr">kartografiye katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">kartográfia közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">kartogrāfijas līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador de cartografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor de cartografia</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم برسم خرائط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地图绘制贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir kartografik çalışmanın görüntüsü oluşturan bütünün bir parçası olan temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy kartográfiai mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän kartografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre cartographique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra cartogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente aportante del agregado que crea una expresión de una obra cartográfica que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van een cartografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et kartografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et kartografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of a cartographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto kartogrāfisko darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues kartograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines kartografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء عمل خرائطي ويتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种地图作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30316 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30316">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur de chorégraphie</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til koreografi</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til koreografi (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of choreography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Choreografie (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van choreografie</rdfs:label>
        <rdfs:label xml:lang="lv">heoreogrāfijas līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline koreograafia alal (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">koreografiaan osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="tr">koreografiye katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfia közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador de coreografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor de coreografia</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بتصميم رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir koreografik çalışmanın yorumlanması için bir anlatım yaratan bütünün bir parçası olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy koreografikus mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän koreografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre chorégraphique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra coreogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colaborador del agregado que crea la expresión de una obra coreográfica que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van een choreografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et koreografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et koreografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of a choreographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto horeogrāfisko darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues koreograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines choreografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء عمل من تصميم الرقصات يتجسيد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种编舞作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30321 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30321">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur d’image fixe</rdfs:label>
        <rdfs:label xml:lang="lv">attēla līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">durağan görüntüye katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til stillbillede</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til bilde (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of still image</rdfs:label>
        <rdfs:label xml:lang="de">hat Illustratorin/Illustrator (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van stilstaand beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikumatu pildi alal (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">stillkuvaan osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador de imagen fija</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor d’imatge fixa</rdfs:label>
        <rdfs:label xml:lang="hu">állókép közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بصور ثابتة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有静态图像的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir hareketsiz görüntü çalışmasının görüntüsünü oluşturan bütünün bir parçası olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy állóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre d’image fixe matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra d’imatge fixa que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que contribuye al agregado y que crea una expresión de una obra de imagen fija que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van een stilstaand beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et bildeverk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et værk med stillbilleder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of a still image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto attēlu kā darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues liikumatust pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines unbewegten Bildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء عمل من صور ثابتة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种静态图像作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30326 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30326">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur d’images animées</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til levende billede</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til levende bilder (agent)</rdfs:label>
        <rdfs:label xml:lang="tr">hareketli görüntüye katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of moving image</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Bewegtbild (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van bewegend beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikuva pildi alal (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">kustīgu attēlu līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="fi">liikkuvaan kuvaan osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="hu">mozgókép közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador de imagen en movimiento</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor d’imatge en moviment</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بصور متحركة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有动态图像的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir hareketli görüntü çalışmasının görüntüsünü oluşturan bütünün bir parçası olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy mozgóképmű aggregátumban megtestesülő kifejezési formáját hozza létre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän liikkuvan kuvan teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre d’images animées matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra d’imatge en moviment que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que contribuye al agregado y que crea una expresión de una obra de imagen en movimiento que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van een bewegend beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et verk med levende bilder som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et værk med levende billeder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of a moving image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto kustīgu attēlu kā darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues liikuvast pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines Bewegtbildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء عمل من صور متحركة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种动态图像作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30327 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30327">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur à un agrégat</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattiin osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátum közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopojuma līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til samling</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til aggregat (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent to aggregate</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger zu einem Aggregat (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor aan aggregaat</rdfs:label>
        <rdfs:label xml:lang="et">liitumi kaastööline (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador para agregar</rdfs:label>
        <rdfs:label xml:lang="tr">toplamaya katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor a un agregat</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم في تجميعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir eserin görüntüsünü oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy mű aggregátumban megtestesülő mű kifejezési formájának létrehozásáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation toimijaan, joka on vastuussa aggregaattiin sisältyvän teoksen ekspression luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent qui est responsable de la création d’une expression d’une œuvre matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és responsable de la creació d’una expressió d’una obra que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que se encarga de crear una expresión de una obra que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die verantwoordelijk is voor het creëren van een expressie van een werk dat is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som skaper et verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som skaber et værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is responsible for creating an expression of a work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, līdzradītājs, kurš rada apkopojumā ietverto darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes loob teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Akteur, der für die Schaffung einer Expression eines Werks verantwortlich ist, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل ينشئ عمل يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责创建被一种合集具体化的一种作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30328 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30328">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur de texte</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til tekst</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tekst (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of text</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von ergänzendem Text (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van tekst</rdfs:label>
        <rdfs:label xml:lang="tr">metne katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">szöveg közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">teksta līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="fi">tekstiin osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="et">tekstiloome kaastööline (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador de texto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor de text</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بنص</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有文本的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan metinsel bir çalışmanın anlatımını yaratan bütünün bir parçası olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy szöveges mű aggregátumban megtestesülő kifejezési formáját hozza létre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre textuelle matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra textual que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que contribuye al agregado y que crea una expresión de una obra textual que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van een tekstwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et tekstlig verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et tekstværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of a textual work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto teksta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues tekstteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines textlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء عمل نصي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种文字作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30329 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30329">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent créateur d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yaratıcı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er ophav til manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av manifestasjon (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has creator agent of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Mitwirkende/Mitwirkenden an einer Manifestation (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-actor van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse teostaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation tekijä (toimija)</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas radītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma létrehozó ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente creador de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent creador d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل منشئ لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的创建者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir veya daha fazla gösterimin somutlaştırılmasından sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely felelős egy vagy több kifejezési forma megtestesüléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaatioon toimijaan, joka on vastuussa yhden tai useamman ekspression ilmiasusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent qui est responsable de la matérialisation d’une ou plusieurs expressions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és responsable de la materialització d’una o més expressions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que es responsable de la encarnación de una o más expresiones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die verantwoordelijk is voor de verwezenlijking van een of meer expressies.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er ansvarlig for realiseringen av ett eller flere uttrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er ansvarlig for realiseringen af et eller flere udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is responsible for the embodiment of one or more expressions.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir atbildīgs par vienas vai vairāku izteiksmju ietveršanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes vastutab ühe või mitme väljenduse teostamise eest kehastusena.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem Akteur, der für die Verkörperung einer Expression oder mehrerer Expressionen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مسئول عن عملية تجسيد تعبيرة أو أكثر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种或多种内容表达之具体化的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of manifestation includes a manufacturer, producer, and publisher.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Hersteller, Produzentinnen/Produzenten und Verlage.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van manifestatie omvat een vervaardiger, producent en uitgever.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En skaper av en manifestasjon inkluderer distributør, tilvirker, produsent og utgiver.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Gösterimin yaratıcısı, bir üretimci, yapımcı ve yayıncıyı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kehastuse teostaja hõlmab levitajat, valmistajat, tootjat ja kirjastajat.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Manifestaation tekijä sisältää jakelijan, valmistajan, tuottajan ja kustantajan.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Manifestācijas radītāji ir arī izplatītāji, ražotāji, izgatavotāji un izdevēji.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til manifestation omfatter distrubutør, producent, producer og udgiver ect.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de manifestación incluye un fabricante, un productor y un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una manifestació inclou un fabricant, un productor i un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une manifestation comprend un fabricant, un producteur et un éditeur.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">megjelenési forma létrehozó ágense:</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل منشئ التجسيدة على الموزع، والصانع، والمنتج، والناشر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">载体表现的创建者包括生产者、制作者和出版者</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30331 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30331">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur de contenu vocal</rdfs:label>
        <rdfs:label xml:lang="hu">beszéd közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di discorso agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til tale</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tale (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of speech</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Rede (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van spraak</rdfs:label>
        <rdfs:label xml:lang="tr">konuşmaya katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">kõneloome kaastööline (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">puheeseen osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="lv">runas līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador del habla</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor de discurs</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بحديث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有讲话的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir sesli eserin yorumunu oluşturan bütünün bir parçası olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente contributore a un aggregato, che crea un&apos;opera parlata, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy beszédmű aggregátumban megtestesülő kifejezési formáját hozza létre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre vocale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra vocal que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que contribuye al agregado y que crea una expresión de una obra vocal que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van een vocaal werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et verk av tale som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et værk med talte ord, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of a vocal work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto mutvārdu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues suulise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines gesprochenen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء عمل من كلمات منطوقة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种人声作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30332 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30332">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur d’objet</rdfs:label>
        <rdfs:label xml:lang="fi">esineeseen osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di oggetto agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til objekt</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til gjenstand (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of object</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Gegenstand (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van object</rdfs:label>
        <rdfs:label xml:lang="tr">nesneye katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">objekta līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">objektiloome kaastööline (tegija)</rdfs:label>
        <rdfs:label xml:lang="hu">objektum közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador del objeto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor d’objecte</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بكائن</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有物体的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir nesne çalışmasının ifadesini oluşturan bütünün bir parçası olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente contributore a un aggregato, che crea un’opera oggetto, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy tárgyi mű aggregátumban megtestesülő kifejezési formáját hozza létre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän esineteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’une œuvre objet matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió d’una obra d’objecte que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que contribuye al agregado y que crea una expresión de un objeto de obra que está encarnado por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van een objectwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragsyter til aggregat som skaper et verk som er en gjenstand som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et værk med objekt, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of an object work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto objekta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues objektteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression eines gegenständlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء عمل شيء ما يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种物体作品的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30333 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30333">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent contributeur de contenu informatique</rdfs:label>
        <rdfs:label xml:lang="tr">bilgisayar içeriğine katkıda bulunan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">datororientēta satura līdzradītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">digisisu kaastööline (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">digitaaliseen sisältöön osallinen toimija</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di contenuto informatico agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bidragsyder til computerindhold</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til datamaskininnhold (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has contributor agent of computer content</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von Computer Content (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager-actor van computercontent</rdfs:label>
        <rdfs:label xml:lang="hu">számítógépes tartalom közreműködő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colaborador de contenidos informáticos</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent contribuïdor de contingut informàtic</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مساهم بمحتوى كمبيوتر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有计算机内容的贡献者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir toplam tarafından somutlaştırılan bilgisayar içeriğinin bir ifadesini oluşturan toplama katkıda bulunan bir aracı ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente contributore a un aggregato, che crea un contenuto informatico, materializzato in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy ágenshez, amely aggregátor közreműködőként egy számítógépes tartalom aggregátumban megtestesülő kifejezési formáját hozza létre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen toimijaan, joka on luonut aggregaattiin sisältyvän digitaalisen sisällön ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent contributeur à un agrégat qui crée une expression d’un contenu informatique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent que és un contribuïdor a un agregat i que crea una expressió de contingut informàtic que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente que contribuye al agregado y que crea una expresión de contenido informático que está incorporado por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een actor die een bijdrager aan aggregaat is die een expressie van computercontent creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en agent som er en bidragyter til aggregat som skaper datamaskininnhold som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber computerindhold, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an agent who is a contributor to aggregate who creates an expression of computer content that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar aģentu, kas ir līdzradītājs, kas radījis apkopojumā ietverto datororientēto saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tegijaga, kes on liitumi kaastööline, luues digisisu väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Akteur), die/der eine Expression von Computer Content erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل مساهم في عمل تجميعي ينشيء محتوى كمبيوتر يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种计算机内容的一种内容表达的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30335 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30335">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour catégorie de manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">anlatımın kategorisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come categoria di manifestazione</rdfs:label>
        <rdfs:label xml:lang="da">har kategori af manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har kategori av manifestasjon</rdfs:label>
        <rdfs:label xml:lang="en">has category of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Kategorie einer Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft categorie van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse kategooria</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation kategoria</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas kategorija</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma kategóriája a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene categoría de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a categoria de manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له فئة تجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的类别</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, gösterimin ait olduğu bir türle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione a un tipo a cui appartiene una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát ahhoz a típushoz, amelyhez a megjelenési forma tartozik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation tyyppiin, johon manifestaatio kuuluu.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un type auquel une manifestation appartient.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un tipus al qual pertany una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un tipo al que pertenece una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een type waartoe een manifestatie behoort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en type som en manifestasjon tilhører.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en type, hvortil en manifestation tilhører.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a type to which a manifestation belongs.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar veidu, pie kura pieder manifestācija.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse tüübiga, millesse kehastus kuulub.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Art, zu der eine Manifestation gehört.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ونوع تنتمي إليه تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种载体表现所属于的一种类型关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30336 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30336">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice à un agrégat</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattiin osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátum közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopojuma līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore a un aggregato persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til aggregat (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til samling</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person to aggregate</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger zu einem Aggregat (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon aan aggregaat</rdfs:label>
        <rdfs:label xml:lang="et">liitumi kaastööline (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene una persona contribuyente para agregar</rdfs:label>
        <rdfs:label xml:lang="tr">toplamaya katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora a un agregat</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم في تجميعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir ifadesini oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona creatrice di un&apos;opera materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátumban megtestesülő mű kifejezési formájának létrehozásáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa aggregaattiin sisältyvän teoksen ekspression luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une expression d’une œuvre matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una expressió d’una obra que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que se encarga de crear una expresión de una obra que está plasmada en un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het creëren van een expressie van een werk die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som skaper et verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som skaber et værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating an expression of a work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura radījusi apkopojumā ietverto darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes loob teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Schaffung einer Expression eines Werks verantwortlich ist, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص ينشيء عمل يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责创建被一种合集具体化的一种作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30337 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30337">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne arpenteuse</rdfs:label>
        <rdfs:label xml:lang="hu">földmérő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come topografo persona</rdfs:label>
        <rdfs:label xml:lang="no">har landmåler (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er landinspektør</rdfs:label>
        <rdfs:label xml:lang="en">has surveyor person</rdfs:label>
        <rdfs:label xml:lang="de">hat Landvermesserin/Landvermesser (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landmeter-persoon</rdfs:label>
        <rdfs:label xml:lang="et">maamõõtja (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">maanmittari (henkilö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona topógrafo</rdfs:label>
        <rdfs:label xml:lang="tr">topograf kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">topogrāfs (persona)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona agrimensora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساح</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有测绘者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, coğrafi alan için ölçümler veya boyutsal ilişkiler sağlayan kartografiye katkıda bulunan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona cartografa di aggregato che fornisce misurazioni o rapporti dimensionali per un&apos;area geografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy kartográfia közreműködő ágense, aki egy földrajzi területről méréseket vagy dimenziós összefüggéseket szolgáltat.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka kartografiaan osallisena toimijana tuottaa maantieteellisen alueen mitat tai mittasuhteet.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice de cartographie qui fournit des mesures ou des relations dimensionnelles pour une aire géographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor de cartografia i que proporciona mesuraments o relacions dimensionals d’una àrea geogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es un agente colaborador de cartografía que proporciona medidas o relaciones dimensionales para un área geográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die is een bijdrager-actor van cartografie die metingen of dimensionele verhoudingen verschaft voor een geografisch gebied.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en kartograf til aggregat som tilfører målinger eller størrelsesforhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er kartograf til samling, som angiver målinger eller dimensionelle forhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor agent of cartography who provides measurements or dimensional relationships for a geographic area.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir apkopojuma kartogrāfs un nodrošina ģeogrāfiskā apgabala mērījumus vai dimensiju attiecības.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes liitumi kartograafina hangib geograafilise piirkonna mõõdud või mõõdusuhted. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger einer Kartografie (Person), die/der Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن رسم الخرائط في عمل تجميعي يقدم علاقات القياسات أو الأبعاد لمنطقة جغرافية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为地图绘制的贡献者行为者并为一个地理区域提供测量或尺寸关系的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30338 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30338">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice de cartographie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di cartografia persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til kartografi (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til kartografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of cartography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Kartografie (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van cartografie</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline kartograafia alal (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">kartografiaan osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="tr">kartografiye katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kartogrāfijas līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora de cartografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora de cartografia</rdfs:label>
        <rdfs:label xml:lang="hu">térképészet közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم برسم خرائط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地图绘制贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılan bir kartografik çalışmanın öğesini oluşturan bütünün bir parçası olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un&apos;opera cartografica, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy kartográfiai mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän kartografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre cartographique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió d’una obra cartogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es colaborador de un agregado que crea una expresión de una obra cartográfica que es plasmada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een cartografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et kartografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et kartografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of a cartographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto kartogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues kartograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines kartografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء عمل خرائطي ويتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种地图作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30339 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30339">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice de chorégraphie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di coreografia persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til koreografi (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til koreografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of choreography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Choreografie (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van choreografie</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfijas līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline koreograafia alal (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">koreografiaan osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="tr">koreografiye katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfia közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora de coreografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora de coreografia</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بتصميم رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılan bir koreografik çalışmanın anlatımını oluşturan bütünün bir parçası olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un&apos;opera coreografica, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy koreografikus mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän koreagrafisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre chorégraphique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una obra coreogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona colaboradora de un agregado que crea una expresión de una obra coreográfica que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een choreografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et koreografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et koreografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of a choreographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto horeogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues koreograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines choreografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء عمل من تصميم الرقصات يتجسيد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种编舞作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30340 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30340">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice d’images animées</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagine in movimento persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til levende bilder (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til levende billede</rdfs:label>
        <rdfs:label xml:lang="tr">hareketli görüntüye katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of moving image</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Bewegtbild (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van bewegend beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikuva pildi alal (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">kustīga attēla līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">liikkuvaan kuvaan osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="hu">mozgókép közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora de imagen en movimiento</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora d’imatge en moviment</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بصور متحركة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有动态图像的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir hareketli görüntü çalışmasının görüntüsünü oluşturan bütünün bir parçası olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un&apos;opera di immagini in movimento, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy mozgóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän liikkuvan kuvan teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre d’images animées matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió d’una obra d’imatge en moviment que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es un colaborador de un agregado que crea una expresión de una obra de imagen en movimiento que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een bewegend beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et verk med levende bilder som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et værk med levende billeder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of a moving image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto kustīgā attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues liikuvast pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines Bewegtbildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء عمل من صور متحركة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种动态图像作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30341 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30341">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice de musique</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di musica persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til musikk (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til musik</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of music</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger einer Musik (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van muziek</rdfs:label>
        <rdfs:label xml:lang="fi">musiikkiin osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="et">muusikaline kaastööline (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">müziğe katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">mūzikas līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora de la música</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora de música</rdfs:label>
        <rdfs:label xml:lang="hu">zene közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بموسيقى</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音乐的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir müzik eserinin yorumunu oluşturan bütünün bir parçası olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un&apos;opera musicale, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy zenemű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän musiikkiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre musicale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió d’una obra musical que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es colaborador de un agregado y que crea una expresión de una obra musical que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een muziekwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et musikalsk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et musikværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of a musical work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto mūzikas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues muusikateose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines Musikwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي بإنشاء عمل موسيقي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种音乐作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30342 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30342">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice de contenu vocal</rdfs:label>
        <rdfs:label xml:lang="hu">beszéd közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di discorso persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tale (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til tale</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of speech</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Rede (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van spraak</rdfs:label>
        <rdfs:label xml:lang="tr">konuşmaya katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">kõneloome kaastööline (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">puheeseen osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="lv">runas līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora del discurso</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora de discurs</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بحديث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有讲话的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir vokal eserin yorumunu yapan ve bütüne katkıda bulunan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un&apos;opera parlata, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy beszédmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre vocale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió d’una obra vocal que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es colaborador de un agregado que crea una expresión de una obra vocal que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een vocaal werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et verk av tale som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et værk med talte ord, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of a vocal work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto mutvārdu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues suulise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines gesprochenen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء عمل من كلمات منطوقة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种人声作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30343 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30343">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice d’image fixe</rdfs:label>
        <rdfs:label xml:lang="lv">attēla līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">durağan görüntüye katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagine fissa persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til bilde (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til stillbillede</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of still image</rdfs:label>
        <rdfs:label xml:lang="de">hat Illustratorin/Illustrator (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van stilstaand beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikumatu pildi alal (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">stillkuvaan osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora de la imagen fija</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora d’imatge fixa</rdfs:label>
        <rdfs:label xml:lang="hu">állókép közreműködője személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بصور ثابتة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有静态图像的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir hareketsiz görüntü çalışmasının görüntüsünün oluşturduğu bütüne katkıda bulunan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un&apos;opera di immagini fisse, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy állóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre d’image fixe matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió d’una obra d’imatge fixa que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que contribuye al agregado y que crea una expresión de una obra de imagen fija que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een stilstaand beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et bildeverk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et værk med stillbilleder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of a still image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues liikumatust pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines unbewegten Bildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء عمل من صور ثابتة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种静态图像作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30344 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30344">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice de texte</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di testo persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tekst (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til tekst</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of text</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von ergänzendem Text (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van tekst</rdfs:label>
        <rdfs:label xml:lang="tr">metne katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">szöveg közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">teksta līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">tekstiin osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="et">tekstiloome kaastööline (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora del texto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora de text</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بنص</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有文本的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan metinsel bir eserin metinsel bir ifadesini oluşturan ve bütüne katkıda bulunan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un&apos;opera testuale, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy szöveges mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre textuelle matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió d’una obra textual que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es un colaborador de un agregado que crea una expresión de una obra textual que está plasmada en un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een tekstwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et tekstlig verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et tekstværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of a textual work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto teksta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues tekstteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines textlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء عمل نصي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种文字作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30345 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30345">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice d’objet</rdfs:label>
        <rdfs:label xml:lang="fi">esineeseen osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di oggetto persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til gjenstand (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til objekt</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of object</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Gegenstand (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van object</rdfs:label>
        <rdfs:label xml:lang="tr">nesneye katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">objekta līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">objektiloome kaastööline (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona contribuyente de objeto</rdfs:label>
        <rdfs:label xml:lang="hu">tárgy közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora d’objecte</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بكائن</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有物体的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bir nesne çalışmasının anlatımını oluşturan bütünün bir katılımcısı olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona contributrice a un aggregato che crea un’opera oggetto, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy tárgyi mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän esineteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’une œuvre objet matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió d’una obra d’objecte que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es un colaborador de un agregado que crea una expresión de un objeto de obra que está encarnado por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van een objectwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper et verk som er en gjenstand som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber et værk med objekt, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of an object work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto objekta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues objektteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression eines gegenständlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء عمل شيء ما يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种物体作品的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30346 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30346">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne contributrice de contenu informatique</rdfs:label>
        <rdfs:label xml:lang="tr">bilgisayar içeriğine katkıda bulunan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">datororientēta satura līdzradītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">digisisu kaastööline (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">digitaaliseen sisältöön osallinen henkilö</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di contenuto informatico persona</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til datamaskininnhold (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bidragsyder til computerindhold</rdfs:label>
        <rdfs:label xml:lang="en">has contributor person of computer content</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von Computer Content (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-persoon van computercontent</rdfs:label>
        <rdfs:label xml:lang="hu">számítógépes tartalom közreműködő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colaboradora de contenidos informáticos</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona contribuïdora de contingut informàtic</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مساهم بمحتوى كمبيوتر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有计算机内容的贡献者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütün tarafından somutlaştırılan bilgisayar içeriğinin bir görünümünü oluşturan bütünün bir katılımcısı olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una nanifestazione alla persona contributrice a un aggregato che crea un contenuto informatico, materializzato in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy aggregátum közreműködőjeként egy számítógépes tartalom olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen henkilöön, joka on luonut aggregaattiin sisältyvän digitaalisen sisällön ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne contributrice à un agrégat qui crée une expression d’un contenu informatique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és un contribuïdor a un agregat i que crea una expressió de contingut informàtic que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que contribuye a un agregado y que crea una expresión de contenido informático que está plasmado en un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die een bijdrager aan aggregaat is die een expressie van computercontent creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er en bidragsyter til aggregat som skaper datamaskininnhold som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er bidragsyder til samling, som skaber computerindhold, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is a contributor to aggregate who creates an expression of computer content that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir līdzradītājs, kura radījusi apkopojumā ietverto datororientēto saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes on liitumi kaastööline, luues digisisu väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Person), die/der eine Expression von Computer Content erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مساهم في عمل تجميعي ينشيء محتوى كمبيوتر يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种计算机内容的一种内容表达的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30347 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30347">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne diffuseuse audiovisuelle</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente persona </rdfs:label>
        <rdfs:label xml:lang="no">har kringkaster (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er broadcaster</rdfs:label>
        <rdfs:label xml:lang="en">has broadcaster person</rdfs:label>
        <rdfs:label xml:lang="de">hat Senderin/Sender (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitzender-persoon</rdfs:label>
        <rdfs:label xml:lang="et">leviedastaja (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">lähetyksestä vastaava henkilö</rdfs:label>
        <rdfs:label xml:lang="hu">műsorszolgáltató személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">raidorganizācija (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona locutora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona de difusió</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مسئول بث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, radyo, televizyon, web yayını veya diğer iletim ortamları aracılığıyla bir izleyici kitlesine bir gösteriyi yayınlamaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella trasmissione di una manifestazione a un pubblico via radio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy megjelenési forma rádión, televízión, webközvetítésen, vagy egyéb adatátviteli médiumon keresztüli közönséghez történő műsorszórásáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation lähettämisestä yleisölle radiossa, televisiossa, suoratoistolähetyksenä tai muuna lähetysmediana.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la diffusion d’une manifestation à un public par la radio, la télévision, la webdiffusion ou d’autres moyens de transmission.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la difusió d’una manifestació a uns destinataris mitjançant la ràdio, la televisió, el web o un altre mitjà de transmissió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de transmitir una manifestación a una audiencia a través de radio, televisión, webcast u otros medios de transmisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het uitzenden van een manifestatie aan een publiek via radio, televisie, webcast of andere uitzendmedia.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i å kringkaste en manifestasjon til et publikum via radio, fjernsyn, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i transmissionen af en manifestation til et publikum via radio, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for broadcasting a manifestation to an audience via radio, television, webcast, or other transmission media.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas pārraidē, izmantojot radio, televīziju, tīmekļa apraidi u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes tegeleb kehastuse levitamisega avalikkusele raadio, televisiooni, veebi vms kaudu.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Ausstrahlung einer Manifestation über Hörfunk, Fernsehen oder Webcast oder andere Übertragungsmedien verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول بث تجسيدة لجمهور ما عبر الإذاعة، أو التلفزيون، أو البث عبر الانترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责通过广播、电视、网络广播或其他传输媒介向受众广播载体表现的个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30348 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30348">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne distributrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvan jakelija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">film dağıtımcısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas izplatītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">filmilevitaja (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">filmterjesztő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore cinematografico persona</rdfs:label>
        <rdfs:label xml:lang="no">har filmdistributør (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er filmdistributør</rdfs:label>
        <rdfs:label xml:lang="en">has film distributor person</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmvertrieb (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmdistributeur-persoon</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona distribuidora de películas</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona distribuïdora de pel·lícules</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص موزع أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影发行者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, hareketli görüntü gösteriminin tiyatrolara veya diğer dağıtım kanallarına dağıtımından sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella distribuzione di una manifestazione di immagini in movimento alle sale cinematografiche o ad altri canali di distribuzione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy mozgókép megjelenési formájának terjesztéséért felelős filmszínházak vagy más disztribúciós csatornák számára.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la distribution d’une manifestation d’images animées aux salles de cinéma ou aux autres réseaux de distribution.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la distribució d’una manifestació d’imatge en moviment a cinemes o a altres canals de distribució.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que se encarga de distribuir una manifestación de imágenes en movimiento a cines u otros canales de distribución.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor de distributie van een bewegend beeld-manifestatie naar theaters of andere distributiekanalen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i å distribuere en manifestasjon i form av levende bilder til kinoer eller andre distribusjonskanaler.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i distribueringen af en manifestation med levende billeder til biografer eller andre distributionskanaler.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for distributing a moving image manifestation to theatres or other distribution channels.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta filmas manifestācijas izplatīšanā kinoteātriem vai izmantojot citus izplatīšanas kanālus.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes tegeleb filmi kehastuse levitamisega kinodesse või muudesse levikanalitesse.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für den Vertrieb einer Bewegtbildmanifestation an Kinos oder andere Vertriebskanäle verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن توزيع تجسيدة من الصور المتحركة لقاعات العرض أو عبر قنوات توزيع أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责向剧院或其他发行渠道发行动态图像载体表现的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30349 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30349">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne maquettiste de livre</rdfs:label>
        <rdfs:label xml:lang="fi">graafinen suunnittelija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatas dizaina autors (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come grafico persona</rdfs:label>
        <rdfs:label xml:lang="no">har bokdesigner (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bogdesigner</rdfs:label>
        <rdfs:label xml:lang="en">has book designer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchgestalterin/Buchgestalter (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekontwerper-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">kitap tasarımcısı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvtervező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukujundaja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona diseñadora de libros</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona dissenyadora gràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مصمم كتاب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书设计者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yazı ve illüstrasyon düzenlemesi, malzeme seçimi ve kullanılan süreç de dahil olmak üzere bir kitabın tüm grafik tasarımından sorumlu olarak bir öğenin oluşturulmasından sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, come responsabile dell&apos;intero progetto grafico di un libro, compresi la disposizione dei caratteri tipografici e delle illustrazioni, la scelta dei materiali e il procedimento utilizzato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy felelős egy könyv teljes grafikai tervezéséért, beleértve a nyomdai betűtípus és az illusztrációk elrendezését, az anyagválasztást és az alkalmazott eljárást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta vastaamalla kirjan graafisesta suunnittelusta, taitosta, materiaalien valinnasta ja käytettävistä valmistusmenetelmistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une manifestation en étant responsable de toute la conception graphique d’un livre, y compris la composition typographique, l’arrangement des illustrations, le choix des matériaux et le procédé utilisé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una manifestació amb la responsabilitat de tot el disseny gràfic d’un llibre, inclosa la composició tipogràfica i la il·lustració, la tria dels materials i el procés utilitzat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de crear una manifestación al ser responsable de todo el diseño gráfico de un libro, incluida la disposición del tipo y la ilustración, la elección de los materiales y el proceso utilizado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het creëren van een manifestatie door verantwoordelijk te zijn voor het gehele grafische ontwerp van een boek, inclusief de indeling van het zetsel en illustratie, keuze van materialen en gebruikt procedé.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å ha ansvar for hele den grafiske utformingen av en bok, inkludert oppsett av skrifttype og illustrasjoner, valg av materialer og hvilke prosesser som brukes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at være ansvarlig for hele det grafiske design af en bog, inkl. opsætning af tekst og illustrationer, materialevalg og anvendt proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating a manifestation by being responsible for the entire graphic design of a book, including arrangement of type and illustration, choice of materials, and process used.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, atbildot par grāmatas grafisko dizainu, tajā skaitā par izkārtojuma veidu un ilustrācijām, materiālu izvēli un tehnoloģisko procesu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, vastutades raamatu graafilise kujunduse eest, sealhulgas trükiteksti ja illustratsioonide paigutuse, materjalide valiku ja valmistamismenetluste eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie für das gesamte grafische Design eines Buchs, einschließlich Schriftbild, Bildgestaltung, Materialwahl und angewandter Verfahren, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة بالتصميم الجرافيكي الكامل لكتاب، بما في ذلك توضيب حروف الطباعة، والإيضاحيات، واختيار المواد، والعمليات المستخدمة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过负责图书的整体图形设计（包括字体和插图的编排、材料的选取和工艺流程的使用等）对载体表现创建负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30350 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30350">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne graveuse</rdfs:label>
        <rdfs:label xml:lang="et">graveerija (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">gravieris (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">gravür sanatçısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come incisore persona </rdfs:label>
        <rdfs:label xml:lang="no">har gravør (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er gravør</rdfs:label>
        <rdfs:label xml:lang="en">has engraver person</rdfs:label>
        <rdfs:label xml:lang="de">hat Stecherin/Stecher (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft graveur-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">kaivertaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona grabadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona gravadora</rdfs:label>
        <rdfs:label xml:lang="hu">vésnök személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص نقاش</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕版者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, baskı için kullanılan ahşap veya metal bir plaka gibi bir yüzey üzerinde harfler, şekiller veya diğer işaretleri keserek bir öğe oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, tramite l&apos;intaglio di lettere, figure, etc. su di una superficie come una lastra di legno o metallo utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy betűket, ábrákat vagy egyéb jeleket vés nyomtatáshoz használatos fa- vagy fémlemezhez hasonló felületre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une manifestation en gravant des lettres, des figures ou d’autres marques sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una manifestació mitjançant la gravació de lletres, figures o altres marques sobre una superfície com ara una planxa de fusta o de metall usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de crear una manifestación cortando letras, figuras u otras marcas en una superficie como una placa de madera o metal utilizada para imprimir.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het creëren van een manifestatie middels het snijden van letters, figuren of andere markeringen, in een oppervlak zoals een houten of metalen plaat gebruikt bij het drukken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å skjære ut bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating a manifestation by cutting letters, figures, or other marks on a surface such as a wooden or metal plate used for printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, uz drukāšanai izmantojama materiāla (piemēram, uz koka vai metāla plāksnes) virsmas iegriežot burtus, zīmes u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, lõigates tähti, kujundeid jms trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Buchstaben, figürliche Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte schneidet, die zum Drucken benutzt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة برص الحروف، والأشكال، إلخ، على سطح مثل لوح خشبي أو معدني يستخدم للطباعة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过在用于印刷的木版或金属版的表面上雕刻字母、图像或其他记号负责载体表现的创建的个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30351 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30351">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="lv">Braila raksta iespiedējs (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">Braille-dombornyomó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fr">a pour personne productrice braille</rdfs:label>
        <rdfs:label xml:lang="tr">braille kabartmacısı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come goffratore braille persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er punktskriftspræger</rdfs:label>
        <rdfs:label xml:lang="no">har punktskriftpreger (person)</rdfs:label>
        <rdfs:label xml:lang="en">has braille embosser person</rdfs:label>
        <rdfs:label xml:lang="de">hat Brailleschriftprägerin/Brailleschriftpräger (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft brailleerder-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">pistekirjoituksen tekijä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">punktkirja kirjutaja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona impresora de braille</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona estampadora braille</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مجسد بطريقة برايل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有布莱叶盲文点字制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, kalem, özel kabartmalı yazıcı veya başka bir cihaz kullanarak braille hücrelerini kabartarak bir öğeyi üretmekten sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, tramite goffratura di celle braille, utilizzando uno stilo, una stampante speciale per goffratura, o altro dispositivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy domborítja a Braille-cellákat íróvessző, speciális domborítónyomtató vagy más készülék használatával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la fabrication d’une manifestation par l’embossage de cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la fabricació d’una manifestació amb el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de fabricar una manifestación estampando celdas braille usando un lápiz óptico, una impresora especial de estampación u otro dispositivo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het vervaardigen van een manifestatie middels het brailleren met gebruik van een stylus, een speciale stansmachine of ander hulpmiddel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å prege brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at præge punktskriftsceller vha. en stift, særlig prægeprinter eller andet apparatur.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for manufacturing a manifestation by embossing braille cells using a stylus, special embossing printer, or other device.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, iespiežot Braila raksta matricas, izmantojot irbuli, īpašu ciļņa iespieduma printeri vai citu ierīci.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, tehes punktkirjamärke spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation in Form von Braillezeichen verantwortlich ist, indem sie einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät zum Prägen verwendet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة بالطباعة بطريقة خلايا نقش برايل باستخدام قلم نقش، أو طابعة نقش خاصة، أو أي أداة أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文而对一种载体表现的生产负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30352 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30352">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne graveuse d’estampe</rdfs:label>
        <rdfs:label xml:lang="tr">baskı sanatçısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">graafika trükkija (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">gravīru meistars (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come preparatore di stampe persona </rdfs:label>
        <rdfs:label xml:lang="no">har grafiker (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er grafiker</rdfs:label>
        <rdfs:label xml:lang="en">has printmaker person</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckgrafikerin/Druckgrafiker (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft prentmaker-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">kuvalaatan valmistaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">nyomtatványkészítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona grabadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona gravadora d’estampes</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص طباع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印版制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, oyma veya planografik baskı yüzeyi yaparak bir gösterim oluşturmaktan sorumlu olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, tramite la preparazione di una superficie di stampa in rilievo, a intaglio o planografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy egy domború, mélynyomásos (intaglio) vagy síknyomásos felületet készít.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta valmistamalla kohokuvan, syväpainon tai laakapainon painopinnan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une manifestation en préparant un élément d’impression en relief, en creux ou planographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una manifestació fent una superfície d’impressió en relleu, gravada en profunditat o planogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que se encarga de crear una manifestación mediante la realización de una superficie de impresión en relieve, calcografía o planográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het creëren van een manifestatie middels het vervaardigen van een hoogdruk, diepdruk of vlakdruk oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å lage en overflate for relieff-, intaglio- eller plantrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at lave en relief-, dybtryks- eller fladtryksoverflade.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating a manifestation by making a relief, intaglio, or planographic printing surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, veidojot reljefa, dobspiedes vai gludspieduma drukāšanas virsmu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, tehes kõrgtrüki, sügavtrüki või lametrüki teel tõmmiseid.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie eine Hochdruck-, Tiefdruck- oder Flachdruckoberfläche erstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة بإعداد الأسطح المستخدمة في الطباعة من خلال سطح طباعة بارز، أو غائر، أو مستوي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作浮雕、凹版或平版印刷表面对一种载体表现的创建负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30353 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30353">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne fondeuse</rdfs:label>
        <rdfs:label xml:lang="tr">dökümcü ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fonditore persona </rdfs:label>
        <rdfs:label xml:lang="da">har person, som er støber</rdfs:label>
        <rdfs:label xml:lang="no">har støper (person)</rdfs:label>
        <rdfs:label xml:lang="en">has caster person</rdfs:label>
        <rdfs:label xml:lang="de">hat Formgießerin/Formgießer (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gieter-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">lējējs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona lanzadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona emmotlladora</rdfs:label>
        <rdfs:label xml:lang="fi">valaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">valaja (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">öntvénykészítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مسئول عن الصب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有铸造者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, sıvı veya erimiş bir maddeyi bir kalıba dökerek ve kalıbın şeklini almak üzere katılaşmaya bırakarak bir öğe oluşturmakla sorumlu olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, tramite il versamento di una sostanza liquida o fusa in uno stampo e lasciandola solidificare fino ad assumere la forma dello stampo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy folyékony vagy olvasztott anyagot önt egy öntőformába és hagyja, hogy az megszilárduljon és az öntőforma formáját felvegye.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta muovaamalla sulatettua tai nestemäistä ainetta muotin avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une manifestation en versant un liquide ou une substance fondue dans un moule et en laissant ce liquide ou cette substance se solidifier pour prendre la forme du moule.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una manifestació mitjançant l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que se encarga de crear una manifestación vertiendo un líquido o sustancia fundida en un molde y dejándolo solidificar para tomar la forma del molde.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het creëren van een manifestatie middels het gieten van een vloeistof of gesmolten substantie in een mal en die te laten stollen in de vorm van die mal.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å helle et flytende eller smeltet stoff i en støpeform og la det stivne i denne formen.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating a manifestation by pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, lejot veidnē šķidru vai izkausētu vielu un atstājot to sacietēt, lai tā iegūtu veidnes formu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, valades vedela või sulatatud materjali valuvormi, kus materjal tahkub, võttes valuvormi kuju.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie eine Flüssigkeit oder eine geschmolzenen Substanz in eine Form gießt, die in der Gießform verbleibt, bis sie ausgehärtet ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة بصب السائل أو المادة المذابة في القالب وتركه حتى يجف ليأخذ شكل القالب.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过将液体或融化的物质倒入模具中使其按模具固化成型而对一种载体表现的创建负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30354 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30354">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne lithographe</rdfs:label>
        <rdfs:label xml:lang="it">ha come litografo persona </rdfs:label>
        <rdfs:label xml:lang="no">har litograf (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er litograf</rdfs:label>
        <rdfs:label xml:lang="en">has lithographer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Lithografin/Lithograf (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft lithograaf-persoon</rdfs:label>
        <rdfs:label xml:lang="hu">kőnyomatkészítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="et">litograaf (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">litografi (henkilö)</rdfs:label>
        <rdfs:label xml:lang="lv">litogrāfs (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">taş baskı sanatçısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona litógrafa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona litògrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص طباع على الحجر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有平版制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, taş veya levhayı litografik baskı için hazırlayarak bir gösterim yaratmakla sorumlu olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, tramite la preparazione di una pietra o lastra per l&apos;impressione litografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy egy követ vagy lemezt készít elő litográfiai nyomtatáshoz, azaz kőnyomathoz.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta valmistamalla litografiassa käytetyn kivilaatan tai muun painolaatan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une manifestation en préparant une pierre ou une plaque pour l’impression lithographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una manifestació amb la preparació d’una pedra o una planxa per a la impressió litogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que se encarga de crear una manifestación preparando una piedra o plancha para impresión litográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het creëren van een manifestatie middels het voorbereiden van een steen of plaat voor lithografisch drukwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å klargjøre en stein eller plate for litografisk trykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at klargøre en sten eller plade til litografisk trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating a manifestation by preparing a stone or plate for lithographic printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, sagatavojot akmeni vai iespiedplati litogrāfiskai pavairošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, valmistades ette kivi või plaadi litograafiliste tõmmiste jaoks. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie einen Stein oder eine Platte für lithografischen Druck vorbereitet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة بإعداد الحجر أو اللوح للطباعة الحجرية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作用于平版印刷的石头或平版而对一种载体表现的创建负责的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A lithographer includes a graphic artist creating a design directly on the surface from which printing will be done.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A litográfus egy grafikusművész, aki közvetlenül azon a felületen készít tervet, amelyről a nyomtatás történik.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir taş baskı sanatçısı, baskının yapılacağı yüzey üzerinde doğrudan bir tasarım yaratan bir grafik sanatçısını da içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een lithograaf omvat een grafisch kunstenaar die een ontwerp maakt direct op het oppervlak waarvan gedrukt zal worden.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En litograf inkluderer en grafiker som skaper et design direkte på overflaten som trykkingen vil bli gjort.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Litograaf hõlmab ka graafikut, kes loob kujutise otse pinnale, millelt toimub trükkimine.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Litograf omfatter en grafiker, som skaber et design direkte på overfladen, hvorfra trykning vil blive udført.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Litogrāfs ir arī grafiķis, kas veido dizainu tieši uz virsmas, no kuras materiāls tiks drukāts.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un lithographe comprend un artiste graphique créant un dessin directement sur la surface à partir de laquelle l’impression sera effectuée.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un litografo comprende un artista grafico che crea un disegno direttamente sulla superficie da cui viene effettuata l&apos;impressione.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un litògraf inclou un artista gràfic que crea un disseny directament sobre la superfície a partir de la qual es farà la impressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un litógrafo incluye un artista gráfico que crea un diseño directamente sobre la superficie desde la cual se realizará la impresión.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل الطباع على فنان الجرافيك الذي يصمم بشكل مباشر على السطح الذي سيتم منه الطباعة مباشرة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">平版制作者包括直接在用于印刷的表面进行设计创作的平面美术家</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30355 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30355">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne clicheuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come preparatore di lastre persona </rdfs:label>
        <rdfs:label xml:lang="da">har person, som er plademager</rdfs:label>
        <rdfs:label xml:lang="no">har trykkplatemaker (person)</rdfs:label>
        <rdfs:label xml:lang="en">has platemaker person</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckformherstellerin/Druckformhersteller (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft platenmaker-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">levhacı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomólemez-készítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painolaatan valmistaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="lv">presformas izgatavotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona fabricante de planchas</rdfs:label>
        <rdfs:label xml:lang="et">trükiplaadi valmistaja (isik)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona gravadora de planxes</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مصمم لوحات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制版者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir öğedeki basılı görsellerin veya metnin yapımında kullanılan levhaların hazırlanmasından sorumlu olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, tramite la preparazione di lastre utilizzate nella produzione di immagini o testo stampati.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy nyomtatott képek vagy szövegek előállításánál használt lemezeket készít elő.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta valmistamalla painettujen kuvien tai tekstin valmistuksessa käytettäviä painolaattoja tai -levyjä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la préparation des planches utilisées dans la réalisation d’images ou de textes imprimés dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la preparació de les planxes usades en l’elaboració d’imatges o de text imprès en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que se encarga de preparar las planchas utilizadas en la elaboración de imágenes impresas o texto en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het prepareren van platen gebruikt in het maken van gedrukte beelden of tekst in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å klargjøre trykkplater som brukes ved produksjon av trykte bilder og/eller tekst.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at forberede plader, som anvendes til fremstilling af trykte billeder eller tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for preparing plates used in the making of printed images or text in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, sagatavojot plāksnes, ko izmanto iespiestu attēlu vai teksta izgatavošanā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, valmistades ette plaadid piltide või teksti trükkimiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Druckformen für die Produktion von gedruckten Bildern oder gedrucktem Text anfertigt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة بإعداد اللوحات المستخدمة في إنتاج الصور المطبوعة أو النص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责准备用于在一种载体表现中制作印刷图像和/或文字的平版的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30356 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30356">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne aquafortiste</rdfs:label>
        <rdfs:label xml:lang="fi">etsaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="it">ha come acquafortista persona </rdfs:label>
        <rdfs:label xml:lang="no">har etser (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er raderer</rdfs:label>
        <rdfs:label xml:lang="en">has etcher person</rdfs:label>
        <rdfs:label xml:lang="de">hat Radiererin/Radierer (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft etser-persoon</rdfs:label>
        <rdfs:label xml:lang="hu">karckészítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">ofortists (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">oymacı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">söövitaja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona grabadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona aiguafortista</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص حفار زنكوغراف (كليشيهات)</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有蚀刻者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, metali, camı veya baskı için kullanılan başka bir yüzeyi asit veya başka bir aşındırıcı maddeye maruz bırakarak bir öğe oluşturmaktan sorumlu olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, sottoponendo all&apos;acido o ad altra sostanza corrosiva, del metallo, vetro o altra superficie utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy nyomtatáshoz használt fém-, üveg- vagy valamilyen más felületet savnak vagy más maró anyagnak vet alá.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta etsaamalla metallia, lasia tms. pintaa hapon tai muun syövyttävän aineen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une manifestation en soumettant à l’acide ou à une autre substance corrosive du métal, du verre ou une autre surface utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una manifestació sotmetent a l’àcid, o a qualsevol altra substància corrosiva, el metall, el vidre o qualsevol altra superfície usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que se encarga de crear una manifestación sometiendo metal, vidrio o alguna otra superficie utilizada para imprimir, en ácido u otra sustancia corrosiva.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het creëren van een manifestatie middels het blootstellen van metaal, glas of een ander oppervlak gebruikt voor het drukproces, aan zuur of een ander bijtend middel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å utsette metall, glass eller et annet overflatemateriale som brukes til trykking, for syre eller et annet etsende stoff.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation ved at udsætte metal, glas eller en anden overflade, som anvendes til trykning, for syre eller andet ætsende stof.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating a manifestation by subjecting metal, glass, or some other surface used for printing, to acid or another corrosive substance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, pakļaujot metāla, stikla vai kādu citu drukāšanai paredzētu virsmu skābei vai citai kodīgai vielai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, töödeldes happe või muu söövitava ainega trükkimiseks kasutatavat metallist, klaasist või muust materjalist pinda.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Metall, Glas oder eine andere Oberfläche, die zum Drucken benutzt wird, mit Säure oder einer anderen ätzenden Substanz behandelt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة لإخضاع المعدن، أو الزجاج، أو أي سطح آخر يستخدم في الطباعة، بالحمض أو أي مادة أخرى كاوية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过使用酸或其他腐蚀性物质施于用来印刷的金属、玻璃或其他表面上而对一种载体表现的创建负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30357 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30357">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne phototypeuse</rdfs:label>
        <rdfs:label xml:lang="lv">fotogravieris (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">fénynyomatkészítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come collotipista persona</rdfs:label>
        <rdfs:label xml:lang="no">har lystrykker (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er lystrykker</rdfs:label>
        <rdfs:label xml:lang="en">has collotyper person</rdfs:label>
        <rdfs:label xml:lang="de">hat Lichtdruckerin/Lichtdrucker (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft collotype-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">kollotypian valmistaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">kollotüübi valmistaja (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">kolotip baskıcı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona colotipadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona fototipista</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص طباع صور</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有珂罗版制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskılar yapmak için kullanılan sertleştirilmiş bir jelatin veya diğer kolloid filmi hazırlayarak bir gösterim yaratmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione, utilizzando un processo fotomeccanico per realizzare stampe direttamente da un film indurito di gelatina o altro colloide che ha superfici ricettive o repellenti all&apos;inchiostro.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy megjelenési forma gyártásáért oly módon, hogy fotómechanikai eljárás alkalmazásával nyomtatványokat állít elő közvetlenül olyan zselatin vagy más kolloid megkeményedett filmjéből, amelynek tintafelvevő és tintataszító felülete van.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaation valmistamisesta tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la création d’une manifestation en préparant un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la creació d’una manifestació mitjançant la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta que s’usa per fer gravats usant un procés fotomecànic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de crear una manifestación preparando una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que se utiliza para realizar impresiones mediante un proceso fotomecánico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die is verantwoordelijk voor het creëren van een manifestatie middels het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon ved å bruke en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation vha. en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for creating a manifestation by preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta manifestācijas ražošanā, izmantojot fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb kehastuse valmistamises, tehes fotomehaanilises protsessis tõmmiseid otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation verantwortlich ist, indem sie ein fotomechanisches Verfahren zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid verwendet, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تصنيع تجسيدة باستخدام عمليات ضوئية ميكانيكية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التى تحتوي أسطح مستقبلة وطاردة للحبر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印对一种载体表现的创建负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30358 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30358">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne imprimeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come stampatore persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er trykker</rdfs:label>
        <rdfs:label xml:lang="no">har trykker (person)</rdfs:label>
        <rdfs:label xml:lang="en">has printer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckerin/Drucker (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft drukker-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">iespiedējs (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">matbaacı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomdász személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona impresora</rdfs:label>
        <rdfs:label xml:lang="et">trükkija (isik)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona impressora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص طابع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印刷者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, basılı metin, notalı müzik veya plakalardan diğer içeriklerin bir gösterimi üretmekten sorumlu bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona coinvolta nella manifattura di una manifestazione di testo a stampa, musica notata, etc., da tipi o lastre, come un libro, un giornale, una rivista, un foglio sciolto, una partitura, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy nyomtatott szöveg, kottázott zene vagy egyéb tartalom megjelenési formájának nyomdai szedésből vagy lemezekből történő gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa painetun tekstin, nuottiaineiston tai muun sisällön manifestaation valmistamisesta painolaatalta tai -levyltä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la fabrication d’une manifestation imprimée matérialisant du texte, de la musique notée, un contenu cartographique, du mouvement noté ou un contenu visuel fixe à l’aide d’un dispositif qui transfère de l’encre ou un médium semblable sur une surface.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la fabricació d’una manifestació impresa que materialitza text, música notada, imatge cartogràfica, moviment notat o contingut d’imatge fixa usant un mecanisme que transfereix tinta o un mitjà similar a una superfície.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de fabricar una manifestación impresa que materializa texto, música notada, imagen cartográfica, movimiento notado o contenido de imagen fija utilizando un dispositivo que transfiere tinta o un medio similar a una superficie.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het vervaardigen van een gedrukte manifestatie die omvat tekst, bladmuziek, cartografische content, bewegingsnotatie, of stilstaand beeld-content met gebruik van een apparaat that inkt of een soortgelijk medium overbrengt op een oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er involvert i framstillingen av en manifestasjon av trykt tekst, nedskrevet musikk, etc., ved hjelp av typer eller plater, f.eks. en bok, en avis, et tidsskrift, en løpeseddel eller et partitur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er involveret i fremstillingen af en manifestation af trykt tekst, noteret musik etc. fra typer eller plader, såsom en bog, en avis, et magasin, et tværformat, et partitur etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for manufacturing a printed manifestation that embodies text, notated music, cartographic image, notated movement, or still image content using a device that transfers ink or a similar medium to a surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura iesaistīta iespiesta teksta, nošu u.tml. manifestāciju ražošanā no burtu salikuma vai plāksnēm.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes osaleb trükise, noodi vms kehastuse valmistamises, trükkides trükilaolt või -plaadilt raamatuid, ajalehti, ajakirju, plakateid, partituure jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Herstellung einer Manifestation von gedrucktem Text, Noten oder anderem Inhalt durch Drucktypen oder Druckformen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن صناعة تجسيدة لنص مطبوع، أو موسيقى مدونة، إلخ، من صفحة أو لوحة، مثل كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقيه، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责生产用活字或平版印刷文字、乐谱或其他内容的一种载体表现的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend la fabrication d’un livre, d’un journal, d’un magazine, d’un placard ou d’une partition.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Herstellung eines Buchs, einer Zeitung, eines Magazins, eines Einblattdrucks oder einer Partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Idetartozik egy könyv, hírlap, magazin, egyoldalas nyomtatvány vagy partitúra gyártója.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver grāmatas, laikraksta, žurnāla, plakāta, vai partitūras ražošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la fabricació d’un llibre, un diari, un magazín, un full solt o una partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes the manufacture of a book, newspaper, magazine, broadside, or score.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye la fabricación de un libro, periódico, revista, andanada o partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter produktion af en bog, avis, tidsskrift, tværformat eller partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat de vervaardiging van een boek, krant, tijdschrift, pamfletvel of partituur.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Sisältää kirjan, sanomalehden, aikakauslehden, julisteen tai partituurin valmistuksen.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">matbaacı kişisi ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">ويشمل صناعة كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括图书、报纸、杂志、大张印刷品或总谱的生产</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30359 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30359">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne diffuseuse ou distributrice</rdfs:label>
        <rdfs:label xml:lang="tr">dağıtımcı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore persona</rdfs:label>
        <rdfs:label xml:lang="no">har distributør (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er distributør</rdfs:label>
        <rdfs:label xml:lang="en">has distributor person</rdfs:label>
        <rdfs:label xml:lang="de">hat Vertrieb (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft distributeur-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">izplatītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">jakelija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">levitaja (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">terjesztő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona distribuidora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona distribuïdora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص موزع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发行者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanmış bir gösterimi dağıtmaktan sorumlu olan kişiylr ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona responsabile della distribuzione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy kiadott megjelenési forma megalkotásáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa julkaistun manifestaation jakelusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la diffusion ou de la distribution d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la distribució d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de distribuir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het distribueren van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er ansvarlig for å distribuere en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er ansvarlig for at distribuere en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for distributing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir atbildīga par manifestācijas izplatīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes vastutab kehastuse levitamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für den Vertrieb einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن توزيع تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责发行一种出版载体表现的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30360 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30360">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne productrice d’une manifestation non publiée</rdfs:label>
        <rdfs:label xml:lang="et">avaldamata kehastuse tootja (isik)</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di manifestazione non pubblicata persona </rdfs:label>
        <rdfs:label xml:lang="da">har person, som er producer af upubliceret manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har produsent av upublisert manifestasjon (person)</rdfs:label>
        <rdfs:label xml:lang="en">has producer person of unpublished manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Erzeugerin/Erzeuger einer unveröffentlichten Manifestation (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-persoon van ongepubliceerde manifestatie</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisemattoman manifestaation tuottaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadatlan megjelenési forma előállító személye:</rdfs:label>
        <rdfs:label xml:lang="lv">nepublicētas manifestācijas izgatavotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona productora de manifestación inédita</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona productora d’una manifestació no publicada</rdfs:label>
        <rdfs:label xml:lang="tr">yayınlanmamış gösterimin yapımcı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منتج لتجسيدة غير منشورة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有非出版载体表现的制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi yazmaktan, oluşturmaktan, inşa etmekten veya yayınlanmamış bir gösterimi üretmenin başka bir yönteminden sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona responsabile della iscrizione, fabbricazione, costruzione, etc. di una manifestazione non pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy kiadatlan megjelenési forma írásáért, összeállításáért, készítéséért vagy egyéb módú előállításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa julkaisemattoman manifestaation kaiverruksesta, valmistuksesta, kokoonpanosta tms.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la scription, de la fabrication, de la construction ou de toute autre méthode de production d’une manifestation non publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la inscripció, la fabricació, la construcció o un altre mètode de producció d’una manifestació no publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de inscribir, fabricar, construir u otro método de producir una manifestación inédita.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het afschrijven, fabriceren, construeren of andere methode van het produceren van een ongepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er ansvarlig for å inskribere, fabrikere, konstruere etc. en upublisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er ansvarlig for indskrift, fremstilling, konstruktion etc. af en upubliceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for inscribing, fabricating, constructing, or other method of producing an unpublished manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir atbildīga par nepublicētās manifestācijas pierakstīšanu, izgatavošanu, radīšanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes vastutab avaldamata kehastuse inskribeerimise, tootmise, ehitamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für das Gravieren, Fabrizieren, Konstruieren oder eine andere Entstehungsmethode einer unveröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن تسجيل، أو تصنيع، أو إنشاء، إلخ. تجسيدة غير منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责镌刻、制造、构建或其他方法制作一种非出版载体表现的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30361 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30361">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne fabricante</rdfs:label>
        <rdfs:label xml:lang="hu">gyártó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come manifattura persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er producent</rdfs:label>
        <rdfs:label xml:lang="no">har tilvirker (person)</rdfs:label>
        <rdfs:label xml:lang="en">has manufacturer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Herstellerin/Hersteller (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft vervaardiger-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">ražotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona fabricante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona fabricant</rdfs:label>
        <rdfs:label xml:lang="fi">valmistaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">valmistaja (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">üretici kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص صانع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有生产者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi basımdan, çoğaltmadan, rol dağıtımından veya başka bir yöntemle yayınlanmış bir gösteriminden sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona responsabile della stampa, riproduzione, fusione, etc. di una manifestazione pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy kiadott megjelenési forma nyomtatásáért, sokszorosításáért, öntéséért vagy egyéb módú gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilö, joka on vastuussa julkaistun manifestaation painamisesta, monistamisesta, kirjasinten valamisesta tai muusta valmistustavasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de l’impression, de la reproduction, du moulage ou de toute autre méthode de fabrication d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la impressió, la reproducció, el modelat o un altre mètode de fabricació d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona responsable de imprimir, duplicar, moldear u otro método de fabricación de una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het drukken, vermeerderen, gieten of andere methode van het vervaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er ansvarlig for å trykke, mangfoldiggjøre, kaste, etc. en publisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er ansvarlig for trykning, duplikering, støbning etc. af en publiceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for printing, duplicating, casting, or other method of manufacturing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir atbildīga par resursa publicējamās formas drukāšanu, pavairošanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes vastutab avaldatud kehastuse trükkimise, paljundamise, valamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für den Druck, die Vervielfältigung, den Guss oder eine andere Herstellungsmethode einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن طباعة، أو نسخ، أو صب، إلخ. تجسيدة منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责印刷、复制、铸造或其他方法生产一种出版载体表现的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30362 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30362">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne éditrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come editore persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er udgiver</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (person)</rdfs:label>
        <rdfs:label xml:lang="en">has publisher person</rdfs:label>
        <rdfs:label xml:lang="de">hat Verlag (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitgever-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">izdevējs (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="et">kirjastaja (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">kustantaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona editora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona editora</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص ناشر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有出版者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanan bir gösterimi yayınlamaktan, piyasaya sunmaktan veya yayımlamaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona responsabile della pubblicazione, diffusione o emissione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy kiadott megjelenési forma kiadásáért, kibocsájtásáért vagy megjelentetéséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa julkaistun manifestaation kustantamisesta, julkaisemisesta tai ilmestymisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la publication, de la mise à disposition ou de l’édition d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la publicació, la posada en circulació o l’emissió d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de publicar, divulgar o emitir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het uitgeven, uitbrengen of uitvaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er ansvarlig for å publisere, tilgjengeliggjøre eller utgi en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er ansvarlig for at publicere, frigive eller udgive en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for publishing, releasing, or issuing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir atbildīga par resursa izdošanu, publicēšanu vai izlaišanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes vastutab kehastuse avaldamise, väljalaskmise või väljaandmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für das Veröffentlichen, die Freigabe oder die Herausgabe einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن نشر، أو إصدار تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责出版、发布或发行一种出版载体表现的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30363 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30363">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne créatrice d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yaratıcısı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore di manifestazione persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er ophav til manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av manifestasjon (person)</rdfs:label>
        <rdfs:label xml:lang="en">has creator person of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Mitwirkende/Mitwirkenden an einer Manifestation (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-persoon van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse teostaja (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation tekijä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas radītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma létrehozó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona creadora de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona creadora d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منشيء لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的创建者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir veya daha fazla anlatımın somutlaştırılmasından sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona responsabile della materializzazione di una o più espressioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki felelős egy vagy több kifejezési forma megtestesüléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa yhden tai useamman ekspression ilmiasusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la matérialisation d’une ou plusieurs expressions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de la materialització d’una o més expressions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de la encarnación de una o más expresiones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor de verwezenlijking van één of meer expressies.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er ansvarlig for realiseringen av ett eller flere uttrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er ansvarlig for realiseringen af et eller flere udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for the embodiment of one or more expressions.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir atbildīga par vienas vai vairāku izteiksmju ietveršanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes vastutab ühe või mitme väljenduse teostamise eest kehastusena.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Verkörperung einer Expression oder mehrerer Expressionen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن عملية تجسيد تعبيرة أو أكثر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种或多种内容表达之具体化的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of manifestation includes a manufacturer, producer, and publisher.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Hersteller, Produzentinnen/Produzenten und Verlage.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van manifestatie omvat een vervaardiger, producent en uitgever.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy megjelenési forma létrehozója magában foglalja a gyártót, az előállítót és a kiadót.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En skaper av en manifestasjon inkluderer distributør, tilvirker, produsent og utgiver.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Gösterimin yaratıcısı, bir üretimci, yapımcı ve yayıncıyı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kehastuse teostaja hõlmab levitajat, valmistajat, tootjat ja kirjastajat.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Manifestaation tekijä sisältää jakelijan, valmistajan, tuottajan ja kustantajan.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Manifestācijas radītāji ir arī izplatītāji, ražotāji, izgatavotāji un izdevēji.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til manifestation omfatter distrubutør, producent, producer og udgiver ect.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de manifestación incluye un fabricante, un productor y un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una manifestació inclou un distribuïdor, un fabricant, un productor i un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di manifestazione comprende un distributore, manifattura, produttore e editore.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une manifestation comprend un fabricant, un producteur et un éditeur.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل منشئ التجسيدة على الموزع، والصانع، والمنتج، والناشر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">载体表现的创建者包括生产者、制作者和出版者</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30364 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30364">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour personne papetière</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di carta persona</rdfs:label>
        <rdfs:label xml:lang="no">har papirprodusent (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er papirproducent</rdfs:label>
        <rdfs:label xml:lang="en">has papermaker person</rdfs:label>
        <rdfs:label xml:lang="de">hat Papiermacherin/Papiermacher (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft papierproducent-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">kağıt üreticisi kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">paberivalmistaja (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">paperinvalmistaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">papírgyártó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">papīra izgatavotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona fabricante de papel</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona paperera</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص صانع ورق</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有造纸者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimde kullanılan kağıdın yapımından sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla persona responsabile della produzione della carta utilizzata per la manifattura di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy személyhez, aki egy megjelenési forma gyártásához használt papír előállításáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation henkilöön, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une personne qui est responsable de la confection du papier utilisé dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una persona que és responsable de l’elaboració del paper usat en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una persona que es responsable de la elaboración del papel utilizado en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een persoon die verantwoordelijk is voor het maken van papier gebruikt in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en person som er ansvarlig for produksjonen av papir brukt til å framstille en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en person, som er ansvarlig for fremstilling af papir, som anvendes til fremstilling af en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a person who is responsible for the making of paper used in a manifestation. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar personu, kura ir atbildīga par papīra izgatavošanu, kas izmantots ražošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse isikuga, kes vastutab kehastuse valmistamiseks kasutatud paberi tootmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Person, die für die Produktion von Papier verantwortlich ist, das zur Herstellung einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وشخص مسئول عن إنتاج الورق المستخدم في صناعة تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种载体表现中所使用的纸张之制造的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30365 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30365">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur à un agrégat</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattiin osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátum közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopojuma līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore a un aggregato agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til aggregat (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til samling</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent to aggregate</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor aan aggregaat</rdfs:label>
        <rdfs:label xml:lang="et">liitumi kaastööline (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo contribuyente para agregar</rdfs:label>
        <rdfs:label xml:lang="tr">toplamaya katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor a un agregat</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم في تجميعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir kollektif temsilci tarafından somutlaştırılan bir eserin anlatımını yaratmaktan sorumlu olan bir toplulukla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo creatore di un&apos;opera materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy mű olyan kifejezési formájának létrehozásáért felelős, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa aggregaattiin sisältyvän teoksen ekspression luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une expression d’une œuvre matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una expressió d’una obra que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que se encarga de crear una expresión de una obra que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een expressie van een werk die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som skaper et verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som skaber et værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating an expression of a work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas radījusi apkopojumā ietverto darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes loob teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung einer Expression eines Werks verantwortlich ist, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي ينشئ عمل يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责创建被一种合集具体化的一种作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30366 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30366">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif arpenteur</rdfs:label>
        <rdfs:label xml:lang="hu">földmérő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come topografo agente</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er landinspektør</rdfs:label>
        <rdfs:label xml:lang="no">har landmåler (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has surveyor collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Landvermesserin/Landvermesser (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landmeter-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">maamõõtja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">maanmittari (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo agrimensor</rdfs:label>
        <rdfs:label xml:lang="tr">topograf kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">topogrāfs (grupa)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu agrimensor</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساح</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有测绘者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir coğrafi alan için ölçümler veya boyutsal ilişkiler sağlayan, haritacılıkta katkıda bulunan bir aracı olan kolektif bir aracıyla bir gösterimi ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, cartografo di aggregato, che fornisce misurazioni o rapporti dimensionali per un&apos;area geografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy kartográfia közreműködő ágenseként egy földrajzi területről méréseket vagy dimenziós összefüggéseket szolgáltat.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka kartografiaan osallisena toimijana tuottaa maantieteellisen alueen mitat tai mittasuhteet.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur de cartographie qui fournit des mesures ou des relations dimensionnelles pour une aire géographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un agent contribuïdor de cartografia i que proporciona mesuraments o relacions dimensionals d’una àrea geogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un agente colaborador de cartografía que proporciona medidas o relaciones dimensionales para un área geográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager-actor van cartografie die metingen of dimensionele verhoudingen verschaft voor een geografisch gebied.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en kartograf til aggregat som tilfører målinger eller størrelsesforhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er kartograf til samling, som angiver målinger eller dimensionelle forhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor agent of cartography who provides measurements or dimensional relationships for a geographic area.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir apkopojuma kartogrāfs un nodrošina ģeogrāfiskā apgabala mērījumus vai dimensiju attiecības.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes liitumi kartograafina hangib geograafilise piirkonna mõõdud või mõõdusuhted. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger einer Kartografie (Gemeinschaftlicher Akteur), die/der Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن رسم الخرائط في عمل تجميعي يقدم علاقات القياسات أو الأبعاد لمنطقة جغرافية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为地图绘制的贡献者行为者并为一个地理区域提供测量或尺寸关系的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30367 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30367">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur de cartographie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di cartografia agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til kartografi (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til kartografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of cartography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Kartografie (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van cartografie</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline kartograafia alal (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">kartografiaan osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="tr">kartografiye katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kartogrāfijas līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de cartografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor de cartografia</rdfs:label>
        <rdfs:label xml:lang="hu">térképészet közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم برسم خرائط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地图绘制贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütünün somutlaştırdığı bir kartografik çalışmanın bir ifadesini yaratan, bütüne katkıda bulunan kolektif temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un&apos;opera cartografica materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy kartográfiai mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän kartografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre cartographique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat i que crea una obra cartogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es colaborador de un agregado que crea una expresión de una obra cartográfica que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een cartografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et kartografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et kartografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of a cartographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto kartogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues kartograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines kartografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي يساهم في عمل تجميعي ينشيء عمل خرائطي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种地图作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30368 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30368">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur de chorégraphie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di coreografia agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til koreografi (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til koreografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of choreography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Choreografie (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van choreografie</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfijas līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline koreograafia alal (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">koreografiaan osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="tr">koreografiye katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfia közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de coreografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor de coreografia</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بتصميم رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluk tarafından somutlaştırılan bir koreografik eserin anlatımını yaratan, topluluğa katkıda bulunan kolektif temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un&apos;opera coreografica, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként oegy koreografikus mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän koreografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre chorégraphique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat i que crea una expressió d’una obra coreogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador del agregado que crea una expresión de una obra coreográfica que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een choreografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et koreografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et koreografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of a choreographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto horeogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues koreograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines choreografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي ينشيء عمل من تصميم الرقصات يتجسيد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种编舞作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30369 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30369">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur d’images animées</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagine in movimento agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til levende bilder (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til levende billede</rdfs:label>
        <rdfs:label xml:lang="tr">hareketli görüntüye katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of moving image</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Bewegtbild (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van bewegend beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikuva pildi alal (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">kustīga attēla līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">liikkuvaan kuvaan osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="hu">mozgókép közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de imagen en movimiento</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor d’imatge en moviment</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بصور متحركة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有动态图像的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı hareketli bir görüntü eserinin anlatımını yaratan, bütüne katkıda bulunan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un&apos;opera di immagini in movimento, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy mozgóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän liikkuvan kuvan teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre d’images animées matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat i que crea una expressió d’una obra d’imatge en moviment que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador al agregado que crea una expresión de una obra de imagen en movimiento que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een bewegend beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et verk med levende bilder som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et værk med levende billeder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of a moving image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto kustīgā attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues liikuvast pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines Bewegtbildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي ينشيء عمل من صور متحركة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种动态图像作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30370 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30370">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur de musique</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di musica agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til musikk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til musik</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of music</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger einer Musik (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van muziek</rdfs:label>
        <rdfs:label xml:lang="fi">musiikkiin osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="et">muusikaline kaastööline (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="tr">müziği katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">mūzikas līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de música</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor de música</rdfs:label>
        <rdfs:label xml:lang="hu">zene közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بموسيقى</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音乐的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluk tarafından somutlaştırılan bir müzik eserinin anlatımını yaratan, topluluğa katkıda bulunan kolektif temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un&apos;opera musicale, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy zenemű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän musiikkiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre musicale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat i que crea una expressió d’una obra musical que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador al agregado que crea una expresión de una obra musical que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een muziekwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et musikalsk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et musikværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of a musical work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto mūzikas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues muusikateose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines Musikwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي بإنشاء عمل موسيقي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种音乐作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30371 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30371">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur de contenu vocal</rdfs:label>
        <rdfs:label xml:lang="hu">beszéd közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di discorso agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tale (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til tale</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of speech</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Rede (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van spraak</rdfs:label>
        <rdfs:label xml:lang="tr">konuşmaya katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">kõneloome kaastööline (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">puheeseen osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="lv">runas līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador del discurso</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor de discurs</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بحديث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有讲话的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir bütünün somutlaştırdığı bir ses eserinin anlatımını yaratan, bütüne katkıda bulunan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un&apos;opera parlata, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy beszédmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimjaan, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre vocale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat i que crea una expressió d’una obra vocal que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador al agregado que crea una expresión de una obra vocal que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een vocaal werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et verk av tale som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et værk med talte ord, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of a vocal work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto mutvārdu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues suulise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines gesprochenen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي ينشيء عمل من كلمات منطوقة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种人声作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30372 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30372">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur d’image fixe</rdfs:label>
        <rdfs:label xml:lang="lv">attēla līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">durağan görüntüye katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagine fissa agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til bilde (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til stillbillede</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of still image</rdfs:label>
        <rdfs:label xml:lang="de">hat Illustratorin/Illustrator (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van stilstaand beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikumatu pildi alal (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">stillkuvaan osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de imagen fija</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor d’imatge fixa</rdfs:label>
        <rdfs:label xml:lang="hu">állókép közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بصور ثابتة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有静态图像的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı bir hareketsiz görüntü eserinin anlatımını yaratan, bütüne katkıda bulunan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un&apos;opera di immagine fissa, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy állóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre d’image fixe matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat i que crea una expressió d’una obra d’imatge fixa que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador al agregado y que crea una expresión de una obra de imagen fija que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een stilstaand beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et bildeverk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et værk med stillbilleder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of a still image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues liikumatust pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines unbewegten Bildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي ينشيء عمل من صور ثابتة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种静态图像作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30373 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30373">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur de texte</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di testo agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tekst (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til tekst</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of text</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von ergänzendem Text (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van tekst</rdfs:label>
        <rdfs:label xml:lang="tr">metne katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">szöveg közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">teksta līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">tekstiin osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="et">tekstiloome kaastööline (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de texto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor de text</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بنص</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有文本的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı metinsel bir eserin anlatımını yaratan, topluluğa katkıda bulunan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un&apos;opera testuale, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy szöveges mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre textuelle matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat i que crea una obra textual que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador al agregado que crea una expresión de una obra textual que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een tekstwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et tekstlig verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et tekstværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of a textual work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto teksta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues tekstteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines textlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي ينشيء عمل نصي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种文字作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30374 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30374">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur d’objet</rdfs:label>
        <rdfs:label xml:lang="fi">esineeseen osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di oggetto agente collettivo  </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til gjenstand (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til objekt</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of object</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Gegenstand (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van object</rdfs:label>
        <rdfs:label xml:lang="tr">nesneye katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">objekta līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">objektiloome kaastööline (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de objeto</rdfs:label>
        <rdfs:label xml:lang="hu">tárgy közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor d’objecte</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بكائن</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有物体的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı bir obje eserinin anlatımını yaratan, topluluğa katkıda bulunan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un’opera oggetto, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy tárgyi mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän esineteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’une œuvre objet matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat que crea expressió d’una obra d’objecte que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador al agregado que crea una expresión de un objeto de obra que está encarnado por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van een objectwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper et verk som er en gjenstand som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber et værk med objekt, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of an object work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto objekta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues objektteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression eines gegenständlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي ينشيء عمل شيء ما يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种物体作品的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30375 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30375">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif contributeur de contenu informatique</rdfs:label>
        <rdfs:label xml:lang="tr">bilgisayar içeriğine katkıda bulunan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">datororientēta satura līdzradītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">digisisu kaastööline (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">digitaaliseen sisältöön osallinen yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di contenuto informatico agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til datamaskininnhold (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bidragsyder til computerindhold</rdfs:label>
        <rdfs:label xml:lang="en">has contributor collective agent of computer content</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von Computer Content (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-collectieve actor van computercontent</rdfs:label>
        <rdfs:label xml:lang="hu">számítógépes tartalom közreműködő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colaborador de contenidos informáticos</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu contribuïdor de contingut informàtic</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مساهم بمحتوى كمبيوتر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有计算机内容的贡献者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluk tarafından somutlaştırılan bilgisayar içeriğinin bir anlatımını yaratan, topluluğa katkıda bulunan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo, contributore a un aggregato, che crea un contenuto informatico, materializzato in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Egy megjelenési formát hozzákapcsol egy kollektív ágenshez, amely aggregátor közreműködőként egy számítógépes tartalom olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteistoimijaan, joka on luonut aggregaattiin sisältyvän digitaalisen sisällön ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif contributeur à un agrégat qui crée une expression d’un contenu informatique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és un contribuïdor a un agregat que crea una expressió de contingut informàtic que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es un colaborador al agregado y crea una expresión de contenido informático que está encarnado por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die is een bijdrager aan aggregaat die een expressie van computercontent creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er en bidragsyter til aggregat som skaper datamaskininnhold som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er bidragsyder til samling, som skaber computerindhold, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is a contributor to aggregate who creates an expression of computer content that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir līdzradītājs, kas radījusi apkopojumā ietverto datororientēto saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes on liitumi kaastööline, luues digisisu väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Gemeinschaftlicher Akteur), die/der eine Expression von Computer Content erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مساهم في عمل تجميعي ينشيء محتوى كمبيوتر يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种计算机内容的一种内容表达的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30376 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30376">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif diffuseur audiovisuel</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er broadcaster</rdfs:label>
        <rdfs:label xml:lang="no">har kringkaster (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has broadcaster collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Senderin/Sender (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitzender-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">leviedastaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">lähetyksestä vastaava yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="hu">műsorszolgáltató kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">raidorganizācija (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo de emisoras</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu de difusió</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مسئول بث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi radyo, televizyon, web yayını veya diğer iletim ortamları yoluyla bir izleyici kitlesine yayınlamaktan sorumlu kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella trasmissione di una manifestazione a un pubblico via radio, televisione, web, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy megjelenési forma rádión, televízión, webközvetítésen, vagy egyéb adatátviteli médiumon keresztüli közönséghez történő műsorszórásáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation lähettämisestä yleisölle radiossa, televisiossa, suoratoistolähetyksenä tai muuna lähestysmediana.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la diffusion d’une manifestation à un public par la radio, la télévision, la webdiffusion ou d’autres moyens de transmission.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la difusió d’una manifestació a uns destinataris mitjançant la ràdio, la televisió, el web o un altre mitjà de transmissió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de transmitir una manifestación a una audiencia vía radio, televisión, webcast u otros medios de transmisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het uitzenden van een manifestatie aan een publiek via radio, televisie, webcast of andere uitzendmedia.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i å kringkaste en manifestasjon til et publikum via radio, fjernsyn, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i transmissionen af en manifestation til et publikum via radio, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for broadcasting a manifestation to an audience via radio, television, webcast, or other transmission media.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas pārraidē, izmantojot radio, televīziju, tīmekļa apraidi u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes tegeleb kehastuse levitamisega avalikkusele raadio, televisiooni, veebi vms kaudu.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Ausstrahlung einer Manifestation über Hörfunk, Fernsehen oder Webcast oder andere Übertragungsmedien verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول بث تجسيدة لجمهور ما عبر الإذاعة، أو التلفزيون، أو البث عبر الانترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责通过广播、电视、网络广播或其他传输媒介向受众广播载体表现的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30377 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30377">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif distributeur de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvan jakelija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">film dağıtımcısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas izplatītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">filmilevitaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="hu">filmterjesztő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore cinematografico agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har filmdistributør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er filmdistributør</rdfs:label>
        <rdfs:label xml:lang="en">has film distributor collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmvertrieb (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmdistributeur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo distribuidor de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu distribuïdor de pel·lícules</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي موزع أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影发行者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, hareketli bir görüntü gösteriminin sinemalara veya diğer dağıtım kanallarına dağıtılmasından sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella distribuzione di una manifestazione di immagini in movimento alle sale cinematografiche o ad altri canali di distribuzione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy mozgókép megjelenési formájának terjesztéséért felelős filmszínházak vagy más disztribúciós csatornák számára.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la distribution d’une manifestation d’images animées aux salles de cinéma ou aux autres réseaux de distribution.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la distribució d’una manifestació d’imatge en moviment a cinemes o a altres canals de distribució.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de distribuir una manifestación de imágenes en movimiento a salas de cine u otros canales de distribución.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het distribueren van een bewegend beeld-manifestatie naar theaters of andere distributiekanalen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i å distribuere en manifestasjon i form av levende bilder til kinoer eller andre distribusjonskanaler.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i distribueringen af en manifestation med levende billeder til biografer eller andre distributionskanaler.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for distributing a moving image manifestation to theatres or other distribution channels.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta filmas manifestācijas izplatīšanā kinoteātriem vai izmantojot citus izplatīšanas kanālus.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes tegeleb filmi kehastuse levitamisega kinodesse või muudesse levikanalitesse.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für den Vertrieb einer Bewegtbildmanifestation an Kinos oder andere Vertriebskanäle verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن توزيع تجسيدة من الصور المتحركة لقاعات العرض أو عبر قنوات توزيع أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责向剧院或其他发行渠道发行动态图像载体表现的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30378 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30378">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif maquettiste de livre</rdfs:label>
        <rdfs:label xml:lang="fi">graafinen suunnittelija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatas dizaina autors (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come grafico agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har bokdesigner (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bogdesigner</rdfs:label>
        <rdfs:label xml:lang="en">has book designer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchgestalterin/Buchgestalter (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekontwerper-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">kitap tasarımcısı kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvtervező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukujundaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo diseñador de libros</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu dissenyador gràfic</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مصمم كتاب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书设计者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, tür ve çizim düzenlemesi, malzeme seçimi ve kullanılan süreç dahil olmak üzere bir kitabın tüm grafik tasarımından sorumlu olarak bir gösterim yaratmaktan sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione, come responsabile dell&apos;intero progetto grafico di un libro, compresi la disposizione dei caratteri tipografici e delle illustrazioni, la scelta dei materiali e il procedimento utilizzato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy felelős egy könyv teljes grafikai tervezéséért, beleértve a nyomdai betűtípus és az illusztrációk elrendezését, az anyagválasztást és az alkalmazott eljárást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta vastaamalla kirjan graafisesta suunnittelusta, taitosta, materiaalien valinnasta ja käytettävistä valmistusmenetelmistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une manifestation en étant responsable de toute la conception graphique d’un livre, y compris la composition typographique, l’arrangement des illustrations, le choix des matériaux et le procédé utilisé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una manifestació amb la responsabilitat de tot el disseny gràfic d’un llibre, inclosa la composició tipogràfica i la il·lustració, la tria dels materials i el procés utilitzat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de crear una manifestación al ser responsable de todo el diseño gráfico de un libro, incluida la disposición del tipo y la ilustración, la elección de los materiales y el proceso utilizado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een manifestatie door verantwoordelijk te zijn voor het gehele grafische ontwerp van een boek, inclusief de indeling van het zetsel en illustratie, keuze van materialen en gebruikt procedé.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å ha ansvar for hele den grafiske utformingen av en bok, inkludert oppsett av skrifttype og illustrasjoner, valg av materialer og hvilke prosesser som brukes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at være ansvarlig for hele det grafiske design af en bog, inkl. opsætning af tekst og illustrationer, materialevalg og anvendt proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating a manifestation by being responsible for the entire graphic design of a book, including arrangement of type and illustration, choice of materials, and process used.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, atbildot par grāmatas grafisko dizainu, tajā skaitā par izkārtojuma veidu un ilustrācijām, materiālu izvēli un tehnoloģisko procesu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, vastutades raamatu graafilise kujunduse eest, sealhulgas trükiteksti ja illustratsioonide paigutuse, materjalide valiku ja valmistamismenetluste eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er für das gesamte grafische Design eines Buchs, einschließlich Schriftbild, Bildgestaltung, Materialwahl und angewandter Verfahren, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة بالتصميم الجرافيكي الكامل لكتاب، بما في ذلك توضيب حروف الطباعة، والإيضاحيات، واختيار المواد، والعمليات المستخدمة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过负责图书的整体图形设计（包括字体和插图的编排、材料的选取和工艺流程的使用等）对载体表现创建负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30379 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30379">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif graveur</rdfs:label>
        <rdfs:label xml:lang="et">graveerija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">gravieris (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">gravür sanatçısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come incisore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har gravør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er gravør</rdfs:label>
        <rdfs:label xml:lang="en">has engraver collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Stecherin/Stecher (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft graveur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">kaivertaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo grabador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu gravador</rdfs:label>
        <rdfs:label xml:lang="hu">vésnök kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي نقاش</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕版者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, baskı için kullanılan ahşap veya metal bir plaka gibi bir yüzey üzerinde harfleri, şekilleri veya diğer işaretleri keserek bir gösterim yaratmaktan sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione tramite l’intaglio di lettere, figure, etc. su di una superficie come una lastra di legno o metallo utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy betűket, ábrákat vagy egyéb jeleket vés nyomtatáshoz használatos fa- vagy fémlemezhez hasonló felületre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une manifestation en gravant des lettres, des figures ou d’autres marques sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una manifestació mitjançant la gravació de lletres, figures o altres marques sobre una superfície com ara una planxa de fusta o de metall usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de crear una manifestación cortando letras, figuras u otras marcas en una superficie como una placa de madera o metal utilizada para imprimir.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een manifestatie middels het snijden van letters, figuren of andere markeringen, in een oppervlak zoals een houten of metalen plaat gebruikt bij het drukken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å skjære ut bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating a manifestation by cutting letters, figures, or other marks on a surface such as a wooden or metal plate used for printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, uz drukāšanai izmantojama materiāla (piemēram, uz koka vai metāla plāksnes) virsmas iegriežot burtus, zīmes u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, lõigates tähti, kujundeid jms trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er Buchstaben, figürliche Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte schneidet, die zum Drucken benutzt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة برص الحروف، والأشكال، إلخ، على سطح مثل لوح خشبي أو معدني يستخدم للطباعة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一个载体表现与通过在用于印刷的木版或金属版的表面上雕刻字母、图像或其他记号负责载体表现的创建的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30380 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30380">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="lv">Braila raksta iespiedējs (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">Braille-dombornyomó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fr">a pour agent collectif producteur braille</rdfs:label>
        <rdfs:label xml:lang="tr">braille kabartmacısı kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come goffratore braille agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er punktskriftspræger</rdfs:label>
        <rdfs:label xml:lang="no">har punktskriftpreger (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has braille embosser collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Brailleschriftprägerin/Brailleschriftpräger (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft brailleerder-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">pistekirjoituksen tekijä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">punktkirja kirjutaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo impresor de braille</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu estampador braille</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مجسد بطرية برايل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有布莱叶盲文点字制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir çizimi, bir ekran kalemi, özel kabartma yazıcısı veya başka bir cihaz kullanarak braille hücrelerini kabartma yaparak bir gösterimi üretmekten sorumlu kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione tramite goffratura di celle braille, utilizzando uno stilo, una stampante speciale per goffratura, o altro dispositivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy megjelenési forma gyártásáért felelős oly módon, hogy domborítja a Braille-cellákat íróvessző, speciális domborítónyomtató vagy más készülék használatával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la fabrication d’une manifestation par l’embossage de cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la fabricació d’una manifestació amb el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de fabricar una manifestación grabando celdas braille usando un lápiz, una impresora especial de estampado u otro dispositivo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het vervaardigen van een manifestatie middels het brailleren met gebruik van een stylus, een speciale stansmachine of ander hulpmiddel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å prege brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at præge punktskriftsceller vha. en stift, særlig prægeprinter eller andet apparatur.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for manufacturing a manifestation by embossing braille cells using a stylus, special embossing printer, or other device.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, iespiežot Braila raksta matricas, izmantojot irbuli, īpašu ciļņa iespieduma printeri vai citu ierīci.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, tehes punktkirjamärke spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation in Form von Braillezeichen verantwortlich ist, indem er einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät zum Prägen verwendet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة بالطباعة بطريقة خلايا نقش برايل باستخدام قلم نقش، أو طابعة نقش خاصة، أو أي أداة أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文而对一种载体表现的生产负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30381 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30381">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif graveur d’estampe</rdfs:label>
        <rdfs:label xml:lang="tr">baskı sanatçısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">graafika trükkija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">gravīru meistars (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come preparatore di stampe agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har grafiker (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er grafiker</rdfs:label>
        <rdfs:label xml:lang="en">has printmaker collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckgrafikerin/Druckgrafiker (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft prentmaker-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">kuvalaatan valmistaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">nyomtatványkészítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo impresor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu gravador d’estampes</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي طباع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印版制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir kabartma, oyma veya planografik baskı yüzeyi yaparak bir gösterim yaratmaktan sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione tramite la preparazione di una superficie di stampa in rilievo, a intaglio o planografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy egy domború, mélynyomásos (intaglio) vagy síknyomásos felületet készít.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta valmistamalla kohokuvan, syväpainon tai laakapainon painopinnan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une manifestation en préparant un élément d’impression en relief, en creux ou planographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una manifestació fent una superfície d’impressió en relleu, gravada en profunditat o planogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de crear una manifestación mediante la realización de una superficie de impresión en relieve, calcografía o planográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een manifestatie middels het vervaardigen van een hoogdruk, diepdruk of vlakdruk oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å lage en overflate for relieff-, intaglio- eller plantrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at lave en relief-, dybtryks- eller fladtryksoverflade.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating a manifestation by making a relief, intaglio, or planographic printing surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, veidojot reljefa, dobspiedes vai gludspieduma drukāšanas virsmu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, tehes kõrgtrüki, sügavtrüki või lametrüki teel tõmmiseid.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er eine Hochdruck-, Tiefdruck- oder Flachdruckoberfläche erstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة بإعداد الأسطح المستخدمة في الطباعة من خلال سطح طباعة بارز، أو غائر، أو مستوي</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作浮雕、凹版或平版印刷表面对一种载体表现的创建负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30382 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30382">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif fondeur</rdfs:label>
        <rdfs:label xml:lang="tr">dökümcü kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fonditore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er støber</rdfs:label>
        <rdfs:label xml:lang="no">har støper (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has caster collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Formgießerin/Formgießer (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gieter-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">lējējs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo lanzador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu emmotllador</rdfs:label>
        <rdfs:label xml:lang="et">valaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">valaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">öntvénykészítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مسئول عن الصب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有铸造者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, sıvı veya erimiş bir maddeyi bir kalıba dökerek ve kalıbın şeklini alması için katılaşmaya bırakarak bir gösterim yaratmaktan sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione tramite il versamento di una sostanza liquida o fusa in uno stampo e lasciandola solidificare fino ad assumere la forma dello stampo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy folyékony vagy olvasztott anyagot önt egy öntőformába és hagyja, hogy az megszilárduljon és az öntőforma formáját felvegye.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta muovaamalla sulatettua tai nestemäistä ainetta muotin avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une manifestation en versant un liquide ou une substance fondue dans un moule et en laissant ce liquide ou cette substance se solidifier pour prendre la forme du moule.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una manifestació mitjançant l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de crear una manifestación vertiendo un líquido o sustancia fundida en un molde y dejándolo solidificar para tomar la forma del molde.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een manifestatie middels het gieten van een vloeistof of gesmolten substantie in een mal en die te laten stollen in de vorm van die mal.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å helle et flytende eller smeltet stoff i en støpeform og la det stivne i denne formen.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating a manifestation by pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, lejot veidnē šķidru vai izkausētu vielu un atstājot to sacietēt, lai tā iegūtu veidnes formu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, valades vedela või sulatatud materjali valuvormi, kus materjal tahkub, võttes valuvormi kuju.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er eine Flüssigkeit oder eine geschmolzenen Substanz in eine Form gießt, die in der Gießform verbleibt, bis sie ausgehärtet ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة بصب السائل أو المادة المذابة في القالب وتركه حتى يجف ليأخذ شكل القالب.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过将液体或融化的物质倒入模具中使其按模具固化成型而对一种载体表现的创建负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30383 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30383">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif lithographe</rdfs:label>
        <rdfs:label xml:lang="it">ha come litografo agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er litograf</rdfs:label>
        <rdfs:label xml:lang="no">har litograf (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has lithographer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Lithografin/Lithograf (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft lithograaf-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="hu">kőnyomatkészítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">litograaf (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">litografi (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="lv">litogrāfs (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">taş baskı sanatçısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo litógrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu litògraf</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي طباع على الحجر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有平版制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, litografik baskı için bir taş veya levha hazırlayarak bir gösterim yaratmaktan sorumlu kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione, tramite la preparazione di una pietra o lastra per l&apos;impressione litografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy egy követ vagy lemezt készít elő litográfiai nyomtatáshoz, azaz kőnyomathoz.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta valmistamalla litografiassa käytetyn kivilaatan tai muun painolaatan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une manifestation en préparant une pierre ou une plaque pour l’impression lithographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una manifestació amb la preparació d’una pedra o una planxa per a la impressió litogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de crear una manifestación preparando una piedra o placa para impresión litográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een manifestatie middels het voorbereiden van een steen of plaat voor lithografisch drukwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å klargjøre en stein eller plate for litografisk trykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at klargøre en sten eller plade til litografisk trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating a manifestation by preparing a stone or plate for lithographic printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, sagatavojot akmeni vai iespiedplati litogrāfiskai pavairošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, valmistades ette kivi või plaadi litograafiliste tõmmiste jaoks. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er einen Stein oder eine Platte für lithografischen Druck vorbereitet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة بإعداد الحجر أو اللوح للطباعة الحجرية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作用于平版印刷的石头或平版而对一种载体表现的创建负责的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A lithographer includes a graphic artist creating a design directly on the surface from which printing will be done.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A litográfus egy grafikusművész, aki közvetlenül azon a felületen készít tervet, amelyről a nyomtatás történik.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir taş baskı sanatçısı, baskının yapılacağı yüzey üzerinde doğrudan bir tasarım yaratan bir grafik sanatçısı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een lithograaf omvat een grafisch kunstenaar die een ontwerp maakt direct op het oppervlak waarvan gedrukt zal worden.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En litograf inkluderer en grafiker som skaper et design direkte på overflaten som trykkingen vil bli gjort.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Litograaf hõlmab ka graafikut, kes loob kujutise otse pinnale, millelt toimub trükkimine.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Litograf omfatter en grafiker, som skaber et design direkte på overfladen, hvorfra trykning vil blive udført.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Litogrāfs ir arī grafiķis, kas veido dizainu tieši uz virsmas, no kuras materiāls tiks drukāts.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un lithographe comprend un artiste graphique créant un dessin directement sur la surface à partir de laquelle l’impression sera effectuée.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un litografo comprende un artista grafico che crea un disegno direttamente sulla superficie da cui viene effettuata l&apos;impressione.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un litògraf inclou un artista gràfic que crea un disseny directament sobre la superfície a partir de la qual es farà la impressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un litógrafo incluye un artista gráfico que crea un diseño directamente sobre la superficie desde la cual se realizará la impresión.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل الطباع على فنان الجرافيك الذي يصمم بشكل مباشر على السطح الذي سيتم منه الطباعة مباشرة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">平版制作者包括直接在用于印刷的表面进行设计创作的平面美术家</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30384 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30384">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif clicheur</rdfs:label>
        <rdfs:label xml:lang="it">ha come preparatore di lastre agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er plademager</rdfs:label>
        <rdfs:label xml:lang="no">har trykkplatemaker (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has platemaker collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckformherstellerin/Druckformhersteller (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft platenmaker-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">levhacı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomólemez-készítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painolaatan valmistaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="lv">presformas izgatavotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo fabricante de placas</rdfs:label>
        <rdfs:label xml:lang="et">trükiplaadi valmistaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu gravador de planxes</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مصمم لوحات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制版者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki basılı görüntülerin veya metnin yapımında kullanılan plakaları hazırlamaktan sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione, tramite la preparazione di lastre utilizzate nella produzione di immagini o testo stampati.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy nyomtatott képek vagy szövegek előállításánál használt lemezeket készít elő.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta valmistamalla painettujen kuvien tai tekstin valmistuksessa käytettäviä painolaattoja tai -levyjä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la préparation des planches utilisées dans la réalisation d’images ou de textes imprimés dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la preparació de les planxes usades en l’elaboració d’imatges impreses o de text imprès.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de preparar las placas utilizadas en la realización de imágenes impresas o texto en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het prepareren van platen gebruikt in het maken van gedrukte beelden of tekst in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å klargjøre trykkplater som brukes ved produksjon av trykte bilder og/eller tekst.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at forberede plader, som anvendes til fremstilling af trykte billeder eller tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for preparing plates used in the making of printed images or text in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, sagatavojot plāksnes, ko izmanto iespiestu attēlu vai teksta izgatavošanā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, valmistades ette plaadid piltide või teksti trükkimiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er Druckformen für die Produktion von gedruckten Bildern oder gedrucktem Text anfertigt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة بإعداد اللوحات المستخدمة في إنتاج الصور المطبوعة أو النص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责准备用于在一种载体表现中制作印刷图像或文字的印版的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30385 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30385">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif aquafortiste</rdfs:label>
        <rdfs:label xml:lang="fi">etsaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come acquafortista agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har etser (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er raderer</rdfs:label>
        <rdfs:label xml:lang="en">has etcher collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Radiererin/Radierer (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft etser-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="hu">karckészítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">ofortists (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">oymacı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">söövitaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo grabador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu aiguafortista</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي حفار زنكوغراف (كليشيهات)</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有蚀刻者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, metali, camı veya baskı için kullanılan diğer bazı yüzeyleri asit veya başka bir aşındırıcı maddeye tabi tutarak bir gösterim yaratmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione, sottoponendo all&apos;acido o ad altra sostanza corrosiva, del metallo, vetro o altra superficie utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy nyomtatáshoz használt fém-, üveg- vagy valamilyen más felületet savnak vagy más maró anyagnak vet alá.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta etsaamalla metallia, lasia tai muuta pintaa hapon tai muun syövyttävän aineen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une manifestation en soumettant à l’acide ou à une autre substance corrosive du métal, du verre ou une autre surface utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una manifestació sotmetent a l’àcid, o a qualsevol altra substància corrosiva, el metall, el vidre o qualsevol altra superfície usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de crear una manifestación sometiendo metal, vidrio o alguna otra superficie utilizada para imprimir, a ácido u otra sustancia corrosiva.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een manifestatie middels het blootstellen van metaal, glas of een ander oppervlak gebruikt voor het drukproces, aan zuur of een ander bijtend middel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å utsette metall, glass eller et annet overflatemateriale som brukes til trykking, for syre eller et annet etsende stoff.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation ved at udsætte metal, glas eller en anden overflade, som anvendes til trykning, for syre eller andet ætsende stof.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating a manifestation by subjecting metal, glass, or some other surface used for printing, to acid or another corrosive substance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, pakļaujot metāla, stikla vai kādu citu drukāšanai paredzētu virsmu skābei vai citai kodīgai vielai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, töödeldes happe või muu söövitava ainega trükkimiseks kasutatavat metallist, klaasist või muust materjalist pinda.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er Metall, Glas oder eine andere Oberfläche, die zum Drucken benutzt wird, mit Säure oder einer anderen ätzenden Substanz behandelt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة لإخضاع المعدن، أو الزجاج، أو أي سطح آخر يستخدم في الطباعة، بالحمض أو أي مادة أخرى كاوية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过使用酸或其他腐蚀性物质施于用来印刷的金属、玻璃或其他表面上而对一种载体表现的创建负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30386 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30386">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif phototypeur</rdfs:label>
        <rdfs:label xml:lang="lv">fotogravieris (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">fénynyomatkészítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come collotipista agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er lystrykker</rdfs:label>
        <rdfs:label xml:lang="no">har lystrykker (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has collotyper collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Lichtdruckerin/Lichtdrucker (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft collotype-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">kollotypian valmistaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">kollotüübi valmistaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="tr">kolotip baskıcı kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo colotipador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu fototipista</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي طباع صور</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有珂罗版制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir fotomekanik işlem kullanarak baskılar yapmak için kullanılan, mürekkep alıcı ve mürekkep itici yüzeylere sahip sertleştirilmiş bir jelatin veya diğer kolloid filmi hazırlayarak bir gösterim yaratmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione, utilizzando un processo fotomeccanico per realizzare stampe direttamente da un film indurito di gelatina o altro colloide che ha superfici ricettive o repellenti all&apos;inchiostro.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy fotómechanikai eljárás alkalmazásával nyomtatványokat állít elő közvetlenül olyan zselatin vagy más kolloid megkeményedett filmjéből, amelynek tintafelvevő és tintataszító felülete van.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaation valmistamisesta tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la création d’une manifestation en préparant un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la creació d’una manifestació mitjançant la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta que s’usa per fer gravats usant un procés fotomecànic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de crear una manifestación preparando una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que se utilice para realizar impresiones mediante un proceso fotomecánico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het creëren van een manifestatie middels het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon ved å bruke en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation vha. en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for creating a manifestation by preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta manifestācijas ražošanā, izmantojot fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb kehastuse valmistamises, tehes fotomehaanilises protsessis tõmmiseid otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation verantwortlich ist, indem er ein fotomechanisches Verfahren zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid verwendet, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تصنيع تجسيدة باستخدام عمليات ضوئية ميكانيكية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التى تحتوي أسطح مستقبلة وطاردة للحبر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印对一种载体表现的创建负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30387 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30387">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif imprimeur</rdfs:label>
        <rdfs:label xml:lang="it">ha come stampatore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er trykker</rdfs:label>
        <rdfs:label xml:lang="no">har trykker (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has printer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckerin/Drucker (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft drukker-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">iespiedējs (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">matbaacı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomdász kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo impresor</rdfs:label>
        <rdfs:label xml:lang="et">trükkija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu impressor</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي طابع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印刷者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Basılı metin, notalı müzik veya tip veya plakalardan diğer içeriklerin bir gösterimini üretmekten sorumlu kolektif bir temsilciye bir gösterimi ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo coinvolto nella manifattura di una manifestazione di testo a stampa, musica notata, etc., da tipi o lastre, come un libro, giornale, rivista, foglio sciolto, partitura, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy nyomtatott szöveg, zenei lejegyzés vagy egyéb tartalom megjelenési formájának nyomdai szedésből vagy lemezekből történő gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa painetun tekstin, nuottiaineiston tai muun sisällön manifestaation valmistamisesta painolaatalta tai -levyltä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la fabrication d’une manifestation imprimée matérialisant du texte, de la musique notée, un contenu cartographique, du mouvement noté ou un contenu visuel fixe à l’aide d’un dispositif qui transfère de l’encre ou un médium semblable sur une surface.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la fabricació d’una manifestació impresa que materialitza text, música notada, imatge cartogràfica, moviment notat o contingut d’imatge fixa usant un mecanisme que transfereix tinta o un mitjà similar a una superfície.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de fabricar una manifestación impresa que materializa texto, música notada, imagen cartográfica, movimiento notado o contenido de imagen fija utilizando un dispositivo que transfiere tinta o un medio similar a una superficie.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het vervaardigen van een gedrukte manifestatie die omvat tekst, bladmuziek, cartografische content, bewegingsnotatie, of stilstaand beeld-content met gebruik van een apparaat that inkt of een soortgelijk medium overbrengt op een oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er involvert i framstillingen av en manifestasjon av trykt tekst, nedskrevet musikk, etc., ved hjelp av typer eller plater, f.eks. en bok, en avis, et tidsskrift, en løpeseddel eller et partitur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er involveret i fremstillingen af en manifestation af trykt tekst, noteret musik etc. fra typer eller plader, såsom en bog, en avis, et magasin, et tværformat, et partitur etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for manufacturing a printed manifestation that embodies text, notated music, cartographic image, notated movement, or still image content using a device that transfers ink or a similar medium to a surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas iesaistīta iespiesta teksta, nošu u.tml. manifestāciju ražošanā no burtu salikuma vai plāksnēm.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes osaleb trükise, noodi vms kehastuse valmistamises, trükkides trükilaolt või -plaadilt raamatuid, ajalehti, ajakirju, plakateid, partituure jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Herstellung einer Manifestation von gedrucktem Text, Noten oder anderem Inhalt durch Drucktypen oder Druckformen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن صناعة تجسيدة لنص مطبوع، أو موسيقى مدونة، إلخ، من صفحة أو لوحة، مثل كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقيه، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责生产用活字或平版印刷文字、乐谱或其他内容的一种载体表现的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend la fabrication d’un livre, d’un journal, d’un magazine, d’un placard ou d’une partition.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Herstellung eines Buchs, einer Zeitung, eines Magazins, eines Einblattdrucks oder einer Partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Idetartozik egy könyv, hírlap, magazin, egyoldalas nyomtatvány vagy partitúra gyártója.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver grāmatas, laikraksta, žurnāla, plakāta, vai partitūras ražošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la fabricació d’un llibre, un diari, un magazín, un full solt o una partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes the manufacture of a book, newspaper, magazine, broadside, or score.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye la fabricación de un libro, periódico, revista, andanada o partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter produktion af en bog, avis, tidsskrift, tværformat eller partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat de vervaardiging van een boek, krant, tijdschrift, pamfletvel of partituur.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Sisältää kirjan, sanomalehden, aikakauslehden, julisteen tai partituurin valmistamisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">matbaacı kolektif temsilcisi ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">ويشمل صناعة كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括图书、报纸、杂志、大张印刷品或总谱的生产。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30388 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30388">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif diffuseur ou distributeur</rdfs:label>
        <rdfs:label xml:lang="tr">dağıtımcı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har distributør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er distributør</rdfs:label>
        <rdfs:label xml:lang="en">has distributor collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Vertrieb (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft distributeur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">izplatītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">jakelija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">levitaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="hu">terjesztő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo distribuidor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu distribuïdor</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي موزع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发行者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayımlanmış bir bildiriyi dağıtmaktan sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo responsabile della distribuzione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy kiadott megjelenési forma terjesztéséért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa julkaistun manifestaation jakelusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la diffusion ou de la distribution d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la distribució d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de distribuir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het distribueren van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er ansvarlig for å distribuere en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er ansvarlig for at distribuere en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for distributing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir atbildīga par manifestācijas izplatīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes vastutab kehastuse levitamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für den Vertrieb einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن توزيع تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责发行一种出版载体表现的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30389 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30389">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif producteur d’une manifestation non publiée</rdfs:label>
        <rdfs:label xml:lang="et">avaldamata kehastuse tootja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di manifestazione non pubblicata agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er producer af upubliceret manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har produsent av upublisert manifestasjon (kollekitv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has producer collective agent of unpublished manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Erzeugerin/Erzeuger einer unveröffentlichten Manifestation (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-collectieve actor van ongepubliceerde manifestatie</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisemattoman manifestaation tuottaja (yhteistoimja)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadatlan megjelenési forma előállító kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">nepublicētas manifestācijas izgatavotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo productor de manifestación inédita</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu productor d’una manifestació no publicada</rdfs:label>
        <rdfs:label xml:lang="tr">yayınlanmamış gösterimin yapımcı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منتج لتجسيدة غير منشورة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有非出版载体表现的制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanmamış bir gösterimin kaydedilmesinden, üretilmesinden, inşa edilmesinden veya başka bir şekilde üretilmesinden sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo responsabile della iscrizione, fabbricazione, costruzione, etc. di una manifestazione non pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy kiadatlan megjelenési forma írásáért, összeállításáért, készítéséért vagy egyéb módú előállításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa julkaisemattoman manifestaation kaiverruksesta, valmistuksesta, kokoonpanosta tai muusta tuotantotavasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la scription, de la fabrication, de la construction ou de toute autre méthode de production d’une manifestation non publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la inscripció, la fabricació, la construcció o un altre mètode de producció d’una manifestació no publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de inscribir, fabricar, construir u otro método de producir una manifestación inédita.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het afschrijven, fabriceren, construeren of andere methode van het produceren van een ongepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er ansvarlig for å inskribere, fabrikere, konstruere etc. en upublisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er ansvarlig for indskrift, fremstilling, konstruktion etc. af en upubliceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for inscribing, fabricating, constructing, or other method of producing an unpublished manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir atbildīga par nepublicētās manifestācijas pierakstīšanu, izgatavošanu, radīšanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes vastutab avaldamata kehastuse inskribeerimise, tootmise, ehitamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für das Gravieren, Fabrizieren, Konstruieren oder eine andere Entstehungsmethode einer unveröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن تسجيل، أو تصنيع، أو إنشاء، إلخ. تجسيدة غير منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责镌刻、制造、构建或其他方法制作一种非出版载体表现的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30390 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30390">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif fabricant</rdfs:label>
        <rdfs:label xml:lang="hu">gyártó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come manifattura agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er producent</rdfs:label>
        <rdfs:label xml:lang="no">har tilvirker (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has manufacturer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Herstellerin/Hersteller (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft vervaardiger-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">ražotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo del fabricante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu fabricant</rdfs:label>
        <rdfs:label xml:lang="et">valmistaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">valmistaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">üretici kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي صانع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有生产者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, basımdan, çoğaltmadan, dökümden veya yayınlanmış bir gösterimi üretmenin başka bir yönteminden sorumlu olan kolektif temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo responsabile della stampa, riproduzione, fusione, etc. di una manifestazione pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy kiadott megjelenési forma nyomtatásáért, sokszorosításáért, öntéséért vagy egyéb módú gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa julkaistun manifestaation painamisesta, monistamisesta, kirjasinten valamisesta tai muusta valmistustavasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de l’impression, de la reproduction, du moulage ou de toute autre méthode de fabrication d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la impressió, la reproducció, el modelat o un altre mètode de fabricació d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de imprimir, duplicar, moldear u otro método de fabricación de una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het drukken, vermeerderen, gieten of andere methode van het vervaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er ansvarlig for å trykke, mangfoldiggjøre, etc. en publisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er ansvarlig for trykning, duplikering, støbning etc. af en publiceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for printing, duplicating, casting, or other method of manufacturing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir atbildīga par resursa publicējamās formas drukāšanu, pavairošanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes vastutab avaldatud kehastuse trükkimise, paljundamise, valamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für den Druck, die Vervielfältigung, den Guss oder eine andere Herstellungsmethode einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن طباعة، أو نسخ، أو صب، إلخ. تجسيدة منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责印刷、复制、铸造或其他方法生产一种出版载体表现的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30391 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30391">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif éditeur</rdfs:label>
        <rdfs:label xml:lang="it">ha come editore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er udgiver</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has publisher collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Verlag (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitgever-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">izdevējs (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">kirjastaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">kustantaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo editor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu editor</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي ناشر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有出版者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanan bir gösterimi yayınlamaktan, piyasaya sürmekten veya yayımlamaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo responsabile della pubblicazione, diffusione o emissione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy kiadott megjelenési forma kiadásáért, kibocsájtásáért vagy megjelentetéséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa julkaistun manifestaation kustantamisesta, julkaisemisesta tai ilmestymisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la publication, de la mise à disposition ou de l’édition d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la publicació, la posada en circulació o l’emissió d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de publicar, difundir o emitir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het uitgeven, uitbrengen of uitvaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er ansvarlig for å publisere, tilgjengeliggjøre eller utgi en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er ansvarlig for at publicere, frigive eller udgive en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for publishing, releasing, or issuing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir atbildīga par resursa izdošanu, publicēšanu vai izlaišanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes vastutab kehastuse avaldamise, väljalaskmise või väljaandmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für das Veröffentlichen, die Freigabe oder die Herausgabe einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن نشر، أو إصدار تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责出版、发布或发行一种出版载体表现的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30392 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30392">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif créateur d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yaratıcı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore di manifestazione agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er ophav til manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av manifestasjon (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has creator collective agent of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Mitwirkende/Mitwirkenden an einer Manifestation (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-collectieve actor van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse teostaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation tekijä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas radītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma létrehozó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo creador de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu creador d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منشئ لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的创建者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir veya daha fazla anlatımın somutlaştırılmasından sorumlu olan kolektif bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo responsabile della materializzazione di una o più espressioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely felelős egy vagy több kifejezési forma megtestesüléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaatioon yhteistoimijaan, joka on vastuussa yhden tai useamman ekspression ilmiasusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la matérialisation d’une ou plusieurs expressions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de la materialització d’una o més expressions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de la materialización de una o más expresiones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor de productie van het papier gebruikt voor de vervaardiging van een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er ansvarlig for realiseringen av ett eller flere uttrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er ansvarlig for realiseringen af et eller flere udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for the embodiment of one or more expressions.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir atbildīga par vienas vai vairāku izteiksmju ietveršanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes vastutab ühe või mitme väljenduse teostamise eest kehastusena.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Verkörperung einer Expression oder mehrerer Expressionen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن عملية تجسيد تعبيرة أو أكثر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种或多种内容表达之具体化的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of manifestation includes a manufacturer, producer, and publisher.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Hersteller, Produzentinnen/Produzenten und Verlage.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van manifestatie omvat een vervaardiger, producent en uitgever.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy megjelenési forma létrehozója magában foglalja a gyártót, az előállítót és a kiadót.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En skaper av en manifestasjon inkluderer distributør, tilvirker, produsent og utgiver.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Gösterimin yaratıcısı, bir üretimci, yapımcı ve yayıncıyı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kehastuse teostaja hõlmab levitajat, valmistajat, tootjat ja kirjastajat.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Manifestaation tekijä sisältää jakelijan, valmistajan, tuottajan ja kustantajan.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Manifestācijas radītāji ir arī izplatītāji, ražotāji, izgatavotāji un izdevēji.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til manifestation omfatter distrubutør, producent, producer og udgiver ect.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de manifestación incluye un fabricante, un productor y un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una manifestació inclou un distribuïdor, un fabricant, un productor i un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di manifestazione comprende un distributore, manifattura, produttore e editore.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une manifestation comprend un fabricant, un producteur et un éditeur.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل منشئ التجسيدة على الموزع، والصانع، والمنتج، والناشر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">载体表现的创建者包括生产者、制作者和出版者</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30393 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30393">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif papetier</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di carta agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er papirproducent</rdfs:label>
        <rdfs:label xml:lang="no">har papirprodusent (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has papermaker collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Papiermacherin/Papiermacher (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft papierproducent-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">kağıt üreticisi kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">paberivalmistaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">paperinvalmistaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">papírgyártó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">papīra izgatavotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo fabricante de papel</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu paperer</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي صانع ورق</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有造纸者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimde kullanılan kağıdın yapımından sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;agente collettivo responsabile della produzione della carta utilizzata per la manifattura di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy megjelenési forma gyártásához használt papír előállításáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteistoimijaan, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec un agent collectif qui est responsable de la confection du papier utilisé dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb un agent col·lectiu que és responsable de l’elaboració del paper usat en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un agente colectivo que es responsable de la elaboración del papel utilizado en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een collectieve actor die verantwoordelijk is voor het maken van papier gebruikt in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en kollektiv agent som er ansvarlig for produksjonen av papir brukt til å framstille en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en kollektiv agent, som er ansvarlig for fremstilling af papir, som anvendes til fremstilling af en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a collective agent who is responsible for the making of paper used in a manifestation. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar grupu, kas ir atbildīga par papīra izgatavošanu, kas izmantots ražošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse kollektiiviga, kes vastutab kehastuse valmistamiseks kasutatud paberi tootmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einem gemeinschaftlichen Akteur, der für die Produktion von Papier verantwortlich ist, das zur Herstellung einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ووكيل جماعي مسئول عن إنتاج الورق المستخدم في صناعة تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种载体表现中所使用的纸张之制造的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30394 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30394">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice à un agrégat</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattiin osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátum közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopojuma līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore a un aggregato ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til aggregat (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til samling</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body to aggregate</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger zu einem Aggregat (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie aan aggregaat</rdfs:label>
        <rdfs:label xml:lang="et">liitumi kaastööline (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene un cuerpo corporativo colaborador para agregar</rdfs:label>
        <rdfs:label xml:lang="tr">toplamaya katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora a un agregat</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة في تجميعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı bir eserin anlatımı yaratmaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente creatore di un&apos;opera materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely egy mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa aggregaattiin sisältyvän teoksen ekspression luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une expression d’une œuvre matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creació d’una expressió d’una obra que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una expresión de una obra que está personificada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het creëren van een expressie van een werk die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som skaper et verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som skaber et værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating an expression of a work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas radījusi apkopojumā ietverto darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes loob teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Schaffung einer Expression eines Werks verantwortlich ist, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة تنشئ عمل يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责创建被一种合集具体化的一种作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30395 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30395">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité arpenteuse</rdfs:label>
        <rdfs:label xml:lang="hu">földmérő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come topografo ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er landinspektør</rdfs:label>
        <rdfs:label xml:lang="no">har landmåler (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has surveyor corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Landvermesserin/Landvermesser (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landmeter-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">maamõõtja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">maanmittari (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo topógrafo</rdfs:label>
        <rdfs:label xml:lang="tr">topograf tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">topogrāfs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa agrimensora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساح</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有测绘者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi coğrafi alan için ölçümler veya boyutsal ilişkiler sağlayan, haritacılıkta katkıda bulunan bir aracı olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente cartografo di aggregato, che fornisce misurazioni o rapporti dimensionali per un&apos;area geografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely egy kartográfia közreműködő ágense, amely egy földrajzi területről méréseket vagy dimenziós összefüggéseket szolgáltat.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka kartografiaan osallisena toimijana tuottaa maantieteellisen alueen mitat tai mittasuhteet.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice de cartographie qui fournit des mesures ou des relations dimensionnelles pour une aire géographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un agent contribuïdor de cartografia que proporciona mesuraments o relacions dimensionals d’una àrea geogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es un agente colaborador de cartografía que proporciona medidas o relaciones dimensionales para un área geográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die is een bijdrager-actor van cartografie die metingen of dimensionele verhoudingen verschaft voor een geografisch gebied.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en kartograf til aggregat som tilfører målinger eller størrelsesforhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er kartograf til samling, som angiver målinger eller dimensionelle forhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor agent of cartography who provides measurements or dimensional relationships for a geographic area.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir apkopojuma kartogrāfs un nodrošina ģeogrāfiskā apgabala mērījumus vai dimensiju attiecības.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes liitumi kartograafina hangib geograafilise piirkonna mõõdud või mõõdusuhted. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger einer Kartografie (Körperschaft), die/der Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن رسم الخرائط في عمل تجميعي يقدم علاقات القياسات أو الأبعاد لمنطقة جغرافية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为地图绘制的贡献者行为者并为一个地理区域提供测量或尺寸关系的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30396 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30396">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice de cartographie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di cartografia ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til kartografi (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til kartografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of cartography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Kartografie (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van cartografie</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline kartograafia alal (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">kartografiaan osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="tr">kartografiye katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kartogrāfijas līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colaborador de cartografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora de cartografia</rdfs:label>
        <rdfs:label xml:lang="hu">térképészet közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة برسم خرائط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地图绘制贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı bir kartografik eserin anlatımını yaratan, topluluğa katkıda bulunan bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un&apos;opera cartografica, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy kartográfiai mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän kartografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre cartographique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra cartogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es un colaborador de un agregado que crea una expresión de una obra cartográfica que está plasmada en un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een cartografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et kartografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et kartografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of a cartographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto kartogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues kartograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines kartografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة تساهم في عمل تجميعي ينشيء عمل خرائطي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种地图作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30397 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30397">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice de chorégraphie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di coreografia ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til koreografi (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til koreografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of choreography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Choreografie (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van choreografie</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfijas līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline koreograafia alal (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">koreografiaan osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="tr">koreografiye katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfia közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colaborador de coreografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora de coreografia</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بتصميم رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğa katkıda bulunan ve bir topluluğa somutlaşan bir koreografik eserin anlatımını yaratan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un&apos;opera coreografica materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kollektív ágenshez, amely aggregátor közreműködőként egy koreografikus mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän koreografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre chorégraphique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra coreogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es un colaborador de un agregado que crea una expresión de una obra coreográfica que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een choreografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et koreografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et koreografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of a choreographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto horeogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues koreograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines choreografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهمة في عمل تجميعي ينشيء عمل من تصميم الرقصات يتجسيد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种编舞作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30398 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30398">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice d’images animées</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagine in movimento ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til levende bilder (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til levende billede</rdfs:label>
        <rdfs:label xml:lang="tr">hareketli görüntüye katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of moving image</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Bewegtbild (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van bewegend beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikuva pildi alal  (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">kustīga attēla līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">liikkuvaan kuvaan osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="hu">mozgókép közreműködő testülete a következő a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colaboradora de imagen en movimiento</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora d’imatge en moviment</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بصور متحركة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有动态图像的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı hareketli bir görüntü eserin anlatımını yaratan, topluluğa katkıda bulunan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un&apos;opera di immagini in movimento, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy mozgóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän liikkuvan kuvan teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre d’images animées matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra d’imatge en moviment que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es un colaborador a un agregado y que crea una expresión de una obra de imagen en movimiento que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een bewegend beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et verk med levende bilder som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et værk med levende billeder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of a moving image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto kustīgā attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues liikuvast pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines Bewegtbildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهمة في عمل تجميعي ينشيء عمل من صور متحركة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种动态图像作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30399 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30399">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice de musique</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di musica ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til musikk (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til musik</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of music</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger einer Musik (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van muziek</rdfs:label>
        <rdfs:label xml:lang="fi">musiikkiin osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="et">muusikaline kaastööline (asutus)</rdfs:label>
        <rdfs:label xml:lang="tr">müziğe katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">mūzikas līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colaborador de música</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora de música</rdfs:label>
        <rdfs:label xml:lang="hu">zene közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بموسيقى</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音乐的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi topluluk tarafından somutlaştırılan bir müzik eserinin anlatımını yaratan, topluluğa katkıda bulunan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un&apos;opera musicale, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy zenemű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän musiikkiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre musicale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra musical que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es un colaborador a un agregado y crea una expresión de una obra musical que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een muziekwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et musikalsk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et musikværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of a musical work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto mūzikas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues muusikateose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines Musikwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهمة في عمل تجميعي بإنشاء عمل موسيقي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种音乐作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30400 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30400">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice de contenu vocal</rdfs:label>
        <rdfs:label xml:lang="hu">beszéd közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di discorso ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tale (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til tale</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of speech</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Rede (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van spraak</rdfs:label>
        <rdfs:label xml:lang="tr">konuşmaya katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">kõneloome kaastööline (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">puheeseen osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="lv">runas līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colaborador de discurso</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora de discurs</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بحديث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有讲话的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğa katkıda bulunan ve bir topluluğa somutlaşan bir ses eserinin anlatımını yaratan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un&apos;opera parlata, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy beszédmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre vocale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra vocal que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es un colaborador a un agregado que crea una expresión de una obra vocal que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een vocaal werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et verk av tale som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et værk med talte ord, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of a vocal work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto mutvārdu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues suulise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines gesprochenen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهمة في عمل تجميعي ينشيء عمل من كلمات منطوقة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种人声作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30401 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30401">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice d’image fixe</rdfs:label>
        <rdfs:label xml:lang="lv">attēla līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">durağan görüntüye katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagine fissa ente</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til bilde (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til stillbillede</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of still image</rdfs:label>
        <rdfs:label xml:lang="de">hat Illustratorin/Illustrator (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van stilstaand beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikumatu pildi alal (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">stillkuvaan osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo contribuyente de imagen fija</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora d’imatge fixa</rdfs:label>
        <rdfs:label xml:lang="hu">állókép közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بصور ثابتة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有静态图像的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı hareketsiz bir görüntü eserinin anlatımını yaratan, topluluğa katkıda bulunan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un&apos;opera di immagine fissa, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy állóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre d’image fixe matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra d’imatge fixa que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es colaborador al agregado y que crea una expresión de una obra de imagen fija que está encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een stilstaand beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et bildeverk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et værk med stillbilleder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of a still image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues liikumatust pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines unbewegten Bildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهمة في عمل تجميعي ينشيء عمل من صور ثابتة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种静态图像作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30402 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30402">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice de texte</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di testo ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tekst (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til tekst</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of text</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von ergänzendem Text (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van tekst</rdfs:label>
        <rdfs:label xml:lang="tr">metne katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">szöveg közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">teksta līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">tekstiin osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="et">tekstiloome kaastööline (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colaborador de texto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora de text</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بنص</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有文本的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı metinsel bir eserin anlatımını yaratan, topluluğa katkıda bulunan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un&apos;opera testuale, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy szöveges mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre textuelle matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra textual que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es colaborador a un agregado y que crea una expresión de una obra textual que está incorporada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een tekstwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et tekstlig verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et tekstværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of a textual work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto teksta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues tekstteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines textlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهمة في عمل تجميعي ينشيء عمل نصي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种文字作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30403 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30403">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice d’objet</rdfs:label>
        <rdfs:label xml:lang="fi">esineeseen osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di oggetto ente</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til gjenstand (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til objekt</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of object</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Gegenstand (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van object</rdfs:label>
        <rdfs:label xml:lang="tr">nesneye katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">objekta līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">objektiloome kaastööline (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo contribuyente de objeto</rdfs:label>
        <rdfs:label xml:lang="hu">tárgy közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora d’objecte</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بكائن</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有物体的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluğun somutlaştırdığı bir obje eserinin anlatımını yaratan, topluluğa katkıda bulunan bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un’opera oggetto, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy tárgyi mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän esineteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’une œuvre objet matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió d’una obra d’objecte que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es colaborador al agregado y que crea una expresión de un objeto de trabajo que está encarnado por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van een objectwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper et verk som er en gjenstand som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber et værk med objekt, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of an object work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto objekta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues objektteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression eines gegenständlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهمة في عمل تجميعي ينشيء عمل شيء ما يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种物体作品的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30404 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30404">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité contributrice de contenu informatique</rdfs:label>
        <rdfs:label xml:lang="tr">bilgisayar içeriğine katkıda bulunan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">datororientēta satura līdzradītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">digisisu kaastööline (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">digitaaliseen sisältöön osallinen yhteisö</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di contenuto informatico ente </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til datamaskininnhold (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bidragsyder til computerindhold</rdfs:label>
        <rdfs:label xml:lang="en">has contributor corporate body of computer content</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von Computer Content (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-corporatie van computercontent</rdfs:label>
        <rdfs:label xml:lang="hu">számítógépes tartalom közreműködő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colaborador de contenido informático</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa contribuïdora de contingut informàtic</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مساهمة بمحتوى كمبيوتر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有计算机内容的贡献者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir topluluk tarafından somutlaştırılan bilgisayar içeriğinin bir anlatımını yaratan, topluluğa katkıda bulunan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente contributore a un aggregato, che crea un contenuto informatico, materializzato in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely aggregátor közreműködőként egy számítógépes tartalom olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen yhteisöön, joka on luonut aggregaattiin sisältyvän digitaalisen sisällön ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité contributrice à un agrégat qui crée une expression d’un contenu informatique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és un contribuïdor a un agregat que crea una expressió de contingut informàtic que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es colaborador a un agregado y que crea una expresión de contenido informático que está personificado por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die een bijdrager aan aggregaat is die een expressie van computercontent creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er en bidragsyter til aggregat som skaper datamaskininnhold som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er bidragsyder til samling, som skaber computerindhold, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is a contributor to aggregate who creates an expression of computer content that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir līdzradītājs, kas radījusi apkopojumā ietverto datororientēto saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes on liitumi kaastööline, luues digisisu väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Körperschaft), die/der eine Expression von Computer Content erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مساهم في عمل تجميعي ينشيء محتوى كمبيوتر يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种计算机内容的一种内容表达的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30405 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30405">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité diffuseuse audiovisuelle</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er broadcaster</rdfs:label>
        <rdfs:label xml:lang="no">har kringkaster (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has broadcaster corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Senderin/Sender (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitzender-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">leviedastaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">lähetyksestä vastaava yhteisö</rdfs:label>
        <rdfs:label xml:lang="hu">műsorszolgáltató testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">raidorganizācija (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo de radiodifusión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa de difusió</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مسئولة بث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, radyo, televizyon, web yayını veya diğer iletim ortamları yoluyla bir dinleyici kitlesine yayınlamaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella trasmissione di una manifestazione a un pubblico via radio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely egy megjelenési forma rádión, televízión, webközvetítésen, vagy egyéb adatátviteli médiumon keresztüli közönséghez történő műsorszórásáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation lähettämisestä yleisölle radiossa, televisiossa, suoratoistolähetyksenä tai muuna lähetysmediana.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la diffusion d’une manifestation à un public par la radio, la télévision, la webdiffusion ou d’autres moyens de transmission.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la difusió d’una manifestació a uns destinataris mitjançant la ràdio, la televisió, el web o un altre mitjà de transmissió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de transmitir una manifestación a una audiencia a través de radio, televisión, webcast u otros medios de transmisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het uitzenden van een manifestatie aan een publiek via radio, televisie, webcast of andere uitzendmedia.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i å kringkaste en manifestasjon til et publikum via radio, fjernsyn, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i transmissionen af en manifestation til et publikum via radio, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for broadcasting a manifestation to an audience via radio, television, webcast, or other transmission media.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas pārraidē, izmantojot radio, televīziju, tīmekļa apraidi u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes tegeleb kehastuse levitamisega avalikkusele raadio, televisiooni, veebi vms kaudu.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Ausstrahlung einer Manifestation über Hörfunk, Fernsehen oder Webcast oder andere Übertragungsmedien verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة بث تجسيدة لجمهور ما عبر الإذاعة، أو التلفزيون، أو البث عبر الانترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责通过广播、电视、网络广播或其他传输媒介向受众广播载体表现的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30406 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30406">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité distributrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvan jakelija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">film dağıtımcısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas izplatītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">filmilevitaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="hu">filmterjesztő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore cinematografico ente </rdfs:label>
        <rdfs:label xml:lang="no">har filmdistributør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er filmdistributør</rdfs:label>
        <rdfs:label xml:lang="en">has film distributor corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmvertrieb (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmdistributeur-corporatie</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo distribuidor de películas</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa distribuïdora de pel·lícules</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة موزع أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影发行者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, sinema salonlarına veya diğer dağıtım kanallarına hareketli bir görüntü gösterimi dağıtmaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella distribuzione di una manifestazione di immagini in movimento alle sale cinematografiche o ad altri canali di distribuzione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely egy mozgókép megjelenési formájának terjesztéséért felelős filmszínházak vagy más disztribúciós csatornák számára.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la distribution d’une manifestation d’images animées aux salles de cinéma ou aux autres réseaux de distribution.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la distribució d’una manifestació d’imatge en moviment a cinemes o a altres canals de distribució.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de distribuir una manifestación de imágenes en movimiento a cines u otros canales de distribución.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het distribueren van een bewegend beeld-manifestatie naar theaters of andere distributiekanalen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i å distribuere en manifestasjon i form av levende bilder til kinoer eller andre distribusjonskanaler.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i distribueringen af en manifestation med levende billeder til biografer eller andre distributionskanaler.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for distributing a moving image manifestation to theatres or other distribution channels.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta filmas manifestācijas izplatīšanā kinoteātriem vai izmantojot citus izplatīšanas kanālus.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes tegeleb filmi kehastuse levitamisega kinodesse või muudesse levikanalitesse.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für den Vertrieb einer Bewegtbildmanifestation an Kinos oder andere Vertriebskanäle verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن توزيع تجسيدة من الصور المتحركة لقاعات العرض أو عبر قنوات توزيع أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责通过广播、电视、网络广播或其他传输媒介向受众广播载体表现的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30407 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30407">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité maquettiste de livre</rdfs:label>
        <rdfs:label xml:lang="fi">graafinen suunnittelija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatas dizaina autors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come grafico ente</rdfs:label>
        <rdfs:label xml:lang="no">har bokdesigner (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bogdesigner</rdfs:label>
        <rdfs:label xml:lang="en">has book designer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchgestalterin/Buchgestalter (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekontwerper-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">kitap tasarımcısı tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvtervező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukujundaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo diseñador de libros</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa dissenyadora gràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مصممة كتاب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书设计者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, tür ve resim düzenlemesi, malzeme seçimi ve kullanılan süreç de dahil olmak üzere bir kitabın tüm grafik tasarımından sorumlu olarak bir gösterim oluşturmaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, come responsabile dell&apos;intero progetto grafico di un libro, compresi la disposizione dei caratteri tipografici e delle illustrazioni, la scelta dei materiali e il procedimento utilizzato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy felelős egy könyv teljes grafikai tervezéséért, beleértve a nyomdai betűtípus és az illusztrációk elrendezését, az anyagválasztást és az alkalmazott eljárást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta vastaamalla kirjan graafisesta suunnittelusta, taitosta, materiaalien valinnasta ja käytettävistä valmistusmenetelmistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une manifestation en étant responsable de toute la conception graphique d’un livre, y compris la composition typographique, l’arrangement des illustrations, le choix des matériaux et le procédé utilisé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creaació d’una manifestació amb la responsabilitat de tot el disseny gràfic d’un llibre, inclosa la composició tipogràfica i la il·lustració, la tria dels materials i el procés utilitzat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una manifestación al ser responsable de todo el diseño gráfico de un libro, incluida la disposición del tipo y la ilustración, la elección de los materiales y el proceso utilizado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het creëren van een manifestatie door verantwoordelijk te zijn voor het gehele grafische ontwerp van een boek, inclusief de indeling van het zetsel en illustratie, keuze van materialen en gebruikt procedé.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å ha ansvar for hele den grafiske utformingen av en bok, inkludert oppsett av skrifttype og illustrasjoner, valg av materialer og hvilke prosesser som brukes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at være ansvarlig for hele det grafiske design af en bog, inkl. opsætning af tekst og illustrationer, materialevalg og anvendt proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating a manifestation by being responsible for the entire graphic design of a book, including arrangement of type and illustration, choice of materials, and process used.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, atbildot par grāmatas grafisko dizainu, tajā skaitā par izkārtojuma veidu un ilustrācijām, materiālu izvēli un tehnoloģisko procesu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, vastutades raamatu graafilise kujunduse eest, sealhulgas trükiteksti ja illustratsioonide paigutuse, materjalide valiku ja valmistamismenetluste eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie für das gesamte grafische Design eines Buchs, einschließlich Schriftbild, Bildgestaltung, Materialwahl und angewandter Verfahren, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة بالتصميم الجرافيكي الكامل لكتاب، بما في ذلك توضيب حروف الطباعة، والإيضاحيات، واختيار المواد، والعمليات المستخدمة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过负责图书的整体图形设计（包括字体和插图的编排、材料的选取和工艺流程的使用等）对载体表现创建负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30408 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30408">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité graveuse</rdfs:label>
        <rdfs:label xml:lang="et">graveerija (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">gravieris (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">gravür sanatçısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come incisore ente</rdfs:label>
        <rdfs:label xml:lang="no">har gravør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er gravør</rdfs:label>
        <rdfs:label xml:lang="en">has engraver corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Stecherin/Stecher (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft graveur-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">kaivertaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo grabador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa gravadora</rdfs:label>
        <rdfs:label xml:lang="hu">vésnök testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة نقاش</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕版者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, basım için kullanılan ahşap veya metal bir levha gibi bir yüzey üzerinde harfleri, şekilleri veya diğer işaretleri keserek bir gösterimi yaratmaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, tramite l&apos;intaglio di lettere, figure, etc. su di una superficie, come una lastra di legno o metallo utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy betűket, ábrákat vagy egyéb jeleket vés nyomtatáshoz használatos fa- vagy fémlemezhez hasonló felületre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une manifestation en gravant des lettres, des figures ou d’autres marques sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creació d’una manifestació mitjançant la gravació de lletres, figures o altres marques sobre una superfície com ara una planxa de fusta o de metall usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una manifestación cortando letras, figuras u otras marcas en una superficie como una placa de madera o metal utilizada para imprimir.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het creëren van een manifestatie middels het snijden van letters, figuren of andere markeringen, in een oppervlak zoals een houten of metalen plaat gebruikt bij het drukken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å skjære ut bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating a manifestation by cutting letters, figures, or other marks on a surface such as a wooden or metal plate used for printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, uz drukāšanai izmantojama materiāla (piemēram, uz koka vai metāla plāksnes) virsmas iegriežot burtus, zīmes u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, lõigates tähti, kujundeid jms trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Buchstaben, figürliche Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte schneidet, die zum Drucken benutzt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة برص الحروف، والأشكال، إلخ، على سطح مثل لوح خشبي أو معدني يستخدم للطباعة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过在用于印刷的木版或金属版的表面上雕刻字母、图像或其他记号负责载体表现的创建的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30409 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30409">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="lv">Braila raksta iespiedējs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">Braille-dombornyomó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fr">a pour collectivité productrice braille</rdfs:label>
        <rdfs:label xml:lang="tr">braille kabartmacısı tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come goffratore braille ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er punktskriftspræger</rdfs:label>
        <rdfs:label xml:lang="no">har punktskriftpreger (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has braille embosser corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Brailleschriftprägerin/Brailleschriftpräger (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft brailleerder-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">pistekirjoituksen tekijä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">punktkirja kirjutaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo impresor de braille</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa estampadora braille</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مجسدة بطريقة برايل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有布莱叶盲文点字制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir kalem, özel kabartmalı yazıcı veya başka bir cihaz kullanarak braille hücrelerini kabartmak suretiyle bir gösterim üretmekten sorumlu olan tüzel kişilikle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, tramite goffratura di celle braille, utilizzando uno stilo, una stampante speciale per goffratura, o altro dispositivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy domborítja a Braille-cellákat íróvessző, speciális domborítónyomtató vagy más készülék használatával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la fabrication d’une manifestation par l’embossage de cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la fabricació d’una manifestació amb el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de fabricar una manifestación grabando celdas braille usando un lápiz óptico, una impresora especial de estampado u otro dispositivo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het vervaardigen van een manifestatie middels het brailleren met gebruik van een stylus, een speciale stansmachine of ander hulpmiddel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å prege brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at præge punktskriftsceller vha. en stift, særlig prægeprinter eller andet apparatur.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for manufacturing a manifestation by embossing braille cells using a stylus, special embossing printer, or other device.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, iespiežot Braila raksta matricas, izmantojot irbuli, īpašu ciļņa iespieduma printeri vai citu ierīci.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, tehes punktkirjamärke spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation in Form von Braillezeichen verantwortlich ist, indem sie einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät zum Prägen verwendet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة بالطباعة بطريقة خلايا نقش برايل باستخدام قلم نقش، أو طابعة نقش خاصة، أو أي أداة أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文而对一种载体表现的生产负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30410 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30410">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité graveuse d’estampe</rdfs:label>
        <rdfs:label xml:lang="tr">baskı sanatçısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">graafika trükkija (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">gravīru meistars (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come incisore di stampe ente </rdfs:label>
        <rdfs:label xml:lang="no">har grafiker (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er grafiker</rdfs:label>
        <rdfs:label xml:lang="en">has printmaker corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckgrafikerin/Druckgrafiker (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft prentmaker-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">kuvalaatan valmistaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">nyomtatványkészítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo impresor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa gravadora d’estampes</rdfs:label>
        <rdfs:label xml:lang="ar">لها هيئة طباع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印版制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, kabartma veya planografik baskı yüzeyi yaparak bir gösterim yaratmaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, tramite la preparazione di una superficie di stampa in rilievo, a intaglio o planografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy egy domború, mélynyomásos (intaglio) vagy síknyomásos felületet készít.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta valmistamalla kohokuvan, syväpainon tai laakapainon painopinnan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une manifestation en préparant un élément d’impression en relief, en creux ou planographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creaació d’una manifestació fent una superfície d’impressió en relleu, gravada en profunditat o planogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una manifestación mediante la realización de una superficie de impresión en relieve, calcográfica o planográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het creëren van een manifestatie middels het vervaardigen van een hoogdruk, diepdruk of vlakdruk oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å lage en overflate for relieff-, intaglio- eller plantrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at lave en relief-, dybtryks- eller fladtryksoverflade.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating a manifestation by making a relief, intaglio, or planographic printing surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, veidojot reljefa, dobspiedes vai gludspieduma drukāšanas virsmu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, tehes kõrgtrüki, sügavtrüki või lametrüki teel tõmmiseid.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie eine Hochdruck-, Tiefdruck- oder Flachdruckoberfläche erstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة بإعداد الأسطح المستخدمة في الطباعة من خلال سطح طباعة بارز، أو غائر، أو مستوي</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作浮雕、凹版或平版印刷表面对一种载体表现的创建负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30411 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30411">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité fondeuse</rdfs:label>
        <rdfs:label xml:lang="tr">dökümcü tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fonditore ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er støber</rdfs:label>
        <rdfs:label xml:lang="no">har støper (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has caster corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Formgießerin/Formgießer (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gieter-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">lējējs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo lanzador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa emmotlladora</rdfs:label>
        <rdfs:label xml:lang="et">valaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">valaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">öntvénykészítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مسئولة عن الصب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有铸造者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, sıvı veya erimiş bir maddeyi bir kalıba dökerek ve kalıbın şeklini alması için katılaşmaya bırakarak gösterim yaratmakla yükümlü olan bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, tramite il versamento di una sostanza liquida o fusa in uno stampo e lasciandola solidificare fino ad assumere la forma dello stampo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy folyékony vagy olvasztott anyagot önt egy öntőformába és hagyja, hogy az megszilárduljon és az öntőforma formáját felvegye.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta muovaamalla sulatettua tai nestemäistä ainetta muotin avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une manifestation en versant un liquide ou une substance fondue dans un moule et en laissant ce liquide ou cette substance se solidifier pour prendre la forme du moule.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creació d’una manifestació amb l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una manifestación vertiendo un líquido o sustancia fundida en un molde y dejándolo solidificar para tomar la forma del molde.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het creëren van een manifestatie middels het gieten van een vloeistof of gesmolten substantie in een mal en die te laten stollen in de vorm van die mal.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å helle et flytende eller smeltet stoff i en støpeform og la det stivne i denne formen.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating a manifestation by pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, lejot veidnē šķidru vai izkausētu vielu un atstājot to sacietēt, lai tā iegūtu veidnes formu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, valades vedela või sulatatud materjali valuvormi, kus materjal tahkub, võttes valuvormi kuju.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie eine Flüssigkeit oder eine geschmolzenen Substanz in eine Form gießt, die in der Gießform verbleibt, bis sie ausgehärtet ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة بصب السائل أو المادة المذابة في القالب وتركه حتى يجف ليأخذ شكل القالب.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过将液体或融化的物质倒入模具中使其按模具固化成型而对一种载体表现的创建负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30412 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30412">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité lithographe</rdfs:label>
        <rdfs:label xml:lang="it">ha come litografo ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er litograf</rdfs:label>
        <rdfs:label xml:lang="no">har litograf (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has lithographer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Lithografin/Lithografen (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft lithograaf-corporatie</rdfs:label>
        <rdfs:label xml:lang="hu">kőnyomatkészítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="et">litograaf (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">litografi (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="lv">litogrāfs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">taş baskı sanatçısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo litógrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa litògrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة طباع على الحجر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有平版制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, litografik baskı için bir taş veya plaka hazırlayarak bir gösterim yaratmaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, preparando una pietra o lastra per l&apos;impressione litografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy egy követ vagy lemezt készít elő litográfiai nyomtatáshoz, azaz kőnyomathoz.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta valmistamalla litografiassa käytetyn kivilaatan tai muun painolaatan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une manifestation en préparant une pierre ou une plaque pour l’impression lithographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creació d’una manifestació amb la preparació d’una pedra o una planxa per a la impressió litogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una manifestación mediante la preparación de una piedra o placa para impresión litográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het creëren van een manifestatie middels het voorbereiden van een steen of plaat voor lithografisch drukwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å klargjøre en stein eller plate for litografisk trykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at klargøre en sten eller plade til litografisk trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating a manifestation by preparing a stone or plate for lithographic printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, sagatavojot akmeni vai iespiedplati litogrāfiskai pavairošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, valmistades ette kivi või plaadi litograafiliste tõmmiste jaoks. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie einen Stein oder eine Platte für lithografischen Druck vorbereitet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة بإعداد الحجر أو اللوح للطباعة الحجرية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作用于平版印刷的石头或平版而对一种载体表现的创建负责的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A lithographer includes a graphic artist creating a design directly on the surface from which printing will be done.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A litográfus egy grafikusművész, aki közvetlenül azon a felületen készít tervet, amelyről a nyomtatás történik.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir taş baskı sanatçısı, baskının yapılacağı yüzey üzerinde doğrudan bir tasarım yaratan bir grafik sanatçısı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een lithograaf omvat een grafisch kunstenaar die een ontwerp maakt direct op het oppervlak waarvan gedrukt zal worden.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En litograf inkluderer en grafiker som skaper et design direkte på overflaten som trykkingen vil bli gjort.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Litograaf hõlmab ka graafikut, kes loob kujutise otse pinnale, millelt toimub trükkimine.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Litograf omfatter en grafiker, som skaber et design direkte på overfladen, hvorfra trykning vil blive udført.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Litogrāfs ir arī grafiķis, kas veido dizainu tieši uz virsmas, no kuras materiāls tiks drukāts.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un lithographe comprend un artiste graphique créant un dessin directement sur la surface à partir de laquelle l’impression sera effectuée.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un litografo comprende un artista grafico che crea un disegno direttamente sulla superficie da cui viene effettuata l&apos;impressione.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un litògraf inclou un artista gràfic que crea un disseny directament sobre la superfície a partir de la qual es farà la impressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un litógrafo incluye un artista gráfico que crea un diseño directamente sobre la superficie desde la cual se realizará la impresión.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل الطباع على فنان الجرافيك الذي يصمم بشكل مباشر على السطح الذي سيتم منه الطباعة مباشرة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">平版制作者包括直接在用于印刷的表面进行设计创作的平面美术家</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30413 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30413">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité clicheuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come preparatore di lastre ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er plademager</rdfs:label>
        <rdfs:label xml:lang="no">har trykkplatemaker (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has platemaker corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckformherstellerin/Druckformhersteller (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft platenmaker-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">levhacı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomólemez-készítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painolaatan valmistaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="lv">presformas izgatavotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo fabricante de placas</rdfs:label>
        <rdfs:label xml:lang="et">trükiplaadi valmistaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa gravadora de planxes</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مصممة لوحات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制版者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki basılı görüntülerin veya metnin yapımında kullanılan plakaları hazırlamaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, preparando lastre utilizzate nella produzione di immagini o testo stampati.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy nyomtatott képek vagy szövegek előállításánál használt lemezeket készít elő.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta valmistamalla painettujen kuvien tai tekstin valmistuksessa käytettäviä painolaattoja tai -levyjä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la préparation des planches utilisées dans la réalisation d’images ou de textes imprimés dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la preparació de les planxes usades en la producció d’imatges impreses o de text imprès.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de preparar las placas utilizadas en la realización de imágenes impresas o texto en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het prepareren van platen gebruikt in het maken van gedrukte beelden of tekst in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å klargjøre trykkplater som brukes ved produksjon av trykte bilder og/eller tekst.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at forberede plader, som anvendes til fremstilling af trykte billeder eller tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for preparing plates used in the making of printed images or text in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, sagatavojot plāksnes, ko izmanto iespiestu attēlu vai teksta izgatavošanā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, valmistades ette plaadid piltide või teksti trükkimiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Druckformen für die Produktion von gedruckten Bildern oder gedrucktem Text anfertigt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة بإعداد اللوحات المستخدمة في إنتاج الصور المطبوعة أو النص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责准备用于在一种载体表现中制作印刷图像或文字的印版的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30414 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30414">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité aquafortiste</rdfs:label>
        <rdfs:label xml:lang="fi">etsaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="it">ha come acquafortista ente </rdfs:label>
        <rdfs:label xml:lang="no">har etser (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er raderer</rdfs:label>
        <rdfs:label xml:lang="en">has etcher corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Radiererin/Radierer (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft etser-corporatie</rdfs:label>
        <rdfs:label xml:lang="hu">karckészítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">ofortists (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">oymacı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">söövitaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo grabador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa aiguafortista</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة حفار زنكوغراف (كليشيهات)</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有蚀刻者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi metal, cam veya baskı için kullanılan diğer bazı yüzeyleri asit veya başka bir aşındırıcı maddeye tabi tutarak bir gösterim oluşturmaktan sorumlu olan bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, sottoponendo all&apos;acido o a un&apos;altra sostanza corrosiva, del metallo, vetro o altra superficie utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy nyomtatáshoz használt fém-, üveg- vagy valamilyen más felületet savnak vagy más maró anyagnak vet alá.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta etsaamalla metallia, lasia tai muuta pintaa hapon tai muun syövyttävän aineen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une manifestation en soumettant à l’acide ou à une autre substance corrosive du métal, du verre ou une autre surface utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creació d’una manifestació sotmetent a l’àcid, o a qualsevol altra substància corrosiva, el metall, el vidre o qualsevol altra superfície usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una manifestación sometiendo metal, vidrio o alguna otra superficie utilizada para imprimir, a ácido u otra sustancia corrosiva.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het creëren van een manifestatie middels het blootstellen van metaal, glas of een ander oppervlak gebruikt voor het drukproces, aan zuur of een ander bijtend middel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å utsette metall, glass eller et annet overflatemateriale som brukes til trykking, for syre eller et annet etsende stoff.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation ved at udsætte metal, glas eller en anden overflade, som anvendes til trykning, for syre eller andet ætsende stof.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating a manifestation by subjecting metal, glass, or some other surface used for printing, to acid or another corrosive substance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, pakļaujot metāla, stikla vai kādu citu drukāšanai paredzētu virsmu skābei vai citai kodīgai vielai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, töödeldes happe või muu söövitava ainega trükkimiseks kasutatavat metallist, klaasist või muust materjalist pinda.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Metall, Glas oder eine andere Oberfläche, die zum Drucken benutzt wird, mit Säure oder einer anderen ätzenden Substanz behandelt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة لإخضاع المعدن، أو الزجاج، أو أي سطح آخر يستخدم في الطباعة، بالحمض أو أي مادة أخرى كاوية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过使用酸或其他腐蚀性物质施于用来印刷的金属、玻璃或其他表面上而对一种载体表现的创建负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30415 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30415">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité phototypeuse</rdfs:label>
        <rdfs:label xml:lang="lv">fotogravieris (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">fénynyomatkészítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come collotipista ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er lystrykker</rdfs:label>
        <rdfs:label xml:lang="no">har lystrykker (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has collotyper corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Lichtdruckerin/Lichtdrucker (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft collotype-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">kollotypian valmistaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">kollotüübi valmistaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="tr">kolotip baskıcı tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo colotipador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa fototipista</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة طباع صور</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有珂罗版制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve fotomekanik bir işlem kullanarak baskılar yapmak için kullanılan jelatin veya diğer kolloidden sertleştirilmiş bir film hazırlayarak bir gösterim yaratmaktan sorumlu olan bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione, utilizzando un processo fotomeccanico per realizzare stampe direttamente da un film indurito di gelatina o altro colloide che ha superfici ricettive o repellenti all&apos;inchiostro.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy megjelenési forma gyártásáért oly módon, hogy fotómechanikai eljárás alkalmazásával nyomtatványokat állít elő közvetlenül olyan zselatin vagy más kolloid megkeményedett filmjéből, amelynek tintafelvevő és tintataszító felülete van.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaation valmistamisesta tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la création d’une manifestation en préparant un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la creació d’una manifestació mitjançant la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de crear una manifestación mediante la preparación de una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que se utilice para realizar impresiones mediante un proceso fotomecánico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die is verantwoordelijk voor het creëren van een manifestatie middels het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon ved å bruke en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation vha. en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for creating a manifestation by preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta manifestācijas ražošanā, izmantojot fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb kehastuse valmistamises, tehes fotomehaanilises protsessis tõmmiseid otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation verantwortlich ist, indem sie ein fotomechanisches Verfahren zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid verwendet, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن تصنيع تجسيدة باستخدام عمليات ضوئية ميكانيكية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التى تحتوي أسطح مستقبلة وطاردة للحبر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印对一种载体表现的创建负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30416 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30416">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité imprimeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come stampatore ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er trykker</rdfs:label>
        <rdfs:label xml:lang="no">har trykker (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has printer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckerin/Drucker (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft drukker-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">iespiedējs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">matbaacı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomdász testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo impresor</rdfs:label>
        <rdfs:label xml:lang="et">trükkija (asutus)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa impressora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة طابع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印刷者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, basılı metin, notalı müzik plaka ya da diğer türlerden olan içeriğin bir gösterimi üretmekten sorumlu olan tüzel kişilikle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente coinvolto nella manifattura di una manifestazione di testo a stampa, musica notata, etc., da tipi o lastre, come un libro, giornale, rivista, foglio sciolto, partitura, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy nyomtatott szöveg, zenei lejegyzés vagy egyéb tartalom megjelenési formájának nyomdai szedésből vagy lemezekből történő gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa painetun tekstin, nuottiaineiston tai muun sisällön manifestaation valmistamiseen painolaatalta tai -levyltä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la fabrication d’une manifestation imprimée matérialisant du texte, de la musique notée, un contenu cartographique, du mouvement noté ou un contenu visuel fixe à l’aide d’un dispositif qui transfère de l’encre ou un médium semblable sur une surface.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la fabricació d’una manifestació impresa que materialitza text, música notada, imatge cartogràfica, moviment notat o contingut d’imatge fixa usant un mecanisme que transfereix tinta o un mitjà similar a una superfície.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un organismo corporativo que es responsable de fabricar una manifestación impresa que materializa texto, música notada, imagen cartográfica, movimiento notado o contenido de imagen fija utilizando un dispositivo que transfiere tinta o un medio similar a una superficie.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het vervaardigen van een gedrukte manifestatie die omvat tekst, bladmuziek, cartografische content, bewegingsnotatie, of stilstaand beeld-content met gebruik van een apparaat that inkt of een soortgelijk medium overbrengt op een oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er involvert i framstillingen av en manifestasjon av trykt tekst, nedskrevet musikk, etc., ved hjelp av typer eller plater, f.eks. en bok, en avis, et tidsskrift, en løpeseddel eller et partitur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er involveret i fremstillingen af en manifestation af trykt tekst, noteret musik etc. fra typer eller plader, såsom en bog, en avis, et magasin, et tværformat, et partitur etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for manufacturing a printed manifestation that embodies text, notated music, cartographic image, notated movement, or still image content using a device that transfers ink or a similar medium to a surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas iesaistīta iespiesta teksta, nošu u.tml. manifestāciju ražošanā no burtu salikuma vai plāksnēm.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes osaleb trükise, noodi vms kehastuse valmistamises, trükkides trükilaolt või -plaadilt raamatuid, ajalehti, ajakirju, plakateid, partituure jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Herstellung einer Manifestation von gedrucktem Text, Noten oder anderem Inhalt durch Drucktypen oder Druckformen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن صناعة تجسيدة لنص مطبوع، أو موسيقى مدونة، إلخ، من صفحة أو لوحة، مثل كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقيه، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责生产用活字或平版印刷文字、乐谱或其他内容的一种载体表现的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend la fabrication d’un livre, d’un journal, d’un magazine, d’un placard ou d’une partition.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Herstellung eines Buchs, einer Zeitung, eines Magazins, eines Einblattdrucks oder einer Partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Idetartozik egy könyv, hírlap, magazin, egyoldalas nyomtatvány vagy partitúra gyártója.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver grāmatas, laikraksta, žurnāla, plakāta, vai partitūras ražošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la fabricació d’un llibre, un diari, un magazín, un full solt o una partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes the manufacture of a book, newspaper, magazine, broadside, or score.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye la fabricación de un libro, periódico, revista, andanada o partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter produktion af en bog, avis, tidsskrift, tværformat eller partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat de vervaardiging van een boek, krant, tijdschrift, pamfletvel of partituur.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Sisältää kirjan, sanomalehden, aikakauslehden, julisteen tai partituurin valmistamisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">matbaacı tüzel kişisi ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">ويشمل صناعة كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括图书、报纸、杂志、大张印刷品或总谱的生产。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30417 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30417">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité diffuseuse ou distributrice</rdfs:label>
        <rdfs:label xml:lang="tr">dağıtımcı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore ente </rdfs:label>
        <rdfs:label xml:lang="no">har distributør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er distributør</rdfs:label>
        <rdfs:label xml:lang="en">has distributor corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Vertrieb (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft distributeur-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">izplatītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">jakelija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">levitaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="hu">terjesztő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo distribuidor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa distribuïdora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة موزع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发行者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanan bir gösterimi dağıtmaktan sorumlu olan bir tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente responsabile della distribuzione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely egy kiadott megjelenési forma terjesztéséért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa julkaistun manifestaation jakelusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la diffusion ou de la distribution d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la distribució d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de distribuir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het distribueren van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er ansvarlig for å distribuere en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er ansvarlig for at distribuere en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for distributing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir atbildīga par manifestācijas izplatīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes vastutab kehastuse levitamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für den Vertrieb einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن توزيع تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责发行一种出版载体表现的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30418 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30418">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité productrice d’une manifestation non publiée</rdfs:label>
        <rdfs:label xml:lang="et">avaldamata kehastuse tootja (asutus)</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di manifestazione non pubblicata ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er producer af upubliceret manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har produsent av upublisert manifestasjon (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has producer corporate body of unpublished manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Erzeugerin/Erzeuger einer unveröffentlichten Manifestation (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-corporatie van ongepubliceerde manifestatie</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisemattoman manifestaation tuottaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadatlan megjelenési forma előállító testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">nepublicētas manifestācijas izgatavotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo productor de manifestación inédita</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa productora d’una manifestació no publicada</rdfs:label>
        <rdfs:label xml:lang="tr">yayınlanmamış gösterimin yapımcı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منتجة لتجسيدة غير منشورة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有非出版载体表现的制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayınlanmamış gösterimin yazımı, üretimi, yapımı veya üretimi için başka bir yönteminden sorumlu tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente responsabile della iscrizione, fabbricazione, costruzione, etc. di una manifestazione non pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy kiadatlan megjelenési forma írásáért, összeállításáért, készítéséért vagy egyéb módú előállításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa julkaisemattoman manifestaation kaiverruksesta, valmistuksesta, kokoonpanosta tai muuta tuotantotavasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la scription, de la fabrication, de la construction ou de toute autre méthode de production d’une manifestation non publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la inscripció, la fabricació, la construcció o un altre mètode d’una manifestació no publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de inscribir, fabricar, construir u otro método de producir una manifestación inédita.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het afschrijven, fabriceren, construeren of andere methode van het produceren van een ongepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er ansvarlig for å inskribere, fabrikere, konstruere etc. en upublisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er ansvarlig for indskrift, fremstilling, konstruktion etc. af en upubliceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for inscribing, fabricating, constructing, or other method of producing an unpublished manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir atbildīga par nepublicētās manifestācijas pierakstīšanu, izgatavošanu, radīšanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes vastutab avaldamata kehastuse inskribeerimise, tootmise, ehitamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für das Gravieren, Fabrizieren, Konstruieren oder eine andere Entstehungsmethode einer unveröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئول عن تسجيل، أو تصنيع، أو إنشاء، إلخ. تجسيدة غير منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责镌刻、制造、构建或其他方法制作一种非出版载体表现的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30419 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30419">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité fabricante</rdfs:label>
        <rdfs:label xml:lang="hu">gyártó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come manifattura ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er producent</rdfs:label>
        <rdfs:label xml:lang="no">har tilvirker (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has manufacturer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Herstellerin/Hersteller (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft vervaardiger-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">ražotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo fabricante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa fabricant</rdfs:label>
        <rdfs:label xml:lang="et">valmistaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">valmistaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">üretici tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة صانع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有生产者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayımlanmış gösterimin basımı, çoğaltılması, döküm ve üretimi için başka yöntemlerden sorumlu tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente responsabile della stampa, riproduzione, fusione, etc. di una manifestazione pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy kiadott megjelenési forma nyomtatásáért, sokszorosításáért, öntéséért vagy egyéb módú gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa julkaistun manifestaation painamisesta, monistamisesta, kirjasinten valamisesta tai muusta valmistustavasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de l’impression, de la reproduction, du moulage ou de toute autre méthode de fabrication d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la impressió, la reproducció, el modelat o un altre mètode de fabricació d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de imprimir, duplicar, moldear u otro método de fabricación de una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het drukken, vermeerderen, gieten of andere methode van het vervaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er ansvarlig for å trykke, mangfoldiggjøre, etc. en publisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er ansvarlig for trykning, duplikering, støbning etc. af en publiceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for printing, duplicating, casting, or other method of manufacturing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir atbildīga par resursa publicējamās formas drukāšanu, pavairošanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes vastutab avaldatud kehastuse trükkimise, paljundamise, valamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für den Druck, die Vervielfältigung, den Guss oder eine andere Herstellungsmethode einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن طباعة، أو نسخ، أو صب، إلخ. تجسيدة منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责印刷、复制、铸造或其他方法生产一种出版载体表现的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30420 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30420">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité éditrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come editore ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er udgiver</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has publisher corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Verlag (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitgever-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">izdevējs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="et">kirjastaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">kustantaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo editor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa editora</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة ناشر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有出版者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayımlanmış gösterimin basımı, satımı veya ihraç edilmesinden sorumlu tüzel kişiyle ilişkilendirir..</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente responsabile della pubblicazione, diffusione o emissione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy kiadott megjelenési forma kiadásáért, kibocsájtásáért vagy megjelentetéséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa julkaistun manifestaation kustantamisesta, julkaisemisesta tai ilmestymisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la publication, de la mise à disposition ou de l’édition d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la publicació, la posada en circulació o l’emissió d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de publicar, divulgar o emitir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het uitgeven, uitbrengen of uitvaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er ansvarlig for å publisere, tilgjengeliggjøre eller utgi en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er ansvarlig for at publicere, frigive eller udgive en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for publishing, releasing, or issuing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir atbildīga par resursa izdošanu, publicēšanu vai izlaišanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes vastutab kehastuse avaldamise, väljalaskmise või väljaandmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für das Veröffentlichen, die Freigabe oder die Herausgabe einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن نشر، أو إصدار تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责出版、发布或发行一种出版载体表现的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30421 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30421">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité créatrice d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yaratıcı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore di manifestazione ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er ophav til manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av manifestasjon (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has creator corporate body of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Mitwirkende/Mitwirkenden an einer Manifestation (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-corporatie van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse teostaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation tekijä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas radītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma létrehozó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo creador de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa creadora d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منشئ لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的创建者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir veya daha fazla ifadenin somutlaştırılmasından sorumlu tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente responsabile della materializzazione di una o più espressioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely felelős egy vagy több kifejezési forma megtestesüléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaatioon yhteisöön, joka on vastuussa yhden tai useamman ekspression ilmiasusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la matérialisation d’une ou plusieurs expressions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de la materialització d’una o més expressions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de la materialización de una o más expresiones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor de productie van het papier gebruikt voor de vervaardiging van een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er ansvarlig for realiseringen av ett eller flere uttrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er ansvarlig for realiseringen af et eller flere udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for the embodiment of one or more expressions.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir atbildīga par vienas vai vairāku izteiksmju ietveršanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes vastutab ühe või mitme väljenduse teostamise eest kehastusena.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Verkörperung einer Expression oder mehrerer Expressionen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن عملية تجسيد تعبيرة أو أكثر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种或多种内容表达之具体化的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of manifestation includes a manufacturer, producer, and publisher.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Hersteller, Produzentinnen/Produzenten und Verlage.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van manifestatie omvat een vervaardiger, producent en uitgever.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy megjelenési forma létrehozója magában foglalja a gyártót, az előállítót és a kiadót.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En skaper av en manifestasjon inkluderer distributør, tilvirker, produsent og utgiver.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Gösterimin yaratıcısı, bir üretimci, yapımcı ve yayıncıyı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kehastuse teostaja hõlmab levitajat, valmistajat, tootjat ja kirjastajat.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Manifestaation tekijä sisältää jakelijan, valmistajan, tuottajan ja kustantajan.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Manifestācijas radītāji ir arī izplatītāji, ražotāji, izgatavotāji un izdevēji.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til manifestation omfatter distrubutør, producent, producer og udgiver ect.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de manifestación incluye un fabricante, un productor y un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una manifestació inclou un fabricant, un productor i un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di manifestazione comprende un distributore, manifattura, produttore e editore.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une manifestation comprend un fabricant, un producteur et un éditeur.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل منشئ التجسيدة على الموزع، والصانع، والمنتج، والناشر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">载体表现的创建者包括生产者、制作者和出版者</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30422 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30422">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour collectivité papetière</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di carta ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er papirproducent</rdfs:label>
        <rdfs:label xml:lang="no">har papirprodusent (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has papermaker corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Papiermacherin/Papiermacher (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft papierproducent-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">kağıt üreticisi tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">paberivalmistaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">paperinvalmistaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">papírgyártó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">papīra izgatavotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo fabricante de papel</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa paperera</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة صانع ورق</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有造纸者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, gösterimde kullanılan kağıtları üretmekten sorumlu tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione all&apos;ente responsabile della produzione della carta utilizzata per la manifattura di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy testülethez, amely egy megjelenési forma gyártásához használt papír előállításáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation yhteisöön, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une collectivité qui est responsable de la confection du papier utilisé dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una entitat corporativa que és responsable de l’elaboració del paper usat en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con un cuerpo corporativo que es responsable de la fabricación del papel utilizado en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een corporatie die verantwoordelijk is voor het maken van papier gebruikt in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en korporasjon som er ansvarlig for produksjonen av papir brukt til å framstille en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en korporation, som er ansvarlig for fremstilling af papir, som anvendes til fremstilling af en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a corporate body who is responsible for the making of paper used in a manifestation. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar institūciju, kas ir atbildīga par papīra izgatavošanu, kas izmantots ražošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse asutusega, kes vastutab kehastuse valmistamiseks kasutatud paberi tootmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Körperschaft, die für die Produktion von Papier verantwortlich ist, das zur Herstellung einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وهيئة مسئولة عن إنتاج الورق المستخدم في صناعة تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种载体表现中所使用的纸张之制造的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30423 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30423">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice à un agrégat</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattiin osallinen suku</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátum közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopojuma līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore a un aggregato famiglia </rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til aggregat (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til samling</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family to aggregate</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger zu einem Aggregat (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie aan aggregaat</rdfs:label>
        <rdfs:label xml:lang="et">liitumi kaastööline (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia colaboradora para agregar</rdfs:label>
        <rdfs:label xml:lang="tr">toplamaya katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora a un agregat</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة في تجميعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış eserin ifadesini oluşturulmasından sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia creatrice di un&apos;opera materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely egy mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa aggregaattiin sisältyvän teoksen ekspression luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une expression d’une œuvre matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una expressió d’una obra que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una expresión de una obra que es encarnada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het creëren van een expressie van een werk die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som skaper et verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som skaber et værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating an expression of a work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas radījusi apkopojumā ietverto darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes loob teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Schaffung einer Expression eines Werks verantwortlich ist, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة تنشئ عمل يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责创建被一种合集具体化的一种作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30424 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30424">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille arpenteuse</rdfs:label>
        <rdfs:label xml:lang="hu">földmérő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come topografo famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er landinspektør</rdfs:label>
        <rdfs:label xml:lang="no">har landmåler (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has surveyor family</rdfs:label>
        <rdfs:label xml:lang="de">hat Landvermesserin/Landvermesser (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landmeter-familie</rdfs:label>
        <rdfs:label xml:lang="et">maamõõtja (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">maanmittari (suku)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia agrimensora</rdfs:label>
        <rdfs:label xml:lang="tr">topograf ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">topogrāfs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família agrimensora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساح</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有测绘者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, coğrafi bölge için ölçüler veya boyutsal ilişkiler sağlayan, kartografyanın katkı sağlayan temsilcisi olan aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia cartografa di un aggregato che fornisce misurazioni o rapporti dimensionali per un&apos;area geografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, egy kartográfia közreműködő ágenséhez, amely egy földrajzi területről méréseket vagy dimenziós összefüggéseket szolgáltat.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka kartografiaan osallisena toimijana tuottaa maantieteellisen alueen mitat tai mittasuhteet.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice de cartographie qui fournit des mesures ou des relations dimensionnelles pour une aire géographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un agent contribuïdor de cartografia que proporciona mesuraments o relacions dimensionals d’una àrea geogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es agente contribuidor de cartografía quien provee medidas o relaciones dimensionales para un área geográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die is een bijdrager-actor van cartografie die metingen of dimensionele verhoudingen verschaft voor een geografisch gebied.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en kartograf til aggregat som tilfører målinger eller størrelsesforhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er kartograf til samling, som angiver målinger eller dimensionelle forhold for et geografisk område.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor agent of cartography who provides measurements or dimensional relationships for a geographic area.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir apkopojuma kartogrāfs un nodrošina ģeogrāfiskā apgabala mērījumus vai dimensiju attiecības.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes liitumi kartograafina hangib geograafilise piirkonna mõõdud või mõõdusuhted. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger einer Kartografie (Familie), die/der Messwerte oder Abmessungsverhältnisse für den dargestellten geografischen Bereich zur Verfügung stellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن رسم الخرائط في عمل تجميعي يقدم علاقات القياسات أو الأبعاد لمنطقة جغرافية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为地图绘制的贡献者行为者并为一个地理区域提供测量或尺寸关系的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30425 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30425">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice de cartographie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di cartografia famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til kartografi (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til kartografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of cartography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Kartografie (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van cartografie</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline kartograafia alal (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">kartografiaan osallinen suku</rdfs:label>
        <rdfs:label xml:lang="tr">kartografiye katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kartogrāfijas līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de cartografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora de cartografia</rdfs:label>
        <rdfs:label xml:lang="hu">térképészet közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة برسم خرائط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有测绘者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; bütün tarafından somutlaştırılmış kartografik eserin ifadesini oluşturan, bütüne katkı sağlayan aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un&apos;opera cartografica, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy kartográfiai mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän kartografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre cartographique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra cartogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidor a un agregado quien crea una expresión de una obra cartográfica que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een cartografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et kartografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en agent, som er bidragsyder til samling, som skaber et kartografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of a cartographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto kartogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues kartograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines kartografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة تساهم في عمل تجميعي ينشيء عمل خرائطي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种地图作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30426 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30426">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice de chorégraphie</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di coreografia famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til koreografi (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til koreografi</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of choreography</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Choreografie (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van choreografie</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfijas līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline koreograafia alal (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">koreografiaan osallinen suku</rdfs:label>
        <rdfs:label xml:lang="tr">koreografiye katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfia közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de coreografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora de coreografia</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة برسم خرائط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılan koreografik eserin ifadesini yaratmış bütüne katkı sağlayan aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un&apos;opera coreografica, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy koreografikus mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän koreografisen teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre chorégraphique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra coreogràfica que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de una obra coreográfica que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een choreografisch werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et koreografisk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber et koreografisk værk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of a choreographic work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto horeogrāfijas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues koreograafilise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines choreografischen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي ينشيء عمل من تصميم الرقصات يتجسيد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为作为合集的一个贡献者并创建被一种合集具体化的一种地图作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30427 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30427">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice d’images animées</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagini in movimento famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til levende bilder (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til levende billede</rdfs:label>
        <rdfs:label xml:lang="tr">hareketli görüntüye katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of moving image</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Bewegtbild (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van bewegend beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikuva pildi alal (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">kustīga attēla līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">liikkuvaan kuvaan osallinen suku</rdfs:label>
        <rdfs:label xml:lang="hu">mozgókép közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de imagen en movimiento</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora d’imatge en moviment</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة بصور متحركة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有动态图像的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış hareketli görüntü eserinin ifadesini yaratan bütünün katkıcısı ailesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un&apos;opera di immagini in movimento, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy mozgóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän liikkuvan kuvan teoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre d’images animées matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra d’imatge en moviment que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de una obra de imagen en movimiento que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een bewegend beeldwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et verk med levende bilder som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber et værk med levende billeder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of a moving image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto kustīgā attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues liikuvast pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines Bewegtbildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي ينشيء عمل من صور متحركة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种动态图像作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30428 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30428">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice de musique</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di musica famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til musikk (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til musik</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of music</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger einer Musik (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van muziek</rdfs:label>
        <rdfs:label xml:lang="fi">musiikkiin osallinen suku</rdfs:label>
        <rdfs:label xml:lang="et">muusikaline kaastööline (perekond)</rdfs:label>
        <rdfs:label xml:lang="tr">müziğe katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">mūzikas līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de música</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora de música</rdfs:label>
        <rdfs:label xml:lang="hu">zene közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة بموسيقى</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音乐的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış müzikal eserin ifadesini yaratan bütünün katkıcı ailesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un&apos;opera musicale, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy zenemű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän musiikkiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre musicale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra musical que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de una obra musical que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een muziekwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et musikalsk verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber et musikværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of a musical work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto mūzikas darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues muusikateose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines Musikwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي بإنشاء عمل موسيقي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种音乐作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30429 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30429">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice de contenu vocal</rdfs:label>
        <rdfs:label xml:lang="hu">beszéd közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di discorso famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tale (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til tale</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of speech</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einer Rede (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van spraak</rdfs:label>
        <rdfs:label xml:lang="tr">konuşmaya katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">kõneloome kaastööline (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">puheeseen osallinen suku</rdfs:label>
        <rdfs:label xml:lang="lv">runas līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora de discurs</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة بحديث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有讲话的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış sözlü eserin ifadesini yaratan bütüne katkı sağlayan aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un&apos;opera parlata materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy beszédmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän puheteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre vocale matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra vocal que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de una obra vocal que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een vocaal werk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et verk av tale som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber et værk med talte ord, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of a vocal work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto mutvārdu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues suulise teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines gesprochenen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي ينشيء عمل من كلمات منطوقة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种人声作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30430 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30430">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice d’image fixe</rdfs:label>
        <rdfs:label xml:lang="lv">attēla līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">durağan görüntüye katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di immagini fisse famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til bilde (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til stillbillede</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of still image</rdfs:label>
        <rdfs:label xml:lang="de">hat Illustratorin/Illustrator (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van stilstaand beeld</rdfs:label>
        <rdfs:label xml:lang="et">kaastööline liikumatu pildi alal (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">stillkuvaan osallinen suku</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de imagen fija</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora d’imatge fixa</rdfs:label>
        <rdfs:label xml:lang="hu">állókép közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة بصور ثابتة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有静态图像的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış hareketsiz görünütünün ifadesini yaratan bütüne katkı sağlamış aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un&apos;opera di immagini fisse materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy állóképmű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän stillkuvateoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre d’image fixe matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra d’imatge fixa que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de una obra de imagen fija que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een stilstaand beeldwerk creëert dat is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et bildeverk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber et værk med stillbilleder, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of a still image work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto attēla darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues liikumatust pildist koosneva teose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines unbewegten Bildwerks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي ينشيء عمل من صور ثابتة يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种静态图像作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30431 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30431">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice de texte</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di testo famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til tekst (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til tekst</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of text</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von ergänzendem Text (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van tekst</rdfs:label>
        <rdfs:label xml:lang="tr">metne katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">szöveg közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">teksta līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">tekstiin osallinen suku</rdfs:label>
        <rdfs:label xml:lang="et">tekstiloome kaastööline (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de texto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora de text</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة بنص</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有文本的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış metinsel eserin ifadesini yaratan bütüne katkı sağlamış aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un&apos;opera testuale materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy szöveges mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän tekstiteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre textuelle matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra textual que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de una obra textual que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een tekstwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et tekstlig verk som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber et tekstværk, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of a textual work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto teksta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues tekstteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines textlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي ينشيء عمل نصي يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种文字作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30432 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30432">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice d’objet</rdfs:label>
        <rdfs:label xml:lang="fi">esineeseen osallinen suku</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di oggetto famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til gjenstand (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til objekt</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of object</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von einem Gegenstand (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van object</rdfs:label>
        <rdfs:label xml:lang="tr">nesneye katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">objekta līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">objektiloome kaastööline (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de objeto</rdfs:label>
        <rdfs:label xml:lang="hu">tárgy közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora d’objecte</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة بكائن</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有物体的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış nesne eserinin ifadesini yaratan bütüne katkı sağlamış aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un’opera oggetto, materializzata in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy tárgyi mű olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän esineteoksen ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’une œuvre objet matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió d’una obra d’objecte que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de una obra de objeto que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die een expressie van een objectwerk creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper et verk som er en gjenstand som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber et værk med objekt, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of an object work that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto objekta darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues objektteose väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression eines gegenständlichen Werks erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي ينشيء عمل شيء ما يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种物体作品的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30433 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30433">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille contributrice de contenu informatique</rdfs:label>
        <rdfs:label xml:lang="tr">bilgisayar içeriğine katkıda bulunan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">datororientēta satura līdzradītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">digisisu kaastööline (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">digitaaliseen sisältöön osallinen suku</rdfs:label>
        <rdfs:label xml:lang="it">ha come contributore di contenuto informatico famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bidragsyter til datamaskininnhold (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bidragsyder til computerindhold</rdfs:label>
        <rdfs:label xml:lang="en">has contributor family of computer content</rdfs:label>
        <rdfs:label xml:lang="de">hat Beiträgerin/Beiträger von Computer Content (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrage-familie van computercontent</rdfs:label>
        <rdfs:label xml:lang="hu">számítógépes tartalom közreműködő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia contribuidora de contenido por computadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família contribuïdora de contingut informàtic</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مساهمة بمحتوى كمبيوتر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有计算机内容的贡献者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün tarafından somutlaştırılmış bilgisayar içeriğinin ifadesini yaratan bütüne katkı sağlamış aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia contributrice a un aggregato che crea un contenuto informatico materializzato in un aggregato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely aggregátor közreműködőként egy számítógépes tartalom olyan kifejezési formáját hozza létre, amely egy aggregátumban testesül meg.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation aggregaattiin osalliseen sukuun, joka on luonut aggregaattiin sisältyvän digitaalisen sisällön ekspression.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille contributrice à un agrégat qui crée une expression d’un contenu informatique matérialisée par un agrégat.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és un contribuïdor a un agregat que crea una expressió de contingut informàtic que es materialitza en un agregat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es contribuidora a un agregado quien crea una expresión de contenido por computadora que es materializada por un agregado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die een bijdrager aan aggregaat is die expressie van computercontent creëert die is verwezenlijkt in een aggregaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er en bidragsyter til aggregat som skaper datamaskininnhold som er realisert i et aggregat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er bidragsyder til samling, som skaber computerindhold, der er indeholdt i en samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is a contributor to aggregate who creates an expression of computer content that is embodied by an aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir līdzradītājs, kas radījusi apkopojumā ietverto datororientēto saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes on liitumi kaastööline, luues digisisu väljenduse, mis on teostatud liitumis.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Beiträgerin/einem Beiträger zu einem Aggregat (Familie), die/der eine Expression von Computer Content erstellt, die durch ein Aggregat verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مساهمة في عمل تجميعي ينشيء محتوى كمبيوتر يتجسد في تجميعية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与作为合集的一个贡献者并创建被一种合集具体化的一种计算机内容的一种内容表达的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30434 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30434">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille diffuseuse audiovisuelle</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er broadcaster</rdfs:label>
        <rdfs:label xml:lang="no">har kringkaster (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has broadcaster family</rdfs:label>
        <rdfs:label xml:lang="de">hat Senderin/Sender (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitzender-familie</rdfs:label>
        <rdfs:label xml:lang="et">leviedastaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">lähetyksestä vastaava suku</rdfs:label>
        <rdfs:label xml:lang="hu">műsorszolgáltató családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">raidorganizācija (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia transmisora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família de difusió</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مسئولة بث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; radyo, televizyon, internet canlı yayınları, veya diğer iletim ortamları sayesinde izleyicilere gösterim yayınlamaktan sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella trasmissione di una manifestazione a un pubblico via radio, televisione, web, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely egy megjelenési forma rádión, televízión, webközvetítésen, vagy egyéb adatátviteli médiumon keresztüli közönséghez történő műsorszórásááért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation lähettämisestä yleisölle radiossa, televisiossa, suoratoistolähetyksenä tai muuna lähetysmediana.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la diffusion d’une manifestation à un public par la radio, la télévision, la webdiffusion ou d’autres moyens de transmission.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la difusió d’una manifestació a uns destinataris mitjançant la ràdio, la televisió, el web o un altre mitjà de transmissió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de transmitir una manifestación a una audiencia vía radio, televisión, webcast u otros medios de transmisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het uitzenden van een manifestatie aan een publiek via radio, televisie, webcast of andere uitzendmedia.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i å kringkaste en manifestasjon til et publikum via radio, fjernsyn, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i transmissionen af en manifestation til et publikum via radio, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for broadcasting a manifestation to an audience via radio, television, webcast, or other transmission media.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas pārraidē, izmantojot radio, televīziju, tīmekļa apraidi u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes tegeleb kehastuse levitamisega avalikkusele raadio, televisiooni, veebi vms kaudu.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Ausstrahlung einer Manifestation über Hörfunk, Fernsehen oder Webcast oder andere Übertragungsmedien verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة بث تجسيدة لجمهور ما عبر الإذاعة، أو التلفزيون، أو البث عبر الانترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责通过广播、电视、网络广播或其他传输媒介向受众广播载体表现的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30435 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30435">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille distributrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvan jakelija (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">film dağıtımcısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas izplatītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">filmilevitaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">filmterjesztő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore cinematografico famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er filmdistributør</rdfs:label>
        <rdfs:label xml:lang="no">har filmdistributør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has film distributor family</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmvertrieb (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmdistributeur-familie</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia distribuidora fílmica</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família distribuïdora de pel·lícules</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة موزع أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影发行者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, tiyatrolar veya başka dağıtım kanalları için hareketli gösterimin dağıtımından sorumlu olan aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella distribuzione di una manifestazione di immagini in movimento alle sale cinematografiche o ad altri canali di distribuzione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely egy mozgókép megjelenési formájának terjesztéséért felelős filmszínházak vagy más disztribúciós csatornák számára.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa elokuvan tms. manifestaation jakamisesta elokuvateattereille tai muille jakelukanaville.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la distribution d’une manifestation d’images animées aux salles de cinéma ou aux autres réseaux de distribution.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la distribució d’una manifestació d’imatge en moviment a cinemes o a altres canals de distribució.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de distribuir imágenes en movimiento a cines u otros canales.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het distribueren van een bewegend beeld-manifestatie naar theaters of andere distributiekanalen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i å distribuere en manifestasjon i form av levende bilder til kinoer eller andre distribusjonskanaler.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i distribueringen af en manifestation med levende billeder til biografer eller andre distributionskanaler.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for distributing a moving image manifestation to theatres or other distribution channels.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta filmas manifestācijas izplatīšanā kinoteātriem vai izmantojot citus izplatīšanas kanālus.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes tegeleb filmi kehastuse levitamisega kinodesse või muudesse levikanalitesse.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für den Vertrieb einer Bewegtbildmanifestation an Kinos oder andere Vertriebskanäle verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن توزيع تجسيدة من الصور المتحركة لقاعات العرض أو عبر قنوات توزيع أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责向剧院或其他发行渠道发行动态图像载体表现的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30436 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30436">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille maquettiste de livre</rdfs:label>
        <rdfs:label xml:lang="fi">graafinen suunnittelija (suku)</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatas dizaina autors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come grafico famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har bokdesigner (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er bogdesigner</rdfs:label>
        <rdfs:label xml:lang="en">has book designer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchgestalterin/Buchgestalter (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekontwerper-familie</rdfs:label>
        <rdfs:label xml:lang="tr">kitap tasarımcı aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvtervező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukujundaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia diseñadora de libros</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família dissenyadora gràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مصممة كتاب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书设计者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; türün ayarlanması ve gösterimi, materyal seçimi ve kullanılan işlem dahil bir kitabın bütün grafik tasarımından sorumlu olarak bir gösterim yaratmakla sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, come responsabile dell&apos;intero progetto grafica di un libro, compresi la disposizione dei caratteri tipografici e delle illustrazioni, la scelta dei materiali e il procedimento utilizzato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy felelős egy könyv teljes grafikai tervezéséért, beleértve a nyomdai betűtípus és az illusztrációk elrendezését, az anyagválasztást és az alkalmazott eljárást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta vastaamalla kirjan graafisesta suunnittelusta, taitosta, materiaalien valinnasta ja käytettävistä valmistusmenetelmistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une manifestation en étant responsable de toute la conception graphique d’un livre, y compris la composition typographique, l’arrangement des illustrations, le choix des matériaux et le procédé utilisé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una manifestació amb la responsabilitat de tot el disseny gràfic d’un llibre, inclosa la composició tipogràfica i la il·lustració, la tria dels materials i el procés utilitzat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al ser responsable de todo el diseño gráfico de un libro, incluyendo la disposición de tipo e ilustración, elección de materiales y el proceso utilizado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het creëren van een manifestatie door verantwoordelijk te zijn voor het gehele grafische ontwerp van een boek, inclusief de indeling van het zetsel en illustratie, keuze van materialen en gebruikt procedé.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å ha ansvar for hele den grafiske utformingen av en bok, inkludert oppsett av skrifttype og illustrasjoner, valg av materialer og hvilke prosesser som brukes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at være ansvarlig for hele det grafiske design af en bog, inkl. opsætning af tekst og illustrationer, materialevalg og anvendt proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating a manifestation by being responsible for the entire graphic design of a book, including arrangement of type and illustration, choice of materials, and process used.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, atbildot par grāmatas grafisko dizainu, tajā skaitā par izkārtojuma veidu un ilustrācijām, materiālu izvēli un tehnoloģisko procesu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, vastutades raamatu graafilise kujunduse eest, sealhulgas trükiteksti ja illustratsioonide paigutuse, materjalide valiku ja valmistamismenetluste eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie für das gesamte grafische Design eines Buchs, einschließlich Schriftbild, Bildgestaltung, Materialwahl und angewandter Verfahren, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تصنيع تجسيدة بالتصميم الجرافيكي الكامل لكتاب، بما في ذلك توضيب حروف الطباعة، والإيضاحيات، واختيار المواد، والعمليات المستخدمة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过负责图书的整体图形设计（包括字体和插图的编排、材料的选取和工艺流程的使用等）对载体表现创建负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30437 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30437">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille graveuse</rdfs:label>
        <rdfs:label xml:lang="et">graveerija (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">gravieris (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">gravür sanatçısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come incisore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er gravør</rdfs:label>
        <rdfs:label xml:lang="no">har gravør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has engraver family</rdfs:label>
        <rdfs:label xml:lang="de">hat Stecherin/Stecher (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft graveur-familie</rdfs:label>
        <rdfs:label xml:lang="fi">kaivertaja (suku)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia grabadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família gravadora</rdfs:label>
        <rdfs:label xml:lang="hu">vésnök családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة نقاش</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕版者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; harfler, figürler veya basım için kullanılan tahta veya metal plaka gibi yüzeylerin üzerinde diğer izleri keserek bir gösterim oluşturmaktan sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, tramite l&apos;intaglio di lettere, figure, etc. su di una superficie come una lastra di legno o metallo utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy betűket, ábrákat vagy egyéb jeleket vés nyomtatáshoz használatos fa- vagy fémlemezhez hasonló felületre.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta kaivertamalla kirjaimia, kuvioita tai muita merkkejä painamisessa käytettävälle pinnalle, kuten puu- tai metallipinnalle.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une manifestation en gravant des lettres, des figures ou d’autres marques sur une surface telle qu’une plaque de bois ou de métal utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una manifestació mitjançant la gravació de lletres, figures o altres marques sobre una superfície com ara una planxa de fusta o de metall usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al cortar letras, figuras, etc., sobre una superficie tal como una placa de madera o metal utilizada para imprimir.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het creëren van een manifestatie middels het snijden van letters, figuren of andere markeringen, in een oppervlak zoals een houten of metalen plaat gebruikt bij het drukken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å skjære ut bokstaver, figurer, etc. i en overflate som en tre- eller metallplate som brukes til trykking.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at udskære bogstaver, figurer etc. på en overflade såsom en træ- eller metalplade, som anvendes til trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating a manifestation by cutting letters, figures, or other marks on a surface such as a wooden or metal plate used for printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, uz drukāšanai izmantojama materiāla (piemēram, uz koka vai metāla plāksnes) virsmas iegriežot burtus, zīmes u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, lõigates tähti, kujundeid jms trükkimiseks kasutatava puidust, metallist või muust materjalist plaadi pinnale.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Buchstaben, figürliche Darstellungen oder andere Zeichen in eine Oberfläche, wie zum Beispiel eine Holz- oder Metallplatte schneidet, die zum Drucken benutzt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تصنيع تجسيدة بالتصميم الجرافيكي الكامل لكتاب، بما في ذلك توضيب حروف الطباعة، والإيضاحيات، واختيار المواد، والعمليات المستخدمة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过在用于印刷的木版或金属版的表面上雕刻字母、图像或其他记号负责载体表现的创建的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30438 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30438">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="lv">Braila raksta iespiedējs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">Braille-dombornyomó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fr">a pour famille productrice braille</rdfs:label>
        <rdfs:label xml:lang="tr">braille kabartmacısı aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come goffratore braille famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er punktskriftspræger</rdfs:label>
        <rdfs:label xml:lang="no">har punktskriftpreger (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has braille embosser family</rdfs:label>
        <rdfs:label xml:lang="de">hat Brailleschriftprägerin/Brailleschriftpräger (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft brailleerder-familie</rdfs:label>
        <rdfs:label xml:lang="fi">pistekirjoituksen tekijä (suku)</rdfs:label>
        <rdfs:label xml:lang="et">punktkirja kirjutaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia grabadora en relieve de braille de</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família estampadora braille</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مجسدة بطريقة برايل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有布莱叶盲文点字制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; bir taş kalem, özel kabartma yazıcısı veya başka bir cihaz kullanarak braille hücrelerini kabartarak bir gösterim üretmekle sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, tramite goffratura di celle braille, utilizzando uno stilo, una stampante speciale per goffratura, o altro dispositivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy domborítja a Braille-cellákat íróvessző, speciális domborítónyomtató vagy más készülék használatával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta tuottamalla pistekirjoitusmerkkejä piirtimen, erityistulostimen tai muun laitteen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la fabrication d’une manifestation par l’embossage de cellules braille au moyen d’un poinçon, d’une imprimante spéciale ou d’un autre appareil.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la fabricació d’una manifestació amb el repujat de punts braille amb un punxó, una impressora especial d’estampar o un altre mecanisme.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al grabar en relieve celdas braille utilizando un stylus, impresora especial de grabado en relieve u otro dispositivo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het vervaardigen van een manifestatie middels het brailleren met gebruik van een stylus, een speciale stansmachine of ander hulpmiddel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å prege brailleceller ved hjelp av pren, punktskriftmaskin eller annen innretning.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at præge punktskriftsceller vha. en stift, særlig prægeprinter eller andet apparatur.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for manufacturing a manifestation by embossing braille cells using a stylus, special embossing printer, or other device.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, iespiežot Braila raksta matricas, izmantojot irbuli, īpašu ciļņa iespieduma printeri vai citu ierīci.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, tehes punktkirjamärke spetsiaalse kirjutusvahendi, punktkirjaprinteri või muu seadmega.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation in Form von Braillezeichen verantwortlich ist, indem sie einen Griffel, einen speziellen Brailledrucker oder ein anderes Gerät zum Prägen verwendet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تصنيع تجسيدة بالطباعة بطريقة خلايا نقش برايل باستخدام قلم نقش، أو طابعة نقش خاصة، أو أي أداة أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与涉及通过使用刻写针、专门的压纹机或其他设备压印布莱叶盲文而对一种载体表现的生产负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30439 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30439">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille graveuse d’estampe</rdfs:label>
        <rdfs:label xml:lang="tr">baskı sanatçısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">graafika trükkija (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">gravīru meistars (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="it">ha come preparatore di stampe famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er grafiker</rdfs:label>
        <rdfs:label xml:lang="no">har grafiker (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has printmaker family</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckgrafikerin/Druckgrafiker (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft prentmaker-familie</rdfs:label>
        <rdfs:label xml:lang="fi">kuvalaatan valmistaja (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">nyomtatványkészítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia impresora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família gravadora d’estampes</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة طباع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印版制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; bir kabartma, oyma veya planografik baskı yüzeyi yaparak bir gösterim oluşturmakla sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, tramite la preparazione di una superficie di stampa in rilievo, a intaglio o planografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy egy domború, mélynyomásos (intaglio) vagy síknyomásos felületet készít.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta valmistamalla kohokuvan, syväpainon tai laakapainon painopinnan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une manifestation en préparant un élément d’impression en relief, en creux ou planographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una manifestació fent una superfície d’impressió en relleu, gravada en profunditat o planogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al hacer una superficie de impresión en relieve, calcográfica o planográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het creëren van een manifestatie middels het vervaardigen van een hoogdruk, diepdruk of vlakdruk oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å lage en overflate for relieff-, intaglio- eller plantrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at lave en relief-, dybtryks- eller fladtryksoverflade.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating a manifestation by making a relief, intaglio, or planographic printing surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, veidojot reljefa, dobspiedes vai gludspieduma drukāšanas virsmu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, tehes kõrgtrüki, sügavtrüki või lametrüki teel tõmmiseid.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie eine Hochdruck-, Tiefdruck- oder Flachdruckoberfläche erstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئول عن تصنيع تجسيدة بإعداد الأسطح المستخدمة في الطباعة من خلال سطح طباعة بارز، أو غائر، أو مستوي</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作浮雕、凹版或平版印刷表面对一种载体表现的创建负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30440 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30440">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille fondeuse</rdfs:label>
        <rdfs:label xml:lang="tr">dökümcü aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fonditore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er støber</rdfs:label>
        <rdfs:label xml:lang="no">har støper (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has caster family</rdfs:label>
        <rdfs:label xml:lang="de">hat Formgießerin/Formgießer (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gieter-familie</rdfs:label>
        <rdfs:label xml:lang="lv">lējējs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia fundidora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família emmotlladora</rdfs:label>
        <rdfs:label xml:lang="et">valaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">valaja (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">öntvénykészítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مسئولة عن الصب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有铸造者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, sıvı veya eritilmiş maddeyi bir kalıba dökerek ve kalıbın şeklini alması için katılaşmaya bırakarak bir gösterim yaratmakla sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione tramite il versamento di una sostanza liquida o fusa in uno stampo e lasciandola solidificare fino ad assumere la forma dello stampo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy folyékony vagy olvasztott anyagot önt egy öntőformába és hagyja, hogy az megszilárduljon és az öntőforma formáját felvegye.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta muovaamalla sulatettua tai nestemäistä ainetta muotin avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une manifestation en versant un liquide ou une substance fondue dans un moule et en laissant ce liquide ou cette substance se solidifier pour prendre la forme du moule.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una manifestació mitjançant l’abocament d’un líquid o una substància fosa en un motlle tot deixant que se solidifiqui perquè prengui la forma del motlle.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al verter un líquido o sustancia fundida en un molde y dejar que se solidifique para que tome la forma del molde.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het creëren van een manifestatie middels het gieten van een vloeistof of gesmolten substantie in een mal en die te laten stollen in de vorm van die mal.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å helle et flytende eller smeltet stoff i en støpeform og la det stivne i denne formen.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at hælde en væske eller et varmt, flydende stof i en form og lade det størkne, så det tager facon efter formen.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating a manifestation by pouring a liquid or molten substance into a mold and leaving it to solidify to take the shape of the mold.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, lejot veidnē šķidru vai izkausētu vielu un atstājot to sacietēt, lai tā iegūtu veidnes formu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, valades vedela või sulatatud materjali valuvormi, kus materjal tahkub, võttes valuvormi kuju.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie eine Flüssigkeit oder eine geschmolzenen Substanz in eine Form gießt, die in der Gießform verbleibt, bis sie ausgehärtet ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تصنيع تجسيدة بصب السائل أو المادة المذابة في القالب وتركه حتى يجف ليأخذ شكل القالب.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过将液体或融化的物质倒入模具中使其按模具固化成型而对一种载体表现的创建负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30441 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30441">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille lithographe</rdfs:label>
        <rdfs:label xml:lang="it">ha come litografo famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er litograf</rdfs:label>
        <rdfs:label xml:lang="no">har litograf (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has lithographer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Lithografin/Lithografen (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft lithograaf-familie</rdfs:label>
        <rdfs:label xml:lang="hu">kőnyomatkészítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="et">litograaf (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">litografi (suku)</rdfs:label>
        <rdfs:label xml:lang="lv">litogrāfs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">taş baskı sanatçısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia litógrafa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família litògrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة طباع على الحجر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有平版制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, litografik baskı için bir taş veya plaka hazırlayarak bir gösterim yaratmaktan sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, preparando una pietra o lastra per l&apos;impressione litografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy egy követ vagy lemezt készít elő litográfiai nyomtatáshoz, azaz kőnyomathoz.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamiseen valmistamalla litografiassa käytetyn kivilaatan tai muun painolaatan.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une manifestation en préparant une pierre ou une plaque pour l’impression lithographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una manifestació amb la preparació d’una pedra o una planxa per a la impressió litogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al preparar una piedra o placa para impresión litográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het creëren van een manifestatie middels het voorbereiden van een steen of plaat voor lithografisch drukwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å klargjøre en stein eller plate for litografisk trykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at klargøre en sten eller plade til litografisk trykning.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating a manifestation by preparing a stone or plate for lithographic printing.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, sagatavojot akmeni vai iespiedplati litogrāfiskai pavairošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, valmistades ette kivi või plaadi litograafiliste tõmmiste jaoks. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie einen Stein oder eine Platte für lithografischen Druck vorbereitet.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تصنيع تجسيدة بإعداد الحجر أو اللوح للطباعة الحجرية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过制作用于平版印刷的石头或平版而对一种载体表现的创建负责的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A lithographer includes a graphic artist creating a design directly on the surface from which printing will be done.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A litográfus egy grafikusművész, aki közvetlenül azon a felületen készít tervet, amelyről a nyomtatás történik.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Grafikerinnen/Grafiker, die ein Muster direkt auf der Oberfläche erstellen, von der aus gedruckt werden soll.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een lithograaf omvat een grafisch kunstenaar die een ontwerp maakt direct op het oppervlak waarvan gedrukt zal worden.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En litograf inkluderer en grafiker som skaper et design direkte på overflaten som trykkingen vil bli gjort.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Litograaf hõlmab ka graafikut, kes loob kujutise otse pinnale, millelt toimub trükkimine.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Litograf omfatter en grafiker, som skaber et design direkte på overfladen, hvorfra trykning vil blive udført.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Litografi tarkoittaa myös graafikkoa, joka tekee piirroksen suoraan painamiseen käytettävälle pinnalle.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Litogrāfs ir arī grafiķis, kas veido dizainu tieši uz virsmas, no kuras materiāls tiks drukāts.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Taş baskı sanatçısı olan bir aile, basımın yapılacağı yüzey üzerinde doğrudan bir tasarım yaratan grafik sanatçısını içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un lithographe comprend un artiste graphique créant un dessin directement sur la surface à partir de laquelle l’impression sera effectuée.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un litografo comprende un artista grafico che crea un disegno direttamente sulla superficie da cui viene effettuata la stampa.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un litògraf inclou un artista gràfic que crea un disseny directament sobre la superfície a partir de la qual es farà la impressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un litógrafo incluye un artista gráfico que está creando un diseño directamente sobre la superficie desde la cual se realizará la impresión.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل الطباع على فنان الجرافيك الذي يصمم بشكل مباشر على السطح الذي سيتم منه الطباعة مباشرة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">平版制作者包括直接在用于印刷的表面进行设计创作的平面美术家</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30442 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30442">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille clicheuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come preparatore di lastre famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er plademager</rdfs:label>
        <rdfs:label xml:lang="no">har trykkplatemaker (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has platemaker family</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckformherstellerin/Druckformhersteller (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft platenmaker-familie</rdfs:label>
        <rdfs:label xml:lang="tr">levhacı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomólemez-készítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painolaatan valmistaja (suku)</rdfs:label>
        <rdfs:label xml:lang="lv">presformas izgatavotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia fabricante de placas</rdfs:label>
        <rdfs:label xml:lang="et">trükiplaadi valmistaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família gravadora de planxes</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مصممة لوحات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制版者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterimdeki basılmış görüntüler veya metin yaparken kullanılan plakaları hazırlamakla sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, preparando lastre utilizzate nella produzione di immagini o testo stampati.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely egy felelős megjelenési forma gyártásáért oly módon, hogy nyomtatott képek vagy szövegek előállításánál használt lemezeket készít elő.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta valmistamalla painettujen kuvien tai tekstin valmistuksessa käytettäviä painolaattoja tai -levyjä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la préparation des planches utilisées dans la réalisation d’images ou de textes imprimés dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la preparació de les planxes usades en l’elaboració d’imatges o de text imprès.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al preparar placas utilizadas en la elaboración de imágenes o texto impreso.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het prepareren van platen gebruikt in het maken van gedrukte beelden of tekst in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å klargjøre trykkplater som brukes ved produksjon av trykte bilder og/eller tekst.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at forberede plader, som anvendes til fremstilling af trykte billeder eller tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for preparing plates used in the making of printed images or text in a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, sagatavojot plāksnes, ko izmanto iespiestu attēlu vai teksta izgatavošanā.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, valmistades ette plaadid piltide või teksti trükkimiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Druckformen für die Produktion von gedruckten Bildern oder gedrucktem Text anfertigt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تصنيع تجسيدة بإعداد اللوحات المستخدمة في إنتاج الصور المطبوعة أو النص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责准备用于在一种载体表现中制作印刷图像或文字的印版的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30443 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30443">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille aquafortiste</rdfs:label>
        <rdfs:label xml:lang="fi">etsaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="it">ha come acquafortista famiglia </rdfs:label>
        <rdfs:label xml:lang="no">har etser (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er raderer</rdfs:label>
        <rdfs:label xml:lang="en">has etcher family</rdfs:label>
        <rdfs:label xml:lang="de">hat Radiererin/Radierer (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft etser-familie</rdfs:label>
        <rdfs:label xml:lang="hu">karckészítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">ofortists (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">oymacı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">söövitaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia aguafuertista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família aiguafortista</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة حفار زنكوغراف (كليشيهات)</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有蚀刻者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; baskı için kullanılan metal, cam veya diğer bazı yüzeyleri asit veya başka bir aşındırıcı maddeye maruz bırakarak bir gösterim oluşturmakla sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, sottoponendo all&apos;acido o a un&apos;altra sostanza corrosiva, del metallo, vetro o altra superficie utilizzata per la stampa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy nyomtatáshoz használt fém-, üveg- vagy valamilyen más felületet savnak vagy más maró anyagnak vet alá.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta etsaamalla metallia, lasia tai muuta pintaa hapon tai muun syövyttävän aineen avulla.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une manifestation en soumettant à l’acide ou à une autre substance corrosive du métal, du verre ou une autre surface utilisée pour l’impression.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una manifestació sotmetent a l’àcid, o a qualsevol altra substància corrosiva, el metall, el vidre o qualsevol altra superfície usada en la impressió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al someter metal, vidrio u otra superficie utilizada para imprimir a un ácido u otra sustancia corrosiva.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het creëren van een manifestatie middels het blootstellen van metaal, glas of een ander oppervlak gebruikt voor het drukproces, aan zuur of een ander bijtend middel.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å utsette metall, glass eller et annet overflatemateriale som brukes til trykking, for syre eller et annet etsende stoff.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation ved at udsætte metal, glas eller en anden overflade, som anvendes til trykning, for syre eller andet ætsende stof.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating a manifestation by subjecting metal, glass, or some other surface used for printing, to acid or another corrosive substance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, pakļaujot metāla, stikla vai kādu citu drukāšanai paredzētu virsmu skābei vai citai kodīgai vielai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, töödeldes happe või muu söövitava ainega trükkimiseks kasutatavat metallist, klaasist või muust materjalist pinda.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie Metall, Glas oder eine andere Oberfläche, die zum Drucken benutzt wird, mit Säure oder einer anderen ätzenden Substanz behandelt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تصنيع تجسيدة لإخضاع المعدن، أو الزجاج، أو أي سطح آخر يستخدم في الطباعة، بالحمض أو أي مادة أخرى كاوية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过使用酸或其他腐蚀性物质施于用来印刷的金属、玻璃或其他表面上而对一种载体表现的创建负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30444 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30444">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille phototypeuse</rdfs:label>
        <rdfs:label xml:lang="lv">fotogravieris (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">fénynyomatkészítő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come collotipista famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er lystrykker</rdfs:label>
        <rdfs:label xml:lang="no">har lystrykker (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has collotyper family</rdfs:label>
        <rdfs:label xml:lang="de">hat Lichtdruckerin/Lichtdrucker (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft collotype-familie</rdfs:label>
        <rdfs:label xml:lang="fi">kollotypian valmistaja (suku)</rdfs:label>
        <rdfs:label xml:lang="et">kollotüübi valmistaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="tr">kolotip baskıcı aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia colotipiadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família fototipista</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة طباع صور</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有珂罗版制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, mürekkep alıcı ve mürekkep itici yüzeylere sahip olan ve bir fotomekanik işlem kullanarak baskılar yapmak için kullanılan sertleştirilmiş bir jelatin veya diğer kolloid filmini hazırlayarak bir gösterim oluşturmakla sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione, utilizzando un processo fotomeccanico per realizzare stampe direttamente da un film indurito di gelatina o altro colloide che ha superfici ricettive o repellenti all&apos;inchiostro.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy megjelenési forma gyártásáért oly módon, hogy fotómechanikai eljárás alkalmazásával nyomtatványokat állít elő közvetlenül olyan zselatin vagy más kolloid megkeményedett filmjéből, amelynek tintafelvevő és tintataszító felülete van.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaation valmistamisesta tekemällä vedoksia suoraan kovettuneelta gelatiinifilmiltä tai muulta materiaalilta, jossa on mustetta imeviä ja hylkiviä pintoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la création d’une manifestation en préparant un film durci de gélatine ou d’un autre colloïde présentant des surfaces réceptives et répulsives à l’encre et servant à réaliser des images imprimées à l’aide d’un procédé photomécanique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la creació d’una manifestació mitjançant la preparació d’una pel·lícula endurida de gelatina o d’un altre col·loide que té superfícies que accepten o rebutgen la tinta i que s’usa per fer gravats usant un procés fotomecànic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de crear una manifestación al preparar una película endurecida de gelatina u otro coloide que tenga superficies receptoras y repelentes de tinta y que es utilizada para realizar impresiones mediante un proceso fotomecánico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die is verantwoordelijk voor het creëren van een manifestatie middels het prepareren van een verharde film van gelatine of ander colloïde dat inktopnemende en inktafstotende oppervlakken heeft en die gebruikt wordt voor het maken van afdrukken met gebruikmaking van een fotomechanisch proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon ved å bruke en fotomekanisk prosess for å lage kopier direkte fra en stivnet film av gelatin eller et annet kolloid som har overflater som er mottagelige for blekk og motstandige mot blekk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation vha. en fotomekanisk proces, hvorved der laves tryk direkte fra et hærdet gelatinelag eller andet kolloid, som har blækmodtagelige og blækafvisende overflader.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for creating a manifestation by preparing a hardened film of gelatin or other colloid that has ink-receptive and ink-repellent surfaces and that is used to make prints using a photomechanical process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta manifestācijas ražošanā, izmantojot fotomehānisku procesu, lai izgatavotu izdrukas tieši no plates, kas pārklāta ar gaismjutīga hromželatīna slāni vai citu koloīdu, kuram ir tinti piesaistošas un tinti atgrūdošas virsmas.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb kehastuse valmistamises, tehes fotomehaanilises protsessis tõmmiseid otse želatiini või muu kolloidi tahkunud kihilt, mille pind osalt seob värvainet, osalt ei seo. </skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation verantwortlich ist, indem sie ein fotomechanisches Verfahren zur Herstellung von Abzügen direkt von einem gehärteten Film aus Gelatine oder einem anderen Kolloid verwendet, der druckerfarbenaufnehmende und -abweisende Oberflächen aufweist.</skos:definition>
        <skos:definition xml:lang="ar">يربط تجسيدة وعائلة مسئولة عن تصنيع تجسيدة باستخدام عمليات ضوئية ميكانيكية لإنتاج المطبوعات مباشرة من فيلم صلد من الجيلاتين أو غيره من المواد الغروية التى تحتوي أسطح مستقبلة وطاردة للحبر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与通过利用一面吸墨而另一面不吸墨的明胶或其他硬胶片进行影印对一种载体表现的创建负责的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30445 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30445">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille imprimeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come stampatore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er trykker</rdfs:label>
        <rdfs:label xml:lang="no">har trykker (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has printer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Druckerin/Drucker (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft drukker-familie</rdfs:label>
        <rdfs:label xml:lang="lv">iespiedējs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="tr">matbaacı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">nyomdász családja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">painaja (suku)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia impresora</rdfs:label>
        <rdfs:label xml:lang="et">trükkija (perekond)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família impressora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة طابع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有印刷者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; basılmış metin, notalı müzik veya türden ya da plakadan alınmış diğer içeriklerin üretiminden sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia coinvolta nella manifattura di una manifestazione di testo a stampa, musica notata, etc., da tipi o lastre, come un libro, un giornale, una rivista, un volantino, una partitura, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy nyomtatott szöveg, zenei lejegyzés vagy egyéb tartalom megjelenési formájának nyomdai szedésből vagy lemezekből történő gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa painetun tekstin, nuottiaineiston tai muun sisällön manifestaation valmistamiseen painolaatalta tai -levyltä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la fabrication d’une manifestation imprimée matérialisant du texte, de la musique notée, un contenu cartographique, du mouvement noté ou un contenu visuel fixe à l’aide d’un dispositif qui transfère de l’encre ou un médium semblable sur une surface.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la fabricació d’una manifestació impresa que materialitza text, música notada, imatge cartogràfica, moviment notat o contingut d’imatge fixa usant un mecanisme que transfereix tinta o un mitjà similar a una superfície.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de fabricar una manifestación impresa que materializa texto, música notada, imagen cartográfica, movimiento notado o contenido de imagen fija utilizando un dispositivo que transfiere tinta o un medio similar a una superficie.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het vervaardigen van een gedrukte manifestatie die omvat tekst, bladmuziek, cartografische content, bewegingsnotatie, of stilstaand beeld-content met gebruik van een apparaat that inkt of een soortgelijk medium overbrengt op een oppervlak.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er involvert i framstillingen av en manifestasjon av trykt tekst, nedskrevet musikk, etc., ved hjelp av typer eller plater, f.eks. en bok, en avis, et tidsskrift, en løpeseddel eller et partitur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er involveret i fremstillingen af en manifestation af trykt tekst, noteret musik etc. fra typer eller plader, såsom en bog, en avis, et magasin, et tværformat, et partitur etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for manufacturing a printed manifestation that embodies text, notated music, cartographic image, notated movement, or still image content using a device that transfers ink or a similar medium to a surface.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas iesaistīta iespiesta teksta, nošu u.tml. manifestāciju ražošanā no burtu salikuma vai plāksnēm.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes osaleb trükise, noodi vms kehastuse valmistamisel, trükkides trükilaolt või -plaadilt raamatuid, ajalehti, ajakirju, plakateid, partituure jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Herstellung einer Manifestation von gedrucktem Text, Noten oder anderem Inhalt durch Drucktypen oder Druckformen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن صناعة تجسيدة لنص مطبوع، أو موسيقى مدونة، إلخ، من صفحة أو لوحة، مثل كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقيه، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责生产用活字或平版印刷文字、乐谱或其他内容的一种载体表现的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend la fabrication d’un livre, d’un journal, d’un magazine, d’un placard ou d’une partition.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Herstellung eines Buchs, einer Zeitung, eines Magazins, eines Einblattdrucks oder einer Partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Idetartozik egy könyv, hírlap, magazin, egyoldalas nyomtatvány vagy partitúra gyártója.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver grāmatas, laikraksta, žurnāla, plakāta, vai partitūras ražošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la fabricació d’un llibre, un diari, un magazín, un full solt o una partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes the manufacture of a book, newspaper, magazine, broadside, or score.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye la fabricación de un libro, periódico, revista, andanada o partitura.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter produktion af en bog, avis, tidsskrift, tværformat eller partitur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat de vervaardiging van een boek, krant, tijdschrift, pamfletvel of partituur.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Sisältää kirjan, sanomalehden, aikakauslehden, julisteen tai partituurin valmistamisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">matbaacı ailesi ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">ويشمل صناعة كتاب، أو صحيفة، أو مجلة، أو ملصق، أو نوتة موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括图书、报纸、杂志、大张印刷品或总谱的生产。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30446 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30446">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille diffuseuse ou distributrice</rdfs:label>
        <rdfs:label xml:lang="tr">dağıtımcı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come distributore famiglia</rdfs:label>
        <rdfs:label xml:lang="no">har distributør (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er distributør</rdfs:label>
        <rdfs:label xml:lang="en">has distributor family</rdfs:label>
        <rdfs:label xml:lang="de">hat Vertrieb (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft distributeur-familie</rdfs:label>
        <rdfs:label xml:lang="lv">izplatītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">jakelija (suku)</rdfs:label>
        <rdfs:label xml:lang="et">levitaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">terjesztő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia distribuidora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família distribuïdora</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة موزع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发行者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayımlanmış gösterimin dağıtımından sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia responsabile della distribuzione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely egy kiadott megjelenési forma terjesztéséért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa julkaistun manifestaation jakelusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la diffusion ou de la distribution d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la distribució d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de distribuir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het distribueren van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er ansvarlig for å distribuere en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er ansvarlig for at distribuere en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for distributing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir atbildīga par manifestācijas izplatīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes vastutab kehastuse levitamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für den Vertrieb einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن توزيع تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责发行一种出版载体表现的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30447 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30447">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille productrice d’une manifestation non publiée</rdfs:label>
        <rdfs:label xml:lang="et">avaldamata kehastuse tootja (perekond)</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di manifestazione non pubblicata famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er producer af upubliceret manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har produsent av upublisert manifestasjon (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has producer family of unpublished manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Erzeugerin/Erzeuger einer unveröffentlichten Manifestation (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-familie van ongepubliceerde manifestatie</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisemattoman manifestaation tuottaja (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadatlan megjelenési forma előállító családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">nepublicētas manifestācijas izgatavotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia productora de manifestación inédita</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família productora d’una manifestació no publicada</rdfs:label>
        <rdfs:label xml:lang="tr">yayınlanmamış gösterimin yapımcı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منتجة لتجسيدة غير منشورة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有非出版载体表现的制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi; yazım, üretim, yapım veya yayımlanmamış gösterimi üretmek için başka yöntemlerden sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia responsabile della iscrizione, fabbricazione, costruzione, etc. di una manifestazione non pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy kiadatlan megjelenési forma írásáért, összeállításáért, készítéséért vagy egyéb módú előállításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa julkaisemattoman manifestaation kaiverruksesta, valmistuksesta, kokoonpanosta tai muusta tuotantotavasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la scription, de la fabrication, de la construction ou de toute autre méthode de production d’une manifestation non publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la inscripció, la fabricació, la construcció o un altre mètode de producció d’una manifestació no publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de inscribir, fabricar, construir o producir mediante otro método una manifestación inédita.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het afschrijven, fabriceren, construeren of andere methode van het produceren van een ongepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er ansvarlig for å inskribere, fabrikere, konstruere etc. en upublisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er ansvarlig for indskrift, fremstilling, konstruktion etc. af en upubliceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for inscribing, fabricating, constructing, or other method of producing an unpublished manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir atbildīga par nepublicētās manifestācijas pierakstīšanu, izgatavošanu, radīšanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes vastutab avaldamata kehastuse inskribeerimise, tootmise, ehitamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für das Gravieren, Fabrizieren, Konstruieren oder eine andere Entstehungsmethode einer unveröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن تسجيل، أو تصنيع، أو إنشاء، إلخ. تجسيدة غير منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责镌刻、制造、构建或其他方法制作一种非出版载体表现的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30448 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30448">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille fabricante</rdfs:label>
        <rdfs:label xml:lang="hu">gyártó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come manifattura famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er producent</rdfs:label>
        <rdfs:label xml:lang="no">har tilvirker (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has manufacturer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Herstellerin/Hersteller (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft vervaardiger-familie</rdfs:label>
        <rdfs:label xml:lang="lv">ražotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia fabricante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família fabricant</rdfs:label>
        <rdfs:label xml:lang="et">valmistaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">valmistaja (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">üretici ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة صانع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有生产者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, basım, çoğaltma, döküm veya yayımlanmamış gösterimi üretmenin başka yöntemlerinden sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia responsabile della stampa, riproduzione, fusione, etc. di una manifestazione pubblicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy kiadott megjelenési forma nyomtatásáért, sokszorosításáért, öntéséért vagy egyéb módú gyártásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa julkaistun manifestaation painamisesta, monistamisesta, kirjasinten valamisesta tai muusta valmistustavasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de l’impression, de la reproduction, du moulage ou de toute autre méthode de fabrication d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la impressió, la reproducció, el modelat o un altre mètode de fabricació d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de imprimir, duplicar, fundir, etc. manufacturar mediante otro método una manifestación inédita.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het drukken, vermeerderen, gieten of andere methode van het vervaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er ansvarlig for å trykke, mangfoldiggjøre, etc. en publisert manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er ansvarlig for trykning, duplikering, støbning etc. af en publiceret manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for printing, duplicating, casting, or other method of manufacturing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir atbildīga par resursa publicējamās formas drukāšanu, pavairošanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes vastutab avaldatud kehastuse trükkimise, paljundamise, valamise vms eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für den Druck, die Vervielfältigung, den Guss oder eine andere Herstellungsmethode einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن طباعة، أو نسخ، أو صب، إلخ. تجسيدة منشورة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责印刷、复制、铸造或其他方法生产一种出版载体表现的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30449 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30449">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille éditrice</rdfs:label>
        <rdfs:label xml:lang="es">es familia editorial</rdfs:label>
        <rdfs:label xml:lang="it">ha come editore famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er udgiver</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has publisher family</rdfs:label>
        <rdfs:label xml:lang="de">hat Verlag (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitgever-familie</rdfs:label>
        <rdfs:label xml:lang="lv">izdevējs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">kiadó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="et">kirjastaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">kustantaja (suku)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família editora</rdfs:label>
        <rdfs:label xml:lang="tr">yayıncı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة ناشر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有出版者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, yayımlama, satma veya yayımlanmış gösterimin ihracından sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia responsabile della pubblicazione, diffusione o emissione di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy kiadott megjelenési forma kiadásáért, kibocsájtásáért vagy megjelentetéséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa julkaistun manifestaation kustantamisesta, julkaisemisesta tai ilmestymisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la publication, de la mise à disposition ou de l’édition d’une manifestation publiée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la publicació, la posada en circulació o l’emissió d’una manifestació publicada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de editar, lanzar o emitir una manifestación publicada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het uitgeven, uitbrengen of uitvaardigen van een gepubliceerde manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er ansvarlig for å publisere, tilgjengeliggjøre eller utgi en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er ansvarlig for at publicere, frigive eller udgive en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for publishing, releasing, or issuing a published manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir atbildīga par resursa izdošanu, publicēšanu vai izlaišanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes vastutab kehastuse avaldamise, väljalaskmise või väljaandmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für das Veröffentlichen, die Freigabe oder die Herausgabe einer veröffentlichten Manifestation verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن نشر، أو إصدار تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责出版、发布或发行一种出版载体表现的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30450 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30450">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille créatrice d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin yaratıcı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore di manifestazione famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er ophav til manifestation</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av manifestasjon (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has creator family of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Mitwirkende/Mitwirkenden an einer Manifestation (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-familie van manifestatie</rdfs:label>
        <rdfs:label xml:lang="et">kehastuse teostaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">manifestaation tekijä (suku)</rdfs:label>
        <rdfs:label xml:lang="lv">manifestācijas radītājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="hu">megjelenési forma létrehozó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia creadora de manifestación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família creadora d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منشئ لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有载体表现的创建者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir veya daha fazla ifadenin somutlaştırılmasından sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia responsabile della materializzazione di una o più espressioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely felelős egy vagy több kifejezési forma megtestesüléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaatioon sukuun, joka on vastuussa yhden tai useamman ekspression ilmiasusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la matérialisation d’une ou plusieurs expressions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de la materialització d’una o més expressions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable de la materialización de una o más expresiones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestie aan een familie die verantwoordelijk is voor de verwezenlijking van één of meer expressies.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er ansvarlig for realiseringen av ett eller flere uttrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er ansvarlig for realiseringen af et eller flere udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for the embodiment of one or more expressions.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir atbildīga par vienas vai vairāku izteiksmju ietveršanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes vastutab ühe või mitme väljenduse teostamise eest kehastusena.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Verkörperung einer Expression oder mehrerer Expressionen verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن عملية تجسيد تعبيرة أو أكثر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种或多种内容表达之具体化的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of manifestation includes a manufacturer, producer, and publisher.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Hersteller, Produzentinnen/Produzenten und Verlage.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van manifestatie omvat een vervaardiger, producent en uitgever.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy megjelenési forma létrehozója magában foglalja a gyártót, az előállítót és a kiadót.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En skaper av en manifestasjon inkluderer distributør, tilvirker, produsent og utgiver.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Gösterimin yaratıcısı, bir üretimci, yapımcı ve yayıncıyı içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Kehastuse teostaja hõlmab levitajat, valmistajat, tootjat ja kirjastajat.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Manifestaation tekijä sisältää jakelijan, valmistajan, tuottajan ja kustantajan.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Manifestācijas radītāji ir arī izplatītāji, ražotāji, izgatavotāji un izdevēji.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til manifestation omfatter distrubutør, producent, producer og udgiver ect.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de manifestación incluye un fabricante, productor y editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una manifestació inclou un fabricant, un productor i un editor.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di manifestazione comprende un distributore, manifattura, produttore e editore.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une manifestation comprend un fabricant, un producteur et un éditeur.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشتمل منشئ التجسيدة على الموزع، والصانع، والمنتج، والناشر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">载体表现的创建者包括生产者、制作者和出版者</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30451 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30451">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour famille papetière</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore di carta famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er papirproducent</rdfs:label>
        <rdfs:label xml:lang="no">har papirprodusent (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has papermaker family</rdfs:label>
        <rdfs:label xml:lang="de">hat Papiermacherin/Papiermacher (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft papierproducent-familie</rdfs:label>
        <rdfs:label xml:lang="tr">kağıt üreticisi ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">paberivalmistaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">paperinvalmistaja (suku)</rdfs:label>
        <rdfs:label xml:lang="hu">papírgyártó családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">papīra izgatavotājs (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia papelera</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família paperera</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة صانع ورق</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有造纸者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, gösterimde kullanılan kağıtları üretmekten sorumlu aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla una manifestazione alla famiglia responsabile della produzione della carta utilizzata per la manifattura di una manifestazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy családhoz, amely egy megjelenési forma gyártásához használt papír előállításáért felelős.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation sukuun, joka on vastuussa manifestaatioon käytettävän paperin valmistamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une famille qui est responsable de la confection du papier utilisé dans une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una família que és responsable de l’elaboració del paper usat en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una familia que es responsable por la elaboración de papel utilizado en una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een familie die verantwoordelijk is voor het maken van papier gebruikt in een manifestatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer en manifestasjon til en familie som er ansvarlig for produksjonen av papir brukt til å framstille en manifestasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en familie, som er ansvarlig for fremstilling af papir, som anvendes til fremstilling af en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to a family who is responsible for the making of paper used in a manifestation. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar dzimtu/ģimeni, kas ir atbildīga par papīra izgatavošanu, kas izmantots ražošanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab kehastuse perekonnaga, kes vastutab kehastuse valmistamiseks kasutatud paberi tootmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Familie, die für die Produktion von Papier verantwortlich ist, das zur Herstellung einer Manifestation verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة وعائلة مسئولة عن إنتاج الورق المستخدم في صناعة تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与负责一种载体表现中所使用的纸张之制造的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30452 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30452">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour contenu accessible</rdfs:label>
        <rdfs:label xml:lang="hu">akadálymentesített tartalma a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">erişilebilirlik içeriği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="da">har tilgængelighedsfremmende indhold</rdfs:label>
        <rdfs:label xml:lang="en">has accessibility content</rdfs:label>
        <rdfs:label xml:lang="de">hat barrierefreien Inhalt</rdfs:label>
        <rdfs:label xml:lang="nl">heeft toegankelijkheidscontent</rdfs:label>
        <rdfs:label xml:lang="fi">saavutettavuussisältö</rdfs:label>
        <rdfs:label xml:lang="es">tiene contenido de accesibilidad</rdfs:label>
        <rdfs:label xml:lang="ca">té com a contingut d’accessibilitat</rdfs:label>
        <rdfs:label xml:lang="lv">uztveri atbalstošs saturs</rdfs:label>
        <rdfs:label xml:lang="ar">له محتوى إتاحة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有无障碍内容</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün artırım tarafından somutlaştırılmış ana ifadeleri algılamak için alternatif duyusal modlar sağlayan ifadenin türlerinin gösterimiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kifejezési forma azon típusainak a jelöléséhez, amelyek alternatív érzékelési módokat nyújtanak a bővülésből eredő aggregátumban megtestesülő fő kifejezési forma észleléséhez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation ilmaukseen niistä ekspressioista, jotka tarjoavat vaihtoehtoisia aistintatapoja laajennusaggregaatin sisältämien pääekspressioiden vastaanottamiseksi.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une indication des genres d’expressions qui fournissent des modes sensoriels de remplacement pour percevoir les expressions principales matérialisées par un agrégat par augmentation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una indicació de les classes d’expressió que proporcionen modes sensorials alternatius per percebre les expressions principals que es materialitzen en un agregat d’augmentació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una indicación de los tipos de expresión que proveen modos sensoriales alternativos para percibir la expresión principal que están materializados por un agregado de aumento.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een indicatie van de soorten expressies die alternatieve zintuiglijke modi bieden om de hoofd-expressie waar te nemen die verwezenlijkt zijn in een augmentatie-aggregaat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en indikation af de typer af udtryk der giver alternative sansemåder for at forstå de hovedudtryk der er indholdt i en beriget samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an indication of the kinds of expression that provide alternative sensory modes to perceive the main expressions that are embodied by an augmentation aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar norādi par saturu, kas nodrošina alternatīvas maņu metodes, lai uztvertu sākotnējo saturu.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Angabe der Expressionsarten, die alternative, sensorische Formen liefern, um die Hauptexpressionen wahrzunehmen, die durch ein Erweiterungsaggregat verkörpert werden.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومؤشر لأنواع التعبير التي توفر بديلًا لإدراك التعبير الأساسي الذي يتم تجسيده بواسطة إضافة تجميعة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与提供用于感知被一种附增合集具体化的主要内容表达的交替感官模式的内容表达的类型的指示关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Accessibility content includes accessible labels, an audio description, captioning, image descriptions, sign language, and subtitles. Accessibility content does not include subtitles in a language different from the spoken content.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Az akadálymentesített tartalmak magukban foglalnak akadálymentes címkéket, hangzó leírást, képleírást, jelnyelvet és feliratozást. Az akadálymentesített tartalmakba nem tartoznak bele a beszélt tartalomtól eltérő nyelvű feliratok.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">El contenido de accesibilidad incluye etiquetas accesibles, una descripción de audio, subtítulos descriptivos, lenguaje de señas y subtítulos. El contenido de accesibilidad no incluye subtítulos en un idioma diferente al del contenido hablado.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">El contingut d’accessibilitat inclou etiquetes accessibles, una descripció àudio, subtitulació per a persones sordes, descripcions d’imatges, llenguatge de signes i subtítols. El contingut d’accessibilitat no inclou subtítols en una llengua diferent a la del contingut parlat.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Erişilebilirlik içeriği, erişilebilir etiketler, sesli açıklama, resim açıklamaları, işaret dili ve altyazıları içerir. Erişilebilirlik içeriği, konuşulan içerikten farklı bir dilde altyazı içermez.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Saavutettavuussisältö sisältää saavutettavat nimikkeet, kuunneltavan kuvauksen, otsikoinnin, kuvien kuvauksen, viittomakielen ja tekstityksen. Saavutettavuussisältö ei sisällä tekstitystä, joka eroaa puhutusta sisällöstä.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Satura pieejamība ietver uzlīmes, audio aprakstu, parakstus (zem ilustrācijām), attēla aprakstu, žestu valodu un titrus. Satura pieejamība neietver titrus, kas atšķiras no runātas valodas.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Tilgængelighedsfremmende indhold indeholder tilgængelighedsbetegnelser, lydbeskrivelse, rubrikker, billedbeskrivelser, tegnsprog og undertekster. Tilgængelighedsfremmende indhold indbegriber ikke undertekster i et sprog der ikke er det samme som det talte sprog.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Toegankelijkheidscontent omvat toegankelijke labels, een audiobeschrijving, bijschriften, beeldbeschrijvingen, gebarentaal en ondertitells. Toegankelijkheidscontent omvat niet ondertitels in een taal anders dan de gesproken content.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un contenu accessible comprend une description audio, les descriptions d’images, les étiquettes accessibles, la langue des signes, le sous-titrage pour malentendants et les sous-titres. Un contenu accessible ne comprend pas les sous-titres dans une langue différente de celle du contenu parlé.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Zum barrierefreien Inhalt gehören barrierefreie Labels, eine Audiodeskription, Untertitel für Hörgeschädigte, Bildbeschreibungen, Gebärdensprache und Untertitel. Zum barrierefreien Inhalt gehören nicht die Untertitel in einer Sprache, die von dem gesprochenen Inhalt abweichen.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتضمن المحتوى التَسهيلي ملصقات يمكن الوصول إليها، وصف صوتي، تعليق، وصف الصور، لغة إشارة، وترجمات. ولا يتضمن محتوى الإتاحة ترجمات بلغة مختلفة عن المحتوى المنطوق.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">无障碍内容包括无障碍标签、音频描述、说明文字、图像描述、记号语言和字幕。无障碍内容不包括不同于口语内容的另一种语言的字幕。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30453 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30453">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour contenu illustratif</rdfs:label>
        <rdfs:label xml:lang="da">har illustrativt indhold</rdfs:label>
        <rdfs:label xml:lang="en">has illustrative content</rdfs:label>
        <rdfs:label xml:lang="de">hat illustrierenden Inhalt</rdfs:label>
        <rdfs:label xml:lang="nl">heeft illustratieve content</rdfs:label>
        <rdfs:label xml:lang="hu">illusztratív tartalma a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">ilustratīvs saturs</rdfs:label>
        <rdfs:label xml:lang="fi">kuvasisältö</rdfs:label>
        <rdfs:label xml:lang="tr">resimleyici içerik ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene contenido ilustrativo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a contingut il·lustratiu</rdfs:label>
        <rdfs:label xml:lang="ar">له محتوى توضيحي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有插图内容</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün artırım tarafından somutlaştırılmış ana ifadeleri destekleyen resim içeriğinin ifadesinin türlerinin gösterimiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy képi tartalom azon kifejezésiforma-típusainak a jelöléséhez, amelyek kiegészítik az aggregátumban megtestesülő fő kifejezési formákat.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation ilmaukseen niistä kuvasisällön ekspressioista, jotka täydentävät laajennusaggregaatin sisältämiä pääekspressioita.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une indication des genres d’expressions de contenu visuel qui complètent les expressions principales matérialisées par un agrégat par augmentation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una indicació de les classes d’expressió de contingut d’imatge que complementen les expressions principals que es materialitzen en un agregat d’augmentació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una indicación de los tipos de expresión que proveen modos sensoriales alternativos para percibir la expresión principal que están materializados por un agregado de aumento.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een indicatie van de soorten expressies van beeldcontent die de hoofd-expressies aanvullen die verwezenlijkt zijn door een augmentatie-aggregaat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en indikation af de typer af udtryk af billedindhold der supplerer det hovedudtryk som er indholdt i en beriget samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an indication of the kinds of expression of image content that supplement the main expressions that are embodied by an augmentation aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar norādi par saturu, kas paredzēts izteiksmes pamatsatura ilustrācijai.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Angabe der Expressionsarten von Bildinhalt, die die Hauptexpressionen ergänzt, welche durch ein Erweiterungsaggregat verkörpert werden.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومؤشر لأنواع محتوى الصورة التي تُكمل التعبيرات الأساسية التي يتم تجسيدها بواسطة إضافة تجميعة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与补充被一种附增合集具体化的主要内容表达的图像内容的内容表达的类型的指示关联起来。</skos:definition>
        <skos:scopeNote xml:lang="es">El contenido ilustrativo aplica a un agregado que materializa una expresión con un valor de &quot;imagen cartográfica&quot;, &quot;imagen cartográfica en movimiento&quot;, &quot;imagen cartográfica táctil&quot;, &quot;forma cartográfica táctil tridimensional&quot;, &quot;forma cartográfica tridimensional&quot;, &quot;imagen tridimensional en movimiento&quot;, &quot;imagen bidimensional en movimiento&quot;, &quot;forma táctil tridimensional&quot;, &quot;imagen fija&quot; o &quot;imagen táctil&quot; para tipo de contenido. Las tablas que solo contienen palabras o datos numéricos se excluyen.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">El contingut il·lustratiu s’aplica a un agregat que materialitza una expressió amb un valor de &quot;imatge cartogràfica&quot;, &quot; imatge cartogràfica en moviment&quot;, &quot;imatge cartogràfica tàctil&quot;, &quot; forma cartogràfica tàctil tridimensional&quot;, &quot; forma cartogràfica tridimensional&quot;, &quot;imatge en moviment tridimensional&quot;, &quot;imatge en moviment bidimensional&quot;, &quot;forma tridimensional tàctil&quot;, &quot;forma tridimensional&quot;, &quot;imatge fixa&quot; o &quot;imatge tàctil&quot; per al tipus de contingut. S’exclouen les taules que només contenen paraules o dades numèriques.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Illustrative content applies to an aggregate that embodies an expression with a value of &quot;cartographic image&quot;, &quot;cartographic moving image&quot;, &quot;cartographic tactile image&quot;, &quot;cartographic tactile three-dimensional form&quot;, &quot;cartographic three-dimensional form&quot;, &quot;three-dimensional moving image&quot;, &quot;two-dimensional moving image&quot;, &quot;tactile three-dimensional form&quot;, &quot;three-dimensional form&quot;, &quot;still image&quot;, or &quot;tactile image&quot; for content type. Tables containing only words or numerical data are excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Illustrativt indhold gælder for en samling der er indholdt i et udtryk med værdien &quot;karotgrafisk billede&quot;, &quot;kartografisk levende billede&quot;, &quot;kartografisk taktil billede&quot;, &quot;kartografisk taktil tredimensional billede&quot;, &quot;tredimensional levende billede&quot;, &quot;todimensional levende billede&quot;, &quot;taktil tredimensional form&quot;, &quot;tredimensional form&quot;, &quot;stillbillede&quot;, eller &quot;taktilt billede&quot; som indholdstype. Tabeller der ikke indholder ord eller numeriske data udelades.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Illustrierender Inhalt bezieht sich auf ein Aggregat, das eine Expression mit dem Wert kartografisches Bild, kartografisches Bewegtbild, kartografisches taktiles Bild, kartografische taktile dreidimensionale Form, kartografische dreidimensionale Form, dreidimensionales Bewegtbild, zweidimensionales Bewegtbild, taktile dreidimensionale Form, dreidimensionale Form, unbewegtes Bild oder taktiles Bild für den Inhaltstyp verkörpert. Darunter fallen keine Tabellen, die nur Wörter oder numerische Daten enthalten.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Illusztrációul szolgáló tartalom azon aggregátumra vonatkozik, amelyben megtestesülhet egy kifejezési forma a következő tartalomtípusokra vonatkozó értékekkel: „kartográfiai kép”, „kartográfiai mozgókép”, „tapintható térkép”, „háromdimenziós tapintható kartográfiai forma”, „háromdimenziós kartográfiai forma”, „háromdimenziós mozgókép”, „kétdimenziós mozgókép”, „tapintható háromdimenziós forma”, „háromdimenziós forma”, „állókép” és „tapintható kép”. A csak szavakat vagy számadatokat tartalmazó táblázatok nem tartoznak ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kuvasisältöä sovelletaan aggregaatteihin, jotka sisältävät ekspression, jonka sisältötyypin arvo on &quot;kartografinen kuva&quot;, &quot;kartografinen liikkuva kuva&quot;, &quot;kartografinen taktiili kuva&quot;, &quot;kartografinen taktiili kolmiulotteinen muoto&quot;, &quot;kartografinen kolmiulotteinen muoto&quot;, &quot;kolmiulotteinen liikkuva kuva&quot;, &quot;kaksiulotteinen liikkuva kuva&quot;, &quot;taktiili kolmiulotteinen muoto&quot;, &quot;kolmiulotteinen muoto&quot;, &quot;stillkuva&quot; tai &quot;taktiili kuva&quot;. Vain tekstiä ja numeerisia tietoja sisältävät taulukot eivät sisälly kuvasisältöön.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le contenu illustratif s’applique à un agrégat matérialisant une expression ayant une valeur de &amp;laquo;&amp;nbsp;forme cartographique tridimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;forme cartographique tridimensionnelle tactile&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;forme tridimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;forme tridimensionnelle tactile&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image animée bidimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image animée tridimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image cartographique&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image cartographique animée&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image cartographique tactile&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image fixe&amp;nbsp;&amp;raquo; ou &amp;laquo;&amp;nbsp;image tactile&amp;nbsp;&amp;raquo; pour type de contenu. Les tableaux ne contenant que des mots ou des données numériques sont exclus.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver tabulas, kurās ir tikai vārdi un/vai skaitļi.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">illustratieve content heeft betrekking op een aggregaat dat een expressie verwezenlijkt met een waarde van &quot;cartografisch beeld&quot;, &quot;cartografisch bewegend beeld&quot;, &quot;cartografisch tactiel beeld&quot;, &quot;cartografische tactiele driedimensionale vorm&quot;, &quot;cartografische driedimensionale vorm&quot;, &quot;driedimensionaal bewegend beeld&quot;, &quot;tweedimensionaal bewegend beeld&quot;, &quot;tactiele driedimensionale vorm&quot;, &quot;niet-bewegend beeld&quot; of &quot;tactiel beeld&quot; als type content. Tabellen die alleen woorden en numerieke data bevatten zijn uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">resimleyici içerik ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">ينطبق المحتوي التوضيحي على الإضافة التي تتضمن تعبيرة لها نوع محتوى من &quot;صورة خرائطية&quot;، &quot;صورة متحركة خرائطية&quot;، &quot;صورة لمسية خرائطية&quot;، &quot;شكل خرائطي ثلاثي الأبعاد&quot;، &quot;صورة متحركة ثلاثية الأبعاد&quot;، &quot;صورة متحركة ثنائية الأبعاد&quot;، &quot;شكل ملموس ثلاثي الأبعاد&quot;، &quot;شكل ثلاثي الأبعاد&quot;، &quot;صورة ثابتة&quot;، أو &quot;صورة ملموسة&quot;. تُستبعد الجداول التي تحتوي فقط على كلمات وبيانات رقمية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">插图内容适用于具体化如下内容类型值的载体表现的合集：“地图图像”、“地图动态图像”、“地图触摸图像”、“地图触摸三维形式”、“地图三维形式”、“三维动态图像”、“二维动态图像”、“触摸三维形式”、“三维形式”、“静态图像”、或“触摸图像”。不包括只有文字或数字数据的表格。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30454 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30454">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour contenu sonore</rdfs:label>
        <rdfs:label xml:lang="hu">hangtartalma a következő:</rdfs:label>
        <rdfs:label xml:lang="en">has sound content</rdfs:label>
        <rdfs:label xml:lang="de">hat Toninhalt</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geluidscontent</rdfs:label>
        <rdfs:label xml:lang="da">lydindhold</rdfs:label>
        <rdfs:label xml:lang="tr">ses içeriği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņas saturs</rdfs:label>
        <rdfs:label xml:lang="es">tiene contenido sonoro</rdfs:label>
        <rdfs:label xml:lang="ca">té com a contingut sonor</rdfs:label>
        <rdfs:label xml:lang="fi">äänisisältö</rdfs:label>
        <rdfs:label xml:lang="ar">له محتوى صوت</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有声音内容</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, gösterim tarafından somutlaştırılmış sesin varlığının veya yokluğunun göstergesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési formában megtestesülő, a hang jelenlétét vagy hiányát mutató jelöléshez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation ilmaukseen manifestaation sisältämän äänen mukanaolosta tai puuttumisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une indication de la présence ou de l’absence de son matérialisé par une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una indicació de la presència o absència de so materialitzada en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una indicación de la presencia o ausencia de sonido materializado por una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een indicatie van de aanwezigheid of afwezigheid van geluid verwezenlijkt door een manifestatie.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en indikation af nærvær eller fravær af lyd indholdt i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an indication of the presence or absence of sound embodied by a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar skaņas esamību vai tās trūkumu izteiksmē.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Angabe über das Vorhandensein beziehungsweise nicht Vorhandensein von Ton, der durch eine Manifestation verkörpert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تعبيرة ومؤشر لوجود أو عدم وجود صوت في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种载体表现所具体化的声音出现或不出现的指示关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Du contenu sonore est présent dans une expression ayant une valeur de &amp;laquo;&amp;nbsp;musique exécutée&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;parole énoncée&amp;nbsp;&amp;raquo; ou &amp;laquo;&amp;nbsp;sons&amp;nbsp;&amp;raquo; pour type de contenu.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">El contenido sonoro está presente en una expresión con un valor de &quot;música interpretada&quot;, &quot;sonidos&quot; o &quot;palabra hablada&quot; para tipo de contenido.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">El contingut sonor és present en una expressió amb un valor de &quot;música executada&quot;, &quot;sons&quot; o &quot;paraula parlada&quot; per al tipus de contingut.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Geluidscontent is aanwezig in een expressie met een waarde van “uitgevoerde muziek”, “geluiden” of “gesproken woord” als type content.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Hangtartalmat tartalmazó kifejezési forma a következő tartalomtípusokra vonatkozó értékekkel: „előadott zene”, „hangok” és „beszéd”.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Lydhindhold findes i et udtryk med værdi som &quot;fremført musik&quot;, &quot;lyd&quot;, &quot;talet ord&quot; som indholdstype.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Ses içeriği, içerik türü için &quot;uygulanmış müzik&quot;, &quot;sesler&quot; veya &quot;söz&quot; değeriyle bir anlamda bulunur.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Skaņas saturs ir izteiksmēm, kuru satura veids ir &quot;mūzikas izpildījums&quot;, &quot;skaņas&quot; vai &quot;mutvārdi&quot;.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Sound content is present in an expression with a value of &quot;performed music&quot;, &quot;sounds&quot;, or &quot;spoken word&quot; for content type.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Toninhalt kommt in einer Expression mit dem Wert aufgeführte Musik, Töne oder gesprochene Worte für den Inhaltstyp vor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Äänisisältö ilmaistaa ekspressiossa sisältötyypin arvolla &quot;esitetty musiikki&quot;, &quot;ääni&quot; tai &quot;puhe&quot;.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">محتوى صوت متواجد في تعبيرة لها نوع محتوى من &quot;موسيقى مُسجلة&quot;، &quot; أصوات&quot;، أو &quot;كلمة منطوقة&quot;.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">声音内容出现于有如下内容类型值的一种内容表达：“表演音乐”、“声音”、或“口语”</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30455 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30455">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour contenu supplémentaire</rdfs:label>
        <rdfs:label xml:lang="da">har supplerende indhold</rdfs:label>
        <rdfs:label xml:lang="en">has supplementary content</rdfs:label>
        <rdfs:label xml:lang="de">hat ergänzenden Inhalt</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aanvullende content</rdfs:label>
        <rdfs:label xml:lang="hu">kiegészítő tartalma a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">lisätty sisältö</rdfs:label>
        <rdfs:label xml:lang="lv">papildu saturs</rdfs:label>
        <rdfs:label xml:lang="tr">tamamlayıcı içerik ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene contenido suplementario</rdfs:label>
        <rdfs:label xml:lang="ca">té com a contingut suplementari</rdfs:label>
        <rdfs:label xml:lang="ar">له محتوى تكميلي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有补充内容</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bütün artış tarafından somutlaştırılmış ana ifadeleri tamamlayan ifadenin türlerinin göstergesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy kifejezési forma azon típusainak a jelöléséhez, amelyek kiegészítik az aggregátumban megtestesülő fő kifejezési formákat.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation ilmaukseen niistä ekspressioista, jotka täydentävät laajennusaggregaatin sisältämiä pääekspressioita.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une indication des genres d’expressions qui complètent les expressions principales matérialisées par un agrégat par augmentation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una indicació de les classes d’expressió que suplementen les expressions principals que es materialitzen en un agregat d’augmentació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una indicación de los tipos de expresión que suplementan las expresiones principales que están materializadas por un agregado de aumento.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een indicatie van de soorten expressies die de hoofd-expressies aanvullen die verwezenlijkt zijn door een augmentatie-aggregaat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en indikation af de typer af udtryk der supplerer de hovedudtryk der er inholdt i en beriget samling.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an indication of the kinds of expression that supplement the main expressions that are embodied by an augmentation aggregate.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar norādi par saturu, kas atjaunina vai papildina izteiksmes pamata saturu. Papildu saturs var ietvert, piemēram, bibliogrāfiju, rādītāju vai pielikumu.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Angabe der Expressionsarten, die die Hauptexpressionen ergänzen, welche durch ein Erweiterungsaggregat verkörpert werden.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومؤشر لأنواع التعبير التي تُكمل التعبيرات الأساسية التي يتم تجسيدها بواسطة إضافة تجميعة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与补充被一种附增合集具体化的主要内容表达的内容表达的类型的指示关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/m/P30456 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/m/P30456">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/m/"/>
        <rdfs:label xml:lang="fr">a pour contenu de couleur</rdfs:label>
        <rdfs:label xml:lang="da">har farveindhold</rdfs:label>
        <rdfs:label xml:lang="en">has colour content</rdfs:label>
        <rdfs:label xml:lang="de">hat Farbinhalt</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kleurcontent</rdfs:label>
        <rdfs:label xml:lang="lv">krāsainība</rdfs:label>
        <rdfs:label xml:lang="tr">renk içeriği ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">színtartalma a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene contenido de color</rdfs:label>
        <rdfs:label xml:lang="ca">té com a contingut de color</rdfs:label>
        <rdfs:label xml:lang="fi">värisisältö</rdfs:label>
        <rdfs:label xml:lang="ar">له محتوى ملون</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有颜色内容</rdfs:label>
        <skos:definition xml:lang="tr">Bir gösterimi, bir gösterim tarafından somutlaştırılmış rengin veya tonun varlığının göstergesiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy megjelenési formát egy megjelenési formában megtestesülő, szín vagy színárnyalat jelenlétét mutató jelöléshez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää manifestaation manifestaatioon sisältyvän värin tai sävyn ilmaukseen.</skos:definition>
        <skos:definition xml:lang="fr">Met une manifestation en relation avec une indication de la présence de couleur ou de teinte matérialisée par une manifestation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una manifestació amb una indicació de la presència de color o to materialitzat en una manifestació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una manifestación con una indicación de la presencia de color o tono materializada por una manifestación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een manifestatie aan een indicatie van de aanwezigheid van kleur of toon verwezenlijkt door een manifestatie.</skos:definition>
        <skos:definition xml:lang="da">Relaterer en manifestation til en indikation af nærvær af farve wller tone indholdt i en manifestation.</skos:definition>
        <skos:definition xml:lang="en">Relates a manifestation to an indication of the presence of colour or tone embodied by a manifestation.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista manifestāciju ar norādi par krāsas, toņa u.tml. klātbūtni izteiksmes saturā.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Manifestation in Beziehung zu einer Angabe über das Vorhandensein von Farbe oder Tönung, die durch eine Manifestation verkörpert werden.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين تجسيدة ومؤشر وجود اللون أو درجة اللون في تجسيدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种载体表现与一种载体表现所具体化的颜色或色调出现的指示关联起来。</skos:definition>
        <skos:scopeNote xml:lang="hu">Alapszíneknek tekinthetők a fekete, a fehér, valamint az alapszínek feketével, fehérrel és szürkével kevert árnyalatai. A színtartalom azon kifejezési formákra vonatkozik, amelyeknek a tartalomtípusa &quot;kartográfiai kép&quot;, &quot;kartográfiai mozgókép&quot;, &quot;háromdimenziós kartográfiai forma&quot;, &quot;lejegyzett mozgás&quot;; &quot;lejegyzett zene&quot;, &quot;előadott mozgás&quot;, &quot;állókép&quot;, &quot;szöveg&quot;, &quot;háromdimenziós mozgókép&quot;, &quot;háromdimenziós forma&quot; vagy &quot;kétdimenziós mozgókép&quot;.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Black, white, single colour shades of black, single colour tints of white, and single colour tones of gray are considered to be single colours. Colour content applies to an expression with a value of &quot;cartographic image&quot;, &quot;cartographic moving image&quot;, &quot;cartographic three-dimensional form&quot;, &quot;notated movement&quot;, &quot;notated music&quot;, &quot;performed movement&quot;, &quot;still image&quot;, &quot;text&quot;, &quot;three-dimensional moving image&quot;, &quot;three-dimensional form&quot;, or &quot;two-dimensional moving image&quot; for content type.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Es consideren colors únics el negre, el blanc, els tons de negre, els matisos de blanc i els tons de gris. El contingut de color s’aplica a una expressió amb un valor de &quot;imatge cartogràfica&quot;, &quot;imatge cartogràfica en moviment&quot;, &quot;forma tridimensional cartogràfica&quot;, &quot;moviment notat&quot;, &quot;música notada&quot;, &quot;moviment executat&quot;, &quot;imatge fixa&quot;, &quot; text&quot;, &quot;imatge en moviment tridimensional&quot;, &quot;forma tridimensional&quot; o &quot;imatge en moviment bidimensional&quot; per al tipus de contingut.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le noir et le blanc sont considérés comme étant des couleurs ; les différents tons d’une même couleur obtenus en ajoutant du noir, du blanc ou du gris sont considérés comme étant une seule couleur. Le contenu de couleur s’applique à une expression ayant une valeur de &amp;laquo;&amp;nbsp;forme cartographique tridimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;forme tridimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image animée bidimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image animée tridimensionnelle&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image cartographique&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image cartographique animée&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;image fixe&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;mouvement exécuté&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;mouvement noté&amp;nbsp;&amp;raquo;, &amp;laquo;&amp;nbsp;musique notée&amp;nbsp;&amp;raquo; ou &amp;laquo;&amp;nbsp;texte&amp;nbsp;&amp;raquo; pour type de contenu.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Melns, balts un pelēkie toņi tiek uzskatīti par vienu krāsu.Melns, balts un pelēkie toņi tiek uzskatīti par vienu krāsu. Krāsas saturs ir izteiksmēm, kuru satura veids ir &quot;kartogrāfisks attēls&quot;, &quot;kustīgs kartogrāfisks attēls&quot;, &quot;kartogrāfiska trīsdimensiju forma&quot;, &quot;kustības pieraksts&quot;, &quot;notācija&quot;, &quot;kustības izpildījums&quot;, &quot;attēls&quot;, &quot;teksts&quot;, &quot;trīsdimensiju kustīgs attēls&quot;, &quot;trīsdimensiju forma&quot; vai &quot;divdimensiju kustīgs attēls&quot;.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Musta, valkoinen, yksiväriset mustan sävyt, yksiväriset valkoisen sävyt ja yksiväriset harmaan sävyt lasketaan yksivärisiksi. Kuvasisältöä sovelletaan ekspressioon, jonka sisältötyypin arvo on &quot;kartografinen kuva&quot;, &quot;kartografinen liikkuva kuva&quot;, &quot;kartografinen kolmiulotteinen muoto&quot;, &quot;liikenotaatio&quot;, &quot;nuottiaineisto&quot;, &quot;esitetty liike&quot;, &quot;stillkuva&quot;, &quot;teksti&quot;, &quot; kolmiulotteinen liikkuva kuva&quot;, &quot;kolmiulotteinen muoto&quot; tai &quot;kaksiulotteinen liikkuva kuva&quot;.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Negro, blanco, matices de negro de un solo color, tintes de blanco de un solo color y tonos de gris de un solo color se consideran colores solos. El contenido de color aplica a una expresión con un valor de &quot;imagen cartográfica&quot;, imagen cartográfica en movimiento&quot;, &quot;forma cartográfica tridimensional&quot;, &quot;movimiento notado&quot;, &quot;música notada&quot;, &quot;movimiento interpretado&quot;, &quot;imagen fija&quot;, &quot;texto&quot;, &quot;imagen tridimensional en movimiento&quot;, &quot;forma tridimensional&quot; o &quot;imagen bidimensional en movimiento&quot; para tipo de contenido.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Schwarz, Weiß, einfarbige Schwarztöne, einfarbige Weißtönungen und einfarbige Grauschattierungen werden als einfarbig angesehen. Farbinhalt gibt es in einer Expression mit dem Wert kartografisches Bild, kartografisches Bewegtbild, kartografische dreidimensionale Form, Bewegtnotation, Noten, aufgeführte Bewegung, unbewegtes Bild, Text, dreidimensionales Bewegtbild, dreidimensionale Form oder zweidimensionales Bewegtbild.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Siyah, beyaz, siyahın tek renk tonları, beyazın tek renk tonları, ve grinin tek renk tonları; tekli tonlar olarak görülür. Renk içeriği, içerik türü için &quot;kartografik görüntü&quot;, &quot;kartografik hareketli görüntü&quot;, &quot;kartografik üç boyutlu form&quot;, &quot;notalı hareket&quot;, &quot;notalı müzik&quot;, &quot;icra edilen hareket&quot;, &quot;sabit görüntü&quot;, &quot;metin&quot;, &quot;üç boyutlu hareketli görüntü&quot;, &quot;üç boyutlu form&quot; veya &quot;iki boyutlu hareketli görüntü&quot; değerine sahip bir anlatım için geçerlidir.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Sort, hvid, enkelte farvenuancer af sort, enkelte farvenuancer af hvid og enkelte farvetoner af grå betragtes som enkelte farver. Farveindhold bruges for et udtryk med en værdi af &quot;kartografisk billede&quot;, &quot;kartografisk levende billede&quot;, &quot;kartografisk tredimensional form&quot;, &quot;noteret bevægelse&quot;, &quot;noteret musik&quot;, &quot;fremført bevægelse&quot;, &quot;stillbillede&quot;, &quot;tekst&quot;, &quot;tredimensional levende billede&quot;, &quot;tredimensional form&quot; eller &quot;todimensional form&quot; eller todimensional levende billede, som indholdstype.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Zwart, wit, éénkleurige schakeringen van zwart, éénkleurige tinten wit en eenkleurige tonen van grijs worden beschouwd als enkele kleur. Kleurcontent is van toepassing op een expressie met een waarde van &quot;cartografisch beeld&quot;, &quot;cartografisch bewegend beeld&quot;, &quot;cartografische driedimensionale vorm&quot;, &quot;bewegingsnotatie&quot;, &quot;muzieknotatie&quot;, &quot;uitgevoerde beweging&quot;, &quot;niet-bewegend beeld&quot;, &quot;tekst&quot;, &quot;driedimensionaal bewegend beeld&quot;, &quot;driedimensionale vorm&quot; of &quot;tweedimensionaal bewegend beeld&quot; als type content.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">黑色、白色、单色黑阴影、单色白色调、单色灰色调都被认为是单色。颜色内容适用于有如下内容类型值的内容表达：“地图图像”、“地图动态图像”、“地图三维形式”、“动作谱”、“乐谱”、“表演动作”、“静止图像”、“文本”、“三维动态图像”、“三维形式”、或“二维动态图像”。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10004 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10004">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour catégorie d’œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có hình thái của tác phẩm</rdfs:label>
        <rdfs:label xml:lang="lv">darba kategorija</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kategorisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come categoria di opera</rdfs:label>
        <rdfs:label xml:lang="da">har kategori af værk</rdfs:label>
        <rdfs:label xml:lang="no">har kategori av verk</rdfs:label>
        <rdfs:label xml:lang="sv">har verkets form</rdfs:label>
        <rdfs:label xml:lang="en">has category of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Kategorie eines Werks</rdfs:label>
        <rdfs:label xml:lang="nl">heeft categorie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">műformája a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen kategoria</rdfs:label>
        <rdfs:label xml:lang="et">teose kategooria</rdfs:label>
        <rdfs:label xml:lang="es">tiene categoría de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a categoria d’obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει μορφή του έργου</rdfs:label>
        <rdfs:label xml:lang="ar">له فئة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的类别</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisinin dahil olduğu tür ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un tipo al quale un’opera appartiene.</skos:definition>
        <skos:definition xml:lang="hu">Egy művet hozzákapcsol egy típushoz, amelyhez a mű tartozik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen tyyppiin, johon teos kuuluu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với lớp hoặc loại mà tác phẩm thuộc vào.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un type auquel une œuvre appartient.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un tipus al qual pertany una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un tipo al cual pertenece una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een type waartoe een werk behoort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en type som verket tilhører.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en type, som et værk tilhører.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a type to which a work belongs.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar veidu, pie kura pieder darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tüübiga, millesse teos kuulub.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Art, zu der ein Werk gehört.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια τάξη ή ένα είδος στο οποίο ανήκει ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ونوع ينتمي إليه عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所属于的一种类型关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend une classe ou un genre.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Klassen oder Genres.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab liiki ja žanri.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver klasi vai žanru.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou una classe o un gènere.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Include una classe o un genere.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes a class or genre.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye una clase o género.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Inkluderer en klasse eller sjanger.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa luokan tai genren.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter en klasse eller genre</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat een klasse of genre.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">eserin kategorisi ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">műforma</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتضمن فئة أو شكل أدبي.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括类或体裁</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10005 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10005">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité intimée</rdfs:label>
        <rdfs:label xml:lang="lv">atbildētājinstitūcija</rdfs:label>
        <rdfs:label xml:lang="vi">có tập thể bị kháng cáo</rdfs:label>
        <rdfs:label xml:lang="hu">fellebezési alperes testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come ente appellato</rdfs:label>
        <rdfs:label xml:lang="no">har appellee (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er indstævnte</rdfs:label>
        <rdfs:label xml:lang="en">has appellee corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Berufungsbeklagte/Berufungsbeklagten/Revisionsbeklagte/Revisionsbeklagten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gedaagde-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">temyiz edilen tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo apelado</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa apel·lada</rdfs:label>
        <rdfs:label xml:lang="et">vastustaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">yhteisö muutoksenhakijan vastapuolena</rdfs:label>
        <rdfs:label xml:lang="el">είναι εφεσίβλητο/αναιρεσίβλητο συλλογικό όργανο</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مستأنف ضدها</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有被上诉者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, üst mahkemenin yasal eserinde kaydedilen bir alt mahkeme kararına karşı temyiz başvurusunda bulunulan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un ente contro cui ha luogo un appello su decisione di un tribunale ordinario, registrato in un&apos;opera giuridica di un tribunale superiore.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely ellen fellebbezést nyújtanak be egy magasabb fokú bíróság jogi művében rögzített alacsonyabb fokú bírósági döntéssel kapcsolatban.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, jota vastaan muutoksenhaku alemman oikeusasteen päätökseen kohdistuu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể chống lại người đưa ra kháng cáo trên quyết định của toà án cấp thấp hơn trong tác phẩm luật pháp của toà án cấp cao hơn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité contre laquelle a été formé un appel d’une décision d’un tribunal inférieur enregistrée dans une œuvre juridique d’un tribunal supérieur.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa contra la qual es recorre una decisió d’un tribunal inferior enregistrada en una obra legal d’un tribunal superior.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo contra quien se interpone una apelación sobre una decisión de un tribunal inferior registrada en una obra jurídica de un tribunal superior.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie waartegen een beroep wordt aangetekend over een oordeel van een lager gerechtshof vastgelegd in een juridisch werk van een hoger gerechtshof.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som anker en avgjørelse fra en lavere rettsinstans som er registrert i et juridisk verk fra en høyere rettsinstans.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation mod hvilken der appelleres en afgørelse, truffet af en lavere retsinstans, som er registreret i et juridisk værk fra en højere retsinstans.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body against whom an appeal is taken on a decision of a lower court recorded in a legal work of a higher court.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, pret kuru ceļ apsūdzību par nodarījuma izdarīšanu un uztur apsūdzību tiesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kelle vastu on esitatud alama astme kohtu otsuse peale apellatsioon, mis on dokumenteeritud kõrgema astme kohtu juriidilises teoses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, gegen die Rechtsmittel (Berufung/Revision) gegen ein Gerichtsurteil einer unteren Instanz, das in einem juristischen Werk einer höheren Instanz erfasst ist, eingelegt werden.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα συλλογικό όργανο εναντίον του οποίου ασκείται έφεση εναντίον απόφασης κατώτερου δικαστηρίου, που καταχωρίστηκε στα πρακτικά ενός ανωτέρου δικαστηρίου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مستأنف ضدها بحكم صادر عن محكمة دنيا ومسجل في عمل قانوني لمحكمة عليا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在上级法院的一种法律作品中记录下级法院起诉该团体之决定的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10008 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10008">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour société de production</rdfs:label>
        <rdfs:label xml:lang="vi">có công ty sản xuất</rdfs:label>
        <rdfs:label xml:lang="it">ha come compagnia di produzione</rdfs:label>
        <rdfs:label xml:lang="no">har produksjonsselskap</rdfs:label>
        <rdfs:label xml:lang="da">har produktionsselskab</rdfs:label>
        <rdfs:label xml:lang="en">has production company</rdfs:label>
        <rdfs:label xml:lang="de">hat Produktionsfirma</rdfs:label>
        <rdfs:label xml:lang="nl">heeft productiebedrijf</rdfs:label>
        <rdfs:label xml:lang="lv">producentu kompānija</rdfs:label>
        <rdfs:label xml:lang="hu">produkciós cége a következő:</rdfs:label>
        <rdfs:label xml:lang="et">produktsioonifirma</rdfs:label>
        <rdfs:label xml:lang="es">tiene compañía productora</rdfs:label>
        <rdfs:label xml:lang="fi">tuotantoyhtiö</rdfs:label>
        <rdfs:label xml:lang="ca">té com a empresa de producció</rdfs:label>
        <rdfs:label xml:lang="tr">yapım şirketi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει εταιρία παραγωγής</rdfs:label>
        <rdfs:label xml:lang="ar">له شركة إنتاج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制作公司</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, sahne, ekran, ses kaydı, televizyon, web yayını vb. için bir prodüksiyonun finansal, teknik ve organizasyonel yönlerini yönetmekten sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un ente responsabile della gestione finanziaria, tecnica e organizzativa di una produzione per il teatro, cinema, registrazione audio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy színpadi produkció, film, hangfelvétel, televíziós vagy webes közvetítés, stb. pénzügyi, technikai és szervezeti vonatkozásának irányításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka vastaa näyttämö-, elokuva-, äänite-, televisio-, suoratoistolähetys- tms. tuotannon taloudellisesta, teknisestä ja organisatorisesta johtamisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể có trách nhiệm về quản lý tài chính, kỹ thuật và tổ chức sản phẩm cho sân khấu, màn ảnh, ghi âm, truyền hình, trên web, v.v...</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de gérer les aspects financiers, techniques et organisationnels de la production d’un spectacle, d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la gestió dels aspectes financers, tècnics i d’organització de la producció d’un espectacle, d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que es responsable de gestionar los aspectos financieros, técnicos y organizativos de una producción teatral, cinematográfica, grabación de sonido, televisión, webcast, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het beheer van de financiële, technische en organisatorische aspecten van een productie voor podium, scherm, geluidsopname, televisie, webcast etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon med ansvar for håndtering av de økonomiske, tekniske og organisatoriske aspektene av en produksjon for scene, film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for økonomisk, teknisk og organisatorisk ledelse af en produktion beregnet til scene, lærred, lydoptagelse, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for managing the financial, technical, and organizational aspects of a production for stage, screen, sound recording, television, webcast, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par teātra, filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraides u.tml. finansiālu, tehnisku un organizatorisku vadību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab lavastuste, filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmise finantsilise, tehnilise ja korraldusliku juhtimise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für das finanzielle, technische und organisatorische Management einer Produktion für die Bühne, den Bildschirm, die Tonaufnahme, das Fernsehen, für einen Webcast und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα συλλογικό όργανο, το οποίο είναι υπεύθυνο για την οικονομική, τεχνική και οργανωτική διαχείριση μιας παραγωγής που προορίζεται για τη σκηνή, την οθόνη, μια ηχογράφηση, την τηλεόραση, μια διαδικτυακή μετάδοση κ.λπ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إدارة الجوانب المالية، والتقنية، والتنظيمية في الإنتاج للمسرح، وللسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责管理舞台、播放、录音、电视、网络直播等制作的资金、技术和组织方面的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10009 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10009">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité appelante</rdfs:label>
        <rdfs:label xml:lang="et">apellant (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">apelācijas iesniedzējinstitūcija</rdfs:label>
        <rdfs:label xml:lang="vi">có tập thể kháng cáo</rdfs:label>
        <rdfs:label xml:lang="hu">fellebbező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come appellante ente</rdfs:label>
        <rdfs:label xml:lang="no">har appellerende korporasjon</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er appellant</rdfs:label>
        <rdfs:label xml:lang="en">has appellant corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Berufungsklagende/Revisionsklagende (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aanklager in beroep-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">temyiz eden tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo apelante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa apel·lant</rdfs:label>
        <rdfs:label xml:lang="fi">yhteisö muutoksenhakijana</rdfs:label>
        <rdfs:label xml:lang="el">έχει εκαλλούν/αναιρεσείον συλλογικό όργανο</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مستأنفة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有上诉者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, üst mahkemenin yasal eserinde kaydedilen bir alt mahkeme kararını temyiz eden tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un ente che si appella alla decisione di un tribunale ordinario registrata in un&apos;opera giuridica di tribunale superiore.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely egy magasabb rendű bíróság jogi művében rögzített alacsonyabb rendű bíróság döntése ellen fellebbez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka hakee muutosta alemman oikeusasteen päätökseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể kháng cáo quyết định của toà án cấp thấp hơn được ghi trong tác phẩm luật pháp của toà án cấp cao hơn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui en appelle d’une décision d’un tribunal inférieur enregistrée dans une œuvre juridique d’un tribunal supérieur.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que recorre una decisió d’un tribunal inferior enregistrada en una obra legal d’un tribunal superior.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que apela una decisión de un tribunal inferior registrada en una obra legal de un tribunal superior.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die in beroep gaat tegen een oordeel van een lager gerechtshof vastgelegd in een juridisch werk van een hoger gerechtshof.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som anker en avgjørelse til en lavere rettsinstans som er registrert i et juridisk verk fra en høyere rettsinstans.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som appellerer imod en lavere retsinstans dom, som er registreret i et juridisk værk fra en højere retsinstans.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who appeals a decision of a lower court recorded in a legal work of a higher court.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas pārsūdz zemāka līmeņa tiesas spriedumu kādā augstāka līmeņa tiesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes esitab alama astme kohtu otsuse peale apellatsiooni, mis on dokumenteeritud kõrgema astme kohtu juriidilises teoses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die gegen ein Gerichtsurteil einer unteren Instanz, das in einem juristischen Werk einer höheren Instanz erfasst ist, Rechtsmittel (Berufung/Revision) einlegt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα συλλογικό όργανο, που ασκεί έφεση εναντίον απόφασης κατώτερου δικαστηρίου, που καταχωρίστηκε στα πρακτικά ενός ανωτέρου δικαστηρίου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تستأنف حكم صادر عن محكمة دنيا ومسجل في عمل قانوني لمحكمة عليا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与记录在上级法院的一种法律作品中起诉一个下级法院决定的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10010 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10010">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité demanderesse</rdfs:label>
        <rdfs:label xml:lang="vi">có tập thể nguyên đơn</rdfs:label>
        <rdfs:label xml:lang="tr">davacı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">felperes testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come querelante ente</rdfs:label>
        <rdfs:label xml:lang="et">hageja (asutus)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er sagsøger</rdfs:label>
        <rdfs:label xml:lang="no">har saksøker (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has plaintiff corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Zivilklägerin/Zivilkläger (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aanklager-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">prasītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo demandante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa demandant</rdfs:label>
        <rdfs:label xml:lang="fi">yhteisökantaja</rdfs:label>
        <rdfs:label xml:lang="el">έχει ενάγον συλλογικό όργανο</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مدعية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有原告团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, hukuk davasına taşıyan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un ente che intenta un’azione legale nell’ambito di un procedimento civile.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely polgárjogi eljárás keretében pert indít.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka nostaa kanteen siviilioikeudenkäyntiin.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể đưa ra đơn kiện trong vụ kiện dân sự.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui intente une poursuite civile.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que interposa una demanda civil.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que entabla una demanda en un proceso civil.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een proces aanspant in een civielrechtelijke procedure.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er saksøker i en sivilrettslig sak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som anlægger en sag i en civilproces.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who brings a suit in a civil proceeding.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ceļ parasību civiltiesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes esitab tsiviilkohtumenetluses hagi.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die eine Klage in ein Zivilverfahren einbringt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα συλλογικό όργανο, το οποίο ασκεί αγωγή στο πλαίσιο αστικής διαδικασίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة ترفع دعوى ضمن دعوى مدنية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在民事诉讼中起诉的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10013 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10013">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent réalisateur de cinéma</rdfs:label>
        <rdfs:label xml:lang="vi">có đạo diễn phim</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvaohjaaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">film yönetmeni temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">filmirežissöör (tegija)</rdfs:label>
        <rdfs:label xml:lang="hu">filmrendező ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista cinematografico agente</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er filminstruktør</rdfs:label>
        <rdfs:label xml:lang="no">har filmregissør (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has film director agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmregisseurin/Filmregisseur (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmregisseur-actor</rdfs:label>
        <rdfs:label xml:lang="lv">kinorežisors (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente director de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent director cinematogràfic</rdfs:label>
        <rdfs:label xml:lang="el">έχει σκηνοθέτη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مخرج أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影导演行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın genel yönetiminden ve denetiminden sorumlu bir yönetmen olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente regista responsabile dell&apos;organizzazione e della supervisione generali di una rappresentazione cinematografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező ágenshez, amely felelős egy filmre vett előadás általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on ohjaaja, joka on vastuussa elokuvatun esityksen yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với đạo diễn có trách nhiệm về quản lý và giám sát chung của biểu diễn để làm phim.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent réalisateur qui est responsable de la gestion et de la supervision générales d’une prestation filmée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un director que és responsable de la gestió general i la supervisió d’una actuació filmada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un director quien es responsable de la gestión y supervisión general de una presentación filmada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een gefilmde uitvoering.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er regissør med ansvar for generell ledelse av en filmet forestilling.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is a director who is responsible for the general management and supervision of a filmed performance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir filmas režisors, kurš ir atbildīgs par uzfilmētā pasākuma vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on filmitava esituse üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Akteur), die/der für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν σκηνοθέτη υπεύθυνο για τη γενική διεύθυνση και εποπτεία μίας κινηματογραφικής ερμηνείας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مخرجا مسئولاً عن الإدارة العامة والإشراف على أداء مصوَّر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责拍摄表演的总体管理和监督的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10014 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10014">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent réalisateur de radio</rdfs:label>
        <rdfs:label xml:lang="vi">có đạo diễn truyền thanh</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista radiofonico agente</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er radioregissør</rdfs:label>
        <rdfs:label xml:lang="no">har radioregissør (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has radio director agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkregisseurin/Hörfunkregisseur (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioregisseur-actor</rdfs:label>
        <rdfs:label xml:lang="et">raadiorežissöör (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma direktors (aģents)</rdfs:label>
        <rdfs:label xml:lang="fi">radio-ohjaaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yönetmeni temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádiós rendező ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente director de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent realitzador radiofònic</rdfs:label>
        <rdfs:label xml:lang="el">έχει διευθυντή ραδιοφωνικού προγράμματος</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مخرج إذاعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播导演行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, radyo programına ait bir performansın genel yönetiminden ve denetiminden sorumlu bir yönetmen olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente regista responsabile dell&apos;organizzazione e della supervisione generali di un programma radiofonico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező ágenshez, amely felelős egy rádióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với đạo diễn có trách nhiệm về quản lý và giám sát chung của chương trình truyền thanh.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent réalisateur qui est responsable de la gestion et de la supervision générales d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un realitzador que és responsable de la gestió general i la supervisió d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un director quien es responsable de la gestión y supervisión general de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er regissør med ansvar for generell ledelse av et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is a director who is responsible for the general management and supervision of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu - direktors, kurš atbildīgs par radio raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on raadiosaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Akteur), die/der für das allgemeine Management und die Leitung einer Radiosendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν διευθυντή υπεύθυνο για τη γενική διεύθυνση και εποπτεία ενός ραδιοφωνικού προγράμματος.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مخرجا مسئولاً عن الإدارة العامة والإشراف على برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责广播节目的总体管理和监督的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10015 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10015">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent réalisateur de télévision</rdfs:label>
        <rdfs:label xml:lang="vi">có đạo diễn truyền hình</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista televisivo agente</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er tv-regissør</rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsregissør (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has television director agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehregisseurin/Fernsehregisseur (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieregisseur-actor</rdfs:label>
        <rdfs:label xml:lang="et">telerežissöör (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">televisio-ohjaaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yönetmeni temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televíziós rendező ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma režisors (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente director de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent realitzador de televisió</rdfs:label>
        <rdfs:label xml:lang="el">έχει τηλεοπτικό διευθυντή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مخرج تليفزيوني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视导演行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, televizyon programına ait bir performansın genel yönetiminden ve denetiminden sorumlu bir yönetmen olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente regista responsabile dell&apos;organizzazione e della supervisione generali di un programma televisivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező ágenshez, amely felelős egy televízióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on ohjaaja, joka on vastuussa televisio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với đạo diễn có trách nhiệm về quản lý và giám sát chung của chương trình truyền hình.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent réalisateur qui est responsable de la gestion et de la supervision générales d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un realitzador que és responsable de la gestió general i la supervisió d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un director quien es responsable de la gestión y supervisión general de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er regissør med ansvar for generell ledelse av et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is a director who is responsible for the general management and supervision of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu - režisors, kurš ir atbildīgs par televīzijas raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on telesaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Akteur), die/der für das allgemeine Management und die Leitung einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν διευθυντή υπεύθυνο για τη γενική διεύθυνση και εποπτεία ενός τηλεοπτικού προγράμματος.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مخرجا مسئولاً عن الإدارة العامة والإشراف على برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责电视节目的总体管理和监督的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10019 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10019">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er del af værk</rdfs:label>
        <rdfs:label xml:lang="no">er del av verk</rdfs:label>
        <rdfs:label xml:lang="es">es parte de obra</rdfs:label>
        <rdfs:label xml:lang="tr">eserin bir bileşenidir</rdfs:label>
        <rdfs:label xml:lang="fr">est une partie d’œuvre de</rdfs:label>
        <rdfs:label xml:lang="lv">ir daļa darbā</rdfs:label>
        <rdfs:label xml:lang="nl">is deel van werk</rdfs:label>
        <rdfs:label xml:lang="en">is part of work</rdfs:label>
        <rdfs:label xml:lang="de">ist Teil von (Werk)</rdfs:label>
        <rdfs:label xml:lang="et">osa teosest</rdfs:label>
        <rdfs:label xml:lang="fi">osa teosta</rdfs:label>
        <rdfs:label xml:lang="hu">része a következő műnek:</rdfs:label>
        <rdfs:label xml:lang="it">è parte di opera</rdfs:label>
        <rdfs:label xml:lang="ca">és part d’una obra</rdfs:label>
        <rdfs:label xml:lang="vi">được chứa trong (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="el">περιέχεται σε (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو جزء من عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是作品的部分</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, ayrık bir bileşen olarak farklı bir esere sahip bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’opera che ha un’altra opera come componente distinta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amely elkülöníthető alkotóelemként rendelkezik egy másik művel.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, jolla on toinen teos itsenäisenä osana.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm lớn hơn mà tác phẩm là bộ phận cấu thành tách biệt.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui a pour composante distincte une autre œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que té una altra obra com a component discret.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que tiene otra obra como un componente discreto.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat een ander werk als afzonderlijk onderdeel heeft.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som inneholder et annet verk som en avgrenset del.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som har et andet værk som en separat komponent.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that has another work as a discrete component.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kam ir cits darbs kā atsevišķa sastāvdaļa.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, millesse kuulub iseseisva koostisosana teine teos.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das ein anderes Werk als einzelnen Bestandteil enthält.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα μεγαλύτερο έργο για το οποίο το έργο συνιστά ένα διακριτό συστατικό.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل يحتوي على عمل آخر كمكون منفصل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与有另一种作品作为独立组成部分的一种作品关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A part work is considered to be essential to the whole work.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A részmű alapvető fontosságú az egész mű szempontjából.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir parça eserin, eserin bütünü için gerekli olduğu kabul edilir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darbs: daļa, kuru uzskata par būtisku visam darbam.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Del af et værk er anset for at være vigtigt for hele værket.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een deelwerk wordt beschouwd als essentieel voor het hele werk.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Ein Teilwerk wird als wesentlich für das Gesamtwerk angesehen.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Et delverk er ansett å være viktig for hele verket.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen osaa pidetään olennaisena koko teokselle.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose osa peetakse kogu teose suhtes oluliseks.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un&apos;opera parte è considerata essenziale per l&apos;intera opera</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una obra de part es considera essencial per a l’obra completa.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una parte de obra se considera esencial para la obra completa.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une partie d’œuvre est considérée comme essentielle à l’œuvre entière.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يعد العمل الجزئي ضروريًا للعمل بأكمله.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">一种部分作品被认为对于完整作品至关重要。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10024 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10024">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour coordonnées d’un contenu cartographique</rdfs:label>
        <rdfs:label xml:lang="vi">có toạ độ của nội dung bản đồ</rdfs:label>
        <rdfs:label xml:lang="it">ha come coordinate di contenuto cartografico</rdfs:label>
        <rdfs:label xml:lang="sv">har koordinater (kartografiska resurser)</rdfs:label>
        <rdfs:label xml:lang="da">har koordinater for kartografisk indhold</rdfs:label>
        <rdfs:label xml:lang="no">har koordinater for kartografisk innhold</rdfs:label>
        <rdfs:label xml:lang="en">has coordinates of cartographic content</rdfs:label>
        <rdfs:label xml:lang="de">hat Koordinaten von kartografischem Inhalt</rdfs:label>
        <rdfs:label xml:lang="nl">heeft coördinaten van cartografische content</rdfs:label>
        <rdfs:label xml:lang="et">kartograafilise sisu koordinaadid</rdfs:label>
        <rdfs:label xml:lang="tr">kartografik içeriğin koordinatları ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">kartografikus tartalomhoz tartozó koordináták a következők:</rdfs:label>
        <rdfs:label xml:lang="fi">kartografisen sisällön koordinaatit</rdfs:label>
        <rdfs:label xml:lang="lv">kartogrāfiskā satura koordinātas</rdfs:label>
        <rdfs:label xml:lang="es">tiene coordenadas de contenido cartográfico</rdfs:label>
        <rdfs:label xml:lang="ca">té com a coordenades d’un contingut cartogràfic</rdfs:label>
        <rdfs:label xml:lang="el">έχει συντεταγμένες του χαρτογραφικού περιεχομένου</rdfs:label>
        <rdfs:label xml:lang="ar">له إحداثيات محتوى رسم خرائطي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有地图内容的坐标</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, sınırlarını veya konumunu belirlemek için matematiksel bir sistem kullanılarak tanımlanan bir kartografik eserin kapsama alanı olan yerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un sistema matematico per identificare un luogo coperto dal contenuto cartografico di un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy helyhez, egy kartográfiai mű által lefedett területhez, amelyet matematikai módszert használva írnak le, hogy meghatározzák a határát vagy a helyzetét.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen paikkaan, joka on kartografisen teoksen kattama alue, joka on kuvattu matemaattisen järjestelmän avulla sen rajojen tai sijainnin identifioimiseksi.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với hệ thống toán học dùng để nhận dạng khu vực được bao quát bởi nội dung bản đồ của tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un lieu qui constitue la zone de couverture d’une œuvre cartographique décrite à l’aide d’un système mathématique permettant d&apos;identifier ses limites ou son emplacement.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un lloc que és l’àrea de cobertura d’una obra cartogràfica que es descriu usant un sistema matemàtic per identificar els seus límits o la seva localització.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lugar que es el área de cobertura de una obra cartográfica que es descrita utilizando un sistema matemático para identificar sus límites o ubicación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een plaats die is het bestreken gebied van een cartografisch werk dat is beschreven met gebruikmaking van een mathematisch systeem voor het identificeren van zijn grenzen of locatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et matematisk system for å identifisere et sted som dekkes av det kartografiske innholdet til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et matematisk system til at identifice et sted, som dækkes af et værks kartografiske indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a place that is the area of coverage of a cartographic work that is described using a mathematical system to identify its boundaries or location.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vietu, kas ir teritorija matemātiskas sistēmas darba kartogrāfiskajā saturā ietvertās teritorijas noteikšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose matemaatilise süsteemiga, mille abil tuvastatakse teose kartograafilise sisuga hõlmatud koht.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Gebiet, das den Abdeckungsbereich eines kartografischen Werks darstellt und mit Hilfe eines mathematischen Systems beschrieben wird, um seine Grenzen oder Lage zu identifizieren.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα μαθηματικό σύστημα για την ταύτιση μιας περιοχής που καλύπτεται από το χαρτογραφικό περιεχόμενο ενός έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل عبار عن نطاق تغطية عمل رسم خرائطي موصوف باستخدام نظام رياضي لتحديد حدوده أو موقعه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一种地图作品的覆盖范围、并被使用一个数学体系描述以标识其边界或位置的一个地点关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Coordinates may be expressed by means of longitude and latitude on the surface of planets or by the angles of right ascension and declination for celestial charts.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Coördinaten kunnen uitgedrukt worden door lengtegraad en breedtegraad op het oppervlak van planeten of door de hoeken van rechte klimming en declinatie voor hemelkaarten.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Koordinaate väljendatakse planeetide pinnal pikkus- ja laiuskraadidena ning taevakaartidel otsetõusu ja käände nurgamõõtudena.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Koordinaatit voidaan ilmaista pituus- ja leveysasteilla planeettojen pinnalla tai rektaskension ja deklinaation kulmilla taivaankappaleissa.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Koordinaten können durch Längen- und Breitengrade auf der Oberfläche von Planeten oder durch die Winkel der Rektaszension und Deklination bei Himmelskarten ausgedrückt werden.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Koordinater kan udtrykkes vha. længdegrad og breddegrad på planeters overflader eller vha. vinklerne for rektascension og deklination for himmellegemer.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Koordinater kan uttrykkes gjennom lengdegrad og breddegrad på planeters overflate eller gjennom vinklene for rektascensjon og deklinasjon for stjernekart.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Koordinatlar, gezegenlerin yüzeyinde boylam ve enlem yoluyla veya göksel haritalar için dikey yükseklik ve sapma açılarıyla ifade edilebilir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Koordinātas var būt izteiktas kā planētas virsmas ģeogrāfiskais garums un ģeogrāfiskais platums vai debess ķermeņu kartēs kā rektascensija un deklinācija.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Las coordenadas pueden expresarse mediante longitud y latitud en la superficie de los planetas o mediante los ángulos de ascensión recta y declinación en las cartas celestes.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Le coordinate possono essere espresse per mezzo di longitudine e latitudine sulla superficie dei pianeti o per mezzo degli angoli di ascensione retta e declinazione per le carte celesti.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Les coordenades s’expressen o bé mitjançant la longitud i la latitud sobre la superfície dels planetes, o bé mitjançant els angles de l’ascensió recta i de la declinació en el cas de les cartes celestes.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Les coordonnées peuvent s’exprimer au moyen de la longitude et de la latitude sur la surface des planètes ou bien par les angles de l’ascension droite et de la déclinaison pour les cartes célestes.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Toạ độ có thể được thể hiện bằng kinh độ và vĩ độ trên bề mặt của hành tinh hoặc bằng các góc của độ xích kinh và độ lẹch cho biểu đồ bầu trời.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">kartografikus tartalomhoz tartozó koordináták:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Οι συντεταγμένες μπορεί να εκφραστούν μέσω γεωγραφικού μήκους και πλάτους στην επιφάνεια των πλανητών ή μέσω των γωνιών της ορθής αναφοράς και απόκλισης για τους ουράνιους χάρτες.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يمكن التعبير عن الإحداثيات عن طريق خطوط الطول والعرض على سطح الكواكب أو بزوايا الصعود المستقيم والانحراف للمخططات السماوية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">坐标可以通过行星表面上的经度和纬度或者天体图的赤经和赤纬的角度来表示。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10035 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10035">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne intimée</rdfs:label>
        <rdfs:label xml:lang="lv">atbildētājpersona</rdfs:label>
        <rdfs:label xml:lang="vi">có cá nhân bị kháng cáo</rdfs:label>
        <rdfs:label xml:lang="hu">fellebező alperes személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come appellato persona </rdfs:label>
        <rdfs:label xml:lang="no">har appellee (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er indstævnte</rdfs:label>
        <rdfs:label xml:lang="en">has appellee person</rdfs:label>
        <rdfs:label xml:lang="de">hat Berufungsbeklagte/Berufungsbeklagten/Revisionsbeklagte/Revisionsbeklagten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gedaagde-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">henkilö muutoksenhakijan vastapuolena</rdfs:label>
        <rdfs:label xml:lang="tr">temyiz edilen kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona apelada</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona apel·lada</rdfs:label>
        <rdfs:label xml:lang="et">vastustaja (isik)</rdfs:label>
        <rdfs:label xml:lang="el">έχει εφεσίβλητο/αναιρεσίβλητο φυσικό πρόσωπο</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مستأنف ضده</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有被上诉者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, üst mahkemenin yasal eserinde kaydedilen bir alt mahkeme kararına karşı temyiz başvurusunda bulunulan kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una persona contro cui ha luogo un appello su decisione di un tribunale ordinario, registrata in un&apos;opera giuridica di un tribunale superiore.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki ellen fellebbezést nyújtanak be egy magasabb fokú bíróság jogi művében rögzített alacsonyabb fokú bírósági döntéssel kapcsolatban.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, jota vastaan muutoksenhaku alemman oikeusasteen päätökseen kohdistuu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với cá nhân kháng cáo quyết định của toà án cấp thấp hơn được ghi trong tác phẩm luật pháp của toà án cấp cao hơn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne contre laquelle a été formé un appel d’une décision d’un tribunal inférieur enregistrée dans une œuvre juridique d’un tribunal supérieur.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona contra la qual es recorre una decisió d’un tribunal inferior enregistrada en una obra legal d’un tribunal superior.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona contra quien se interpone una apelación sobre una decisión de un tribunal inferior registrada en una obra jurídica de un tribunal superior.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon waartegen een beroep wordt aangetekend over een oordeel van een lager gerechtshof vastgelegd in een juridisch werk van een hoger gerechtshof.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er gjenstand for en anke mot en avgjørelse fra en lavere rettsinstans som er registrert i et juridisk verk fra en høyere rettsinstans.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person mod hvem der appelleres en afgørelse, truffet af en lavere retsinstans, som er registreret i et juridisk værk fra en højere retsinstans.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person against whom an appeal is taken on a decision of a lower court recorded in a legal work of a higher court.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, pret kuru iesniegta apelācija un pieņemts zemākas instances tiesas spriedums, kas reģistrēts darbā augstāka līmeņa tiesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kelle vastu on esitatud alama astme kohtu otsuse peale apellatsioon, mis on dokumenteeritud kõrgema astme kohtu juriidilises teoses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, gegen die Rechtsmittel (Berufung/Revision) gegen ein Gerichtsurteil einer unteren Instanz, das in einem juristischen Werk einer höheren Instanz erfasst ist, eingelegt werden.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα φυσικό πρόσωπο, που ασκεί έφεση εναντίον μίας απόφασης κατώτερου δικαστηρίου για μεταβίβαση της υπόθεσης σε ανώτερο δικαστήριο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مستأنَف ضده حكم صادر عن محكمة دنيا ومسجل في عمل قانوني لمحكمة عليا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在上级法院的一种法律作品中记录下级法院起诉该个人之决定的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10042 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10042">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne appelante</rdfs:label>
        <rdfs:label xml:lang="lv">apelācijas iesniedzējpersona</rdfs:label>
        <rdfs:label xml:lang="et">appellant (isik)</rdfs:label>
        <rdfs:label xml:lang="vi">có cá nhân kháng cáo</rdfs:label>
        <rdfs:label xml:lang="hu">fellebbező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come appellante persona </rdfs:label>
        <rdfs:label xml:lang="no">har appellant (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er appellant</rdfs:label>
        <rdfs:label xml:lang="en">has appellant person</rdfs:label>
        <rdfs:label xml:lang="de">hat Berufungsklagende/Revisionsklagende (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aanklager in beroep-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">henkilö muutoksenhakijana</rdfs:label>
        <rdfs:label xml:lang="tr">temyiz eden kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona apelante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona apel·lant</rdfs:label>
        <rdfs:label xml:lang="el">έχει εκκαλούν/αναιρεσείον φυσικό πρόσωπο</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مستأنف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有上诉者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, üst mahkemenin yasal eserinde kaydedilen bir alt mahkeme kararını temyiz eden kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una persona che si appella alla decisione di un tribunale ordinario registrata in un&apos;opera giuridica di un tribunale superiore.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki egy magasabb rendű bíróság jogi művében rögzített alacsonyabb rendű bíróság döntése ellen fellebbez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka hakee muutosta alemman oikeusasteen päätökseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với cá nhân kháng cáo quyết định của toà án cấp thấp hơn được ghi trong tác phẩm luật pháp của toà án cấp cao hơn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui en appelle d’une décision d’un tribunal inférieur enregistrée dans une œuvre juridique d’un tribunal supérieur.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que recorre una decisió d’un tribunal inferior enregistrada en una obra legal d’un tribunal superior.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que apela una decisión de un tribunal inferior registrada en una obra legal de un tribunal superior.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die in beroep gaat tegen een oordeel van een lager gerechtshof vastgelegd in een juridisch werk van een hoger gerechtshof.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som anker en avgjørelse fra en lavere rettsinstans som er registrert i et juridisk verk fra en høyere rettsinstans.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som appellerer imod en lavere retsinstans dom, som er registreret i et juridisk værk fra en højere retsinstans.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who appeals a decision of a lower court recorded in a legal work of a higher court.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura pārsūdz zemākas instances tiesas spriedumu augstāka līmeņa tiesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes esitab alama astme kohtu otsuse peale apellatsiooni, mis on dokumenteeritud kõrgema astme kohtu juriidilises teoses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die gegen ein Gerichtsurteil einer unteren Instanz, das in einem juristischen Werk einer höheren Instanz erfasst ist, Rechtsmittel (Berufung/Revision) einlegt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα φυσικό πρόσωπο, που ασκεί έφεση εναντίον απόφασης κατώτερου δικαστηρίου, που καταχωρίστηκε στα πρακτικά ενός ανωτέρου δικαστηρίου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يستأنف حكم صادر عن محكمة دنيا ومسجل في عمل قانوني لمحكمة عليا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与记录在上级法院的一种法律作品中起诉一个下级法院决定的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10043 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10043">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne demanderesse</rdfs:label>
        <rdfs:label xml:lang="vi">có cá nhân nguyên đơn</rdfs:label>
        <rdfs:label xml:lang="tr">davacı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">felperese a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come querelante persona </rdfs:label>
        <rdfs:label xml:lang="et">hageja (isik)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er sagsøger</rdfs:label>
        <rdfs:label xml:lang="no">har saksøker (person)</rdfs:label>
        <rdfs:label xml:lang="en">has plaintiff person</rdfs:label>
        <rdfs:label xml:lang="de">hat Zivilklägerin/Zivilkläger (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aanklager-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">henkilökantaja</rdfs:label>
        <rdfs:label xml:lang="lv">prasītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona demandante</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona demandant</rdfs:label>
        <rdfs:label xml:lang="el">έχει ενάγον φυσικό πρόσωπο</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مدعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有原告个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, hukuk davasına taşıyan kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una persona che intenta un’azione legale nell’ambito di un procedimento civile.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki polgárjogi eljárás keretében pert indít.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka nostaa kanteen siviilioikeudenkäyntiin.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với cá nhân đưa ra đơn kiện trong vụ kiện dân sự.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui intente une poursuite civile.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que interposa una demanda civil.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que entabla una demanda en un proceso civil.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een proces aanspant in een civielrechtelijke procedure.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er saksøker i en sivilrettslig sak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som anlægger en sag i en civilproces.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who brings a suit in a civil proceeding.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ceļ prasību civiltiesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes esitab tsiviilkohtumenetluses hagi.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die eine Klage in ein Zivilverfahren einbringt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα φυσικό πρόσωπο, το οποίο ασκεί αγωγή στο πλαίσιο αστικής διαδικασίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يرفع دعوى ضمن دعوى مدنية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在民事诉讼中起诉的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10046 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10046">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent émetteur</rdfs:label>
        <rdfs:label xml:lang="vi">có tập thể công bố</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er udstedende organ</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has issuing agent</rdfs:label>
        <rdfs:label xml:lang="de">hat herausgebenden Akteur</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvaardiger-actor</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisija (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">kibocsátó ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">piyasaya çıkaran temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente emisor</rdfs:label>
        <rdfs:label xml:lang="lv">turpinājumizdevuma izdevējs (aģents)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent d’entitat editora</rdfs:label>
        <rdfs:label xml:lang="et">väljaandja (tegija)</rdfs:label>
        <rdfs:label xml:lang="el">έχει οργανισμό έκδοσης</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جهة إصدار</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有颁布行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eseri yayınlayan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente che emette un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely kibocsát egy művet.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka julkaisee teoksen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân công bố tác phẩm, như là cơ quan chính thức của tập thể.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui publie une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que publica una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que emite una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een werk uitvaardigt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som utgir et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som udgiver et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who issues a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas izdevis turpinājumizdevumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes annab teose välja.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der ein Werk heraus gibt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα, ο οποίος εκδίδει ένα έργο, όπως ένα επίσημο όργανο του οργάνου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يصدر عملا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与颁布一种作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10050 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10050">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent programmeur</rdfs:label>
        <rdfs:label xml:lang="vi">có người lập trình</rdfs:label>
        <rdfs:label xml:lang="it">ha come programmatore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er programmør</rdfs:label>
        <rdfs:label xml:lang="no">har programmerer (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has programmer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Programmiererin/Programmierer (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft programmeur-actor</rdfs:label>
        <rdfs:label xml:lang="fi">ohjelmoija (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">program temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">programmeerija (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">programmētājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="hu">programozó ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente programador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent programador</rdfs:label>
        <rdfs:label xml:lang="el">έχει προγραμματιστή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مبرمج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编程者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bilgisayar programı tasarlamaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un programma per computer.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy számítógépes program megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa tietokoneohjelman luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm sáng tạo chương trình máy tính.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’un programme informatique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’un programa informàtic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear un programa de computadora.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een computerprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et dataprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et computerprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a computer program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par datorprogrammas izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab arvutiprogrammi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines Computerprogramms verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός προγράμματος υπολογιστή.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء برنامج كمبيوتر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种计算机程序的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10051 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10051">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent designer</rdfs:label>
        <rdfs:label xml:lang="vi">có người thiết kế</rdfs:label>
        <rdfs:label xml:lang="fi">designer (toimija)</rdfs:label>
        <rdfs:label xml:lang="lv">dizainers (aģents)</rdfs:label>
        <rdfs:label xml:lang="it">ha come designer agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er designer</rdfs:label>
        <rdfs:label xml:lang="no">har designer (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has designer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Designerin/Designer (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ontwerper-actor</rdfs:label>
        <rdfs:label xml:lang="et">kujundaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="tr">tasarımcı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">tervező ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente diseñador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent dissenyador</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχεδιαστή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مصمم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有设计者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir nesnenin tasarımından sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione del progetto di un oggetto.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy tárgy tervezetének a megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa kohteen suunnittelusta tai muotoilusta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm sáng tạo thiết kế cho vật thể.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la conception d’un objet.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’un disseny d’un objecte.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear un diseño para un objeto.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een ontwerp voor een object.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å designe en gjenstand.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at designe et objekt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a design for an object.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par objekta dizaina radīšanu/izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab objekti kujunduse loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Gestaltung des Designs eines Objekts verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τον σχεδιασμό ενός αντικειμένου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إعداد تصميم لكائن.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个物体的设计的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10052 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10052">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent cartographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có người lập bản đồ</rdfs:label>
        <rdfs:label xml:lang="lv">darba kartogrāfs (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kartograf temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come cartografo agente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er kartograf for værk</rdfs:label>
        <rdfs:label xml:lang="no">har kartograf for verk (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has cartographer agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Kartografin/Kartografen eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cartograaf-actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű térképész ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen kartantekijä (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose kartograaf (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente cartógrafo de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent cartògraf d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει χαρτογράφο</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل رسام خرائط لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的地图绘制者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kartografik bir eser oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile di un&apos;opera cartografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy kartográfiai mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa kartografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập bản đồ, tập bản đồ, quả địa cầu, hoặc tác phẩm bản đồ khác.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre cartographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra cartogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra cartográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een cartografisch werk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for et kartografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a cartographic work.</skos:definition>
        <skos:definition xml:lang="no">Relateter et verk til en agent som er ansvarlig for et kartografisk verk.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par karti, atlantu, globusu vai citu kartogrāfijas materiālu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab kartograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines kartografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός χάρτη, ενός άτλαντα, μιας υδρόγειας σφαίρας ή άλλου χαρτογραφικού έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل خرائطي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种地图作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10053 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10053">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent compositeur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có người soạn</rdfs:label>
        <rdfs:label xml:lang="lv">darba komponists (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin besteci temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compositore agente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er komponist af værk</rdfs:label>
        <rdfs:label xml:lang="no">har komponist for verk (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has composer agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Komponistin/Komponisten eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft componist-actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű zeneszerző ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen säveltäjä (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose helilooja (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente compositor de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent compositor d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει συνθέτη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل ملحن لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的作曲者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, müzik eseri oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un&apos;opera musicale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy zenemű megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa musiikkiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm âm nhạc.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een muziekwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et musikalsk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et musikværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a musical work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par mūzikas darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab muusikateose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός μουσικού έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسؤول عن إنشاء عمل موسيقي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种音乐作品的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Bewerken van een ander muziekwerk om een onderscheidende aanpassing te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E’ incluso l’adattamento di un’altra opera musicale per costituire una variazione distinta, tramite la parafrasi o la creazione di un’opera nello stile tipico di un altro compositore o tramite la creazione di un’opera basata sulla musica di un altro compositore</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">La adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra al estilo general de otro compositor, o crear una obra que está basada en la música de otro compositor, se incluye.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Phỏng theo tác phẩm âm nhạc khác thành hình thái sửa đổi riêng, diễn giải tác phẩm hoặc tạo lập tác phẩm với phong cách chung của người soạn khác, hoặc tạo lập tác phẩm dựa trên âm nhạc của người soạn khác, được bao gồm.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">zeneszerző:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Περιλαμβάνεται η προσαρμογή ενός άλλου μουσικού έργου για να αποτελέσει μια διακριτή μεταβολή, η παράφραση ενός έργου ή η δημιουργία ενός έργου στο γενικό ύφος ενός άλλου συνθέτη ή η δημιουργία ενός έργου που βασίζεται στη μουσική ενός άλλου συνθέτη.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين تكييف عمل موسيقي آخر لتشكيل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل يعتمد على موسيقى ملحن آخر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创建一种新的作品、或者基于另一个作曲者的音乐创建一种新的作品。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10054 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10054">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent inventeur</rdfs:label>
        <rdfs:label xml:lang="vi">có người phát minh</rdfs:label>
        <rdfs:label xml:lang="hu">feltaláló ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come inventore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er opfinder</rdfs:label>
        <rdfs:label xml:lang="no">har oppfinner (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has inventor agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Erfinderin/Erfinder (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvinder-actor</rdfs:label>
        <rdfs:label xml:lang="lv">izgudrotājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="fi">keksijä (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">leiutaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="tr">mucit temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente inventor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent inventor</rdfs:label>
        <rdfs:label xml:lang="el">έχει εφευρέτη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مخترع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发明者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, yeni bir cihaz veya işlem oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un nuovo dispositivo o procedimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy új eszköz vagy eljárás létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa uuden välineen tai menetelmän luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập sáng chế hoặc quy trình mới.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’un nouveau dispositif ou procédé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’un mecanisme o un procés nou.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear un nuevo dispositivo o proceso.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een nieuw apparaat of proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape en ny innretning eller prosess.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe en ny anordning eller proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a new device or process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par jaunas ierīces vai procesa radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab uue seadme või protsessi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία μιας νέας συσκευής ή διαδικασίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء جهاز أو عملية جديدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种新装置或新过程的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10055 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10055">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent compilateur</rdfs:label>
        <rdfs:label xml:lang="vi">có người biên soạn</rdfs:label>
        <rdfs:label xml:lang="tr">derleyen temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compilatore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er kompilator</rdfs:label>
        <rdfs:label xml:lang="no">har utarbeider (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has compiler agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Zusammenstellende/Zusammenstellenden (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft samensteller-actor</rdfs:label>
        <rdfs:label xml:lang="fi">kokoaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">koostaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">sastādītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente compilador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent compilador</rdfs:label>
        <rdfs:label xml:lang="hu">összeállító ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="el">έχει συμπιλητή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مجمع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编纂者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, üstveri seti oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di una nuova opera come una bibliografia o un repertorio, tramite la la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely adatok, információk stb. kiválasztása, elrendezése, aggregálása és szerkesztése révén felelős egy olyan új mű létrehozásáért, mint például egy bibliográfia vagy adattár.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa uuden teoksen, kuten bibliografian tai hakemiston luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm mới như là thư mục hoặc danh bạ bằng cách lựa chọn, sắp xếp, tập hợp, và biên tập dữ liệu, thông tin, v.v...</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’un ensemble de métadonnées descriptives.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’un conjunt de descripció de metadades.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear un conjunto de descripción de metadatos.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a metadata description set.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός νέου έργου, όπως μιας βιβλιογραφίας ή ενός οδηγού μέσω της επιλογής, της οργάνωσης, της συλλογής και της επιμέλειας δεδομένων, πληροφοριών κ.λπ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个元数据描述集的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono esclusi la revisione o il chiarimento del contenuto di una espressione dell’opera e la selezione e la raccolta di espressioni di opere o di parti di opere</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Sửa lại hoặc làm rõ nội dung, hoặc lưa chọn và kết hợp lại các tác phẩm hoặc phần của tác phẩm, bởi một hoặc nhiều hơn người sáng tạo, được bao gồm</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Toimija, joka on vastuussa uuden teoksen, kuten bibliografian tai luettelon luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares y una ayuda analítica para hallazgos.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">összeállító:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Δεν περιλαμβάνεται η αναθεώρηση ή η αποσαφήνιση του περιεχομένου ή η επιλογή και η συγκέντρωση έργων ή μερών ενός έργου από έναν ή περισσότερους δημιουργούς.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن الأعمال أو أجزاء من الأعمال وتجميعها.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10056 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10056">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent photographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có người chụp ảnh</rdfs:label>
        <rdfs:label xml:lang="tr">eserin fotoğrafçı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">fotogrāfs (aģents)</rdfs:label>
        <rdfs:label xml:lang="it">ha come fotografo agente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er fotograf af værk</rdfs:label>
        <rdfs:label xml:lang="no">har fotograf for verk (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has photographer agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Fotografin/Fotografen eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fotograaf-actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű fényképész ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen valokuvaaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose fotograaf (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente fotógrafo de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent fotògraf d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει φωτογράφο</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مصور لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的摄影者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, fotoğraf eseri oluşturmaktan sorumlu bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un&apos;opera fotografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy fényképészeti mű megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa valokuvateoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm nhiếp ảnh.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre photographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra fotogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra fotográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een fotografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et fotografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et fotografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a photographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par fotogrāfiska darba izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab fotograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines fotografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός φωτογραφικού έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسؤول عن إبداع عمل مصور.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种摄影作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10057 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10057">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent intervieweur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có người phỏng vấn</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervējis (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşmeci temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistatore agente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er interviewer for værk</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuer for verk</rdfs:label>
        <rdfs:label xml:lang="en">has interviewer agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewerin/Interviewer eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft interviewer-actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúkészítő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastattelija (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueerija (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente entrevistador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent entrevistador d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει συνεντευκτή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل محاور لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的采访者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, röportajcı, muhabir, anketör veya bilgi toplayan başka bir tür temsilci olarak hareket ederek bir eser oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile di un&apos;opera tramite la sua azione come intervistatore, reporter, sondaggista o altro agente che raccoglie informazioni. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő ágensként cselekszik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm bằng cách hoạt động như là người phỏng vấn, người báo cáo, người thăm dò ý kiến, hoặc tác nhân thu thập thông tin khác.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre agent qui recueille de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus d’agent que recull la informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de actuar como un entrevistador, reportero, encuestador u otro tipo de agente que recolecta información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of agent who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva tegijana.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines Werks verantwortlich ist, indem er als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder anderer Akteur Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός έργου ενεργώντας ως συνεντευκτής, δημοσιογράφος, δημοσκόπος ή ως κάποιος άλλος φορέας συγκέντρωσης πληροφοριών.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل من خلال قيامه بدور محاور، أو مراسل، أو مستطلع آراء، أو وكيل من نوع آخر يجمع معلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过担当采访者、记者、民意调查员或其他类型信息搜集行为者而对一种作品的创建负责的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10058 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10058">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent artiste</rdfs:label>
        <rdfs:label xml:lang="vi">có nghệ sỹ</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er kunstner</rdfs:label>
        <rdfs:label xml:lang="no">har kunstner (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has artist agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Künstlerin/Künstler (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kunstenaar-actor</rdfs:label>
        <rdfs:label xml:lang="et">kunstnik (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">mākslinieks (aģents)</rdfs:label>
        <rdfs:label xml:lang="hu">művész ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">sanatçı temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">taiteilija (toimija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente artista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent artista</rdfs:label>
        <rdfs:label xml:lang="el">έχει καλλιτέχνη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل فنان</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有美术家行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, orijinal bir grafik tasarım, çizim, resim vb. oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un progetto grafico, schizzo, dipinto, etc. originali.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy eredeti grafikai terv, rajz, festmény, stb. megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm bằng cách tưởng tượng, và thường thực hiện thiết kế, vẽ, hoạ, v.v...thiết kế đồ hình nguyên gốc.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’un graphisme, d’une peinture, d’un dessin, etc. original.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’un disseny gràfic, un dibuix, una pintura, etc., original.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de concebir, y frecuentemente implementar, un diseño gráfico, dibujo, pintura, etc. original.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et originalt grafisk design, en tegning, et maleri etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et originalt grafisk design, -tegning, -maleri etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating an original graphic design, drawing, painting, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par darba radīšanu un īstenošanu, izmantojot oriģinālu grafisko dizainu, zīmēšanu, gleznošanu, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab originaalse graafilise kujunduse, joonistuse, maali vms loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός έργου μέσω της σύλληψης και συχνά της εφαρμογής ενός πρωτότυπου γραφικού σχεδίου, σκίτσου, πίνακα ζωγραφικής κ.λπ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن ابتكار تصميم رسومي أصلي، ورسم، ورسم زيتي، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责完成原创图形设计、绘图、绘画等的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10059 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10059">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent interviewé d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có người được phỏng vấn</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervēts (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşülen temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistato agente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er interviewperson for værk</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuobjekt for verk (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has interviewee agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewte/Interviewten eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geïnterviewde actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúalany ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastateltava (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueeritav (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente entrevistado de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent entrevistat d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει συνεντευξιαζόμενο</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل ضيف مقابلة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的受访者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, genellikle bir muhabir, anketör veya bilgi toplayan başka bir tür temsilci olan bir görüşmeciye yanıt vererek bir eser oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un&apos;opera tramite le risposte rilasciate a un intervistatore, solitamente un reporter, sondaggista o altro agente che raccoglie informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy mű létrehozásáért oly módon, hogy válaszol egy interjúkészítőnek, általában riporternek, közvélemény-kutatónak, vagy valamilyen más információgyűjtő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa teoksen luomisesta vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jonkinlaiselle muulle toimijalle, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm bằng cách trả lời người phỏng vấn, thường là người báo cáo, người thăm dò ý kiến, hoặc hoặc tác nhân thu thập thông tin khác.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre en répondant à un intervieweur, habituellement un reporteur, un sondeur ou un autre agent qui recueille de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra responent a un entrevistador, habitualment un periodista, un enquestador o qualsevol altre tipus d’agent que recull la informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra al responder a un entrevistador, comúnmente un reportero, encuestador u otro tipo de agente que recolecta información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een werk door het antwoorden op een interviewer, meestal een journalist, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et verk ved å svare på spørsmål fra en intervjuer, reporter eller annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et værk ved at besvare spørgsmål fra en interviewer, normalt en journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a work by responding to an interviewer, usually a reporter, pollster, or some other kind of agent who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par darba radīšanu, atbildot uz intervētāja, parasti reportiera, aptaujas organizētāja vai kāda cita informācijas apkopotāja jautājumiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab teose loomise eest, vastates intervjueerijale, reporterile, küsitlejale või muule infot koguvale tegijale.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines Werks verantwortlich ist, indem er einer Interviewerin/einem Interviewer antwortet. Dabei handelt es sich normalerweise um eine Reporterin/einen Reporter, eine Meinungsforscherin/einen Meinungsforscher oder eine andere Akteurin/einen anderen Akteur, die/der Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός έργου αποκρινόμενο στον συνεντευκτή, συνήθως δημοσιογράφο, δημοσκόπο ή κάποιον άλλον φορέα συλλογής πληροφοριών.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل من خلال الرد على محاور، عادة يكون مراسلا، أو مستطلع آراء، أو وكيل من نوع آخر يجمع معلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过回答采访者（通常是记者、民意调查员或其他类型信息搜集行为者）而对一种作品的创建负责的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10060 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10060">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent chorégraphe</rdfs:label>
        <rdfs:label xml:lang="vi">có biên đạo múa</rdfs:label>
        <rdfs:label xml:lang="it">ha come coreografo agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er koreograf</rdfs:label>
        <rdfs:label xml:lang="no">har koreograf (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has choreographer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Choreografin/Choreografen (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft choreograaf-actor</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfs (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">koreograaf (tegija)</rdfs:label>
        <rdfs:label xml:lang="tr">koreograf temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">koreografi (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfus ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente coreógrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent coreògraf</rdfs:label>
        <rdfs:label xml:lang="el">έχει χορογράφο</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مصمم رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Br eseri, koreografik bir eser oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un&apos;opera coreografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet ágenshez, amely felelős egy koreografikus mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa koreografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm động thái.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre chorégraphique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra coreogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra coreográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een choreografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et koreografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for et koreografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a choreographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par horeogrāfisku darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab koreograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines choreografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός έργου κίνησης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن ابتكار عمل راقص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种编舞作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10061 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10061">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent auteur</rdfs:label>
        <rdfs:label xml:lang="lv">autors (aģents)</rdfs:label>
        <rdfs:label xml:lang="vi">có tác giả</rdfs:label>
        <rdfs:label xml:lang="it">ha come autore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er forfatter</rdfs:label>
        <rdfs:label xml:lang="no">har forfatter (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has author agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Verfasserin/Verfasser (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft auteur-actor</rdfs:label>
        <rdfs:label xml:lang="fi">kirjoittaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">szerző ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">tekstteose autor (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente autor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent autor</rdfs:label>
        <rdfs:label xml:lang="tr">yazar temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει συγγραφέα</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مؤلف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有著者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, yazılı eser oluşturmaktan sorumlu bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile di un&apos;opera testuale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy szöveges mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa tekstiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập tác phẩm chủ yếu là nguyên bản trong nội dung, bất kể loại phương tiên và thể loại.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre textuelle.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra textual.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra textual.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een tekstwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for et tekstlig verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for et tekstværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a textual work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par tekstuālu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab tekstteose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines textlichen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός έργου κυρίως κειμενικού περιεχομένου, ανεξάρτητα από τον τύπο του μέσου μετάδοσης ή το γένος/είδος.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل نصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种文字作品的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Başka bir yaratıcıya ait eserlerin yeniden yazılması, yeniden ifade edilmesi veya uyarlanması yoluyla, eğer yapılan değişiklik orijinal eserin niteliğini ve içeriğini önemli ölçüde değiştirmişse ya da ifade ortamını dönüştürmüşse, yeni bir eser oluşturulması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Creatie van een nieuw werk door het parafraseren, herschrijven of bewerken van werken van een andere maker, als de wijziging de aard en content van het origineel substantieel gewijzigd heeft of het medium van expressie gewijzigd heeft, is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Creation of a new work by paraphrasing, rewriting, or adapting works by another creator, if the modification has substantially changed the nature and content of the original or changed the medium of expression, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Schaffung eines neuen Werks durch Paraphrasieren, Umschreiben oder Adaption von Werken einer anderen geistigen Schöpferin/eines anderen geistigen Schöpfers, wenn die Veränderung die Art und den Inhalt des Originals substanziell verändert hat oder sich das Medium der Expression geändert hat.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å skape et nytt verk ved å omskrive eller bearbeide verk av en annen opphaver er inkludert hvis dette i vesentlig grad har endret originalverkets særpreg og innhold, eller hvis mediet for uttrykket er endret.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uue teose loomist, ümber sõnastades, ümber töötades või adapteerides teise autori teoseid, kui teisendamine on originaali olemust ja sisu oluliselt muutnud või muutunud on väljenduse meedium.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver arī jauna darba radīšanu, pārfrazējot, pārrakstot vai pielāgojot cita radītāja darbus, ja ir būtiski mainīta pamatdarba būtība, saturs vai izteiksmes nesējs.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la creació d’una obra nova parafrasejant, reescrivint o adaptant obres d’un altre creador, si la modificació ha canviat substancialment la natura i el contingut de l’original o si ha canviat el mitjà d’expressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Include la creazione di una nuova opera parafrasando, riscrivendo o o adattando le opere di un altro creatore, se la modifica ha cambiato in modo sostanziale la natura e il contenuto dell’originale o il mezzo dell’espressione</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">La creación de una nueva obra al parafrasear, reescribir o adaptar obras de otro creador, si la modificación ha cambiado sustancialmente la naturaleza y contenido del original, o cambiado el medio de expresión, se incluye.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La création d’une nouvelle œuvre en paraphrasant, en réécrivant ou en adaptant les œuvres d’un autre créateur est incluse, si la modification a changé considérablement la nature et le contenu de l’original ou a changé le mode d’expression.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Skabelse af et nyt værk ved at parafrasere, omskrive eller bearbejde værker af et andet ophav, hvis modificeringen har medført en væsentlig ændring af originalens karakter og indhold, eller den har ændret udtryksmediet, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Sáng tạo tác phẩm mới bằng cách diễn giải, viết lại, hoặc phỏng theo tác phẩm bởi người sáng tạo khác, nếu sửa chữa có thay đổi cơ bản bản chất và nội dung của nguyên gốc hoặc thay đổi phương tiện của biểu hiện, được bao gồm.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">szerző ágens:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Περιλαμβάνεται η δημιουργία ενός νέου έργου μέσω της παράφρασης, η επανασυγγραφή ή η προσαρμογή έργων από έναν άλλον δημιουργό, εφόσον η τροποποίηση έχει μεταβάλει ουσιαστικά τη φύση και το περιεχόμενο του πρωτότυπου ή έχει αλλάξει το μέσο της έκφρασης.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين إنشاء عمل جديد عن طريق إعادة الصياغة، أو إعادة الكتابة، أو تكييف أعمال منشئ آخر، إذا كان التعديل قد غيَّر تغيرا كبيرا طبيعة الأصل ومحتواه أو وسيط التعبيرة.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">通过演绎、改写或改变另一个创建者的作品所作而成的新作品的创建，如果修改实质性改变了原作的性质和内容或者改变了内容表达的媒介，应被包括在内。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10062 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10062">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent architecte</rdfs:label>
        <rdfs:label xml:lang="et">arhitekt (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">arhitekts (aģents)</rdfs:label>
        <rdfs:label xml:lang="fi">arkkitehti (toimija)</rdfs:label>
        <rdfs:label xml:lang="vi">có kiến trúc sư</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er arkitekt</rdfs:label>
        <rdfs:label xml:lang="no">har arkitekt (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has architect agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Architektin/Architekten (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft architect-actor</rdfs:label>
        <rdfs:label xml:lang="tr">mimar temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente arquitecto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent arquitecte</rdfs:label>
        <rdfs:label xml:lang="hu">építész ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="el">έχει αρχιτέκτονα</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مهندس معماري</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有建筑师行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir binanın veya diğer bir yapının tamamlandığında nasıl görüneceğini göstermeyi amaçlayan resimsel bir temsil de dahil olmak üzere mimari bir tasarım oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un progetto architettonico inclusa una rappresentazione visiva  destinata a mostrare l&apos;aspetto che avrà una costruzione una volta completata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy építészeti tervért, beleértve egy képi ábrázolást, melynek célja bemutatni, hogy egy épület stb. az elkészülte után hogyan fog kinézni.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập thiết kế kiến trúc, bao gồm cả trình bày bằng tranh để chỉ ra toà nhà sẽ trông như thế nào khi hoàn thành.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une conception architecturale, y compris une représentation illustrée conçue pour montrer à quoi ressemblera un bâtiment ou une autre structure une fois la construction terminée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’un disseny arquitectònic, inclosa una representació il·lustrada concebuda per mostrar com serà un edifici o qualsevol altra estructura una vegada complet.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear un diseño arquitectónico, incluyendo una representación ilustrada destinada a mostrar cómo se verá un edificio u otra estructura cuando haya sido completada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een architectonisch ontwerp, omvattende een picturale representatie bedoeld te laten zien hoe een gebouw of andere structuur er na voltooiing uit zal zien.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape en arkitektonisk utforming, inkludert en gjengivelse i bildeform som er ment å vise hvordan en bygning eller annen struktur vil se ut når den er ferdig.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for et arkitektonisk design, inkl. en billedrepræsentation, som skal vise, hvordan en bygning eller anden struktur vil se ud, når den er færdig.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating an architectural design, including a pictorial representation intended to show how a building or other structure will look when completed.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par arhitektūras projekta radīšanu, ieskaitot projekta skici, lai parādītu, kā ēka vai cita struktūra izskatīsies, kad tā tiks pabeigta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab arhitektuurse kujunduse loomise eest, k.a pildiline esitus, mis näitab, kuidas ehitis või muu konstruktsioon valmides välja hakkab nägema.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines architektonischen Entwurfs verantwortlich ist, einschließlich einer bildlichen Darstellung, die zeigt, wie ein Gebäude oder eine andere Konstruktion nach der Fertigstellung aussehen soll.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα, υπεύθυνο για τη δημιουργία ενός αρχιτεκτονικού σχεδίου, περιλαμβανομένης μιας οπτικής αναπαράστασης με στόχο να δείξει π.χ., την όψη του κτηρίου όταν αυτό θα έχει ολοκληρωθεί.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء تصميم معماري، يتضمن تمثيل تصويري يهدف إلى إظهار كيف سيبدو المبنى أو هيكل آخر عند اكتماله.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建建筑设计（包括用于展示建筑或其他结构完成之后外观效果的绘画作品）的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10063 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10063">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent cinéaste</rdfs:label>
        <rdfs:label xml:lang="vi">có người làm phim</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvantekijä (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">film üreticisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas veidotājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">filmitegija (tegija)</rdfs:label>
        <rdfs:label xml:lang="hu">filmkészítő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come cineasta agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er filmskaber</rdfs:label>
        <rdfs:label xml:lang="no">har filmskaper (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has filmmaker agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmemacherin/Filmemacher (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmmaker-actor</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente cineasta</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent cineasta</rdfs:label>
        <rdfs:label xml:lang="el">έχει σκηνοθέτη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل صانع أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制片人行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bağımsız ya da kişisel film yapmaktan sorumlu olan bir temsilciyle eşleştirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della creazione di un film indipendente o realizzato autonomamente.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy független- vagy egy magánfilm létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập phim độc lập hoặc cá nhân.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’un film indépendant ou personnel.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una pel·lícula cinematogràfica independent o personal.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear un film independiente o personal.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een zelfstandige of persoonlijke film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape en uavhengig eller personlig film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe en indiefilm eller personlig film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating an independent or personal film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab sõltumatu või autorifilmi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines unabhängigen oder privaten Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός ανεξάρτητου ή προσωπικού φιλμ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن صنع فيلم مستقل أو شخصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种独立或个人电影的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A filmmaker is individually responsible for the conception and execution of all aspects of the film.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir film yapımcısı, filmin tüm yönlerinin tasarlanmasından ve yürütülmesinden bireysel olarak sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een filmmaker is individueel verantwoordelijk voor de conceptie en uitvoering van alle aspecten van de film.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En filmskaper har personlig ansvar for planen med og gjennomføringen av alle aspektene ved filmen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Filmas veidotājs ir pilnībā atbildīgs par visiem filmas koncepcijas un realizācijas aspektiem.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmitegija vastutab üksinda kõigi filmi aspektide kontseptsiooni ja teostamise eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmskaberen er individuelt ansvarlig for udtænkning og udførelse af alle filmens aspekter.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Người làm phim có trách nhiệm về ý niệm và thực hiện tất cả các khía cạnh của phim đó.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un cineasta es individualmente responsable de crear un film independiente o personal.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un cineasta è responsabile a livello individuale della concezione ed esecuzione di ogni aspetto del film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un cineasta és responsable a títol individual de la concepció i l’execució de tots els aspectes de la pel·lícula.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un cinéaste est responsable à titre individuel de la conception et de l’exécution de tous les aspects du film.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">filmkészítő ágens:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ένας σκηνοθέτης είναι ατομικά υπεύθυνος για τη σύλληψη και εκτέλεση όλων των πτυχών της ταινίας.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">صانع أفلام مسئول مسئولية فردية عن تصور جميع جوانب الفيلم وتنفيذه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制片人对电影所有方面的构思和执行负有个人责任</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10064 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10064">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent producteur</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà sản xuất</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er producer</rdfs:label>
        <rdfs:label xml:lang="no">har produsent (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has producer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-actor</rdfs:label>
        <rdfs:label xml:lang="lv">producents (aģents)</rdfs:label>
        <rdfs:label xml:lang="hu">producer ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">produtsent (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente productor</rdfs:label>
        <rdfs:label xml:lang="fi">tuottaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent productor</rdfs:label>
        <rdfs:label xml:lang="tr">yapımcı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει παραγωγό</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل منتج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制作者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir prodüksiyonun ticari yönlerinin çoğundan sorumlu bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés stb. legtöbb üzleti vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka vastaa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm về phần lớn khía cạnh kinh doanh của sản phẩm màn ảnh, ghi âm, truyền hình, web, v.v...</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, un programa de televisió, d’una emissió web, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, de grabación de audio, televisión, webcast, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές μιας παραγωγής επί της οθόνης, ηχογράφησης, τηλεοπτικής, διαδικτυακής εκπομπής κ.λπ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن معظم جوانب العمل الخاصة بالإنتاج للسينما، وللتسجيل الصوتي، وللتلفزيون، وللبث عبر الإنترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Nhà sản xuất có trách nhiệm tổng quát về nguồn tài chính, quản lý sản xuất, thuê mướn nhân sự chủ yếu, dắp xếp về nhà phân phppos, v.v...</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest. </skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un productor es generalmente responsable de recaudar fondos, gestionar la producción, contratar personal clave, llegar a acuerdos para distribuidores, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un produttore è in genere responsabile della raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">producer ágens.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ένας παραγωγός είναι γενικά υπεύθυνος για τη συγκέντρωση πόρων/χρηματοδότησης, τη διεύθυνση της παραγωγής, την πρόσληψη του βασικού προσωπικού, την οργάνωση της διανομής κ.λπ.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10065 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10065">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent créateur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có người sáng tạo</rdfs:label>
        <rdfs:label xml:lang="lv">darba radītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">es agente creador de obra de</rdfs:label>
        <rdfs:label xml:lang="tr">eserin yaratıcı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore agente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er ophav til værk</rdfs:label>
        <rdfs:label xml:lang="sv">har skapare</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av verk (agent) </rdfs:label>
        <rdfs:label xml:lang="en">has creator agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat geistige Schöpferin/geistigen Schöpfer eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű létrehozó ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen tekijä (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose autor (tegija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent creador d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει δημιουργό</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل منشئ لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创作者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm sáng tạo tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Schaffung eines Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创作一种作品的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of work includes an agent who is jointly responsible for the creation of a work either by performing the same role as another agent, such as in a collaboration between two writers, or by performing a different role, such as in a collaboration between a composer and a lyricist.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir eserin yaratıcısı, iki yazarın iş birliği gibi başka bir temsilciyle aynı rolü üstlenerek ya da bir besteci ve söz yazarı arasındaki iş birliği gibi farklı bir rol üstlenerek, eserin yaratılmasından ortaklaşa sorumlu olan bir temsilciyi kapsar.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darba radītājs ietver aģentu, kas ir atbildīgs par darba radīšanu un pilda tādu pašu lomu kā cits aģents, piemēram, kā sadarbībā starp diviem rakstniekiem vai veicot dažādas lomas, kā piemēram, komponista un teksta autora sadarbībā.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt ein Akteur, der für die Schaffung eines Werks mitverantwortlich ist, wenn er entweder dieselbe Rolle wie ein anderer Akteur ausführt, wie bei einer Zusammenarbeit zwischen zwei Schriftstellerinnen/Schriftstellern, oder eine andere Rollen ausführt, wie bei einer Zusammenarbeit zwischen einer Komponistin/einem Komponisten und einer Textdichterin/einem Textdichter.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van werk omvat een actor die gezamenlijk verantwoordelijk is voor de creatie van een werk door ofwel dezelfde rol uit te voeren als een andere actor, zoals bij een samenwerking door twee schrijvers, ofwel door een verschillende rol uit te voeren, zoals bij een samenwerking tussen een componist en een liedtekstschrijver.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En opphaver for verk inkluderer en agent med delt ansvar for å skape et verk, enten ved å fylle samme rolle som en annen agent, som i et samarbeid mellom to forfattere, eller ulike roller som i et samarbeid mellom en komponist og en sangtekstforfatter.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Người sáng tạo bao gồm tác nhân có trách nhiệm liên dới về sáng tạo tác phẩm hoặc có cùng vai trò, như là việc phối hợp giữa 2 người viết, hoặc có vai trò khác nhau, như là việc phối hợp giữa người soạn với nhà thơ trữ tình.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til værk omfatter en agent, som har fælles ansvar for at have skabt et værk enten ved at udføre den samme rolle som en anden agent, såsom i et samarbejde mellem to forfattere, eller ved at udføre en anden rolle, såsom i et samarbejde mellem en komponist og en tekstforfatter. </skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose autor hõlmab ka tegijat, kes kaasvastutab teose loomise eest, täites teise tegijaga kas sama rolli (nt kahe kirjaniku koostöö) või erinevat rolli (nt helilooja ja sõnade autori koostöö).</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de obra incluye un agente que es responsable en conjunto de la creación de una obra ya sea al desempeñar el mismo papel que otro agente, tal como en una colaboración entre dos escritores, o al desempeñar un papel distinto, tal como en una colaboración entre un compositor y un letrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una obra inclou un agent que és responsable conjuntament de la creació d’una obra ja sigui realitzant la mateixa funció que un altre agent, com ara una col·laboració entre dos escriptors, o realitzant funcions diferents, com ara una col·laboració entre un compositor i un lletrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di opera include un agente che è congiuntamente responsabile della creazione di un’opera sia ricoprendo lo stesso ruolo di un altro agente, come in una collaborazione tra due scrittori, sia ricoprendo un ruolo differente, come nella collaborazione tra un compositore e un paroliere</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une œuvre comprend un agent coresponsable de la création d’une œuvre soit en exerçant le même rôle qu’un autre agent, comme dans le cas d’une collaboration entre deux écrivains, soit en exerçant un rôles différent, comme dans le cas d’une collaboration entre un compositeur et un parolier.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">létrehozó:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Οι δημιουργοί περιλαμβάνουν τους φορείς που είναι συνυπεύθυνοι για τη δημιουργία ενός έργου είτε μέσω της εκτέλεσης του ίδιου ρόλου, όπως σε μια συνεργασία μεταξύ δύο συγγραφέων ή μέσω της εκτέλεσης διαφορετικών ρόλων, όπως σε μια συνεργασία μεταξύ ενός συνθέτη και ενός στιχουργού.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل منشئ العمل وكيلًا مسئولا مسئولية مشتركة عن إنشاء عمل إما عن طريق أداء نفس الدور الذي يؤديه وكيل آخر، كما هو الحال في التعاون بين كاتبين، وإما عن طريق أداء دور مختلف، كما هو الحال في التعاون بين ملحن ومؤلف أغاني.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">作品的创作者包括对作品的创建联合负责的行为者，他们或者行使同样的角色（例如两个写作者之间的合作）或者行使不同角色（例如作曲者和词作者之间的合作）。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10066 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10066">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent réalisateur</rdfs:label>
        <rdfs:label xml:lang="vi">có đạo diễn</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er instruktør</rdfs:label>
        <rdfs:label xml:lang="no">har regissør (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has director agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Regisseurin/Regisseur (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft regisseur-actor</rdfs:label>
        <rdfs:label xml:lang="fi">ohjaaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">rendező ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">režisors (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">režissöör (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente director</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent realitzador</rdfs:label>
        <rdfs:label xml:lang="tr">yönetmen temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει σκηνοθέτη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مخرج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有导演行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetiminden ve denetiminden sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile dell&apos;organizzazione e supervisione generali di una rappresentazione cinematografica, programma radiofonico o televisivo, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm quản lý và giám sát chung về biểu diễm làm phim, chương trình truyền thanh hoặc truyền hình, v.v...</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de la gestión y supervisión general de una presentación filmada, un programa de radio o televisión, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη γενική διαχείριση και εποπτεία μιας κινηματογραφικής παράστασης, ενός ραδιοφωνικού ή τηλεοπτικού προγράμματος κ.λπ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن الإدارة العامة والإشراف على أداء فيلمي، أو برنامج إذاعي أو تليفزيوني، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责电影表演、广播或电视节目等的全面管理和监督的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10067 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10067">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent parraineur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có tập thể tài trợ</rdfs:label>
        <rdfs:label xml:lang="lv">darba sponsors (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin sponsoru olan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come sponsor agente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er sponsor af værk</rdfs:label>
        <rdfs:label xml:lang="no">har sponsor for verk (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has sponsoring agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Trägerin/Träger eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft sponsor van werk-actor</rdfs:label>
        <rdfs:label xml:lang="hu">mű szponzoráló ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen sponsori (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose toetaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente patrocinador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent patrocinador d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει φορέα επιχορήγησης</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل راعٍ لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的赞助行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserin bazı bölümlerine sponsorluk yapan bir temsilcyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente che sponsorizza alcuni aspetti di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely egy művet valamilyen tekintetben szponzorál.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka sponsoroi teosta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân tài trợ khía cạnh nào đó của tác phẩm như là hỗ trợ nghiên cứu hoặc tài trợ sự kiện.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui parraine un aspect quelconque d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que patrocina algun aspecte d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que patrocina algún aspecto de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die enige aspecten van een werk sponsort.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er sponsor for et aspekt ved et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som sponsorerer et aspekt af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who sponsors some aspect of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas sponsorē dažus darba aspektus.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes mingil viisil majanduslikult toetab teose loomist.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der einzelne Aspekte eines Werks finanziell unterstützt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα που χρηματοδοτεί κάποια πτυχή ενός έργου, όπως μια επιδοτούμενη έρευνα ή χρηματοδότηση ενός συμβάντος.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يرعى بعض جوانب عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与赞助一种作品某方面的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="fr">Comprend le financement de la recherche et le parrainage d’un événement qui constitue la base d’une œuvre.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Forschungsförderungen und die finanzielle Unterstützung einer Veranstaltung, die die Grundlage eines Werks bilden.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uurimistöö rahastamist ja teose aluseks oleva ürituse majanduslikku toetamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver pētījumu finansēšanu un pasākuma sponsorēšanu, kas ir darba pamatā.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou el finançament de la recerca i el patrocini d’un esdeveniment que és la base d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Include la ricerca di fondi e la sponsorizzazione di un evento che è la base di un&apos;opera</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Includes funding research and sponsoring an event that is the basis of a work.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Incluye financiar investigación y patrocinar un evento que es la base de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Inkluderer finansiering av forskning og økonomisk støtte til et arrangement som er grunnlaget for et verk.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa tutkimuksen rahoituksen ja teoksen perustana olevan tapahtuman sponsoroinnin.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter finansiering af forskning og sponsorering af et arrangement, som er grundlag for et værk.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Omvat het financieren van onderzoek en het sponsoren van een evenement dat de basis vormt van een werk.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">eserin sponsoru olan temsilci ile ilişkilidir</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">szponzor:</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يشمل تمويل البحث ورعاية حدث يمثل أساس عمل.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括资助作为一种作品之基础的研究以及赞助作为一种作品之基础的一项活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10068 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10068">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent directeur de la photographie</rdfs:label>
        <rdfs:label xml:lang="vi">có giám đốc hình ảnh</rdfs:label>
        <rdfs:label xml:lang="tr">görüntü yönetmeni temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore della fotografia agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er filmfotograf</rdfs:label>
        <rdfs:label xml:lang="no">har filmfotograf (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has director agent of photography</rdfs:label>
        <rdfs:label xml:lang="de">hat Kamerafrau/Kameramann (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cameraregisseur-actor</rdfs:label>
        <rdfs:label xml:lang="lv">kinooperators (aģents)</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">operaator-lavastaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="hu">operatőre a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente director de fotografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent director de fotografia</rdfs:label>
        <rdfs:label xml:lang="el">έχει διευθυντή φωτογραφίας</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مدير تصوير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有摄影指导行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, elektronik ortamda veya film ya da video stoğunda görüntü kaydeden ve genellikle ışıklandırmayı seçen ve düzenleyen bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente che cattura le immagini, sia elettronicamente che su pellicola o video, e spesso seleziona e sistema le luci.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân thu nạp hình ảnh, hoặc là bằng điện tử hoặc trên phim hoặc video, và thường lựa chọn, và bố trí chiếu sáng.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que captura imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente elige y organiza la iluminación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα ο οποίος συλλαμβάνει τις εικόνες είτε ηλεκτρονικά είτε με φιλμ είτε με βίντεο και συχνά επιλέγει και οργανώνει τον φωτισμό.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يلتقط الصور، إما إلكترونيا وإما بفيلم أو تسجيلات فيديو، وغالبا ما يختار الإضاءة وينسقها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A director of photography for a movie is also called a chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Kamerafrau/Ein Kameramann für einen Film wird auch als &quot;Bildregisseurin/Bildregisseur&quot; bezeichnet.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Filmfotografen for en film kalles også sjefsfotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmfotografen på en film kaldes også for en cheffotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Giám đố hình ảnh của phim điện ảnh cũng được gọi là nhà điện ảnh chính.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Kinooperatoru mēdz saukt arī par galveno operatoru.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un director de fotografia d’una pel·lícula també s’anomena primer operador.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un director de fotografía para una película también es llamado un primer cinematógrafo.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">operatőr ágens:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ένας διευθυντής φωτογραφίας σε μια ταινία ονομάζεται επίσης επικεφαλής κινηματογραφιστής.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">电影的摄影指导也称总摄影师</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10071 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10071">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent consultant</rdfs:label>
        <rdfs:label xml:lang="fi">asiantuntija (toimija)</rdfs:label>
        <rdfs:label xml:lang="vi">có người tư vấn</rdfs:label>
        <rdfs:label xml:lang="tr">danışman temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come consulente agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er rådgiver</rdfs:label>
        <rdfs:label xml:lang="no">har konsulent (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has consultant agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Beraterin/Berater (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft consultant-actor</rdfs:label>
        <rdfs:label xml:lang="et">konsultant (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">konsultants (aģents)</rdfs:label>
        <rdfs:label xml:lang="hu">tanácsadó ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente consultor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent consultor</rdfs:label>
        <rdfs:label xml:lang="el">έχει σύμβουλο</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل استشاري</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有顾问行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmeti veren ve genellikle tavsiyelerde bulunan bir temsilciyle ilişkilendirilir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente che fornisce servizi di consulenza, e spesso formula raccomandazioni a un agente correlato presentato come il creatore di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân cung cấp dịch vụ tư vấn, và thường đưa ra khuyến nghị, cho tác nhân khác người được nêu như là người sáng tạo của tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que provee servicios de consultoría, y frecuentemente hace recomendaciones, a un agente relacionado que es representado como un creador de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα που παρέχει υπηρεσίες συμβουλευτικής και συχνά κάνει συστάσεις σε κάποιον άλλον φορέα, ο οποίος αναπαρίσταται ως ο δημιουργός ενός έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يقدم خدمات استشارية، وغالبا ما يقدم مقترحات، لوكيل ذي صلة يقدَّم على أنه منشئ لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10073 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10073">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent producteur de cinéma</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà sản xuất phim</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvatuottaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">film yapımcısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas producents (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">filmiprodutsent (tegija)</rdfs:label>
        <rdfs:label xml:lang="hu">filmproducer ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore cinematografico agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er filmproducer</rdfs:label>
        <rdfs:label xml:lang="no">har filmprodusent (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has film producer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmproduzentin/Filmproduzenten (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmproducent-actor</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente productor fílmico</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent productor cinematogràfic</rdfs:label>
        <rdfs:label xml:lang="el">έχει παραγωγό</rdfs:label>
        <rdfs:label xml:lang="ar">وكيل منتج أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影制作者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir filmin yapımının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente produttore responsabile della maggior parte degli aspetti commerciali di un film.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer ágenshez, amely felelős egy filmprodukció üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nhà sản xuất có trách nhiệm với phần lớn khía cạnh kinh doanh của phim.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent producteur qui est responsable de la majeure partie des aspects commerciaux de la production d’un film.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de un film.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved en film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is a producer who is responsible for most of the business aspects of the production of a film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par filmas uzņemšanas finansiālajiem aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές μιας παραγωγής επί της οθόνης, ηχογράφησης, τηλεοπτικής, διαδικτυακής κ.λπ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل عبارة عن منتج مسئول عن معظم جوانب العمل في إنتاج فيلم.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电影制作的大部分商业运作的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10074 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10074">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent producteur de radio</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà sản xuất truyền thanh</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore radiofonico agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er radioproducer</rdfs:label>
        <rdfs:label xml:lang="no">har radioprodusent (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has radio producer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkproduzentin/Hörfunkproduzenten (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioproducent-actor</rdfs:label>
        <rdfs:label xml:lang="et">raadioprodutsent (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma producents (aģents)</rdfs:label>
        <rdfs:label xml:lang="fi">radiotuottaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yapımcısı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádiós producer ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente productor de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent productor radiofònic</rdfs:label>
        <rdfs:label xml:lang="el">έχει ραδιοφωνικό παραγωγό</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل منتج إذاعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播制作者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente produttore responsabile della maggior parte degli aspetti commerciali di un programma radiofonico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer ágenshez, amely felelős egy rádióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nhà sản xuất có trách nhiệm về phần lớn khía cạnh kinh doanh của chương trình thanh</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent producteur qui est responsable de la majeure partie des aspects commerciaux d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un productor que és responsable de la majoria dels aspectes comercials d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is a producer who is responsible for most of the business aspects of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu - producents, kurš ir atbildīgs par radio raidījuma darbības/biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes produtsendina vastutab enamiku äriliste aspektide eest raadiosaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν παραγωγό υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές ενός ραδιοφωνικού προγράμματος.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل عبارة عن منتج مسئول عن معظم جوانب العمل في برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责广播节目的大部分商业运作的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10075 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10075">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent producteur de télévision</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà sản xuất truyền hình</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore televisivo agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er tv-producer</rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsprodusent (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has television producer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehproduzentin/Fernsehproduzenten (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieproducent-actor</rdfs:label>
        <rdfs:label xml:lang="et">teleprodutsent (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">televisiotuottaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yapımcısı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televízió-producer ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma producents (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente productor televisivo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent productor de televisió</rdfs:label>
        <rdfs:label xml:lang="el">έχει τηλεοπτικό παραγωγό</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل منتج تليفزيوني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视制作者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente produttore responsabile della maggior parte degli aspetti commerciali di un programma televisivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer ágenshez, amely felelős egy televízióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta televisio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nhà sản xuất có trách nhiệm về phần lớn khía cạnh kinh doanh của chương trình truyền hình.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent producteur qui est responsable de la majeure partie des aspects commerciaux d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un productor que és responsable de la majoria dels aspectes comercials d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is a producer who is responsible for most of the business aspects of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu - producents, kurš atbildīgs par televīzijas raidījuma biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes produtsendina vastutab enamiku äriliste aspektide eest telesaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν παραγωγό υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές ενός τηλεοπτικού προγράμματος.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل عبارة عن منتج مسئول عن معظم جوانب العمل في برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电视节目的大部分商业运作的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10081 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10081">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour longitude et latitude</rdfs:label>
        <rdfs:label xml:lang="vi">có kinh độ và vĩ độ</rdfs:label>
        <rdfs:label xml:lang="tr">enlem ve boylam ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come longitudine e latitudine</rdfs:label>
        <rdfs:label xml:lang="no">har lengdegrad og breddegrad</rdfs:label>
        <rdfs:label xml:lang="sv">har longitud och latitud</rdfs:label>
        <rdfs:label xml:lang="da">har længdegrad og breddegrad</rdfs:label>
        <rdfs:label xml:lang="en">has longitude and latitude</rdfs:label>
        <rdfs:label xml:lang="de">hat Längengrad und Breitengrad</rdfs:label>
        <rdfs:label xml:lang="nl">heeft lengte- en breedtegraad</rdfs:label>
        <rdfs:label xml:lang="hu">hosszúsági és szélességi foka a következő:</rdfs:label>
        <rdfs:label xml:lang="et">pikkuskraad ja laiuskraad</rdfs:label>
        <rdfs:label xml:lang="fi">pituus- ja leveysasteet</rdfs:label>
        <rdfs:label xml:lang="es">tiene longitud y latitud</rdfs:label>
        <rdfs:label xml:lang="ca">té com a longitud i latitud</rdfs:label>
        <rdfs:label xml:lang="lv">ģeogrāfiskais garums un platums</rdfs:label>
        <rdfs:label xml:lang="el">έχει γεωγραφικό μήκος και γεωγραφικό πλάτος</rdfs:label>
        <rdfs:label xml:lang="ar">له خط طول وعرض</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有经度和纬度</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, en batı ve en doğu sınırlarının boylamı ile en kuzey ve en güney sınırlarının enlemi kullanılarak tanımlanan bir kartografik eserin kapsama alanı olan bir yerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un luogo che identifica un’area coperta dal contenuto cartografico di un’opera che utilizza la longitudine dei limiti orientale e occidentale e la latitudine dei limiti settentrionale e meridionale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy helyhez, amely azonosít egy kartográfiai mű által lefedett területet a legnyugatibb és legkeletibb határok hosszúságának és a legészakibb és legdélibb határok szélességének a használatával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen paikkaan, joka on kartografisen teoksen kattama alue, joka on identifioitu käyttämällä läntisimmän ja itäisimmän rajan pituusastetta sekä pohjoisimman ja eteläisimmän rajan leveysastetta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với hệ thống để nhận dạng khu vực được bao quát bởi nội dung bản đồ của tác phẩm sử dung kinh độ của biên giới cực tây và cực đông và vĩ độ của biên giới cực bắc và cực nam.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un lieu qui constitue la zone de couverture d’une œuvre cartographique identifiée à l’aide de la longitude des limites ouest et est et de la latitude des limites nord et sud.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un lloc que és l’àrea de cobertura d’una obra cartogràfica que s’identifica usant la longitud dels límits oest i est i la latitud dels límits nord i sud.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lugar que es el área de cobertura de una obra cartográfica que es identificada utilizando la longitud de los límites al extremo oeste y este y la latitud de los límites al extremo norte y sur.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een plaats die is het bestreken gebied van een cartografisch werk dat geïdentificeerd wordt met gebruikmaking van de lengtegraad van de meest westelijke en meest oostelijke grenzen en de breedtegraad van de meest noordelijke en meest zuidelijke grenzen.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et sted som identifiserer området som dekkes av det kartografiske innholdet til et verk, ved hjelp av lengdegrader for vestligste og østligste grense og breddegrader for nordligste og sørligste grense.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et sted, som identificerer det område, som dækkes af et værks kartografiske indhold, ved anvendelse af længdegrader for de vestligste og østligste grænser samt breddegrader for de nordligste og sydligste grænser.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a place that is the area of coverage of a cartographic work that is identified using the longitude of the westernmost and easternmost boundaries and the latitude of the northernmost and southernmost boundaries.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vietu, kas ir teritorija sistēmas resursa kartogrāfiskajā saturā ietvertās teritorijas identificēšanai, izmantojot ģeogrāfiskā garuma tālākās rietumu un austrumu robežas un ģeogrāfiskā platuma tālākās ziemeļu un dienvidu robežas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kohaga, mis tuvastatakse teose kartograafilise sisuga hõlmatud alana läänepoolseima ja idapoolseima piirjoone pikkuskraadi ning põhjapoolseima ja lõunapoolseima piirjoone laiuskraadi abil.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Gebiet, das den Abdeckungsbereich eines kartografischen Werks darstellt und anhand des Längengrads der westlichsten und östlichsten Grenze sowie des Breitengrads der nördlichsten und südlichsten Grenze identifiziert wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα σύστημα για την ταύτιση της περιοχής που καλύπτεται από το χαρτογραφικό περιεχόμενο ενός έργου που χρησιμοποιεί το γεωγραφικό μήκος για την ταύτιση της περιοχής των δυτικότερων και ανατολικότερων ορίων και το γεωγραφικό πλάτος για τα δυτικότερα και βορειότερα όρια.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومكان عبارة عن نطاق تغطية محتوى خرائطي لعمل محدد باستخدام خط الطول لأقصى الحدود الغربية والشرقية وخط العرض لأقصى الحدود الشمالية والجنوبية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一种地图作品的覆盖范围、用最西和最东边界的经度以及最北和最南边界的纬度标识的一个地点关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10082 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10082">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour ascension droite et déclinaison</rdfs:label>
        <rdfs:label xml:lang="vi">có độ xích kinh và độ lệch</rdfs:label>
        <rdfs:label xml:lang="it">ha come ascensione retta e declinazione</rdfs:label>
        <rdfs:label xml:lang="sv">har rektascension och deklination</rdfs:label>
        <rdfs:label xml:lang="da">har rektascension og deklination</rdfs:label>
        <rdfs:label xml:lang="no">har rektascensjon og deklinasjon</rdfs:label>
        <rdfs:label xml:lang="en">has right ascension and declination</rdfs:label>
        <rdfs:label xml:lang="de">hat Rektaszension und Deklination</rdfs:label>
        <rdfs:label xml:lang="nl">heeft rechte klimming en declinatie</rdfs:label>
        <rdfs:label xml:lang="et">otsetõus ja kääne</rdfs:label>
        <rdfs:label xml:lang="lv">rektascensija un deklinācija</rdfs:label>
        <rdfs:label xml:lang="fi">rektaskensio ja deklinaatio</rdfs:label>
        <rdfs:label xml:lang="hu">rektaszcenziója és deklinációja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene ascensión recta y declinación</rdfs:label>
        <rdfs:label xml:lang="ca">té com a ascensió recta i declinació</rdfs:label>
        <rdfs:label xml:lang="tr">yükseliş ve sapma ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει ορθή αναφορά και απόκλιση</rdfs:label>
        <rdfs:label xml:lang="ar">له صعود مستقيم وانحراف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有赤经和赤纬</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kartografik bir çalışmanın kapsamı olan ve dik yükseliş ve eğim açıları kullanılarak tanımlanan bir gök cisminin konumu olan bir yerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un sistema per identificare l’ubicazione di un oggetto celeste nel cielo coperto dal contenuto cartografico di un’opera che utilizza gli angoli di ascensione retta e declinazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy helyhez, amely egy kartográfiai mű által, rektaszcenzió és deklináció szögei segítségével, meghatározott égitest helyzete az égbolton.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen paikkaan, joka on taivaankappaleen sijainti, jonka kartografinen teos kattaa ja joka on identifioitu käyttämällä rektaskension ja deklinaation kulmamittoja.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với hệ thống để nhận dạng địa điểm của vật thể vũ trụ trong bầu trời bằng cách bao quát bằng nội dung bản đồ của tác phẩm dùng góc của độ xích kinh và độ lệch.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un lieu qui constitue l’emplacement d’un corps céleste constituant la couverture d’une œuvre cartographique et identifié à l’aide des angles d’ascension droite et de déclinaison.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un lloc que és la localització d’un cos celeste que és la cobertura d’una obra cartogràfica i s’identifica mitjançant els angles d’ascensió recta i de declinació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lugar que es la ubicación de un cuerpo celeste que es la cobertura de la obra cartográfica y es identificado utilizando los ángulos de ascensión recta y declinación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een plaats die is de locatie van een hemellichaam dat is de dekking van een cartografisch werk en is geïdentificeerd met gebruikmaking van de hoeken voor rechte klimming en declinatie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et system for å identifisere plasseringen til et himmellegeme som dekkes av det kartografiske innholdet til et verk, ved hjelp av vinklene for rektascensjon og deklinasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et system til identificering af placeringen af et himmellegeme på himlen, som dækkes af et værks kartografiske indhold, ved anvendelse af vinklerne for rektascension og deklination.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a place that is the location of a celestial body that is the coverage of a cartographic work and is identified using the angles of right ascension and declination.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vietu, kas ir teritorija identifikācijas sistēmas debess objekta vietas noteikšanai resursa kartogrāfiskajā saturā ietvertajā debess juma attēlojumā, izmantojot rektascensijas un deklinācijas leņķus.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose süsteemiga, mille abil tuvastatakse teose kartograafilises sisus hõlmatud taevakeha asukoht taevas, kasutades otsetõusu ja käände nurgamõõte.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Ort, bei dem es sich um die Position eines Himmelskörpers handelt, der Gegenstand eines kartografischen Werks ist, und anhand der Winkel der Rektaszension und der Deklination identifiziert wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα σύστημα για την ταύτιση της τοποθεσίας ενός ουράνιου αντικειμένου στον ουρανό που καλύπτεται από το χαρτογραφικό περιεχόμενο ενός έργου χρησιμοποιώντας τις γωνίες της ορθής αναφοράς και απόκλισης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومكان عبارة عن موقع جسم سماوي هو نطاق تغطية محتوى خرائطي لعمل ومحدد باستخدام زوايا الصعود المستقيم والانحراف.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个天体的位置并作为一种地图作品的覆盖范围并用赤经和赤纬的角度标识的一个地点关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10083 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10083">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour chaînes de paires de coordonnées</rdfs:label>
        <rdfs:label xml:lang="vi">có chuỗi các cặp toạ độ</rdfs:label>
        <rdfs:label xml:lang="it">ha come stringhe di coppie di coordinate</rdfs:label>
        <rdfs:label xml:lang="da">har strenge med koordinatpar</rdfs:label>
        <rdfs:label xml:lang="no">har strenger med koordinatpar</rdfs:label>
        <rdfs:label xml:lang="en">has strings of coordinate pairs</rdfs:label>
        <rdfs:label xml:lang="de">hat Reihen von Koordinatenpaaren</rdfs:label>
        <rdfs:label xml:lang="nl">heeft tekenreeksen van coördinatenparen</rdfs:label>
        <rdfs:label xml:lang="et">koordinaatide paaride rida</rdfs:label>
        <rdfs:label xml:lang="fi">koordinaattiparit</rdfs:label>
        <rdfs:label xml:lang="tr">koordinat çifti dizgesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">koordinátapár-láncai a következők:</rdfs:label>
        <rdfs:label xml:lang="lv">koordinātu pāru virknes</rdfs:label>
        <rdfs:label xml:lang="es">tiene secuencias de pares de coordenadas</rdfs:label>
        <rdfs:label xml:lang="ca">té com a cadenes de parells de coordenades</rdfs:label>
        <rdfs:label xml:lang="el">έχει αλφαριθμητικά των ζευγών συντεταγμένων</rdfs:label>
        <rdfs:label xml:lang="ar">له خطوط إحداثيات مزدوجة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有坐标对串</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, her bir köşe için koordinatlar kullanılarak bir çokgenle tanımlanan bir kartografik eserin kapsama alanı olan bir yerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un sistema per identificare l’area precisa coperta dal contenuto cartografico di un’opera che utilizza coordinate per ciascun vertice di un poligono.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy helyhez, egy kartográfiai mű által lefedett területhez, amely meghatározásához az a poligon csúcsainak koordinátáit használja.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen paikkaan, joka on kartografisen teoksen kattama alue, joka on identifioitu jokaisen kärjen koordinaatteja käyttävällä monikulmiolla.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với hệ thống để nhận dạng khu vực chính xác được bao quát bằng nội dung bản đồ của tác phẩm sử dụng các toạ độ cho mỗi đỉnh của đa giác.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un lieu qui constitue la zone de couverture d’une œuvre cartographique identifiée par un polygone à l’aide des coordonnées de chaque sommet.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un lloc que és l’àrea de cobertura d’una obra cartogràfica que s’identifica per un polígon mitjançant les coordenades de cada vèrtex.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lugar que el área de cobertura de una obra cartográfica que es identificada por un polígono utilizando coordinadas para cada vértice.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een systeem voor het identificeren van een exact gebied bestreken door de cartografische content van een werk waarbij coördinaten gebruikt worden voor elk hoekpunt van een veelhoek.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et system for å identifisere det eksakte området som dekkes av det kartografiske innholdet til et verk, ved hjelp av koordinater for hvert hjørne av et polygon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et system til identificering af det præcise areal, som dækkes af et værks kartografiske indhold, ved anvendelse af koordinater for hvert af en polygons toppunkter.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a place that is the area of coverage of a cartographic work that is identified by a polygon using coordinates for each vertex.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vietu, kas ir teritorija sistēmas precīzai teritorijas noteikšanai, izmantojot koordinātas katrai daudzstūra virsotnei.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose süsteemiga, mille abil tuvastatakse teose kartograafilises sisus hõlmatud täpne ala, kasutades hulknurga iga tipu koordinaate.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Gebiet, das den Abdeckungsbereich eines kartografischen Werks darstellt und durch ein Vieleck mit Koordinaten für jeden Eckpunkt identifiziert wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα σύστημα για την ταύτιση της ακριβούς περιοχής που καλύπτεται από το χαρτογραφικό περιεχόμενο ενός έργου που χρησιμοποιεί συντεταγμένες για κάθε κορυφή ενός πολύγωνου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومكان عبارة عن نطاق تغطية محتوى خرائطي لعمل محدد من خلال مضلع باستخدام إحداثيات لكل قمة مضلع.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为使用一个多边形每个角的坐标标识一种地图作品所覆盖范围的一个地点关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10086 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10086">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour variante de titre d’œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề khác của tác phẩm</rdfs:label>
        <rdfs:label xml:lang="lv">darba cits nosaukums</rdfs:label>
        <rdfs:label xml:lang="tr">eserin alternatif başlığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo variante di opera</rdfs:label>
        <rdfs:label xml:lang="no">har tittelvariant for verk</rdfs:label>
        <rdfs:label xml:lang="da">har variant af titel på værk</rdfs:label>
        <rdfs:label xml:lang="sv">har varianttitel för verket</rdfs:label>
        <rdfs:label xml:lang="en">has variant title of work</rdfs:label>
        <rdfs:label xml:lang="de">hat abweichenden Titel eines Werks</rdfs:label>
        <rdfs:label xml:lang="nl">heeft variant titel van werk</rdfs:label>
        <rdfs:label xml:lang="hu">műhöz tartozó címváltozat a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen varianttinimeke</rdfs:label>
        <rdfs:label xml:lang="et">teose variantpealkiri</rdfs:label>
        <rdfs:label xml:lang="es">tiene título variante de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a variant de títol d’obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει εναλλακτικό τίτλο για το έργο</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان عمل متغير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的变异题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, belirli bir uygulama veya bağlamda tercih için seçilmemiş eser başlığı olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un titolo dell’opera che non è scelto come preferito in un’applicazione o contesto specifici.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, amely egy olyan műcím, amelyet egy adott alkalmazásban vagy kontextusban nem részesítenek előnyben.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, joka on teoksen nimeke, jota ei ole valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nhan đề hoặc hình thái của nhan đề mà theo đó tác phẩm được biết tới nhưng khác với nhan đề hoặc hình thái của nhan đề được chọn như là nhan đề ưu tiên của tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est un titre d’œuvre ne faisant pas l’objet d’un choix privilégié dans une application ou un contexte spécifiques.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és un títol d’obra que no se selecciona com a preferent en una aplicació o un context específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es un título de obra que no está seleccionado para preferencia en una aplicación o un contexto específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat is een titel van werk die niet bij voorkeur geselecteerd is in een specifieke applicatie of context.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en tittel på verk som ikke er valgt som preferanse i en spesifikk applikasjon eller sammenheng.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en titel på værk, som ikke er valgt som præference i en specifik anvendelse eller kontekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is a title of work that is not selected for preference in a specific application or context.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir darba nosaukums, kas nav izvēlēts kā prioritārs noteiktā lietojumprogrammā vai kontekstā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose pealkirjaga, mis kindlas rakenduses või kontekstis ei ole valitud eelistatuks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Titel eines Werks, der in einer bestimmten Anwendung oder in einem bestimmten Kontext nicht als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν τίτλο ή μορφή τίτλου με τον (-ην) οποίο (-α) το έργο είναι γνωστό, που διαφέρει από έναν τίτλο ή μορφή τίτλου που έχει επιλεγεί ως ο προτιμώμενος τίτλος για το έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعنوان عمل لم يتم اختياره بتفضيل استخدامه في تطبيق محدد أو سياق محدد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个作品题名、并没有在一个特定的应用或语境中被首选的一个命名关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A variant title of work includes a title or form of title appearing on a manifestation of the work or found in reference sources, a title resulting from a different transliteration of a title, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir eserin alternatif başlığı, eserin bir gösteriminde yer alan veya referans kaynaklarında bulunan bir başlığı veya başlık biçimini, bir başlığın farklı bir çevirisinden kaynaklanan bir başlığı vb. içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darba cits nosaukums ietver nosaukumu vai tā veidu, kas parādās darba manifestācijā vai atrodams atsauces avotos, nosaukumā, kas iegūts no nosaukuma atšķirīgas transliterācijas u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Titel oder Titelformen, die in einer Manifestation des Werks erscheinen oder in Nachschlagewerken zu finden sind, Titel, die sich aus einer abweichenden Transliteration ergeben, und so weiter.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een variant titel van werk omvat een titel of vorm van titel die verschijnt op een manifestatie van een werk of die gevonden wordt in naslagwerken, een titel die resulteert uit een verschillende transliteratie van een titel etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En tittelvariant for verk inkluderer en tittel eller tittelform som forekommer på en manifestasjon av verket eller som finnes i referanseverk, en tittel som er resultat av en annen transkripsjon av en tittel, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Nhan đè khác của tác phẩm bao gồm cả nhan đề hoặc hình thái của nhan đề xuất hiện trên biểu hiện của tác phẩm hoặc được tìm thấy trong các nguồn tham khảo, nhan đề là kết quả của việc chuyển tự khác nhau của nhan đề, v.v...</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen varianttinimeke kattaa nimekkeen tai nimekkeen muodon, joka esiintyy teoksen manifestaatiossa tai tietolähteissä sekä nimekkeen eri translitteroinnit tms.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose variantpealkirjaks võib olla teose kehastuses või teatmeallikates leiduv pealkiri või pealkirjavorm, pealkirja erinevast translitereerimisest tulenev pealkiri vms.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un titolo variante dell’opera include un titolo o una forma del titolo che appare su una manifestazione dell’opera o citata nelle fonti di reference, un titolo che deriva da una traslitterazione differente di un titolo, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un título variante de obra incluye un título o forma de título que aparece en una manifestación de la obra o que se encuentra en fuentes de referencia, un título resultante de una transliteración diferente de un título, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una variant de títol d’obra inclou un títol o una forma de títol que figura a una manifestació de l’obra o trobat en fonts de referència, un títol que és el resultat d’una transliteració diferent del títol, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une variante de titre d’œuvre comprend un titre ou une forme de titre figurant sur une manifestation de l’œuvre ou trouvée dans les sources de référence, un titre qui résulte d’une translittération différente d’un titre, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Variant af titel på værk omfatter en titel eller form for titel, som forekommer på en manifestation for værket eller findes i referenceværker, en titel, som er et resultat af en anden translitteration af en titel, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">műhöz tartozó címváltozat:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ο εναλλακτικός τίτλος για το έργο περιλαμβάνει έναν τίτλο ή μια μορφή τίτλου που εμφανίζεται στην εκδήλωση του έργου ή εντοπίζεται στις πηγές αναφοράς, έναν τίτλο που προκύπτει από έναν διαφορετικό μεταγραμματισμό ενός τίτλου κ.λπ.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتضمن العنوان المغاير لعمل عنوانًا أو شكل عنوان يظهر على تجسيدة للعمل، أو موجود في مصادر مرجعية، أو عنوان ناتج عن نقحرة مختلفة لعنوان، إلخ.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">变异题名包括出现在该作品的载体表现上或在参考信息源中被发现的题名或题名形式、由题名的不同音译所导致的题名等。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10088 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10088">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour titre d’œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề của tác phẩm</rdfs:label>
        <rdfs:label xml:lang="lv">darba nosaukums</rdfs:label>
        <rdfs:label xml:lang="tr">eser başlığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo di opera</rdfs:label>
        <rdfs:label xml:lang="da">har titel på værk</rdfs:label>
        <rdfs:label xml:lang="no">har tittel på verk</rdfs:label>
        <rdfs:label xml:lang="sv">har verktitel</rdfs:label>
        <rdfs:label xml:lang="en">has title of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Titel eines Werks</rdfs:label>
        <rdfs:label xml:lang="nl">heeft titel van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű címe a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen nimeke</rdfs:label>
        <rdfs:label xml:lang="et">teose pealkiri</rdfs:label>
        <rdfs:label xml:lang="es">tiene título de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol d’obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει τίτλο του έργου</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, doğal dilde ve ortak söylemde kullanılan ifadelerde bir eserin unvanı olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una denominazione dell’opera in linguaggio e frasi naturali usati nel discorso comune.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, amely egy a műhöz tartozó természetes nyelvű megnevezés és a közbeszédben használt megfogalmazás.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, joka on luonnollisella kielellä ja sanamuodolla oleva, yleisessä diskurssissa käytetty teoksen nimitykseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với từ, ký tự, hoặc nhóm từ và/hoặc ký tự mà theo đó tác phẩm được biết tới.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est une appellation d’œuvre exprimée dans un langage et une formulation naturels et utilisée dans le langage courant.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és una apel·lació d’obra en llenguatge i frases naturals usada en el discurs comú.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es un apelativo de obra en lenguaje natural y fraseo utilizado en el discurso común.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat is een benaming van werk in natuurlijke taal en terminologie in gebruikelijke bewoording.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en betegnelse på et verk på et naturlig språk og med en frasering som brukes i vanlig diskurs.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en benævnelse på værk på normalsprog og med formuleringer, som bruges alment.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is an appellation of work in natural language and phrasing used in common discourse.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir darba apzīmējums dabiskajā valodā un frāzē, ko lieto kopējā diskursā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose nimetusega loomulikus keeles ja sõnastuses, mida kasutatakse ühises diskursuses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Bezeichnung für ein Werk in natürlicher Sprache und Ausdrucksweise, die beim normalen Sprechen und Schreiben verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια λέξη, έναν χαρακτήρα ή μια ομάδα λέξεων ή/και χαρακτήρων με τους οποίους είναι γνωστό ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية عبارة عن اسم تعريفي لعمل باللغة الطبيعية والصياغة المستخدمة في الخطاب العام.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为用自然语言和普通话语措词表达的作品的称谓的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10100 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10100">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af værk</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av verk</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de obra</rdfs:label>
        <rdfs:label xml:lang="tr">eserin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts darbam</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van werk</rdfs:label>
        <rdfs:label xml:lang="en">is description of work</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Werk)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud teos</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus teoksesta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő műnek:</rdfs:label>
        <rdfs:label xml:lang="vi">là mô tả của tác phẩm</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di opera</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιγραφή του (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是作品的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından tanımlanan bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un&apos;opera che è descritta da un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm được mô tả bởi tác phẩm mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui est décrite par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que és descrita per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que es descrita por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kas aprakstīts darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο που περιγράφεται από ένα περιγραφικό έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل موصوف في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10109 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10109">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour résumé</rdfs:label>
        <rdfs:label xml:lang="lv">darba kopsavilkums</rdfs:label>
        <rdfs:label xml:lang="da">er opsummeret som værk</rdfs:label>
        <rdfs:label xml:lang="no">er sammendrag som verk</rdfs:label>
        <rdfs:label xml:lang="en">has summary</rdfs:label>
        <rdfs:label xml:lang="nl">heeft samenvatting</rdfs:label>
        <rdfs:label xml:lang="de">ist zusammengefasst als (Werk)</rdfs:label>
        <rdfs:label xml:lang="et">kokkuvõte teosena</rdfs:label>
        <rdfs:label xml:lang="es">tiene resumen</rdfs:label>
        <rdfs:label xml:lang="ca">té sumari</rdfs:label>
        <rdfs:label xml:lang="fi">yhteenveto</rdfs:label>
        <rdfs:label xml:lang="it">è riassunta come opera</rdfs:label>
        <rdfs:label xml:lang="hu">összefoglalja a következő mű:</rdfs:label>
        <rdfs:label xml:lang="tr">özet ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">được tóm lược như là (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="el">είναι περίληψη ως (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو ملخص كعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有提要</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin kısa bir açıklaması olan bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’opera che consiste di una breve ricapitolazione del contenuto di un’opera di partenza.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amely egy másik mű tartalmának rövid összegzéséből áll.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, joka on teoksen lyhyt kuvaus.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm có chứa bản tóm tắt ngắn gọn của nội dung của tác phẩm nguồn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui consiste en une brève description d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que és una descripció breu d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que es una descripción breve de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat bestaat uit een korte herformulering van de content van een ander werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som består av et kort sammendrag av innholdet fra et kildeverk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som består af en kortfattet gengivelse af et oprindeligt værks indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that is a brief description of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu - pamatdarba īss satura izklāsts.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, milles on lühidalt kokku võetud allikteose sisu.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das aus einer kurzen Wiederholung des Inhalts eines anderen Werks besteht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο, το οποίο συνιστά μια σύντομη ανακεφαλαίωση του περιεχομένου ενός έργου-πηγής.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل يتكون من تلخيص موجز لمحتوى عمل آخر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一种作品简要描述的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10147 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10147">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour partie d’œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba daļa</rdfs:label>
        <rdfs:label xml:lang="tr">eser bileşeni ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come parte opera</rdfs:label>
        <rdfs:label xml:lang="no">har del av verk</rdfs:label>
        <rdfs:label xml:lang="da">har delværk</rdfs:label>
        <rdfs:label xml:lang="en">has part work</rdfs:label>
        <rdfs:label xml:lang="de">hat Teilwerk</rdfs:label>
        <rdfs:label xml:lang="nl">heeft deelwerk</rdfs:label>
        <rdfs:label xml:lang="vi">là vỏ chứa của (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="hu">részműve a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen osa</rdfs:label>
        <rdfs:label xml:lang="et">teose osa</rdfs:label>
        <rdfs:label xml:lang="es">tiene obra en parte</rdfs:label>
        <rdfs:label xml:lang="ca">té com a obra de part</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιέκτης του (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">له عمل جزئي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有部分作品</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, başka bir eserin ayrık bir bileşeni olan bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un&apos;opera che è una componente distinta di un’altra opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amely egy másik mű elkülöníthető alkotóeleme.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, joka on itsenäinen osa toista teosta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm là bộ phận cấu thành tách biệt của tác phẩm lớn hơn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui constitue une composante distincte d’une autre œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que és un component discret d’una altra obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que es un componente discreto de otra obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat een afzonderlijk onderdeel van een ander werk is.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som er en avgrenset bestanddel av et annet verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som er en adskilt komponent af et andet værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that is a discrete component of another work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kas ir cita darba atsevišķa sastāvdaļa.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, mis on teise teose iseseisev koostisosa.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das ein einzelner Bestandteil eines anderen Werks ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο το οποίο συνιστά διακριτό συστατικό ενός μεγαλύτερου έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل عبارة عن مكون منفصل من عمل آخر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为另一种作品之独立部分的一种作品关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A part work is considered to be essential to the whole work.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir parça eserin, eserin bütünü için gerekli olduğu kabul edilir.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Delværk er anset for at være vigtigt for hele værket.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een deelwerk wordt beschouwd als essentieel voor het hele werk.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Ein Teilwerk wird als wesentlich für das Gesamtwerk angesehen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Elements tiek uzskatīts par būtisku visam darbam.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen osaa pidetään olennaisena koko teokselle.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose osa peetakse kogu teose suhtes oluliseks.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un&apos;opera parte è considerata essere essenziale per l&apos;opera completa.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Una obra de part es considera essencial per a l’obra completa.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Una obra en parte es considerada esencial para la obra completa.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une partie d’œuvre est considérée comme essentielle à l’œuvre entière.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">alkotórésze:</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">عمل جزئي يعد ضروريًا للعمل بأكمله.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">一种部分作品被认为对于完整作品至关重要。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10153 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10153">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fi">arviointi teoksesta</rdfs:label>
        <rdfs:label xml:lang="da">er evaluering af værk</rdfs:label>
        <rdfs:label xml:lang="no">er evaluering av verk</rdfs:label>
        <rdfs:label xml:lang="es">es evaluación de obra</rdfs:label>
        <rdfs:label xml:lang="tr">eserin değerlendirmesidir</rdfs:label>
        <rdfs:label xml:lang="fr">est une évaluation d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="et">hinnang teosele</rdfs:label>
        <rdfs:label xml:lang="lv">ir novērtējums darbam</rdfs:label>
        <rdfs:label xml:lang="nl">is beschouwing van werk</rdfs:label>
        <rdfs:label xml:lang="en">is evaluation of work</rdfs:label>
        <rdfs:label xml:lang="de">ist Evaluierung von (Werk)</rdfs:label>
        <rdfs:label xml:lang="vi">là đánh giá (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="it">è valutazione di opera</rdfs:label>
        <rdfs:label xml:lang="hu">értékelése a következő műnek:</rdfs:label>
        <rdfs:label xml:lang="ca">és avaluació d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">είναι αξιολόγηση του (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو تقييم لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是作品的评价</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından incelenen veya değerlendirilen bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’opera che è esaminata o giudicata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amelyet elemeznek és megítélnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, jota on tutkittu tai arvioitu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm được kiểm tra hoặc đánh giá.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui est examinée ou jugée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que és examinada o jutjada per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que es examinada o juzgada por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat onderzocht of beoordeeld wordt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som utforskes eller vurderes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som er undersøgt eller vurderet.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that is examined or judged by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kas tiek pārbaudīts vai vērtēts.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, mida on kontrollitud või hinnatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das geprüft oder beurteilt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο το οποίο υποβάλλεται σε εξέταση ή κριτική.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل فُحِص أو حُكِم عليه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品检查或评判的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10158 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10158">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour index (œuvre)</rdfs:label>
        <rdfs:label xml:lang="lv">darbs: rādītājs</rdfs:label>
        <rdfs:label xml:lang="it">ha come indice opera</rdfs:label>
        <rdfs:label xml:lang="fi">hakemisto (teos)</rdfs:label>
        <rdfs:label xml:lang="no">har indeks (verk)</rdfs:label>
        <rdfs:label xml:lang="da">har indeksværk</rdfs:label>
        <rdfs:label xml:lang="en">has index work (Deprecated)</rdfs:label>
        <rdfs:label xml:lang="de">hat Index (Werk)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft indexwerk</rdfs:label>
        <rdfs:label xml:lang="hu">indexműve a következő:</rdfs:label>
        <rdfs:label xml:lang="vi">là chỉ mục (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="et">register (teos)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a obra d’índex</rdfs:label>
        <rdfs:label xml:lang="el">είναι ευρετήριο (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">له عمل كشاف</rdfs:label>
        <skos:definition xml:lang="it">Correla un’opera s un’opera che fornisce una guida sistematica e in ordine alfabetico ai contenuti di un’opera predominante, che solitamente rinvia a numeri di pagina o ad altri codici di riferimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amely egy szisztematikus és betűrendes kalauz egy másik mű tartalmához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, joka on systemaattinen, aakkosellinen opas toisen teoksen sisällöstä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm cung cấp chỉ dẫn theo hệ thống, chữ cái về nội dung của tác phẩm nổi trội, thường dẫn tới số trang hoặc mã tham chiếu khác.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui fournit un guide méthodique et alphabétique du contenu d’une autre œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que proporciona una guia sistemàtica o alfabètica als continguts d’una altra obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat een systematische, alfabetische gids biedt bij de inhoud van een ander werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som gir en systematisk, alfabetisk veiledning til innholdet i et mer fremtredende verk, som regel med henvisninger til sidenumre eller andre referansekoder.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som giver en systematisk, alfabetiseret oversigt over indholdet i et fremtrædende værk, normalt kædet sammen med sidenumre eller andre henvisningskoder.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that provides a systematic, alphabetical guide to the contents of another work. (Deprecated)</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kas ir sistemātisks vai alfabētisks palīglīdzeklis pamatdarba saturam, parasti norādot uz lappušu numuriem vai citiem atsauču kodiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, mis on süstemaatiline ja tähestikuline aineloend dominantse teose sisu kohta. Registris kasutatakse viitamiseks tavaliselt leheküljenumbreid või muid tähiseid.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das eine systematische, alphabetische Orientierungshilfe zum Inhalte eines anderen Werks bietet.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο το οποίο παρέχει έναν συστηματικό, αλφαβητικό οδηγό στα περιεχόμενα του κύριου έργου, που συνήθως πληκτρολογείται στη σελιδαρίθμηση ή σε άλλους κώδικες αναφοράς.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل يوفر دليلًا منهجيًا هجائيًا لمحتويات عمل آخر.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10178 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10178">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fi">arvostelu teoksesta</rdfs:label>
        <rdfs:label xml:lang="da">er anmeldelse af værk</rdfs:label>
        <rdfs:label xml:lang="no">er anmeldelse av verk</rdfs:label>
        <rdfs:label xml:lang="es">es revisión de la obra</rdfs:label>
        <rdfs:label xml:lang="tr">eserin incelemesidir</rdfs:label>
        <rdfs:label xml:lang="fr">est une recension d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">ir recenzija darbam</rdfs:label>
        <rdfs:label xml:lang="nl">is recensie van werk</rdfs:label>
        <rdfs:label xml:lang="en">is review of work</rdfs:label>
        <rdfs:label xml:lang="de">ist Rezension von (Werk)</rdfs:label>
        <rdfs:label xml:lang="vi">là tổng thuật của (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="hu">szemlézi a következő művet:</rdfs:label>
        <rdfs:label xml:lang="it">è recensione di opera</rdfs:label>
        <rdfs:label xml:lang="ca">és revisió d’una obra</rdfs:label>
        <rdfs:label xml:lang="et">ülevaade teosest</rdfs:label>
        <rdfs:label xml:lang="el">είναι κριτική του (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو مراجعة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是作品的评论</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından kısaca değerlendirilen bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un&apos;opera usata come base per una breve valutazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amelyet egy rövid kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen lyhyen arvioinnin perustana käytettyyn teokseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho đánh giá ngắn gọn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui est brièvement évaluée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que és avaluada breument per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que es brevemente evaluada por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat kort beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk brukt som utgangspunkt for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som anvendes som grundlag for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that is briefly evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kas izmantots par pamatu īsam novērtējumam.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, mis on lühihinnangu aluseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine kurze Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل يُستخدم كأساس لتقييم موجز.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品简要评价的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10182 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10182">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="et">arvustatud teos</rdfs:label>
        <rdfs:label xml:lang="hu">bírálata a következő műnek:</rdfs:label>
        <rdfs:label xml:lang="da">er kritik af værk</rdfs:label>
        <rdfs:label xml:lang="no">er kritikk av verk</rdfs:label>
        <rdfs:label xml:lang="es">es critica de la obra</rdfs:label>
        <rdfs:label xml:lang="tr">eserin eleştirisidir</rdfs:label>
        <rdfs:label xml:lang="fr">est une critique d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">ir kritika darbam</rdfs:label>
        <rdfs:label xml:lang="en">is critique of work</rdfs:label>
        <rdfs:label xml:lang="nl">is kritiek van werk</rdfs:label>
        <rdfs:label xml:lang="de">ist Kritik von (Werk)</rdfs:label>
        <rdfs:label xml:lang="fi">kritiikki teoksesta</rdfs:label>
        <rdfs:label xml:lang="vi">phê bình của (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="it">è critica di opera</rdfs:label>
        <rdfs:label xml:lang="ca">és crítica d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">είναι κριτική του (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو نقد لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是作品的批评</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir çalışma tarafından eleştirel olarak değerlendirilen bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un&apos;opera usata come base per una valutazione critica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amelyet egy kritikai kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, johon kriittinen arviointi perustuu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm được sử dụng như là cơ sở cho đánh giá phê bình.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui fait l’objet d’une évaluation critique par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que és avaluada críticament per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que es evaluada críticamente por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat kritisch beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk brukt som utgangspunkt for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som anvendes som grundlag for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that is critically evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kas izmantots par pamatu kritikai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, mis on aluseks kriitilisele hinnangule.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das als Grundlage für eine kritische Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο το οποίο χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل يُستخدم كأساس لتقييم نقدي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被被一种作品批评性评价的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10198 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10198">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour œuvre en relation avec une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">ar darbu saistītais darbs</rdfs:label>
        <rdfs:label xml:lang="vi">có tác phẩm có liên quan (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin ilgili eseri ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come opera correlata di opera</rdfs:label>
        <rdfs:label xml:lang="no">har relatert verk av verk</rdfs:label>
        <rdfs:label xml:lang="da">har værk relateret til værk</rdfs:label>
        <rdfs:label xml:lang="en">has related work of work</rdfs:label>
        <rdfs:label xml:lang="de">hat mit Werk in Beziehung stehendes Werk</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gerelateerd werk van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű kapcsolódó műve a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teokseen liittyvä teos</rdfs:label>
        <rdfs:label xml:lang="et">teosega seotud teos</rdfs:label>
        <rdfs:label xml:lang="es">tiene obra relacionada de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a obra relacionada amb una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχετικό έργο (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">له عمل مرتبط بعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的关联作品</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserle bağlantılı olan bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’opera che è associata a un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amelyet egy műhöz társítanak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, joka liittyy teokseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm liên quan tới tác phẩm đang được mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre qui est associée à une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra que s’associa amb una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra que está asociada a una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk dat is geassocieerd met een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som forbindes med et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som er knyttet til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that is associated with a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, kas saistīts ar darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega seotud teosega.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, das mit einem Werk in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο που συνδέεται με ένα περιγραφόμενο έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل مرتبط بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与和一种作品有关的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10200 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10200">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent architecte paysagiste</rdfs:label>
        <rdfs:label xml:lang="lv">ainavu arhitekts (aģents)</rdfs:label>
        <rdfs:label xml:lang="vi">có kiến trúc sư phong cảnh</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto del paesaggio agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er landskabsarkitekt</rdfs:label>
        <rdfs:label xml:lang="no">har landskapsarkitekt (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has landscape architect agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Landschaftsarchitektin/Landschaftsarchitekten (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landschapsarchitect-actor</rdfs:label>
        <rdfs:label xml:lang="et">maastikuarhitekt (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">maisema-arkkitehti (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">peyzaj mimarı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente arquitecto paisajista</rdfs:label>
        <rdfs:label xml:lang="hu">tájépítész ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent arquitecte paisatgista</rdfs:label>
        <rdfs:label xml:lang="el">έχει αρχιτέκτονα τοπίου</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مهندس تنسيق مواقع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有景观设计师行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, peyzaj çalışmaları oluşturmaktan sorumlu bir mimar olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente architetto responsabile di opere paesaggistiche.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy építész ágenshez, amely felelős tájépítészeti művek létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với kiến trúc sư có trách nhiệm tạo lập tác phẩm phong cảnh.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent architecte qui est responsable de la création d’œuvres paysagères.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un arquitecte que és responsable de la creació d’obres paisatgístiques.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un arquitecto que es responsable de crear obras de paisaje.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een architect is die verantwoordelijk is voor het creëren van landschapswerken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en arkitekt med ansvar for å skape landskapsverk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en arkitekt, som er ansvarlig for at skabe landskabsværker.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an architect who is responsible for creating landscape works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar arhitektu, kurš ir atbildīgs par ainavu darbu veidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes arhitektina vastutab maastikuteoste loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Architektin/einem Architekten (Akteur), die/der für die Erschaffung landschaftlicher Werke verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν αρχιτέκτονα, υπεύθυνο για τη δημιουργία τοπίων.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مهندسا معماريا مسئول عن إنشاء أعمال تنسيق المواقع.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为建筑师并负责创建景观作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10202 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10202">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent sculpteur</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà điêu khắc</rdfs:label>
        <rdfs:label xml:lang="it">ha come scultore agente</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er skulptør</rdfs:label>
        <rdfs:label xml:lang="no">har skulptør (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has sculptor agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Bildhauerin/Bildhauer (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft beeldhouwer-actor</rdfs:label>
        <rdfs:label xml:lang="tr">heykeltıraş temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">kuvanveistäjä (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">skulptor (tegija)</rdfs:label>
        <rdfs:label xml:lang="hu">szobrász ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente escultor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent escultor</rdfs:label>
        <rdfs:label xml:lang="lv">tēlnieks (aģents)</rdfs:label>
        <rdfs:label xml:lang="el">έχει γλύπτη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل نحات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕塑家行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, modelleme, oyma veya benzer bir teknikle üç boyutlu bir eser oluşturmaktan sorumlu bir sanatçı olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente artista responsabile della creazione di un’opera tridimensionale tramite modellatura, intaglio o tecnica simile.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész ágenshez, amely felelős egy háromdimenziós mű megalkotásáért modellezési, faragási vagy hasonló technikával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nghệ sỹ có trách nhiệm tạo lập tác phẩm ba chiều bởi làm mô hình, khắc, hoặc kỹ thuật tương tự.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent artiste qui est responsable de la création d’une œuvre tridimensionnelle par le modelage, la taille ou une technique similaire.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un artista que és responsable de la creació d’una obra tridimensional a partir del modelatge, la talla o una tècnica similar.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un artista que es responsable de crear una obra tridimensional mediante modelado, tallado o una técnica similar.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een kunstenaar is die verantwoordelijk is voor het creëren van driedimensionaal modelleren, snijden of gelijksoortige techniek.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en kunstner med ansvar for å skape et tredimensjonalt verk gjennom modellering, utskjæring eller lignende teknikker.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en kunstner, som er ansvarlig for at skabe et tredimensionelt værk vha. modellering, udskæring eller lignende teknik.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an artist who is responsible for creating a three-dimensional work by modeling, carving, or similar technique.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu - mākslinieks, kurš ir atbildīgs par trīsdimensiju darba radīšanu, to veidojot, grebjot vai izmantojot līdzīgu tehniku.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on modelleerimise, nikerdamise või muu säärase tehnika teel loodud kolmemõõtmelise teose eest vastutav kunstnik.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Akteur), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν καλλιτέχνη υπεύθυνο για τη δημιουργία ενός τρισδιάστατου έργου μέσω του μοντελισμού, της γλυπτικής ή μιας παρόμοιας τεχνικής.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون فنانًا مسئولاً عن إنشاء عمل ثلاثي الأبعاد عن طريق النمذجة، أو النحت، أو تقنية مشابهة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家并通过模型、雕刻或类似技术负责创建一种三维作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10203 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10203">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent scénariste</rdfs:label>
        <rdfs:label xml:lang="vi">có người viết kịch bản</rdfs:label>
        <rdfs:label xml:lang="hu">forgatókönyvíró ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come sceneggiatore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er manuskriptforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har manusforfatter (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has screenwriter agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Drehbuchautorin/Drehbuchautor (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft scenarioschrijver-actor</rdfs:label>
        <rdfs:label xml:lang="fi">käsikirjoittaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="lv">scenārists (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">senarist temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">stsenarist (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente guionista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent guionista</rdfs:label>
        <rdfs:label xml:lang="el">έχει σεναριογράφο</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل كاتب سيناريو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有影视剧编剧行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, senaryo, metin ya da sahne yazarı olan bir temsilciyile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera con un agente autore di una sceneggiatura, copione o scena.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely szerzője egy forgatókönyvnek, szövegkönyvnek vagy jelenetnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on käsikirjoituksen tai kohtauksen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác giả của kịch bản, bản phát thanh, hoặc cảnh.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent auteur d’un scénario, d’un script ou d’une scène.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un autor d’un guió, un argument o una escena.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es autor de un guión, escrito o escena.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een auteur is van een scenario, script of scène.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en forfatter av et skuespill, et manuskript eller en scene.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er forfatter af et manuskript, drejebog eller scene.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an author of a screenplay, script, or scene.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir scenārija, uzveduma plāna vai ainas autors.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on stsenaariumi või stseeni autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur) eines Drehbuchs, eines Skripts oder einer Szene.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν συγγραφέα ενός σεναρίου, των διαλόγων ή των σκηνών.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مؤلف سيناريو، أو نص، أو مشهد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为影视剧剧本、脚本或场景著者的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10204 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10204">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent parolier</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà thơ trữ tình</rdfs:label>
        <rdfs:label xml:lang="hu">dalszövegíró ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">dziesmas teksta autors (aģents)</rdfs:label>
        <rdfs:label xml:lang="it">ha come paroliere agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er tekstforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har sangtekstforfatter (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has lyricist agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Textdichterin/Textdichter (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft liedtekstschrijver-actor</rdfs:label>
        <rdfs:label xml:lang="fi">sanoittaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">sõnade autor (tegija)</rdfs:label>
        <rdfs:label xml:lang="tr">söz yazarı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente letrista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent lletrista</rdfs:label>
        <rdfs:label xml:lang="el">έχει στιχουργό</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مؤلف أغاني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作词者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzikalden bir şarkı da dahil olmak üzere popüler bir şarkının sözlerinin yazarı olan bir temsilciyile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente autore delle parole di una canzone pop, inclusa una canzone di un musical.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác giả của lời của bài hát bình dân, bao gồm cả bài hát hoặc các bài hát từ âm nhạc.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es autor de la letra de una canción popular, incluida una canción de un musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an author of the words of a popular song, including a song from a musical.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dziesmas vārdu autoru, ieskaitot dziesmas no mūzikla.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on levilaulu (k.a laul muusikalist) sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν συγγραφέα των στίχων ενός δημοφιλούς τραγουδιού, περιλαμβανομένων του τραγουδιού ή των τραγουδιών ενός μιούζικαλ.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مؤلف كلمات أغنية شعبية، بما في ذلك أغنية من مسرحية موسيقية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of only the dialogue from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca diyaloglarının yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å bare skrive dialogen fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; esclusa la creazione dei soli dialoghi in un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali dialoogide kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkän musikaalin dialogin kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun dialogen i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de dialogen uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver mūzikla dialogus.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría únicamente del diálogo de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només el diàleg d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Tác giả của chỉ phần hội thoại từ âm nhạc, không được bao gồm.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">dalszövegíró:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Δεν περιλαμβάνεται η συγγραφή μόνο του διαλόγου ενός musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف الحوار فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是对话的著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10205 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10205">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent librettiste</rdfs:label>
        <rdfs:label xml:lang="vi">có người viết lời nhạc kịch</rdfs:label>
        <rdfs:label xml:lang="it">ha come librettista agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er librettist</rdfs:label>
        <rdfs:label xml:lang="no">har librettist (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has librettist agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Librettistin/Librettist (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft librettist-actor</rdfs:label>
        <rdfs:label xml:lang="et">libretist (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">libretisti (toimija)</rdfs:label>
        <rdfs:label xml:lang="lv">libretists (aģents)</rdfs:label>
        <rdfs:label xml:lang="hu">librettista ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">libretto yazarı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente libretista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent llibretista</rdfs:label>
        <rdfs:label xml:lang="el">έχει λιμπρετίστα</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مؤلف أوبرالي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有台本作者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, opera, bale veya müzikal sahne için başka bir eser veya bir oratoryo gibi bir müzikal veya koreografik eserin sözlerinin yazarı olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente autore delle parole di un’opera musicale o coreografica come un’opera,  balletto o altro tipo di opera per il teatro musicale, o un oratorio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző ágenshez, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác giả của lời của opera hoặc tác phẩm sân khấu âm nhạc khác, hoặc oratorio.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent auteur des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur) des Texts für ein Musikwerk oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν συγγραφέα των στίχων μιας όπερας ή κάποιου άλλου μουσικού σκηνικού έργου ή ενός ορατορίου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为歌剧、芭蕾等音乐或编舞作品或其他舞台音乐作品或者清唱剧的歌词的著者的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of the words of only the songs from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; esclusa la creazione delle parole  delle sole canzoni di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali laulusõnade kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun sangteksterne i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atsevišķu dziesmu tekstus mūziklos.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría de la letra únicamente de las canciones de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només les paraules de les cançons d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Tác giả của lời chỉ các bài hát từ âm nhạc, không được bao gồm.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">librettista:</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Δεν περιλαμβάνεται η συγγραφή των στίχων μόνο των τραγουδιών ενός musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是歌曲的词著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10216 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10216">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour couverture du contenu</rdfs:label>
        <rdfs:label xml:lang="vi">có bao quát của nội dung</rdfs:label>
        <rdfs:label xml:lang="it">ha come copertura del contenuto</rdfs:label>
        <rdfs:label xml:lang="da">har dækning af indhold</rdfs:label>
        <rdfs:label xml:lang="sv">har innehållets täckning</rdfs:label>
        <rdfs:label xml:lang="no">har innholdsmessig dekning</rdfs:label>
        <rdfs:label xml:lang="en">has coverage of content</rdfs:label>
        <rdfs:label xml:lang="de">hat inhaltlichen Bezugsrahmen</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bereik van content</rdfs:label>
        <rdfs:label xml:lang="tr">içerik kapsamı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">satura aptvērums laikā (?)</rdfs:label>
        <rdfs:label xml:lang="et">sisu ulatus</rdfs:label>
        <rdfs:label xml:lang="fi">sisällön kattavuus</rdfs:label>
        <rdfs:label xml:lang="hu">tartalmi vonatkozása a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cobertura de contenido</rdfs:label>
        <rdfs:label xml:lang="ca">té com a cobertura de contingut</rdfs:label>
        <rdfs:label xml:lang="el">έχει κάλυψη του περιεχομένου</rdfs:label>
        <rdfs:label xml:lang="ar">له تغطية لمحتوى</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有内容的覆盖面</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin içeriğinin kronolojik veya coğrafi kapsamıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una copertura cronologica o geografica del contenuto di un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy mű tartalmának kronológiai vagy földrajzi vonatkozásához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teoksen sisällön ajalliseen tai maantieteelliseen kattavuuteen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với độ bao quát theo biên niên hoặc địa lý của nội dung của tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une couverture chronologique ou géographique du contenu d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una cobertura cronològica o geogràfica del contingut d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una cobertura cronológica o geográfica del contenido de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een chronologisch of geografisch bereik van de content van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kronologisk eller geografisk dekning for innholdet i et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kronologisk eller geografisk dækning af et værks indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a chronological or geographic coverage of the content of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darba satura hronoloģisku vai ģeogrāfisku aptvērumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose sisu kronoloogilise või geograafilise ulatusega.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem chronologischen oder geografischen Bezugsrahmen des Inhalts eines Werks.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια χρονολογική ή γεωγραφική κάλυψη του περιεχομένου ενός έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتغطية زمنية أو جغرافية لمحتوى عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品之内容的时间覆盖面或地理覆盖面关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10219 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10219">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour date d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có ngày của tác phẩm</rdfs:label>
        <rdfs:label xml:lang="lv">darba datējums</rdfs:label>
        <rdfs:label xml:lang="tr">eser tarihi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come data dell&apos;opera</rdfs:label>
        <rdfs:label xml:lang="da">har dato for værk</rdfs:label>
        <rdfs:label xml:lang="sv">har tid för verket</rdfs:label>
        <rdfs:label xml:lang="no">har tidspunkt for verk</rdfs:label>
        <rdfs:label xml:lang="en">has date of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Datum eines Werks</rdfs:label>
        <rdfs:label xml:lang="nl">heeft datum van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű dátuma a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen ajankohta</rdfs:label>
        <rdfs:label xml:lang="et">teose daatum</rdfs:label>
        <rdfs:label xml:lang="es">tiene fecha de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a data d’obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει χρονολογία του έργου</rdfs:label>
        <rdfs:label xml:lang="ar">له تاريخ عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的日期</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserle bağlantılı olan en erken zaman aralığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un intervallo di tempo che è la prima data associata a un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy legkorábbi időtartamhoz, ami egy művel társítható.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen varhaisimpaan teokseen liittyvään ajanjaksoon.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với ngày sớm nhất liên quan tới tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un laps de temps qui est le plus ancien associé à une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un interval de temps que és el més antic associat amb una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un período de tiempo que es el más antiguo asociado con una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een tijdspanne die de vroegste is, geassocieerd met een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et tidsrom som er det tidligste tidspunktet som kan forbindes med et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en tidsperiode, som er den tidligste dato knyttet til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a timespan that is the earliest associated with a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar laikposmu, kas ir agrākais darba radīšanas datējums.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose ajavahemikuga, milleks on teosega seotud varaseim daatum.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu dem frühesten Zeitraum, der mit einem Werk in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια προηγούμενη χρονολογία συνδεδεμένη με ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وفترة زمنية تمثل أقدم تاريخ مرتبط بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与和一种作品有关的最早的时间段关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10223 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10223">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour titre privilégié d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có nhan đề ưu tiên của tác phẩm</rdfs:label>
        <rdfs:label xml:lang="lv">darba prioritārais nosaukums</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo preferito dell&apos;opera</rdfs:label>
        <rdfs:label xml:lang="da">har foretrukken titel på værk</rdfs:label>
        <rdfs:label xml:lang="no">har foretrukket tittel på verk</rdfs:label>
        <rdfs:label xml:lang="sv">har föredragen titel för verket</rdfs:label>
        <rdfs:label xml:lang="en">has preferred title of work</rdfs:label>
        <rdfs:label xml:lang="de">hat bevorzugten Titel eines Werks</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geprefereerde titel van werk</rdfs:label>
        <rdfs:label xml:lang="hu">műhöz tartozó előnyben részesített címe a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen ensisijainen nimeke</rdfs:label>
        <rdfs:label xml:lang="et">teose eelispealkiri</rdfs:label>
        <rdfs:label xml:lang="tr">tercih edilen eser başlığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene título preferido la obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol preferit d’obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει προτιμώμενο τίτλο για έργο</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان مفضل لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的首选题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, belirli bir uygulama veya bağlamda tercih için seçilen bir eser başlığı olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un titolo dell’opera scelto come preferito in un ambito di utilizzo o contesto specifici.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, amely egy olyan műcím, amelyet egy adott alkalmazásban vagy kontextusban előnyben részesítenek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, joka on teoksen nimeke, joka on valittu ensisijaiseksi tietyssä sovelluksessa tai kontekstissa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nhan đề hoặc hình thái của nhan đề được chọn để nhận dạng tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est un titre d’œuvre faisant l’objet d’un choix privilégié dans une application ou un contexte spécifiques.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és un títol d’obra que se selecciona com a preferent en una aplicació o un context específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es un título de obra que se selecciona de preferencia en una aplicación o contexto específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat is een titel van werk die bij voorkeur geselecteerd is in een specifieke applicatie of context.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en tittel på verk som er valgt som preferanse i en spesifikk applikasjon eller sammenheng.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en titel på værk, som er valgt som præference i en specifik anvendelse eller kontekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is a title of work that is selected for preference in a specific application or context.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir darba nosaukums, kas ir izvēlēts noteiktam lietojumam vai noteiktā kontekstā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose pealkirjaga, mis kindlas rakenduses või kontekstis on valitud eelistatuks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Titel eines Werks, der in einer bestimmten Anwendung oder in einem bestimmten Kontext als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν τίτλο ή μορφή του τίτλου που επιλέγεται για την ταύτιση ενός έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية عبارة عن عنوان عمل تم اختياره بتفضيل استخدامه في تطبيق أو سياق محدد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为作品的一个题名并在一个特定的应用或语境下被首选的一个命名关联起来。</skos:definition>
        <skos:scopeNote xml:lang="hu">A kitűntetett vagy preferált cím alapja a művet képviselő meghatalmazott hozzáférési pontnak is.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Den foretrukne titel er også grundlag for en autoriseret søgeindgang der repræsenterer værket.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Der bevorzugte Titel ist auch die Grundlage für den normierten Sucheinstieg, der dieses Werk repräsentiert.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">El títol preferit és també la base d’un punt d’accés autoritzat que representa l’obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le titre privilégié constitue aussi l’élément de base d’un point d’accès autorisé représentant cette œuvre.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Nhan đề ưu tiên cũng là cơ sở cho điểm truy cập được phép trình bày tác phẩm đó.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Ο προτιμώμενος τίτλος είναι επίσης η βάση για το καθιερωμένο σημείο πρόσβασης που αναπαριστά αυτό το έργο.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10253 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10253">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent calligraphe</rdfs:label>
        <rdfs:label xml:lang="vi">có người viết chữ đẹp</rdfs:label>
        <rdfs:label xml:lang="it">ha come calligrafo agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er kalligraf</rdfs:label>
        <rdfs:label xml:lang="no">har kalligraf (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has calligrapher agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Kalligrafin/Kalligraf (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kalligraaf-actor</rdfs:label>
        <rdfs:label xml:lang="tr">kaligraf temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kaligrāfs (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">kalligraaf (tegija)</rdfs:label>
        <rdfs:label xml:lang="fi">kalligrafi (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">kalligráfus ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente calígrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent cal·lígraf</rdfs:label>
        <rdfs:label xml:lang="el">έχει καλλιγράφο</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل خطاط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有书法者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, aynı temsilcinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının el yazısının estetik değerinde veya grafik sanatında olduğu kaligrafiden sorumlu sanatçı olan temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente artista responsabile per la calligrafia quando il centro d’interesse risiede nel valore estetico della scrittura o della grafica, indipendentemente dal fatto che lo stesso agente sia anche responsabile per il testo scritto.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész ágenshez, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz az ágens a lejegyzett szöveg szerzője is egyben vagy sem.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nghệ sỹ có trách nhiệm tạo ra tác phẩm nghệ thuật viết chữ đẹp nơi mà tập trung của sự chú ý nằm ở giá trị thẩm mỹ của phong cách viết hoặc nghệ thuật đồ hình, không phân biệt có cùng cá nhân, v.v... hay không, cũng là tác giả của văn bản được viết.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que le même agent soit aussi responsable du texte calligraphié.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si el mateix agent és també responsable del text inscrit.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de que el mismo agente sea también responsable del texto inscrito.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde actor ook verantwoordelijk is voor de geschreven tekst.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme agent også har forfattet den indskrevne tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same agent is also responsible for the inscribed text.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tas pats aģents ir atbildīgs arī par ierakstīto tekstu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama tegija on vastutav ka kirjutatud teksti eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Akteur), die/der für die Kalligrafie verantwortlich ist, bei der im Mittelpunkt des Interesses der ästhetische Wert dessen Schreibkunst oder die grafische Kunstfertigkeit liegt, unabhängig davon, ob derselbe Akteur auch für den aufgeschriebenen Text verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν καλλιτέχνη υπεύθυνο για τη δημιουργία ενός καλλιγραφικού έργου, όπου το ενδιαφέρον εστιάζει στην αισθητική αξία της καλλιγραφίας ή της γραφικής δεξιοτεχνίας, ανεξάρτητα από το αν πρόκειται για το ίδιο φυσικό πρόσωπο κ.λπ., επίση υπεύθυνο για το χαραγμένο κείμενο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل هو فنانً مسئول عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عما إذا كان الوكيل نفسه مسئولاً أيضًا عن النص المكتوب.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10254 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10254">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent artiste du livre</rdfs:label>
        <rdfs:label xml:lang="vi">có nghệ sỹ sách</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatu mākslinieks (aģents)</rdfs:label>
        <rdfs:label xml:lang="it">ha come book artist agente</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er bogkunstner</rdfs:label>
        <rdfs:label xml:lang="no">har bokkunstner (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has book artist agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchkünstlerin/Buchkünstler (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekkunstenaar-actor</rdfs:label>
        <rdfs:label xml:lang="fi">kirjataiteilija (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">kitap sanatçısı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvművész ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukunstnik (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente de artista de libros</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent artista de llibre d’art</rdfs:label>
        <rdfs:label xml:lang="el">έχει βιβλίο καλλιτέχνη</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل فنان كتب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书美术家行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kitap formunu değerlendirmek veya fiziksel yapısını değiştirmekten sorumlu olan bir sanatçı olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente artista che sfrutta la forma del libro o altera la sua struttura fisica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész ágenshez, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nghệ sỹ có trách nhiệm tạo ra tác phẩm nghệ thuật khai thác hình thái sách hoặc thay đổi cấu trúc vật lý như là phần của nội dung.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un artista que es responsable de explotar la forma del libro o alterar su estructura física.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an artist who is responsible for exploiting the book form or altering its physical structure.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas atbild par grāmatas kā mākslas darba radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Akteur), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν καλλιτέχνη που είναι υπεύθυνος για τη δημιουργία έργων τέχνης που αξιοποιούν τη μορφή του βιβλίου ή μεταβάλλουν τη φυσική του δομή ως μέρος του περιεχομένου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون فنانًا مسئولاً عن استغلال شكل الكتاب أو تغيير هيكله المادي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10255 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10255">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent rapporteur</rdfs:label>
        <rdfs:label xml:lang="et">aruande koostaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="vi">có người chuẩn bị báo cáo</rdfs:label>
        <rdfs:label xml:lang="it">ha come relatore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er rapportør</rdfs:label>
        <rdfs:label xml:lang="no">har rapportør (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has rapporteur agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Berichterstatterin/Berichterstatter (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft rapporteur-actor</rdfs:label>
        <rdfs:label xml:lang="fi">kokousten raportoija (toimija)</rdfs:label>
        <rdfs:label xml:lang="tr">raportör temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">raportőr ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente relator</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent relator</rdfs:label>
        <rdfs:label xml:lang="lv">ziņotājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="el">έχει εισηγητή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مقرر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有会务报告人行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kuruluş tarafından toplantılarının işleyişleri hakkında rapor vermek üzere atanan bir yazar olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente che è un autore incaricato da un’organizzazione di compilare rapporti sugli atti dei suoi incontri.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy forrást egy szerző ágenshez, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést üléseinek a jegyzőkönyveiről.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác giả được chỉ định bởi tổ chức để báo cáo về kỷ yếu của cuộc họp.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent auteur qui est nommé par une organisation pour rédiger les comptes rendus de ses réunions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es un autor que es designado por una organización para informar sobre el desarrollo de sus reuniones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is an author who is appointed by an organization to report on the proceedings of its meetings.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Akteur), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν συγγραφέα, στον οποίο έχει ανατεθεί από έναν οργανισμό να αναφέρει σχετικά με τα πρακτικά των συναντήσεων του.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个著者并被一个组织指定为在其会议文集中报告的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="no">Ansvar som er begrenset til å ta møtereferater, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; esclusa la responsabilità limitata alla stesura delle minute</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma vastutust, mis on piiratud ainult protokollimisega.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atbildību protokolēt.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele a jegyzőkönyvvezetésre korlátozódó szerzőség.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter ikke ansvar begrænset til at tage referat.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Responsibility limited to taking minutes is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la responsabilidad limitada a levantar actas.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la responsabilitat que es limita a prendre notes.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Trách nhiệm giới hạn vào ghi biển bản không được bao gồm</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Tutanak tutmakla sınırlı sorumluluk hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une responsabilité limitée à rédiger un procès-verbal est exclue.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Verantwoordelijkheid beperkt tot het notuleren is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Δεν περιλαμβάνεται η υπευθυνότητα που περιορίζεται στην τήρηση πρακτικών.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括仅限于写会议记录的责任。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10256 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10256">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aihe</rdfs:label>
        <rdfs:label xml:lang="vi">có mối quan hệ chủ đề</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto</rdfs:label>
        <rdfs:label xml:lang="no">har emne</rdfs:label>
        <rdfs:label xml:lang="da">har subjekt</rdfs:label>
        <rdfs:label xml:lang="sv">har ämnesrelation</rdfs:label>
        <rdfs:label xml:lang="en">has subject</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema</rdfs:label>
        <rdfs:label xml:lang="lv">temats</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχέση θέματος</rdfs:label>
        <rdfs:label xml:lang="ar">له موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan bir konuyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un argomento di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy témához, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen aiheeseen, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với thuật ngữ, cụm từ, chỉ số phân loại, v.v..., chỉ ra tác phẩm nói về cái gì.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un sujet dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un tema sobre el qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un tema del que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een onderwerp waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et emne som verket handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et emne, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a topic that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar tematu, par ko ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teemaga, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Thema, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν όρο, μια φράση, έναν ταξινομικό αριθμό κ.λπ. που δηλώνει σε τι αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وموضوع يدور حوله عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个论题关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10257 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10257">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour œuvre sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva teos</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto opera </rdfs:label>
        <rdfs:label xml:lang="no">har emne (verk)</rdfs:label>
        <rdfs:label xml:lang="da">har værk, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject work</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Werk)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft werk als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan eser ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (teos)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (darbs)</rdfs:label>
        <rdfs:label xml:lang="es">tiene obra de tema</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő mű:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a obra de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">له عمل موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题作品</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eseri hakkındaki bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’opera di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teokseen, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác phẩm mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une œuvre dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una obra sobre la qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una obra de la que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een werk waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et verk som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et værk, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a work that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar darbu, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Werk, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα έργο στο οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط عمل بعمل يدور حوله عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一种作品关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10258 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10258">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour expression sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva ekspressio</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (biểu hiện)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto espressione </rdfs:label>
        <rdfs:label xml:lang="no">har emne (uttrykk)</rdfs:label>
        <rdfs:label xml:lang="da">har udtryk, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Expression)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft expressie als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan anlatım ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (väljendus)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (izteiksme)</rdfs:label>
        <rdfs:label xml:lang="es">tiene expresión de tema</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő kifejezési forma:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a expressió de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (έκφραση)</rdfs:label>
        <rdfs:label xml:lang="ar">له تعبيرة موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题内容表达</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olduğu bir anlatımla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’espressione di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kifejezési formához, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ekspressioon, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu hiện mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une expression dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una expressió sobre la qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una expresión de la que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een expressie waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et uttrykk som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et udtryk som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an expression that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar izteiksmi, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose väljendusega, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Expression, von der ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια έκφραση στην οποία αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتعبيرة يدور حولها عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一种内容表达关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10259 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10259">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour manifestation sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva manifestaatio</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (biểu thị)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto manifestazione </rdfs:label>
        <rdfs:label xml:lang="no">har emne (manifestasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har manifestation, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject manifestation</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Manifestation)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft manifestatie als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan gösterim ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (kehastus)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (manifestācija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene manifestación de tema</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő megjelenési forma:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a manifestació de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">له تجسيدة موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题载体表现</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, o çalışmanın hakkında olan gösterimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una manifestazione di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy megjelenési formához, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen manifestaatioon, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une manifestation dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una manifestació sobre la qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una manifestación de la que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een manifestatie waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en manifestasjon som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en manifestation, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a manifestation that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar manifestāciju, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kehastusega, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Manifestation, von der ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια εκδήλωση στην οποία αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتجسيدة يدور حولها عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一种载体表现关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10260 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10260">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour item sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva kappale</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (bản)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto item </rdfs:label>
        <rdfs:label xml:lang="da">har eksemplar, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="no">har emne (eksemplar)</rdfs:label>
        <rdfs:label xml:lang="en">has subject item</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Exemplar)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft item als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan kopya ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (eksemplar)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (vienība)</rdfs:label>
        <rdfs:label xml:lang="es">tiene item de tema</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő példány:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a ítem de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (αντίτυπο)</rdfs:label>
        <rdfs:label xml:lang="ar">له مفردة موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题单件</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserin hakkında olduğu bir kopyayla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un item di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy példányhoz, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen kappaleeseen, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với bản mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un item dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un ítem sobre el qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un item del que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een item waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et eksemplar som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et eksemplar, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an item that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vienību, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose eksemplariga, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Exemplar, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα αντίτυπο στο οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومفردة يدور حولها عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个单件关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10261 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10261">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva henkilö</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (cá nhân)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto persona </rdfs:label>
        <rdfs:label xml:lang="no">har emne (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject person</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft persoon als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de persona</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő személy:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (φυσικό πρόσωπο)</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una persona di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, akiről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với cá nhân mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona sobre la qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona de la que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person whom a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kelle kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, von der ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα φυσικό πρόσωπο στο οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يدور حوله عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10262 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10262">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva suku</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (gia đình)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto famiglia </rdfs:label>
        <rdfs:label xml:lang="no">har emne (familie)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject family</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft familie als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan aile ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de familia</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő család:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (οικογένεια)</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una famiglia di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với gia đình mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família sobre la qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia de la que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family whom a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kelle kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, von der ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια οικογένεια στην οποία αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة يدور حولها عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10263 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10263">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva yhteisö</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (tập thể)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto ente </rdfs:label>
        <rdfs:label xml:lang="no">har emne (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft corporatie als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de cuerpo corporativo</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő testület:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (συλλογικό όργανο)</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un ente di cui un’opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa sobre la qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo del que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body whom a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, von der ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα συλλογικό όργανο στο οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة يدور حولها عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10265 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10265">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af eksemplar</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av eksemplar</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de item</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’un item</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts vienībai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van item</rdfs:label>
        <rdfs:label xml:lang="en">is description of item</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Exemplar)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud eksemplar</rdfs:label>
        <rdfs:label xml:lang="tr">kopyanın tanımıdır</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus kappaleesta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő példánynak:</rdfs:label>
        <rdfs:label xml:lang="vi">là mô tả của (bản)</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di item</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’un ítem</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιγραφή του (αντίτυπο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لمفردة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是单件的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser tarafından tanımlanan bir kopyayla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un item che è descritto da un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy példányhoz, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen kappaleeseen, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với bản được mô tả bởi tác phẩm mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un item qui est décrit par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un ítem que és descrit per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un item que es descrito por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een item dat beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et eksemplar som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et eksemplar, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an item that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vienību, kas ir aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose eksemplariga, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Exemplar, das von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα αντίτυπο που περιγράφεται σε ένα περιγραφικό έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومفردة موصوفة في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个单件关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10267 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10267">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fi">arviointi kappaleesta</rdfs:label>
        <rdfs:label xml:lang="da">er evaluering af eksemplar</rdfs:label>
        <rdfs:label xml:lang="no">er evaluering av eksemplar</rdfs:label>
        <rdfs:label xml:lang="fr">est une évaluation d’un item</rdfs:label>
        <rdfs:label xml:lang="et">hinnang eksemplarile</rdfs:label>
        <rdfs:label xml:lang="lv">ir novērtējums vienībai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschouwing van item</rdfs:label>
        <rdfs:label xml:lang="en">is evaluation of item (Deprecated)</rdfs:label>
        <rdfs:label xml:lang="de">ist Evaluierung von (Exemplar)</rdfs:label>
        <rdfs:label xml:lang="hu">kiértékelése a következő példánynak:</rdfs:label>
        <rdfs:label xml:lang="vi">là đánh giá của (bản)</rdfs:label>
        <rdfs:label xml:lang="it">è valutazione di item</rdfs:label>
        <rdfs:label xml:lang="ca">és avaluació d’un ítem</rdfs:label>
        <rdfs:label xml:lang="el">είναι αξιολόγηση του (αντίτυπο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو تقييم لمفردة</rdfs:label>
        <skos:definition xml:lang="it">Correla un’opera a un item che è esaminato o valutato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy példányhoz, amelyet elemeznek és megítélnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen kappaleeseen, jota on tutkittu tai arvioitu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với bản được kiểm tra hoặc đánh giá.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un item qui est examiné ou jugé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un ítem que s’examina o es jutja.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een item dat onderzocht of beoordeeld wordt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et eksemplar som utforskes eller vurderes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et eksemplar, som er undersøgt eller bedømt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an item that is examined or judged. (Deprecated)</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vienību, kas ir pārbaudīta vai vērtēta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose eksemplariga, mida on kontrollitud või hinnatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Exemplar, das untersucht oder beurteilt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα αντίτυπο που εξετάζεται ή κρίνεται.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومفردة يتم فحصها أو الحكم عليها.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10268 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10268">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fi">arvostelu kappaleesta</rdfs:label>
        <rdfs:label xml:lang="da">er anmeldelse af eksemplar</rdfs:label>
        <rdfs:label xml:lang="no">er anmeldelse av eksemplar</rdfs:label>
        <rdfs:label xml:lang="fr">est une recension d’un item</rdfs:label>
        <rdfs:label xml:lang="lv">ir recenzija vienībai</rdfs:label>
        <rdfs:label xml:lang="nl">is recensie van item</rdfs:label>
        <rdfs:label xml:lang="en">is review of item (Deprecated)</rdfs:label>
        <rdfs:label xml:lang="de">ist Rezension von (Exemplar)</rdfs:label>
        <rdfs:label xml:lang="hu">szemlézi a következő példányt:</rdfs:label>
        <rdfs:label xml:lang="vi">tổng quan của bản</rdfs:label>
        <rdfs:label xml:lang="it">è recensione di item</rdfs:label>
        <rdfs:label xml:lang="ca">és revisió d’un ítem</rdfs:label>
        <rdfs:label xml:lang="et">ülevaade eksemplarist</rdfs:label>
        <rdfs:label xml:lang="el">είναι εξέταση του (αντίτυπο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو مراجعة لمفردة</rdfs:label>
        <skos:definition xml:lang="it">Correla un&apos;opera a un item usato come base per una breve valutazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy példányhoz, amelyet egy rövid kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen lyhyen arvioinnin perustana käytettyyn kappaleeseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với bản được dùng như là cơ sở cho đánh giá ngắn gọn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un item qui sert de base à une brève évaluation.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un ítem usat com a base d’una avaluació breu.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een item gebruikt als een basis voor een korte beschouwing.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et eksemplar brukt som utgangspunkt for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et eksemplar, som anvendes som grundlag for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an item used as a basis for a brief evaluation. (Deprecated)</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vienību, kas izmantota par pamatu īsam novērtējumam.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose eksemplariga, mis on lühihinnangu aluseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Exemplar, das als Grundlage für eine kurze Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα αντίτυπο που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومفردة تستخدم كأساس لتقييم موجز.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10269 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10269">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="et">arvustatud eksemplar</rdfs:label>
        <rdfs:label xml:lang="hu">bírálata a következő példánynak:</rdfs:label>
        <rdfs:label xml:lang="da">er kritik af eksemplar</rdfs:label>
        <rdfs:label xml:lang="no">er kritikk av eksemplar</rdfs:label>
        <rdfs:label xml:lang="fr">est une critique d’un item</rdfs:label>
        <rdfs:label xml:lang="lv">ir kritika vienībai</rdfs:label>
        <rdfs:label xml:lang="en">is critique of item (Deprecated)</rdfs:label>
        <rdfs:label xml:lang="nl">is kritiek van item</rdfs:label>
        <rdfs:label xml:lang="de">ist Kritik von (Exemplar)</rdfs:label>
        <rdfs:label xml:lang="fi">kritiikki kappaleesta</rdfs:label>
        <rdfs:label xml:lang="vi">là phê bình của (bản)</rdfs:label>
        <rdfs:label xml:lang="it">è critica di item</rdfs:label>
        <rdfs:label xml:lang="ca">és crítica d’un ítem</rdfs:label>
        <rdfs:label xml:lang="el">είναι κριτική στο (αντίτυπο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو نقد لمفردة</rdfs:label>
        <skos:definition xml:lang="it">Correla un&apos;opera a un item usato come base per una valutazione critica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy példányhoz, amelyet egy kritikai kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen kappaleeseen, johon kriittinen arviointi perustuu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với bản được dùng như là cơ sở cho đánh giá phê bình.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un item qui sert de base à une évaluation critique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un ítem usat com a base d’una avaluació crítica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een item gebruikt als een basis voor een kritische beschouwing.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et eksemplar brukt som utgangspunkt for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et eksemplar, som anvendes som grundlag for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an item used as a basis for a critical evaluation. (Deprecated)</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vienību, kas izmantota par pamatu kritikai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose eksemplariga, mis on aluseks kriitilisele hinnangule.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Exemplar, das als Grundlage für eine kritische Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα αντίτυπο που χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومفردة تستخدم كأساس لتقييم نقدي.</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10271 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10271">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af manifestation</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av manifestasjon</rdfs:label>
        <rdfs:label xml:lang="es">es la descripción de la manifestación</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts manifestācijai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van manifestatie</rdfs:label>
        <rdfs:label xml:lang="en">is description of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Manifestation)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud kehastus</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus manifestaatiosta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő megjelenési formának:</rdfs:label>
        <rdfs:label xml:lang="vi">là mô tả của (biểu thị)</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di manifestazione</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιγραφή της (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是载体表现的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından tanımlanan bir gösterimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una manifestazione che è descritta da un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy megjelenési formához, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen manifestaatioon, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị được mô tả bởi tác phẩm mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une manifestation qui est décrite par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una manifestació que és descrita per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una manifestación que es descrita por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een manifestatie die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en manifestasjon som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en manifestation, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a manifestation that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar manifestāciju, kas ir aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kehastusega, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Manifestation, die von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια εκδήλωση που περιγράφεται σε ένα περιγραφικό έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتجسيدة موصوفة في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一种载体表现关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10273 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10273">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fi">arviointi manifestaatiosta</rdfs:label>
        <rdfs:label xml:lang="da">er evaluering af manifestation</rdfs:label>
        <rdfs:label xml:lang="no">er evaluering av manifestasjon</rdfs:label>
        <rdfs:label xml:lang="es">es la evaluación de la manifestación</rdfs:label>
        <rdfs:label xml:lang="fr">est une évaluation d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin değerlendirmesidir</rdfs:label>
        <rdfs:label xml:lang="et">hinnang kehastusele</rdfs:label>
        <rdfs:label xml:lang="lv">ir novērtējums manifestācijai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschouwing van manifestatie</rdfs:label>
        <rdfs:label xml:lang="en">is evaluation of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">ist Evaluierung von (Manifestation)</rdfs:label>
        <rdfs:label xml:lang="vi">là đánh giá của (biểu thị)</rdfs:label>
        <rdfs:label xml:lang="it">è valutazione di manifestazione</rdfs:label>
        <rdfs:label xml:lang="hu">értékelése a következő megjelenési formának:</rdfs:label>
        <rdfs:label xml:lang="ca">és avaluació d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">είναι αξιολόγηση της (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">هو تقييم لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是载体表现的评价</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından incelenen veya değerlendirilen bir gösterimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una manifestazione che è esaminata o valutata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy megjelenési formához, amelyet elemeznek és megítélnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen manifestaatioon, jota on tutkittu tai arvioitu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị được kiểm tra hoặc đánh giá.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une manifestation qui est examinée ou jugée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una manifestació que és examinada o jutjada per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una manifestación que es examinada o juzgada por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een manifestatie die onderzocht of beoordeeld wordt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en manifestasjon som utforskes eller vurderes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en manifestation, som er undersøgt eller bedømt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a manifestation that is examined or judged by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar manifestāciju, kas ir pārbaudīta vai vērtēta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kehastusega, mida on kontrollitud või hinnatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Manifestation, die untersucht oder beurteilt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια εκδήλωση που εξετάζεται ή κρίνεται.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتجسيدة يتم فحصها أو الحكم عليها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品检查或评判的一种载体表现关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10274 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10274">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fi">arvostelu manifestaatiosta</rdfs:label>
        <rdfs:label xml:lang="da">er anmeldelse af manifestation</rdfs:label>
        <rdfs:label xml:lang="no">er anmeldelse av manifestasjon</rdfs:label>
        <rdfs:label xml:lang="es">es revisión de manifestación</rdfs:label>
        <rdfs:label xml:lang="fr">est une recension d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin incelemesidir</rdfs:label>
        <rdfs:label xml:lang="lv">ir recenzija manifestācijai</rdfs:label>
        <rdfs:label xml:lang="nl">is recensie van manifestatie</rdfs:label>
        <rdfs:label xml:lang="en">is review of manifestation</rdfs:label>
        <rdfs:label xml:lang="de">ist Rezension von (Manifestation)</rdfs:label>
        <rdfs:label xml:lang="vi">là tổng quan của (biểu thị)</rdfs:label>
        <rdfs:label xml:lang="hu">szemlézi a következő megjelenési formát</rdfs:label>
        <rdfs:label xml:lang="it">è recensione di manifestazione</rdfs:label>
        <rdfs:label xml:lang="ca">és revisió d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="et">ülevaade kehastusest</rdfs:label>
        <rdfs:label xml:lang="el">είναι εξέταση της (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">هو مراجعة لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是载体表现的评论</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından kısaca değerlendirilen bir gösterimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una manifestazione usata come base per una breve valutazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy megjelenési formához, amelyet egy rövid kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen lyhyen arvioinnin perustana käytettyyn manifestaatioon.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị được dùng như là cơ sở cho đánh giá ngắn gọn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une manifestation qui est brièvement évaluée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una manifestació que és avaluada breument per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una manifestación que es brevemente evaluada por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een manifestatie die kort beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en manifestasjon brukt som utgangspunkt for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en manifestation, som anvendes som grundlag for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a manifestation that is briefly evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar manifestāciju, kas izmantota par pamatu īsam novērtējumam.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kehastusega, mis on lühihinnangu aluseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Manifestation, die als Grundlage für eine kurze Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια εκδήλωση που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتجسيدة تستخدم كأساس لتقييم موجز.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品简要评价的一种载体表现关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10275 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10275">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="et">arvustatud kehastus</rdfs:label>
        <rdfs:label xml:lang="hu">bírálata a következő megjelenési formának:</rdfs:label>
        <rdfs:label xml:lang="da">er kritik af manifestation</rdfs:label>
        <rdfs:label xml:lang="no">er kritikk av manifestasjon</rdfs:label>
        <rdfs:label xml:lang="es">es crítica de la manifestación</rdfs:label>
        <rdfs:label xml:lang="fr">est une critique d’une manifestation</rdfs:label>
        <rdfs:label xml:lang="tr">gösterimin eleştirisidir</rdfs:label>
        <rdfs:label xml:lang="lv">ir kritika manifestācijai</rdfs:label>
        <rdfs:label xml:lang="en">is critique of manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">is kritiek van manifestatie</rdfs:label>
        <rdfs:label xml:lang="de">ist Kritik von (Manifestation)</rdfs:label>
        <rdfs:label xml:lang="fi">kritiikki manifestaatiosta</rdfs:label>
        <rdfs:label xml:lang="vi">là phê bình của (biểu thị)</rdfs:label>
        <rdfs:label xml:lang="it">è critica di manifestazione</rdfs:label>
        <rdfs:label xml:lang="ca">és crítica d’una manifestació</rdfs:label>
        <rdfs:label xml:lang="el">είναι κριτική της (εκδήλωση)</rdfs:label>
        <rdfs:label xml:lang="ar">هو نقد لتجسيدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是载体表现的批评</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından eleştirel olarak değerlendirilen bir gösterimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una manifestazione usata come base per una valutazione critica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy megjelenési formához, amelyet egy kritikai kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen manifestaatioon, johon kriittinen arviointi perustuu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị được dùng như là cơ sở cho đánh giá phê bình.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une manifestation qui fait l’objet d’une évaluation critique par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una manifestació que és avaluada críticament per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una manifestación que es evaluada críticamente por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een manifestatie die kritisch beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en manifestasjon brukt som utgangspunkt for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en manifestation, som anvendes som grundlag for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a manifestation that is critically evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar manifestāciju, kas izmantota par pamatu kritikai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kehastusega, mis on aluseks kriitilisele hinnangule.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Manifestation, die als Grundlage für eine kritische Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια εκδήλωση που χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتجسيدة تستخدم كأساس لتقييم نقدي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品批评性评价的一种载体表现关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10277 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10277">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">anlatımın tanımıdır</rdfs:label>
        <rdfs:label xml:lang="da">er beskrivelse af udtryk</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av uttrykk</rdfs:label>
        <rdfs:label xml:lang="es">es la descripción de la expresión</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’une expression</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts izteiksmei</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van expressie</rdfs:label>
        <rdfs:label xml:lang="en">is description of expression</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Expression)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud väljendus</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus ekspressiosta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő kifejezési formának:</rdfs:label>
        <rdfs:label xml:lang="vi">là mô tả của (biểu hiện)</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di espressione</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’una expressió</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιγραφή της (έκφραση)</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لتعبيرة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是内容表达的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından tanımlanan bir anlatımla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una espressione che è descritta da un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kifejezési formához, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ekspressioon, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu hiện được mô tả bởi tác phẩm mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une expression qui est décrite par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una expressió que és descrita per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una expresión que es descrita por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een expressie die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et uttrykk som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et udtryk, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an expression that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar izteiksmi, kura aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose väljendusega, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Expression, die von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια έκφραση που περιγράφεται από ένα περιγραφικό έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتعبيرة موصوفة في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一种内容表达关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10279 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10279">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">anlatımın değerlendirmesidir</rdfs:label>
        <rdfs:label xml:lang="fi">arviointi ekspressiosta</rdfs:label>
        <rdfs:label xml:lang="da">er evaluering af udtryk</rdfs:label>
        <rdfs:label xml:lang="no">er evaluering av uttrykk</rdfs:label>
        <rdfs:label xml:lang="es">es la evaluación de la expresión</rdfs:label>
        <rdfs:label xml:lang="fr">est une évaluation d’une expression</rdfs:label>
        <rdfs:label xml:lang="et">hinnang väljendusele</rdfs:label>
        <rdfs:label xml:lang="lv">ir novērtējums izteiksmei</rdfs:label>
        <rdfs:label xml:lang="nl">is beschouwing van expressie</rdfs:label>
        <rdfs:label xml:lang="en">is evaluation of expression</rdfs:label>
        <rdfs:label xml:lang="de">ist Evaluierung von (Expression)</rdfs:label>
        <rdfs:label xml:lang="vi">là đánh giá của (biểu hiện)</rdfs:label>
        <rdfs:label xml:lang="it">è valutazione di espressione</rdfs:label>
        <rdfs:label xml:lang="hu">értékelése a következő kifejezési formának:</rdfs:label>
        <rdfs:label xml:lang="ca">és avaluació d’una expressió</rdfs:label>
        <rdfs:label xml:lang="el">είναι αξιολόγηση της (έκφραση)</rdfs:label>
        <rdfs:label xml:lang="ar">هو تقييم لتعبيرة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是内容表达的评价</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından incelenen veya değerlendirilen bir anlatımla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un&apos;espressione che è esaminata o valutata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kifejezési formához, amelyet elemeznek és megítélnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ekspressioon, jota on tutkittu tai arvioitu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu hiện được kiểm tra hoặc đánh giá.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une expression qui est examinée ou jugée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una expressió que és examinada o jutjada per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una expresión que es examinada o juzgada por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een expressie die onderzocht of beoordeeld wordt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et uttrykk som utforskes eller vurderes.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et udtryk, som er undersøgt eller bedømt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an expression that is examined or judged by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar izteiksmi, kas tiek pārbaudīta vai vērtēta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose väljendusega, mida on kontrollitud või hinnatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Expression, die untersucht oder beurteilt wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια έκφραση που εξετάζεται ή κρίνεται.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتعبيرة يتم فحصها أو الحكم عليها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品检查或评判的一种内容表达关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10280 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10280">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">Anlatımın incelemesidir</rdfs:label>
        <rdfs:label xml:lang="fi">arvostelu ekspressiosta</rdfs:label>
        <rdfs:label xml:lang="da">er anmeldelse af udtryk</rdfs:label>
        <rdfs:label xml:lang="no">er anmeldelse av uttrykk</rdfs:label>
        <rdfs:label xml:lang="es">es repaso de expresión</rdfs:label>
        <rdfs:label xml:lang="fr">est une recension d’une expression</rdfs:label>
        <rdfs:label xml:lang="lv">ir recenzija izteiksmei</rdfs:label>
        <rdfs:label xml:lang="nl">is recensie van expressie</rdfs:label>
        <rdfs:label xml:lang="en">is review of expression</rdfs:label>
        <rdfs:label xml:lang="de">ist Rezension von (Expression)</rdfs:label>
        <rdfs:label xml:lang="vi">là tổng quan của (biểu hiện)</rdfs:label>
        <rdfs:label xml:lang="hu">szemlézi a következő kifejezési formát:</rdfs:label>
        <rdfs:label xml:lang="it">è recensione di espressione</rdfs:label>
        <rdfs:label xml:lang="ca">és revisió d’una expressió</rdfs:label>
        <rdfs:label xml:lang="et">ülevaade väljendusest</rdfs:label>
        <rdfs:label xml:lang="el">είναι εξέταση της (έκφρασης)</rdfs:label>
        <rdfs:label xml:lang="ar">هو مراجعة لتعبيرة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是内容表达的评论</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eseri tarafından kısaca değerlendirilen bir anlatımla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un&apos;espressione usata come base per una breve valutazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kifejezési formához, amelyet egy rövid kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ekspressioon, jota on käytetty lyhyen arvioinnin perustana.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị được dùng như là cơ sở cho đánh giá ngắn gọn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une expression qui est brièvement évaluée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una expressió que és avaluada breument per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una expresión que es brevemente evaluada por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een expressie die kort beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et uttrykk brukt som utgangspunkt for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et udtryk, som anvendes som grundlag for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an expression that is briefly evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar izteiksmi, kas izmantota par pamatu īsam novērtējumam.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose väljendusega, mis on lühihinnangu aluseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Expression, die als Grundlage für eine kurze Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια έκφραση που χρησιμοποιείται ως η βάση για μια σύντομη αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتعبيرة تستخدم كأساس لتقييم موجز.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品简要评价的一种内容表达关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10281 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10281">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">anlatımın eleştirisidir</rdfs:label>
        <rdfs:label xml:lang="et">arvustatud väljendus</rdfs:label>
        <rdfs:label xml:lang="hu">bírálata a következő kifejezési formának:</rdfs:label>
        <rdfs:label xml:lang="da">er kritik af udtryk</rdfs:label>
        <rdfs:label xml:lang="no">er kritikk av uttrykk</rdfs:label>
        <rdfs:label xml:lang="es">es crítica de la expresión</rdfs:label>
        <rdfs:label xml:lang="fr">est une critique d’une expression</rdfs:label>
        <rdfs:label xml:lang="lv">ir kritika izteiksmei</rdfs:label>
        <rdfs:label xml:lang="en">is critique of expression</rdfs:label>
        <rdfs:label xml:lang="nl">is kritiek van expressie</rdfs:label>
        <rdfs:label xml:lang="de">ist Kritik von (Expression)</rdfs:label>
        <rdfs:label xml:lang="fi">kritiikki ekspressiosta</rdfs:label>
        <rdfs:label xml:lang="vi">là phê bình của (biểu hiện)</rdfs:label>
        <rdfs:label xml:lang="it">è critica di espressione</rdfs:label>
        <rdfs:label xml:lang="ca">és crítica d’una expressió</rdfs:label>
        <rdfs:label xml:lang="el">είναι κρίση της (έκφραση)</rdfs:label>
        <rdfs:label xml:lang="ar">هو نقد لتعبيرة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是内容表达的批评</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından eleştirel olarak değerlendirilen bir anlatımla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un&apos;espressione usata come base per una valutazione critica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kifejezési formához, amelyet egy kritikai kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ekspressioon, johon kriittinen arviointi perustuu.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị được dùng như là cơ sở cho đánh giá phê bình.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une expression qui fait l’objet d’une évaluation critique par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una expressió que és avaluada críticament per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una expresión que es evaluada críticamente por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een expressie die kritisch beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et uttrykk brukt som utgangspunkt for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et udtryk, som anvendes som grundlag for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an expression that is critically evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar izteiksmi, kas izmantota par pamatu kritikai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose väljendusega, mis on aluseks kriitilisele hinnangule.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Expression, die als Grundlage für eine kritische Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια έκφραση που χρησιμοποιείται ως η βάση για μια κριτική αξιολόγηση.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتعبيرة تستخدم كأساس لتقييم نقدي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品批评性评价的一种内容表达关联起来。</skos:definition>
