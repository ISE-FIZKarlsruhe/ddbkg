        <owl:inverseOf rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isRepresentationOf"/>
        <rdfs:domain rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Expression"/>
        <rdfs:range rdf:resource="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#Item"/>
        <rdfs:label xml:lang="en">mocho:hasRepresentation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isAdaptationOf -->

    <owl:ObjectProperty rdf:about="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isAdaptationOf">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/vocab/frbr/core#relatedEndeavour"/>
        <rdfs:comment xml:lang="en">It identifies the work/expression of an adapted one.</rdfs:comment>
        <rdfs:label xml:lang="en">mocho:isAdaptationOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isEmbodimentOf -->

    <owl:ObjectProperty rdf:about="https://ise-fizkarlsruhe.github.io/ddbkg/mocho#isEmbodimentOf">
