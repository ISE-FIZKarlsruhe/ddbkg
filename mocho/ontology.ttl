###  http://rdaregistry.info/Elements/w/P10019
rdaw:P10019 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "er del af værk"@da ,
                       "er del av verk"@no ,
                       "es parte de obra"@es ,
                       "eserin bir bileşenidir"@tr ,
                       "est une partie d’œuvre de"@fr ,
                       "ir daļa darbā"@lv ,
                       "is deel van werk"@nl ,
                       "is part of work"@en ,
                       "ist Teil von (Werk)"@de ,
                       "osa teosest"@et ,
                       "osa teosta"@fi ,
                       "része a következő műnek:"@hu ,
                       "è parte di opera"@it ,
                       "és part d’una obra"@ca ,
                       "được chứa trong (tác phẩm)"@vi ,
                       "περιέχεται σε (έργο)"@el ,
                       "هو جزء من عمل"@ar ,
                       "是作品的部分"@zh-hans-cn ;
            skos:definition "Bir eseri, ayrık bir bileşen olarak farklı bir esere sahip bir eserle ilişkilendirir."@tr ,
                            "Correla un’opera a un’opera che ha un’altra opera come componente distinta."@it ,
                            "Hozzákapcsol egy művet egy műhöz, amely elkülöníthető alkotóelemként rendelkezik egy másik művel."@hu ,
                            "Liittää teoksen teokseen, jolla on toinen teos itsenäisenä osana."@fi ,
                            "Liên kết tác phẩm với tác phẩm lớn hơn mà tác phẩm là bộ phận cấu thành tách biệt."@vi ,
                            "Met une œuvre en relation avec une œuvre qui a pour composante distincte une autre œuvre."@fr ,
                            "Relaciona una obra amb una obra que té una altra obra com a component discret."@ca ,
                            "Relaciona una obra con una obra que tiene otra obra como un componente discreto."@es ,
                            "Relateert een werk aan een werk dat een ander werk als afzonderlijk onderdeel heeft."@nl ,
                            "Relaterer et verk til et verk som inneholder et annet verk som en avgrenset del."@no ,
                            "Relaterer et værk til et værk, som har et andet værk som en separat komponent."@da ,
                            "Relates a work to a work that has another work as a discrete component."@en ,
                            "Sasaista darbu ar darbu, kam ir cits darbs kā atsevišķa sastāvdaļa."@lv ,
                            "Seostab teose teosega, millesse kuulub iseseisva koostisosana teine teos."@et ,
                            "Setzt ein Werk in Beziehung zu einem Werk, das ein anderes Werk als einzelnen Bestandteil enthält."@de ,
                            "Συνδέει ένα έργο με ένα μεγαλύτερο έργο για το οποίο το έργο συνιστά ένα διακριτό συστατικό."@el ,
                            "يربط عمل بعمل يحتوي على عمل آخر كمكون منفصل."@ar ,
                            "将一种作品与有另一种作品作为独立组成部分的一种作品关联起来。"@zh-hans-cn ;
            skos:scopeNote "A part work is considered to be essential to the whole work."@en ,
                           "A részmű alapvető fontosságú az egész mű szempontjából."@hu ,
                           "Bir parça eserin, eserin bütünü için gerekli olduğu kabul edilir."@tr ,
                           "Darbs: daļa, kuru uzskata par būtisku visam darbam."@lv ,
                           "Del af et værk er anset for at være vigtigt for hele værket."@da ,
                           "Een deelwerk wordt beschouwd als essentieel voor het hele werk."@nl ,
                           "Ein Teilwerk wird als wesentlich für das Gesamtwerk angesehen."@de ,
                           "Et delverk er ansett å være viktig for hele verket."@no ,
                           "Teoksen osaa pidetään olennaisena koko teokselle."@fi ,
                           "Teose osa peetakse kogu teose suhtes oluliseks."@et ,
                           "Un'opera parte è considerata essenziale per l'intera opera"@it ,
                           "Una obra de part es considera essencial per a l’obra completa."@ca ,
                           "Una parte de obra se considera esencial para la obra completa."@es ,
                           "Une partie d’œuvre est considérée comme essentielle à l’œuvre entière."@fr ,
                           "يعد العمل الجزئي ضروريًا للعمل بأكمله."@ar ,
                           "一种部分作品被认为对于完整作品至关重要。"@zh-hans-cn .


###  http://rdaregistry.info/Elements/w/P10024
rdaw:P10024 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
