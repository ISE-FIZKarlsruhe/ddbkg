    <!-- http://www.openarchives.org/ore/terms/proxyFor -->

    <owl:ObjectProperty rdf:about="http://www.openarchives.org/ore/terms/proxyFor"/>
    


    <!-- http://www.w3.org/2002/07/owl#topObjectProperty -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader">
