###  http://rdaregistry.info/Elements/w/P10563
rdaw:P10563 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "a pour famille productrice de cinéma"@fr ,
                       "elokuvatuottaja (suku)"@fi ,
                       "film yapımcısı ailesi ile ilişkilidir"@tr ,
                       "filmas producents (dzimta/ģimene)"@lv ,
                       "filmiprodutsent (perekond)"@et ,
                       "filmproducer családja a következő:"@hu ,
                       "ha come produttore televisivo famiglia "@it ,
                       "har familie, som er filmproducer"@da ,
                       "har filmprodusent (familie)"@no ,
                       "has film producer family"@en ,
                       "hat Filmproduzentin/Filmproduzenten (Familie)"@de ,
                       "heeft filmproducent-familie"@nl ,
                       "tiene familia productora fílmica"@es ,
                       "té com a família productora cinematogràfica"@ca ,
                       "له عائلة منتجة أفلام"@ar ,
                       "有电影制作者家族"@zh-hans-cn ;
            skos:definition "Bir eseri, bir filmin yapımının ticari yönlerinin çoğundan sorumlu olan yapımcı bir aileyle ilişkilendirir."@tr ,
                            "Correla un'opera alla famiglia produttore responsabile della gestione della maggior parte degli aspetti commerciali di un film. "@it ,
                            "Hozzákapcsol egy művet egy producer családhoz, amely felelős egy filmprodukció üzleti vonatkozásainak a zöméért."@hu ,
                            "Liittää teoksen sukuun, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta."@fi ,
                            "Met une œuvre en relation avec une famille productrice qui est responsable de la majeure partie des aspects commerciaux de la production d’un film."@fr ,
                            "Relaciona un recurso con una familia que es una productora que es responsable de gestionar la mayoría de los aspectos comerciales de un film."@es ,
                            "Relaciona una obra amb una família que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula."@ca ,
                            "Relateert een werk aan een familie die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film."@nl ,
                            "Relaterer et verk til en familie som er en produsent med ansvar for de fleste forretningsmessige aspektene ved en film."@no ,
                            "Relaterer et værk til en familie, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film."@da ,
                            "Relates a work to a family who is a producer who is responsible for most of the business aspects of the production of a film."@en ,
                            "Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par filmas uzņemšanas finansiālajiem aspektiem."@lv ,
                            "Seostab teose perekonnaga, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel."@et ,
                            "Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Familie), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist."@de ,
                            "يربط بين عمل وعائلة تكون منتجة مسئولة عن معظم جوانب العمل في فيلم."@ar ,
                            "将一种作品与作为制作者并负责电影制作的大部分商业运作的一个家族关联起来。"@zh-hans-cn .


