###  http://rdaregistry.info/Elements/m/P30421
rdam:P30421 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdam: ;
            rdfs:label "a pour collectivité créatrice d’une manifestation"@fr ,
                       "gösterimin yaratıcı tüzel kişisi ile ilişkilidir"@tr ,
