                       "heeft bijdrage-persoon van cartografie"@nl ,
                       "kaastööline kartograafia alal (isik)"@et ,
                       "kartografiaan osallinen henkilö"@fi ,
                       "kartografiye katkıda bulunan kişi ile ilişkilidir"@tr ,
                       "kartogrāfijas līdzradītājs (persona)"@lv ,
                       "tiene persona colaboradora de cartografía"@es ,
