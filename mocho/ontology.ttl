                       "has screenwriter family"@en ,
                       "hat Drehbuchautorin/Drehbuchautor (Familie)"@de ,
                       "heeft scenarioschrijver-familie"@nl ,
                       "käsikirjoittaja (suku)"@fi ,
                       "scenārists (dzimta/ģimene)"@lv ,
                       "senarist ailesi ile ilişkilidir"@tr ,
                       "stsenarist (perekond)"@et ,
                       "tiene familia guionista"@es ,
