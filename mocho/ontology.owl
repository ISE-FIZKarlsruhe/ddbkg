    <!-- http://rdaregistry.info/Elements/w/P10285 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10285">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité défenderesse</rdfs:label>
        <rdfs:label xml:lang="hu">alperes testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">atbildētājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="vi">có tập thể bị đơn</rdfs:label>
        <rdfs:label xml:lang="tr">davalı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come imputato ente </rdfs:label>
        <rdfs:label xml:lang="da">har sagsøgt korporation</rdfs:label>
        <rdfs:label xml:lang="no">har saksøkt korporasjon</rdfs:label>
        <rdfs:label xml:lang="en">has defendant corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Angeklagte/Angeklagten/Beklagte/Beklagten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft verweerder-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">kostja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo demandado</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa acusada</rdfs:label>
        <rdfs:label xml:lang="fi">yhteisövastaaja</rdfs:label>
        <rdfs:label xml:lang="el">έχει εναγόμενο συλλογικό όργανο</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مدعى عليها</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有被告团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ceza davasında suçlanan veya bir hukuk davasında dava edilen bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile per la creazione di un nuovo dispositivo o procedimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amelyet büntetőjogi eljárásban vádolnak, vagy polgári jogi eljárásban perelnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể bị buộc tội trong vụ kiện hình sự hoặc bị kiện trong vụ kiện dân sự.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est accusée dans une poursuite criminelle ou contre laquelle une poursuite civile est intentée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és acusada en un procés penal o demandada en un procés civil.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que está imputado en un proceso penal o demandada en un proceso civil.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die beschuldigd is in een strafproces of gedaagd wordt in een civielrechtelijke procedure.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å bli tiltalt i en straffesak eller saksøkt i en sivilrettslig sak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at være anklaget i en straffesag eller sagsøgt i en civilsag.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is accused in a criminal proceeding or sued in a civil proceeding.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, pret kuru celta prasība kriminālprocesā vai sūdzība civilprocesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kelle vastu on esitatud süüdistus kriminaalkohtumenetluses või hagi tsiviilkohtumenetluses. </skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die in einem Strafverfahren angeklagt oder in einem Zivilverfahren verklagt ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα  συλλογικό όργανο, το οποίο έχει κατηγορηθεί σε μία ποινική διαδικασία ή έχει ασκηθεί αγωγή εναντίον του στο πλαίσιο αστικής διαδικασίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة متهمة في دعوى جنائية أو تحاكم في دعوى مدنية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在刑事或民事诉讼中被控告的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10286 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10286">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne défenderesse</rdfs:label>
        <rdfs:label xml:lang="hu">alperes személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">atbildētājs (persona)</rdfs:label>
        <rdfs:label xml:lang="vi">có cá nhân bị đơn</rdfs:label>
        <rdfs:label xml:lang="tr">davalı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come imputato persona </rdfs:label>
        <rdfs:label xml:lang="da">har sagsøgt person</rdfs:label>
        <rdfs:label xml:lang="no">har saksøkt person</rdfs:label>
        <rdfs:label xml:lang="en">has defendant person</rdfs:label>
        <rdfs:label xml:lang="de">hat Angeklagte/Angeklagten/Beklagte/Beklagten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft verweerder-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">henkilövastaaja</rdfs:label>
        <rdfs:label xml:lang="et">kostja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona demandada</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona acusada</rdfs:label>
        <rdfs:label xml:lang="el">έχει εναγόμενο φυσικό πρόσωπο</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مدعى عليه</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有被告个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ceza davasında suçlanan veya bir hukuk davasında dava edilen kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una persona accusata in un procedimento penale o citata in un procedimento civile.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, akit büntetőjogi eljárásban vádolnak, vagy polgári jogi eljárásban perelnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on syytettynä rikosprosessissa tai jota vastaan on nostettu kanne.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với cá nhân bị buộc tội trong vụ kiện hình sự hoặc bị kiện trong vụ kiện dân sự.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est accusée dans une poursuite criminelle ou contre laquelle une poursuite civile est intentée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és acusada en un procés penal o demandada en un procés civil.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que está imputada en un proceso penal o demandada en un proceso civil.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die beschuldigd wordt in een strafproces of gedaagd wordt in een civielrechtelijke procedure.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er tiltalt i en straffesak eller saksøkt i en sivilrettslig sak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er anklaget i en straffesag eller sagsøgt i en civilsag.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is accused in a criminal proceeding or sued in a civil proceeding.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir apzūdzēta kriminālprocesā vai iesūdzēta civilprocesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kelle vastu on esitatud süüdistus kriminaalkohtumenetluses või hagi tsiviilkohtumenetluses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die in einem Strafverfahren angeklagt oder in einem Zivilverfahren verklagt ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα φυσικό πρόσωπο, το οποίο έχει κατηγορηθεί σε μία ποινική διαδικασία ή έχει ασκηθεί αγωγή εναντίον του στο πλαίσιο αστικής διαδικασίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص متهم في دعوى جنائية أو يحاكم في دعوى مدنية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在刑事或民事诉讼中被控告的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10287 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10287">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent commanditaire</rdfs:label>
        <rdfs:label xml:lang="vi">có tập thể uỷ thác</rdfs:label>
        <rdfs:label xml:lang="tr">görevlendiren temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come committente agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er opgavestiller</rdfs:label>
        <rdfs:label xml:lang="no">har oppdragsgiver (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has commissioning agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Auftraggeberin/Auftraggeber (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft opdrachtgever-actor</rdfs:label>
        <rdfs:label xml:lang="hu">megrendelő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pasūtītājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">tellija (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente comisionista</rdfs:label>
        <rdfs:label xml:lang="fi">toimeksiantaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent comitent</rdfs:label>
        <rdfs:label xml:lang="el">έχει φορέα ανάθεσης</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جهة تكليف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有委托行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eseri görevlendirmekten sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente che commissiona un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy mű megrendeléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa teoksen teettämisestä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm về uỷ thác tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la commande d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable d’encarregar una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de encargar una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor opdracht geven tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å bestille et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for bestilling af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for commissioning a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par darba pasūtīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab teose tellimise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der ein Werk in Auftrag gibt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για την ανάθεση ενός έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن التكليف بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责委托一种作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10292 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10292">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour participant à un traité</rdfs:label>
        <rdfs:label xml:lang="tr">antlaşmanın katılımcısı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có bên tham gia hiệp ước</rdfs:label>
        <rdfs:label xml:lang="it">ha come partecipante a un trattato</rdfs:label>
        <rdfs:label xml:lang="no">har part i traktat</rdfs:label>
        <rdfs:label xml:lang="da">har traktatdeltager</rdfs:label>
        <rdfs:label xml:lang="en">has participant in treaty</rdfs:label>
        <rdfs:label xml:lang="de">hat Vertragspartnerin/Vertragspartner</rdfs:label>
        <rdfs:label xml:lang="nl">heeft deelnemer in verdrag</rdfs:label>
        <rdfs:label xml:lang="lv">līgumslēdzējs</rdfs:label>
        <rdfs:label xml:lang="et">rahvusvahelise lepingu osaline</rdfs:label>
        <rdfs:label xml:lang="hu">szerződés résztvevője a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene participante en el tratado</rdfs:label>
        <rdfs:label xml:lang="ca">té com a participant en un tractat</rdfs:label>
        <rdfs:label xml:lang="fi">valtiosopimuksen allekirjoittaja</rdfs:label>
        <rdfs:label xml:lang="el">έχει συμμετέχοντα σε συνθήκη</rdfs:label>
        <rdfs:label xml:lang="ar">له مشارك في معاهدة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有条约的参与者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir anlaşmayı imzalayan, onaylayan veya anlaşmaya katılan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un ente che ha firmato, ratificato o aderito a un trattato.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely aláírt, ratifikált vagy jóváhagyott egy szerződést.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on allekirjoittanut, ratifioinut tai liittynyt valtiosopimukseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể chính phủ, liên chính phủ quốc tế, hoặc tập thể khác ký, phê chuẩn, hoặc gia nhập hiệp ước.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui a signé ou ratifié un traité ou y a adhéré.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que ha signat, ratificat o accedit a un tractat.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que ha firmado, ratificado o accedido a un tratado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die heeft getekend, geratificeerd of is toegetreden aan een verdrag.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som har undertegnet, ratifisert eller sluttet seg til en traktat.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som har underskrevet, ratificeret eller tiltrådt en traktat.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who has signed, ratified, or acceded to a treaty.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir parakstījusi, ratificējusi vai pievienojusies līgumam.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on rahvusvahelise lepingu alla kirjutanud, ratifitseerinud või sellega ühinenud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die ein Abkommen unterzeichnet, ratifiziert hat oder ihm beigetreten ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα κυβερνητικό, διεθνές διακυβερνητικό συλλογικό όργανο ή άλλο συλλογικό όργανο, το οποίο έχει υπογράψει, επικυρώσει ή προσχωρήσει σε μια συνθήκη.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة وقعت معاهدة، أو صادقت عليها، أو انضمت إليها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与签署、批准或加入一个条约的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10293 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10293">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent recherchiste</rdfs:label>
        <rdfs:label xml:lang="tr">araştırmacı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà nghiên cứu</rdfs:label>
        <rdfs:label xml:lang="it">ha come ricercatore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er researcher</rdfs:label>
        <rdfs:label xml:lang="no">har forsker (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has researcher agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Forscherin/Forscher (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderzoeker-actor</rdfs:label>
        <rdfs:label xml:lang="hu">kutató ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pētnieks (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente investigador</rdfs:label>
        <rdfs:label xml:lang="fi">tutkija (toimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent investigador</rdfs:label>
        <rdfs:label xml:lang="et">uurija (tegija)</rdfs:label>
        <rdfs:label xml:lang="el">έχει ερευνητή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل باحث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有研究者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserin oluşturulmasını desteklemek için araştırma yapan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente che fa ricerche a supporto della creazione di un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely kutatást végez egy mű megalkotásának támogatására.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka tukee teoksen syntymistä tutkimuksellaan.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân tiến hành nghiên cứu để hỗ trợ sáng tạo tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui effectue des recherches pour aider à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que fa recerca per donar suport a la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que realiza investigaciones en apoyo a la creación de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die onderzoek doet ter ondersteuning van de creatie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som forsker som støtte til å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som udfører research til at understøtte skabelsen af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who does research in support of the creation of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas veicis pētniecību darba radīšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes teeb teose loomise heaks uurimistööd.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der Forschung betreibt, um das Schaffen eines Werks zu unterstützen.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα, ο οποίος διεξάγει έρευνα υποστηρικτικά της δημιουργίας ενός έργου.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يقوم بإجراء بحث لدعم إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与从事研究以支持一种作品的创作的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10297 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10297">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent organisateur</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà tổ chức</rdfs:label>
        <rdfs:label xml:lang="it">ha come organizzatore agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er arrangør</rdfs:label>
        <rdfs:label xml:lang="no">har arrangør (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has organizer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Veranstalterin/Veranstalter (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft organisator-actor</rdfs:label>
        <rdfs:label xml:lang="fi">järjestäjä (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">korraldaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="tr">organizatör temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">organizētājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="hu">szervező ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente organizador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent organitzador</rdfs:label>
        <rdfs:label xml:lang="el">έχει οργανωτή</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل منظم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有组织者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eseri ortaya çıkaran bir konferans, sergi veya başka bir etkinlik düzenleyen bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente che organizza una conferenza, una mostra o un altro evento che dà origine a un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely egy mű létrejöttét eredményező konferenciát, kiállítást vagy egyéb eseményt szervez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân tổ chức triển lãm, sự kiện, hội nghị, khoá học, chương trình, v.v... bắt nguồn cho tác phẩm.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui organise un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que organitza un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que organiza una conferencia, exposición u otro evento que dé origen a una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die organiseert een conferentie, tentoonstelling of andere gebeurtenis die aanleiding geeft tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som organiserer en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som organiserer en konference, udstilling eller anden begivenhed, som giver anledning til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who organizes a conference, exhibition, or other event that gives rise to a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas organizējis konferenci, izstādi vai citu pasākumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes korraldab teosele aluse pannud konverentsi, näituse vm ürituse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert beziehungsweise veranstaltet, aus der/dem ein Werk hervorgeht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα, ο οποίος οργανώνει μια έκθεση, ένα συμβάν, συνέδριο κ.λπ., εκ των οποίων προέκυψε η ανάγκη για ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل ينظم مؤتمرًا، أو معرضًا، أو أي حدث آخر ينتج عنه عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与组织会议、展览或其他事件以产生一种作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10298 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10298">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent directeur de publication</rdfs:label>
        <rdfs:label xml:lang="vi">có giám đốc biên tập</rdfs:label>
        <rdfs:label xml:lang="hu">főszerkesztő ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">galvenais redaktors (aģents)</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore editoriale agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er ansvarshavende redaktør</rdfs:label>
        <rdfs:label xml:lang="no">har redaksjonssjef (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has editorial director agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Chefredakteurin/Chefredakteur (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft hoofdredacteur-actor</rdfs:label>
        <rdfs:label xml:lang="et">peatoimetaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente director editorial</rdfs:label>
        <rdfs:label xml:lang="fi">toimituspäällikkö (toimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent director editorial</rdfs:label>
        <rdfs:label xml:lang="tr">yayın yönetmeni temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="el">έχει διευθυντή σύνταξης</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مدير تحرير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主编行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir artzamanlı eserin yayın politikası ve içeriği için yasal veya fikri sorumluluğu olan, ancak yaratıcı sorumluluğu olmayan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente che ha la responsabilità legale o intellettuale, ma non quella creativa, per la politica editoriale e i contenuti di un’opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amelynek jogi vagy szellemi, de nem alkotói felelőssége van egy diakronikus mű szerkesztési politikájáért és tartalmáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm pháp lý và/hoặc trú tuệ khác với sáng tạo nội dung của ấn phẩm nhiều kỳ, tài nguyên tích hợp, hoặc chuyên khảo nhiều phần.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui a la responsabilité légale ou intellectuelle, mais non la responsabilité créative, de la politique éditoriale et du contenu d’une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que té responsabilitat legal o intel·lectual, però no responsabilitat creativa, de la política editorial i el contingut d’una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que tiene responsabilidad legal o intelectual, pero no creativa, por la política editorial y el contenido de una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die wettelijke of intellectuele verantwoordelijkheid, maar niet creatieve verantwoordelijkheid heeft voor het redactioneel beleid en content van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som har juridisk eller intellektuelt ansvar, men ikke kreativt ansvar, for det redaksjonelle innholdet i et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er juridisk eller intellektuelt ansvarlig, men ikke skabelsesansvarlig, for et diakronisk værks redaktionelle linje og indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who has legal or intellectual responsibility, but not creative responsibility, for the editorial policy and content of a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kam ir juridiska vai intelektuāla, bet ne radoša atbildība par diahroniskā darba izdošanas politiku un saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes juriidiliselt või intellektuaalselt, kuid mitte loominguliselt vastutab diakroonilise teose toimetamispõhimõtete ja sisu eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der die rechtliche oder intellektuelle, aber keine kreative, Verantwortung für die redaktionelle Vorgehensweise und den Inhalt eines diachronen Werks trägt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη νομική ή/και πνευματική υπευθυνότητα, άλλη από τη δημιουργία, για το περιεχόμενο ενός περιοδικού, ενός ενσωματωμένου πόρου ή μιας πολυμερούς μονογραφίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يتحمل مسئولية قانونية أو فكرية، ولكن لا يتحمل مسئولية إبداعية، عن السياسة التحريرية ومحتوى عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与有对一种历时作品的编辑政策和内容的法律或知识责任（但非创作责任）的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Bir eserin anlatımının gözden geçirilmesi, netleştirilmesi veya içeriğinin başka bir şekilde değiştirilmesi hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darbība neietver darba izteiksmes satura pārskatīšanu, precizēšanu vai cita veida izmaiņas u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen nicht Überarbeitungen, Erläuterungen oder andere inhaltliche Änderungen an einer Expression eines Werks.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Duyệt lại, làm rõ nội dung, v.v..., trong biểu hiện của tác phẩm không được bao gồm.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu parandamist, täpsustamist ega muude muudatuste tegemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Herziening, toelichting of andere verandering van content van een expressie van een werk is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La révision, la clarification ou toute autre modification du contenu d’une expression d’une œuvre sont exclues.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele egy mű kifejezési formájának revíziója, áttekintése, vagy egyéb tartalmi változtatása.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Revision, clarification, or other change of content of an expression of a work is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revision, indholdspræcisering eller anden ændring af indholdet af et værks udtryk er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la revisión, aclaración u otro cambio de contenido de una expresión de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono esclusi revisione, chiarimenti o modifiche nel contenuto di un’espressione di un’opera.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la revisió, l’aclariment o qualsevol altre canvi del contingut d’una expressió d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Å redigere innholdet i et uttrykk av et verk eller gjøre det klarere er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Δεν περιλαμβάνεται η αναθεώρηση, η αποσαφήνιση του περιεχομένου κ.λπ. σε μια έκφραση ενός έργου.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل، أو توضيحه، أو أي تغيير آخر فيه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括对一种作品的一种内容表达之内容的修订、说明或其他变化。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10299 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10299">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent fondateur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="vi">có người tạo lập tác phẩm</rdfs:label>
        <rdfs:label xml:lang="lv">darba dibinātājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kurucu temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fondatore agente di un&apos;opera</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er stifter af værk</rdfs:label>
        <rdfs:label xml:lang="no">har grunnlegger av verk (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has founder agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Begründerin/Begründer eines Werks (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft oprichter-actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű alapító ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen perustaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose asutaja (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente fundador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent fundador d’una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει θεμελιωτή του έργου</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مؤسس لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创办者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eseri başlatmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente responsabile dell&apos;avvio di un&apos;opera diacronica.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa diakronisen teoksen alullepanosta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm tạo lập ấn phẩm nhiều kỳ, tài nguyên tích hợp, hoặc chuyên khảo nhiều phần.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de lancer une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable d’iniciar una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de iniciar una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het initiëren van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som har ansvar for å etablere et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at igangsætte et diakronisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for initiating a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab diakroonilise teose ellukutsumise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für das Begründen eines diachronen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="hu">műalapító ágens:</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για την ίδρυση ενός περιοδικού, ενός ενσωματωμένου πόρου ή μιας πολυμερούς μονογραφίας.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن بدء عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责发起一种历时作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10304 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10304">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent producteur audio</rdfs:label>
        <rdfs:label xml:lang="hu">audioproducer ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">audioprodutsent (tegija)</rdfs:label>
        <rdfs:label xml:lang="vi">có nhà sản xuất audio</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore audio agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er lydproducer</rdfs:label>
        <rdfs:label xml:lang="no">har lydprodusent (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has audio producer agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten einer Tonaufnahme (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geluidsproducent-actor</rdfs:label>
        <rdfs:label xml:lang="tr">ses yapımcısı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņu ierakstu producents (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente productor de audio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent productor d’àudio</rdfs:label>
        <rdfs:label xml:lang="fi">äänituottaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="el">έχει παραγωγό ήχου</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل منتج صوت</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音频制作者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ses kaydının ticari yönlerinin çoğunu yönetmekten sorumlu olan bir yapımcı olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera all&apos;agente produttore responsabile per la gestione della maggior parte degli aspetti commerciali di una registrazione audio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer ágenshez, amely felelős egy hangfelvétel üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với nhà sản xuất có trách nhiệm về phần lớn khía cạnh kinh doanh của bản ghi audio.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent producteur qui est responsable de gérer la majeure partie des aspects commerciaux d’un enregistrement audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un productor que és responsable de la gestió de la majoria dels aspectes comercials d’un enregistrament àudio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente quien es un productor que es responsable de gestionar la mayoría de los aspectos comerciales de una grabación de audio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er en produsent som er ansvarlig for de fleste forretningsmessige aspektene ved et lydopptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er en producer, som er ansvarlig for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is a producer who is responsible for managing most of the business aspects of an audio recording. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar producentu aģentu, kas ir atbildīgs par skaņu ieraksta biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes produtsendina vastutab enamiku äriliste aspektide korraldamise eest helisalvestusel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Akteur), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν παραγωγό υπεύθυνο για τις περισσότερες επιχειρηματικές πτυχές μιας ηχογράφησης.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يكون منتجًا مسئولاً عن إدارة معظم جوانب العمل في تسجيل صوتي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个制作者并负责音频录制工作大多数方面商业运作之管理的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10305 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10305">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent directeur de casting</rdfs:label>
        <rdfs:label xml:lang="lv">aktieru atlases režisors (aģents)</rdfs:label>
        <rdfs:label xml:lang="et">casting&apos;u juht (tegija)</rdfs:label>
        <rdfs:label xml:lang="vi">có giám đốc phân vai</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore del casting agente</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er caster</rdfs:label>
        <rdfs:label xml:lang="no">har casting director (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has casting director agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Casting Director (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft castingdirector-actor</rdfs:label>
        <rdfs:label xml:lang="tr">kast yönetmeni temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">roolittaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">szereposztó rendező ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente director de casting</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent director de càsting</rdfs:label>
        <rdfs:label xml:lang="el">έχει υπεύθυνο διανομής ρόλων</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مدير طاقم تمثيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有角色导演行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, sanatçılara rol ve görev verilmesinin tüm yönlerinden sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente responsabile per la maggior parte degli aspetti della assegnazione di parti e compiti agli interpreti.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm về phần lớn khía cạnh được gán cho phần hoặc nhiệm vụ của những người biểu diễn.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la majoria dels aspectes de l’assignació de parts i funcions als intèrprets.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de la mayoría de los aspectos de la asignación de partes y deberes a los intérpretes.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for de fleste aspekter ved å fordele roller og oppgaver mellom utøvere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for de fleste aspekter ved tildeling af roller og ansvar til udøvere.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for most aspects of assigning parts and duties to performers.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par lomu sadali un pienākumu piešķiršanu izpildītājiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab enamiku aspektide eest esitajatele rollide ja ülesannete jagamisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τις περισσότερες πτυχές της κατανομής ρόλων και αρμοδιοτήτων στους εκτελεστές.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن معظم جوانب تخصيص الأدوار والواجبات للمؤدين.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责给演员分配角色和任务的大多数工作的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10306 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10306">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent remixeur</rdfs:label>
        <rdfs:label xml:lang="vi">có nghệ sỹ hoà âm</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista di remix agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er remixer</rdfs:label>
        <rdfs:label xml:lang="no">har remikser (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has remix artist agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Remix Artist (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft remixartiest-actor</rdfs:label>
        <rdfs:label xml:lang="et">remiksija (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">remiksētājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="tr">remix sanatçısı temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">remixművész ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente artista de remix</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent artista de remescla</rdfs:label>
        <rdfs:label xml:lang="fi">uudelleenmiksaaja (toimija)</rdfs:label>
        <rdfs:label xml:lang="el">έχει καλλιτέχνη remix</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل فنان مزج موسيقي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合成艺术家行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, önceden kaydedilmiş sesleri değiştirerek, birleştirip karıştırarak ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente responsabile di un’opera audio mediante la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân có trách nhiệm sáng tạo tác phẩm audio bằng cách thực hiện, kết hợp, hoà âm, và sản xuất lại âm thanh được ghi trước đây.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es responsable de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde. </skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für das Schaffen eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα υπεύθυνο για τη δημιουργία ενός ακουστικού έργου μέσω του χειρισμού, της επανασύνθεσης, της μίξης και της αναπαραγωγής προηγούμενα ηχογραφημένων ήχων.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل صوتي عن طريق معالجة الأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创建一种音频作品的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="it">Correla un’opera a un agente responsabile di un’opera audio mediante la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="vi">Hoạt động tái hào âm không làm thay đổi cơ bản bản chất và nội dung và nội dung của tác phẩm nguyên gốc và hoà trộn các rãnh ghi với nhau để thành rãnh liên tục không được bao gồm.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido del trabajo original, y la mezcla de pistas grabadas para que aparezcan como una pista continua.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua.</skos:scopeNote>
        <skos:scopeNote xml:lang="el">Δεν περιλαμβάνονται οι διαδικασίες μίξης, οι οποίες δεν μεταβάλλουν ουσιαστικά τη φύση και το περιεχόμενου του πρωτότυπου έργου και η μίξη ηχογραφημένων κομματιών [με τέτοιον τρόπο], ώστε [αυτά] να εμφανίζονται ως ένα ενιαίο κομμάτι.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10309 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10309">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour manifestation en relation avec une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">ar darbu saistītā manifestācija</rdfs:label>
        <rdfs:label xml:lang="vi">có biểu thị có liên quan (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin ilgili gösterimi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come manifestazione correlata a opera</rdfs:label>
        <rdfs:label xml:lang="no">har manifestasjon relatert til verk</rdfs:label>
        <rdfs:label xml:lang="da">har manifestation relateret til værk</rdfs:label>
        <rdfs:label xml:lang="en">has related manifestation of work</rdfs:label>
        <rdfs:label xml:lang="de">hat mit Werk in Beziehung stehende Manifestation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gerelateerde manifestatie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">műhöz kapcsolódó megjelenési forma a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teokseen liittyvä manifestaatio</rdfs:label>
        <rdfs:label xml:lang="et">teosega seotud kehastus</rdfs:label>
        <rdfs:label xml:lang="es">tiene manifestación relacionada de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a manifestació relacionada amb una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχετική εκδήλωση (έργο)</rdfs:label>
        <rdfs:label xml:lang="ar">له تجسيدة مرتبطة بعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的关联载体表现</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserle bağlantılı olan bir gösterimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una manifestazione che è associata a un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy műhöz kapcsolódó megjelenési formához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen manifestaatioon, joka liittyy teokseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với biểu thị liên quan tới tác phẩm đang được mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une manifestation qui est associée à une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una manifestació que s’associa amb una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una manifestación que está asociada a una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een manifestatie die is geassocieerd met een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en manifestasjon som forbindes med et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en manifestation, som er knyttet til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a manifestation that is associated with a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar manifestāciju, kas ir saistīta ar darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega seotud kehastusega.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Manifestation, die mit einem Werk in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια εκδήλωση που συνδέεται με ένα περιγραφόμενο έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتجسيدة مرتبطة بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与和一种作品有关的一种载体表现关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10310 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10310">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour item en relation avec une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">ar darbu saistītā vienība</rdfs:label>
        <rdfs:label xml:lang="vi">có bản có liên quan (tác phẩm)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin ilgili kopyası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come item correlato a opera</rdfs:label>
        <rdfs:label xml:lang="da">har eksemplar relateret til værk</rdfs:label>
        <rdfs:label xml:lang="no">har eksemplar relatert til verk</rdfs:label>
        <rdfs:label xml:lang="en">has related item of work</rdfs:label>
        <rdfs:label xml:lang="de">hat mit Werk in Beziehung stehendes Exemplar</rdfs:label>
        <rdfs:label xml:lang="nl">heeft gerelateerd item van werk</rdfs:label>
        <rdfs:label xml:lang="hu">műhöz kapcsolódó példány a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teokseen liittyvä kappale</rdfs:label>
        <rdfs:label xml:lang="et">teosega seotud eksemplar</rdfs:label>
        <rdfs:label xml:lang="es">tiene item relacionado de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a ítem relacionat amb una obra</rdfs:label>
        <rdfs:label xml:lang="el">έχει σχετικό αντίτυπο (έργου)</rdfs:label>
        <rdfs:label xml:lang="ar">له مفردة مرتبطة بعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的关联单件</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserle bağlantılı olan bir kopyayla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un item che è associato a un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy példányhoz, amelyet egy műhöz társítanak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen kappaleeseen, joka liittyy teokseen.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với bản liên quan tới tác phẩm đang được mô tả.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un item qui est associé à une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un ítem que s’associa amb una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un item asociado a una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een item dat is geassocieerd met een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et eksemplar som forbindes med et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et eksemplar, som er knyttet til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an item that is associated with a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vienību, kas ir saistīta ar darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teosega seotud eksemplariga.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Exemplar, das mit einem Werk in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα αντίτυπο που συνδέεται με ένα περιγραφόμενο έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومفردة مرتبطة بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与和一种作品有关的一个单件关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10319 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10319">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva toimija</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (tác nhân)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto agente </rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="no">har emne agent</rdfs:label>
        <rdfs:label xml:lang="en">has subject agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft actor als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (tegija)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (aģents)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente de tema</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő ágens:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (φορέας)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente di cui l&apos;opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent sobre el qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente del que trata la obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent whom a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kelle kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν φορέα στον οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل يدور حوله عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10320 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10320">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva yhteistoimija</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (tác nhân tập thể)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har emne kollektiv agent</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft collectieve actor als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de agente colectivo</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő kollektív ágens:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (συλλογικός φορέας)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo di cui l&apos;opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tác nhân tập thể mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu sobre el qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo del que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent whom a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kelle kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν συλλογικό φορέα στον οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يدور حوله عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10321 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10321">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour lieu sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva paikka</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (địa điểm)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto luogo </rdfs:label>
        <rdfs:label xml:lang="no">har emne sted</rdfs:label>
        <rdfs:label xml:lang="da">har sted, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject place</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Geografikum)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft plaats als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan yer ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (koht)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (vieta)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de lugar</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő hely:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a lloc de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (τόπος)</rdfs:label>
        <rdfs:label xml:lang="ar">له مكان موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题地点</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan bir yerle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un luogo di cui l&apos;opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy helyhez, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen paikkaan, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với địa điểm mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un lieu dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un lloc sobre el qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con el lugar del que trata.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een plaats waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et sted som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et sted, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a place that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar vietu, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kohaga, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Geografikum, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με έναν τόπο στον οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومكان يدور حوله عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个地点关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10322 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10322">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour laps de temps sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva ajanjakso</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (khoảng thời gian)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto  intervallo di tempo</rdfs:label>
        <rdfs:label xml:lang="no">har emne tidsrom</rdfs:label>
        <rdfs:label xml:lang="da">har tidsperiode, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject timespan</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Zeitraum)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft tijdspanne als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan zaman aralığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (ajavahemik)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (laikposms)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de lapso de tiempo</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő időtartam:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a interval de temps de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (χρονικό διάστημα)</rdfs:label>
        <rdfs:label xml:lang="ar">له فترة زمنية موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题时间段</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kendisi hakkında olan bir zaman aralığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un intervallo di tempo di cui l&apos;opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy időtartamhoz, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ajanjaksoon, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với khoảng thời gian mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un laps de temps dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un interval de temps sobre el qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lapso de tiempo del que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een tijdspanne waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et tidsrom som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en tidsperiode, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a timespan that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar laikposmu, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose ajavahemikuga, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Zeitraum, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα χρονικό διάστημα στο οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وفترة زمنية يدور حولها عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个时间段关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10323 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10323">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour nomen sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva nomen</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (danh pháp)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto nomen </rdfs:label>
        <rdfs:label xml:lang="no">har emne nomen</rdfs:label>
        <rdfs:label xml:lang="da">har nomen, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="en">has subject nomen</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (Nomen)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft nomen als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan isim ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (nomen)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (nomens)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de nomen</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő nomen:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a nomen de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει οντότητα (όνομα)</rdfs:label>
        <rdfs:label xml:lang="ar">له تسمية موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题命名</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, o eserin konusu olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera con un nomen di cui l&apos;opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với danh pháp mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen sobre el qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen de que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et nomen som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et nomen, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose nomen&apos;iga, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Nomen, von dem ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα όνομα στο οποίο αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية يدور حولها عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10324 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10324">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour entité RDA sujet</rdfs:label>
        <rdfs:label xml:lang="fi">aiheena oleva RDA-entiteetti</rdfs:label>
        <rdfs:label xml:lang="vi">có chủ đề (thực thể)</rdfs:label>
        <rdfs:label xml:lang="it">ha come soggetto entità RDA</rdfs:label>
        <rdfs:label xml:lang="da">har RDA-entitet, som er subjekt</rdfs:label>
        <rdfs:label xml:lang="no">har emne RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="en">has subject RDA entity</rdfs:label>
        <rdfs:label xml:lang="de">hat Thema (RDA-Entität)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft RDA-entiteit als onderwerp</rdfs:label>
        <rdfs:label xml:lang="tr">konu alınan RDA varlığı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">teema (RDA olem)</rdfs:label>
        <rdfs:label xml:lang="lv">temats (RDA entīte)</rdfs:label>
        <rdfs:label xml:lang="es">tiene tema de entidad RDA</rdfs:label>
        <rdfs:label xml:lang="hu">tárgya a következő entitás:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat RDA de matèria</rdfs:label>
        <rdfs:label xml:lang="el">έχει θέμα (οντότητα)</rdfs:label>
        <rdfs:label xml:lang="ar">له كيان &quot;وام&quot; موضوع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主题RDA实体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, o eserin konusu olan bir RDA varlığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera con un&apos;entità RDA di cui l&apos;opera tratta.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy RDA-entitáshoz, amelyről egy mű szól.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen RDA-entiteettiin, jota teos koskee.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với thực thể mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un entité RDA dont traite une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat RDA sobre la qual tracta una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una entidad RDA de la que trata una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een RDA-entiteit waar een werk over gaat.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en RDA-entitet som et verk handler om.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en RDA-entitet, som et værk handler om.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an RDA entity that a work is about.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar RDA entīti, par kuru ir darbs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose RDA olemiga, mille kohta teos on.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer RDA-Entität, von der ein Werk handelt.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια οντότητα στην οποία αναφέρεται ένα έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وكيان &quot;وام&quot; يدور حوله عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品所关于的一个RDA实体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10325 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10325">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af person</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av person</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de persona</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’une personne</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts personai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van persoon</rdfs:label>
        <rdfs:label xml:lang="en">is description of person</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Person)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud isik</rdfs:label>
        <rdfs:label xml:lang="tr">kişinin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus henkilöstä</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő személynek:</rdfs:label>
        <rdfs:label xml:lang="vi">là mô tả của (cá nhân)</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di persona</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’una persona</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιγραφή του (φυσικό πρόσωπο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لشخص</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是个人的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser tarafından tanımlanan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona che è descritta da un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, akit egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với cá nhân mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est décrite par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és descrita per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es descrita por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, keda teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα φυσικό πρόσωπο που περιγράφεται από ένα περιγραφικό έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص موصوف في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10326 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10326">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af korporation</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av korporasjon</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de cuerpo corporativo</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’une collectivité</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts institūcijai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van corporatie</rdfs:label>
        <rdfs:label xml:lang="en">is description of corporate body</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud asutus</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus yhteisöstä</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő testületnek:</rdfs:label>
        <rdfs:label xml:lang="vi">là mô tả của (tập thể)</rdfs:label>
        <rdfs:label xml:lang="tr">tüzel kişinin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di ente</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’una entitat corporativa</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιγραφή του (συλλογικό όργανο)</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لهيئة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是团体的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser tarafından tanımlanan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente che è descritto da un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với tập thể mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est décrite par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és descrita per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es descrito por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με ένα συλλογικό όργανο που περιγράφεται από ένα περιγραφικό έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة موصوفة في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10327 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10327">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">ailenin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="da">er beskrivelse af familie</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av familie</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de familia</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’une famille</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts dzimtai/ģimenei</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van familie</rdfs:label>
        <rdfs:label xml:lang="en">is description of family</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Familie)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud perekond</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus suvusta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő családnak:</rdfs:label>
        <rdfs:label xml:lang="vi">là mô tả của (gia đình)</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di famiglia</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’una família</rdfs:label>
        <rdfs:label xml:lang="el">είναι περιγραφή της (οικογένεια)</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لعائلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是家族的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser tarafından tanımlanan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia che è descritta da un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="vi">Liên kết tác phẩm với gia đình mà tác phẩm nói về.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui est décrite par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és descrita per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es descrita por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, keda teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="el">Συνδέει ένα έργο με μια οικογένεια που περιγράφεται από ένα περιγραφικό έργο.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة موصوفة في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10328 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10328">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour point d’accès d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba pamatforma</rdfs:label>
        <rdfs:label xml:lang="tr">eser için erişim noktası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come punto d&apos;accesso per opera</rdfs:label>
        <rdfs:label xml:lang="da">har søgeindgang for værk</rdfs:label>
        <rdfs:label xml:lang="no">har søkeinngang for verk</rdfs:label>
        <rdfs:label xml:lang="en">has access point for work</rdfs:label>
        <rdfs:label xml:lang="de">hat Sucheinstieg für ein Werk</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ingang voor werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű hozzáférési pontja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen hakutieto</rdfs:label>
        <rdfs:label xml:lang="et">teose otsielement</rdfs:label>
        <rdfs:label xml:lang="es">tiene punto de acceso para la obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a punt d’accés d’obra</rdfs:label>
        <rdfs:label xml:lang="ar">له نقطة وصول لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的检索点</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kelime kodlama şemasından alınan veya bir dizge kodlama şeması kullanılarak oluşturulan doğal dilde bir eser unvanı olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una denominazione di opera in linguaggio naturale che è tratta da uno schema di codifica di vocabolario o da uno schema di codifica per stringhe.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy műveet egy nomenhez, egy mű természetes nyelvű megnevezéséhez, amely egy szótárkódolási sémából származik, vagy egy karakterlánc-kódolási séma használatával szerkesztett.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, joka on luonnollisella kielellä oleva teoksen nimitys, joka on otettu sanaston merkintäjärjestelmästä tai on muodostettu käyttämällä merkkijonon merkintäjärjestelmää.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est une appellation d’œuvre en langage naturel provenant d’un schéma d’encodage de vocabulaire ou construite à l’aide d’un schéma d’encodage de chaînes.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és una apel·lació d’obra en llenguatge natural que s’obté d’un esquema de codificació de vocabulari o s’elabora usant un esquema de codificació de cadenes.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es una denominación de obra en lenguaje natural que se toma de un esquema de codificación de vocabulario o se construye utilizando un esquema de codificación de cadenas.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat is een benaming voor werk in natuurlijke taal die ontleend is aan een vocabulair coderingsschema of gevormd is volgens een string coderingsschema.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en betegnelse på verk på et naturlig språk som er hentet fra et kodeskjema for vokabular eller er laget ved bruk av et kodeskjema for syntaks.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en benævnelse på værk på normalsprog, som er taget fra et vokabularkodningsskema eller er konstrueret ved hjælp af et strengkodningsskema.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is an appellation of work in natural language that is taken from a vocabulary encoding scheme or is constructed using a string encoding scheme.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir darba vārds/nosaukums dabiskā valodā, kas ņemts no shēmas kontrolētu vārdnīcu kodēšanai vai tiek konstruēts, izmantojot virknes kodēšanas shēmu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose nimetusega loomulikus keeles, mis on võetud leksikaalsest märkimissüsteemist või moodustatud stringilise märkimissüsteemi alusel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Bezeichnung für ein Werk in natürlicher Sprache, die einem Vocabulary Encoding Scheme entnommen oder mit einem String Encoding Scheme konstruiert wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية عبارة عن اسم تعريفي لعمل باللغة الطبيعية مأخوذ من خطة ترميز مفردات أو تم إنشاؤه باستخدام خطة ترميز سلسلة تمثيلات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一种作品的称谓、取自一个词表编码体系或者用一个串编码体系构建、用自然语言的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10330 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10330">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour note sur une œuvre</rdfs:label>
        <rdfs:label xml:lang="tr">eser hakkında not ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come nota su opera</rdfs:label>
        <rdfs:label xml:lang="da">har note om værk</rdfs:label>
        <rdfs:label xml:lang="no">har note på verk</rdfs:label>
        <rdfs:label xml:lang="en">has note on work</rdfs:label>
        <rdfs:label xml:lang="de">hat Anmerkung zum Werk</rdfs:label>
        <rdfs:label xml:lang="nl">heeft noot bij werk</rdfs:label>
        <rdfs:label xml:lang="fi">huomautus teoksesta</rdfs:label>
        <rdfs:label xml:lang="et">märkus teose kohta</rdfs:label>
        <rdfs:label xml:lang="hu">műre vonatkozó megjegyzése a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">piezīme par darbu</rdfs:label>
        <rdfs:label xml:lang="es">tiene nota sobre la obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a nota sobre una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له تبصرة عن عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有关于作品的附注</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin bir veya daha fazla niteliğinin yapılandırılmamış geniş bir tanımıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una descrizione non strutturata estesa di uno o più attributi di un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy mű egy vagy több ismérvének szabad szöveges, strukturálatlan leírásához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teoksen yhden tai useamman attribuutin yleisluonteiseen rakenteistamattomaan kuvailuun.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une description non structurée générale d’un ou plusieurs attributs d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una descripció no estructurada àmplia d’un o més atributs d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una descripción amplia y no estructurada de uno o más atributos de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een algemene ongestructureerde beschrijving van één of meer attributen van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en bred ustrukturert beskrivelse av ett eller flere attributter til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en bred, ustruktureret beskrivelse af en eller flere af et værks attributter.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a broad unstructured description of one or more attributes of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar plašu nestrukturētu darba viena vai vairāku atribūtu aprakstu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose üldise struktureerimata kirjeldusega, mis iseloomustab üht või mitut teose omadust.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer umfassenden, unstrukturierten Beschreibung eines Merkmals oder mehrerer Merkmale eines Werks.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووصف عام غير محدد لخاصية واحدة أو أكثر من خصائص عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与关于一种作品的一个或多个属性的宽泛的非结构化描述关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10331 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10331">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour point d’accès autorisé d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba autoritatīvā pamatforma</rdfs:label>
        <rdfs:label xml:lang="tr">eser için yetkili erişim noktası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come punto d&apos;accesso autorizzato per opera</rdfs:label>
        <rdfs:label xml:lang="da">har autoriseret søgeindgang for værk</rdfs:label>
        <rdfs:label xml:lang="no">har autorisert søkeinngang for verk</rdfs:label>
        <rdfs:label xml:lang="en">has authorized access point for work</rdfs:label>
        <rdfs:label xml:lang="de">hat normierten Sucheinstieg für ein Werk</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geautoriseerde ingang voor werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű autorizált hozzáférési pontja a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen auktorisoitu hakutieto</rdfs:label>
        <rdfs:label xml:lang="et">teose normitud otsielement</rdfs:label>
        <rdfs:label xml:lang="es">tiene punto de acceso autorizado para la obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a punt d’accés autoritzat d’obra</rdfs:label>
        <rdfs:label xml:lang="ar">له نقطة وصول مقننة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的规范检索点</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, belirli bir kelime kodlama şemasında tercih için seçilen bir eserin erişim noktası olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un punto d’accesso per l’opera che è selezionato come preferito in uno specifico schema di codifica di vocabolario.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, amelynek van egy olyan előnyben részesített hozzáférési pontja a műhöz, amelyet egy adott szótárkódolási sémából választanak ki.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, joka on teoksen hakutieto, joka on valittu ensisijaiseksi tietyssä sanaston merkintäjärjestelmässä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est un point d’accès d’une œuvre faisant l’objet d’un choix privilégié dans un schéma d’encodage de vocabulaire spécifique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és un punt d’accés d’obra que se selecciona com a preferent en un esquema de codificació de vocabulari específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es un punto de acceso a la obra que se selecciona de preferencia en un esquema de codificación de vocabulario específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat is een ingang voor werk die bij voorkeur geselecteerd is in een specifiek vocabulair coderingssysteem.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en søkeinngang for verk som er valgt som preferanse i et bestemt kodeskjema for vokabular.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en søgeindgang for værk, som er valgt som præference i et specifikt vokabularkodningsskema.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is an access point of work that is selected for preference in a specific vocabulary encoding scheme.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir darba pamatforma, kas ir izvēle no konkrētas vārdnīcas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose otsielemendiga, mis on valitud eelistatuks vastavas leksikaalses märkimissüsteemis.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Sucheinstieg für ein Werk, der in einem bestimmten Vocabulary Encoding Scheme als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية عبارة عن نقطة وصول لعمل تم اختيارها بتفضيل استخدامها في خطة ترميز مفردات معينة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一种作品的检索点、并在一个特定的词表编码体系中被首选的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10332 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10332">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour variante de point d’accès d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba papildforma</rdfs:label>
        <rdfs:label xml:lang="tr">eser için alternatif erişim noktası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come punto d&apos;accesso variante per opera</rdfs:label>
        <rdfs:label xml:lang="no">har alternativ søkeinngang for verk</rdfs:label>
        <rdfs:label xml:lang="da">har variant af søgeindgang for værk</rdfs:label>
        <rdfs:label xml:lang="en">has variant access point for work</rdfs:label>
        <rdfs:label xml:lang="de">hat zusätzlichen Sucheinstieg für ein Werk</rdfs:label>
        <rdfs:label xml:lang="nl">heeft variant ingang voor werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű hozzáférésipont-változata a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen varianttihakutieto</rdfs:label>
        <rdfs:label xml:lang="et">teose otsielemendi variant</rdfs:label>
        <rdfs:label xml:lang="es">tiene un punto de acceso variante para la obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a variant de punt d’accés d’obra</rdfs:label>
        <rdfs:label xml:lang="ar">له نقطة وصول متغيرة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的变异检索点</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, belirli bir kelime kodlama şemasında tercih için seçilmemiş bir eser erişim noktası olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un punto d’accesso per l’opera che non è selezionato come preferito in uno specifico schema di codifica di vocabolario.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, egy olyan hozzáférési ponthoz mű számára, amelyet egy adott szótárkódolási sémában nem részesítenek előnyben.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, joka on teoksen hakutieto, jota ei ole valittu ensisijaiseksi tietyssä sanaston merkintäjärjestelmässä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est un point d’accès d’une œuvre ne faisant pas l’objet d’un choix privilégié dans un schéma d’encodage de vocabulaire spécifique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és un punt d’accés d’obra que no se selecciona com a preferent en un esquema de codificació de vocabulari específic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es un punto de acceso a la obra que no está seleccionado de preferencia en un esquema de codificación de vocabulario específico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat is een ingang voor werk die niet bij voorkeur geselecteerd is in een specifiek vocabulair coderingssysteem.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en søkeinngang for verk som ikke er valgt som preferanse i et bestemt kodeskjema for vokabular.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en søgeindgang for værk, som ikke er valgt som præference i et specifikt vokabularkodningsskema.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is an access point of work that is not selected for preference in a specific vocabulary encoding scheme.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir piekļuves punkts darbam, kas nav izvēlēts kā prioritārs noteiktai kontrolētas vārdnīcas shēmai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose otsielemendiga, mis ei ole valitud eelistatuks vastavas leksikaalses märkimissüsteemis.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Sucheinstieg für ein Werk, der in einem bestimmten Vocabulary Encoding Scheme nicht als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية عبارة عن نقطة وصول لعمل لم يتم اختيارها بتفضيل استخدامها في خطة ترميز مفردات معينة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一种作品的检索点、并没有在一个特定的词表编码体系中被首选的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10338 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10338">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af agent</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av agent</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de agente</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’un agent</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts aģentam</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van actor</rdfs:label>
        <rdfs:label xml:lang="en">is description of agent</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Akteur)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud tegija</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus toimijasta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő ágensnek:</rdfs:label>
        <rdfs:label xml:lang="tr">temsilcinin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di agente</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’un agent</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لهيئة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是行为者的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserle tanımlanan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente che è descritto da un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est décrit par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és descrit per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente que es descrito por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas aprakstīts darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, keda on teoses kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل موصوف في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10339 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10339">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="da">er beskrivelse af kollektiv agent</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av kollektiv agent</rdfs:label>
        <rdfs:label xml:lang="es">es descripción de agente colectivo</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’un agent collectif</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts grupai</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van collectieve actor</rdfs:label>
        <rdfs:label xml:lang="en">is description of collective agent</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud kollektiiv</rdfs:label>
        <rdfs:label xml:lang="tr">kolektif temsilcinin tanımıdır</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus yhteistoimijasta</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő kollektív ágensnek:</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di agente collettivo</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’un agent col·lectiu</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لوكيل جماعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是集体行为者的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eseriyle tanımlanan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un agente collettivo che è descritto da un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est décrit par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és descrit per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es descrito por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som beskrives av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, keda on teoses kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي موصوف في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个集体行为者行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10347 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10347">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour format d’image d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression kuvasuhde</rdfs:label>
        <rdfs:label xml:lang="it">ha come rapporto d&apos;aspetto di espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="no">har bildesideforhold for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="da">har dimensionsforhold for repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="en">has aspect ratio of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Bildformat einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aspectratio van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse kuvasuhe</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma képmérataránya a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes attēla proporcija</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatımın en boy oranı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene relación de aspecto de expresión representativa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a relació d’aspecte d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له نسبة باعية لتعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的宽高比</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, hareketli bir görüntü eserinin temsili bir anlatımının genişliğinin yüksekliğine sayısal oranıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un rapporto tra l’ampiezza e l’altezza di una espressione rappresentativa di un’opera immagine in movimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy arányszámhoz, amely egy mozgóképmű reprezentatív kifejezési formájának szélességét viszonyítja annak magasságához.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen liikkuvan kuvan teoksen edustavan ekspression leveyden ja korkeuden väliseen numeeriseen suhteeseen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un rapport numérique entre la largeur et la hauteur d’une expression représentative d’une œuvre d’images animées.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una relació numèrica entre l’amplada i l’altura d’una expressió representativa d’una obra d’imatge en moviment.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una relación numérica entre el ancho y el alto de una expresión representativa de una obra de imagen en movimiento.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een numerieke verhouding van de breedte tot de hoogte van een representatieve expressie van een speelfilmwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et tallmessig forhold mellom bredden og høyden til et representativt uttrykk av et verk bestående av levende bilder.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et numerisk forhold mellem bredden og højden af et repræsentativt udtryk af et levende billedeværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a numerical ratio of the width to the height of a representative expression of a moving image work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar kustīgā attēla reprezentatīvās izteiksmes platuma un augstuma skaitlisko attiecību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose liikuvast pildist koosneva teose iseloomuliku väljenduse laiuse ja kõrguse arvulise suhtega.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Zahlenverhältnis von Breite zu Höhe einer repräsentativen Expression eines Bewegtbildwerks.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل والنسبة العددية لعرض تعبيرة ممثِلة لعمل صورة متحركة إلى ارتفاعها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种动态图像作品的一种代表性内容表达的宽度和高度的数字比关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10349 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10349">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour type de contenu d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression sisältötyyppi</rdfs:label>
        <rdfs:label xml:lang="it">ha come tipo di contenuto di espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="da">har indholdstype for repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="no">har innholdstype for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="en">has content type of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Inhaltstyp einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft contenttype van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse sisu tüüp</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma tartalomtípusa a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes satura veids</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatımın içerik türü ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene tipo de contenido de expresión representativa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a tipus de contingut d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له نوع محتوى لتعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的内容类型</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, içeriğin ifade edildiği temel iletişim biçimini ve algılanmasını amaçlayan insan duyusunu yansıtan temsili bir anlatımın sınıflandırılmasıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una categorizzazione dell’espressione rappresentativa che riflette la forma di comunicazione fondamentale in cui si esprime il contenuto e il senso che permette di percepirlo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy reprezentatív kifejezési forma kategorizálásához, amely tükrözi a kommunikáció azon alapvető formáját, melyen a tartalom kifejezésre kerül, és amelyet emberi érzékszerven keresztüli érzékelésére szántak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen edustavan ekspression jaotteluun, joka ilmaisee sisällön esitysmuodon ja sen, minkä aistin välityksellä sisältö on tarkoitus vastaanottaa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une catégorisation d’une expression représentative qui reflète la forme fondamentale de communication sous laquelle le contenu est exprimé et le sens humain par lequel il est destiné à être perçu.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una categorització d’una expressió representativa que reflecteix la forma fonamental de comunicació en què s’expressa el contingut i el sentit humà per mitjà del qual s’ha de percebre.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una categorización de una expresión representativa que refleja la forma fundamental de comunicación en la que se expresa el contenido y el sentido humano a través del cual se pretende percibirlo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een categorisatie van een representatieve expressie die de fundamentele vorm van communicatie weergeeft waarin de content uitgedrukt is en het menselijk zintuig waarmee het bedoeld is waargenomen te worden.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en katagorisering av et representativt uttrykk som gjenspeiler den opprinnelige kommunikasjonsformen som innholdet er uttrykt i, og den menneskelige sansen som det er ment å oppfattes gjennom.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kategorisering af et repræsentativt udtryk, som afspejler den grundlæggende kommunikationsform, som indholdet er udtrykt i, og den menneskelige sans, gennem hvilken det er tiltænkt til at blive opfattet.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a categorization of a representative expression that reflects the fundamental form of communication in which the content is expressed and the human sense through which it is intended to be perceived.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar reprezentatīvās izteiksmes kategorizāciju, kas atspoguļo būtisko saziņas pamatformu, kurā saturs tiek izteikts ar to, kā cilvēks to uztver un saprot (maņas).</skos:definition>
        <skos:definition xml:lang="et">Seostab teose iseloomuliku väljenduse kategooriaga, mis kajastab kommunikatsiooni põhivormi, milles sisu on väljendatud, ja inimmeelt, mille kaudu seda tajutakse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Kategorisierung einer repräsentativen Expression, die zum einen die grundlegende Form der Kommunikation widerspiegelt, in der der Inhalt ausgedrückt wird, und zum andern die menschliche Wahrnehmung wiedergibt, durch die diese wahrgenommen werden soll.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتصنيف لتعبيرة ممثِلة يعكس الشكل الأساسي للتواصل، الذي يتم فيه التعبير عن المحتوى، والحس الإنساني، الذي يُقصد تصوره من خلاله.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与反映一个内容被表达所用通讯的基本形式和设计被感知的人类感觉的代表性内容表达的分类关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10350 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10350">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour date de captation d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression tallennusajankohta</rdfs:label>
        <rdfs:label xml:lang="it">ha come data di cattura di espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="da">har dato for indspilning af repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="no">har tidspunkt for opptak for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="en">has date of capture of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Aufzeichnungsdatum einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft datum van vastleggen van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse jäädvustamise daatum</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma rögzítési dátuma a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes tveršanas datējums</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatım kayıt tarihi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene fecha de captura de expresión representativa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a data de captura d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له تاريخ التقاط لتعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的摄录日期</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, temsili bir anlatımın içeriği olan kayıt, filme alma vb. ile bağlantılı olan bir zaman aralığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un intervallo di date associate alla registrazione, ripresa, etc. del contenuto di un’espressione rappresentativa.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy időtartamhoz, amely egy reprezentatív kifejezési forma tartalmának rögzítéséhez, filmezéséhez, stb. kapcsolódik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen ajanjaksoon, joka liittyy edustavan ekspression sisällön äänitykseen, filmaukseen tms.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un laps de temps qui est associé à l’enregistrement, au tournage, etc. du contenu d’une expression représentative.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un interval de temps que s’associa amb l’enregistrament, la filmació, etc. del contingut d’una expressió representativa.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lapso de tiempo que se asocia a la grabación, filmación, etc., el contenido de una expresión representativa.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een tijdspanne die geassocieerd is met het opnemen, filmen etc. van de content van een representatieve expressie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et tidsrom som forbindes med innspilling, opptak, etc. av innholdet i et representativt uttrykk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en tidsperiode, som er knyttet til indspilning, filmoptagelse, etc., af et repræsentativt udtryks indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a timespan that is associated with recording, filming, etc., the content of a representative expression.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar laikposmu, kas saistīts ar reprezentatīvās izteiksmes satura ierakstīšanu, filmēšanu u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose ajavahemikuga, mis on seotud iseloomuliku väljenduse sisu salvestamise, filmimise vms jäädvustamisega.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Zeitraum, der mit der Aufnahme, dem Filmen und so weiter des Inhalts einer Expression in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وفترة زمنية مرتبطة بتسجيل محتوى تعبيرة ممثِلة، أو تصويره، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与和一种代表性内容表达的内容的录制、摄制等有关的一个时间段关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10351 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10351">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour durée d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression kesto</rdfs:label>
        <rdfs:label xml:lang="it">ha come durata di espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="da">har spilletid af repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="no">har varighet for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="en">has duration of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Dauer einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft duur van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse kestus</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma időterjedelme a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes ilgums</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatım süresi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene duración de expresión representativa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a durada d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له مدة لتعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的持续时间</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir çalma süresi, performans süresi, çalışma süresi veya başka bir süre uzunluğu olan bir eserin temsili anlatımının kapsamıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’estensione dell’espressione di un’espressione rappresentativa cioè una durata di riproduzione, di esecuzione, attivazione o altro intervallo di tempo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy mű reprezentatív kifejezési formája kifejezési formájának terjedelméhez, amely játékidő, előadás ideje, futási idő vagy egyéb időtartomány.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teoksen edustavan ekspression ekspression laajuuteen, joka on soittoaika, esitysaika, toistoaika tai muu ajan pituus.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une étendue d’une expression d’une expression représentative d’une œuvre qui consiste en une durée de lecture, d’exécution, de projection ou en une autre période de temps.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una extensió d’expressió d’una expressió representativa d’una obra que és un temps de reproducció, d’execució o de qualsevol altre longitud de temps.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un grado de expresión de una expresión representativa de una obra que es un tiempo de reproducción, tiempo de interpretación, tiempo de ejecución u otro período de tiempo.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een omvang van expressie van een representatieve expressie van een werk dat een speeltijd, opvoeringstijd, looptijd of andere tijdsduur.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et omfang for uttrykk av et representativt uttrykk av et verk som er spilletid, framføringstid, avspillingstid eller et annet tidsrom.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til omfanget af et værks repræsentative udtryk, som er en varighed, opførelsestid, spilletid etc. eller anden tidsperiode.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an extent of expression of a representative expression of a work that is a playing time, performance time, running time, or other length of time.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar reprezentatīvās izteiksmes satura atskaņošanas ilgumu, izpildes laiku, darbības laiku, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose iseloomuliku väljenduse mahuga, milleks on mängimisaeg, esituse aeg, töötamisaeg või muu ajavahemik.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Umfang einer repräsentativen Expression eines Werks, bei dem es sich um eine Wiedergabezeit, eine Aufführungszeit, eine Laufzeit oder eine andere Zeitspanne handelt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ومدى تعبير تعبيرة ممثِلة لعمل عبارة عن وقت تشغيل، أو وقت أداء، أو مدة عرض، أو مدة زمنية أخرى.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为播放时间、表演时间、运行时间或其他时间长度的一种代表性内容表达的表现的数量关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10352 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10352">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour étendue d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression laajuus</rdfs:label>
        <rdfs:label xml:lang="it">ha come estensione dell&apos;espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="da">har omfang af repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="no">har omfang for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="en">has extent of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Umfang einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft omvang van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse maht</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma terjedelme a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes apjoms</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatım kapsamı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene grado de expresión representativa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a extensió d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له مدى تعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的数量</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin temsili bir anlatımının kapsamının bir yönünü ölçen bir tür, sayı ve ölçü birimiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un tipo, numero e unità di misura che quantificano un aspetto dell’estensione di un’espressione rappresentativa di un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy típushoz, számhoz és mértékegységhez, amely egy mű reprezentatív kifejezési formája terjedelmének számszerű aspektusa.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen tyyppiin, lukuun ja mittayksikköön, joka ilmaisee teoksen edustavan ekspression laajuutta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un type, un nombre et une unité de mesure qui quantifient un aspect de l’étendue d’une expression représentative d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un tipus, número i unitat de mesura que quantifica un aspecte de l’extensió d’una expressió representativa d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un tipo, número y unidad de medida que cuantifican un aspecto del alcance de una expresión representativa de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een soort, nummer en meeteenheid die een aspect kwantificeren van de omvang van een representatieve expressie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en type, nummerering og måleenhet som kvantifiserer et aspekt av omfanget for et representativt uttrykk av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en type, et tal og en måleenhed, som kvantificerer et aspekt af omfanget af et værks repræsentative udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a type, number, and measurement unit that quantify an aspect of the extent of a representative expression of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar mērvienību, daudzumu un izmēru, kas nosaka darba raksturīgās izteiksmes apjomu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tüübi, arvu ja mõõtühikuga, mis näitavad kvantitatiivselt teose iseloomuliku väljenduse mahu tunnuseid.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Art, Nummer oder Maßeinheit, die eine Eigenschaft des Umfangs einer repräsentativen Expression eines Werks beziffert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ونوع، ورقم، ووحدة قياس تحدد جانبًا من مدى تعبيرة ممثِلة لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与把一种作品的一种代表性内容表达的一个数量方面定量化的一个类型、数字和计量单位关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10353 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10353">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour langue d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression kieli</rdfs:label>
        <rdfs:label xml:lang="it">ha come lingua dell&apos;espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="da">har sprog for repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="no">har språk for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="en">has language of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Sprache einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft taal van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse keel</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma nyelve a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes valoda</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatımın dili ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene un lenguaje de expresión representativo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a llengua d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له لغة تعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的语言</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eserin temsili bir anlatımının içeriği için kullanılan bir dille ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a una lingua usata per il contenuto di un’espressione rappresentativa di un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nyelvhez, amelyet egy mű reprezentatív kifejezési formájának tartalmához használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teoksen edustavan ekspression sisällössä käytettyyn kieleen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une langue utilisée pour le contenu d’une expression représentative d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una llengua usada en el contingut d’una expressió representativa d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un lenguaje utilizado para el contenido de una expresión representativa de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een taal gebruikt voor de content van een representatieve expressie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til et språk som er brukt for innholdet av et representativt uttrykk av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til et sprog, som er brugt til et værks repræsentative udtryks indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a language used for the content of a representative expression of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar valodu, kas izmantota darba reprezentatīvas izteiksmes saturā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose keelega, mida on kasutatud teose iseloomuliku väljenduse sisus.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Sprache, die für den Inhalt einer repräsentativen Expression eines Werks verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ولغة مستخدمة لمحتوى تعبيرة ممثِلة لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与一种作品的代表性内容表达的内容所用的语言关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10355 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10355">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour projection d’un contenu cartographique d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression kartografisen sisällön projektio</rdfs:label>
        <rdfs:label xml:lang="it">ha come proiezione di contenuto cartografico dell&apos;espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="no">har kartprojeksjon for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="da">har projicering af kartografisk indhold af repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="en">has projection of cartographic content of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Projektion von kartografischem Inhalt einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft projectie van cartografische content van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse kartograafilise sisu projektsioon</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma vetített kartográfiai tartalma a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes projekcija (kartogrāfijā)</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatımın kartografik içeriğinin projeksiyonu ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene proyección de contenido cartográfico de expresión representativa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a projecció de contingut cartogràfic d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له إسقاط لمحتوى خرائطي لتعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的地图内容的投影</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin temsili ifadesinde, yeryüzünün veya bir göksel kürenin yüzeyini bir düzlem üzerinde temsil etmek için kullanılan bir yöntem veya sistemle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un metodo o sistema utilizzato per rappresentare la superficie della Terra o di una sfera celeste su un piano in un’espressione rappresentativa di un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy olyan módszerhez vagy rendszerhez, amelyet egy mű kifejezési formájában a Föld vagy egy égitest felszínének síkbeli ábrázolására használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen menetelmään tai järjestelmään, jota käytetään esittämään maapallon tai taivaanpallon pintaa kaksiulotteisesti teoksen edustavassa ekspressiossa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une méthode ou un système utilisé pour représenter la surface de la Terre ou d’une sphère céleste sur un plan dans une expression représentative d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un mètode o sistema usat per representar la superfície de la terra o d’una esfera celeste sobre un pla en una expressió representativa d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un método o sistema utilizado para representar la superficie de la tierra o de una esfera celeste sobre un plano en una expresión representativa de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een methode of systeem gebruikt om het oppervlak van de aarde of een hemelbol voor te stellen op een vlak in een representatieve expressie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en metode eller et system som brukes for å gjengi overflaten til jorden eller et annet kuleformet himmellegeme på en flat overflate i et representativt uttrykk av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en metode eller system, som anvendes til at repræsentere jordens overflade eller overfladen på et himmellegeme på et kort i et værks repræsentative udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a method or system used to represent the surface of the earth or of a celestial sphere on a plane in a representative expression of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar metodi vai sistēmu, ko izmanto zemes vai debess sfēras virsmas attēlošanai plaknē, reprezentatīvā darba izteiksmē.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose meetodi või süsteemiga, mida teose iseloomulikus väljenduses on kasutatud Maa pinna või taevasfääri tasapinnaliseks kujutamiseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt eine Expression in Beziehung zu einer Methode oder ein System, die/das angewendet wird, um in einer repräsentativen Expression eines Werks die Oberfläche der Erde oder einer Himmelskugel auf einer Ebene zu repräsentieren.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وطريقة أو نظام مستخدم لتمثيل سطح الأرض أو الكرة السماوية على مسطح في تعبيرة ممثِلة لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与用于在一种作品的一种代表性内容表达中一个平面上表示地球或天球表面的方法或系统关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10359 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10359">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">RDA varlığının eleştirisidir</rdfs:label>
        <rdfs:label xml:lang="et">arvustatud RDA olem</rdfs:label>
        <rdfs:label xml:lang="hu">bírálata a következő RDA-entitásnak:</rdfs:label>
        <rdfs:label xml:lang="da">er kritik af RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="no">er kritikk av RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="es">es crítica a la entidad RDA</rdfs:label>
        <rdfs:label xml:lang="fr">est une critique d’une entité RDA</rdfs:label>
        <rdfs:label xml:lang="lv">ir kritika RDA entītei</rdfs:label>
        <rdfs:label xml:lang="en">is critique of RDA entity</rdfs:label>
        <rdfs:label xml:lang="nl">is kritiek van RDA-entiteit</rdfs:label>
        <rdfs:label xml:lang="de">ist Kritik von (RDA-Entität)</rdfs:label>
        <rdfs:label xml:lang="fi">kritiikki RDA-entiteetistä</rdfs:label>
        <rdfs:label xml:lang="it">è critica di entità RDA</rdfs:label>
        <rdfs:label xml:lang="ca">és crítica d’una entitat RDA</rdfs:label>
        <rdfs:label xml:lang="ar">هو نقد لكيان &quot;وام&quot;</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是RDA实体的批评</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından eleştirel olarak değerlendirilen bir RDA varlığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’entità RDA utilizzata come base per una valutazione critica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy RDA-entitáshoz, amelyet egy kritikai kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen RDA-entiteettiin, johon kriittinen arviointi perustuu.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une entité RDA qui fait l’objet d’une évaluation critique par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat RDA que és avaluada críticament per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una entidad RDA que es evaluada críticamente por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een RDA-entiteit die kritisch beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en RDA-entitet brukt som utgangspunkt for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en RDA-entitet, som anvendes som grundlag for en kritisk evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an RDA entity that is critically evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar RDA entīti, kura tikusi kritiski novērtēta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose RDA olemiga, mis on aluseks kriitilisele hinnangule.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer RDA-Entität, die als Grundlage für eine kritische Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وكيان &quot;وام&quot; مستخدم كأساس لتقييم نقدي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品批评性评价的一个RDA实体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10360 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10360">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">RDA varlığının tanımıdır</rdfs:label>
        <rdfs:label xml:lang="da">er beskrivelse af RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="no">er beskrivelse av RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="es">es la descripción de la entidad RDA</rdfs:label>
        <rdfs:label xml:lang="fr">est une description d’une entité RDA</rdfs:label>
        <rdfs:label xml:lang="lv">ir apraksts RDA entītei</rdfs:label>
        <rdfs:label xml:lang="nl">is beschrijving van RDA-entiteit</rdfs:label>
        <rdfs:label xml:lang="en">is description of RDA entity</rdfs:label>
        <rdfs:label xml:lang="de">ist Beschreibung von (RDA-Entität)</rdfs:label>
        <rdfs:label xml:lang="et">kirjeldatud RDA olem</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaus RDA-entiteetistä</rdfs:label>
        <rdfs:label xml:lang="hu">leírása a következő RDA-entitásnak:</rdfs:label>
        <rdfs:label xml:lang="it">è descrizione di entità RDA</rdfs:label>
        <rdfs:label xml:lang="ca">és descripció d’una entitat RDA</rdfs:label>
        <rdfs:label xml:lang="ar">هو وصف لكيان &quot;وام&quot;</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是RDA实体的描述</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından tanımlanan bir RDA varlığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’entità RDA che è descritta da un’opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy RDA-entitáshoz, amelyet egy mű leír.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen RDA-entiteettiin, jota teos kuvaa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une entité RDA qui est décrite par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat RDA que és descrita per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una entidad RDA que es descrita por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een RDA-entiteit die beschreven wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en RDA-entitet som er beskrevet av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en RDA-entitet, som er beskrevet af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an RDA entity that is described by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar RDA entīti, kas aprakstīta darbā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose RDA olemiga, mida teoses on kirjeldatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer RDA-Entität, die von einem Werk beschrieben wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وكيان &quot;وام&quot; موصوف في عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品描述的一个RDA实体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10361 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10361">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">RDA varlığının değerlendirmesidir</rdfs:label>
        <rdfs:label xml:lang="fi">arviointi RDA-entiteetistä</rdfs:label>
        <rdfs:label xml:lang="da">er evaluering af RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="no">er evaluering av RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="es">es la evaluación de la entidad RDA</rdfs:label>
        <rdfs:label xml:lang="fr">est une évaluation d’une entité RDA</rdfs:label>
        <rdfs:label xml:lang="et">hinnang RDA olemile</rdfs:label>
        <rdfs:label xml:lang="lv">ir novērtējums RDA entītei</rdfs:label>
        <rdfs:label xml:lang="nl">is beschouwing van RDA-entiteit</rdfs:label>
        <rdfs:label xml:lang="en">is evaluation of RDA entity</rdfs:label>
        <rdfs:label xml:lang="de">ist Evaluierung von (RDA-Entität)</rdfs:label>
        <rdfs:label xml:lang="it">è valutazione di entità RDA</rdfs:label>
        <rdfs:label xml:lang="hu">értékelése a következő RDA-entitásnak:</rdfs:label>
        <rdfs:label xml:lang="ca">és avaluació d’una entitat RDA</rdfs:label>
        <rdfs:label xml:lang="ar">هو تقييم لكيان &quot;وام&quot;</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是RDA实体的评价</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından incelenen veya yargılanan bir RDA varlığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’entità RDA che è esaminata o valutata.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy RDA-entitáshoz, amelyet elemeznek és megítélnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen RDA-entiteettiin, jota on tutkittu tai arvioitu.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une entité RDA qui est examinée ou jugée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat RDA que és examinada o jutjada per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una entidad RDA que es examinada o juzgada por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een RDA-entiteit die onderzocht of beoordeeld wordt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en RDA-entitet som er utforsket eller vurdert.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en RDA-entitet, som er undersøgt eller bedømt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an RDA entity that is examined or judged by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar RDA entīti, kas tiek pārbaudīta vai vērtēta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose RDA olemiga, mida on kontrollitud või hinnatud.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer RDA-Entität, die untersucht oder beurteilt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وكيان &quot;وام&quot; الذي يتم فحصه أو الحكم عليه.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品检查或评判的一种RDA实体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10362 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10362">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="tr">RDA varlığının incelemesidir</rdfs:label>
        <rdfs:label xml:lang="fi">arvostelu RDA-entiteetistä</rdfs:label>
        <rdfs:label xml:lang="da">er anmeldelse af RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="no">er anmeldelse av RDA-entitet</rdfs:label>
        <rdfs:label xml:lang="es">es revisión de la entidad RDA</rdfs:label>
        <rdfs:label xml:lang="fr">est une recension d’une entité RDA</rdfs:label>
        <rdfs:label xml:lang="lv">ir recenzija RDA entītei</rdfs:label>
        <rdfs:label xml:lang="nl">is recensie van RDA-entiteit</rdfs:label>
        <rdfs:label xml:lang="en">is review of RDA entity</rdfs:label>
        <rdfs:label xml:lang="de">ist Rezension von (RDA-Entität)</rdfs:label>
        <rdfs:label xml:lang="hu">szemlézi a következő RDA-entitást</rdfs:label>
        <rdfs:label xml:lang="it">è recensione di entità RDA</rdfs:label>
        <rdfs:label xml:lang="ca">és revisió d’una entitat RDA</rdfs:label>
        <rdfs:label xml:lang="et">ülevaade RDA olemist</rdfs:label>
        <rdfs:label xml:lang="ar">هو مراجعة لكيان &quot;وام&quot;</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">是RDA实体的评论</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser tarafından kısaca değerlendirilen bir RDA varlığıyla ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un’entità RDA utilizzata come base per una breve valutazione.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy RDA-entitáshoz, amelyet egy rövid kiértékelés alapjaként használnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen lyhyen arvioinnin perustana käytettyyn RDA-entiteettiin.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une entité RDA qui est brièvement évaluée par une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat RDA que és avaluada breument per una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una entidad RDA que es evaluada brevemente por una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een RDA-entiteit die kort beschouwd wordt door een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en RDA-entitet brukt som utgangspunkt for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en RDA-entitet, som anvendes som grundlag for en kortfattet evaluering.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an RDA entity that is briefly evaluated by a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar RDA entīti, kas izmantota par pamatu īsam novērtējumam.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose RDA olemiga, mis on lühihinnangu aluseks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer RDA-Entität, die als Grundlage für eine kurze Untersuchung verwendet wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وكيان &quot;وام&quot; مستخدم كأساس لتقييم موجز.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与被一种作品简要评价的一个RDA实体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10367 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10367">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour titre-clé</rdfs:label>
        <rdfs:label xml:lang="tr">ana başlık ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">atslēgnosaukums</rdfs:label>
        <rdfs:label xml:lang="fi">avainnimeke</rdfs:label>
        <rdfs:label xml:lang="it">ha come titolo chiave</rdfs:label>
        <rdfs:label xml:lang="da">har nøgletitel</rdfs:label>
        <rdfs:label xml:lang="no">har nøkkeltittel</rdfs:label>
        <rdfs:label xml:lang="en">has key title</rdfs:label>
        <rdfs:label xml:lang="de">hat Key Title</rdfs:label>
        <rdfs:label xml:lang="nl">heeft key title</rdfs:label>
        <rdfs:label xml:lang="hu">kulcscíme a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene título clave</rdfs:label>
        <rdfs:label xml:lang="ca">té com a títol clau</rdfs:label>
        <rdfs:label xml:lang="et">võtmepealkiri</rdfs:label>
        <rdfs:label xml:lang="ar">له عنوان مفتاحي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有识别题名</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ISSN kayıt kuruluşu tarafından atanan bir eser başlığı olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un’opera a un titolo dell&apos;opera che è assegnato da un’agenzia di registrazione ISSN.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, egy olyan műcímhez, amelyet egy ISSN regisztrációs ügynökség jegyez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen nomeniin, joka on teoksen nimeke, jonka on antanut ISSN-rekisteröintitoimisto.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est un titre d’œuvre attribué par une agence d’enregistrement de l’ISSN.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és un títol d’obra que és assignat per una agència de registre de l’ISSN.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es un título de obra que es asignado por una agencia de registro de ISSN.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat is een titel van een werk dat toegekend is door een ISSN-registratiebureau.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en tittel for verk som er tildelt av et ISSN-kontor.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en titel på værk, som er tildelt af et ISSN-kontor.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is a title of work that is assigned by an ISSN registration agency.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir unikāls nosaukums, ko resursam piešķīrusi starptautiskā ISSN aģentūra.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose pealkirjaga, mille on määranud ISSN registreerimise agentuur.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Titel eines Werks, der durch eine ISSN-Registrierungsstelle zugewiesen wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية عبارة عن عنوان عمل خصصته وكالة تسجيل ردمد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为被国际标准连续出版物号一个注册机构分配之作品的一个题名的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10393 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10393">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent agrégateur</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattori (toimija)</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátor ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopotājs (aģents)</rdfs:label>
        <rdfs:label xml:lang="it">ha come aggregatore agente</rdfs:label>
        <rdfs:label xml:lang="da">har agent, som er samler</rdfs:label>
        <rdfs:label xml:lang="no">har aggregator (agent)</rdfs:label>
        <rdfs:label xml:lang="en">has aggregator agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Aggregatorin/Aggregator (Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aggregator-actor</rdfs:label>
        <rdfs:label xml:lang="et">liitja (tegija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente agregador</rdfs:label>
        <rdfs:label xml:lang="tr">toplayıcı temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent agregador</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل مجمع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集编者行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, diğer eserlerin anlatımlarını seçerek ve düzenleyerek toplu bir eser yapmaktan sorumlu olan bir temsilciyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente responsabile della creazione di un&apos;opera aggregata attraverso la selezione e l&apos;organizzazione di espressioni di altre opere.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy ágenshez, amely felelős egy aggregáló mű létrehozásáért, más művek kifejezési formáinak kiválasztása és elrendezése révén.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen toimijaan, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent qui est responsable de la création d’une œuvre agrégatrice par la sélection et l’arrangement d’expressions d’autres œuvres.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és responsable de la creació d’una obra agregadora mitjançant la selecció i l’arranjament d’expressions d’altres obres.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente quees responsable de crear una obra agregada seleccionando y ordenando expresiones de otras obras.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een aggregaatwerk door middel van selectie en arrangeren van expressies van andere werken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en agent som er ansvarlig for å skape et aggregerende verk ved å velge ut og arrangere uttrykk av andre verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en agent, som er ansvarlig for at skabe et aggregerende værk ved at udvælge og arrangere udtryk af andre værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to an agent who is responsible for creating an aggregating work by selecting and arranging expressions of other works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar aģentu, kas ir atbildīgs par darba-apkopojumu radīšanu, atlasot un sakārtojot citu darbu izteiksmes.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose tegijaga, kes vastutab liitva teose loomise eest, valides ja korrastades teiste teoste väljendused.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Akteur, der für die Erstellung eines aggregierenden Werks verantwortlich ist, indem er Expressionen von anderen Werken auswählt und zusammenstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل مسئول عن إنشاء عمل مجمع عن طريق اختيار تعبيرات أعمال أخرى وترتيبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责把其他作品的内容表达选择和整理后创建一种合集性作品的一个行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10394 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10394">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité défenderesse criminelle</rdfs:label>
        <rdfs:label xml:lang="lv">atbildētājs kriminālprocesā (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">bűnvádi eljárás alperes testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come imputato penale ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er sagsøgt</rdfs:label>
        <rdfs:label xml:lang="no">har strafferettslig saksøkt korporasjon</rdfs:label>
        <rdfs:label xml:lang="en">has criminal defendant corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Angeklagte/Angeklagten in einem Strafverfahren (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft criminele verdachte-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">sanık tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">süüdistatav (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo demandado penalmente</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa acusada penal</rdfs:label>
        <rdfs:label xml:lang="fi">yhteisövastaaja rikosoikeudessa</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة جنائية مدعى عليها</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有刑事被告团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ceza davasında suçlanan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente accusato in un procedimento penale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amelyet egy büntetőeljárásban vádolnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on syytettynä rikosprosessissa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est accusée dans une poursuite criminelle.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és acusada en un procés penal.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que está imputado en un proceso penal.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die is beschuldigd in een strafproces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å være saksøkt i en straffesak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at blive anklaget i en straffesag.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is accused in a criminal proceeding.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, pret kuru celta prasība kriminālprocesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kelle vastu on esitatud süüdistus kriminaalkohtumenetluses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die in einem Strafverfahren angeklagt ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة موجَه إليها اتهام في دعوى جنائية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在一项刑事诉讼中被指控的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10396 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10396">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne défenderesse criminelle</rdfs:label>
        <rdfs:label xml:lang="lv">atbildētājs kriminālprocesā (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">bűnvádi eljárás alperes személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come imputato persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er sagsøgt</rdfs:label>
        <rdfs:label xml:lang="no">har strafferettslig saksøkt person</rdfs:label>
        <rdfs:label xml:lang="en">has criminal defendant person</rdfs:label>
        <rdfs:label xml:lang="de">hat Angeklagte/Angeklagten in einem Strafverfahren (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft criminele verdachte-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">henkilövastaaja rikosoikeudessa</rdfs:label>
        <rdfs:label xml:lang="tr">sanık kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">süüdistatav (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona criminal acusada</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona acusada penal</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مدعى عليه جنائيا</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有刑事被告个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ceza davasında suçlanan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona accusata in un procedimento penale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, akit egy büntetőeljárásban vádolnak.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on syytettynä rikosprosessissa.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est accusée dans une poursuite criminelle.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és acusada en un procés penal.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que está imputada en un proceso penal.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die beschuldigd is in een strafproces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er saksøkt i en straffesak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at blive anklaget i en straffesag.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is accused in a criminal proceeding.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir apsūdzēta kriminālprocesā.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kelle vastu on esitatud süüdistus kriminaalkohtumenetluses.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die in einem Strafverfahren angeklagt ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص متهم في دعوى جنائية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与在一项刑事诉讼中被指控的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10398 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10398">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour date d’une expression représentative</rdfs:label>
        <rdfs:label xml:lang="fi">edustavan ekspression ajankohta</rdfs:label>
        <rdfs:label xml:lang="it">ha come data di espressione rappresentativa</rdfs:label>
        <rdfs:label xml:lang="no">har dato for representativt uttrykk</rdfs:label>
        <rdfs:label xml:lang="da">har dato for repræsentativt udtryk</rdfs:label>
        <rdfs:label xml:lang="en">has date of representative expression</rdfs:label>
        <rdfs:label xml:lang="de">hat Datum einer repräsentativen Expression</rdfs:label>
        <rdfs:label xml:lang="nl">heeft datum van representatieve expressie</rdfs:label>
        <rdfs:label xml:lang="et">iseloomuliku väljenduse daatum</rdfs:label>
        <rdfs:label xml:lang="hu">reprezentatív kifejezési forma dátuma a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">reprezentatīvās izteiksmes datējums</rdfs:label>
        <rdfs:label xml:lang="tr">temsili anlatım tarihi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene fecha de expresión representativa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a data d’una expressió representativa</rdfs:label>
        <rdfs:label xml:lang="ar">له تاريخ تعبيرة ممثِلة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有代表性内容表达的日期</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin temsili anlatımı ile bağlantılı olan en eski zaman aralığı ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a al primo arco di tempo associato a un&apos;espressione rappresentativa di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy legkorábbi időtartamhoz, amely egy mű reprezentatív kifejezési formájával társítható.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen varhaisimpaan teoksen edustavaan ekspressioon liittyvään ajanjaksoon.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un laps de temps qui est le plus ancien associé à une expression représentative d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un interval de temps que és el més antic associat amb una expressió representativa d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un período de tiempo que es el más antiguo asociado con una expresión representativa de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een tijdspanne die de vroegste datum geassocieerd met een representatieve expressie van een werk is.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til det tidligste tidsrommet som forbindes med et representativt uttrykk av et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en tidsperiode, som er den tidligste dato knyttet til et værks repræsentative udtryk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a timespan that is the earliest associated with a representative expression of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar laikposmu, kas saistīts ar agrāko darba reprezentatīvo izteiksmi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose varaseima ajavahemikuga, mis on seotud teose iseloomuliku väljendusega.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu dem frühesten Zeitraum, der mit einer repräsentativen Expression eines Werks in Verbindung steht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وفترة زمنية هي الفترة الأقدم المرتبطة بتعبيرة ممثِلة لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与和一种作品的代表性内容表达有关的最早的时间段关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10401 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10401">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour point d’accès autorisé d’un groupe d’œuvres</rdfs:label>
        <rdfs:label xml:lang="lv">autoritatīvā pamatforma darba grupai</rdfs:label>
        <rdfs:label xml:lang="tr">eser grubu için yetkili erişim noktası ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come punto d&apos;accesso autorizzato per gruppo di opere</rdfs:label>
        <rdfs:label xml:lang="da">har autoriseret søgeindgang for værkgruppe</rdfs:label>
        <rdfs:label xml:lang="no">har autorisert søkeinngang for verksgruppe</rdfs:label>
        <rdfs:label xml:lang="en">has authorized access point for work group</rdfs:label>
        <rdfs:label xml:lang="de">hat normierten Sucheinstieg für eine Werkgruppe</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geautoriseerde ingang voor werkgroep</rdfs:label>
        <rdfs:label xml:lang="hu">műcsoport autorizált hozzáférési pontja a következő:</rdfs:label>
        <rdfs:label xml:lang="et">teoserühma normitud otsielement</rdfs:label>
        <rdfs:label xml:lang="fi">teosryhmän auktorisoitu hakutieto</rdfs:label>
        <rdfs:label xml:lang="es">tiene punto de acceso autorizado para grupo de obras</rdfs:label>
        <rdfs:label xml:lang="ca">té com a punt d’accés autoritzat de grup d’obres</rdfs:label>
        <rdfs:label xml:lang="ar">له نقطة وصول مقننة لمجموعة عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品群的规范检索点</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser grupları için belirli bir kelime kodlama şemasında tercih için seçilen bir eserin erişim noktası olan bir isimle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un punto d&apos;accesso di opera, scelto come preferito nell&apos;ambito di uno specifico schema di codifica di vocabolario per gruppi di opere. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy nomenhez, amely egy olyan előnyben részesített hozzáférési pont a műhöz, amelyet egy adott szótárkódolási sémából választanak ki.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen teoksen nomeniin, joka on hakutieto, joka on valittu ensisijaiseksi tietyssä sanaston merkintäjärjestelmässä teosryhmille.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un nomen qui est un point d’accès autorisé d’une œuvre utilisé dans un schéma d’encodage de vocabulaire spécifique pour identifier un groupes d’œuvres.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un nomen que és un punt d’accés autoritzat d’obra que s’usa en un esquema de codificació de vocabulari específic per identificar un grup d’obres.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un nomen que es un punto de acceso autorizado para obra utilizado en un esquema de codificación de vocabulario específico para identificar un grupo de obras.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een nomen dat een voorkeursingang voor werk is gebruikt in een specifiek vocabulair coderingssysteem voor de identificatie van een werkgroep.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en søkeinngang for verk som er valgt som preferanse i et bestemt kodeskjema for vokabular for verksgrupper.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en søgeindgang for værk, som er valgt som præference i et specifikt vokabularkodningsskema for værkgrupper.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a nomen that is an authorized access point for work used in a specific vocabulary encoding scheme to identify a work group.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar nomenu, kas ir darbs, kuram ir darba pamatforma, kas izvēlēta no konkrētas vārdnīcas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose teose otsielemendiga, mis on valitud eelistatuks vastavas leksikaalses märkimissüsteemis teoserühmade jaoks.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem Sucheinstieg für ein Werk, der in einem bestimmten Vocabulary Encoding Scheme für Werkgruppen als Vorzugsform bestimmt wird.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وتسمية عبارة عن نقطة وصول لعمل تم اختيارها بتفضيل استخدامها في خطة ترميز مفردات معينة لمجموعات عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一种作品的检索点、并在一个特定的词表编码体系中被首选用于作品群的一个命名关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10407 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10407">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour superviseur académique</rdfs:label>
        <rdfs:label xml:lang="et">akadeemiline juhendaja</rdfs:label>
        <rdfs:label xml:lang="tr">akademik danışman ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">akadēmiskā darba vadītājs</rdfs:label>
        <rdfs:label xml:lang="fi">akateeminen ohjaaja</rdfs:label>
        <rdfs:label xml:lang="it">ha come supervisore accademico</rdfs:label>
        <rdfs:label xml:lang="no">har akademisk veileder</rdfs:label>
        <rdfs:label xml:lang="da">har akademisk vejleder</rdfs:label>
        <rdfs:label xml:lang="en">has academic supervisor</rdfs:label>
        <rdfs:label xml:lang="de">hat akademische Betreuerin/akademischen Betreuer</rdfs:label>
        <rdfs:label xml:lang="nl">heeft academische begeleider</rdfs:label>
        <rdfs:label xml:lang="es">tiene supervisor académico</rdfs:label>
        <rdfs:label xml:lang="hu">tudományos témavezetője a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a supervisor acadèmic</rdfs:label>
        <rdfs:label xml:lang="ar">له مشرف أكاديمي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有学术主管</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, tez, araştırma ve proje de dahil olmak üzere bir eser ile sonuçlanan her türlü akademik faaliyeti denetlemekle sorumlu olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della supervisione su attività accademiche di qualsiasi tipo che producono un&apos;opera, incluse tesi, ricerche e progetti.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős bármilyen tudományos tevékenység felügyeletéért, amelynek eredménye egy mű, beleértve szakdolgozatokat, kutatást és projekteket.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa kaikenlaisen akateemisen toiminnan valvonnasta, joka johtaa teokseen, mukaan lukien tutkielmat, tutkimukset ja projektit.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de superviser les activités universitaires de toute nature entraînant la création d’une œuvre, y compris les thèses, les travaux de recherche et les projets.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de supervisar l’activitat acadèmica de qualsevol classe que dona com a resultat una obra, incloses tesis, recerques i projectes.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de la supervisión de la actividad académica de cualquier tipo que dé como resultado una obra, incluidas tesis, investigaciones y proyectos.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het toezicht houden op academische activiteiten van elke soort die resulteert in een werk, inclusief dissertaties, onderzoek en projecten.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å føre tilsyn med all akademisk aktivitet som resulterer i et verk, inklusive avhandlinger, forskning og prosjekter.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at føre tilsyn med akademisk aktivitet af enhver art, som resulterer i et værk, herunder afhandlinger, forskning og projekter.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for overseeing academic activity of any kind that results in a work, including theses, research, and projects.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par jebkāda veida akadēmiskās darbības pārraudzību, ieskaitot promocijas darbus, pētījumus un projektus.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab teoses (sh väitekirjad, uurimused ja projektid) väljenduva ükskõik millist laadi akadeemilise tegevuse ülevaatamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die akademische Tätigkeiten jeglicher Art betreut, die zu einem Werk führen. Darunter fallen Hochschulschriften, Forschungen und Projekte.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن الإشراف على نشاط أكاديمي من أي نوع ينتج عنه عمل، بما في ذلك الأطروحات، والأبحاث، والمشروعات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责导致一种作品的各种学术活动（包括论文、研究和项目）之监督的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10415 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10415">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne directrice de la photographie</rdfs:label>
        <rdfs:label xml:lang="tr">görüntü yönetmeni kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore persona della fotografia</rdfs:label>
        <rdfs:label xml:lang="no">har filmfotograf (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er filmfotograf</rdfs:label>
        <rdfs:label xml:lang="en">has director person of photography</rdfs:label>
        <rdfs:label xml:lang="de">hat Kamerafrau/Kameramann (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cameraregisseur-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">kinooperators (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">operaator-lavastaja (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">operatőr személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona director de fotografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona directora de fotografia</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مدير تصوير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有摄影指导个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, elektronik olarak veya film ya da video stoğu üzerinde görüntü kaydeden ve genellikle ışıklandırmayı seçen ve düzenleyen kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona che cattura le immagini, sia elettronicamente che su film o su video, e che spesso sceglie e sistema le luci.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que captura imágenes, ya sea electrónicamente o en películas o videos, y a menudo selecciona y organiza la iluminación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som tar bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يلتقط الصور، إما إلكترونيًا أو على فيلم أو مقاطع فيديو، وغالبًا ما يختار الإضاءة وينسقها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A director of photography for a movie is also called a chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Al director de fotografía de una película también se le llama jefe de fotografía.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy film operatőrét vezető operatőrnek is nevezik.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Kamerafrau/Ein Kameramann für einen Film wird auch als &quot;Bildregisseurin/Bildregisseur&quot; bezeichnet.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Filmfotografen for en film kalles også sjefsfotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmfotografen på en film kaldes også for en cheffotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Kinooperatoru mēdz saukt arī par galveno operatoru.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un director de fotografia d’una pel·lícula també s’anomena primer operador.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un direttore della fotografia in un film è detto anche capo operatore.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">电影的摄影指导也称总摄影师</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10416 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10416">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne recherchiste</rdfs:label>
        <rdfs:label xml:lang="tr">araştırmacı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come ricercatore persona </rdfs:label>
        <rdfs:label xml:lang="no">har forsker (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er researcher</rdfs:label>
        <rdfs:label xml:lang="en">has researcher person</rdfs:label>
        <rdfs:label xml:lang="de">hat Forscherin/Forscher (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderzoeker-persoon</rdfs:label>
        <rdfs:label xml:lang="hu">kutató személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pētnieks (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona investigadora</rdfs:label>
        <rdfs:label xml:lang="fi">tutkija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona investigadora</rdfs:label>
        <rdfs:label xml:lang="et">uurija (isik)</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص باحث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有研究者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin oluşturulmasını desteklemek için araştırma yapan kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona che svolge ricerche a supporto della creazione di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki kutatást végez egy mű megalkotásának támogatására.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka tukee teoksen syntymistä tutkimuksellaan</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui effectue des recherches pour aider à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que fa recerca per donar suport a la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que realiza investigaciones en apoyo a la creación de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die onderzoek doet ter ondersteuning van de creatie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som forsker som bidrag til å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som udfører research til at understøtte skabelsen af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who does research in support of the creation of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura veikusi pētniecību darba radīšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes teeb teose loomise heaks uurimistööd.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die Forschung betreibt, um die Schaffung eines Werks zu unterstützen.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يجري بحوث لدعم إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与从事研究以支持一种作品的创作的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10417 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10417">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne directrice de publication</rdfs:label>
        <rdfs:label xml:lang="hu">főszerkesztő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">galvenais redaktors (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore editoriale persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er ansvarshavende redaktør</rdfs:label>
        <rdfs:label xml:lang="no">har redaksjonssjef (person)</rdfs:label>
        <rdfs:label xml:lang="en">has editorial director person</rdfs:label>
        <rdfs:label xml:lang="de">hat Chefredakteurin/Chefredakteur (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft hoofdredacteur-persoon</rdfs:label>
        <rdfs:label xml:lang="et">peatoimetaja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona directora editorial</rdfs:label>
        <rdfs:label xml:lang="fi">toimituspäällikkö (henkilö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona directora editorial</rdfs:label>
        <rdfs:label xml:lang="tr">yayın yönetmeni kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مدير تحرير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主编个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eserin yayın politikası ve içeriği için yasal veya fikri sorumluluğu olan ancak yaratıcı sorumluluğu olmayan kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona che ha la responsabilità legale o intellettuale, ma non quella creativa, per la politica editoriale e i contenuti di un’opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, akinek jogi vagy szellemi, de nem alkotói felelőssége van egy diakronikus mű szerkesztési politikájáért és tartalmáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui a la responsabilité légale ou intellectuelle, mais non la responsabilité créative, de la politique éditoriale et du contenu d’une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que té responsabilitat legal o intel·lectual, però no responsabilitat creativa, de la política editorial i el contingut d’una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que tiene responsabilidad legal o intelectual, pero no creativa, por la política editorial y el contenido de una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die wettelijke of intellectuele verantwoordelijkheid, maar niet creatieve verantwoordelijkheid heeft voor het redactioneel beleid en content van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som har juridisk eller intellektuelt ansvar, bortsett fra kreativt ansvar, for det redaksjonelle innholdet i et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er juridisk eller intellektuelt ansvarlig, men ikke skabelsesansvarlig, for et diakronisk værks redaktionelle linje og indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who has legal or intellectual responsibility, but not creative responsibility, for the editorial policy and content of a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kurai ir juridiska vai intelektuāla, bet ne radoša atbildība par diahroniskā darba izdošanas politiku un saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes juriidiliselt või intellektuaalselt, kuid mitte loominguliselt vastutab diakroonilise teose toimetamispõhimõtete ja sisu eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die die rechtliche oder intellektuelle, aber keine kreative, Verantwortung für die redaktionelle Vorgehensweise und den Inhalt eines diachronen Werks trägt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يتحمل مسئولية قانونية أو فكرية، ولكن لا يتحمل مسئولية إبداعية، عن السياسة التحريرية ومحتوى عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与有对一种历时作品的编辑政策和内容的法律或知识责任（但非创作责任）的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Bir eserin anlatımının gözden geçirilmesi, netleştirilmesi veya içeriğinin başka bir şekilde değiştirilmesi hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darbība neietver darba izteiksmes satura pārskatīšanu, precizēšanu vai cita veida izmaiņas u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen nicht Überarbeitungen, Erläuterungen oder andere inhaltliche Änderungen an einer Expression eines Werks.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu parandamist, täpsustamist ega muude muudatuste tegemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Herziening, toelichting of andere verandering van content van een expressie van een werk is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La révision, la clarification ou toute autre modification du contenu d’une expression d’une œuvre sont exclues.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele egy mű kifejezési formájának revíziója, áttekintése, vagy egyéb tartalmi változtatása.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Revision, clarification, or other change of content of an expression of a work is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revision, indholdspræcisering eller anden ændring af indholdet af et værks udtryk er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la revisión, aclaración u otro cambio de contenido de una expresión de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono esclusi revisione, chiarimenti o altre modifiche al contenuto di un&apos;espressione di un&apos;opera.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la revisió, l’aclariment o qualsevol altre canvi del contingut d’una expressió d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Å redigere innholdet i et uttrykk av et verk eller gjøre det klarere er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل، أو توضيحه، أو أي تغيير آخر فيه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括对一种作品的一种内容表达之内容的修订、说明或其他变化。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10418 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10418">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne réalisatrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvaohjaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">film yönetmeni kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">filmirežissöör (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">filmrendező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista cinematografico persona</rdfs:label>
        <rdfs:label xml:lang="no">har filmregissør (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er filminstruktør</rdfs:label>
        <rdfs:label xml:lang="en">has film director person</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmregisseurin/Filmregisseur (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmregisseur-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">kinorežisors (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona directora de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona directora cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مخرج أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影导演个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın genel yönetim ve denetiminden sorumlu yönetmen olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona regista responsabile della gestione e della supervisione generali di un&apos;interpretazione cinematografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező személyhez, aki felelős egy filmre vett előadás általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on ohjaaja, joka on vastuussa elokuvatun esityksen yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne réalisatrice qui est responsable de la gestion et de la supervision générales d’une prestation filmée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un director que és responsable de la gestió general i la supervisió d’una actuació filmada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un director que tiene a su cargo la dirección general y supervisión de una actuación filmada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een gefilmde uitvoering.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er regissør med ansvar for generell ledelse av en filmet forestilling.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is a director who is responsible for the general management and supervision of a filmed performance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par uzfilmētā pasākuma vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on filmitava etenduse üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Person), die/der für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مخرجًا مسئولاً عن الإدارة العامة والإشراف على أداء مصوَّر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责拍摄表演的总体管理和监督的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10419 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10419">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne réalisatrice de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista radiofonico persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er radioregissør</rdfs:label>
        <rdfs:label xml:lang="no">har radioregissør (person)</rdfs:label>
        <rdfs:label xml:lang="en">has radio director person</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkregisseurin/Hörfunkregisseur (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioregisseur-persoon</rdfs:label>
        <rdfs:label xml:lang="et">raadiorežissöör (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma direktors (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">radio-ohjaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yönetmeni kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádiós rendező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona directora de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona realitzadora radiofònica</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مخرج إذاعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播导演个人</rdfs:label>
        <skos:definition xml:lang="tr">Bi eseri, bir radyo programının genel yönetim ve denetiminden sorumlu yönetmen olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona regista responsabile della gestione generale e della supervisione di un programma radiofonico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező személyhez, aki felelős egy rádióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne réalisatrice qui est responsable de la gestion et de la supervision générales d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un realitzador que és responsable de la gestió general i la supervisió d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es director y tiene a su cargo la dirección general y supervisión de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er regissør med ansvar for generell ledelse av et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is a director who is responsible for the general management and supervision of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu - direktors, kura atbildīga par radio raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on raadiosaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Person), die/der für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مديرًا مسئولاً عن الإدارة العامة والإشراف على برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责广播节目的总体管理和监督的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10420 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10420">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne réalisatrice de télévision</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista televisivo persona</rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsregissør (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er tv-regissør</rdfs:label>
        <rdfs:label xml:lang="en">has television director person</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehregisseurin/Fernsehregisseur (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieregisseur-persoon</rdfs:label>
        <rdfs:label xml:lang="et">telerežissöör (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">televisio-ohjaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yönetmeni kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televíziós rendező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma režisors (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona director de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona realitzadora de televisió</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مخرج تليفزيوني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视导演个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının genel yönetim ve denetiminden sorumlu yönetmen olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona regista responsabile della gestione generale e della supervisione di un programma televisivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező személyhez, aki felelős egy televízióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on ohjaaja, joka on vastuussa televisio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne réalisatrice qui est responsable de la gestion et de la supervision générales d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un realitzador que és responsable de la gestió general i la supervisió d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un director que tiene a su cargo la dirección general y supervisión de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er regissør med ansvar for generell ledelse av et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is a director who is responsible for the general management and supervision of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu - režisors, kura atbildīga par televīzijas raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on telesaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Person), die/der für das allgemeine Management und die Leitung einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مديرًا مسئولاً عن الإدارة العامة والإشراف على برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责电视节目的总体管理和监督的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10421 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10421">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne productrice audio</rdfs:label>
        <rdfs:label xml:lang="hu">audioproducer személye a következő:</rdfs:label>
        <rdfs:label xml:lang="et">audioprodutsent (isik)</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore audio persona</rdfs:label>
        <rdfs:label xml:lang="no">har lydprodusent (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er lydproducer</rdfs:label>
        <rdfs:label xml:lang="en">has audio producer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten einer Tonaufnahme (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geluidsproducent-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">ses yapımcıs ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņu ierakstu producents (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona productora de audio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona productora d’àudio</rdfs:label>
        <rdfs:label xml:lang="fi">äänituottaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منتج صوت</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音频制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ses kaydının ticari yönlerinin çoğunu yönetmekten sorumlu yapımcı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona produttore responsabile della gestione della maggior parte degli aspetti commerciali di una registrazione audio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer személyhez, aki felelős egy hangfelvétel üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne productrice qui est responsable de gérer la majeure partie des aspects commerciaux d’un enregistrement audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un productor que és responsable de la gestió de la majoria dels aspectes comercials d’un enregistrament àudio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un productor que se encarga de gestionar la mayoría de los aspectos comerciales de una grabación de audio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en produsent som er ansvarlig for de fleste forretningsmessige aspektene ved et lydopptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en producer, som er ansvarlig for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is a producer who is responsible for managing most of the business aspects of an audio recording. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir producents, kas ir atbildīga par skaņu ierakstu biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes produtsendina vastutab enamiku äriliste aspektide korraldamise eest helisalvestusel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Person), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون منتجًا مسئولاً عن إدارة معظم جوانب العمل في تسجيل صوتي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个制作者并负责音频录制工作大多数方面商业运作之管理的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10422 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10422">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne productrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvatuottaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">film yapımcısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas producents (persona)</rdfs:label>
        <rdfs:label xml:lang="et">filmiprodutsent (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">filmproducer személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore cinematografico persona</rdfs:label>
        <rdfs:label xml:lang="no">har filmprodusent (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er filmproducer</rdfs:label>
        <rdfs:label xml:lang="en">has film producer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmproduzentin/Filmproduzenten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmproducent-persoon</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona productora de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona productora cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منتج أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir filmin yapımıyla ilgili ticari yönlerinin çoğunu yönetmekten sorumlu yapımcı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona produttore responsabile della gestione della maggior parte degli aspetti commerciali di un film.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer személyhez, aki felelős egy filmprodukció üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne productrice qui est responsable de la majeure partie des aspects commerciaux de la production d’un film.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de una película.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en produsent med ansvar for de fleste forretningsmessige aspektene ved en film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is a producer who is responsible for most of the business aspects of the production of a film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par filmas uzņemšanas finansiālajiem aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Person), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون منتجًا مسئولاً عن معظم جوانب العمل في فيلم.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电影制作的大部分商业运作的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10423 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10423">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne productrice de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore radiofonico persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er radioproducer</rdfs:label>
        <rdfs:label xml:lang="no">har radioprodusent (person)</rdfs:label>
        <rdfs:label xml:lang="en">has radio producer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkproduzentin/Hörfunkproduzenten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioproducent-persoon</rdfs:label>
        <rdfs:label xml:lang="et">raadioprodutsent (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma producents (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">radiotuottaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yapımcısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádióproducer személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona productora de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona productora radiofònica</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منتج إذاعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının ticari yönlerinin çoğunu yönetmekten sorumlu yapımcı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona produttore responsabile della gestione della maggior parte degli aspetti commerciali di un programma radiofonico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer személyhez, aki felelős egy rádióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne productrice qui est responsable de la majeure partie des aspects commerciaux d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un productor que és responsable de la majoria dels aspectes comercials d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un productor que se encarga de la mayoría de los aspectos comerciales de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is a producer who is responsible for most of the business aspects of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu - producents, kurš ir atbildīgs par radio raidījuma darbības/biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes produtsendina vastutab enamiku äriliste aspektide eest raadiosaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Person), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون منتجًا مسئولاً عن معظم جوانب العمل في برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责广播节目的大部分商业运作的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10424 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10424">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne productrice de télévision</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore televisivo persona</rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsprodusent (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er tv-producer</rdfs:label>
        <rdfs:label xml:lang="en">has television producer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehproduzentin/Fernsehproduzenten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieproducent-persoon</rdfs:label>
        <rdfs:label xml:lang="et">teleprodutsent (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">televisiotuottaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yapımcısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televízió-producer személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma producents (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona productor de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona productora de televisió</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منتج تليفزيوني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının ticari yönlerinin çoğunu yönetmekten sorumlu yapımcı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona produttore responsabile della gestione della maggior parte degli aspetti commerciali di un programma televisivo.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer személyhez, aki felelős egy televízióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on tuottaja, joka on vastuussa suurimmasta osasta televisio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne productrice qui est responsable de la majeure partie des aspects commerciaux d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un productor que és responsable de la majoria dels aspectes comercials d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un productor que se encarga de la mayoría de los aspectos comerciales de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is a producer who is responsible for most of the business aspects of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu - producents, kura atbildīga par televīzijas raidījuma biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes produtsendina vastutab enamiku äriliste aspektide eest telesaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Person), die/der für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون منتجًا مسئولاً عن معظم جوانب العمل في برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电视节目的大部分商业运作的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10425 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10425">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne architecte paysagiste</rdfs:label>
        <rdfs:label xml:lang="lv">ainavu arhitekts (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto del paesaggio persona</rdfs:label>
        <rdfs:label xml:lang="no">har landskapsarkitekt (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er landskabsarkitekt</rdfs:label>
        <rdfs:label xml:lang="en">has landscape architect person</rdfs:label>
        <rdfs:label xml:lang="de">hat Landschaftsarchitektin/Landschaftsarchitekten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landschapsarchitect-persoon</rdfs:label>
        <rdfs:label xml:lang="et">maastikuarhitekt (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">maisema-arkkitehti (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">peyzaj mimarı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona arquitecto paisajista</rdfs:label>
        <rdfs:label xml:lang="hu">tájépítész személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona arquitecta paisatgista</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مهندس تنسيق مواقع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有景观设计师个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri peyzaj çalışmaları yapmaktan sorumlu mimar olan kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona architetto responsabile della creazione di opere paesaggistiche.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy építész személyhez, aki felelős tájépítészeti művek létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne architecte qui est responsable de la création d’œuvres paysagères.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un arquitecte que és responsable de la creació d’obres paisatgístiques.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es arquitecto y se encarga de crear obras paisajísticas.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een architect is die verantwoordelijk is voor het creëren van landschapswerken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en arkitekt med ansvar for å skape landskapsverk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en arkitekt, som er ansvarlig for at skabe landskabsværker.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an architect who is responsible for creating landscape works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par ainavu darbu veidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes arhitektina vastutab maastikuteoste loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Architektin/einem Architekten (Person), die/der für die Schaffung landschaftlicher Werke verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مهندسا معماريا مسئولاً عن إنشاء أعمال تنسيق المواقع.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为建筑师并负责创建景观作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10426 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10426">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne calligraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come calligrafo persona </rdfs:label>
        <rdfs:label xml:lang="no">har kalligraf (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er kalligraf</rdfs:label>
        <rdfs:label xml:lang="en">has calligrapher person</rdfs:label>
        <rdfs:label xml:lang="de">hat Kalligrafin/Kalligrafen (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kalligraaf-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">kaligraf ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kaligrāfs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">kalligraaf (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">kalligrafi (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">kalligráfus személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona calígrafa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona cal·lígrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص خطاط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有书法者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri aynı kişinin yazılı metinden sorumlu olup olmadığına bakılmaksızın, hattatlığın veya grafik sanatının estetik değerinin ön plana çıktığı, kaligrafiden sorumlu sanatçı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona artista responsabile della calligrafia, laddove l&apos;oggetto dell&apos;interesse risieda nel valore estetico della calligrafia o maestria grafica, a prescindere che la stessa persona sia anche responsabile del testo inscritto.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész személyhez, aki felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafikus művésziség áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a személy a lejegyzett szöveg szerzője is egyben vagy sem.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama toimija myös vastuussa kirjoitetusta tekstistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même personne soit aussi responsable du texte calligraphié.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa persona és també responsable del text inscrit.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o del arte gráfico, independientemente de que la misma persona sea también responsable del texto inscrito.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde persoon ook verantwoordelijk is voor de inscriptie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same person is also responsible for the inscribed text.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par ierakstīto tekstu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama isik on vastutav ka kirjutatud teksti eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Person auch für den aufgeschriebenen Text verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون فنانا مسئولاً عن فن الخط حيث ينصب تركيز الاهتمام على القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الشخص نفسه مسئولاً أيضًا عن النص المدون.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一个人是否负责题写文字）的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10427 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10427">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne sculptrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come scultore persona </rdfs:label>
        <rdfs:label xml:lang="da">har person, som er skulptør</rdfs:label>
        <rdfs:label xml:lang="no">har skulptør (person)</rdfs:label>
        <rdfs:label xml:lang="en">has sculptor person</rdfs:label>
        <rdfs:label xml:lang="de">hat Bildhauerin/Bildhauer (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft beeldhouwer-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">heykeltıraş kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">kuvanveistäjä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">skulptor (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">szobrász személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona escultor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona escultora</rdfs:label>
        <rdfs:label xml:lang="lv">tēlnieks (persona)</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص نحات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕塑家个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, modelleme, oyma veya benzeri bir teknikle üç boyutlu bir eser oluşturmaktan sorumlu sanatçı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona artista responsabile della creazione di un&apos;opera tridimensionale tramite modellatura, intaglio o tecnica simile.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész személyhez, aki felelős egy háromdimenziós mű megalkotásáért modellezési, faragási vagy hasonló technikával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne artiste qui est responsable de la création d’une œuvre tridimensionnelle par le modelage, la taille ou une technique similaire.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un artista que és responsable de la creació d’una obra tridimensional a partir del modelatge, la talla o una tècnica similar.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un artista que se encarga de crear una obra tridimensional mediante modelado, tallado o una técnica similar.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een kunstenaar is die verantwoordelijk is voor het creëren van driedimensionaal modelleren, snijden of gelijksoortige techniek.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en kunstner med ansvar for å skape et tredimensjonalt verk gjennom modellering, utskjæring eller lignende teknikker.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en kunstner, som er ansvarlig for at skabe et tredimensionelt værk vha. modellering, udskæring eller lignende teknik.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an artist who is responsible for creating a three-dimensional work by modeling, carving, or similar technique.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu - mākslinieks, kurš ir atbildīgs par trīsdimensiju darba radīšanu, to veidojot, grebjot vai izmantojot līdzīgu tehniku.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on modelleerimise, nikerdamise või muu säärase tehnika teel loodud kolmemõõtmelise teose eest vastutav kunstnik.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون فنانا مسئولاً عن إنشاء عمل ثلاثي الأبعاد عن طريق النمذجة، أو النحت، أو تقنية مشابهة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家并通过模型、雕刻或类似技术负责创建一种三维作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10428 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10428">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne artiste du livre</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatu mākslinieks (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come book artist persona</rdfs:label>
        <rdfs:label xml:lang="no">har bokkunstner (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er bogkunstner</rdfs:label>
        <rdfs:label xml:lang="en">has book artist person</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchkünstlerin/Buchkünstler (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekkunstenaar-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">kirjataiteilija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">kitap sanatçısı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvművész személye a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukunstnik (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona artista de libro</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona artista de llibre d’art</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص فنان كتب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书美术家个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu sanatçı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész személyhez, aki felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és una artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un artista que se encarga de explotar la forma del libro o alterar su estructura física.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an artist who is responsible for exploiting the book form or altering its physical structure.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura atbild par grāmatas kā mākslas darbu radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Person), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physischen Struktur verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون فنانا مسئولاً عن استغلال شكل الكتاب أو تغيير بنيته المادية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10429 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10429">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne scénariste</rdfs:label>
        <rdfs:label xml:lang="hu">forgatókönyvíró személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come sceneggiatore persona </rdfs:label>
        <rdfs:label xml:lang="no">har manusforfatter (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er manuskriptforfatter</rdfs:label>
        <rdfs:label xml:lang="en">has screenwriter person</rdfs:label>
        <rdfs:label xml:lang="de">hat Drehbuchautorin/Drehbuchautor (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft scenarioschrijver-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">käsikirjoittaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="lv">scenārists (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">senarist kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">stsenarist (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona guionista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona guionista</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص كاتب سيناريو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有影视剧编剧个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri senaryo, metin veya sahne yazarı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona autore di una sceneggiatura, copione o scena.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki szerzője egy forgatókönyvnek, szövegkönyvnek vagy jelenetnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on käsikirjoituksen tai kohtauksen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne autrice d’un scénario, d’un script ou d’une scène.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un autor d’un guió, un argument o una escena.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es autor de un guión, escrito o escena.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een auteur is van een scenario, script of scène.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en forfatter av et skuespill, et manuskript eller en scene.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er forfatter af et manuskript, drejebog eller scene.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an author of a screenplay, script, or scene.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir scenārija, uzveduma plāna vai ainas autors.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on stsenaariumi või stseeni autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person) eines Drehbuchs, eines Skripts oder einer Szene.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مؤلف سيناريو، أو نص، أو مشهد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为影视剧剧本、脚本或场景著者的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10430 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10430">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne parolière</rdfs:label>
        <rdfs:label xml:lang="hu">dalszövegíró személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">dziesmas teksta autors (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come paroliere persona </rdfs:label>
        <rdfs:label xml:lang="da">har person, som er tekstforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har sangtekstforfatter (person)</rdfs:label>
        <rdfs:label xml:lang="en">has lyricist person</rdfs:label>
        <rdfs:label xml:lang="de">hat Textdichterin/Textdichter (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft liedtekstschrijver-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">sanoittaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">sõnade autor (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">söz yazarı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona letrista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona lletrista</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مؤلف أغاني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作词者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzikalin şarkısı da dahil olmak üzere popüler bir şarkının sözlerinin yazarı olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona autore delle parole di una canzone pop, inclusa una canzone di un musical.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne autrice des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es autor de la letra de una canción popular, incluida una canción de un musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an author of the words of a popular song, including a song from a musical.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir dziesmas vārdu autors, ieskaitot dziesmas no mūzikla.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on levilaulu (k.a laul muusikalist) sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مؤلف كلمات أغنية مشهورة، بما في ذلك أغنية من مسرحية موسيقية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of only the dialogue from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca diyaloglarının yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å bare skrive dialogen fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore dei soli dialoghi di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali dialoogide kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkän musikaalin dialogin kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun dialogen i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de dialogen uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musical párbeszédeinek szerzősége nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver mūzikla dialogus.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría únicamente del diálogo de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només el diàleg d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف الحوار فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是对话的著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10431 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10431">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne librettiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come librettista persona</rdfs:label>
        <rdfs:label xml:lang="no">har librettist (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er librettist</rdfs:label>
        <rdfs:label xml:lang="en">has librettist person</rdfs:label>
        <rdfs:label xml:lang="de">hat Librettistin/Librettisten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft librettist-persoon</rdfs:label>
        <rdfs:label xml:lang="et">libretist (isik)</rdfs:label>
        <rdfs:label xml:lang="fi">libretisti (henkilö)</rdfs:label>
        <rdfs:label xml:lang="lv">libretists (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">librettista személye a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">libretto yazarı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona libretista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona llibretista</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مؤلف أوبرالي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有台本作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, opera, bale veya müzikal sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan kişiyle ilişkilendirir</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona autore delle parole di un musical o un&apos;opera coreografica, come un&apos;opera, balletto o un&apos;altra opera per il teatro musicale, o per un oratorio.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző személyhez, aki olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un autor de les paraules d’una obra musical o coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为歌剧、芭蕾等音乐或编舞作品或其他舞台音乐作品或者清唱剧的歌词的著者的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of the words of only the songs from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore delle parole delle sole canzoni di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali laulusõnade kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun sangteksterne i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musicaldalok szövegírója nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atsevišķu dziesmu tekstus mūziklos.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría de la letra únicamente de las canciones de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només les paraules de les cançons d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是歌曲的词著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10432 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10432">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne rapporteuse</rdfs:label>
        <rdfs:label xml:lang="et">aruande koostaja (isik)</rdfs:label>
        <rdfs:label xml:lang="it">ha come relatore persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er rapportør</rdfs:label>
        <rdfs:label xml:lang="no">har rapportør (person)</rdfs:label>
        <rdfs:label xml:lang="en">has rapporteur person</rdfs:label>
        <rdfs:label xml:lang="de">hat Berichterstatterin/Berichterstatter (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft rapporteur-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">kokousten raportoija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">raportör kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">raportőr személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona relatora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona relatora</rdfs:label>
        <rdfs:label xml:lang="lv">ziņotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مقرر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有会务报告人个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kuruluş tarafından toplantılarının işleyişi hakkında rapor vermek üzere atanan yazar olan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona autore incaricata da un&apos;organizzazione di compilare rapporti sugli atti dei suoi incontri.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző személyhez, akit egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne autrice qui est nommée par une organisation pour rédiger les comptes rendus de ses réunions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es un autor que es designado por una organización para informar sobre las actas de sus reuniones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is an author who is appointed by an organization to report on the proceedings of its meetings.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Person), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个著者并被一个组织指定为在其会议文集中报告的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="no">Ansvar som er begrenset til å ta møtereferater, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; esclusa la responsabilità limitata alla redazione dei verbali.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma vastutust, mis on piiratud ainult protokollimisega.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atbildību protokolēt.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele a jegyzőkönyvvezetésre korlátozódó szerzőség.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter ikke ansvar begrænset til at tage referat.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Responsibility limited to taking minutes is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la responsabilidad limitada a levantar actas.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la responsabilitat que es limita a prendre notes.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Tutanak tutmakla sınırlı sorumluluk hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une responsabilité limitée à rédiger un procès-verbal est exclue.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Verantwoordelijkheid beperkt tot het notuleren is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括仅限于写会议记录的责任。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10434 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10434">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne chorégraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come coreografo persona </rdfs:label>
        <rdfs:label xml:lang="no">har koreograf (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er koreograf</rdfs:label>
        <rdfs:label xml:lang="en">has choreographer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Choreografin/Choreografen (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft choreograaf-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">koreograaf (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">koreograf ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">koreografi (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfus személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona coreógrafa</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona coreògrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مصمم رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir koreografik eser oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile di un&apos;opera coreografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy koreografikus mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa koreografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre chorégraphique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra coreogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de crear una obra coreográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een choreografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et koreografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for et koreografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a choreographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par horeogrāfisku darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab koreograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines choreografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن ابتكارعمل راقص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种编舞作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10435 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10435">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne cartographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba kartogrāfs (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kartografı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come cartografo persona di opera</rdfs:label>
        <rdfs:label xml:lang="no">har kartograf for verk (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er kartograf for værk</rdfs:label>
        <rdfs:label xml:lang="en">has cartographer person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Kartografin/Kartografen eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cartograaf-persoon van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű térképész személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen kartantekijä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose kartograaf (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona cartógrafo de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona cartògrafa d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص رسام خرائط لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的地图绘制者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kartografik eser oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile di un&apos;opera cartografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy kartográfiai mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa kartografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre cartographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra cartogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de crear una obra cartográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een cartografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for et kartografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for et kartografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a cartographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par karti, atlantu, globusu vai citu kartogrāfijas materiālu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab kartograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines kartografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل خرائطي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种地图作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10436 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10436">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne autrice</rdfs:label>
        <rdfs:label xml:lang="lv">autors (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come autore persona</rdfs:label>
        <rdfs:label xml:lang="no">har forfatter (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er forfatter</rdfs:label>
        <rdfs:label xml:lang="en">has author person</rdfs:label>
        <rdfs:label xml:lang="de">hat Verfasserin/Verfasser (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft auteur-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">kirjoittaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">szerző személye a következő:</rdfs:label>
        <rdfs:label xml:lang="et">tekstteose autor (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona autora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona autora</rdfs:label>
        <rdfs:label xml:lang="tr">yazar ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مؤلف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有著者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, metinsel bir eser yaratmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile di un&apos;opera testuale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy szöveges mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa tekstiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre textuelle.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra textual.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de crear una obra textual.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een tekstwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for et tekstlig verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for et tekstværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a textual work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par tekstuālu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab tekstteose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines textlichen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل نصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种文字作品的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Başka bir yaratıcıya ait eserlerin yeniden yazılması, yeniden ifade edilmesi veya uyarlanması yoluyla, eğer yapılan değişiklik orijinal eserin niteliğini ve içeriğini önemli ölçüde değiştirmişse ya da ifade ortamını dönüştürmüşse, yeni bir eser oluşturulması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy új mű megalkotása egy másik alkotó munkáinak átfogalmazásával, újraírásával vagy adaptálásával, ha a módosítás lényegesen megváltoztatta az eredeti jellegét és tartalmát, vagy a kifejezési forma médiumát.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Creatie van een nieuw werk door het parafraseren, herschrijven of bewerken van werken van een andere maker, als de wijziging de aard en content van het origineel substantieel gewijzigd heeft of het medium van expressie gewijzigd heeft, is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Creation of a new work by paraphrasing, rewriting, or adapting works by another creator, if the modification has substantially changed the nature and content of the original or changed the medium of expression, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Schaffung eines neuen Werks durch Paraphrasieren, Umschreiben oder Adaption von Werken einer anderen geistigen Schöpferin/eines anderen geistigen Schöpfers, wenn die Veränderung die Art und den Inhalt des Originals substanziell verändert hat oder sich das Medium der Expression geändert hat.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å skape et nytt verk ved å omskrive eller bearbeide verk av en annen opphaver er inkludert hvis dette i vesentlig grad har endret originalverkets særpreg og innhold, eller hvis mediet for uttrykket er endret.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compresa la creazione di una nuova opera tramite la parafrasi, riscrittura o adattamento di opere di un altro creatore, se la modifica ha cambiato sostanzialmente la natura e contenuto dell&apos;originale, o ha cambiato il mezzo di espressione.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uue teose loomist, ümber sõnastades, ümber töötades või adapteerides teise autori teoseid, kui teisendamine on originaali olemust ja sisu oluliselt muutnud või muutunud on väljenduse meedium.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver arī jauna darba radīšanu, pārfrazējot, pārrakstot vai pielāgojot cita radītāja darbus, ja ir būtiski mainīta pamatdarba būtība, saturs vai izteiksmes nesējs.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la creació d’una obra nova parafrasejant, reescrivint o adaptant obres d’un altre creador, si la modificació ha canviat substancialment la natura i el contingut de l’original o si ha canviat el mitjà d’expressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La création d’une nouvelle œuvre en paraphrasant, en réécrivant ou en adaptant les œuvres d’un autre créateur est incluse, si la modification a changé considérablement la nature et le contenu de l’original ou a changé le mode d’expression.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se incluye la creación de una obra nueva mediante parafraseo, reescritura o adaptación de obras de otro creador, si la modificación ha cambiado sustancialmente la naturaleza y el contenido del original o ha cambiado el medio de expresión.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Skabelse af et nyt værk ved at parafrasere, omskrive eller bearbejde værker af et andet ophav, hvis modificeringen har medført en væsentlig ændring af originalens karakter og indhold, eller den har ændret udtryksmediet, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين إنشاء عمل جديد عن طريق إعادة منشئ آخر الصياغة، أو الكتابة، أو تكييفه الأعمال، إذا كان التعديل قد غيّر طبيعة الأصل ومحتواه أو غير وسيلة التعبير تغييرا كبيرا.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">通过演绎、改写或改变另一个创建者的作品所作而成的新作品的创建，如果修改实质性改变了原作的性质和内容或者改变了内容表达的媒介，应被包括在内。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10437 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10437">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne créatrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba radītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin yaratıcısı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore persona di opera</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er ophav til værk</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av verk (person)</rdfs:label>
        <rdfs:label xml:lang="en">has creator person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat geistige Schöpferin/geistigen Schöpfer eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-persoon van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű létrehozó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen tekijä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose autor (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona creadora de la obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona creadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منشئ عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有创作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser yaratmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de crear una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创作一种作品的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of work includes an agent who is jointly responsible for the creation of a work either by performing the same role as another agent, such as in a collaboration between two writers, or by performing a different role, such as in a collaboration between a composer and a lyricist.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A mű létrehozója magában foglal egy ágenst, amely egy másik ágenssel közösen felelős egy mű létrehozásáért akár ugyanabban a közreműködői minőségben, mint például két író közötti együttműködés, vagy eltérő közreműködői minőségben, mint például egy zeneszerző és egy szövegíró közötti együttműködés.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir eserin yaratıcısı, iki yazarın iş birliği gibi başka bir temsilciyle aynı rolü üstlenerek ya da bir besteci ve söz yazarı arasındaki iş birliği gibi farklı bir rol üstlenerek, eserin yaratılmasından ortaklaşa sorumlu olan bir temsilciyi kapsar.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darba radītājs ietver aģentu, kas ir atbildīgs par darba radīšanu un pilda tādu pašu lomu kā cits aģents, piemēram, kā sadarbībā starp diviem rakstniekiem vai veicot dažādas lomas, kā piemēram, komponista un teksta autora sadarbībā.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt ein Akteur, der für die Schaffung eines Werks mitverantwortlich ist, wenn er entweder dieselbe Rolle wie ein anderer Akteur ausführt, wie bei einer Zusammenarbeit zwischen zwei Schriftstellerinnen/Schriftstellern, oder eine andere Rollen ausführt, wie bei einer Zusammenarbeit zwischen einer Komponistin/einem Komponisten und einer Textdichterin/einem Textdichter.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van werk omvat een actor die gezamenlijk verantwoordelijk is voor de creatie van een werk door ofwel dezelfde rol uit te voeren als een andere actor, zoals bij een samenwerking door twee schrijvers, ofwel door een verschillende rol uit te voeren, zoals bij een samenwerking tussen een componist en een liedtekstschrijver.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En opphaver for verk inkluderer en agent med delt ansvar for å skape et verk, enten ved å fylle samme rolle som en annen agent, som i et samarbeid mellom to forfattere, eller ulike roller som i et samarbeid mellom en komponist og en sangtekstforfatter.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til værk omfatter en agent, som har fælles ansvar for at have skabt et værk enten ved at udføre den samme rolle som en anden agent, såsom i et samarbejde mellem to forfattere, eller ved at udføre en anden rolle, såsom i et samarbejde mellem en komponist og en tekstforfatter. </skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose autor hõlmab ka tegijat, kes kaasvastutab teose loomise eest, täites teise tegijaga kas sama rolli (nt kahe kirjaniku koostöö) või erinevat rolli (nt helilooja ja sõnade autori koostöö).</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de una obra incluye un agente que es corresponsable de la creación de una obra, ya sea desempeñando el mismo papel que otro agente, como en una colaboración entre dos escritores, o desempeñando un papel diferente, como en una colaboración entre un compositor y letrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una obra inclou un agent que és responsable conjuntament de la creació d’una obra ja sigui realitzant la mateixa funció que un altre agent, com ara una col·laboració entre dos escriptors, o realitzant funcions diferents, com ara una col·laboració entre un compositor i un lletrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di opera comprende un agente, che è congiuntamente responsabile della creazione di un&apos;opera, sia svolgendo lo stesso ruolo di un altro agente, come in una collaborazione tra due scrittori, sia svolgendo un ruolo differente, come in una collaborazione tra un compositore e un paroliere.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une œuvre comprend un agent coresponsable de la création d’une œuvre soit en exerçant le même rôle qu’un autre agent, comme dans le cas d’une collaboration entre deux écrivains, soit en exerçant un rôles différent, comme dans le cas d’une collaboration entre un compositeur et un parolier.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منشئ العمل يشمل وكيلًا مسئولاً مسئولية مشتركة عن إنشاء عمل إما عن طريق أداء نفس الدور الذي يؤديه وكيل آخر، كما هو الحال في التعاون بين كاتبين، أو عن طريق أداء دور مختلف، كما هو الحال في التعاون بين ملحن ومؤلف أغاني.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">作品的创作者包括对作品的创建联合负责的行为者，他们或者行使同样的角色（例如两个写作者之间的合作）或者行使不同角色（例如作曲者和词作者之间的合作）。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10438 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10438">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne architecte</rdfs:label>
        <rdfs:label xml:lang="et">arhitekt (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">arhitekts (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">arkkitehti (henkilö)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto persona</rdfs:label>
        <rdfs:label xml:lang="no">har arkitekt (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er arkitekt</rdfs:label>
        <rdfs:label xml:lang="en">has architect person</rdfs:label>
        <rdfs:label xml:lang="de">hat Architektin/Architekten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft architect-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">mimar kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona arquitecto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona arquitecta</rdfs:label>
        <rdfs:label xml:lang="hu">építész személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مهندس معماري</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有建筑师个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir binanın veya başka bir yapının tamamlandığında nasıl görüneceğini göstermeyi amaçlayan resimli bir temsil de dahil olmak üzere, bir mimari tasarım oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile di un progetto architettonico, inclusa una rappresentazione visiva destinata a mostrare l&apos;aspetto che avrà una costruzione o altra struttura una volta completata. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy építészeti tervért, beleértve egy képi ábrázolást, melynek célja bemutatni, hogy egy épület stb. az elkészülte után hogyan fog kinézni.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une conception architecturale, y compris une représentation illustrée conçue pour montrer à quoi ressemblera un bâtiment ou une autre structure une fois la construction terminée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’un disseny arquitectònic, inclosa una representació il·lustrada concebuda per mostrar com serà un edifici o qualsevol altra estructura una vegada complet.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona responsable de crear un diseño arquitectónico, incluida una representación pictórica destinada a mostrar cómo se verá un edificio u otra estructura cuando esté terminado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een architectonisch ontwerp, omvattende een picturale representatie bedoeld te laten zien hoe een gebouw of andere structuur er na voltooiing uit zal zien.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape en arkitektonisk utforming, inkludert en gjengivelse i bildeform som er ment å vise hvordan en bygning eller annen struktur vil se ut når den er ferdig.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for et arkitektonisk design, inkl. en billedrepræsentation, som skal vise, hvordan en bygning eller anden struktur vil se ud, når den er færdig.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating an architectural design, including a pictorial representation intended to show how a building or other structure will look when completed.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par arhitektūras projekta radīšanu, ieskaitot projekta skici, lai parādītu, kā ēka vai cita struktūra izskatīsies, kad tā tiks pabeigta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab arhitektuurse kujunduse loomise eest, k.a pildiline esitus, mis näitab, kuidas ehitis või muu konstruktsioon valmides välja hakkab nägema.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines architektonischen Entwurfs verantwortlich ist, einschließlich einer bildlichen Darstellung, die zeigt, wie ein Gebäude oder eine andere Konstruktion nach der Fertigstellung aussehen soll.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء تصميم معماري، بما في ذلك تمثيل مصور يهدف إلى إظهار كيف سيبدو المبنى أو هيكل آخر عند اكتماله.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建建筑设计（包括用于展示建筑或其他结构完成之后外观效果的绘画作品）的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10439 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10439">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne commanditaire</rdfs:label>
        <rdfs:label xml:lang="tr">görevlendiren kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come committente persona</rdfs:label>
        <rdfs:label xml:lang="no">har oppdragsgiver (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er opgavestiller</rdfs:label>
        <rdfs:label xml:lang="en">has commissioning person</rdfs:label>
        <rdfs:label xml:lang="de">hat Auftraggeberin/Auftraggeber (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft opdrachtgever-persoon</rdfs:label>
        <rdfs:label xml:lang="hu">megrendelő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pasūtītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">tellija (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona comisionada</rdfs:label>
        <rdfs:label xml:lang="fi">toimeksiantaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona comitent</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مكلف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有委托个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eseri görevlendirmekten sorumlu olan bir kişiye ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della committenza di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy mű megrendeléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa teoksen teettämisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la commande d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable d’encarregar una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de encargar una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor opdracht geven tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å bestille et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for bestilling af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for commissioning a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par darba pasūtīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab teose tellimise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die ein Werk in Auftrag gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن التكليف بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责委托一种作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10440 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10440">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne programmeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come programmatore persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er programmør</rdfs:label>
        <rdfs:label xml:lang="no">har programmerer (person)</rdfs:label>
        <rdfs:label xml:lang="en">has programmer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Programmiererin/Programmierer (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft programmeur-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">ohjelmoija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">programcı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">programmeerija (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">programmētājs (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">programozó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona programadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona programadora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مبرمج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编程者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bilgisayar programı oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un programma per computer.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy számítógépes program megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa tietokoneohjelman luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’un programme informatique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’un programa informàtic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear un programa informático.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een computerprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et dataprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et computerprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a computer program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par datorprogrammas izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab arvutiprogrammi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Computerprogramms verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء برنامج كمبيوتر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种计算机程序的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10441 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10441">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne designer</rdfs:label>
        <rdfs:label xml:lang="fi">designer (henkilö)</rdfs:label>
        <rdfs:label xml:lang="lv">dizainers (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come designer persona</rdfs:label>
        <rdfs:label xml:lang="no">har designer (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er designer</rdfs:label>
        <rdfs:label xml:lang="en">has designer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Designerin/Designer (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ontwerper-persoon</rdfs:label>
        <rdfs:label xml:lang="et">kujundaja (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">tasarımcı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">tervező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona diseñadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona dissenyadora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مصمم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有设计者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir obje için tasarım oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione del progetto di un oggetto.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy tárgy tervezetének a megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa kohteen suunnittelusta tai muotoilusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la conception d’un objet.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’un disseny d’un objecte.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear un diseño para un objeto.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een ontwerp voor een object.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å designe en gjenstand.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at designe et objekt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a design for an object.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par objekta dizaina radīšanu/izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab objekti kujunduse loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Gestaltung des Designs eines Objekts verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء تصميم لكائن.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个物体的设计的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10442 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10442">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne compositrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba komponists (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin bestecisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compositore persona di opera</rdfs:label>
        <rdfs:label xml:lang="no">har komponist for verk (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er komponist af værk</rdfs:label>
        <rdfs:label xml:lang="en">has composer person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Komponistin/Komponisten eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft componist-persoon werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű zeneszerző személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen säveltäjä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose helilooja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona compositora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona compositora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص ملحن لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的作曲者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzik eseri oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un&apos;opera musicale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy zenemű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa musiikkiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear una obra musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een muziekwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et musikalsk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et musikværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a musical work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par mūzikas darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab muusikateose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Musikwerks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل موسيقي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种音乐作品的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Bewerken van een ander muziekwerk om een onderscheidende aanpassing te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compreso l&apos;adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un&apos;opera o la creazione di un&apos;opera nello stile tipico di un altro compositore, o la creazione di un&apos;opera basata sulla musica di un altro compositore.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se incluye la adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra en el estilo general de otro compositor, o crear una obra que se base en la música de otro compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创建一种新的作品、或者基于另一个作曲者的音乐创建一种新的作品。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10443 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10443">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne inventrice</rdfs:label>
        <rdfs:label xml:lang="hu">feltaláló személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come inventore persona</rdfs:label>
        <rdfs:label xml:lang="no">har oppfinner (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er opfinder</rdfs:label>
        <rdfs:label xml:lang="en">has inventor person</rdfs:label>
        <rdfs:label xml:lang="de">hat Erfinderin/Erfinder (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvinder-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">izgudrotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="fi">keksijä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">leiutaja (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">mucit kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona inventora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona inventora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مخترع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发明者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, yeni bir cihaz veya süreç oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un nuovo dispositivo o procedimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy új eszköz vagy eljárás létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa uuden välineen tai menetelmän luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’un nouveau dispositif ou procédé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’un mecanisme o procés nou.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear un nuevo dispositivo o proceso.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een nieuw apparaat of proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape en ny innretning eller prosess.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe en ny anordning eller proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a new device or process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par jaunas ierīces vai procesa radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab uue seadme või protsessi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines neuen Gerätes oder Prozesses verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء جهاز أو عملية جديدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种新装置或新过程的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10444 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10444">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne compilatrice</rdfs:label>
        <rdfs:label xml:lang="tr">derleyen kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compilatore persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er kompilator</rdfs:label>
        <rdfs:label xml:lang="no">har utarbeider (person)</rdfs:label>
        <rdfs:label xml:lang="en">has compiler person</rdfs:label>
        <rdfs:label xml:lang="de">hat Zusammenstellende/Zusammenstellenden (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft samensteller-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">kokoaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">koostaja (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">sastādītājs (persona)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona compiladora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona compiladora</rdfs:label>
        <rdfs:label xml:lang="hu">összeállító személye a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص جامع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编纂者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, üstveri seti oluşturmaktan sorumlu bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di una nuova opera come una bibliografia o un repertorio, tramite selezione, organizzazione, aggregazione e cura di dati, informazioni, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki adatok, információk stb. kiválasztása, elrendezése, aggregálása és szerkesztése révén felelős egy olyan új mű létrehozásáért, mint például egy bibliográfia vagy adattár.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa uuden teoksen, kuten bibliografian tai hakemiston luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’un ensemble de métadonnées descriptives.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’un conjunt de descripció de metadades.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de crear un conjunto de descripción de metadatos.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een actor die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a metadata description set.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个元数据描述集的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön muokkaamista tai selkeyttämistä eikä teosten tai teosten osien valitsemista ja kokoamista yhteen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik ide sem egy mű kifejezési formájának tartalmi felülvizsgálata vagy tisztázása, sem a művek vagy műrészek kifejezési formáinak kiválasztása és összeállítása.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono esclusi la revisione o il chiarimento del contenuto di un&apos;espressione di un&apos;opera, e la selezione e raccolta di espressioni di opere o parti di opere.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares, y una ayuda analítica para la búsqueda.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن الأعمال أو أجزاء من الأعمال وتجميعها.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10445 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10445">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne photographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="tr">eserin fotoğrafçı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">fotogrāfs (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come fotografo persona di opera</rdfs:label>
        <rdfs:label xml:lang="no">har fotograf for verk (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er fotograf af værk</rdfs:label>
        <rdfs:label xml:lang="en">has photographer person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Fotografin/Fotografen eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fotograaf-persoon werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű fényképész személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen valokuvaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose fotograaf (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona fotógrafa de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona fotògrafa d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مصور لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的摄影者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir fotoğraf eseri yaratmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un&apos;opera fotografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy fényképészeti mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa valokuvateoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre photographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra fotogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear una obra fotográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een fotografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et fotografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et fotografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a photographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par fotogrāfiska darba izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab fotograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines fotografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل فوتوغرافي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种摄影作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10446 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10446">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne intervieweuse d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervējis (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşmeci kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistatore persona di opera</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuer for verk (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er interviewer for værk</rdfs:label>
        <rdfs:label xml:lang="en">has interviewer person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewerin/Interviewer eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft interviewer-persoon van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúkészítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastattelija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueerija (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona entrevistadora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona entrevistadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص محاور لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的采访者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, görüşmeci, muhabir, anketör veya bilgi toplayan başka türde bir kişi olarak hareket ederek bir eser oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un&apos;opera, che agisce come intervistatore, reporter, sondaggista o altro genere di persona che raccoglie informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő személyként cselekszik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre personne recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus de persona que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear una obra actuando como entrevistador, reportero, encuestador o algún otro tipo de persona que recopila información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of person who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva isikuna.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Person Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل من خلال العمل كمحاور، أو مراسل، أو مستطلع آراء، أو أي نوع آخر من الأشخاص الذين يجمعون المعلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过担当采访者、记者、民意调查员或其他类型信息搜集个人而对一种作品的创建负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10447 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10447">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne interviewée d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervēts (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşülen kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistato persona di opera</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuobjekt for verk (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er interviewperson for værk</rdfs:label>
        <rdfs:label xml:lang="en">has interviewee person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewte/Interviewten eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geïnterviewde persoon van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúalany személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastateltava (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueeritav (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona entrevistada de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona entrevistada d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص ضيف مقابلة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的受访者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, genellikle bir muhabir, anketör veya bilgi toplayan başka bir tür temsilci olan bir görüşmeciye yanıt vererek bir eser oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un&apos;opera tramite le risposte date a un intervistatore, solitamente un reporter, sondaggista o altro genere di agente che raccoglie le informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy mű létrehozásáért oly módon, hogy válaszol egy interjúkészítőnek, általában riporternek, közvélemény-kutatónak, vagy valamilyen más információgyűjtő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa teoksen luomisesta vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jonkinlaiselle muulle toimijalle, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre en répondant à un intervieweur, habituellement un reporteur, un sondeur ou un autre agent recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra responent a un entrevistador, normalment un periodista, enquestador o qualsevol altre tipus d’agent que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de crear una obra respondiendo a un entrevistador, generalmente un reportero, encuestador o algún otro tipo de agente que recopila información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een werk door het antwoorden op een interviewer, meestal een journalist, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et verk ved å svare på spørsmål fra en intervjuer, reporter eller annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et værk ved at besvare spørgsmål fra en interviewer, normalt en journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating a work by responding to an interviewer, usually a reporter, pollster, or some other kind of agent who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par darba radīšanu, atbildot uz intervētāja, parasti reportiera, aptaujas organizētāja vai kāda cita informācijas apkopotāja jautājumiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab teose loomise eest, vastates intervjueerijale, reporterile, küsitlejale või muule infot koguvale tegijale. </skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Werks verantwortlich ist, indem sie einer Interviewerin/einem Interviewer antwortet. Dabei handelt es sich normalerweise um eine Reporterin/einen Reporter, eine Meinungsforscherin/einen Meinungsforscher oder eine andere Akteurin/einen anderen Akteur, die/der Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل من خلال الرد على المحاور، وعادة ما يكون مراسلاً، أو مستطلع آراء، أو وكيل من نوع آخر يجمع معلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过回答采访者（通常是记者、民意调查员或其他类型信息搜集行为者）而对一种作品的创建负责的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10448 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10448">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne agrégatrice</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattori (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátor személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="it">ha come aggregatore persona </rdfs:label>
        <rdfs:label xml:lang="no">har aggregator (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er samler</rdfs:label>
        <rdfs:label xml:lang="en">has aggregator person</rdfs:label>
        <rdfs:label xml:lang="de">hat Aggregatorin/Aggregator (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aggregator-persoon</rdfs:label>
        <rdfs:label xml:lang="et">liitja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona agregadora</rdfs:label>
        <rdfs:label xml:lang="tr">toplayıcı kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona agregadora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مجمِّع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集编者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, diğer eserlerin anlatımlarını ifadelerini seçerek ve düzenleyerek toplu bir eser oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un&apos;opera tramite la selezione e l&apos;organizzazione di espressioni di altre opere.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy aggregáló mű létrehozásáért, más művek kifejezési formáinak kiválasztása és elrendezése révén.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre agrégatrice par la sélection et l’arrangement d’expressions d’autres œuvres.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra agregadora mitjançant la selecció i l’arranjament d’expressions d’altres obres.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear una obra agregada seleccionando y ordenando expresiones de otras obras.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een aggregaatwerk door middel van selectie en arrangeren van expressies van andere werken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et aggregerende verk ved å velge ut og arrangere uttrykk av andre verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et aggregerende værk ved at udvælge og arrangere udtryk af andre værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating an aggregating work by selecting and arranging expressions of other works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par darba-apkopojuma radīšanu, atlasot un sakārtojot citu darbu izteiksmes.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab liitva teose loomise eest, valides ja korrastades teiste teoste väljendused.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die für die Schaffung eines aggregierenden Werks verantwortlich ist, indem sie Expressionen anderer Werke auswählt und zusammenstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل مجمِّع عن طريق اختيار تعبيرات الأعمال الأخرى وترتيبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责把其他作品的内容表达选择和整理后创建一种合集性作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10449 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10449">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne remixeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista di remix persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er remixer</rdfs:label>
        <rdfs:label xml:lang="no">har remikser (person)</rdfs:label>
        <rdfs:label xml:lang="en">has remix artist person</rdfs:label>
        <rdfs:label xml:lang="de">hat Remix Artist (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft remixartiest-persoon</rdfs:label>
        <rdfs:label xml:lang="et">remiksija (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">remiksētājs (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">remix sanatçısı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">remixművész személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona artista de remezcla</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona artista de remescla</rdfs:label>
        <rdfs:label xml:lang="fi">uudelleenmiksaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص فنان مزج موسيقي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合成艺术家个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses eseri yaratmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un&apos;opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde. </skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创建一种音频作品的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido del trabajo original, y la mezcla de pistas grabadas para que aparezcan como una pista continua.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell&apos;opera originale, nonché il missaggio di brani registrati che appaiono come un unico brano.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10450 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10450">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne cinéaste</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvantekijä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">film üreticisi kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas veidotājs (persona)</rdfs:label>
        <rdfs:label xml:lang="et">filmitegija (isik)</rdfs:label>
        <rdfs:label xml:lang="hu">filmkészítő személye a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come cineasta persona</rdfs:label>
        <rdfs:label xml:lang="no">har filmskaper (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er filmskaber</rdfs:label>
        <rdfs:label xml:lang="en">has filmmaker person</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmemacherin/Filmemacher (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmmaker-persoon</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona cineasta</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona cineasta</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص صانع أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制片人个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bağımsız veya kişisel bir film oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un film indipendente o realizzato autonomamente.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy független- vagy egy magánfilm létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’un film indépendant ou personnel.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’una pel·lícula cinematogràfica independent o personal.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear una película independiente o personal.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het creëren van een zelfstandige of persoonlijke film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape en uavhengig eller personlig film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe en indiefilm eller personlig film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating an independent or personal film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab sõltumatu või autorifilmi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für Schaffung eines unabhängigen oder privaten Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء فيلم مستقل أو شخصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种独立或个人电影的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A filmmaker is individually responsible for the conception and execution of all aspects of the film.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir film yapımcısı, filmin tüm yönlerinin tasarlanmasından ve yürütülmesinden bireysel olarak sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een filmmaker is individueel verantwoordelijk voor de conceptie en uitvoering van alle aspecten van de film.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy filmkészítő egyénileg felelős egy film koncepciójáért és összes aspektusának végrehajtásáért.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En filmskaper har personlig ansvar for planen med og gjennomføringen av alle aspektene ved filmen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Filmas veidotājs ir pilnībā atbildīgs par visiem filmas koncepcijas un realizācijas aspektiem.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmitegija vastutab üksinda kõigi filmi aspektide kontseptsiooni ja teostamise eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmskaberen er individuelt ansvarlig for udtænkning og udførelse af alle filmens aspekter.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un cineasta es individualmente responsable de la concepción y ejecución de todos los aspectos de la película.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un cineasta è responsabile a livello individuale della concezione ed esecuzione di ogni aspetto del film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un cineasta és responsable a títol individual de la concepció i l’execució de tots els aspectes de la pel·lícula.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un cinéaste est responsable à titre individuel de la conception et de l’exécution de tous les aspects du film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">صانع أفلام مسئول مسئولية فردية عن تصور جميع جوانب الفيلم وتنفيذه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制片人对电影所有方面的构思和执行负有个人责任</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10451 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10451">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne artiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista persona </rdfs:label>
        <rdfs:label xml:lang="no">har kunstner (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er kunstner</rdfs:label>
        <rdfs:label xml:lang="en">has artist person</rdfs:label>
        <rdfs:label xml:lang="de">hat Künstlerin/Künstler (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kunstenaar-persoon</rdfs:label>
        <rdfs:label xml:lang="et">kunstnik (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">mākslinieks (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">művész személye a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">sanatçı ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">taiteilija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona artista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona artista</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص فنان</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有美术家个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, özgün bir grafik tasarım, çizim, boyama vb. oluşturmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della creazione di un un progetto grafico, schizzo, dipinto originali, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy eredeti grafikai terv, rajz, festmény, stb. megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la création d’un graphisme, d’une peinture, d’un dessin, etc. original.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la creació d’un disseny gràfic, un dibuix, una pintura, etc., original.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de crear un diseño gráfico original, dibujo, pintura, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is het maken van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for å skape et originalt grafisk design, en tegning, et maleri etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at skabe et originalt grafisk design, -tegning, -maleri etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for creating an original graphic design, drawing, painting, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par darba radīšanu un īstenošanu, izmantojot oriģinālu grafisko dizainu, zīmēšanu, gleznošanu, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab originaalse graafilise kujunduse, joonistuse, maali vms loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن إنشاء تصميم رسومي، أو رسم، أو تصوير زيتي أصلي، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责完成原创图形设计、绘图、绘画等的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10452 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10452">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne fondatrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba dibinātājs (persona)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kurucu kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fondatore persona di opera</rdfs:label>
        <rdfs:label xml:lang="no">har grunnlegger av verk (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er stifter af værk</rdfs:label>
        <rdfs:label xml:lang="en">has founder person of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Begründerin/Begründer eines Werks (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft oprichter-persoon van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű alapító személye a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen perustaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">teose asutaja (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona fundadora de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona fundadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مؤسس عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创办者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eseri başlatmaktan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile dell&apos;avvio di un&apos;opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy diakronikus mű indításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa diakronisen teoksen alullepanosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de lancer une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable d’iniciar una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que se encarga de iniciar una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het initiëren van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som har ansvar for å etablere et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for at igangsætte et diakronisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for initiating a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab diakroonilise teose ellukutsumise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für das Begründen eines diachronen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن بدء عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责发起一种历时作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10453 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10453">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne directrice de casting</rdfs:label>
        <rdfs:label xml:lang="lv">aktieru atlases režisors (persona)</rdfs:label>
        <rdfs:label xml:lang="et">casting&apos;u juht (isik)</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore del casting persona</rdfs:label>
        <rdfs:label xml:lang="no">har casting director (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er caster</rdfs:label>
        <rdfs:label xml:lang="en">has casting director person</rdfs:label>
        <rdfs:label xml:lang="de">hat Casting Director (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft castingdirector-persoon</rdfs:label>
        <rdfs:label xml:lang="tr">kast yönetmeni ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">roolittaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">szereposztó rendező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona directora de casting</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona directora de càsting</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مدير طاقم تمثيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有角色导演个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, sanatçılara rol ve görev atamanın çoğu yönünden sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della maggior parte degli aspetti relativi all&apos;assegnazione di parti e compiti agli interpreti. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la majoria dels aspectes de l’assignació de parts i funcions als intèrprets.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de la mayoría de los aspectos de la asignación de partes y deberes a los artistas intérpretes o ejecutantes.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for de fleste aspekter ved å fordele roller og oppgaver mellom utøvere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for de fleste aspekter ved tildeling af roller og ansvar til udøvere.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for most aspects of assigning parts and duties to performers.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par lomu sadali un pienākumu piešķiršanu izpildītājiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab enamiku aspektide eest esitajatele rollide ja ülesannete jagamisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن معظم جوانب تخصيص الأدوار والواجبات للمؤدين.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种资源与负责给演员分配角色和任务的大多数工作的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10454 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10454">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne productrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore persona </rdfs:label>
        <rdfs:label xml:lang="da">har person, som er producer</rdfs:label>
        <rdfs:label xml:lang="no">har produsent (person)</rdfs:label>
        <rdfs:label xml:lang="en">has producer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-persoon</rdfs:label>
        <rdfs:label xml:lang="lv">producents (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">producer személye a következő:</rdfs:label>
        <rdfs:label xml:lang="et">produtsent (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona productora</rdfs:label>
        <rdfs:label xml:lang="fi">tuottaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona productora</rdfs:label>
        <rdfs:label xml:lang="tr">yapımcı kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منتج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制作者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir prodüksiyonun ticari yönlerinin çoğundan sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que es responsable de la mayoría de los aspectos comerciales de una producción para pantalla, grabación de sonido, televisión, webcast, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن معظم جوانب العمل في الإنتاج للسينما، أو للتسجيل الصوتي، أو للتليفزيون، أو للبث عبر الإنترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个个人关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Generalmente un produttore è responsabile della raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un productor generalmente es responsable de recaudar fondos, gestionar la producción, contratar personal clave, gestionar los distribuidores, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10455 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10455">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne réalisatrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er instruktør</rdfs:label>
        <rdfs:label xml:lang="no">har regissør (person)</rdfs:label>
        <rdfs:label xml:lang="en">has director person</rdfs:label>
        <rdfs:label xml:lang="de">hat Regisseurin/Regisseur (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft regisseur-person</rdfs:label>
        <rdfs:label xml:lang="fi">ohjaaja (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">rendező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">režisors (persona)</rdfs:label>
        <rdfs:label xml:lang="et">režissöör (isik)</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona directora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona realitzadora</rdfs:label>
        <rdfs:label xml:lang="tr">yönetmen kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص مخرج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有导演个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla persona responsabile della gestione generale e della supervisione di un&apos;interpretazione cinematografica, programma radiofonico o televisivo, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que és responsable de la gestió general i la supervisió d’una actuació filmada, un programa radiofònic o de televisió, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que tiene a su cargo la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som er ansvarlig for generell ledelse av en filmet forestilling, et radio- eller fjernsynsprogram, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص مسئول عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责电影表演、广播或电视节目等的全面管理和监督的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10456 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10456">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne émettrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente persona</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er udstedende organ</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (person)</rdfs:label>
        <rdfs:label xml:lang="en">has issuing person</rdfs:label>
        <rdfs:label xml:lang="de">hat herausgebende Person</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvaardiger-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="hu">kibocsátó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">piyasaya çıkaran kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona emisora</rdfs:label>
        <rdfs:label xml:lang="lv">turpinājumizdevuma izdevējs (persona)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona d’entitat editora</rdfs:label>
        <rdfs:label xml:lang="et">väljaandja (isik)</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص جهة إصدار</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有颁布个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eseri yayıınlayan kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una  persona che emette un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki kibocsát egy művet.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka julkaisee teoksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui publie une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que publica una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que emite una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die een werk uitvaardigt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som utgir et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som udgiver et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who issues a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura izdevusi darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes annab teose välja.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die ein Werk heraus gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يصدر عملاً.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与颁布一种作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10457 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10457">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne organisatrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come organizzatore persona</rdfs:label>
        <rdfs:label xml:lang="no">har arrangør (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er arrangør</rdfs:label>
        <rdfs:label xml:lang="en">has organizer person</rdfs:label>
        <rdfs:label xml:lang="de">hat Veranstalterin/Veranstalter (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft organisator-persoon</rdfs:label>
        <rdfs:label xml:lang="fi">järjestäjä (henkilö)</rdfs:label>
        <rdfs:label xml:lang="et">korraldaja (isik)</rdfs:label>
        <rdfs:label xml:lang="tr">organizatör kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">organizētājs (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">szervező személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona organizadora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona organitzadora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص منظِم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有组织者个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser yol açan bir konferans, sergi veya başka bir etkinlik düzenleyen kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona che organizza una conferenza, mostra o altro evento, che dà origine a un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki egy mű létrejöttét eredményező konferenciát, kiállítást vagy egyéb eseményt szervez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui organise un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que organitza un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que organiza una conferencia, exposición u otro evento que dé origen a una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die organiseert een conferentie, tentoonstelling of andere gebeurtenis die aanleiding geeft tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som organiserer en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som organiserer en konference, udstilling eller anden begivenhed, som giver anledning til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who organizes a conference, exhibition, or other event that gives rise to a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura organizējusi konferenci, izstādi vai citu pasākumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes korraldab teosele aluse pannud konverentsi, näituse vm ürituse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert beziehungsweise veranstaltet, aus der/dem ein Werk hervorgeht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص ينظم مؤتمرًا، أو معرضًا، أو أي حدث آخر ينتج عنه عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与组织会议、展览或其他事件以产生一种作品的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10458 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10458">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour personne consultante</rdfs:label>
        <rdfs:label xml:lang="fi">asiantuntija (henkilö)</rdfs:label>
        <rdfs:label xml:lang="tr">danışman ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come consulente persona</rdfs:label>
        <rdfs:label xml:lang="no">har konsulent (person)</rdfs:label>
        <rdfs:label xml:lang="da">har person, som er rådgiver</rdfs:label>
        <rdfs:label xml:lang="en">has consultant person</rdfs:label>
        <rdfs:label xml:lang="de">hat Beraterin/Berater (Person)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft consultant-persoon</rdfs:label>
        <rdfs:label xml:lang="et">konsultant (isik)</rdfs:label>
        <rdfs:label xml:lang="lv">konsultants (persona)</rdfs:label>
        <rdfs:label xml:lang="hu">tanácsadó személye a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene persona consultora</rdfs:label>
        <rdfs:label xml:lang="ca">té com a persona consultora</rdfs:label>
        <rdfs:label xml:lang="ar">له شخص استشاري</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有顾问个人</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eseri yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmetleri sunan ve genellikle önerilerde bulunan bir kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una persona che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come creatore di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy személyhez, aki tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen henkilöön, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une personne qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una persona que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una persona que brinda servicios de consulta, y a menudo hace recomendaciones, para un agente relacionado que está representado como creador de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een persoon die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en person som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en person, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a person who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar personu, kura sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose isikuga, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Person, die Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وشخص يقدم خدمات استشارية، وغالبًا ما يقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个个人关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10462 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10462">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif directeur de la photographie</rdfs:label>
        <rdfs:label xml:lang="tr">görüntü yönetmeni kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore della fotografia agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har filmfotograf (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er filmfotograf</rdfs:label>
        <rdfs:label xml:lang="en">has director collective agent of photography</rdfs:label>
        <rdfs:label xml:lang="de">hat Kamerafrau/Kameramann (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cameraregisseur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">kinooperators (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">operaator-lavastaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="hu">operatőr kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene director agente colectivo de fotografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu director de fotografia</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مدير تصوير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有摄影指导集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, elektronik olarak veya film ya da video stoğu üzerinde görüntü kaydeden ve genellikle ışıklandırmayı seçen ve düzenleyen bir kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo che cattura le immagini sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que captura imágenes, ya sea electrónicamente o en películas o videos, y a menudo selecciona y organiza la iluminación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يلتقط الصور، إما إلكترونيًا، أو على فيلم، أو مقاطع فيديو، وغالبًا ما يختار الإضاءة ويرتبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A director of photography for a movie is also called a chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Al director de fotografía de una película también se le llama jefe de fotografía.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy film operatőrét vezető operatőrnek is nevezik.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Kamerafrau/Ein Kameramann für einen Film wird auch als &quot;Bildregisseurin/Bildregisseur&quot; bezeichnet.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Filmfotografen for en film kalles også sjefsfotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmfotografen på en film kaldes også for en cheffotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Kinooperatoru mēdz saukt arī par galveno operatoru.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un director de fotografia d’una pel·lícula també s’anomena primer operador.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un direttore della fotografia in un film è detto anche capo operatore.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">电影的摄影指导也称总摄影师</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10463 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10463">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif recherchiste</rdfs:label>
        <rdfs:label xml:lang="tr">araştırmacı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come ricercatore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har forsker (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er researcher</rdfs:label>
        <rdfs:label xml:lang="en">has researcher collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Forscherin/Forscher (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderzoeker-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="hu">kutató kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pētnieks (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo investigador</rdfs:label>
        <rdfs:label xml:lang="fi">tutkija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu investigador</rdfs:label>
        <rdfs:label xml:lang="et">uurija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي باحث</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有研究者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin oluşturulmasını desteklemek için araştırma yapan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo che svolge ricerche a supporto della creazione di un&apos;opera.  </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely kutatást végez egy mű megalkotásának támogatására.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka tukee teoksen syntymistä tutkimuksellaan.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui effectue des recherches pour aider à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que fa recerca per donar suport a la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que realiza investigaciones en apoyo a la creación de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die onderzoek doet ter ondersteuning van de creatie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som forsker som bidrag til å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som udfører research til at understøtte skabelsen af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who does research in support of the creation of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas veikusi pētniecību darba radīšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes teeb teose loomise heaks uurimistööd.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der Forschung betreibt, um das Schaffen eines Werks zu unterstützen.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يجري بحوث لدعم إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与从事研究以支持一种作品的创作的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10464 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10464">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif directeur de publication</rdfs:label>
        <rdfs:label xml:lang="hu">főszerkesztő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">galvenais redaktors (grupa)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er ansvarshavende redaktør</rdfs:label>
        <rdfs:label xml:lang="no">har redaksjonssjef (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has editorial director collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Chefredakteurin/Chefredakteur (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft hoofdredacteur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">peatoimetaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo director editorial</rdfs:label>
        <rdfs:label xml:lang="fi">toimituspäällikkö (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu director editorial</rdfs:label>
        <rdfs:label xml:lang="tr">yayın yönetmeni kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مدير تحرير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主编集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eserin yayın politikası ve içeriği için yasal veya fikri sorumluluğu olan ancak yaratıcı sorumluluğu olmayan bir kolektif temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amelynek jogi vagy szellemi, de nem alkotói felelőssége van egy diakronikus mű szerkesztési politikájáért és tartalmáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui a la responsabilité légale ou intellectuelle, mais non la responsabilité créative, de la politique éditoriale et du contenu d’une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que té responsabilitat legal o intel·lectual, però no responsabilitat creativa, de la política editorial i el contingut d’una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que tiene responsabilidad jurídica o intelectual, pero no creativa, por la política editorial y el contenido de una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die wettelijke of intellectuele verantwoordelijkheid, maar niet creatieve verantwoordelijkheid heeft voor het redactioneel beleid en content van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som har juridisk eller intellektuelt ansvar, bortsett fra kreativt ansvar, for det redaksjonelle innholdet i et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er juridisk eller intellektuelt ansvarlig, men ikke skabelsesansvarlig, for et diakronisk værks redaktionelle linje og indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who has legal or intellectual responsibility, but not creative responsibility, for the editorial policy and content of a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kam ir juridiska vai intelektuāla, bet ne radoša atbildība par diahroniskā darba izdošanas politiku un saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes juriidiliselt või intellektuaalselt, kuid mitte loominguliselt vastutab diakroonilise teose toimetamispõhimõtete ja sisu eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der die rechtliche oder intellektuelle, aber keine kreative, Verantwortung für die redaktionelle Vorgehensweise und den Inhalt eines diachronen Werks trägt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يتحمل مسئولية قانونية أو فكرية، ولكن لا يتحمل مسئولية إبداعية، عن السياسة التحريرية ومحتوى عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与有对一种历时作品的编辑政策和内容的法律或知识责任（但非创作责任）的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Bir eserin anlatımının gözden geçirilmesi, netleştirilmesi veya içeriğinin başka bir şekilde değiştirilmesi hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darbība neietver darba izteiksmes satura pārskatīšanu, precizēšanu vai cita veida izmaiņas u. tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen nicht Überarbeitungen, Erläuterungen oder andere inhaltliche Änderungen an einer Expression eines Werks.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu parandamist, täpsustamist ega muude muudatuste tegemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Herziening, toelichting of andere verandering van content van een expressie van een werk is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La révision, la clarification ou toute autre modification du contenu d’une expression d’une œuvre sont exclues.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele egy mű kifejezési formájának revíziója, áttekintése, vagy egyéb tartalmi változtatása.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Revision, clarification, or other change of content of an expression of a work is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revision, indholdspræcisering eller anden ændring af indholdet af et værks udtryk er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la revisión, aclaración u otro cambio de contenido de una expresión de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la revisió, l’aclariment o qualsevol altre canvi del contingut d’una expressió d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Å redigere innholdet i et uttrykk av et verk eller gjøre det klarere er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل، أو توضيحه، أو أي تغيير آخر فيه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括对一种作品的一种内容表达之内容的修订、说明或其他变化。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10465 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10465">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif réalisateur de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvaohjaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">film yönetmeni kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">filmirežissöör (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="hu">filmrendező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har filmregissør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er filminstruktør</rdfs:label>
        <rdfs:label xml:lang="en">has film director collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmregisseurin/Filmregisseur (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmregisseur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">kinorežisors (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo director de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu director cinematogràfic</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مخرج أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影导演集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın genel yönetimi ve denetiminden sorumlu yönetmen olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo regista responsabile della gestione e supervisione generali di un&apos;interpretazione cinematografica. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező kollektív ágenshez, amely felelős egy filmre vett előadás általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on ohjaaja, joka on vastuussa elokuvatun esityksen yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif réalisateur qui est responsable de la gestion et de la supervision générales d’une prestation filmée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un director que és responsable de la gestió i la supervisió d’una actuació filmada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un director que se encarga de la dirección general y supervisión de una actuación filmada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een gefilmde uitvoering.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er regissør med ansvar for generell ledelse av en filmet forestilling.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is a director who is responsible for the general management and supervision of a filmed performance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par uzfilmētā pasākuma vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on filmitava etenduse üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Gemeinschaftlicher Akteur), die/der für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مديرًا مسئولاً عن الإدارة العامة والإشراف على الأداء المصور.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责拍摄表演的总体管理和监督的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10466 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10466">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif réalisateur de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista radiofonico agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er radioregissør</rdfs:label>
        <rdfs:label xml:lang="no">har radioregissør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has radio director collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkregisseurin/Hörfunkregisseur (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioregisseur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">raadiorežissöör (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma direktors (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">radio-ohjaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yönetmeni kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádiós rendező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo director de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu realitzador radiofònic</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مخرج إذاعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播导演集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının genel yönetimi ve denetiminden sorumlu yönetmen olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo regista responsabile della gestione generale e della supervisione di un programma radiofonico. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező kollektív ágenshez, amely felelős egy rádióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif réalisateur qui est responsable de la gestion et de la supervision générales d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un realitzador que és responsable de la gestió i supervisió d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un director que tiene a su cargo la dirección general y supervisión de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er regissør med ansvar for generell ledelse av et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is a director who is responsible for the general management and supervision of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu - direktors, kura atbildīga par radio raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on raadiosaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regiesseurin/einem Regisseur (Gemeinschaftlicher Akteur), die/der für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مديرًا مسئولاً عن الإدارة العامة والإشراف على برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责广播节目的总体管理和监督的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10467 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10467">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif réalisateur de télévision</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista televisivo agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsregissør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er tv-regissør</rdfs:label>
        <rdfs:label xml:lang="en">has television director collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehregisseurin/Fernsehregisseur (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieregisseur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">telerežissöör (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">televisio-ohjaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yönetmeni kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televíziós rendező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma režisors (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo director de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu realitzador de televisió</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مخرج تليفزيوني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视导演集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının genel yönetimi ve denetiminden sorumlu yönetmen olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo regista responsabile della gestione generale e della supervisione di un programma televisivo. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező kollektív ágenshez, amely felelős egy televízióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on ohjaaja, joka on vastuussa televisio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif réalisateur qui est responsable de la gestion et de la supervision générales d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un realitzador que és responsable de la gestió i supervisió d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un director que tiene a su cargo la dirección general y supervisión de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er regissør med ansvar for generell ledelse av et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is a director who is responsible for the general management and supervision of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu - režisors, kura ir atbildīga par televīzijas raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on telesaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regiesseurin/einem Regisseur (Gemeinschaftlicher Akteur), die/der für das allgemeine Management und die Leitung einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مديرًا مسئولاً عن الإدارة العامة والإشراف على برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责电视节目的总体管理和监督的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10468 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10468">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif producteur audio</rdfs:label>
        <rdfs:label xml:lang="hu">audioproducer kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">audioprodutsent (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore audio agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er lydproducer</rdfs:label>
        <rdfs:label xml:lang="no">har lydprodusent (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has audio producer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten einer Tonaufnahme (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geluidsproducent-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">ses yapımcısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņu ierakstu producents (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo productor de audio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu productor d’àudio</rdfs:label>
        <rdfs:label xml:lang="fi">äänituottaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منتج صوت</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音频制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ses kaydının ticari yönlerinin çoğunu yönetmekten sorumlu yapımcı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo produttore responsabile della gestione della maggior parte degli aspetti commerciali di una registrazione audio. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer kollektív ágenshez, amely felelős egy hangfelvétel üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif producteur qui est responsable de gérer la majeure partie des aspects commerciaux d’un enregistrement audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un productor que és responsable de la gestió de la majoria dels aspectes comercials d’un enregistrament àudio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un productor que se encarga de gestionar la mayoría de los aspectos comerciales de una grabación de audio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en produsent som er ansvarlig for de fleste forretningsmessige aspektene ved et lydopptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en producer, som er ansvarlig for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is a producer who is responsible for managing most of the business aspects of an audio recording. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir producents, kas ir atbildīgs par skaņu ieraksta biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes produtsendina vastutab enamiku äriliste aspektide korraldamise eest helisalvestusel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Gemeinschaftlicher Akteur), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون منتجًا مسئولاً عن إدارة معظم جوانب العمل في تسجيل صوتي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个制作者并负责音频录制工作大多数方面商业运作之管理的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10469 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10469">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif producteur de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvatuottaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">film yapımcısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas producents (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">filmiprodutsent (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="hu">filmproducer kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore cinematografico agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har filmprodusent (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er filmproducer</rdfs:label>
        <rdfs:label xml:lang="en">has film producer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmproduzentin/Filmproduzenten (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmproducent-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo productor de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu productor cinematogràfic</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منتج أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir filmin yapımının ticari yönlerinin çoğundan sorumlu yapımcı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo produttore responsabile della gestione della maggior parte degli aspetti commerciali di un film. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer kollektív ágenshez, amely felelős egy filmprodukció üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif producteur qui est responsable de la majeure partie des aspects commerciaux de la production d’un film.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un productor que es responsable de la mayoría de los aspectos comerciales de la producción de una película.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved en film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is a producer who is responsible for most of the business aspects of the production of a film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par filmas uzņemšanas finansiālajiem aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Gemeinschaftlicher Akteur), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون منتجًا مسئولاً عن معظم جوانب العمل في إنتاج فيلم.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电影制作的大部分商业运作的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10470 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10470">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif producteur de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore radiofonico agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er radioproducer</rdfs:label>
        <rdfs:label xml:lang="no">har radioprodusent (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has radio producer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkproduzentin/Hörfunkproduzenten (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioproducent-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">raadioprodutsent (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma producents (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">radiotuottaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yapımcısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádióproducer kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo productor de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu productor radiofònic</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منتج إذاعي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının ticari yönlerinin çoğundan sorumlu yapımcı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo produttore responsabile della gestione della maggior parte degli aspetti commerciali di un programma radiofonico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer kollektív ágenshez, amely felelős egy rádióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif producteur qui est responsable de la majeure partie des aspects commerciaux d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un productor que és responsable de la majoria dels aspectes comercials d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un productor que se encarga de la mayor parte de los aspectos comerciales de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is a producer who is responsible for most of the business aspects of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu - producents, kurš ir atbildīgs par radio raidījuma darbības/biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes produtsendina vastutab enamiku äriliste aspektide eest raadiosaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Gemeinschaftlicher Akteur), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون منتجًا مسئولاً عن معظم جوانب العمل في برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责广播节目的大部分商业运作的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10471 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10471">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif producteur de télévision</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore televisivo agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsprodusent (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er tv-producer</rdfs:label>
        <rdfs:label xml:lang="en">has television producer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehproduzentin/Fernsehproduzenten (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieproducent-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">teleprodutsent (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">televisiotuottaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yapımcısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televízióproducer kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma producents (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo productor de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu productor de televisió</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منتج تليفزيوني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının ticari yönlerinin çoğundan sorumlu yapımcı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo produttore responsabile della gestione della maggior parte degli aspetti commerciali di un programma televisivo. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer kollektív ágenshez, amely felelős egy televízióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on tuottaja, joka on vastuussa suurimmasta osasta televisio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif producteur qui est responsable de la majeure partie des aspects commerciaux d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un productor que és responsable de la majoria dels aspectes comercials d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un productor que se encarga de la mayor parte de los aspectos comerciales de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is a producer who is responsible for most of the business aspects of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu - producents, kura atbildīga par televīzijas raidījuma biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes produtsendina vastutab enamiku äriliste aspektide eest telesaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Gemeinschaftlicher Akteur), die/der für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون منتجًا مسئولاً عن معظم جوانب العمل في برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电视节目的大部分商业运作的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10472 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10472">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif architecte paysagiste</rdfs:label>
        <rdfs:label xml:lang="lv">ainavu arhitekts (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto del paesaggio agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er landskabsarkitekt</rdfs:label>
        <rdfs:label xml:lang="no">har landskapsarkitekt (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has landscape architect collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Landschaftsarchitektin/Landschaftsarchitekten (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landschapsarchitect-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">maastikuarhitekt (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">maisema-arkkitehti (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">peyzaj mimarı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo arquitecto paisajista</rdfs:label>
        <rdfs:label xml:lang="hu">tájépítész kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu arquitecte paisatgista</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مهندس تنسيق مواقع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有景观设计师集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, peyzaj işleri yaratmaktan sorumlu mimar olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo architetto responsabile della creazione di opere paesaggistiche. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy építész kollektív ágenshez, amely felelős tájépítészeti művek létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’œuvres paysagères.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un arquitecte que és responsable de la creació d’obres paisatgístiques.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un arquitecto que se encarga de crear obras paisajísticas.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een architect is die verantwoordelijk is voor het creëren van landschapswerken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en arkitekt med ansvar for å skape landskapsverk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en arkitekt, som er ansvarlig for at skabe landskabsværker.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an architect who is responsible for creating landscape works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par ainavu darbu veidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes arhitektina vastutab maastikuteoste loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Architektin/einem Architekten (Gemeinschaftlicher Akteur), die/der für die Schaffung landschaftlicher Werke verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مهندسا معماريا مسئولاً عن إنشاء أعمال تنسيق المواقع.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为建筑师并负责创建景观作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10473 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10473">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif calligraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come calligrafo agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har kalligraf (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er kalligraf</rdfs:label>
        <rdfs:label xml:lang="en">has calligrapher collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Kalligrafin/Kalligrafen (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kalligraaf-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">kaligraf kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kaligrāfs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">kalligraaf (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">kalligrafi (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">kalligráfus kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo calígrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu cal·lígraf</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي خطاط</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有书法者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, aynı temsilcinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlık veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan kolektif bir temsilci ile ilişkilendirir</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo che è l&apos;artista responsabile della calligrafia, laddove l&apos;oggetto dell&apos;interesse risiede nel valore estetico della calligrafia o della maestria grafica, a prescindere dal fatto che lo stesso agente collettivo sia anche responsabile del testo inscritto. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész kollektív ágenshez, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a kollektív ágens a lejegyzett szöveg szerzője is egyben vagy sem.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama yhteistoimija myös vastuussa kirjoitetusta tekstistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que le même agent collectif soit aussi responsable du texte calligraphié.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si el mateix agent col·lectiu és també responsable del text inscrit.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de que el mismo agente colectivo sea también responsable del texto inscrito.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde collectieve actor ook verantwoordelijk is voor de inscriptie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same collective agent is also responsible for the inscribed text.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu mākslinieks, ir atbildīga par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīga arī par uzrakstīto tekstu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama kollektiiv on vastutav ka kirjutatud teksti eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Gemeinschaftlicher Akteur), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob derselbe gemeinschaftliche Akteur auch für den aufgeschriebenen Text verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون فنانا مسئولاً عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الوكيل الجماعي نفسه مسئولاً أيضًا عن النص المدرج.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一行为者是否负责题写文字）的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10474 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10474">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif sculpteur</rdfs:label>
        <rdfs:label xml:lang="it">ha come scultore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er skulptør</rdfs:label>
        <rdfs:label xml:lang="no">har skulptør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has sculptor collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Bildhauerin/Bildhauer (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft beeldhouwer-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">heykeltıraş kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">kuvanveistäjä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">skulptor (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="hu">szobrász kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo escultor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu escultor</rdfs:label>
        <rdfs:label xml:lang="lv">tēlnieks (grupa)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي نحات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕塑家集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, modelleme, oyma veya benzeri bir teknikle üç boyutlu bir eser oluşturmaktan sorumlu bir sanatçı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo artista responsabile della creazione di un&apos;opera tridimensionale tramite modellatura, intaglio o tecnica simile. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész kollektív ágenshez, amely felelős egy háromdimenziós mű megalkotásáért modellezési, faragási vagy hasonló technikával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif artiste qui est responsable de la création d’une œuvre tridimensionnelle par le modelage, la taille ou une technique similaire.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un artista que és responsable de la creació d’una obra tridimensional mitjançant l’escultura, la talla o una tècnica similar.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un artista que se encarga de crear una obra tridimensional mediante modelado, tallado o técnica similar.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een kunstenaar is die verantwoordelijk is voor het creëren van driedimensionaal modelleren, snijden of gelijksoortige techniek.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en kunstner med ansvar for å skape et tredimensjonalt verk gjennom modellering, utskjæring eller lignende teknikker.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en kunstner, som er ansvarlig for at skabe et tredimensionelt værk vha. modellering, udskæring eller lignende teknik.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an artist who is responsible for creating a three-dimensional work by modeling, carving, or similar technique.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu - mākslinieks, kura ir atbildīga par trīsdimensiju darba radīšanu, to veidojot, grebjot vai izmantojot līdzīgu tehniku.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on modelleerimise, nikerdamise või muu säärase tehnika teel loodud kolmemõõtmelise teose eest vastutav kunstnik.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Gemeinschaftlicher Akteur), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون فنانًا مسئولاً عن إنشاء عمل ثلاثي الأبعاد من خلال النمذجة، أو النحت، أو تقنية مشابهة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家并通过模型、雕刻或类似技术负责创建一种三维作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10475 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10475">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif artiste du livre</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatu mākslinieks (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come book artist agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har bokkunstner (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er bogkunstner</rdfs:label>
        <rdfs:label xml:lang="en">has book artist collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchkünstlerin/Buchkünstler (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekkunstenaar-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">kirjataiteilija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">kitap sanatçısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvművész kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukunstnik (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo artista del libro</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu artista de llibre d’art</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي فنان كتب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书美术家集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu bir sanatçı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész kollektív ágenshez, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és una artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un artista que se encarga de explotar la forma del libro o alterar su estructura física.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an artist who is responsible for exploiting the book form or altering its physical structure.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas atbild par grāmatas kā mākslas darba radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Gemeinschaftlicher Akteur), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physische Struktur verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون فنانا مسئولاً عن استغلال شكل الكتاب أو تغيير هيكله المادي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10476 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10476">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif scénariste</rdfs:label>
        <rdfs:label xml:lang="hu">forgatókönyvíró kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come sceneggiatore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er manuskriptforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har manusforfatter (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has screenwriter collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Drehbuchautorin/Drehbuchautor (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft scenarioschrijver-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">käsikirjoittaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="lv">scenārists (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">senarist kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">stsenarist (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo de guionistas</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu guionista</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي كاتب سيناريو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有影视剧编剧集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, senaryo, metin veya sahne yazarı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo, che è autore di una sceneggiatura, copione o scena.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely szerzője egy forgatókönyvnek, szövegkönyvnek vagy jelenetnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on käsikirjoituksen tai kohtauksen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif auteur d’un scénario, d’un script ou d’une scène.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un autor d’un guió, un argument o una escena.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es autor de un guión, escrito o escena.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een auteur is van een scenario, script of scène.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en forfatter av et skuespill, et manuskript eller en scene.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er forfatter af et manuskript, drejebog eller scene.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an author of a screenplay, script, or scene.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir scenārija, uzveduma plāna vai ainas autors.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on stsenaariumi või stseeni autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur) eines Drehbuchs, eines Skripts oder einer Szene.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مؤلف سيناريو، أو نص، أو مشهد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为影视剧剧本、脚本或场景著者的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10477 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10477">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif parolier</rdfs:label>
        <rdfs:label xml:lang="hu">dalszövegíró kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">dziesmas teksta autors (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come paroliere agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er tekstforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har sangtekstforfatter (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has lyricist collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Textdichterin/Textdichter (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft liedtekstschrijver-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">sanoittaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">sõnade autor (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="tr">söz yazarı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo letrista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu lletrista</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مؤلف أغاني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作词者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzikalin şarkısı da dahil popüler bir şarkının sözlerinin yazarı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo autore delle parole di una canzone pop, inclusa una canzone di un musical.  </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif auteur des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es autor de la letra de una canción popular, incluida una canción de un musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an author of the words of a popular song, including a song from a musical.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir dziesmas vārdu autors, ieskaitot dziesmas no mūzikla.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on levilaulu (k.a laul muusikalist) sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مؤلف كلمات أغنية شعبية، بما في ذلك أغنية من مسرحية موسيقية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of only the dialogue from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca diyaloglarının yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å bare skrive dialogen fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore dei soli dialoghi di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali dialoogide kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkän musikaalin dialogin kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun dialogen i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de dialogen uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musical párbeszédeinek szerzősége nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver mūzikla dialogus.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría únicamente del diálogo de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només el diàleg d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف الحوار فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是对话的著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10478 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10478">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif librettiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come librettista agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er librettist</rdfs:label>
        <rdfs:label xml:lang="no">har librettist (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has librettist collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Librettistin/Librettisten (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft librettist-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">libretist (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="fi">libretisti (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="lv">libretists (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">librettista kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">libretto yazarı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo libretista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu llibretista</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مؤلف أوبرالي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有台本作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, opera, bale veya müzikal sahnesi için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo autore delle parole di un musical o opera coreografica, come un&apos;opera, balletto, o altra opera per il teatro musicale, o per un oratorio. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző kollektív ágenshez, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif auteur des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent que és un autor de les paraules d’un musical o una obra coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es autor de la letra de una obra musical o coreográfica como una ópera, un ballet u otra obra para la escena musical, o un oratorio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مؤلف كلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为歌剧、芭蕾等音乐或编舞作品或其他舞台音乐作品或者清唱剧的歌词的著者的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of the words of only the songs from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore delle parole delle sole canzoni di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali laulusõnade kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun sangteksterne i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musicaldalok szövegírója nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atsevišķu dziesmu tekstus mūziklos.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría de la letra únicamente de las canciones de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només les paraules de les cançons d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是歌曲的词著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10479 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10479">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif rapporteur</rdfs:label>
        <rdfs:label xml:lang="et">aruande koostaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="it">ha come relatore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er rapportør</rdfs:label>
        <rdfs:label xml:lang="no">har rapportør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has rapporteur collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Berichterstatterin/Berichterstatter (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft rapporteur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">kokousten raportoija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">raportör kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">raportőr kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo relator</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu relator</rdfs:label>
        <rdfs:label xml:lang="lv">ziņotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مقرر</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有会务报告人集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kuruluş tarafından toplantılarının işleyişi hakkında rapor vermek üzere atanan bir yazar olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo autore incaricato da un&apos;organizzazione di compilare rapporti sugli atti dei suoi incontri. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző kollektív ágenshez, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif auteur qui est nommé par une organisation pour rédiger les comptes rendus de ses réunions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es un autor que es designado por una organización para informar sobre los procedimientos de sus reuniones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is an author who is appointed by an organization to report on the proceedings of its meetings.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Gemeinschaftlicher Akteur), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个著者并被一个组织指定为在其会议文集中报告的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="no">Ansvar som er begrenset til å ta møtereferater, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; esclusa la responsabilità limitata alla redazione dei verbali.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma vastutust, mis on piiratud ainult protokollimisega.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atbildību protokolēt.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele a jegyzőkönyvvezetésre korlátozódó szerzőség.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter ikke ansvar begrænset til at tage referat.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Responsibility limited to taking minutes is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la responsabilidad limitada a levantar minutas.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la responsabilitat que es limita a prendre notes.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Tutanak tutmakla sınırlı sorumluluk hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une responsabilité limitée à rédiger un procès-verbal est exclue.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Verantwoordelijkheid beperkt tot het notuleren is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括仅限于写会议记录的责任。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10481 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10481">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif chorégraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come coreografo agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er koreograf</rdfs:label>
        <rdfs:label xml:lang="no">har koreograf (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has choreographer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Choreografin/Choreografen (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft choreograaf-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">koreograaf (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="tr">koreograf kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">koreografi (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfus kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo coreógrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu coreògraf</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مصمم رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir koreografik eser yaratmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile di un&apos;opera coreografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy koreografikus mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa koreografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre chorégraphique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra coreogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra coreográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een choreografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et koreografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for et koreografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a choreographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par horeogrāfisku darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab koreograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines choreografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن ابتكار عمل راقص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种编舞作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10482 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10482">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif cartographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba kartogrāfs (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kartograf kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come cartografo agente collettivo di opera</rdfs:label>
        <rdfs:label xml:lang="no">har kartograf for verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er kartograf for værk</rdfs:label>
        <rdfs:label xml:lang="en">has cartographer collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Kartografin/Kartografen eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cartograaf-collectieve actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű térképész kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen kartantekijä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose kartograaf (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cartográfo agente colectivo de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu cartògraf d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي رسام خرائط لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的地图绘制者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kartografik eser oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile di un&apos;opera cartografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy kartográfiai mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa kartografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre cartographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra cartogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra cartográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een cartografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for et kartografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for et kartografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a cartographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par karti, atlantu, globusu vai citu kartogrāfijas materiālu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab kartograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines kartografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل خرائطي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种地图作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10483 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10483">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif auteur</rdfs:label>
        <rdfs:label xml:lang="lv">autors (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come autore agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har forfatter (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er forfatter</rdfs:label>
        <rdfs:label xml:lang="en">has author collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Verfasserin/Verfasser (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft auteur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">kirjoittaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">szerző kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">tekstteose autor (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo autor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu autor</rdfs:label>
        <rdfs:label xml:lang="tr">yazar kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مؤلف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有著者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, metinsel bir eser oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile di un&apos;opera testuale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy szöveges mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa tekstiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre textuelle.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra textual.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra textual.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren een tekstwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for et tekstlig verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for et tekstværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a textual work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par tekstuālu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab tekstteose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines textlichen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل نصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种文字作品的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Başka bir yaratıcıya ait eserlerin yeniden yazılması, yeniden ifade edilmesi veya uyarlanması yoluyla, eğer yapılan değişiklik orijinal eserin niteliğini ve içeriğini önemli ölçüde değiştirmişse ya da ifade ortamını dönüştürmüşse, yeni bir eser oluşturulması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy új mű megalkotása egy másik alkotó munkáinak átfogalmazásával, újraírásával vagy adaptálásával, ha a módosítás lényegesen megváltoztatta az eredeti jellegét és tartalmát, vagy a kifejezési forma médiumát.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Creatie van een nieuw werk door het parafraseren, herschrijven of bewerken van werken van een andere maker, als de wijziging de aard en content van het origineel substantieel gewijzigd heeft of het medium van expressie gewijzigd heeft, is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Creation of a new work by paraphrasing, rewriting, or adapting works by another creator, if the modification has substantially changed the nature and content of the original or changed the medium of expression, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Schaffung eines neuen Werks durch Paraphrasieren, Umschreiben oder Adaption von Werken einer anderen geistigen Schöpferin/eines anderen geistigen Schöpfers, wenn die Veränderung die Art und den Inhalt des Originals substanziell verändert hat oder sich das Medium der Expression geändert hat.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å skape et nytt verk ved å omskrive eller bearbeide verk av en annen opphaver er inkludert hvis dette i vesentlig grad har endret originalverkets særpreg og innhold, eller hvis mediet for uttrykket er endret.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compresa la creazione di una nuova opera tramite la parafrasi, riscrittura o adattamento di opere di un altro creatore, se la modifica ha cambiato sostanzialmente la natura e contenuto dell&apos;originale, o ha cambiato il mezzo di espressione.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uue teose loomist, ümber sõnastades, ümber töötades või adapteerides teise autori teoseid, kui teisendamine on originaali olemust ja sisu oluliselt muutnud või muutunud on väljenduse meedium.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver arī jauna darba radīšanu, pārfrazējot, pārrakstot vai pielāgojot cita radītāja darbus, ja ir būtiski mainīta pamatdarba būtība, saturs vai izteiksmes nesējs.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la creació d’una obra nova parafrasejant, reescrivint o adaptant obres d’un altre creador, si la modificació ha canviat substancialment la natura i el contingut de l’original o si ha canviat el mitjà d’expressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La création d’une nouvelle œuvre en paraphrasant, en réécrivant ou en adaptant les œuvres d’un autre créateur est incluse, si la modification a changé considérablement la nature et le contenu de l’original ou a changé le mode d’expression.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se incluye la creación de una obra nueva mediante parafraseo, reescritura o adaptación de obras de otro creador, si la modificación ha cambiado sustancialmente la naturaleza y el contenido del original o ha cambiado el medio de expresión.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Skabelse af et nyt værk ved at parafrasere, omskrive eller bearbejde værker af et andet ophav, hvis modificeringen har medført en væsentlig ændring af originalens karakter og indhold, eller den har ændret udtryksmediet, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين إنشاء عمل جديد عن طريق إعادة منشئ آخر الصياغة، أو الكتابة، أو تكييفه الأعمال، إذا كان التعديل قد غيّر طبيعة الأصل ومحتواه أو غير وسيلة التعبير تغييرا كبيرا.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">通过演绎、改写或改变另一个创建者的作品所作而成的新作品的创建，如果修改实质性改变了原作的性质和内容或者改变了内容表达的媒介，应被包括在内。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10484 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10484">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif créateur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba radītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin yaratıcı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore agente collettivo di opera</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er ophav til værk</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has creator collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat geistige Schöpferin/geistigen Schöpfer eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-collectieve actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű létrehozó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen tekijä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose autor (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo creador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu creador d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منشئ لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创作一种作品的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of work includes an agent who is jointly responsible for the creation of a work either by performing the same role as another agent, such as in a collaboration between two writers, or by performing a different role, such as in a collaboration between a composer and a lyricist.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A mű létrehozója magában foglal egy ágenst, amely egy másik ágenssel közösen felelős egy mű létrehozásáért akár ugyanabban a közreműködői minőségben, mint például két író közötti együttműködés, vagy eltérő közreműködői minőségben, mint például egy zeneszerző és egy szövegíró közötti együttműködés.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir eserin yaratıcısı, iki yazarın iş birliği gibi başka bir temsilciyle aynı rolü üstlenerek ya da bir besteci ve söz yazarı arasındaki iş birliği gibi farklı bir rol üstlenerek, eserin yaratılmasından ortaklaşa sorumlu olan bir temsilciyi kapsar.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darba radītājs ietver aģentu, kas ir atbildīgs par darba radīšanu un pilda tādu pašu lomu kā cits aģents, piemēram, kā sadarbībā starp diviem rakstniekiem vai veicot dažādas lomas, kā piemēram, komponista un teksta autora sadarbībā.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt ein Akteur, der für die Schaffung eines Werks mitverantwortlich ist, wenn er entweder dieselbe Rolle wie ein anderer Akteur ausführt, wie bei einer Zusammenarbeit zwischen zwei Schriftstellerinnen/Schriftstellern, oder eine andere Rollen ausführt, wie bei einer Zusammenarbeit zwischen einer Komponistin/einem Komponisten und einer Textdichterin/einem Textdichter.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van werk omvat een actor die gezamenlijk verantwoordelijk is voor de creatie van een werk door ofwel dezelfde rol uit te voeren als een andere actor, zoals bij een samenwerking door twee schrijvers, ofwel door een verschillende rol uit te voeren, zoals bij een samenwerking tussen een componist en een liedtekstschrijver.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En opphaver for verk inkluderer en agent med delt ansvar for å skape et verk, enten ved å fylle samme rolle som en annen agent, som i et samarbeid mellom to forfattere, eller ulike roller som i et samarbeid mellom en komponist og en sangtekstforfatter.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til værk omfatter en agent, som har fælles ansvar for at have skabt et værk enten ved at udføre den samme rolle som en anden agent, såsom i et samarbejde mellem to forfattere, eller ved at udføre en anden rolle, såsom i et samarbejde mellem en komponist og en tekstforfatter. </skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose autor hõlmab ka tegijat, kes kaasvastutab teose loomise eest, täites teise tegijaga kas sama rolli (nt kahe kirjaniku koostöö) või erinevat rolli (nt helilooja ja sõnade autori koostöö).</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de una obra incluye un agente que es corresponsable de la creación de una obra, ya sea desempeñando el mismo papel que otro agente, como en una colaboración entre dos escritores, o desempeñando un papel diferente, como en una colaboración entre un compositor y letrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una obra inclou un agent que és responsable conjuntament de la creació d’una obra ja sigui realitzant la mateixa funció que un altre agent, com ara una col·laboració entre dos escriptors, o realitzant funcions diferents, com ara una col·laboració entre un compositor i un lletrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di opera comprende l&apos;agente congiuntamente responsabile della creazione di un&apos;opera, sia svolgendo lo stesso ruolo di un altro agente, come in una collaborazione tra due scrittori, sia svolgendo un ruolo differente, come in una collaborazione tra un compositore e un paroliere.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une œuvre comprend un agent coresponsable de la création d’une œuvre soit en exerçant le même rôle qu’un autre agent, comme dans le cas d’une collaboration entre deux écrivains, soit en exerçant un rôles différent, comme dans le cas d’une collaboration entre un compositeur et un parolier.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منشئ العمل يشمل وكيلًا مسئولاً مسئولية مشتركة عن إنشاء عمل إما عن طريق أداء نفس الدور الذي يؤديه وكيل آخر، كما هو الحال في التعاون بين كاتبين، أو عن طريق أداء دور مختلف، كما هو الحال في التعاون بين ملحن ومؤلف أغاني.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">作品的创作者包括对作品的创建联合负责的行为者，他们或者行使同样的角色（例如两个写作者之间的合作）或者行使不同角色（例如作曲者和词作者之间的合作）。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10485 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10485">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif architecte</rdfs:label>
        <rdfs:label xml:lang="et">arhitekt (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">arhitekts (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">arkkitehti (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har arkitekt (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er arkitekt</rdfs:label>
        <rdfs:label xml:lang="en">has architect collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Architektin/Architekten (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft architect-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">mimar kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo arquitecto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu arquitecte</rdfs:label>
        <rdfs:label xml:lang="hu">építész kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مهندس معماري</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有建筑师集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir binanın veya diğer bir yapının tamamlandığında nasıl görüneceğini göstermeyi amaçlayan resimsel bir temsil de dahil olmak üzere mimari bir tasarım oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo  responsabile di un progetto architettonico, compresa una rappresentazione visiva destinata  a mostrare l&apos;aspetto che avrà una costruzione o altra struttura, una volta completata. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy építészeti tervért, beleértve egy képi ábrázolást, melynek célja bemutatni, hogy egy épület stb. az elkészülte után hogyan fog kinézni.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une conception architecturale, y compris une représentation illustrée conçue pour montrer à quoi ressemblera un bâtiment ou une autre structure une fois la construction terminée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’un disseny arquitectònic, inclosa una representació il·lustrada concebuda per mostrar com serà un edifici o qualsevol altra estructura una vegada complet.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es responsable de crear un diseño arquitectónico, incluida una representación pictórica destinada a mostrar cómo se verá un edificio u otra estructura una vez terminado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een architectonisch ontwerp, omvattende een picturale representatie bedoeld te laten zien hoe een gebouw of andere structuur er na voltooiing uit zal zien.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape en arkitektonisk utforming, inkludert en gjengivelse i bildeform som er ment å vise hvordan en bygning eller annen struktur vil se ut når den er ferdig.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for et arkitektonisk design, inkl. en billedrepræsentation, som skal vise, hvordan en bygning eller anden struktur vil se ud, når den er færdig.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating an architectural design, including a pictorial representation intended to show how a building or other structure will look when completed.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par arhitektūras projekta radīšanu, ieskaitot projekta skici, lai parādītu, kā ēka vai cita struktūra izskatīsies, kad tā tiks pabeigta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab arhitektuurse kujunduse loomise eest, k.a pildiline esitus, mis näitab, kuidas ehitis või muu konstruktsioon valmides välja hakkab nägema.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines architektonischen Entwurfs verantwortlich ist, einschließlich einer bildlichen Darstellung die zeigt, wie ein Gebäude oder eine andere Konstruktion nach der Fertigstellung aussehen soll.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء تصميم معماري، بما في ذلك التمثيل التصويري الذي يهدف إلى إظهار كيف سيبدو المبنى أو هيكل آخر عند اكتماله.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建建筑设计（包括用于展示建筑或其他结构完成之后外观效果的绘画作品）的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10486 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10486">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif commanditaire</rdfs:label>
        <rdfs:label xml:lang="tr">görevlendiren kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come committente agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er opgavestiller</rdfs:label>
        <rdfs:label xml:lang="no">har oppdragsgiver (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has commissioning collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Auftraggeberin/Auftraggeber (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft opdrachtgever-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="hu">megrendelő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pasūtītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">tellija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo comisionado</rdfs:label>
        <rdfs:label xml:lang="fi">toimeksiantaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu comitent</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مكلف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有委托集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eseri görevlendirmekten sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della committenza di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy mű megrendeléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa teoksen teettämisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la commande d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable d’encarregar una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es responsable de encargar una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor opdracht geven tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å bestille et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for bestilling af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for commissioning a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par darba pasūtīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab teose tellimise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der ein Werk in Auftrag gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن التكليف بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种资源与负责委托一种资源的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10487 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10487">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif programmeur</rdfs:label>
        <rdfs:label xml:lang="it">ha come programmatore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er programmør</rdfs:label>
        <rdfs:label xml:lang="no">har programmerer (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has programmer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Programmiererin/Programmierer (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft programmeur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">kolektif program temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">ohjelmoija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">programmeerija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">programmētājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">programozó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo programador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu programador</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مبرمج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编程者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir bilgisayar programı oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un programma per computer.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy számítógépes program megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa tietokoneohjelman luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’un programme informatique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’un programa informàtic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear un programa informático.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een computerprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et dataprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et computerprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a computer program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par datorprogrammas izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab arvutiprogrammi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Computerprogramms verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء برنامج كمبيوتر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种计算机程序的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10488 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10488">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif designer</rdfs:label>
        <rdfs:label xml:lang="fi">designer (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="lv">dizainers (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come designer agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har designer (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er designer</rdfs:label>
        <rdfs:label xml:lang="en">has designer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Designerin/Designer (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ontwerper-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">kujundaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="tr">tasarımcı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">tervező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo diseñador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu dissenyador</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مصمم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有设计者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir nesne için tasarım oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione del progetto di un oggetto. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy tárgy tervezetének a megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa kohteen suunnittelusta tai muotoilusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la conception d’un objet.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’un disseny d’un objecte.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear un diseño para un objeto.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een ontwerp voor een object.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å designe en gjenstand.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at designe et objekt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a design for an object.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par objekta dizaina radīšanu/izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab objekti kujunduse loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Gestaltung des Designs eines Objekts verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء تصميم لكائن.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个物体的设计的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10489 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10489">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif compositeur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba komponists (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin besteci kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compositore agente collettivo di opera</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er komponist af værk</rdfs:label>
        <rdfs:label xml:lang="no">har komponist for verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has composer collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Komponistin/Komponisten eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft componist-collectieve actor werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű zeneszerző kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen säveltäjä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose helilooja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo compositor de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu compositor d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي ملحن لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的作曲者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzik eseri oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un&apos;opera musicale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy zenemű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa musiikkiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een muziekwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et musikalsk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et musikværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a musical work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par mūzikas darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab muusikateose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Musikwerks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل موسيقي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种音乐作品的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Bewerken van een ander muziekwerk om een onderscheidende aanpassing te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compreso l&apos;adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un&apos;opera o la creazione di un&apos;opera nello stile tipico di un altro compositore, o tramite la creazione di un&apos;opera basata sulla musica di un altro compositore. </skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se incluye la adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra en el estilo general de otro compositor, o crear una obra que se base en la música de otro compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创建一种新的作品、或者基于另一个作曲者的音乐创建一种新的作品。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10490 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10490">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif inventeur</rdfs:label>
        <rdfs:label xml:lang="hu">feltaláló kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come inventore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er opfinder</rdfs:label>
        <rdfs:label xml:lang="no">har oppfinner (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has inventor collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Erfinderin/Erfinder (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvinder-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">izgudrotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="fi">keksijä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">leiutaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="tr">mucit kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo inventor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu inventor</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مخترع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发明者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, yeni bir cihaz veya süreç oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un nuovo dispositivo o procedimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy új eszköz vagy eljárás létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa uuden välineen tai menetelmän luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’un nouveau dispositif ou procédé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’un mecanisme o procés nou.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear un nuevo dispositivo o proceso.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een nieuw apparaat of proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape en ny innretning eller prosess.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe en ny anordning eller proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a new device or process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par jaunas ierīces vai procesa radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab uue seadme või protsessi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines neuen Geräts oder Prozesses verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء جهاز جديد أو عملية جديدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种新装置或新过程的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10491 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10491">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif compilateur</rdfs:label>
        <rdfs:label xml:lang="tr">derleyen kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compilatore agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er kompilator</rdfs:label>
        <rdfs:label xml:lang="no">har utarbeider (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has compiler collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Zusammenstellende/Zusammenstellenden (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft samensteller-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">kokoaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">koostaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">sastādītājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo compilador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu compilador</rdfs:label>
        <rdfs:label xml:lang="hu">összeállító kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي جامع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编纂者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir metadata setini oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo responsabile della creazione di una nuova opera come una bibliografia o un repertorio, tramite la la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely adatok, információk stb. kiválasztása, elrendezése, aggregálása és szerkesztése révén felelős egy olyan új mű létrehozásáért, mint például egy bibliográfia vagy adattár.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa uuden teoksen, kuten bibliografian tai hakemiston luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’un ensemble de métadonnées descriptives.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’un conjunt de descripció de metadades.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es responsable de crear un conjunto de descripción de metadatos.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a metadata description set.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个元数据描述集的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön muokkaamista tai selkeyttämistä eikä teosten tai teosten osien valitsemista ja kokoamista yhteen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik ide sem egy mű kifejezési formájának tartalmi felülvizsgálata vagy tisztázása, sem a művek vagy műrészek kifejezési formáinak kiválasztása és összeállítása.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono esclusi la revisione o il chiarimento del contenuto di un&apos;espressione di un&apos;opera, e la selezione e raccolta di espressioni di opere o parti di opere.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares, y una ayuda analítica para la búsqueda.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن الأعمال أو أجزاء من الأعمال وتجميعها.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10492 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10492">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif photographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="tr">eserin fotoğrafçı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">fotogrāfs (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come fotografo agente collettivo di opera</rdfs:label>
        <rdfs:label xml:lang="no">har fotograf for verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er fotograf af værk</rdfs:label>
        <rdfs:label xml:lang="en">has photographer collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Fotografin/Fotografen eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fotograaf-collectieve actor werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű fényképész kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen valokuvaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose fotograaf (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo fotógrafo de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu fotògraf d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مصور لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的摄影者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, fotoğrafik bir eser oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un&apos;opera fotografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy fényképészeti mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa valokuvateoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre photographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra fotogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra fotográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een fotografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et fotografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et fotografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a photographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par fotogrāfiska darba izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab fotograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines fotografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل فوتوغرافي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种摄影作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10493 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10493">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif intervieweur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervējis (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşmeci kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistatore agente collettivo di opera</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuer for verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er interviewer for værk</rdfs:label>
        <rdfs:label xml:lang="en">has interviewer collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewerin/Interviewer eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft interviewer-collectieve actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúkészítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastattelija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueerija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo entrevistador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu entrevistador d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي محاور لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的采访者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir görüşmeci, muhabir, anketör veya bilgi toplayan başka bir tür kolektif bir temsilci olarak hareket ederek eser oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un&apos;opera che agisce come intervistatore, reporter, sondaggista o altro genere di persona che raccoglie informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő kollektív ágensként cselekszik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre agent collectif recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus d’agent col·lectiu que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra actuando como entrevistador, reportero, encuestador o algún otro tipo de agente colectivo que recopila información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of collective agent who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva kollektiivina.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Werks verantwortlich ist, indem er als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder anderer gemeinschaftlicher Akteur Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل من خلال العمل كمحاور، أو مراسل، أو مستطلع آراء، أو كوكيل جماعي من نوع آخر يجمع معلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过担当采访者、记者、民意调查员或其他类型信息搜集集体行为者而对一种作品的创建负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10494 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10494">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif interviewé d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervēts (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşülen kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistato agente collettivo di opera </rdfs:label>
        <rdfs:label xml:lang="no">har intervjuobjekt for verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er interviewperson for værk</rdfs:label>
        <rdfs:label xml:lang="en">has interviewee collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewte/Interviewten eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geïnterviewde collectieve actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúalany kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastateltava (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueeritav (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo entrevistado de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu entrevistat d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مقابَل لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的受访者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, genellikle bir muhabir, anketör veya bilgi toplayan başka bir tür temsilci olan bir görüşmeciye yanıt vererek bir eser oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un&apos;opera tramite le risposte rilasciate a un intervistatore, solitamente un reporter, sondaggista o altro genere di agente che raccoglie le informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy mű létrehozásáért oly módon, hogy válaszol egy interjúkészítőnek, általában riporternek, közvélemény-kutatónak, vagy valamilyen más információgyűjtő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa teoksen luomisesta vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jonkinlaiselle muulle toimijalle, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre en répondant à un intervieweur, habituellement un reporteur, un sondeur ou un autre agent recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra responent a un entrevistador, normalment un periodista, enquestador o qualsevol altre tipus d’agent que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra respondiendo a un entrevistador, generalmente un reportero, encuestador o algún otro tipo de agente que recopila información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een werk door het antwoorden op een interviewer, meestal een journalist, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et verk ved å svare på spørsmål fra en intervjuer, reporter eller annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et værk ved at besvare spørgsmål fra en interviewer, normalt en journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating a work by responding to an interviewer, usually a reporter, pollster, or some other kind of agent who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par darba radīšanu, atbildot uz intervētāja, parasti reportiera, aptaujas organizētāja vai kāda cita informācijas apkopotāja jautājumiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab teose loomise eest, vastates intervjueerijale, reporterile, küsitlejale või muule infot koguvale tegijale. </skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Werks verantwortlich ist, indem er einer Interviewerin/einem Interviewer antwortet. Dabei handelt es sich normalerweise um eine Reporterin/einen Reporter, eine Meinungsforscherin/einen Meinungsforscher oder eine andere Akteurin/einen anderen Akteur, die/der Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل من خلال الرد على المحاور، وعادة ما يكون مراسلًا، أو مستطلع آراء، أو وكيلاً من نوع آخر يجمع معلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过回答采访者（通常是记者、民意调查员或其他类型信息搜集行为者）而对一种作品的创建负责的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10495 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10495">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif agrégateur</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattori (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátor kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="it">ha come aggregatore agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har aggregator (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er samler</rdfs:label>
        <rdfs:label xml:lang="en">has aggregator collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Aggregatorin/Aggregator (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aggregator-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">liitja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo agregador</rdfs:label>
        <rdfs:label xml:lang="tr">toplayıcı kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu agregador</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مجمع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集编者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, diğer eserlerin anlatımlarını seçerek ve düzenleyerek toplu bir eser yapmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un&apos;opera tramite la selezione e l&apos;organizzazione di espressioni di altre opere.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy aggregáló mű létrehozásáért, más művek kifejezési formáinak kiválasztása és elrendezése révén.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre agrégatrice par la sélection et l’arrangement d’expressions d’autres œuvres.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra agregadora mitjançant la selecció i l’arranjament d’expressions d’altres obres.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra agregadora seleccionando y ordenando expresiones de otras obras.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een aggregaatwerk door middel van selectie en arrangeren van expressies van andere werken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et aggregerende verk ved å velge ut og arrangere uttrykk av andre verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et aggregerende værk ved at udvælge og arrangere udtryk af andre værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating an aggregating work by selecting and arranging expressions of other works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par darba-apkopojuma radīšanu, atlasot un sakārtojot citu darbu izteiksmes.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab liitva teose loomise eest, valides ja korrastades teiste teoste väljendused.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines aggregierenden Werks verantwortlich ist, indem er Expressionen anderer Werke auswählt und zusammenstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل مجمع عن طريق اختيار تعبيرات أعمال أخرى وترتيبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责把其他作品的内容表达选择和整理后创建一种合集性作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10496 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10496">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif remixeur</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista di remix agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er remixer</rdfs:label>
        <rdfs:label xml:lang="no">har remikser (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has remix artist collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Remix Artist (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft remixartiest-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">remiksija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">remiksētājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">remix sanatçısı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">remixművész kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo artista de remix</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu artista de remescla</rdfs:label>
        <rdfs:label xml:lang="fi">uudelleenmiksaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي فنان مزج موسيقي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合成艺术家集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses kaynağı oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un&apos;opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung eines Tonwerks verantwortlich ist, indem er eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء عمل صوتي من خلال المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创建一种音频作品的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido de la obra original, y la mezcla de pistas grabadas para que aparezcan como una pista continua.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell&apos;opera originale, nonché il missaggio di brani registrati che appaiono come un unico brano.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10497 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10497">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif cinéaste</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvantekijä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">film üreticisi kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas veidotājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">filmitegija (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="hu">filmkészítő kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come cineasta agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har filmskaper (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er filmskaber</rdfs:label>
        <rdfs:label xml:lang="en">has filmmaker collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmemacherin/Filmemacher (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmmaker-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo cineasta</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu cineasta</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي صانع أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制片人集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bağımsız veya kişisel bir film oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un film indipendente, o realizzato autonomamente.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy független- vagy egy magánfilm létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’un film indépendant ou personnel.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable d’una pel·lícula cinematogràfica independent o personal.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear una película independiente o personal.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het creëren van een zelfstandige of persoonlijke film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape en uavhengig eller personlig film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe en indiefilm eller personlig film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating an independent or personal film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab sõltumatu või autorifilmi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Erstellung eines unabhängigen oder privaten Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء فيلم مستقل أو شخصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种独立或个人电影的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A filmmaker is individually responsible for the conception and execution of all aspects of the film.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir film yapımcısı, filmin tüm yönlerinin tasarlanmasından ve yürütülmesinden bireysel olarak sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een filmmaker is individueel verantwoordelijk voor de conceptie en uitvoering van alle aspecten van de film.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy filmkészítő egyénileg felelős egy film koncepciójáért és összes aspektusának végrehajtásáért.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En filmskaper har personlig ansvar for planen med og gjennomføringen av alle aspektene ved filmen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Filmas veidotājs ir pilnībā atbildīgs par visiem filmas koncepcijas un realizācijas aspektiem.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmitegija vastutab üksinda kõigi filmi aspektide kontseptsiooni ja teostamise eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmskaberen er individuelt ansvarlig for udtænkning og udførelse af alle filmens aspekter.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un cineasta es individualmente responsable de la concepción y ejecución de todos los aspectos de la película.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un cineasta è responsabile a livello individuale della concezione ed esecuzione di ogni aspetto del film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un cineasta és responsable a títol individual de la concepció i l’execució de tots els aspectes de la pel·lícula.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un cinéaste est responsable à titre individuel de la conception et de l’exécution de tous les aspects du film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">صانع أفلام مسئول مسئولية فردية عن تصور جميع جوانب الفيلم وتنفيذه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制片人对电影所有方面的构思和执行负有个人责任</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10498 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10498">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif artiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er kunstner</rdfs:label>
        <rdfs:label xml:lang="no">har kunstner (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has artist collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Künstlerin/Künstler (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kunstenaar-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">kunstnik (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">mākslinieks (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">művész kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">sanatçı kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">taiteilija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo artista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu artista</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي فنان</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有美术家集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, orijinal bir grafik tasarımı, çizimi, resmi vb. oluşturmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della creazione di un  progetto grafico, schizzo, dipinto originali, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy eredeti grafikai terv, rajz, festmény, stb. megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la création d’un graphisme, d’une peinture, d’un dessin, etc. original.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la creació d’un disseny gràfic, un dibuix, una pintura, etc., original.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de crear un diseño gráfico original, dibujo, pintura, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is het maken van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for å skape et originalt grafisk design, en tegning, et maleri etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at skabe et originalt grafisk design, -tegning, -maleri etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for creating an original graphic design, drawing, painting, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par darba radīšanu un īstenošanu, izmantojot oriģinālu grafisko dizainu, zīmēšanu, gleznošanu, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab originaalse graafilise kujunduse, joonistuse, maali vms loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن إنشاء تصميم رسومي، ورسم، وتصوير زيتي أصلي، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责完成原创图形设计、绘图、绘画等的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10499 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10499">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif fondateur d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba dibinātājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kurucu kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fondatore agente collettivo di opera</rdfs:label>
        <rdfs:label xml:lang="no">har grunnlegger av verk (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er stifter af værk</rdfs:label>
        <rdfs:label xml:lang="en">has founder collective agent of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Begründerin/Begründer eines Werks (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft oprichter-collectieve actor van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű alapító kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen perustaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">teose asutaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo fundador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu fundador d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مؤسس لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创办者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eseri başlatmaktan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile dell&apos;avvio di un&apos;opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy diakronikus mű indításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa diakronisen teoksen alullepanosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de lancer une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable d’iniciar una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de iniciar una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het initiëren van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som har ansvar for å etablere et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for at igangsætte et diakronisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for initiating a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab diakroonilise teose ellukutsumise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für das Begründen eines diachronen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن بدء عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责发起一种历时作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10500 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10500">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif directeur de casting</rdfs:label>
        <rdfs:label xml:lang="lv">aktieru atlases režisors (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">casting&apos;u juht (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore del casting agente collettivo </rdfs:label>
        <rdfs:label xml:lang="no">har casting director (kollektivt verk)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er caster</rdfs:label>
        <rdfs:label xml:lang="en">has casting director collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Casting Director (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft castingdirector-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="tr">kast yönetmeni kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">roolittaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">szereposztó rendező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo director de casting</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu director de càsting</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مدير طاقم تمثيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有角色导演集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, sanatçılara rol ve görev verilmesinin çoğu yönünden sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della maggior parte degli aspetti relativi all&apos;assegnazione agli interpreti di parti e compiti. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la majoria dels aspectes de l’assignació de parts i funcions als intèrprets.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es responsable de la mayoría de los aspectos de la asignación de partes y deberes a los artistas intérpretes o ejecutantes.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for de fleste aspekter ved å fordele roller og oppgaver mellom utøvere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for de fleste aspekter ved tildeling af roller og ansvar til udøvere.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for most aspects of assigning parts and duties to performers.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par lomu sadali un pienākumu piešķiršanu izpildītājiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab enamiku aspektide eest esitajatele rollide ja ülesannete jagamisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن معظم جوانب تخصيص الأدوار والواجبات للمؤدين.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责给演员分配角色和任务的大多数工作的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10501 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10501">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif producteur</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er producer</rdfs:label>
        <rdfs:label xml:lang="no">har produsent (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has producer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="lv">producents (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">producer kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="et">produtsent (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo productor</rdfs:label>
        <rdfs:label xml:lang="fi">tuottaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu productor</rdfs:label>
        <rdfs:label xml:lang="tr">yapımcı kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منتج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制作者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir yapımın ticari yönlerinin çoğundan sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que es responsable de la mayoría de los aspectos comerciales de una producción para pantalla, grabación de sonido, televisión, webcast, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط العمل بوكيل جماعي مسئول عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个集体行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Generalmente un produttore è responsabile per la raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un productor generalmente es responsable de recaudar fondos, gestionar la producción, contratar personal clave, gestionar los distribuidores, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10502 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10502">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif réalisateur</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er instruktør</rdfs:label>
        <rdfs:label xml:lang="no">har regissør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has director collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Regisseurin/Regisseur (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft regisseur-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">ohjaaja (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">rendező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">režisors (grupa)</rdfs:label>
        <rdfs:label xml:lang="et">režissöör (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo director</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu realitzador</rdfs:label>
        <rdfs:label xml:lang="tr">yönetmen kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي مخرج</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有导演集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera all&apos;agente collettivo responsabile della gestione generale e della supervisione di un&apos;interpretazione cinematografica, programma radiofonico o televisivo, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que és responsable de la gestió general i la supervisió d’una actuació filmada, un programa radiofònic o de televisió, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que se encarga de la dirección general y supervisión de una actuación filmada, un programa de radio o televisión, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي مسئول عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责电影表演、广播或电视节目等的全面管理和监督的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10503 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10503">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif émetteur</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er udstedende organ</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has issuing collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat herausgebenden gemeinschaftlichen Akteur</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvaardiger-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="hu">kibocsátó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">piyasaya çıkaran kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo emisor</rdfs:label>
        <rdfs:label xml:lang="lv">turpinājumizdevuma izdevējs (grupa)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu d’entitat editora</rdfs:label>
        <rdfs:label xml:lang="et">väljaandja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي جهة إصدار</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有颁布集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eser yayınlayan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo che emette un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely kibocsát egy művet.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka julkaisee teoksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui publie une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que publica una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que emite una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die een werk uitvaardigt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som utgir et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som udgiver et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who issues a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas izdevusi darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes annab teose välja.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der ein Werk heraus gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يصدر عملاً.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与颁布一种作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10504 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10504">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif organisateur</rdfs:label>
        <rdfs:label xml:lang="it">ha come organizzatore agente collettivo</rdfs:label>
        <rdfs:label xml:lang="no">har arrangør (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er arrangør</rdfs:label>
        <rdfs:label xml:lang="en">has organizer collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Veranstalterin/Veranstalter (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft organisator-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="fi">järjestäjä (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="et">korraldaja (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="tr">organizatör kolektif temsilcisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">organizētājs (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">szervező kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo organizador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu organitzador</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي منظِم</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有组织者集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir esere yol açan bir konferans, sergi veya başka bir etkinlik düzenleyen kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo organizzatore di una conferenza, mostra o altro evento che dà origine a un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely egy mű létrejöttét eredményező konferenciát, kiállítást vagy egyéb eseményt szervez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui organise un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que organitza un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que organiza una conferencia, exposición u otro evento que dé origen a una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die organiseert een conferentie, tentoonstelling of andere gebeurtenis dat aanleiding geeft tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som organiserer en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som organiserer en konference, udstilling eller anden begivenhed, som giver anledning til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who organizes a conference, exhibition, or other event that gives rise to a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas organizējusi konferenci, izstādi vai citu pasākumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes korraldab teosele aluse pannud konverentsi, näituse vm ürituse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlichen Akteur, der eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert beziehungsweise veranstaltet, aus der/dem ein Werk hervorgeht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي ينظم مؤتمرًا، أو معرضًا، أو أي حدث آخر ينتج عنه عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与组织会议、展览或其他事件以产生一种作品的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10505 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10505">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour agent collectif consultant</rdfs:label>
        <rdfs:label xml:lang="fi">asiantuntija (yhteistoimija)</rdfs:label>
        <rdfs:label xml:lang="tr">danışman kolektif temsilci ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come consulente agente collettivo</rdfs:label>
        <rdfs:label xml:lang="da">har kollektiv agent, som er rådgiver</rdfs:label>
        <rdfs:label xml:lang="no">har konsulent (kollektiv agent)</rdfs:label>
        <rdfs:label xml:lang="en">has consultant collective agent</rdfs:label>
        <rdfs:label xml:lang="de">hat Beraterin/Berater (Gemeinschaftlicher Akteur)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft consultant-collectieve actor</rdfs:label>
        <rdfs:label xml:lang="et">konsultant (kollektiiv)</rdfs:label>
        <rdfs:label xml:lang="lv">konsultants (grupa)</rdfs:label>
        <rdfs:label xml:lang="hu">tanácsadó kollektív ágense a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene agente colectivo consultor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a agent col·lectiu consultor</rdfs:label>
        <rdfs:label xml:lang="ar">له وكيل جماعي استشاري</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有顾问集体行为者</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmetleri sağlayan ve genellikle tavsiyelerde bulunan kolektif bir temsilci ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un agente collettivo che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come  creatore di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy kollektív ágenshez, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteistoimijaan, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec un agent collectif qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb un agent col·lectiu que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un agente colectivo que brinda servicios de consulta, y a menudo hace recomendaciones, para un agente relacionado que está representado como creador de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een collectieve actor die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en kollektiv agent som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en kollektiv agent, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a collective agent who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar grupu, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose kollektiiviga, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einem gemeinschaftlicher Akteur, der Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل ووكيل جماعي يقدم خدمات استشارية، وغالبًا ما يقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个集体行为者关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10509 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10509">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité directrice de la photographie</rdfs:label>
        <rdfs:label xml:lang="tr">görüntü yönetmeni tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore della fotografia ente </rdfs:label>
        <rdfs:label xml:lang="no">har filmfotograf (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er filmfotograf</rdfs:label>
        <rdfs:label xml:lang="en">has director corporate body of photography</rdfs:label>
        <rdfs:label xml:lang="de">hat Kamerafrau/Kameramann (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cameraregisseur-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">kinooperators (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">operaator-lavastaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="hu">operatőr testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo director de fotografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa directora de fotografia</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مديرة تصوير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有摄影指导团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, elektronik olarak veya film ya da video stoğu üzerinde görüntü yakalayan ve genellikle ışıklandırmayı seçen ve düzenleyen tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente che cattura le immagini, sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que captura imágenes, ya sea electrónicamente o en películas o videos, y a menudo selecciona y organiza la iluminación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تلتقط الصور، إما إلكترونيًا أو على فيلم أو مقاطع فيديو، وغالبًا ما تختار الإضاءة وترتبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A director of photography for a movie is also called a chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Al director de fotografía de una película también se le llama jefe de fotografía.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy film operatőrét vezető operatőrnek is nevezik.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Kamerafrau/Ein Kameramann für einen Film wird auch als &quot;Bildregisseurin/Bildregisseur&quot; bezeichnet.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Filmfotografen for en film kalles også sjefsfotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmfotografen på en film kaldes også for en cheffotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Kinooperatoru mēdz saukt arī par galveno operatoru.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un director de fotografia d’una pel·lícula també s’anomena primer operador.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un direttore della fotografia in un film è detto anche capo operatore.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">电影的摄影指导也称总摄影师</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10510 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10510">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité recherchiste</rdfs:label>
        <rdfs:label xml:lang="tr">araştırmacı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come ricercatore ente</rdfs:label>
        <rdfs:label xml:lang="no">har forsker (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er researcher</rdfs:label>
        <rdfs:label xml:lang="en">has researcher corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Forscherin/Forscher (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderzoeker-corporatie</rdfs:label>
        <rdfs:label xml:lang="hu">kutató testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pētnieks (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo investigador</rdfs:label>
        <rdfs:label xml:lang="fi">tutkija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa investigadora</rdfs:label>
        <rdfs:label xml:lang="et">uurija (asutus)</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة باحثة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有研究者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin oluşturulmasını desteklemek için araştırma yapan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente che svolge ricerche a supporto della creazione di un&apos;opera.  </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely kutatást végez egy mű megalkotásának támogatására.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka tukee teoksen syntymistä tutkimuksellaan.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui effectue des recherches pour aider à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que fa recerca per donar suport a la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que realiza investigaciones en apoyo a la creación de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die onderzoek doet ter ondersteuning van de creatie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som forsker som bidrag til å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som udfører research til at understøtte skabelsen af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who does research in support of the creation of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas veikusi pētniecību darba radīšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes teeb teose loomise heaks uurimistööd.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die Forschung betreibt, um das Schaffen eines Werks zu unterstützen.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تجري بحوث لدعم إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与从事研究以支持一种作品的创作的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10511 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10511">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité directrice de publication</rdfs:label>
        <rdfs:label xml:lang="hu">főszerkesztő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">galvenais redaktors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er ansvarshavende redaktør</rdfs:label>
        <rdfs:label xml:lang="no">har redaksjonssjef (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has editorial director corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Chefredakteurin/Chefredakteur (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft hoofdredacteur-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">peatoimetaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo director editorial</rdfs:label>
        <rdfs:label xml:lang="fi">toimituspäällikkö (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa directora editorial</rdfs:label>
        <rdfs:label xml:lang="tr">yayın yönetmeni tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مديرة تحرير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主编团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eserin yayın politikası ve içeriği için yasal veya fikri sorumluluğu olan ancak yaratıcı sorumluluğu olmayan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amelynek jogi vagy szellemi, de nem alkotói felelőssége van egy diakronikus mű szerkesztési politikájáért és tartalmáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui a la responsabilité légale ou intellectuelle, mais non la responsabilité créative, de la politique éditoriale et du contenu d’une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que té responsabilitat legal o intel·lectual, però no responsabilitat creativa, de la política editorial i el contingut d’una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que tiene responsabilidad legal o intelectual, pero no responsabilidad creativa, por la política editorial y el contenido de una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die wettelijke of intellectuele verantwoordelijkheid, maar niet creatieve verantwoordelijkheid heeft voor het redactioneel beleid en content van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som har juridisk eller intellektuelt ansvar, bortsett fra kreativt ansvar, for det redaksjonelle innholdet i et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er juridisk eller intellektuelt ansvarlig, men ikke skabelsesansvarlig, for et diakronisk værks redaktionelle linje og indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who has legal or intellectual responsibility, but not creative responsibility, for the editorial policy and content of a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kam ir juridiska vai intelektuāla, bet ne radoša atbildība par diahroniskā darba izdošanas politiku un saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes juriidiliselt või intellektuaalselt, kuid mitte loominguliselt vastutab diakroonilise teose toimetamispõhimõtete ja sisu eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die die rechtliche oder intellektuelle, aber keine kreative, Verantwortung für die redaktionelle Vorgehensweise und den Inhalt eines diachronen Werks trägt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تتحمل مسئولية قانونية أو فكرية، ولكن لا تتحمل مسئولية إبداعية، عن السياسة التحريرية ومحتوى عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与有对一种历时作品的编辑政策和内容的法律或知识责任（但非创作责任）的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Bir eserin anlatımının gözden geçirilmesi, netleştirilmesi veya içeriğinin başka bir şekilde değiştirilmesi hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darbība neietver darba izteiksmes satura pārskatīšanu, precizēšanu vai cita veida izmaiņas u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen nicht Überarbeitungen, Erläuterungen oder andere inhaltliche Änderungen an einer Expression eines Werks.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu parandamist, täpsustamist ega muude muudatuste tegemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Herziening, toelichting of andere verandering van content van een expressie van een werk is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La révision, la clarification ou toute autre modification du contenu d’une expression d’une œuvre sont exclues.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele egy mű kifejezési formájának revíziója, áttekintése, vagy egyéb tartalmi változtatása.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Revision, clarification, or other change of content of an expression of a work is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revision, indholdspræcisering eller anden ændring af indholdet af et værks udtryk er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la revisión, aclaración u otro cambio de contenido de una expresión de una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la revisió, l’aclariment o qualsevol altre canvi del contingut d’una expressió d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Å redigere innholdet i et uttrykk av et verk eller gjøre det klarere er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل، أو توضيحه، أو أي تغيير آخر فيه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括对一种作品的一种内容表达之内容的修订、说明或其他变化。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10512 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10512">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité réalisatrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvaohjaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">film yönetmeni tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">filmirežissöör (asutus)</rdfs:label>
        <rdfs:label xml:lang="hu">filmrendező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista cinematografico ente</rdfs:label>
        <rdfs:label xml:lang="no">har filmregissør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er filminstruktør</rdfs:label>
        <rdfs:label xml:lang="en">has film director corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmregisseurin/Filmregisseur (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmregisseur-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">kinorežisors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo director de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa directora cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مخرجة أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影导演团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın genel yönetim ve denetiminden sorumlu bir yönetmen olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente regista responsabile della gestione generale e della supervisione di un&apos;interpretazione cinematografica. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező testülethez, amely felelős egy filmre vett előadás általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on ohjaaja, joka on vastuussa elokuvatun esityksen yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité réalisatrice qui est responsable de la gestion et de la supervision générales d’une prestation filmée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un director que és responsable de la gestió i la supervisió d’una actuació filmada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un director que se encarga de la dirección general y supervisión de una actuación filmada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een gefilmde uitvoering.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er regissør med ansvar for generell ledelse av en filmet forestilling.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is a director who is responsible for the general management and supervision of a filmed performance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par uzfilmētā pasākuma vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on filmitava etenduse üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Körperschaft), die/der für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مديرة مسئولة عن الإدارة العامة والإشراف على أداء مصوَّر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责拍摄表演的总体管理和监督的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10513 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10513">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité réalisatrice de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista radiofonico ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er radioregissør</rdfs:label>
        <rdfs:label xml:lang="no">har radioregissør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has radio director corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkregisseurin/Hörfunkregisseur (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioregisseur-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">raadiorežissöör (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma direktors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">radio-ohjaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yönetmeni tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádiós rendező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo director de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa realitzadora radiofònica</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مخرجة إذاعية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播导演团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının genel yönetim ve denetiminden sorumlu yönetici olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente regista responsabile della gestione generale e della supervisione di un programma radiofonico. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező testülethez, amely felelős egy rádióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité réalisatrice qui est responsable de la gestion et de la supervision générales d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un realitzador que és responsable de la gestió i supervisió d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un director que tiene a su cargo la dirección general y supervisión de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er regissør med ansvar for generell ledelse av et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is a director who is responsible for the general management and supervision of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju - direktors, kura atbildīga par radio raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on raadiosaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Körperschaft), die/der für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مديرة مسئولة عن الإدارة العامة والإشراف على برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责广播节目的总体管理和监督的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10514 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10514">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité réalisatrice de télévision</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista televisivo ente </rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsregissør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er tv-regissør</rdfs:label>
        <rdfs:label xml:lang="en">has television director corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehregisseur/Fernsehregisseur (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieregisseur-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">telerežissöör (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">televisio-ohjaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yönetmeni tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televíziós rendező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma režisors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo director de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa realitzadora de televisió</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مخرجة تليفزيونية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视导演团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının genel yönetim ve denetiminden sorumlu yönetici olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente regista responsabile della gestione generale e della supervisione di un programma televisivo. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező testülethez, amely felelős egy televízióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on ohjaaja, joka on vastuussa televisio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité réalisatrice qui est responsable de la gestion et de la supervision générales d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un realitzador que és responsable de la gestió i supervisió d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un director que tiene a su cargo la dirección general y supervisión de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er regissør med ansvar for generell ledelse av et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is a director who is responsible for the general management and supervision of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju - režisors, kura atbildīga par televīzijas raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on telesaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Körperschaft), die/der für das allgemeine Management und die Leitung einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مديرة مسئولة عن الإدارة العامة والإشراف على برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责电视节目的总体管理和监督的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10515 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10515">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité productrice audio</rdfs:label>
        <rdfs:label xml:lang="hu">audioproducer testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="et">audioprodutsent (asutus)</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore audio ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er lydproducer</rdfs:label>
        <rdfs:label xml:lang="no">har lydprodusent (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has audio producer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten einer Tonaufnahme (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geluidsproducent-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">ses yapımcısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņu ierakstu producents (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo productor de audio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa productora d’àudio</rdfs:label>
        <rdfs:label xml:lang="fi">äänituottaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منتجة صوت</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音频制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ses kaydının ticari yönlerinin çoğunu yönetmekten sorumlu bir yapımcı olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente produttore responsabile della gestione della maggior parte  degli aspetti commerciali di una registrazione audio. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer testülethez, amely felelős egy hangfelvétel üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité productrice qui est responsable de gérer la majeure partie des aspects commerciaux d’un enregistrement audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un productor que és responsable de la gestió de la majoria dels aspectes comercials d’un enregistrament àudio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un productor responsable de gestionar la mayoría de los aspectos comerciales de una grabación de audio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en produsent som er ansvarlig for de fleste forretningsmessige aspektene ved et lydopptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en producer, som er ansvarlig for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is a producer who is responsible for managing most of the business aspects of an audio recording. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir producents, kas ir atbildīga par skaņu ieraksta biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes produtsendina vastutab enamiku äriliste aspektide korraldamise eest helisalvestusel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Körperschaft), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون منتجة مسئولة عن إدارة معظم جوانب العمل في تسجيل صوتي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个制作者并负责音频录制工作大多数方面商业运作之管理的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10516 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10516">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité productrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvatuottaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">film yapımcısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas producents (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">filmiprodutsent (asutus)</rdfs:label>
        <rdfs:label xml:lang="hu">filmproducer testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore cinematografico ente</rdfs:label>
        <rdfs:label xml:lang="no">har filmprodusent (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er filmproducer</rdfs:label>
        <rdfs:label xml:lang="en">has film producer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmproduzentin/Filmproduzenten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmproducent-corporatie</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo director de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa productora cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منتجة أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir filmin yapımının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente produttore responsabile della gestione della maggior parte degli aspetti commerciali di un film. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer testülethez, amely felelős egy filmprodukció üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité productrice qui est responsable de la majeure partie des aspects commerciaux de la production d’un film.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un productor responsable de la mayoría de los aspectos comerciales de la producción de una película.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en produsent med ansvar for de fleste forretningsmessige aspektene ved en film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is a producer who is responsible for most of the business aspects of the production of a film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par filmas uzņemšanas finansiālajiem aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Körperschaft), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون منتجة مسئولة عن معظم جوانب العمل في فيلم.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电影制作的大部分商业运作的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10517 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10517">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité productrice de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore radiofonico ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er radioproducer</rdfs:label>
        <rdfs:label xml:lang="no">har radioprodusent (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has radio producer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkproduzentin/Hörfunkproduzenten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioproducent-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">raadioprodutsent (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma producents (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">radiotuottaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yapımcısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádióproducer testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo productor de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa productora radiofònica</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منتجة إذاعية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente produttore responsabile della gestione della maggior parte degli aspetti commerciali di un programma radiofonico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer testülethez, amely felelős egy rádióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité productrice qui est responsable de la majeure partie des aspects commerciaux d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un productor que és responsable de la majoria dels aspectes comercials d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un productor que es responsable de la mayoría de los aspectos comerciales de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is a producer who is responsible for most of the business aspects of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju - producents, kurš ir atbildīgs par radio raidījuma darbības/biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes produtsendina vastutab enamiku äriliste aspektide eest raadiosaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Körperschaft), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون منتجة مسئولة عن معظم جوانب العمل في برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责广播节目的大部分商业运作的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10518 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10518">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité productrice de télévision</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore televisivo ente</rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsprodusent (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er tv-producer</rdfs:label>
        <rdfs:label xml:lang="en">has television producer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehproduzentin/Fernsehproduzenten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieproducent-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">teleprodutsent (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">televisiotuottaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yapımcısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televízió-producer testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma producents (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo productor de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa productora de televisió</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منتجة تليفزيونية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının ticari yönlerinin çoğundan sorumlu olan bir yapımcı olan bir tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente produttore responsabile della gestione della maggior parte degli aspetti commerciali di un programma televisivo. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer testülethez, amely felelős egy televízióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on tuottaja, joka on vastuussa suurimmasta osasta televisio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité productrice qui est responsable de la majeure partie des aspects commerciaux d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un productor que és responsable de la majoria dels aspectes comercials d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un productor responsable de la mayoría de los aspectos comerciales de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is a producer who is responsible for most of the business aspects of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju - producents, kura atbildīga par televīzijas raidījuma biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes produtsendina vastutab enamiku äriliste aspektide eest telesaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Körperschaft), die/der für die meisten geschäftlichen Aspekte einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون منتجة مسئولة عن معظم جوانب العمل في برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电视节目的大部分商业运作的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10519 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10519">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité architecte paysagiste</rdfs:label>
        <rdfs:label xml:lang="lv">ainavu arhitekts (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto del paesaggio ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er landskabsarkitekt</rdfs:label>
        <rdfs:label xml:lang="no">har landskapsarkitekt (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has landscape architect corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Landschaftsarchitektin/Landschaftsarchitekten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft landschapsarchitect-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">maastikuarhitekt (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">maisema-arkkitehti (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">peyzaj mimarı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo arquitecto paisajista</rdfs:label>
        <rdfs:label xml:lang="hu">tájépítész testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa arquitecta paisatgista</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مهندسة تنسيق مواقع</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有景观设计师团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, peyzaj işleri yapmaktan sorumlu bir mimar olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente architetto responsabile della creazione di opere paesaggistiche.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy építész testülethez, amely felelős tájépítészeti művek létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on arkkitehti, joka on vastuussa maisemateosten luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’œuvres paysagères.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un arquitecte que és responsable de la creació d’obres paisatgístiques.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un arquitecto que se encarga de crear obras paisajísticas.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een architect is die verantwoordelijk is voor het creëren van landschapswerken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en arkitekt med ansvar for å skape landskapsverk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en arkitekt, som er ansvarlig for at skabe landskabsværker.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an architect who is responsible for creating landscape works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par ainavu darbu veidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes arhitektina vastutab maastikuteoste loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Architektin/einem Architekten (Körperschaft), die/der für die Schaffung landschaftlicher Werke verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مهندسة معمارية مسئولة عن إنشاء أعمال تنسيق المواقع.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为建筑师并负责创建景观作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10520 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10520">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité calligraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come calligrafo ente </rdfs:label>
        <rdfs:label xml:lang="no">har kalligraf (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er kalligraf</rdfs:label>
        <rdfs:label xml:lang="en">has calligrapher corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Kalligrafin/Kalligrafen (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kalligraaf-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">kaligraf tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">kaligrāfs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">kalligraaf (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">kalligrafi (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">kalligráfus testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo calígrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa cal·lígrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة خطاطة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有书法者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, aynı tüzel kişinin yazılı metinden de sorumlu olup olmadığına bakılmaksızın, ilgi odağının hattatlık veya grafik sanatının estetik değerinde olduğu kaligrafiden sorumlu sanatçı olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della calligrafia, laddove l&apos;oggetto dell&apos;interesse risiede nel valore estetico della calligrafia o maestria grafica, a prescindere dal fatto che lo stesso ente sia anche responsabile per il testo scritto. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész testülethez, amely felelős egy kalligráfia megalkotásáért, amelyben a szépírás esztétikai értéke vagy a grafika művészisége áll az érdeklődés fókuszában, tekintet nélkül arra, hogy ugyanaz a testület a lejegyzett szöveg szerzője is egyben vagy sem.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on taiteilija, joka on vastuussa kalligrafiasta, jossa pääpaino on käsin kirjoittamisen tai graafisen taiteen esteettisissä arvoissa, riippumatta siitä, onko sama yhteisö myös vastuussa kirjoitetusta tekstistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité artiste qui est responsable de la création d’une calligraphie où l’accent est mis sur la valeur esthétique de la calligraphie ou du graphisme, peu importe que la même collectivité soit aussi responsable du texte calligraphié.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un artista que és responsable de la cal·ligrafia on el centre de l’interès se situa en el valor estètic de la cal·ligrafia o del grafisme, independentment de si la mateixa entitat corporativa és també responsable del text inscrit.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un artista responsable de la caligrafía donde el foco de interés radica en el valor estético de la caligrafía o el arte gráfico, independientemente de si el mismo cuerpo corporativo también es responsable del texto inscrito.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een kunstenaar is die verantwoordelijk is voor kalligrafie waar de aandacht primair uitgaat naar de esthetische waarde van de schrijfkunst of grafische kunstenaarschap, ongeacht of dezelfde corporatie ook verantwoordelijk is voor de inscriptie.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en kunstner som er ansvarlig for kalligrafi der fokus er på den estetiske verdien av pennekunsten eller kunstnerisk dyktighet, uavhengig av om den samme agenten også er ansvarlig for tekstinnholdet.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en kunstner, som er ansvarlig for kalligrafi, hvor fokus ligger på den æstetiske værdi af skrivekunsten eller den kunstneriske grafiske dygtighed, uagtet om den samme person også har forfattet den indskrevne tekst.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an artist who is responsible for calligraphy where the focus of interest lies in the aesthetic value of the penmanship or graphic artistry, regardless of whether the same corporate body is also responsible for the inscribed text.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju mākslinieks, kas ir atbildīgs par kaligrāfiju, kur galvenais ir mākslinieciskā vai grafiskā mākslas vērtība, neatkarīgi no tā, vai tā pati persona ir atbildīgs arī par ierakstīto tekstu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on ilukirja eest vastutav kunstnik. Ilukirja põhirõhk on kirjakunsti või graafilise kunstnikutöö esteetilisel väärtusel, olenemata sellest, kas sama asutus on vastutav ka kirjutatud teksti eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Körperschaft), die/der für die Kalligrafie verantwortlich ist, bei der der ästhetische Wert der Schreibkunst oder die grafische Kunstfertigkeit im Mittelpunkt des Interesses liegt, unabhängig davon, ob dieselbe Körperschaft auch für den aufgeschriebenen Text verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون فنانة مسئولة عن الخط حيث يكمن تركيز الاهتمام في القيمة الجمالية للخط أو فن الرسم، بغض النظر عن كون الهيئة نفسها مسئولة أيضًا عن النص المدرج.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责书法（其中兴趣重点是书法或图形艺术的美学价值，不管同一团体是否负责题写文字）的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10521 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10521">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité sculptrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come scultore ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er skulptør</rdfs:label>
        <rdfs:label xml:lang="no">har skulptør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has sculptor corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Bildhauerin/Bildhauer (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft beeldhouwer-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">heykeltıraş tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">kuvanveistäjä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">skulptor (asutus)</rdfs:label>
        <rdfs:label xml:lang="hu">szobrász testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo escultor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa escultora</rdfs:label>
        <rdfs:label xml:lang="lv">tēlnieks (institūcija)</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة نحاتة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有雕塑家团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, modelleme, oyma veya benzeri bir teknikle üç boyutlu bir eser oluşturmaktan sorumlu tüzel kişi olan sanatçı ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente artista responsabile della creazione di un&apos;opera tridimensionale tramite modellatura, intaglio o tecnica simile. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész testülethez, amely felelős egy háromdimenziós mű megalkotásáért modellezési, faragási vagy hasonló technikával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on taiteilija, joka on vastuussa kolmiulotteisen teoksen luomisesta muovaamalla, veistämällä tai vastaavalla tekniikalla.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité artiste qui est responsable de la création d’une œuvre tridimensionnelle par le modelage, la taille ou une technique similaire.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un artista que és responsable de la creació d’una obra tridimensional mitjançant l’escultura, la talla o una tècnica similar.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un artista que se encarga de crear una obra tridimensional mediante modelado, tallado o técnica similar.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een kunstenaar is die verantwoordelijk is voor het creëren van driedimensionaal modelleren, snijden of gelijksoortige techniek.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en kunstner med ansvar for å skape et tredimensjonalt verk gjennom modellering, utskjæring eller lignende teknikker.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en kunstner, som er ansvarlig for at skabe et tredimensionelt værk vha. modellering, udskæring eller lignende teknik.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an artist who is responsible for creating a three-dimensional work by modeling, carving, or similar technique.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju - mākslinieks, kura ir atbildīga par trīsdimensiju darba radīšanu, to veidojot, grebjot vai izmantojot līdzīgu tehniku.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on modelleerimise, nikerdamise või muu säärase tehnika teel loodud kolmemõõtmelise teose eest vastutav kunstnik.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Körperschaft), die/der für die Schaffung eines dreidimensionalen Werks durch Modellieren, Schnitzen oder ähnliche Techniken verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون فنانة مسئولة عن إنشاء عمل ثلاثي الأبعاد من خلال النمذجة، أو النحت، أو تقنية مشابهة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家并通过模型、雕刻或类似技术负责创建一种三维作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10522 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10522">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité artiste du livre</rdfs:label>
        <rdfs:label xml:lang="lv">grāmatu mākslinieks (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come book artist ente </rdfs:label>
        <rdfs:label xml:lang="no">har bokkunstner (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er bogkunstner</rdfs:label>
        <rdfs:label xml:lang="en">has book artist corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Buchkünstlerin/Buchkünstler (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft boekkunstenaar-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">kirjataiteilija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">kitap sanatçısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">könyvművész testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="et">raamatukunstnik (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo artista del libro</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa artista de llibre d’art</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة فنانة كتب</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有图书美术家团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kitabın biçimini kullanmaktan veya fiziksel yapısını değiştirmekten sorumlu bir sanatçı olan tüzel kişiyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente artista responsabile di servirsi della forma del libro o di alterare la sua struttura fisica. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy művész testülethez, amely felelős a könyvforma kiaknázásáért vagy fizikai szerkezetének a megváltoztatásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on taiteilija, joka on vastuussa kirjan muodon hyödyntämisestä tai sen fyysisen rakenteen muuttamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité artiste qui est responsable d’exploiter la forme livre ou de modifier sa structure physique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és una artista que és responsable d’explotar la forma llibre o de modificar la seva estructura física.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un artista que se encarga de explotar la forma del libro o alterar su estructura física.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een kunstenaar is die verantwoordelijk is voor het benutten van de vorm van het boek of veranderen van de fysieke structuur.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en kunstner som er ansvarlig for utnyttelse av bokformatet eller for endring av bokens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en kunstner, som er ansvarlig for at udnytte bogformen eller ændre dens fysiske struktur.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an artist who is responsible for exploiting the book form or altering its physical structure.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas atbild par grāmatas kā mākslas darbu radīšanu, izmantojot grāmatu kā formu vai pārveidojot tās fizisko struktūru.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes kunstnikuna vastutab raamatu vormi rakendamise või selle füüsilise struktuuri muutmise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Künstlerin/einem Künstler (Körperschaft), die/der für die Verwertung der Buchform oder für die Veränderung ihrer physische Struktur verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون فنانة مسئولة عن استغلال شكل الكتاب أو تغيير هيكله المادي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个艺术家负责开发图书外形或改变其物理结构的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10523 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10523">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité scénariste</rdfs:label>
        <rdfs:label xml:lang="hu">forgatókönyvíró testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come sceneggiatore ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er manuskriptforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har manusforfatter (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has screenwriter corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Drehbuchautorin/Drehbuchautor (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft scenarioschrijver-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">käsikirjoittaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="lv">scenārists (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">senarist tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">stsenarist (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo guionista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa guionista</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة كاتبة سيناريو</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有影视剧编剧团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, senaryo, metin veya sahne yazarı olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente autore di una sceneggiatura, copione o scena.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely szerzője egy forgatókönyvnek, szövegkönyvnek vagy jelenetnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on käsikirjoituksen tai kohtauksen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité autrice d’un scénario, d’un script ou d’une scène.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un autor d’un guió, un argument o una escena.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es autor de un guión, escrito o escena.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een auteur is van een scenario, script of scène.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en forfatter av et skuespill, et manuskript eller en scene.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er forfatter af et manuskript, drejebog eller scene.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an author of a screenplay, script, or scene.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir scenārija, uzveduma plāna vai ainas autors.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on stsenaariumi või stseeni autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft) eines Drehbuchs, eines Skripts oder einer Szene.</skos:definition>
        <skos:definition xml:lang="ar">بريط بين عمل وهيئة تكون كاتب سيناريو، أو نص، أو مشهد.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为影视剧剧本、脚本或场景著者的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10524 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10524">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité parolière</rdfs:label>
        <rdfs:label xml:lang="hu">dalszövegíró testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">dziesmas teksta autors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come paroliere ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er tekstforfatter</rdfs:label>
        <rdfs:label xml:lang="no">har sangtekstforfatter (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has lyricist corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Textdichterin/Textdichter (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft liedtekstschrijver-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">sanoittaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">sõnade autor (asutus)</rdfs:label>
        <rdfs:label xml:lang="tr">söz yazarı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo letrista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa lletrista</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مؤلفة أغاني</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作词者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzikalden bir şarkı dahil olmak üzere popüler bir şarkının sözlerinin yazarı olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente autore delle parole di una canzone pop, inclusa una canzone di un musical.  </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely egy könnyűzenei dal szövegének szerzője, beleértve a musicaldalokat is.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on populaarimusiikkiin kuuluvan laulun, mukaan lukien musikaalilaulun, sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité autrice des paroles d’une chanson populaire, y compris une chanson d’une comédie musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un autor de les paraules d’una cançó popular, inclosa una cançó d’un musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es autor de la letra de una canción popular, incluida una canción de un musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een auteur is van de woorden van een populair lied, inclusief een lied uit een musical.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en forfatter av teksten til en populær sang, inkludert én eller flere sanger fra en musikal.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er forfatter til sangteksten til en populær sang, inklusiv en sang fra en musical.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an author of the words of a popular song, including a song from a musical.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir dziesmas vārdu autors, ieskaitot dziesmas no mūzikla.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on levilaulu (k.a laul muusikalist) sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft) des Texts eines populären Lieds, einschließlich eines Lieds aus einem Musical.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مؤلفة لكلمات أغنية مشهورة، بما في ذلك أغنية من مسرحية موسيقية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一首流行歌曲（包括音乐剧中的歌曲）歌词的著者的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of only the dialogue from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca diyaloglarının yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å bare skrive dialogen fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore dei soli dialoghi di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali dialoogide kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkän musikaalin dialogin kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun dialogen i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de dialogen uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des dialogues d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musical párbeszédeinek szerzősége nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver mūzikla dialogus.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen des Dialogs eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría únicamente del diálogo de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només el diàleg d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف الحوار فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是对话的著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10525 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10525">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité librettiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come librettista ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er librettist</rdfs:label>
        <rdfs:label xml:lang="no">har librettist (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has librettist corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Librettistin/Librettisten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft librettist-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">libretist (asutus)</rdfs:label>
        <rdfs:label xml:lang="fi">libretisti (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="lv">libretists (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">librettista testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">libretto yazarı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo libretista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa llibretista</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مؤلفة أوبرالية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有台本作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, opera, bale veya müzikal sahne için başka bir eser veya oratoryo gibi müzikal veya koreografik bir eserin sözlerinin yazarı olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente autore delle parole di un musical o opera coreografica, come un&apos;opera, balletto, o altra opera per il teatro musicale, o per un oratorio. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző testülethez, amely olyan zenei vagy koreografikus mű szövegét szerzi, mint egy opera, balett, oratórium, vagy más zenés színpadi mű.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on musiikki- tai koreografisen teoksen, kuten oopperan, baletin tai muun musiikillisen näyttämöteoksen tai oratorion sanojen kirjoittaja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité autrice des paroles d’une œuvre musicale ou chorégraphique telle qu’un opéra, un ballet ou une autre œuvre pour la scène musicale, ou telle qu’un oratorio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un autor de les paraules d’un musical o una obra coreogràfica com ara una òpera, un ballet o qualsevol altra obra escènica musical o d’un oratori.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es autor de las letras de una obra musical o coreográfica como una ópera, un ballet u otra obra para el escenario musical, o un oratorio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een auteur is van de woorden van een muziek- of choreografisch werk zoals een opera, een ballet of ander muzikaal podiumwerk of een oratorium.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en forfatter av ordene i et musikalsk eller koreografisk verk som en opera, en ballett eller ennet verk for en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er forfatter af teksten til et musikalsk- eller koreografisk værk, såsom en opera, en ballet eller andet værk til en musikalsk scene, eller et oratorium.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an author of the words of a musical or choreographic work such as an opera, a ballet, or other work for the musical stage, or an oratorio.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir teksta autors mūzikas vai horeogrāfiskam darbam, piemēram, operai, baletam, citam muzikālam skatuves darbam vai oratorijai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on muusikalise või koreograafilise lavateose (nt ooper, ballett) või oratooriumi sõnade autor.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft) des Texts für ein Musical oder choreografisches Werk, wie zum Beispiel einer Oper, einem Ballett oder einem anderen Musikwerk für die Bühne, oder für ein Oratorium.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مؤلفة لكلمات عمل موسيقي، أو راقص مثل الأوبرا أو الباليه، أو أي عمل آخر للمسرح الموسيقي، أو موسيقى دينية.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为歌剧、芭蕾等音乐或编舞作品或其他舞台音乐作品或者清唱剧的歌词的著者的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Authoring of the words of only the songs from a musical is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir müzikalde yalnızca şarkıların sözlerinin yazılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å kun skrive ordene til bare sangene fra en musikal, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; escluso essere autore delle parole delle sole canzoni di un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma üksnes muusikali laulusõnade kirjutamist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pelkkien musikaalilaulujen sanojen kirjoittajaa.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Forfatter til kun sangteksterne i en musical er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Het schrijven van alleen de woorden van de liedjes uit een musical is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’être l’auteur uniquement des paroles des chansons d’une comédie musicale est exclu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Musicaldalok szövegírója nem tartozik ide.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atsevišķu dziesmu tekstus mūziklos.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Nur das Verfassen der Liedtexte eines Musicals fällt nicht darunter.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la autoría de la letra únicamente de las canciones de un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou l’autoria de només les paraules de les cançons d’un musical.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يُستبعد تأليف كلمات الأغاني فقط من مسرحية موسيقية.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括音乐剧中只是歌曲的词著者。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10526 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10526">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité rapporteuse</rdfs:label>
        <rdfs:label xml:lang="et">aruande koostaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="it">ha come relatore ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er rapportør</rdfs:label>
        <rdfs:label xml:lang="no">har rapportør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has rapporteur corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Berichterstatterin/Berichterstatter (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft rapporteur-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">kokousten raportoija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">raportör tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">raportőr testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo relator</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa relatora</rdfs:label>
        <rdfs:label xml:lang="lv">ziņotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مقررة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有会务报告人团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir kuruluş tarafından toplantılarının işleyişi hakkında rapor vermek üzere atanan bir yazar olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente autore incaricato da un&apos;organizzazione di compilare rapporti sugli atti dei suoi incontri. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy szerző testülethez, amelyet egy szervezet megbíz azzal, hogy készítsen jelentést az üléseinek a lefolyásáról.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on kirjoittaja, joka on saanut organisaatiolta tehtäväkseen raportoida kokousmenettelyistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité autrice qui est nommée par une organisation pour rédiger les comptes rendus de ses réunions.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és un autor que és nomenat per una organització per redactar les actes de les seves reunions.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es un autor que es designado por una organización para informar sobre los procedimientos de sus reuniones.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een auteur is die is aangesteld door een organisatie om te rapporteren over de handelingen van haar bijeenkomsten.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er en forfatter som er utnevnt av en organisasjon til å rapportere fra organisasjonens møter.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er en forfatter, som er udpeget af en organisation til at rapportere om udviklingen af dens møder.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is an author who is appointed by an organization to report on the proceedings of its meetings.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju - autors, kuru organizācija ir deleģējusi, lai ziņotu par tās sanāksmju rezultātiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes on tekstteose autor, kelle organisatsioon on määranud oma koosolekute toimingutest aruannet kirjutama.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Verfasserin/einem Verfasser (Körperschaft), die/der von einer Organisation eingestellt ist, um über den Ablauf ihrer Sitzungen zu berichten.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مؤلفا عينته منظمة لإعداد تقارير عن وقائع اجتماعاتها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个著者并被一个组织指定为在其会议文集中报告的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="no">Ansvar som er begrenset til å ta møtereferater, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt nicht die Verantwortlichkeit, die sich auf das Protokollschreiben beschränkt.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; esclusa la responsabilità limitata alla redazione dei verbali.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma vastutust, mis on piiratud ainult protokollimisega.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata pöytäkirjan laatimiseen rajoittuvaa vastuuta.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver atbildību protokolēt.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele a jegyzőkönyvvezetésre korlátozódó szerzőség.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Omfatter ikke ansvar begrænset til at tage referat.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Responsibility limited to taking minutes is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluye la responsabilidad limitada a levantar minutas.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la responsabilitat que es limita a prendre notes.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Tutanak tutmakla sınırlı sorumluluk hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Une responsabilité limitée à rédiger un procès-verbal est exclue.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Verantwoordelijkheid beperkt tot het notuleren is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد المسئولية المقتصرة على تدوين مضابط الجلسات.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括仅限于写会议记录的责任。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10528 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10528">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité chorégraphe</rdfs:label>
        <rdfs:label xml:lang="it">ha come coreografo ente</rdfs:label>
        <rdfs:label xml:lang="no">har koreograf (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er koreograf</rdfs:label>
        <rdfs:label xml:lang="en">has choreographer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Choreografin/Choreografen (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft choreograaf-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">horeogrāfs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">koreograaf (asutus)</rdfs:label>
        <rdfs:label xml:lang="tr">koreograf tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">koreografi (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">koreográfus testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo coreógrafo</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa coreògrafa</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مصممة رقصات</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编舞者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eseri görevlendirmekten sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile di un&apos;opera coreografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy koreografikus mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa koreografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre chorégraphique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra coreogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que se encarga de crear una obra coreográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een choreografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et koreografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for et koreografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a choreographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par horeogrāfisku darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab koreograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines choreografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن ابتكار عمل راقص.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种编舞作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10529 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10529">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité cartographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba kartogrāfs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kartograf tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come cartografo ente di opera</rdfs:label>
        <rdfs:label xml:lang="no">har kartograf (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er kartograf for værk</rdfs:label>
        <rdfs:label xml:lang="en">has cartographer corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Kartografin/Kartografen eines Werks (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cartograaf-corporatie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű térképész testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen kartantekijä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose kartograaf (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo cartógrafo de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa cartògrafa d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة رسامة خرائط لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的地图绘制者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, kartografik bir çalışma oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile di un&apos;opera cartografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy kartográfiai mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa kartografisen teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre cartographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra cartogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que se encarga de crear una obra cartográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een cartografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for et kartografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for et kartografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a cartographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par karti, atlantu, globusu vai citu kartogrāfijas materiālu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab kartograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines kartografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء عمل خرائطي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种地图作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10530 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10530">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité autrice</rdfs:label>
        <rdfs:label xml:lang="lv">autors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come autore ente</rdfs:label>
        <rdfs:label xml:lang="no">har forfatter (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er forfatter</rdfs:label>
        <rdfs:label xml:lang="en">has author corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Verfasserin/Verfasser (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft auteur-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">kirjoittaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">szerző testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="et">tekstteose autor (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo autor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa autora</rdfs:label>
        <rdfs:label xml:lang="tr">yazar tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مؤلفة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有著者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, metinsel bir eser oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile di un&apos;opera testuale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy szöveges mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa tekstiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre textuelle.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra textual.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra textual.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een tekstwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for et tekstlig verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for et tekstværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a textual work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par tekstuālu darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab tekstteose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines textlichen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء عمل نصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种文字作品的一个行为者关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Başka bir yaratıcıya ait eserlerin yeniden yazılması, yeniden ifade edilmesi veya uyarlanması yoluyla, eğer yapılan değişiklik orijinal eserin niteliğini ve içeriğini önemli ölçüde değiştirmişse ya da ifade ortamını dönüştürmüşse, yeni bir eser oluşturulması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy új mű megalkotása egy másik alkotó munkáinak átfogalmazásával, újraírásával vagy adaptálásával, ha a módosítás lényegesen megváltoztatta az eredeti jellegét és tartalmát, vagy a kifejezési forma médiumát.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Creatie van een nieuw werk door het parafraseren, herschrijven of bewerken van werken van een andere maker, als de wijziging de aard en content van het origineel substantieel gewijzigd heeft of het medium van expressie gewijzigd heeft, is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Creation of a new work by paraphrasing, rewriting, or adapting works by another creator, if the modification has substantially changed the nature and content of the original or changed the medium of expression, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt die Schaffung eines neuen Werks durch Paraphrasieren, Umschreiben oder Adaption von Werken einer anderen geistigen Schöpferin/eines anderen geistigen Schöpfers, wenn die Veränderung die Art und den Inhalt des Originals substanziell verändert hat oder sich das Medium der Expression geändert hat.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å skape et nytt verk ved å omskrive eller bearbeide verk av en annen opphaver er inkludert hvis dette i vesentlig grad har endret originalverkets særpreg og innhold, eller hvis mediet for uttrykket er endret.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compresa la creazione di una nuova opera tramite la parafrasi, riscrittura o adattamento di opere di un altro creatore, se la modifica ha cambiato sostanzialmente la natura e contenuto dell&apos;originale, o ha mutato il mezzo di espressione.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka uue teose loomist, ümber sõnastades, ümber töötades või adapteerides teise autori teoseid, kui teisendamine on originaali olemust ja sisu oluliselt muutnud või muutunud on väljenduse meedium.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Ietver arī jauna darba radīšanu, pārfrazējot, pārrakstot vai pielāgojot cita radītāja darbus, ja ir būtiski mainīta pamatdarba būtība, saturs vai izteiksmes nesējs.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou la creació d’una obra nova parafrasejant, reescrivint o adaptant obres d’un altre creador, si la modificació ha canviat substancialment la natura i el contingut de l’original o si ha canviat el mitjà d’expressió.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa uuden teoksen luomisen toisen tekijän teoksia mukailemalla, muokkaamalla tai sovittamalla, mikäli muutos on olennaisesti muuttanut alkuperäisen luonnetta ja sisältöä tai muuttanut ilmaisumuotoa.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La création d’une nouvelle œuvre en paraphrasant, en réécrivant ou en adaptant les œuvres d’un autre créateur est incluse, si la modification a changé considérablement la nature et le contenu de l’original ou a changé le mode d’expression.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se incluye la creación de una obra nueva mediante parafraseo, reescritura o adaptación de obras de otro creador, si la modificación ha cambiado sustancialmente la naturaleza y el contenido del original o ha cambiado el medio de expresión.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Skabelse af et nyt værk ved at parafrasere, omskrive eller bearbejde værker af et andet ophav, hvis modificeringen har medført en væsentlig ændring af originalens karakter og indhold, eller den har ændret udtryksmediet, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين إنشاء عمل جديد عن طريق إعادة منشئ آخر الصياغة، أو الكتابة، أو تكييفه الأعمال، إذا كان التعديل قد غيّر طبيعة الأصل ومحتواه أو غير وسيلة التعبير تغييرا كبيرا.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">通过演绎、改写或改变另一个创建者的作品所作而成的新作品的创建，如果修改实质性改变了原作的性质和内容或者改变了内容表达的媒介，应被包括在内。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10531 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10531">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité créatrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba radītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin yaratıcı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come creatore ente di opera</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er ophav til værk</rdfs:label>
        <rdfs:label xml:lang="no">har skaper av verk (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has creator corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat geistige Schöpferin/geistigen Schöpfer eines Werks (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft maker-corporatie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű létrehozó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen tekijä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose autor (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo creador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa creadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">هيئة منشئة عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa teoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon agent som er ansvarlig for å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创作一种作品的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A creator of work includes an agent who is jointly responsible for the creation of a work either by performing the same role as another agent, such as in a collaboration between two writers, or by performing a different role, such as in a collaboration between a composer and a lyricist.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">A mű létrehozója magában foglal egy ágenst, amely egy másik ágenssel közösen felelős egy mű létrehozásáért akár ugyanabban a közreműködői minőségben, mint például két író közötti együttműködés, vagy eltérő közreműködői minőségben, mint például egy zeneszerző és egy szövegíró közötti együttműködés.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir eserin yaratıcısı, iki yazarın iş birliği gibi başka bir temsilciyle aynı rolü üstlenerek ya da bir besteci ve söz yazarı arasındaki iş birliği gibi farklı bir rol üstlenerek, eserin yaratılmasından ortaklaşa sorumlu olan bir temsilciyi kapsar.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darba radītājs ietver aģentu, kas ir atbildīgs par darba radīšanu un pilda tādu pašu lomu kā cits aģents, piemēram, kā sadarbībā starp diviem rakstniekiem vai veicot dažādas lomas, kā piemēram, komponista un teksta autora sadarbībā.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fällt ein Akteur, der für die Schaffung eines Werks mitverantwortlich ist, wenn er entweder dieselbe Rolle wie ein anderer Akteur ausführt, wie bei einer Zusammenarbeit zwischen zwei Schriftstellerinnen/Schriftstellern, oder eine andere Rollen ausführt, wie bei einer Zusammenarbeit zwischen einer Komponistin/einem Komponisten und einer Textdichterin/einem Textdichter.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een maker van werk omvat een actor die gezamenlijk verantwoordelijk is voor de creatie van een werk door ofwel dezelfde rol uit te voeren als een andere actor, zoals bij een samenwerking door twee schrijvers, ofwel door een verschillende rol uit te voeren, zoals bij een samenwerking tussen een componist en een liedtekstschrijver.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En opphaver for verk inkluderer en agent med delt ansvar for å skape et verk, enten ved å fylle samme rolle som en annen agent, som i et samarbeid mellom to forfattere, eller ulike roller som i et samarbeid mellom en komponist og en sangtekstforfatter.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Ophav til værk omfatter en agent, som har fælles ansvar for at have skabt et værk enten ved at udføre den samme rolle som en anden agent, såsom i et samarbejde mellem to forfattere, eller ved at udføre en anden rolle, såsom i et samarbejde mellem en komponist og en tekstforfatter. </skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Teoksen tekijä kattaa toimijan, joka on yhteisesti vastuussa teoksen luomisesta joko toimimalla samassa roolissa kuin toinen toimija, kuten kahden kirjoittajan välisessä yhteistyössä, tai toimimalla eri rooleissa, kuten säveltäjän ja sanoittajan välisessä yhteistyössä.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Teose autor hõlmab ka tegijat, kes kaasvastutab teose loomise eest, täites teise tegijaga kas sama rolli (nt kahe kirjaniku koostöö) või erinevat rolli (nt helilooja ja sõnade autori koostöö).</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un creador de una obra incluye un agente que es corresponsable de la creación de una obra, ya sea desempeñando el mismo papel que otro agente, como en una colaboración entre dos escritores, o desempeñando un papel diferente, como en una colaboración entre un compositor y letrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un creador d’una obra inclou un agent que és responsable conjuntament de la creació d’una obra ja sigui realitzant la mateixa funció que un altre agent, com ara una col·laboració entre dos escriptors, o realitzant funcions diferents, com ara una col·laboració entre un compositor i un lletrista.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un creatore di opera comprende un agente congiuntamente  responsabile per la creazione di un&apos;opera, sia svolgendo lo stesso ruolo di un altro agente, come in una collaborazione tra due scrittori, sia svolgendo un ruolo differente, come in una collaborazione tra un compositore e un paroliere.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un créateur d’une œuvre comprend un agent coresponsable de la création d’une œuvre soit en exerçant le même rôle qu’un autre agent, comme dans le cas d’une collaboration entre deux écrivains, soit en exerçant un rôles différent, comme dans le cas d’une collaboration entre un compositeur et un parolier.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منشئ العمل يشمل وكيلًا مسئولاً مسئولية مشتركة عن إنشاء عمل إما عن طريق أداء نفس الدور الذي يؤديه وكيل آخر، كما هو الحال في التعاون بين كاتبين، أو عن طريق أداء دور مختلف، كما هو الحال في التعاون بين ملحن ومؤلف أغاني.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">作品的创作者包括对作品的创建联合负责的行为者，他们或者行使同样的角色（例如两个写作者之间的合作）或者行使不同角色（例如作曲者和词作者之间的合作）。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10532 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10532">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité architecte</rdfs:label>
        <rdfs:label xml:lang="et">arhitekt (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">arhitekts (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">arkkitehti (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="it">ha come architetto ente</rdfs:label>
        <rdfs:label xml:lang="no">har arkitekt (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er arkitekt</rdfs:label>
        <rdfs:label xml:lang="en">has architect corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Architektin/Architekten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft architect-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">mimar tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo arquitecto</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa arquitecta</rdfs:label>
        <rdfs:label xml:lang="hu">építész testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مهندسة معمارية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有建筑师团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir binanın veya diğer bir yapının tamamlandığında nasıl görüneceğini göstermeyi amaçlayan resimsel bir temsil de dahil olmak üzere mimari bir tasarımın oluşturulmasından sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile di un progetto architettonico, compresa una rappresentazione visiva destinata a mostrare l&apos;aspetto che avrà una costruzione o altra struttura, una volta completata. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy építészeti tervért, beleértve egy képi ábrázolást, melynek célja bemutatni, hogy egy épület stb. az elkészülte után hogyan fog kinézni.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa arkkitehtisuunnitelman luomisesta, mukaan lukien kuvaesityksestä, jonka tarkoitus on näyttää, miltä rakennus tai muu rakennelma näyttää valmiina.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une conception architecturale, y compris une représentation illustrée conçue pour montrer à quoi ressemblera un bâtiment ou une autre structure une fois la construction terminée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un disseny arquitectònic, inclosa una representació il·lustrada concebuda per mostrar com serà un edifici o qualsevol altra estructura una vegada complet.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear un diseño arquitectónico, incluida una representación pictórica destinada a mostrar cómo se verá un edificio u otra estructura cuando esté terminado.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een architectonisch ontwerp, omvattende een picturale representatie bedoeld te laten zien hoe een gebouw of andere structuur er na voltooiing uit zal zien.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape en arkitektonisk utforming, inkludert en gjengivelse i bildeform som er ment å vise hvordan en bygning eller annen struktur vil se ut når den er ferdig.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for et arkitektonisk design, inkl. en billedrepræsentation, som skal vise, hvordan en bygning eller anden struktur vil se ud, når den er færdig.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating an architectural design, including a pictorial representation intended to show how a building or other structure will look when completed.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par arhitektūras projekta radīšanu, ieskaitot projekta skici, lai parādītu, kā ēka vai cita struktūra izskatīsies, kad tā tiks pabeigta.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab arhitektuurse kujunduse loomise eest, k.a pildiline esitus, mis näitab, kuidas ehitis või muu konstruktsioon valmides välja hakkab nägema.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines architektonischen Entwurfs verantwortlich ist, einschließlich einer bildlichen Darstellung die zeigt, wie ein Gebäude oder eine andere Konstruktion nach der Fertigstellung aussehen soll.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء تصميم معماري، بما في ذلك التمثيل التصويري الذي يهدف إلى إظهار كيف سيبدو المبنى أو هيكل آخر عند اكتماله.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建建筑设计（包括用于展示建筑或其他结构完成之后外观效果的绘画作品）的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="hu">á</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10533 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10533">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité commanditaire</rdfs:label>
        <rdfs:label xml:lang="tr">görevlendiren tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come committente ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er opgavestiller</rdfs:label>
        <rdfs:label xml:lang="no">har oppdragsgiver (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has commissioning corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Auftraggeberin/Auftraggeber (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft opdrachtgever-corporatie</rdfs:label>
        <rdfs:label xml:lang="hu">megrendelő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pasūtītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">tellija (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo comisionado</rdfs:label>
        <rdfs:label xml:lang="fi">toimeksiantaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa comitent</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة تكليف</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有委托团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eseri görevlendirmekten sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della committenza di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy mű megrendeléséért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa teoksen teettämisestä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la commande d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable d’encarregar una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de encargar una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor opdracht geven tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å bestille et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for bestilling af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for commissioning a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par darba pasūtīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab teose tellimise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die ein Werk in Auftrag gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن التكليف بعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责委托一种作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10534 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10534">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité programmeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come programmatore ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er programmør</rdfs:label>
        <rdfs:label xml:lang="no">har programmerer (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has programmer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Programmiererin/Programmierer (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft programmeur-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">ohjelmoija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">programcı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">programmeerija (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">programmētājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">programozó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo programador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa programadora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مبرمجة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编程者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir bilgisayar programı oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un programma per computer.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy számítógépes program megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa tietokoneohjelman luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’un programme informatique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un programa informàtic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que se encarga de crear un programa informático.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een computerprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et dataprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et computerprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a computer program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par datorprogrammas izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab arvutiprogrammi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Computerprogramms verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء برنامج كمبيوتر.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种计算机程序的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10535 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10535">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité designer</rdfs:label>
        <rdfs:label xml:lang="fi">designer (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="lv">dizainers (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come designer ente</rdfs:label>
        <rdfs:label xml:lang="no">har designer (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er designer</rdfs:label>
        <rdfs:label xml:lang="en">has designer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Designerin/Designer (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ontwerper-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">kujundaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="tr">tasarımcı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">tervező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo diseñador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa dissenyadora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مصممة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有设计者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir nesne için tasarım oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione del progetto di un oggetto. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy tárgy tervezetének a megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa kohteen suunnittelusta tai muotoilusta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la conception d’un objet.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un disseny d’un objecte.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que se encarga de crear un diseño para un objeto.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een ontwerp voor een object.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å designe en gjenstand.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at designe et objekt.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a design for an object.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par objekta dizaina radīšanu/izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab objekti kujunduse loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Gestaltung des Designs eines Objekts verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء تصميم لكائن.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个物体的设计的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10536 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10536">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité compositrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba komponists (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin besteci tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compositore di opera  ente</rdfs:label>
        <rdfs:label xml:lang="no">har komponist for verk (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er komponist af værk</rdfs:label>
        <rdfs:label xml:lang="en">has composer corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Komponistin/Komponisten eines Werks (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft componist-corporatie werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű zeneszerző testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen säveltäjä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose helilooja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo compositor de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa compositora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة ملحنة عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的作曲者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir müzik eseri yaratmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un&apos;opera musicale.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy zenemű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa musiikkiteoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre musicale.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra musical.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que se encarga de crear una obra musical.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een muziekwerk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et musikalsk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et musikværk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a musical work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par mūzikas darba radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab muusikateose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Musikwerks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء عمل موسيقي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种音乐作品的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">Adaptation of another musical work to form a distinct alteration, paraphrasing a work or creating a work in the general style of another composer, or creating a work that is based on the music of another composer, is included.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Başka bir müzikal eserin belirgin bir değişiklik oluşturacak şekilde uyarlanması, bir eserin başka sözcükerle ifade edilmesi veya başka bir bestecinin genel üslubunda bir eser yaratılması veya başka bir bestecinin müziğine dayanan bir eser yaratılması dahildir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Bearbeidelse av et annet musikalsk verk som utgjør en klar endring, omskriving av et verk eller det å skape et verk med samme generelle stil som en annen komponists arbeid, eller det å skape et verk som er basert på en annen komponists musikk, er inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Bearbejdninger af et andet musikværk for at danne en distinkt forandring ved at parafrasere et værk eller skabe et værk i en anden komponists typiske stil, eller skabe et værk, der er baseret på en anden komponists musik, er omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Beletartozik egy másik zenemű adaptálása egy eltérő alterációs formára, egy mű parafrazeálása, vagy egy mű megalkotása egy másik zeneszerző általános stílusában, vagy egy olyan mű megalkotása, amely egy másik zeneszerző zenéjén alapul.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Bewerken van een ander muziekwerk om een onderscheidende aanpassing te vormen, een werk te parafraseren of een werk te creëren in de algemene stijl van een andere componist, of een werk te creëren dat gebaseerd is op de muziek van een andere componist is inbegrepen.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen Adaptionen anderer Musikwerke, die sich deutlich vom Original unterscheiden, Paraphrasierungen von Werken oder Schaffungen neuer Werke im Stil einer anderen Komponistin/eines anderen Komponisten oder Schaffungen von Werken, die auf der Musik einer anderen Komponistin/eines anderen Komponisten basieren.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">E&apos; compreso l&apos;adattamento di altra opera musicale per costituire una variazione distinta, tramite la parafrasi di un&apos;opera o la creazione di un&apos;opera nello stile tipico di un altro compositore, o tramite la creazione di un&apos;opera basata sulla musica di un altro compositore. </skos:scopeNote>
        <skos:scopeNote xml:lang="et">Hõlmab ka teise muusikateose adapteerimist selgelt eristuvaks uueks teoseks, teose parafraseerimist või teise helilooja stiilis teose komponeerimist, samuti teise helilooja muusikal põhineva teose loomist.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Inclou una adaptació d’una altra obra musical per formar una alteració distinta parafrasejant una obra o creant una obra en l’estil general d’un altre compositor o creant una obra que es basa en la música d’un altre compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Kattaa selvän muunnoksen muodostamiseksi tehdyn toisen musiikkiteoksen mukaelman, teoksen parafraasin tai teoksen luomisen toisen säveltäjän yleisen tyylin mukaisesti tai toisen säveltäjän musiikkiin perustuvan teoksen luomisen.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Le fait d’adapter une autre œuvre musicale pour constituer une modification distincte, de paraphraser une œuvre ou de créer une œuvre dans le style général d’un autre compositeur, ou bien de créer une œuvre d’après la musique d’un autre compositeur est inclus.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se incluye la adaptación de otra obra musical para formar una alteración distinta, parafrasear una obra o crear una obra en el estilo general de otro compositor, o crear una obra que se base en la música de otro compositor.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Tiek iekļauta cita muzikāla darba pielāgošana/adaptācija, lai izveidotu izmaiņas, pārfrāzējot darbu vai radot darbu cita komponista vispārējā stilā vai radot darbu, kas balstās uz cita komponista mūziku.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">يتم تضمين تكييف عمل موسيقي آخر لعمل تغيير مميز، أو إعادة صياغة عمل أو إنشاء عمل بالأسلوب العام لمؤلف موسيقي آخر، أو إنشاء عمل مبني على موسيقى ملحن آخر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">包括将另一种音乐作品改编以形成一种不同的变化形式、将一种作品演绎或用另一个作曲者的一般风格创建一种新的作品、或者基于另一个作曲者的音乐创建一种新的作品。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10537 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10537">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité inventrice</rdfs:label>
        <rdfs:label xml:lang="hu">feltaláló testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come inventore ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er opfinder</rdfs:label>
        <rdfs:label xml:lang="no">har oppfinner (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has inventor corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Erfinderin/Erfinder (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvinder-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">izgudrotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="fi">keksijä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">leiutaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="tr">mucit tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo inventor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa inventora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مخترعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有发明者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, yeni bir cihaz veya süreç oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un nuovo dispositivo o procedimento.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy új eszköz vagy eljárás létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa uuden välineen tai menetelmän luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’un nouveau dispositif ou procédé.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un mecanisme o procés nou.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear un nuevo dispositivo o proceso.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een nieuw apparaat of proces.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape en ny innretning eller prosess.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe en ny anordning eller proces.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a new device or process.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par jaunas ierīces vai procesa radīšanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab uue seadme või protsessi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines neuen Gerätes oder Prozesses verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء جهاز جديد أو عملية جديدة.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种新装置或新过程的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10538 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10538">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité compilatrice</rdfs:label>
        <rdfs:label xml:lang="tr">derleyici tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come compilatore ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er kompilator</rdfs:label>
        <rdfs:label xml:lang="no">har utarbeider (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has compiler corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Zusammenstellende/Zusammenstellenden (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft samensteller-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">kokoaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">koostaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">sastādītājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo compilador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa compiladora</rdfs:label>
        <rdfs:label xml:lang="hu">összeállító testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة جامعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有编纂者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, üstveri seti oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di una nuova opera, come una bibliografia o un repertorio, tramite la selezione, organizzazione, aggregazione e cura di dati, informazioni, etc. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely adatok, információk stb. kiválasztása, elrendezése, aggregálása és szerkesztése révén felelős egy olyan új mű létrehozásáért, mint például egy bibliográfia vagy adattár.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa uuden teoksen, kuten bibliografian tai hakemiston luomisesta valitsemalla, järjestämällä, koostamalla ja toimittamalla dataa, informaatiota tms.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’un ensemble de métadonnées descriptives.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un conjunt de descripció de metadades.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear un conjunto de descripción de metadatos.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een metadata-beschrijvingsset.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et nytt verk som en bibliografi eller katalog ved å velge ut, arrangere, samle og redigere data, informasjon, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et nyt værk, såsom en bibliografi eller en fortegnelse, ved at udvælge, arrangere, samle og redigere data, information etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a metadata description set.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par jauna darba, piemēram, bibliogrāfijas vai rādītāja izveidi, izvēloties, sakārtojot, apkopojot un rediģējot datus, informāciju, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab uue teose, nt bibliograafia või teatmiku loomise eest, valides, korrastades, koondades ja toimetades andmeid, infot jms.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die durch Selektieren, Gliedern, Aggregieren und Editieren von Daten und Informationen und so weiter für die Schaffung eines neuen Werks, zum Beispiel einer Bibliografie oder eines Verzeichnisses, verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مسئولة عن إنشاء عمل جديد مثل ببليوجرافية أو دليل عن طريق اختيار البيانات والمعلومات، وترتيبها، وتجميعها، وتحريرها، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一个元数据描述集的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A metadata description set includes a bibliography of works, expressions, or manifestations, a directory of agents and places, and an analytic finding aid.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir üstveri seti, eserlerin, anlatımların veya gösterimlerin bir bibliyografyasını, temsilciler ve yerler dizinini ve analitik rehber bilgi içerir.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Überarbeitungen oder Erläuterungen des Inhalts einer Expression eines Werks und die Auswahl und Zusammenstellung von Expressionen von Werken oder Teilen von Werken.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Det å redigere innholdet i et uttrykk av et verk eller gjøre det klarere, eller velge ut og kombinere uttrykk av et verk eller deler av et verk, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een metadata-beschrijvingsset omvat een bibliografie van werken, expressies, of manifestaties, een lijst van actors en plaatsen, en een analytisch vind-hulpmiddel.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu läbivaatamist ja parandamist ega teoste või nende osade väljenduste väljavalimist ja kokkupanemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön muokkaamista tai selkeyttämistä eikä teosten tai teosten osien valitsemista ja kokoamista yhteen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver satura pārskatīšanu vai precizēšanu, vai viena vai vairāku radītāju darbu vai to daļu atlasi vai apvienošanu.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik ide sem egy mű kifejezési formájának tartalmi felülvizsgálata vagy tisztázása, sem a művek vagy műrészek kifejezési formáinak kiválasztása és összeállítása.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revidering eller klarlægning af indholdet af et udtryk af et værk, og udvælgelse og sammensætning af udtryk for værker eller dele af værker, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono esclusi la revisione o il chiarimento del contenuto di un&apos;espressione di un&apos;opera, e la selezione e raccolta di espressioni di opere o parti di opere.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un conjunt de descripció de metadades inclou una bibliografia d’obres, expressions o manifestacions, un directori d’agents i llocs, i un instrument de descripció analític.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un conjunto de descripción de metadatos incluye una bibliografía de obras, expresiones o manifestaciones, un directorio de agentes y lugares, y una ayuda analítica para la búsqueda.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un ensemble de métadonnées descriptives comprend une bibliographie d’œuvres, d’expressions ou de manifestations, un répertoire d’agents et de lieux ainsi qu’un instrument de recherche analytique.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل أو توضيحه واختيار تعبيرات عن أعمال أو أجزاء من أعمال وتجميعها.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">元数据描述集包括作品、内容表达、或载体表现的书目、行为者和地点的名录、以及分析查询工具。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10539 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10539">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité photographe d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="tr">eserin fotoğrafçı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">fotogrāfs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come fotografo ente di opera</rdfs:label>
        <rdfs:label xml:lang="no">har fotograf for verk (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er fotograf af værk</rdfs:label>
        <rdfs:label xml:lang="en">has photographer corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Fotografin/Fotografen eines Werks (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft fotograaf-corporatie werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű fényképész testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen valokuvaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose fotograaf (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo fotógrafo de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa fotògrafa d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مصورة عمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的摄影者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir fotoğraf eseri oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un&apos;opera fotografica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy fényképészeti mű létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa valokuvateoksen luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre photographique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra fotogràfica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que se encarga de crear una obra fotográfica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een fotografisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et fotografisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et fotografisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a photographic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par fotogrāfiska darba izveidi.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab fotograafilise teose loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines fotografischen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء عمل فوتوغرافي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种摄影作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10540 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10540">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité intervieweuse d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervējis (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşmeci tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistatore ente di opera </rdfs:label>
        <rdfs:label xml:lang="no">har intervjuer (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er interviewer for værk</rdfs:label>
        <rdfs:label xml:lang="en">has interviewer corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewerin/Interviewer eines Werks (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft interviewer-corporatie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúkészítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastattelija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueerija (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo entrevistador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa entrevistadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة محاورة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的采访者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir görüşmeci, muhabir, anketör veya bilgi toplayan başka bir türde tüzel kişi olarak hareket ederek bir eser oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un&apos;opera che agisce come intervistatore, reporter, sondaggista o altro genere di ente che raccoglie informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy mű létrehozásáért oly módon, hogy interjúkészítőként, riporterként, közvélemény-kutatóként, vagy valamilyen más információgyűjtő testületként cselekszik.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa teoksen luomisesta toimimalla haastattelijana, toimittajana, mielipidetutkijana tai jonkinlaisena muuna toimijana, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre en agissant à titre d’intervieweur, de reporteur, de sondeur ou d’autre collectivité recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra actuant com un entrevistador, un periodista, un enquestador o qualsevol altre tipus d’entitat corporativa que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra actuando como entrevistador, reportero, encuestador o algún otro tipo de entidad corporativa que recopila información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een werk door het optreden als een interviewer, verslaggever, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et verk ved å fungere som intervjuer, reporter eller en annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et værk ved at optræde som interviewer, journalist, meningsmåler eller en anden form for korporation, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a work by acting as an interviewer, reporter, pollster, or some other kind of corporate body who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par darba radīšanu, darbojoties kā intervētājs, reportieris, aptaujas organizētājs vai kāds cits informācijas apkopotājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab teose loomise eest, tegutsedes intervjueerija, reporteri, küsitleja või muu infot koguva asutusena.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Werks verantwortlich ist, indem sie als Interviewerin/Interviewer, Reporterin/Reporter, Meinungsforscherin/Meinungsforscher oder andere Körperschaft Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء عمل من خلال العمل كمحاور، أو مراسل، أو منظم استطلاعات الرأي، أو أي نوع آخر من الهيئات التي تجمع المعلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过担当采访者、记者、民意调查员或其他类型信息搜集行为者而对一种作品的创建负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10541 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10541">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité interviewée d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darbā intervēts (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin görüşülen tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come intervistato ente di opera</rdfs:label>
        <rdfs:label xml:lang="no">har intervjuobjekt (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er interviewperson for værk</rdfs:label>
        <rdfs:label xml:lang="en">has interviewee corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Interviewte/Interviewten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geïnterviewde corporatie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű interjúalany testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen haastateltava (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose intervjueeritav (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo entrevistado de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa entrevistada d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مقابَلة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的受访者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir görüşmeci, genellikle bir muhabir, anketör veya bilgi toplayan başka bir türde temsilciye yanıt vererek bir eser oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un&apos;opera tramite le risposte rilasciate a un intervistatore, solitamente un reporter, sondaggista o altro genere di agente che raccoglie le informazioni.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy mű létrehozásáért oly módon, hogy válaszol egy interjúkészítőnek, általában riporternek, közvélemény-kutatónak, vagy valamilyen más információgyűjtő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa teoksen luomisesta vastaamalla haastattelijalle, tavallisesti toimittajalle, mielipidetutkijalle tai jonkinlaiselle muulle toimijalle, joka kerää tietoja.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre en répondant à un intervieweur, habituellement un reporteur, un sondeur ou un autre agent recueillant de l’information.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra responent a un entrevistador, normalment un periodista, enquestador o qualsevol altre tipus d’agent que recull informació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra respondiendo a un entrevistador, generalmente un reportero, encuestador o algún otro tipo de agente que recopila información.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een werk door het antwoorden op een interviewer, meestal een journalist, opiniepeiler of een andere soort actor die informatie verzamelt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et verk ved å svare på spørsmål fra en intervjuer, reporter eller annen agent som samler inn informasjon.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et værk ved at besvare spørgsmål fra en interviewer, normalt en journalist, meningsmåler eller en anden form for agent, som indsamler information.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating a work by responding to an interviewer, usually a reporter, pollster, or some other kind of agent who gathers information.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par darba radīšanu, atbildot uz intervētāja, parasti reportiera, aptaujas organizētāja vai kāda cita informācijas apkopotāja jautājumiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab teose loomise eest, vastates intervjueerijale, reporterile, küsitlejale või muule infot koguvale tegijale. </skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Werks verantwortlich ist, indem sie einer Interviewerin/einem Interviewer antwortet. Dabei handelt es sich normalerweise um eine Reporterin/einen Reporter, eine Meinungsforscherin/einen Meinungsforscher oder eine andere Akteurin/einen anderen Akteur, die/der Informationen zusammenträgt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مسئولة عن إنشاء عمل من خلال الرد على المحاور، وعادة ما يكون مراسلًا، أو مستطلع آراء، أو وكيل من نوع آخر يجمع معلومات.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过回答采访者（通常是记者、民意调查员或其他类型信息搜集行为者）而对一种作品的创建负责的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10542 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10542">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité agrégatrice</rdfs:label>
        <rdfs:label xml:lang="fi">aggregaattori (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">aggregátor testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">apkopotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="it">ha come aggregatore ente </rdfs:label>
        <rdfs:label xml:lang="no">har aggregator (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er samler</rdfs:label>
        <rdfs:label xml:lang="en">has aggregator corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Aggregatorin/Aggregator (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aggregator-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">liitja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo agregador</rdfs:label>
        <rdfs:label xml:lang="tr">toplayıcı tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa agregadora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مجمعة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合集编者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, başka eserlerin anlatımlarını seçerek ve düzenleyerek toplama bir eser oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un&apos;opera tramite la selezione e l&apos;organizzazione di espressioni di altre opere.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy aggregáló mű létrehozásáért, más művek kifejezési formáinak kiválasztása és elrendezése révén.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa aggregoivan teoksen luomisesta valitsemalla ja järjestämällä muiden teosten ekspressioita.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre agrégatrice par la sélection et l’arrangement d’expressions d’autres œuvres.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra agregadora mitjançant la selecció i l’arranjament d’expressions d’altres obres.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra agregada seleccionando y ordenando expresiones de otras obras.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een aggregaatwerk door middel van selectie en arrangeren van expressies van andere werken.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et aggregerende verk ved å velge ut og arrangere uttrykk av andre verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et aggregerende værk ved at udvælge og arrangere udtryk af andre værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating an aggregating work by selecting and arranging expressions of other works.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par darba-apkopojuma radīšanu, atlasot un sakārtojot citu darbu izteiksmes.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab liitva teose loomise eest, valides ja korrastades teiste teoste väljendused.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines aggregierenden Werks verantwortlich ist, indem sie Expressionen anderer Werke auswählt und zusammenstellt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء عمل مجمع عن طريق اختيار تعبيرات أعمال الأخرى وترتيبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责把其他作品的内容表达选择和整理后创建一种合集性作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10543 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10543">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité remixeuse</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista di remix ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er remixer</rdfs:label>
        <rdfs:label xml:lang="no">har remikser (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has remix artist corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Remix Artist (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft remixartiest-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">remiksija (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">remiksētājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">remix sanatçısı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">remixművész testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo artista de remix</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa artista de remescla</rdfs:label>
        <rdfs:label xml:lang="fi">uudelleenmiksaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة فنانة مزج موسيقي</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有合成艺术家团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, önceden kaydedilmiş sesleri değiştirerek, yeniden birleştirerek, karıştırarak ve yeniden üreterek bir ses eseri oluşturmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un&apos;opera audio tramite la manipolazione, ricombinazione, missaggio e riproduzione di suoni registrati in precedenza.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy audiomű létrehozásáért korábban rögzített hangok manipulálásával, újrakombinálásával, keverésével és reprodukálásával.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa ääniteoksen luomisesta manipuloimalla, yhdistelemällä, sekoittamalla ja uudelleen tuottamalla aiemmin äänitettyjä ääniä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’une œuvre audio par la manipulation, la recombinaison, le mixage et la reproduction de sons préalablement enregistrés.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’una obra d’àudio mitjançant la manipulació, la recombinació, la mescla i la reproducció de sons enregistrats prèviament.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un cuerpo corporativo que es responsable de crear una obra de audio manipulando, recombinando, mezclando y reproduciendo sonidos previamente grabados.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een geluidswerk door het manipuleren, opnieuw combineren, mixen en reproduceren van eerder opgenomen geluiden.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et lydverk ved å manipulere, mikse, sette sammen og reprodusere lyd som er spilt inn tidligere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et lydværk ved manipulering, rekombinering, mixing og gengivelse af tidligere indspillede lyde.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating an audio work by manipulating, recombining, mixing, and reproducing previously recorded sounds.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par audio darba radīšanu, manipulējot, pārkombinējot, miksējot un atkārtoti atskaņojot iepriekš ierakstītas skaņas.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab audioteose loomise eest, manipuleerides, ümber kombineerides, segades ja taastekitades varem salvestatud helisid.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung eines Tonwerks verantwortlich ist, indem sie eine bestehende Tonaufnahme bearbeitet, rekombiniert, mischt und reproduziert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مشتركة مسئولة عن إنشاء عمل صوتي عن طريق المعالجة بالأصوات المسجلة مسبقًا، وإعادة دمجها، وخلطها، وإعادة إنتاجها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过操纵、重新组合、混合和复制事先录制的声音而负责创建一种音频作品的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="de">Darunter fallen keine Nachbearbeitungen, die weder Art noch Inhalt des Originalwerks wesentlich verändern, sowie das Zusammenmischen von aufgenommenen Einzelspuren (Kanälen) zu einem scheinbar ununterbrochen durchgehenden Klangerlebnis.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma remiksimist, mis ei muuda oluliselt originaalteose olemust ja sisu, ega salvestatud heliradade kokkupanekut üheks helirajaks.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata uudelleenmiksaamista, joka ei oleellisesti muuta alkuperäisen teoksen luonnetta ja sisältöä eikä aiemmin äänitettyjen musiikkikappaleiden yhdistämistä yhdeksi musiikkikappaleeksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Neietver remiksēšanas darbības, kas būtiski nemaina oriģinālā darba būtību un saturu, kā arī ierakstu celiņu apvienošanu vienā ieraksta celiņā.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartoznak ide sem azok a remixelési tevékenységek, amelyek nem változtatják meg lényegesen az eredeti mű jellegét és tartalmát, sem a rögzített sávok látszólag egy folyamatos sávként való összemixelése.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Orijinal çalışmanın niteliğini ve içeriğini önemli ölçüde değiştirmeyen remiks faaliyetleri ve kaydedilen parçaları kesintisiz tek bir parça olarak görünecek şekilde karıştırılması hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Remiksaktiviteter som ikke i betydelig grad endrer originalverkets særpreg og innhold, og miksing av innspilte spor slik at resultatet høres ut som ett sammenhengende spor, er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Remixhandelingen die de aard en content van het originele werk niet substantieel wijzigen, en het bij elkaar mixen van opgenomen sporen zodat het één voortdurend spoor lijkt, zijn uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Remixing activities that do not substantially change the nature and content of the original work, and mixing recorded tracks together to appear as one continuous track, are excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Remixing-aktiviteter, som ikke væsentligt forandrer originalværkets karakter og indhold, samt mixe indspillede lydspor sammen for at fremstå som ét uafbrudt spor, er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Se excluyen las actividades de remezcla que no cambien sustancialmente la naturaleza y el contenido de la obra original, y la mezcla de pistas grabadas para que aparezcan como una pista continua.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Sono escluse le attività che non modificano sostanzialmente la natura e il contenuto dell&apos;opera originale, nonché il missaggio di brani registrati che appaiono come un unico brano.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Sont exclus les activités de remixage qui ne changent pas considérablement la nature et le contenu de l’œuvre originale et le fait de mixer ensemble des pistes enregistrées pour donner l’impression d’une seule piste continue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclouen les activitats de remescla que no canvien substancialment la natura i el contingut de l’obra original, i la mescla de pistes enregistrades conjuntament perquè semblin una pista contínua.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد أنشطة المزج التي لا تغير تغييرا كبيرا طبيعة العمل الأصلي ومحتواه، ودمج المسارات المسجلة معًا لتظهر كمسار واحد مستمر.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括不实质性改变原作品的性质和内容的合成活动、以及将录制的音轨混合成一个连续的音轨的活动。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10544 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10544">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité cinéaste</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvantekijä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">film üreticisi tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas veidotājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">filmitegija (asutus)</rdfs:label>
        <rdfs:label xml:lang="hu">filmkészítő testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come cineasta ente</rdfs:label>
        <rdfs:label xml:lang="no">har filmskaper (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er filmskaber</rdfs:label>
        <rdfs:label xml:lang="en">has filmmaker corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmemacherin/Filmemacher (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmmaker-corporatie</rdfs:label>
        <rdfs:label xml:lang="es">tiene cuerpo corporativo cineasta</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa cineasta</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة صانعة أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制片人团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bağımsız veya kişisel bir film yaratmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un film indipendente o realizzato autonomamente.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy független- vagy egy magánfilm létrehozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa riippumattoman tai henkilökohtaisen elokuvan luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’un film indépendant ou personnel.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable d’una pel·lícula cinematogràfica independent o personal.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que es responsable de crear un film independiente o personal.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het creëren van een zelfstandige of persoonlijke film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape en uavhengig eller personlig film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe en indiefilm eller personlig film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating an independent or personal film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par neatkarīgas vai privātas filmas veidošanu un izpildi visos aspektos.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab sõltumatu või autorifilmi loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Erstellung eines unabhängigen oder privaten Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن إنشاء فيلم مستقل أو شخصي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责创建一种独立或个人电影的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A filmmaker is individually responsible for the conception and execution of all aspects of the film.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir film yapımcısı, filmin tüm yönlerinin tasarlanmasından ve yürütülmesinden bireysel olarak sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een filmmaker is individueel verantwoordelijk voor de conceptie en uitvoering van alle aspecten van de film.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy filmkészítő egyénileg felelős egy film koncepciójáért és összes aspektusának végrehajtásáért.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Filmemacherin/Ein Filmemacher ist persönlich für das Konzept und die Ausführung aller Aspekte des Films verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En filmskaper har personlig ansvar for planen med og gjennomføringen av alle aspektene ved filmen.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Filmas veidotājs ir pilnībā atbildīgs par visiem filmas koncepcijas un realizācijas aspektiem.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmitegija vastutab üksinda kõigi filmi aspektide kontseptsiooni ja teostamise eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmskaberen er individuelt ansvarlig for udtænkning og udførelse af alle filmens aspekter.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tekijä vastaa itse kaikilta osin elokuvan ideoinnista ja toteuttamisesta.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un cineasta es individualmente responsable de crear un film independiente o personal.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un cineasta è responsabile a livello individuale della concezione ed esecuzione di ogni aspetto del film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un cineasta és responsable a títol individual de la concepció i l’execució de tots els aspectes de la pel·lícula.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un cinéaste est responsable à titre individuel de la conception et de l’exécution de tous les aspects du film.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">صانع أفلام مسئول مسئولية فردية عن تصور جميع جوانب الفيلم وتنفيذه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制片人对电影所有方面的构思和执行负有个人责任</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10545 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10545">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité artiste</rdfs:label>
        <rdfs:label xml:lang="it">ha come artista ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er kunstner</rdfs:label>
        <rdfs:label xml:lang="no">har kunstner (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has artist corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Künstlerin/Künstler (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kunstenaar-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">kunstnik (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">mākslinieks (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">művész testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">sanatçı tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">taiteilija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo artista</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa artista</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة فنانة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有美术家团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, orijinal bir grafik tasarımı, çizimi, resmi vb. oluşturmaktan sorumlu tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della creazione di un un progetto grafico, schizzo, dipinto originali, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy eredeti grafikai terv, rajz, festmény, stb. megalkotásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa alkuperäisen graafisen suunnitelman, piirroksen, maalauksen tms. luomisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la création d’un graphisme, d’une peinture, d’un dessin, etc. original.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la creació d’un disseny gràfic, un dibuix, una pintura, etc., original.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que es responsable de concebir, y frecuentemente implementar, un diseño gráfico, dibujo, pintura, etc. original.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is het maken van een oorspronkelijk grafisch ontwerp, tekening, schilderij etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for å skape et originalt grafisk design, en tegning, et maleri etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at skabe et originalt grafisk design, -tegning, -maleri etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for creating an original graphic design, drawing, painting, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par darba radīšanu un īstenošanu, izmantojot oriģinālu grafisko dizainu, zīmēšanu, gleznošanu, u.tml.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab originaalse graafilise kujunduse, joonistuse, maali vms loomise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die Schaffung einer originalen grafischen Gestaltung, einer Zeichnung, eines Gemäldes und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تكون مسئولة عن إنشاء تصميم رسومي، ورسم، وتصوير زيتي أصلي، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责完成原创图形设计、绘图、绘画等的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10546 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10546">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité fondatrice d’une œuvre</rdfs:label>
        <rdfs:label xml:lang="lv">darba dibinātājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="tr">eserin kurucu tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come fondatore ente di opera</rdfs:label>
        <rdfs:label xml:lang="no">har grunnlegger av verk (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er stifter af værk</rdfs:label>
        <rdfs:label xml:lang="en">has founder corporate body of work</rdfs:label>
        <rdfs:label xml:lang="de">hat Begründerin/Begründer eines Werks (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft oprichter-corporatie van werk</rdfs:label>
        <rdfs:label xml:lang="hu">mű alapító testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="fi">teoksen perustaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">teose asutaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo fundador de obra</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa fundadora d’una obra</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مؤسسة لعمل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有作品的创办者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir eseri başlatmaktan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile dell&apos;avvio di un&apos;opera diacronica.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy diakronikus mű indításáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa diakronisen teoksen alullepanosta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de lancer une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable d’iniciar una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que es responsable de iniciar una obra diacrónica.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het initiëren van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som har ansvar for å etablere et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for at igangsætte et diakronisk værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for initiating a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par diahroniskā darba (seriālizdevuma, integrētā resursa vai vairākdaļu monogrāfijas) izveidošanu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab diakroonilise teose ellukutsumise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für das Begründen eines diachronen Werks verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن بدء عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责发起一种历时作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10547 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10547">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité directrice de casting</rdfs:label>
        <rdfs:label xml:lang="lv">aktieru atlases režisors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">casting&apos;u juht (asutus)</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore del casting ente </rdfs:label>
        <rdfs:label xml:lang="no">har casting director (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er caster</rdfs:label>
        <rdfs:label xml:lang="en">has casting director corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Casting Director (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft castingdirector-corporatie</rdfs:label>
        <rdfs:label xml:lang="tr">kast yönetmeni tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="fi">roolittaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">szereposztó rendező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo director de casting</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa directora de càsting</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مديرة طاقم تمثيل</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有角色导演团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, sanatçılara rol ve görev atamanın çoğu yönünden sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della maggior parte degli aspetti relativi all&apos;assegnazione agli interpreti di parti e compiti. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős a szerepek és feladatok előadókra osztásának legtöbb vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa useimmista esiintyjien roolien ja tehtävien antamiseen kuuluvista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la majeure partie des aspects relatifs à la distribution des rôles et des fonctions aux interprètes.</skos:definition>
        <skos:definition xml:lang="es">Relaciona un recurso con un organismo corporativo que es responsable de la mayoría de los aspectos de la asignación de roles y funciones a intérpretes.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la majoria dels aspectes de l’assignació de parts i funcions als intèrprets.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor de meeste aspecten van het toewijzen van rollen en taken aan uitvoerders.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for de fleste aspekter ved å fordele roller og oppgaver mellom utøvere.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for de fleste aspekter ved tildeling af roller og ansvar til udøvere.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for most aspects of assigning parts and duties to performers.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par lomu sadali un pienākumu piešķiršanu izpildītājiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab enamiku aspektide eest esitajatele rollide ja ülesannete jagamisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die meisten Aspekte der Rollenvergabe und Aufgabenzuteilung an Ausführende verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن معظم جوانب تخصيص الأدوار والواجبات للمؤدين.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责给演员分配角色和任务的大多数工作的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10548 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10548">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité productrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er producer</rdfs:label>
        <rdfs:label xml:lang="no">har produsent (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has producer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft producent-corporatie</rdfs:label>
        <rdfs:label xml:lang="lv">producents (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">producer testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="et">produtsent (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo productor</rdfs:label>
        <rdfs:label xml:lang="fi">tuottaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa productora</rdfs:label>
        <rdfs:label xml:lang="tr">yapımcı tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منتجة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有制作者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, ekran, ses kaydı, televizyon, web yayını vb. için bir yapımın ticari yönlerinin çoğundan sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della maggior parte degli aspetti commerciali di una produzione destinata allo schermo, registrazione audio, televisione, webcast, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy képernyőre kerülő műsor, hangfelvétel, televíziós, webes közvetítés, stb. legtöbb üzleti vonatkozásáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa suurimmasta osasta elokuva-, äänite-, televisio-, suoratoisto- tms. tuotannon liiketoiminnallisista tehtävistä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la majeure partie des aspects commerciaux de la production d’un film, d’un enregistrement audio, d’une émission de télévision, d’une webémission, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la majoria dels aspectes comercials d’una producció d’una pel·lícula, d’un enregistrament sonor, d’un programa de televisió, d’una emissió web, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que es responsable de la mayoría de los aspectos comerciales de una producción para la pantalla, de grabación de audio, televisión, webcast, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een productie voor scherm, geluidsopname, televisie, webcast etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en produktion beregnet til lærred, lydoptagelse, tv, webcast etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for most of the business aspects of a production for screen, sound recording, television, webcast, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par filmas, mūzikas ierakstu, televīzijas, tīmekļa pārraižu u.tml. biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab enamiku äriliste aspektide eest filmide, helisalvestiste, telesaadete, veebiülekannete jms tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für die meisten geschäftlichen Aspekte einer Produktion für die Leinwand, für eine Tonaufnahme, für das Fernsehen, für einen Webcast und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن معظم جوانب العمل في الإنتاج للسينما، وللتسجيل الصوتي، وللتليفزيون، وللبث عبر الإنترنت، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责银幕、录音、电视、网络直播等制作的大部分商业运作的一个团体关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A producer is generally responsible for fundraising, managing the production, hiring key personnel, arranging for distributors, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir yapımcı genellikle kaynak yaratma, üretimi yönetme, kilit personel işe alma, dağıtımcıları ayarlama vb. işlerden sorumludur.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een producent is over het algemeen verantwoordelijk voor het werven van fondsen, het beheren van de productie, het inhuren van het belangrijkste personeel, het verzorgen van distributeurs etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy producer általában felelős az adománygyűjtésért, a produkció irányításáért, a kulcsfontosságú személyzet felvételéért, a forgalmazók megszervezéséért stb.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Produzentin/Ein Produzent ist im Allgemeinen für die Geldbeschaffung, das Produktionsmanagement, das Einstellen von wichtigem Personal, die Organisation des Vertriebs und so weiter verantwortlich.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">En general, un productor és responsable d’assegurar el finançament, de gestionar la producció, de contractar el personal clau, d’organitzar la distribució, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">En produsent har normalt ansvar for å skaffe finansiering, lede produksjonen, ansette nøkkelmedarbeidere, finne distributører, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Generalmente un produttore è responsabile della raccolta dei fondi, gestione della produzione, assunzione dei capi reparto, accordi con i distributori, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Producents parasti ir atbildīgs par līdzekļu piesaistīšanu, ražošanas vadīšanu, vadošā personāla pieņemšanu darbā, vienošanos ar izplatītājiem u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Produceren er almindeligvis ansvarlig for finansiering, produktionsledelse, ansættelse af nøglepersonale, at finde distributører etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Tavaliselt vastutab produtsent rahastuse hankimise, tootejuhtimise, põhipersonali palkamise, levitamislepingute jms eest.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Tuottaja vastaa tyypillisesti rahoituksen hankkimisesta, tuotannon johdosta, avainhenkilöstön palkkaamisesta, jakajien järjestämisestä jne.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un producteur est généralement responsable d’assurer le financement, de gérer la production, de recruter le personnel clé, d’organiser la distribution, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un productor es generalmente responsable de recaudar fondos, gestionar la producción, contratar personal clave, llegar a acuerdos para distribuidores, etc.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">منتج مسئول عامة عن التمويل، وإدارة الإنتاج، وتوظيف الموظفين الرؤساء، والترتيب مع الموزعين، إلخ.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">制作者通常负责募集资金、管理制作、聘用主要人员、安排发行者等</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10549 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10549">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité réalisatrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista ente </rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er instruktør</rdfs:label>
        <rdfs:label xml:lang="no">har regissør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has director corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Regisseurin/Regisseur (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft regisseur-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">ohjaaja (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">rendező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">režisors (institūcija)</rdfs:label>
        <rdfs:label xml:lang="et">režissöör (asutus)</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo director</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa realitzadora</rdfs:label>
        <rdfs:label xml:lang="tr">yönetmen tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة مخرجة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有导演团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın, bir radyo veya televizyon programının vb. genel yönetimi ve denetiminden sorumlu olan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente responsabile della gestione generale e della supervisione di un&apos;interpretazione cinematografica, programma radiofonico o televisivo, etc.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely felelős egy filmre vett előadás, egy rádió- vagy televízióműsor stb. általános irányításáért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka on vastuussa elokuvatun esityksen, radio- tai televisio-ohjelman tms. yleisestä johtamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui est responsable de la gestion et de la supervision générales d’une prestation filmée, d’une émission de radio ou de télévision, etc.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que és responsable de la gestió general i la supervisió d’una actuació filmada, d’un programa radiofònic o de televisió, etc.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que es responsable de la gestión y supervisión general de una presentación filmada, un programa de radio o televisión, etc.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het algemene beheer en toezicht van een gefilmde voorstelling, een radio- of televisieprogramma etc.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som er ansvarlig for de fleste forretningsmessige aspektene ved en produksjon for film eller fjernsyn, lydinnspilling, webcast, etc.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse, et radio- eller tv-program etc.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who is responsible for the general management and supervision of a filmed performance, a radio or television program, etc.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas ir atbildīga par radio vai televīzijas raidījuma, uzfilmētā pasākuma u.tml. vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes vastutab filmitava etenduse, raadio- või telesaate vms üldise juhtimise ja juhendamise eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die für das allgemeine Management und die Leitung einer verfilmten Darbietung, einer Hörfunk- oder Fernsehsendung und so weiter verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة مسئولة عن الإدارة العامة والإشراف على أداء مصور، أو برنامج إذاعي أو تليفزيوني، إلخ.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与负责电影表演、广播或电视节目等的全面管理和监督的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10550 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10550">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité émettrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come emittente ente</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er udstedende organ</rdfs:label>
        <rdfs:label xml:lang="no">har utgiver (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="en">has issuing corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat herausgebende Körperschaft</rdfs:label>
        <rdfs:label xml:lang="nl">heeft uitvaardiger-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">julkaisija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="hu">kibocsátó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="tr">piyasaya çıkaran tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo emisor</rdfs:label>
        <rdfs:label xml:lang="lv">turpinājumizdevuma izdevējs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa d’entitat editora</rdfs:label>
        <rdfs:label xml:lang="et">väljaandja (asutus)</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة جهة إصدار</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有颁布团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, eser yayınlayan tüzel kişi ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente che emette un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely kibocsát egy művet.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka julkaisee teoksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui publie une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que publica una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que emite una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die een werk uitvaardigt.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som utgir et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som udgiver et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who issues a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas izdevusi darbu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes annab teose välja.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die ein Werk heraus gibt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تصدر عملاً.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与颁布一种作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10551 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10551">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité organisatrice</rdfs:label>
        <rdfs:label xml:lang="it">ha come organizzatore ente </rdfs:label>
        <rdfs:label xml:lang="no">har arrangør (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er arrangør</rdfs:label>
        <rdfs:label xml:lang="en">has organizer corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Veranstalterin/Veranstalter (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft organisator-corporatie</rdfs:label>
        <rdfs:label xml:lang="fi">järjestäjä (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="et">korraldaja (asutus)</rdfs:label>
        <rdfs:label xml:lang="tr">organizatör tüzel kişisi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">organizētājs (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">szervező testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo organizador</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa organitzadora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة منظِمة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有组织者团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, düzenlediği bir konferans, sergi veya etkinlik sonucu bir eser ortaya çıkan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente organizzatore di una conferenza, mostra o altro evento che dà origine a un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely egy mű létrejöttét eredményező konferenciát, kiállítást vagy egyéb eseményt szervez.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka järjestää konferenssin, näyttelyn tai muun tapahtuman, joka antaa alun teokselle.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui organise un congrès, une exposition ou un autre événement qui donne lieu à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que organitza un congrés, una exposició o qualsevol altre esdeveniment que dona lloc a una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que organiza una conferencia, exhibición u otro evento que da origen a un recurso.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die organiseert een conferentie, tentoonstelling of andere gebeurtenis dat aanleiding geeft tot een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som organiserer en konferanse, en utstilling eller et annet arrangement som gir opphav til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som organiserer en konference, udstilling eller anden begivenhed, som giver anledning til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who organizes a conference, exhibition, or other event that gives rise to a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas organizējusi konferenci, izstādi vai citu pasākumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes korraldab teosele aluse pannud konverentsi, näituse vm ürituse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die eine Konferenz, eine Ausstellung oder ein anderes Ereignis organisiert beziehungsweise veranstaltet, aus der/dem ein Werk hervorgeht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تنظم مؤتمرًا، أو معرضًا، أو أي حدث آخر ينتج عنه عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与组织会议、展览或其他事件以产生一种作品的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10552 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10552">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour collectivité consultante</rdfs:label>
        <rdfs:label xml:lang="fi">asiantuntija (yhteisö)</rdfs:label>
        <rdfs:label xml:lang="tr">danışman tüzel kişi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come consulente ente </rdfs:label>
        <rdfs:label xml:lang="no">har konsulent (korporasjon)</rdfs:label>
        <rdfs:label xml:lang="da">har korporation, som er rådgiver</rdfs:label>
        <rdfs:label xml:lang="en">has consultant corporate body</rdfs:label>
        <rdfs:label xml:lang="de">hat Beraterin/Berater (Körperschaft)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft consultant-corporatie</rdfs:label>
        <rdfs:label xml:lang="et">konsultant (asutus)</rdfs:label>
        <rdfs:label xml:lang="lv">konsultants (institūcija)</rdfs:label>
        <rdfs:label xml:lang="hu">tanácsadó testülete a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene organismo corporativo consultor</rdfs:label>
        <rdfs:label xml:lang="ca">té com a entitat corporativa consultora</rdfs:label>
        <rdfs:label xml:lang="ar">له هيئة استشارية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有顾问团体</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir eserin yaratıcısı olarak temsil edilen ilgili bir temsilci için danışmanlık hizmetleri sağlayan ve genellikle tavsiyelerde bulunan tüzel kişi ile ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a un ente che fornisce servizi di consulenza e spesso formula raccomandazioni a un agente correlato presentato come creatore di un&apos;opera.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy testülethez, amely tanácsadási szolgáltatásokat nyújt és gyakran javaslatokat ad egy mű létrehozójaként megjelenő ágensnek.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen yhteisöön, joka tarjoaa asiantuntijapalveluita ja usein antaa suosituksia toimijalle, joka esiintyy teoksen tekijänä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une collectivité qui fournit des services de consultation et fait souvent des recommandations à un agent en relation représenté comme créateur d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una entitat corporativa que proporciona serveis d’assessorament, i que sovint fa recomanacions, a un agent relacionat que es representa com un creador d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con un organismo corporativo que provee servicios de consultoría, y frecuentemente hace recomendaciones, a un agente relacionado que es representado como un creador de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een corporatie die diensten van raadgeving levert, en vaak aanbevelingen doet, aan een gerelateerde actor die vertegenwoordigd wordt als een maker van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en korporasjon som leverer konsulenttjenester og ofte gir anbefalinger til en annen agent som representeres som opphaveren til et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en korporation, som yder rådgivning, og ofte kommer med anbefalinger til en relateret agent, som er repræsenteret som ophav til et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a corporate body who provides consultation services, and often makes recommendations, for a related agent who is represented as a creator of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar institūciju, kas sniedz konsultāciju pakalpojumus un ieteikumus citam aģentam, kas ir darba radītājs.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose asutusega, kes annab konsultatsiooni ja sageli ka soovitusi seotud tegijale, kes on esitatud teose autorina.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Körperschaft, die Beratungsdienste anbietet und häufig einem in Beziehung stehenden Akteur, der als geistige Schöpferin/geistiger Schöpfer eines Werks repräsentiert wird, Empfehlungen macht.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وهيئة تقدم خدمات استشارية، وغالبًا ما تقدم مقترحات، لوكيل ذي صلة يقدَم على أنه منشئ لعمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与向表现为作品创作者的一个相关行为者提供咨询服务并经常提供建议的一个团体关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10556 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10556">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille directrice de la photographie</rdfs:label>
        <rdfs:label xml:lang="tr">görüntü yönetmeni ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come direttore famiglia della fotografia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er filmfotograf</rdfs:label>
        <rdfs:label xml:lang="no">har filmfotograf (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has director family of photography</rdfs:label>
        <rdfs:label xml:lang="de">hat Kamerafrau/Kameramann (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft cameraregisseur-familie</rdfs:label>
        <rdfs:label xml:lang="lv">kinooperators (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">kuvaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="et">operaator-lavastaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">operatőr családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia directora de fotografía</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família directora de fotografia</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مديرة تصوير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有摄影指导家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, elektronik olarak veya film ya da video stoğu üzerinde görüntü kaydeden ve genellikle ışıklandırmayı seçip düzenleyen bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia che cattura le immagini, sia elettronicamente che su film o su video, e che spesso seleziona e sistema le luci. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely elektronikusan, filmen vagy videóállományon képeket rögzít, és gyakran kiválasztja és elrendezi a megvilágítást.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka tallentaa kuvia joko sähköisesti tai filmille tai videolle ja usein valitsee ja järjestää valaistuksen.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui capte des images, de manière électronique ou bien sur film ou vidéo, et qui, souvent, choisit et dispose l’éclairage.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que captura imatges, ja sigui electrònicament o sobre pel·lícula o vídeo, i que sovint selecciona i arregla la il·luminació.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que captura imágenes, ya sea electrónicamente o en suministros para video, y frecuentemente elige y organiza la iluminación.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die beelden vastlegt, hetzij elektronisch hetzij op film- of videomateriaal, en vaak de belichting selecteert en arrangeert.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som filmer levende bilder, enten elektronisk eller på film, og som ofte velger og arrangerer lyssetting.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som optager billeder, enten elektronisk eller på film eller video, og ofte også udvælger og arrangerer lyssætning.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who captures images, either electronically or on film or video stock, and often selects and arranges the lighting.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas uzņem attēlus elektroniski vai uz filmas vai video, un bieži izvēlas un izvieto apgaismojumu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes jäädvustab pildi kas elektrooniliselt või filmi- või videolindile ning sageli valib ja seab üles valgustuse.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die Bilder aufzeichnet, entweder elektronisch oder auf Film- oder Videomaterial, und häufig die Belichtung auswählt und arrangiert.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تلتقط الصور، إما إلكترونيًا، أو على فيلم، أو مقاطع فيديو، وغالبًا ما تختار الإضاءة وترتبها.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与通过电子、胶片或视频存储方式摄录影像、且经常负责灯光的选择和布置的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="en">A director of photography for a movie is also called a chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="tr">Bir filmin görüntü yönetmeni aynı zamanda, baş sinematograf olarak adlandırılır.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Een cameraregisseur voor een film wordt ook hoofd-cinematograaf genoemd.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Egy film operatőrét vezető operatőrnek is nevezik.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Eine Kamerafrau/Ein Kameramann für einen Film wird auch als &quot;Bildregisseurin/Bildregisseur&quot; bezeichnet.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Elokuvan kuvaajaa kutsutaan myös elokuvaajaksi.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Filmfotografen for en film kalles også sjefsfotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Filmfotografen på en film kaldes også for en cheffotograf.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Filmi operaator-lavastajat nimetatakse inglise keeles sageli ka chief cinematographer.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Kinooperatoru mēdz saukt arī par galveno operatoru.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">Un directeur de la photographie pour un film est également appelé un chef opérateur de prise de vue.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">Un director de fotografia d’una pel·lícula també s’anomena primer operador.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">Un director de fotografía para una película también es llamado un primer cinematógrafo.</skos:scopeNote>
        <skos:scopeNote xml:lang="it">Un direttore della fotografia in un film è detto anche capo operatore.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">مدير تصوير لفيلم يسمى أيضا كبير المصورين السينمائيين.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">电影的摄影指导也称总摄影师</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10557 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10557">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille recherchiste</rdfs:label>
        <rdfs:label xml:lang="tr">araştırmacı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="it">ha come ricercatore famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er researcher</rdfs:label>
        <rdfs:label xml:lang="no">har forsker (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has researcher family</rdfs:label>
        <rdfs:label xml:lang="de">hat Forscherin/Forscher (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft onderzoeker-familie</rdfs:label>
        <rdfs:label xml:lang="hu">kutató családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">pētnieks (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia investigadora</rdfs:label>
        <rdfs:label xml:lang="fi">tutkija (suku)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família investigadora</rdfs:label>
        <rdfs:label xml:lang="et">uurija (perekond)</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة باحثة</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有研究者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, oluşturulmasını desteklemek için araştırma yapan bir aileyi bir eserle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera a una famiglia che svolge ricerche a supporto della creazione di un&apos;opera.  </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amely kutatást végez egy mű megalkotásának támogatására.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka tukee teoksen syntymistä tutkimuksellaan</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui effectue des recherches pour aider à la création d’une œuvre.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que fa recerca per donar suport a la creació d’una obra.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que realiza investigación en apoyo a la creación de una obra.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die onderzoek doet ter ondersteuning van de creatie van een werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som forsker som bidrag til å skape et verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som udfører research til at understøtte skabelsen af et værk.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who does research in support of the creation of a work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas veikusi pētniecību darba radīšanai.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes teeb teose loomise heaks uurimistööd.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die Forschung betreibt, um das Schaffen eines Werks zu unterstützen.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تجري بحوث لدعم إنشاء عمل.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与从事研究以支持一种作品的创作的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10558 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10558">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille directrice de publication</rdfs:label>
        <rdfs:label xml:lang="hu">főszerkesztő családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">galvenais redaktors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er ansvarshavende redaktør</rdfs:label>
        <rdfs:label xml:lang="no">har redaksjonssjef (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has editorial director family</rdfs:label>
        <rdfs:label xml:lang="de">hat Chefredakteurin/Chefredakteur (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft hoofdredacteur-familie</rdfs:label>
        <rdfs:label xml:lang="et">peatoimetaja (perekond)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia directora editorial</rdfs:label>
        <rdfs:label xml:lang="fi">toimituspäällikkö (suku)</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família directora editorial</rdfs:label>
        <rdfs:label xml:lang="tr">yayın yönetmeni ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مديرة تحرير</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有主编家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, artzamanlı bir çalışmanın yayın politikası ve içeriği için yasal veya fikri sorumluluğu olan ancak yaratıcı sorumluluğu olmayan bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy családhoz, amelynek jogi vagy szellemi, de nem alkotói felelőssége van egy diakronikus mű szerkesztési politikájáért és tartalmáért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, jolla on juridinen tai tiedollinen vastuu, mutta ei luovaa vastuuta, diakronisen teoksen toimituslinjasta ja sisällöstä.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille qui a la responsabilité légale ou intellectuelle, mais non la responsabilité créative, de la politique éditoriale et du contenu d’une œuvre diachronique.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que té responsabilitat legal o intel·lectual, però no responsabilitat creativa, de la política editorial i el contingut d’una obra diacrònica.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que tiene responsabilidad legal o intelectual, pero no responsabilidad creativa, sobre la política editorial y el contenido de un recurso diacrónico.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die wettelijke of intellectuele verantwoordelijkheid, maar niet creatieve verantwoordelijkheid heeft voor het redactioneel beleid en content van een diachronisch werk.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som har juridisk eller intellektuelt ansvar, bortsett fra kreativt ansvar, for det redaksjonelle innholdet i et diakronisk verk.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er juridisk eller intellektuelt ansvarlig, men ikke skabelsesansvarlig, for et diakronisk værks redaktionelle linje og indhold.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who has legal or intellectual responsibility, but not creative responsibility, for the editorial policy and content of a diachronic work.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kam ir juridiska vai intelektuāla, bet ne radoša atbildība par diahroniskā darba izdošanas politiku un saturu.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes juriidiliselt või intellektuaalselt, kuid mitte loominguliselt vastutab diakroonilise teose toimetamispõhimõtete ja sisu eest.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Familie, die die rechtliche oder intellektuelle, aber keine kreative, Verantwortung für die redaktionelle Vorgehensweise und den Inhalt eines diachronen Werks trägt.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تتحمل مسئولية قانونية أو فكرية، ولكن لا تتحمل مسئولية إبداعية، عن السياسة التحريرية ومحتوى عمل ممتد زمنيًا.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与有对一种历时作品的编辑政策和内容的法律或知识责任（但非创作责任）的一个家族关联起来。</skos:definition>
        <skos:scopeNote xml:lang="tr">Bir eserin anlatımının gözden geçirilmesi, netleştirilmesi veya içeriğinin başka bir şekilde değiştirilmesi hariçtir.</skos:scopeNote>
        <skos:scopeNote xml:lang="lv">Darbība neietver darba izteiksmes satura pārskatīšanu, precizēšanu vai cita veida izmaiņas u.tml.</skos:scopeNote>
        <skos:scopeNote xml:lang="de">Darunter fallen nicht Überarbeitungen, Erläuterungen oder andere inhaltliche Änderungen an einer Expression eines Werks.</skos:scopeNote>
        <skos:scopeNote xml:lang="et">Ei hõlma teose väljenduse sisu parandamist, täpsustamist ega muude muudatuste tegemist.</skos:scopeNote>
        <skos:scopeNote xml:lang="fi">Ei kata teoksen ekspression sisällön tarkastamista, selkeyttämistä tai muuta muutosta.</skos:scopeNote>
        <skos:scopeNote xml:lang="nl">Herziening, toelichting of andere verandering van content van een expressie van een werk is uitgesloten.</skos:scopeNote>
        <skos:scopeNote xml:lang="es">La corrección, clarificación u otro cambio en el contenido de una expresión de una obra se excluye.</skos:scopeNote>
        <skos:scopeNote xml:lang="fr">La révision, la clarification ou toute autre modification du contenu d’une expression d’une œuvre sont exclues.</skos:scopeNote>
        <skos:scopeNote xml:lang="hu">Nem tartozik bele egy mű kifejezési formájának revíziója, áttekintése, vagy egyéb tartalmi változtatása.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Revision, clarification, or other change of content of an expression of a work is excluded.</skos:scopeNote>
        <skos:scopeNote xml:lang="da">Revision, indholdspræcisering eller anden ændring af indholdet af et værks udtryk er ikke omfattet.</skos:scopeNote>
        <skos:scopeNote xml:lang="ca">S’exclou la revisió, l’aclariment o qualsevol altre canvi del contingut d’una expressió d’una obra.</skos:scopeNote>
        <skos:scopeNote xml:lang="no">Å redigere innholdet i et uttrykk av et verk eller gjøre det klarere er ikke inkludert.</skos:scopeNote>
        <skos:scopeNote xml:lang="ar">تُستبعد مراجعة محتوى تعبيرة لعمل، أو توضيحه، أو أي تغيير آخر فيه.</skos:scopeNote>
        <skos:scopeNote xml:lang="zh-hans-cn">不包括对一种作品的一种内容表达之内容的修订、说明或其他变化。</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10559 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10559">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille réalisatrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvaohjaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">film yönetmeni ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="et">filmirežissöör (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">filmrendező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista cinematografico famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er filminstruktør</rdfs:label>
        <rdfs:label xml:lang="no">har filmregissør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has film director family</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmregisseurin/Filmregisseur (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmregisseur-familie</rdfs:label>
        <rdfs:label xml:lang="lv">kinorežisors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia directora de cine</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família directora cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مخرجة أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影导演家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, filme alınmış bir performansın genel yönetim ve denetiminden sorumlu bir yönetmen bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia regista responsabile della gestione generale e della supervisione di un&apos;interpretazione cinematografica. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező családhoz, amely felelős egy filmre vett előadás általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on ohjaaja, joka on vastuussa elokuvatun esityksen yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille réalisatrice qui est responsable de la gestion et de la supervision générales d’une prestation filmée.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un director responsable de la gestió general i la supervisió d’una actuació filmada.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una directora quien es responsable de la gestión y supervisión general de una presentación filmada.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een gefilmde uitvoering.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er regissør med ansvar for generell ledelse av en filmet forestilling.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med en filmoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is a director who is responsible for the general management and supervision of a filmed performance.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par uzfilmētā pasākuma vispārējo vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on filmitava etenduse üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Familie), die/der für das allgemeine Management und die Leitung einer verfilmten Darbietung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مخرجة مسئولة عن الإدارة العامة والإشراف على أداء مصور.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责拍摄表演的总体管理和监督的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10560 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10560">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille réalisatrice de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista radiofonico famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er radioregissør</rdfs:label>
        <rdfs:label xml:lang="no">har radioregissør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has radio director family</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkregisseurin/Hörfunkregisseur (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioregisseur-familie</rdfs:label>
        <rdfs:label xml:lang="et">raadiorežissöör (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma direktors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">radio-ohjaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yönetmeni ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádiós rendező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia directora de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família realitzadora radiofònica</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مخرجة إذاعية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播导演家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının genel yönetim ve denetiminden sorumlu bir yönetmen bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia regista responsabile della gestione generale e della supervisione di un programma radiofonico. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező családhoz, amely felelős egy rádióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on ohjaaja, joka on vastuussa radio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille réalisatrice qui est responsable de la gestion et de la supervision générales d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un realitzador que és responsable de la gestió general i la supervisió d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es un directora quien es responsable de la gestión y supervisión general de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er regissør med ansvar for generell ledelse av et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is a director who is responsible for the general management and supervision of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni - direktors, kura atbildīga par radio raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on raadiosaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Familie), die/der für das allgemeine Management und die Leitung einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مديرة مسئولة عن الإدارة العامة والإشراف على برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责广播节目的总体管理和监督的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10561 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10561">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille réalisatrice de télévision</rdfs:label>
        <rdfs:label xml:lang="it">ha come regista televisivo famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er tv-regissør</rdfs:label>
        <rdfs:label xml:lang="no">har fjernsynsregissør (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has television director family</rdfs:label>
        <rdfs:label xml:lang="de">hat Fernsehregisseurin/Fernsehregisseur (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft televisieregisseur-familie</rdfs:label>
        <rdfs:label xml:lang="et">telerežissöör (perekond)</rdfs:label>
        <rdfs:label xml:lang="fi">televisio-ohjaaja (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">televizyon yönetmeni ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">televíziós rendező családja a következő:</rdfs:label>
        <rdfs:label xml:lang="lv">televīzijas raidījuma režisors (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia directora de televisión</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família realitzadora de televisió</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة مخرجة تليفزيونية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电视导演家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir televizyon programının genel yönetimi ve denetiminden sorumlu yönetmen bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia regista responsabile della gestione generale e della supervisione di un programma televisivo. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy rendező családhoz, amely felelős egy televízióműsor általános menedzseléséért és felügyeletéért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on ohjaaja, joka on vastuussa televisio-ohjelman yleisestä johtamisesta ja valvonnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille réalisatrice qui est responsable de la gestion et de la supervision générales d’une émission de télévision.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un realitzador responsable de la gestió general i la supervisió d’un programa de televisió.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es un directora quien es responsable de la gestión y supervisión general de un programa de televisión.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een regisseur is die verantwoordelijk is voor het algemeen beheer en toezicht van een televisieprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er regissør med ansvar for generell ledelse av et fjernsynsprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er instruktør, som er ansvarlig for den generelle ledelse af- og tilsyn med et tv-program.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is a director who is responsible for the general management and supervision of a television program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni - režisors, kura atbildīga televīzijas raidījuma vispārēju vadību un uzraudzību.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes on telesaate üldise juhtimise ja juhendamise eest vastutav režissöör.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Regisseurin/einem Regisseur (Familie), die/der für das allgemeine Management und die Leitung einer Fernsehsendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون مديرة مسئولة عن الإدارة العامة والإشراف على برنامج تليفزيوني.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个导演并负责电视节目的总体管理和监督的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10562 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10562">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille productrice audio</rdfs:label>
        <rdfs:label xml:lang="et">audioprodutsent (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">audióproducer családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore audio famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er lydproducer</rdfs:label>
        <rdfs:label xml:lang="no">har lydprodusent (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has audio producer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Produzentin/Produzenten einer Tonaufnahme (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft geluidsproducent-familie</rdfs:label>
        <rdfs:label xml:lang="tr">ses yapımcısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">skaņu ierakstu producents (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia productora de audio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família productora d’àudio</rdfs:label>
        <rdfs:label xml:lang="fi">äänituottaja (suku)</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منتجة صوت</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有音频制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir ses kaydının ticari yönlerinin çoğunu yönetmekten sorumlu olan yapımcı bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia produttore responsabile della gestione della maggior parte degli aspetti commerciali di una registrazione audio. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer családhoz, amely felelős egy hangfelvétel üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on tuottaja, joka on vastuussa useimpien äänitteen liiketoiminnallisten tehtävien hoitamisesta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille productrice qui est responsable de gérer la majeure partie des aspects commerciaux d’un enregistrement audio.</skos:definition>
        <skos:definition xml:lang="es">Relaciona un recurso con una familia que es una productora que es responsable de gestionar la mayoría de los aspectos comerciales de una grabación de audio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un productor que és responsable de la gestió de la majoria dels aspectes comercials d’un enregistrament àudio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een geluidsopname.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en produsent som er ansvarlig for de fleste forretningsmessige aspektene ved et lydopptak.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en producer, som er ansvarlig for at håndtere de fleste forretningsmæssige aspekter af en lydoptagelse.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is a producer who is responsible for managing most of the business aspects of an audio recording. </skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir producents, kas ir atbildīga par skaņu ierakstu biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes produtsendina vastutab enamiku äriliste aspektide korraldamise eest helisalvestusel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Familie), die/der für die meisten geschäftlichen Aspekte einer Audioaufnahme verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون منتجة مسئولة عن إدارة معظم جوانب العمل في تسجيل صوتي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为一个制作者并负责音频录制工作大多数方面商业运作之管理的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10563 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10563">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille productrice de cinéma</rdfs:label>
        <rdfs:label xml:lang="fi">elokuvatuottaja (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">film yapımcısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="lv">filmas producents (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="et">filmiprodutsent (perekond)</rdfs:label>
        <rdfs:label xml:lang="hu">filmproducer családja a következő:</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore televisivo famiglia </rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er filmproducer</rdfs:label>
        <rdfs:label xml:lang="no">har filmprodusent (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has film producer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Filmproduzentin/Filmproduzenten (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft filmproducent-familie</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia productora fílmica</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família productora cinematogràfica</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منتجة أفلام</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有电影制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir filmin yapımının ticari yönlerinin çoğundan sorumlu olan yapımcı bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia produttore responsabile della gestione della maggior parte degli aspetti commerciali di un film. </skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer családhoz, amely felelős egy filmprodukció üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on tuottaja, joka on vastuussa suurimmasta osasta elokuvan tuotannon liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille productrice qui est responsable de la majeure partie des aspects commerciaux de la production d’un film.</skos:definition>
        <skos:definition xml:lang="es">Relaciona un recurso con una familia que es una productora que es responsable de gestionar la mayoría de los aspectos comerciales de un film.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un productor que és responsable de la majoria dels aspectes comercials de la producció d’una pel·lícula.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een producent is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van de productie van een film.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en produsent med ansvar for de fleste forretningsmessige aspektene ved en film.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved en film.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is a producer who is responsible for most of the business aspects of the production of a film.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni, kas ir atbildīga par filmas uzņemšanas finansiālajiem aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes produtsendina vastutab enamiku äriliste aspektide eest filmi tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Familie), die/der für die meisten geschäftlichen Aspekte bei der Produktion eines Films verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون منتجة مسئولة عن معظم جوانب العمل في فيلم.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责电影制作的大部分商业运作的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10564 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10564">
        <rdfs:isDefinedBy rdf:resource="http://rdaregistry.info/Elements/w/"/>
        <rdfs:label xml:lang="fr">a pour famille productrice de radio</rdfs:label>
        <rdfs:label xml:lang="it">ha come produttore radiofonico famiglia</rdfs:label>
        <rdfs:label xml:lang="da">har familie, som er radioproducer</rdfs:label>
        <rdfs:label xml:lang="no">har radioprodusent (familie)</rdfs:label>
        <rdfs:label xml:lang="en">has radio producer family</rdfs:label>
        <rdfs:label xml:lang="de">hat Hörfunkproduzentin/Hörfunkproduzenten (Familie)</rdfs:label>
        <rdfs:label xml:lang="nl">heeft radioproducent-familie</rdfs:label>
        <rdfs:label xml:lang="et">raadioprodutsent (perekond)</rdfs:label>
        <rdfs:label xml:lang="lv">radio raidījuma producents (dzimta/ģimene)</rdfs:label>
        <rdfs:label xml:lang="fi">radiotuottaja (suku)</rdfs:label>
        <rdfs:label xml:lang="tr">radyo yapımcısı ailesi ile ilişkilidir</rdfs:label>
        <rdfs:label xml:lang="hu">rádióproducer családja a következő:</rdfs:label>
        <rdfs:label xml:lang="es">tiene familia productora de radio</rdfs:label>
        <rdfs:label xml:lang="ca">té com a família productora radiofònica</rdfs:label>
        <rdfs:label xml:lang="ar">له عائلة منتجة إذاعية</rdfs:label>
        <rdfs:label xml:lang="zh-hans-cn">有广播制作者家族</rdfs:label>
        <skos:definition xml:lang="tr">Bir eseri, bir radyo programının ticari yönlerinin çoğundan sorumlu olan yapımcı bir aileyle ilişkilendirir.</skos:definition>
        <skos:definition xml:lang="it">Correla un&apos;opera alla famiglia produttore responsabile della gestione della maggior parte degli aspetti commerciali di un programma radiofonico.</skos:definition>
        <skos:definition xml:lang="hu">Hozzákapcsol egy művet egy producer családhoz, amely felelős egy rádióműsor üzleti vonatkozásainak a zöméért.</skos:definition>
        <skos:definition xml:lang="fi">Liittää teoksen sukuun, joka on tuottaja, joka on vastuussa suurimmasta osasta radio-ohjelman liiketoiminnasta.</skos:definition>
        <skos:definition xml:lang="fr">Met une œuvre en relation avec une famille productrice qui est responsable de la majeure partie des aspects commerciaux d’une émission de radio.</skos:definition>
        <skos:definition xml:lang="ca">Relaciona una obra amb una família que és un productor que és responsable de la majoria dels aspectes comercials d’un programa radiofònic.</skos:definition>
        <skos:definition xml:lang="es">Relaciona una obra con una familia que es una productora que es responsable de la mayoría de los aspectos comerciales de la producción de un programa de radio.</skos:definition>
        <skos:definition xml:lang="nl">Relateert een werk aan een familie die een producer is die verantwoordelijk is voor het merendeel van de zakelijke aspecten van een radioprogramma.</skos:definition>
        <skos:definition xml:lang="no">Relaterer et verk til en familie som er en produsent med ansvar for de fleste forretningsmessige aspektene ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="da">Relaterer et værk til en familie, som er en producer, som er ansvarlig for størstedelen af de forretningsmæssige aspekter ved et radioprogram.</skos:definition>
        <skos:definition xml:lang="en">Relates a work to a family who is a producer who is responsible for most of the business aspects of a radio program.</skos:definition>
        <skos:definition xml:lang="lv">Sasaista darbu ar dzimtu/ģimeni - producents, kurš ir atbildīgs par radio raidījuma darbības/biznesa aspektiem.</skos:definition>
        <skos:definition xml:lang="et">Seostab teose perekonnaga, kes produtsendina vastutab enamiku äriliste aspektide eest raadiosaate tootmisel.</skos:definition>
        <skos:definition xml:lang="de">Setzt ein Werk in Beziehung zu einer Produzentin/einem Produzenten (Familie), die/der für die meisten geschäftlichen Aspekte einer Hörfunksendung verantwortlich ist.</skos:definition>
        <skos:definition xml:lang="ar">يربط بين عمل وعائلة تكون منتجة مسئولة عن معظم جوانب العمل في برنامج إذاعي.</skos:definition>
        <skos:definition xml:lang="zh-hans-cn">将一种作品与作为制作者并负责广播节目的大部分商业运作的一个家族关联起来。</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://rdaregistry.info/Elements/w/P10565 -->

    <owl:AnnotationProperty rdf:about="http://rdaregistry.info/Elements/w/P10565">
