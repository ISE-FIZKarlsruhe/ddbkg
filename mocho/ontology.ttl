###  http://rdaregistry.info/Elements/w/P10501
rdaw:P10501 rdf:type owl:AnnotationProperty ;
            rdfs:isDefinedBy rdaw: ;
            rdfs:label "a pour agent collectif producteur"@fr ,
                       "ha come produttore agente collettivo"@it ,
